frame Node {
    pub var value: any;
    pub var next: any;

    pub init(v: any) {
        self.value = v;
        self.next = nil;
    }
}

frame LinkedList {
    pub var head: any;
    pub var tail: any;

    pub init() {
        self.head = nil;
        self.tail = nil;
    }

    pub fn push(v: any) {
        var node = Node(v);
        if (self.tail == nil) {
            self.head = node;
            self.tail = node;
        } else {
            self.tail.next = node;
            self.tail = node;
        }
    }

    pub fn pop(): any {
        if (self.tail == nil) return nil;
        var node: Node = self.tail;
        print("About to get node.value, node type: {node}");
        var value = node.value;
        print("Got value: {value}");
        self.tail = node.next;
        return value;
    }
}

var list = LinkedList();
list.push(42);
print("Pushed 42");
var result = list.pop();
print("Popped: {result}");
