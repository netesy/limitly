+    if (is_integer(idx)) {
+      int64_t i = as_i64(idx);
+      if (i >= 0 && static_cast<uint64_t>(i) < l->size) {
+        l->data[i] = val;
+        auto &vm = *static_cast<Machine *>(ctx);
+        vm.transfer_native_ownership(val, list);
+        return VAL_NIL;
+      }
+    }
