// Lymar Application Benchmark (1,000,000 element Quicksort + Hash Reduction)

import std.io.file as file_mod;

fn get_rss_kb(): int {
    var file_res = file_mod.open("/proc/self/statm", "r");
    match (file_res) {
        val f_obj => {
            var f_concrete = f_obj as file_mod.File;
            var text_res = f_concrete.read();
            var text = "";
            match (text_res) {
                val t => {
                    text = t;
                    nil;
                },
                err e => { nil; }
            }
            f_concrete.close();
            var space1 = _builtin_string_index_of(text, " ");
            if (space1 >= 0) {
                var sub = _builtin_substring(text, space1 + 1, _builtin_len(text));
                var space2 = _builtin_string_index_of(sub, " ");
                if (space2 >= 0) {
                    var rss_str = _builtin_substring(sub, 0, space2);
                    var pages = 0;
                    for (var i = 0; i < _builtin_len(rss_str); i = i + 1) {
                        var ch = _builtin_substring(rss_str, i, i + 1);
                        if (ch == "0") { pages = pages * 10 + 0; }
                        if (ch == "1") { pages = pages * 10 + 1; }
                        if (ch == "2") { pages = pages * 10 + 2; }
                        if (ch == "3") { pages = pages * 10 + 3; }
                        if (ch == "4") { pages = pages * 10 + 4; }
                        if (ch == "5") { pages = pages * 10 + 5; }
                        if (ch == "6") { pages = pages * 10 + 6; }
                        if (ch == "7") { pages = pages * 10 + 7; }
                        if (ch == "8") { pages = pages * 10 + 8; }
                        if (ch == "9") { pages = pages * 10 + 9; }
                    }
                    return pages * 4;
                }
            }
            nil;
        },
        err e => { nil; }
    }
    return 0;
}

fn quicksort(arr: [int], left: int, right: int) {
    var i = left;
    var j = right;
    var pivot = arr[(left + right) / 2];
    while (i <= j) {
        while (arr[i] < pivot) { i = i + 1; }
        while (arr[j] > pivot) { j = j - 1; }
        if (i <= j) {
            var tmp = arr[i];
            arr[i] = arr[j];
            arr[j] = tmp;
            i = i + 1;
            j = j - 1;
        }
    }
    if (left < j) { quicksort(arr, left, j); }
    if (i < right) { quicksort(arr, i, right); }
}

fn main(): int {
    var N = 1000000;
    var data: [int] = [];

    var t0 = clock();

    var seed = 12345;
    for (var i = 0; i < N; i = i + 1) {
        seed = (seed * 1103515245 + 12345) & 2147483647;
        data.append(seed % 1000000);
    }

    quicksort(data, 0, N - 1);

    var hash = 0;
    for (var i = 0; i < N; i = i + 1) {
        hash = (hash * 31 + data[i]) & 9223372036854775807;
    }

    var t1 = clock();
    var dur_ms = (t1 - t0) * 1000.0;
    var rss = get_rss_kb();

    print("LYMAR_APP_RUNTIME_MS={dur_ms}");
    print("LYMAR_APP_HASH={hash}");
    print("LYMAR_APP_RSS_KB={rss}");

    return 0;
}
