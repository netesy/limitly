// Benchmark: AST Stream Fusion vs. Unfused Execution Pipelines

import std.resource as resource;

// Reserve a working set of the requested size through the RT_MEMORY resource and
// report the measured allocation in KB (cross-platform, replacing the Linux-only
// /proc/self/statm read used to compare fused vs. unfused memory footprints).
fn measure_footprint_kb(footprint_bytes: int): int {
    var mem = resource.create_memory(footprint_bytes)? else {
        return 0;
    };
    var kb = mem.size() / 1024;
    mem.close();
    return kb;
}

// Opaque helper functions for Workload B (unfused pipeline)
fn unfused_map1(list_in: [int]): [int] {
    var res: [int] = [];
    for (var i = 0; i < len(list_in); i = i + 1) {
        res.append(list_in[i] * 3 + 1);
    }
    return res;
}

fn unfused_filter(list_in: [int]): [int] {
    var res: [int] = [];
    for (var i = 0; i < len(list_in); i = i + 1) {
        if (list_in[i] % 2 == 0) {
            res.append(list_in[i]);
        }
    }
    return res;
}

fn unfused_map2(list_in: [int]): [int] {
    var res: [int] = [];
    for (var i = 0; i < len(list_in); i = i + 1) {
        res.append(list_in[i] / 2);
    }
    return res;
}

fn unfused_fold(list_in: [int]): int {
    var acc = 0;
    for (var i = 0; i < len(list_in); i = i + 1) {
        acc = acc + list_in[i];
    }
    return acc;
}

fn main(): int {
    print("==================================================");
    print("      LIMITLY AST STREAM FUSION BENCHMARK        ");
    print("==================================================");

    var N = 5000000;
    print("Dataset Size: {N} elements");

    // Initialize dataset
    var data_a: [int] = [];
    var data_b: [int] = [];
    for (var i = 0; i < N; i = i + 1) {
        data_a.append(i);
        data_b.append(i);
    }

    // Workload A: AST Stream Fused Pipeline (no intermediate arrays materialized)
    var t_start_a = clock();

    var res_a = data_a.iter().map(fn(x) { x * 3 + 1 }).filter(fn(x) { x % 2 == 0 }).map(fn(x) { x / 2 }).fold(0, fn(acc, x) { acc + x });

    var t_end_a = clock();
    var dur_a_ms = (t_end_a - t_start_a) * 1000.0;
    // The fused stream allocates no intermediate buffers, so its footprint is 0.
    var mem_a_kb = measure_footprint_kb(0);

    // Workload B: Unfused Dynamic Execution (materializes 3 intermediate arrays)
    var t_start_b = clock();

    var b_step1 = unfused_map1(data_b);
    var len1 = len(b_step1);
    var b_step2 = unfused_filter(b_step1);
    var len2 = len(b_step2);
    var b_step3 = unfused_map2(b_step2);
    var len3 = len(b_step3);
    var res_b = unfused_fold(b_step3);

    var t_end_b = clock();
    var dur_b_ms = (t_end_b - t_start_b) * 1000.0;
    // The unfused pipeline materializes every stage; measure the combined footprint.
    var mem_b_kb = measure_footprint_kb((len1 + len2 + len3) * 8);

    // Validation
    assert(res_a == res_b, "Workload A and Workload B checksum mismatch!");

    print("\n--- Benchmark Results ---");
    print("Workload A (Fused) Result  : {res_a}");
    print("Workload B (Unfused) Result: {res_b}");
    print("Workload A Runtime (ms)    : {dur_a_ms}");
    print("Workload B Runtime (ms)    : {dur_b_ms}");
    print("Workload A Memory (KB)  : {mem_a_kb}");
    print("Workload B Memory (KB)  : {mem_b_kb}");

    return 0;
}
