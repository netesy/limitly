// Lymar Stdlib Benchmark Suite
import std.process as process;

fn get_rss_kb(): int {
    return process.peak_rss();
}

fn main(): int {
    // 1. String Ops
    var t0 = clock();
    var s = "";
    for (var i = 0; i < 100000; i = i + 1) {
        s = s + "a";
    }
    var target = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    var pos = _builtin_string_index_of(s, target);
    var t1 = clock();
    var string_ms = (t1 - t0) * 1000.0;

    // 2. Collections / Vector
    var t2 = clock();
    var lst: [int] = [];
    for (var i = 0; i < 500000; i = i + 1) {
        lst.append(i);
    }
    var total = 0;
    for (var i = 0; i < 500000; i = i + 1) {
        total = total + lst[i];
    }
    var t3 = clock();
    var vec_ms = (t3 - t2) * 1000.0;

    // 3. Stream Pipeline (fused)
    var t4 = clock();
    var pipe_res = lst.iter().map(fn(x) { x * 3 + 1 }).filter(fn(x) { x % 2 == 0 }).map(fn(x) { x / 2 }).fold(0, fn(acc, x) { acc + x });
    var t5 = clock();
    var pipe_ms = (t5 - t4) * 1000.0;

    // 4. Numeric Loop
    var t6 = clock();
    var acc = 0;
    for (var i = 0; i < 10000000; i = i + 1) {
        acc = (acc + i) ^ (i & 255);
    }
    var t7 = clock();
    var num_ms = (t7 - t6) * 1000.0;

    var rss_kb = get_rss_kb();

    print("LYMAR_STRING_MS={string_ms}");
    print("LYMAR_VEC_MS={vec_ms}");
    print("LYMAR_PIPE_MS={pipe_ms}");
    print("LYMAR_NUMERIC_MS={num_ms}");
    print("LYMAR_RSS_KB={rss_kb}");

    return 0;
}
