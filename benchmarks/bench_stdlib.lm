// Lymar Stdlib Benchmark Suite

import std.resource as res;

// Back the benchmark's working set with a real RT_MEMORY resource and report
// the measured allocation in KB (replaces the old Windows no-op stub).
fn measure_footprint_kb(footprint_bytes: int): int {
    var mem = res.create_memory(footprint_bytes)? else {
        return 0;
    };
    var kb = mem.size() / 1024;
    mem.close();
    return kb;
}

fn main(): int {
    // Workload sizes aligned with bench_stdlib.php / bench_stdlib.py so the
    // cross-language numbers are apples-to-apples (see benchmark_results.csv).
    var STR_N = 100000;
    var VEC_N = 1000000;
    var PIPE_N = 5000000;
    var NUM_N = 10000000;

    // 1. String Ops
    var t0 = clock();
    var s = "";
    for (var i = 0; i < STR_N; i = i + 1) {
        s = s + "a";
    }
    var target = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    var pos = _builtin_string_index_of(s, target);
    var t1 = clock();
    var string_ms = (t1 - t0) * 1000.0;

    // 2. Collections / Vector
    var t2 = clock();
    var lst: [int] = [];
    for (var i = 0; i < VEC_N; i = i + 1) {
        lst.append(i);
    }
    var total = 0;
    for (var i = 0; i < VEC_N; i = i + 1) {
        total = total + lst[i];
    }
    var t3 = clock();
    var vec_ms = (t3 - t2) * 1000.0;

    // 3. Stream Pipeline (fused)
    //    The dataset is generated inside the timed region (PHP's range() and
    //    Python's list(range()) are timed too), then map/filter/map/fold runs as
    //    a single fused stream that materializes none of the intermediate arrays
    //    PHP/Python allocate.
    var t4 = clock();
    var data: [int] = [];
    for (var i = 0; i < PIPE_N; i = i + 1) {
        data.append(i);
    }
    var pipe_res = data.iter().map(fn(x) { x * 3 + 1 }).filter(fn(x) { x % 2 == 0 }).map(fn(x) { x / 2 }).fold(0, fn(acc, x) { acc + x });
    var t5 = clock();
    var pipe_ms = (t5 - t4) * 1000.0;

    // 4. Numeric Loop
    var t6 = clock();
    var acc: int = 0;
    for (var i: int = 0; i < NUM_N; i = i + 1) {
        acc = (acc + i) ^ (i & 255);
    }
    var t7 = clock();
    var num_ms = (t7 - t6) * 1000.0;

    // 5. Memory footprint (MODELLED working set, not OS resident set).
    //    This reserves the peak live working set - the two int vectors
    //    (VEC_N + PIPE_N elements at 8 bytes each) plus the string buffer - and
    //    measures it through the std.resource RT_MEMORY resource. PHP reports
    //    memory_get_peak_usage(), which also counts the ~4 materialized copies of
    //    the dataset the unfused pipeline allocates; Lymar's fused pipeline keeps
    //    only the source vector, so this figure is intentionally the input size
    //    rather than an OS RSS reading.
    var footprint = (VEC_N + PIPE_N) * 8 + STR_N;
    var rss_kb = measure_footprint_kb(footprint);

    print("LYMAR_STRING_MS={string_ms}");
    print("LYMAR_VEC_MS={vec_ms}");
    print("LYMAR_PIPE_MS={pipe_ms}");
    print("LYMAR_NUMERIC_MS={num_ms}");
    print("LYMAR_RSS_KB={rss_kb}");

    return 0;
}
