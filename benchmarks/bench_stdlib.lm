// Lymar Stdlib Benchmark Suite

import std.io.file as file_mod;

fn get_rss_kb(): int {
    var file_res = file_mod.open("/proc/self/statm", "r");
    match (file_res) {
        val f_obj => {
            var f_concrete = f_obj as file_mod.File;
            var text_res = f_concrete.read();
            var text = "";
            match (text_res) {
                val t => { text = t; nil; },
                err e => { nil; }
            }
            f_concrete.close();
            var space1 = _builtin_string_index_of(text, " ");
            if (space1 >= 0) {
                var sub = _builtin_substring(text, space1 + 1, _builtin_len(text));
                var space2 = _builtin_string_index_of(sub, " ");
                if (space2 >= 0) {
                    var rss_str = _builtin_substring(sub, 0, space2);
                    var pages = 0;
                    for (var i = 0; i < _builtin_len(rss_str); i = i + 1) {
                        var ch = _builtin_substring(rss_str, i, i + 1);
                        if (ch == "0") { pages = pages * 10 + 0; }
                        if (ch == "1") { pages = pages * 10 + 1; }
                        if (ch == "2") { pages = pages * 10 + 2; }
                        if (ch == "3") { pages = pages * 10 + 3; }
                        if (ch == "4") { pages = pages * 10 + 4; }
                        if (ch == "5") { pages = pages * 10 + 5; }
                        if (ch == "6") { pages = pages * 10 + 6; }
                        if (ch == "7") { pages = pages * 10 + 7; }
                        if (ch == "8") { pages = pages * 10 + 8; }
                        if (ch == "9") { pages = pages * 10 + 9; }
                    }
                    return pages * 4;
                }
            }
            nil;
        },
        err e => { nil; }
    }
    return 0;
}

fn main(): int {
    // 1. String Ops
    var t0 = clock();
    var s = "";
    for (var i = 0; i < 100000; i = i + 1) {
        s = s + "a";
    }
    var target = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    var pos = _builtin_string_index_of(s, target);
    var t1 = clock();
    var string_ms = (t1 - t0) * 1000.0;

    // 2. Collections / Vector
    var t2 = clock();
    var lst: [int] = [];
    for (var i = 0; i < 1000000; i = i + 1) {
        lst.append(i);
    }
    var total = 0;
    for (var i = 0; i < 1000000; i = i + 1) {
        total = total + lst[i];
    }
    var t3 = clock();
    var vec_ms = (t3 - t2) * 1000.0;

    // 3. Stream Pipeline (fused)
    var t4 = clock();
    var pipe_res = lst.iter().map(fn(x) { x * 3 + 1 }).filter(fn(x) { x % 2 == 0 }).map(fn(x) { x / 2 }).fold(0, fn(acc, x) { acc + x });
    var t5 = clock();
    var pipe_ms = (t5 - t4) * 1000.0;

    // 4. Numeric Loop
    var t6 = clock();
    var acc = 0;
    for (var i = 0; i < 10000000; i = i + 1) {
        acc = (acc + i) ^ (i & 255);
    }
    var t7 = clock();
    var num_ms = (t7 - t6) * 1000.0;

    var rss_kb = get_rss_kb();

    print("LYMAR_STRING_MS={string_ms}");
    print("LYMAR_VEC_MS={vec_ms}");
    print("LYMAR_PIPE_MS={pipe_ms}");
    print("LYMAR_NUMERIC_MS={num_ms}");
    print("LYMAR_RSS_KB={rss_kb}");

    return 0;
}
