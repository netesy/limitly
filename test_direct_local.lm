// Test: Direct comparison - same code, local vs module
frame Counter {
    pub var count: int;

    pub init() {
        self.count = 0;
    }

    pub fn increment() {
        self.count = self.count + 1;
    }

    pub fn get_count(): int {
        return self.count;
    }
}

print("=== Local Frame (Baseline) ===");
var counter = Counter();
print("Initial: {counter.count}");
counter.increment();
print("After increment: {counter.count}");
