// Test 2: Import frame from module
import test_module_frame as test;

print("=== Test 2: Imported Frame Mutation ===");
var counter = test.Counter();
print("Initial count: {counter.count}");
counter.increment();
print("After increment(): {counter.count}");
counter.increment();
print("After 2nd increment(): {counter.count}");
var c = counter.get_count();
print("get_count() returns: {c}");
