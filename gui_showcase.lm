// GUI Showcase Application
// Demonstrates end-to-end std.app -> std.ui -> std.graphics -> std.gg -> VM Software Backend

import std.app as app;
import std.ui.application as ui_app;
import std.graphics.color as color;
import std.graphics.canvas as canvas;
import std.graphics.rect as rect;
import std.graphics.paint as paint;
import std.gg as gg;

fn main() {
    print("=== Limit Portable GUI Showcase ===");
    assert(gg.setup(), "gg setup failed");

    var config = app.default_window_config();
    config.title = "Limit GUI & Graphics Showcase";
    config.width = 800;
    config.height = 600;

    assert(app.app_init(config) == 1, "app init failed");

    // Clear background
    gg.begin_pass(800, 600, 0.1, 0.1, 0.15, 1.0);

    // Render UI background panel using std.graphics Canvas -> std.gg
    var cvs = canvas.Canvas(w=800.0, h=600.0);
    var p = paint.Paint();
    p.color_val = color.rgb(40, 120, 220); // Blue button panel

    cvs.draw_rect(rect.Rect(x=50.0, y=50.0, w=300.0, h=150.0), p);

    gg.end_pass();
    gg.commit();

    var my_app = ui_app.Application(n="ShowcaseApp");
    my_app.run();

    app.app_shutdown();
    gg.shutdown();
    print("GUI Showcase completed successfully.");
}

main();
