// GUI Showcase Application
// Demonstrates pure end-to-end std.app -> std.ui -> std.graphics -> std.gg -> VM Software Backend

import std.app as app;
import std.ui.application as ui_app;
import std.ui.window as window;
import std.ui.builder as builder;
import std.gg as gg;

fn main() {
    print("=== Limit Portable GUI Showcase ===");
    assert(gg.setup(), "gg setup failed");

    // Construct retained UI widget tree using std.ui builder
    var btn = builder.button_background("Interactive Button", builder.color_rgb8(50, 150, 240));
    var lbl = builder.text_color("Retained Mode UI Active", builder.color_rgb8(240, 240, 240));
    var root_bp = builder.vstack([btn, lbl]);

    var win = window.Window(t="Limit Showcase Window", w=800.0, h=600.0, bp=root_bp);

    var my_app = ui_app.Application(n="ShowcaseApp");
    my_app.windows = [win];
    my_app.run();

    app.app_shutdown();
    gg.shutdown();
    print("GUI Showcase completed successfully.");
}

main();
