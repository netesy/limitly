frame Node {
    pub var value: any;
    pub var next: any;

    pub init(v: any) {
        self.value = v;
        self.next = nil;
    }
}

frame LinkedList {
    pub var head: any;

    pub init() {
        self.head = nil;
    }

    pub fn get_value(): any {
        if (self.head == nil) return nil;
        var node: Node = self.head;
        return node.value;
    }
}

var list = LinkedList();
list.head = Node(42);
var result = list.get_value();
print("Result: {result}");
