frame Node {
    pub var value: any;
    pub var next: any;
    pub var prev: any;

    pub init(value: any) {
        self.value = value;
        self.next = nil;
        self.prev = nil;
    }
}

frame LinkedList {
    pub var head: any;
    pub var tail: any;
    pub var size: int;

    pub init() {
        self.head = nil;
        self.tail = nil;
        self.size = 0;
    }

    pub fn push_back(value: any) {
        var node = Node(value);
        if (self.tail == nil) {
            self.head = node;
            self.tail = node;
        } else {
            node.prev = self.tail;
            self.tail.next = node;
            self.tail = node;
        }
        self.size = self.size + 1;
    }

    pub fn pop_back(): any {
        if (self.tail == nil) return nil;
        var node: Node = self.tail;
        var value = node.value;
        self.tail = node.prev;
        if (self.tail == nil) {
            self.head = nil;
        } else {
            self.tail.next = nil;
        }
        self.size = self.size - 1;
        return value;
    }
}

var list = LinkedList();
list.push_back(1);
print("Pushed 1");
list.push_back(2);
print("Pushed 2");
var popped = list.pop_back();
print("After pop_back(), returned: {popped}");
print("After pop_back(), list.size: {list.size}");
