import std.collections.index as collections;

fn main(): int {
    var v = collections.Vector();
    print("Initial length: {v.len()}");
    v.push(1);
    print("Length after push(1): {v.len()}");
    v.append(2);
    print("Length after append(2): {v.len()}");
    v.insert(1, 9);
    print("Length after insert(1, 9): {v.len()}");
    print("Get(1): {v.get(1)}");
    return 0;
}
