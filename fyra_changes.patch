-        size_t size = i.getType() ? i.getType()->getSize() : 8;
-        if (isFloat) {
-            loadMnemonic = (size == 4) ? "fld.s" : "fld.d";
-        } else {
-            if (size == 1) loadMnemonic = "ld.b";
-            else if (size == 2) loadMnemonic = "ld.h";
-            else if (size == 4) loadMnemonic = "ld.w";
