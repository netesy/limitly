-    for suffix in [".exe", ""]:
-        p = test_dir / (name + suffix)
-        if p.exists():
-            return p
-    return None
-
-
-def run_suite(test_dir: Path, tests: List[str], verbose: bool) -> Dict[str, bool]:
-    results: Dict[str, bool] = {}
