-
-    auto it = func->getParameters().begin();
-    auto* base = it->get(); ++it;
-    auto* i = it->get();
-
-    // IR: base + (extsw(i) << 2) + 8
-    auto* extI = builder.createExtSW(i, i64Ty);
-    auto* c2 = ctx->getConstantInt(i64Ty, 2);
-    auto* shl = builder.createShl(extI, c2);
