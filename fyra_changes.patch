-    int64_t coeff = (1LL << shift);
-    int64_t newConstant = 0;
-    if (__builtin_mul_overflow(subExpr.constant, coeff, &newConstant)) return false;
-    if (!isConstantSafe(newConstant, bitWidth, true)) return false;
