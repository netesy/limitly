fn quicksort(arr: [int], left: int, right: int) {
    print("quicksort: left={left}, right={right}");
    var i = left;
    var j = right;
    var pivot = arr[(left + right) / 2];
    print("pivot={pivot}");
    while (i <= j) {
        while (arr[i] < pivot) { i = i + 1; }
        while (arr[j] > pivot) { j = j - 1; }
        if (i <= j) {
            var tmp = arr[i];
            arr[i] = arr[j];
            arr[j] = tmp;
            i = i + 1;
            j = j - 1;
        }
    }
    print("after loop: i={i}, j={j}");
    if (left < j) { quicksort(arr, left, j); }
    if (i < right) { quicksort(arr, i, right); }
}

fn main(): int {
    var data: [int] = [5, 2, 8, 1, 9];
    quicksort(data, 0, 4);
    print("Done: {data[0]}, {data[1]}, {data[2]}, {data[3]}, {data[4]}");
    return 0;
}
