// Test 1: Local frame with mutation (no module import)
frame Counter {
    pub var count: int;

    pub init() {
        self.count = 0;
    }

    pub fn increment() {
        self.count = self.count + 1;
    }

    pub fn get_count(): int {
        return self.count;
    }
}

print("=== Test 1: Local Frame Mutation ===");
var counter = Counter();
print("Initial count: {counter.count}");
counter.increment();
print("After increment(): {counter.count}");
counter.increment();
print("After 2nd increment(): {counter.count}");
var c = counter.get_count();
print("get_count() returns: {c}");
