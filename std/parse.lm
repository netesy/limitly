// Standard Library Parse Forwarder Module

import std.parse.index as parse_mod;

frame Parse {
    pub init() {}
    pub fn parse_int(value: str): any {
        var p = parse_mod.Parse();
        return p.parse_int(value);
    }
    pub fn parse_float(value: str): any {
        var p = parse_mod.Parse();
        return p.parse_float(value);
    }
    pub fn parse_bool(value: str): bool {
        var p = parse_mod.Parse();
        return p.parse_bool(value);
    }
}
