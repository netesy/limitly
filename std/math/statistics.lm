// std/math/statistics.lm
// Descriptive statistics including sum, arithmetic mean, median, variance, and standard deviation.

import std.math.arithmetic as arith;

/// Computes the sum of all numerical values in a collection.
///
/// @param items List of numerical values.
/// @return Total sum as a 64-bit float.
pub fn sum(items: [any]): float {
    var s = 0.0;
    for (var i = 0; i < len(items); i = i + 1) {
        s = s + (items[i] as float);
    }
    return s;
}

/// Computes the arithmetic mean (average) of a collection of numbers.
///
/// @pre len(items) > 0
/// @param items List of numerical values.
/// @return Mean value, or 0.0 if collection is empty.
pub fn mean(items: [any]): float {
    contract(len(items) > 0, "Collection must not be empty");
    if (len(items) == 0) return 0.0;
    return sum(items) / (len(items) as float);
}

/// Computes the statistical median (middle value) of a collection.
///
/// Automatically creates an internal copy to perform sorting, leaving the input collection unmodified.
///
/// @pre len(items) > 0
/// @param items List of numerical values.
/// @return Median value.
pub fn median(items: [any]): float {
    contract(len(items) > 0, "Collection must not be empty");
    var n = len(items);
    if (n == 0) return 0.0;

    // Create copy for sorting
    var copy: [any] = [] as [any];
    for (var i = 0; i < n; i = i + 1) {
        copy.append(items[i]);
    }
    var idx = 1;
    while (idx < n) {
        var key = copy[idx];
        var j = idx - 1;
        while (j >= 0 and copy[j] > key) {
            copy[j + 1] = copy[j];
            j = j - 1;
        }
        copy[j + 1] = key;
        idx = idx + 1;
    }

    if (n % 2 == 1) {
        return copy[n / 2] as float;
    } else {
        var a = copy[n / 2 - 1] as float;
        var b = copy[n / 2] as float;
        return (a + b) / 2.0;
    }
}

/// Computes the population variance (σ²) of a collection of values.
///
/// @pre len(items) >= 2
/// @param items List of numerical values.
/// @return Population variance.
pub fn variance(items: [any]): float {
    contract(len(items) >= 2, "Variance requires at least two data points");
    var n = len(items);
    if (n < 2) return 0.0;
    var m = mean(items);
    var s = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var diff = (items[i] as float) - m;
        s = s + diff * diff;
    }
    return s / (n as float);
}

/// Computes the population standard deviation (σ = √variance) of a collection.
///
/// @pre len(items) >= 2
/// @param items List of numerical values.
/// @return Population standard deviation.
pub fn stddev(items: [any]): float {
    contract(len(items) >= 2, "Standard deviation requires at least two data points");
    return arith.sqrt(variance(items));
}
