// std/yaml/parser.lm
// Line-based YAML document parser.

import std.yaml.value as value;
import std.string as std_string;

/// Line-based YAML document parser.
frame Parser {
    pub idx: int;
    pub text: str;

    /// Parses key-value mapping pairs from YAML text.
    pub fn parse_value(): value.Value {
        var keys: [str] = [];
        var vals: [any] = [];
        var length = len(self.text);
        while (self.idx < length) {
            var ch = _builtin_substring(self.text, self.idx, self.idx + 1);
            if (ch == "#" or ch == " " or ch == "\t" or ch == "\n" or ch == "\r") {
                while (self.idx < length and _builtin_substring(self.text, self.idx, self.idx + 1) != "\n") {
                    self.idx = self.idx + 1;
                }
                self.idx = self.idx + 1;
            } else {
                var key_start = self.idx;
                var find_colon = true;
                while (self.idx < length and find_colon) {
                    var cur_ch = _builtin_substring(self.text, self.idx, self.idx + 1);
                    if (cur_ch == ":") {
                        find_colon = false;
                    } else {
                        self.idx = self.idx + 1;
                    }
                }
                var key_raw = _builtin_substring(self.text, key_start, self.idx);
                self.idx = self.idx + 1; // skip ':'

                var key = std_string.trim(key_raw);

                var skip_val_spaces = true;
                while (self.idx < length and skip_val_spaces) {
                    var cur_ch = _builtin_substring(self.text, self.idx, self.idx + 1);
                    if (cur_ch == " " or cur_ch == "\t") {
                        self.idx = self.idx + 1;
                    } else {
                        skip_val_spaces = false;
                    }
                }

                var val_start = self.idx;
                var find_val_end = true;
                while (self.idx < length and find_val_end) {
                    var cur_ch = _builtin_substring(self.text, self.idx, self.idx + 1);
                    if (cur_ch == "\n" or cur_ch == "\r") {
                        find_val_end = false;
                    } else {
                        self.idx = self.idx + 1;
                    }
                }
                var val_raw = _builtin_substring(self.text, val_start, self.idx);
                self.idx = self.idx + 1; // skip newline

                // Trim trailing space from val_raw
                var val_trimmed = "";
                var val_raw_len = len(val_raw);
                var vr_idx = 0;
                while (vr_idx < val_raw_len) {
                    var vr_ch = _builtin_substring(val_raw, vr_idx, vr_idx + 1);
                    if (vr_ch != " " and vr_ch != "\t" and vr_ch != "\r") {
                        val_trimmed = val_trimmed + vr_ch;
                    }
                    vr_idx = vr_idx + 1;
                }

                var val_obj = value.make_string("");
                var val_len = len(val_trimmed);
                if (val_len > 0) {
                    var first_ch = _builtin_substring(val_trimmed, 0, 1);
                    if (first_ch == "\"") {
                        var inner = _builtin_substring(val_trimmed, 1, val_len - 1);
                        val_obj = value.make_string(inner);
                    } elif (val_trimmed == "true") {
                        val_obj = value.make_bool(true);
                    } elif (val_trimmed == "false") {
                        val_obj = value.make_bool(false);
                    } else {
                        var val_int = val_trimmed as int;
                        val_obj = value.make_number(val_int);
                    }
                }

                keys.append(key);
                vals.append(val_obj);
            }
        }
        return value.make_object(keys, vals);
    }
}

/// Parses YAML formatted text into an AST `Value` node.
///
/// @param text Raw YAML text.
/// @return Root `value.Value` object node.
pub fn parse(text: str): value.Value {
    var p = Parser(idx=0, text=text);
    return p.parse_value();
}
