// YAML Value representation

enum YAMLType {
    String,
    Number,
    Bool,
    Object
}

frame YAMLValue {
    pub kind: YAMLType;
    pub str_val: str;
    pub num_val: int;
    pub bool_val: bool;
    pub obj_keys: [str];
    pub obj_vals: [any];

    pub fn is_string(): bool { return self.kind == YAMLType.String; }
    pub fn is_number(): bool { return self.kind == YAMLType.Number; }
    pub fn is_bool(): bool { return self.kind == YAMLType.Bool; }
    pub fn is_object(): bool { return self.kind == YAMLType.Object; }
}

pub fn make_string(v: str): YAMLValue {
    var keys: [str] = [];
    var vals: [any] = [];
    return YAMLValue(kind=YAMLType.String, str_val=v, num_val=0, bool_val=false, obj_keys=keys, obj_vals=vals);
}

pub fn make_number(v: int): YAMLValue {
    var keys: [str] = [];
    var vals: [any] = [];
    return YAMLValue(kind=YAMLType.Number, str_val="", num_val=v, bool_val=false, obj_keys=keys, obj_vals=vals);
}

pub fn make_bool(v: bool): YAMLValue {
    var keys: [str] = [];
    var vals: [any] = [];
    return YAMLValue(kind=YAMLType.Bool, str_val="", num_val=0, bool_val=v, obj_keys=keys, obj_vals=vals);
}

pub fn make_object(k: [str], v: [any]): YAMLValue {
    return YAMLValue(kind=YAMLType.Object, str_val="", num_val=0, bool_val=false, obj_keys=k, obj_vals=v);
}
