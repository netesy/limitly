// std/yaml/value.lm
// YAML Value AST node representation and primitive constructors.

/// Enumeration of YAML value node kinds.
enum Type {
    String,
    Number,
    Bool,
    Object
}

/// Represents an immutable YAML value AST node.
///
/// Encapsulates string, integer, boolean, and key-value mapping objects.
frame Value {
    pub kind: Type;
    pub str_val: str;
    pub num_val: int;
    pub bool_val: bool;
    pub obj_keys: [str];
    pub obj_vals: [any];

    /// Checks if the value is a string.
    pub fn is_string(): bool { return self.kind == Type.String; }

    /// Checks if the value is an integer number.
    pub fn is_number(): bool { return self.kind == Type.Number; }

    /// Checks if the value is a boolean.
    pub fn is_bool(): bool { return self.kind == Type.Bool; }

    /// Checks if the value is an object mapping.
    pub fn is_object(): bool { return self.kind == Type.Object; }
}

/// Constructs a YAML string value node.
///
/// @param v String content.
/// @return Populated `Value` node.
pub fn make_string(v: str): Value {
    var keys: [str] = [];
    var vals: [any] = [];
    return Value(kind=Type.String, str_val=v, num_val=0, bool_val=false, obj_keys=keys, obj_vals=vals);
}

/// Constructs a YAML integer number value node.
///
/// @param v Integer value.
/// @return Populated `Value` node.
pub fn make_number(v: int): Value {
    var keys: [str] = [];
    var vals: [any] = [];
    return Value(kind=Type.Number, str_val="", num_val=v, bool_val=false, obj_keys=keys, obj_vals=vals);
}

/// Constructs a YAML boolean value node.
///
/// @param v Boolean value.
/// @return Populated `Value` node.
pub fn make_bool(v: bool): Value {
    var keys: [str] = [];
    var vals: [any] = [];
    return Value(kind=Type.Bool, str_val="", num_val=0, bool_val=v, obj_keys=keys, obj_vals=vals);
}

/// Constructs a YAML object mapping node.
///
/// @pre len(k) == len(v)
/// @param k List of string keys.
/// @param v Parallel list of value nodes.
/// @return Populated `Value` node.
pub fn make_object(k: [str], v: [any]): Value {
    contract(len(k) == len(v), "Key and value counts must match");
    return Value(kind=Type.Object, str_val="", num_val=0, bool_val=false, obj_keys=k, obj_vals=v);
}
