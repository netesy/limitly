// YAML Writer Module

import std.yaml.value as value;

pub fn stringify(val_any: any): str {
    var jval = val_any as value.Value;
    if (jval == nil) {
        return "";
    }

    match (jval.kind) {
        value.Type.String => {
            return "\"" + jval.str_val + "\"";
        },
        value.Type.Number => {
            var num = jval.num_val;
            return "{num}";
        },
        value.Type.Bool => {
            if (jval.bool_val == true) {
                return "true";
            }
            return "false";
        },
        value.Type.Object => {
            var res = "";
            var i = 0;
            var keys_len = len(jval.obj_keys);
            while (i < keys_len) {
                res = res + jval.obj_keys[i] + ": " + stringify(jval.obj_vals[i]) + "\n";
                i = i + 1;
            }
            return res;
        },
        _ => {
            return "";
        }
    }
}
