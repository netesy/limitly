// std/search/index.lm
// Compatibility re-export forwarding to std.algorithm.search and std.algorithm.binary_search

import std.algorithm.search as search;
import std.algorithm.binary_search as bs;

pub fn linear_search(items: [any], target: any): int {
    return search.linear_search(items, target);
}

pub fn binary_search(items: [any], target: any): int {
    return bs.binary_search(items, target);
}

pub fn lower_bound(items: [any], target: any): int {
    return bs.lower_bound(items, target);
}

pub fn upper_bound(items: [any], target: any): int {
    return bs.upper_bound(items, target);
}

pub fn equal_range(items: [any], target: any): (int, int) {
    return bs.equal_range(items, target);
}

pub fn interpolation_search(items: [int], target: int): int {
    return search.interpolation_search(items, target);
}
