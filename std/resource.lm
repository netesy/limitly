// Standard Library Resource Module

import std.internal.runtime as rt;

pub frame Resource {
    pub var handle: int;
    pub var kind: int;
    pub var is_open_val: bool;

    pub init(h: int, k: int) {
        self.handle = h;
        self.kind = k;
        self.is_open_val = (h != -1);
    }

    pub fn close(): nil? {
        if (self.is_open_val) {
            rt.destroy(self.handle);
            self.is_open_val = false;
        }
        return ok(nil);
    }

    pub fn is_open(): bool {
        return self.is_open_val;
    }

    pub fn _handle(): int {
        return self.handle;
    }
}

pub frame Reader {
    pub var resource: Resource;
    pub init(r: Resource) {
        self.resource = r;
    }
    pub fn read(args: [any]): any {
        return rt.call(self.resource.handle, rt.OP_READ, args);
    }
}

pub frame Writer {
    pub var resource: Resource;
    pub init(r: Resource) {
        self.resource = r;
    }
    pub fn write(args: [any]): any {
        return rt.call(self.resource.handle, rt.OP_WRITE, args);
    }
}

frame Pollable {
    pub var resource: Resource;
    pub init(r: Resource) {
        self.resource = r;
    }
    pub fn poll(): bool {
        var result = rt.call(self.resource.handle, rt.OP_POLL, []);
        return (result == true);
    }
}

frame Poller {
    pub var resource: Resource;
    pub init(r: Resource) {
        self.resource = r;
    }
    pub fn poll(): bool {
        var result = rt.call(self.resource.handle, rt.OP_POLL, []);
        return (result == true);
    }
}

frame Connector {
    pub var resource: Resource;
    pub init(r: Resource) {
        self.resource = r;
    }
    pub fn connect(args: [any]): bool {
        var result = rt.call(self.resource.handle, rt.OP_CONNECT, args);
        return (result == true);
    }
}

frame Binder {
    pub var resource: Resource;
    pub init(r: Resource) {
        self.resource = r;
    }
    pub fn bind(args: [any]): bool {
        var result = rt.call(self.resource.handle, rt.OP_BIND, args);
        return (result == true);
    }
}

pub frame Listener {
    pub var resource: Resource;
    pub init(r: Resource) {
        self.resource = r;
    }
    pub fn listen(args: [any]): bool {
        var result = rt.call(self.resource.handle, rt.OP_LISTEN, args);
        return (result == true);
    }
}

pub frame Accepter {
    pub var resource: Resource;
    pub init(r: Resource) {
        self.resource = r;
    }
    pub fn accept(): int {
        var result = rt.call(self.resource.handle, rt.OP_ACCEPT, []);
        if (result == nil) return -1;
        return result as int;
    }
}

pub var stdout: Resource = Resource(h=0, k=rt.RT_STDOUT);
pub var stderr: Resource = Resource(h=1, k=rt.RT_STDERR);

pub fn create_hash_engine(): Resource? {
    var h = rt.create(rt.RT_HASH_ENGINE, []);
    if (h == -1) return err();
    return ok(Resource(h=h, k=rt.RT_HASH_ENGINE));
}

pub fn create_dns_resolver(): Resource? {
    var h = rt.create(rt.RT_DNS_RESOLVER, []);
    if (h == -1) return err();
    return ok(Resource(h=h, k=rt.RT_DNS_RESOLVER));
}

pub fn open_file(path: str, mode: str): Resource? {
    var h = rt.create(rt.RT_FILE, []);
    if (h == -1) return err();
    var success = rt.call(h, rt.OP_OPEN, [path, mode]);
    if (success != true) {
        rt.destroy(h);
        return err();
    }
    return ok(Resource(h=h, k=rt.RT_FILE));
}

pub fn create_fs_resource(): Resource? {
    var h = rt.create(rt.RT_FILE, []);
    if (h == -1) return err();
    return ok(Resource(h=h, k=rt.RT_FILE));
}

pub fn create_socket(): Resource? {
    var h = rt.create(rt.RT_SOCKET, []);
    if (h == -1) return err();
    return ok(Resource(h=h, k=rt.RT_SOCKET));
}

pub fn create_udp_socket(): Resource? {
    var h = rt.create(rt.RT_UDP_SOCKET, []);
    if (h == -1) return err();
    return ok(Resource(h=h, k=rt.RT_UDP_SOCKET));
}

pub fn create_websocket(): Resource? {
    var h = rt.create(rt.RT_WEBSOCKET, []);
    if (h == -1) return err();
    return ok(Resource(h=h, k=rt.RT_WEBSOCKET));
