// std/geometry/index.lm
// Public entrypoint and facade for std.geometry. Geometric shapes, intersections, bounding boxes, and containment.

import std.math as math;

/// Axis-aligned 2D rectangle defined by position (x, y) and dimensions (width, height).
///
/// @example
/// ```lymar
/// var r = Rect(0.0, 0.0, 100.0, 50.0);
/// assert(r.contains(10.0, 10.0));
/// ```
frame Rect {
    pub var x: float;
    pub var y: float;
    pub var w: float;
    pub var h: float;
    
    pub init(x: float = 0.0, y: float = 0.0, w: float = 0.0, h: float = 0.0) {
        self.x = x;
        self.y = y;
        self.w = w;
        self.h = h;
    }
    
    /// Tests whether a 2D coordinate lies within the boundary of this rectangle.
    ///
    /// @param px Target X coordinate.
    /// @param py Target Y coordinate.
    /// @return True if point is inside or on the boundary.
    pub fn contains(px: float, py: float): bool {
        return px >= self.x and px <= self.x + self.w and py >= self.y and py <= self.y + self.h;
    }
    
    /// Tests whether this rectangle overlaps with another rectangle.
    ///
    /// @param other Another rectangle to test intersection with.
    /// @return True if bounding boxes overlap.
    pub fn intersects(other: Rect): bool {
        return not (other.x > self.x + self.w or 
                    other.x + other.w < self.x or 
                    other.y > self.y + self.h or 
                    other.y + other.h < self.y);
    }
    
    /// Calculates the area of the rectangle.
    ///
    /// @return Non-negative area (width * height).
    pub fn area(): float { 
        return self.w * self.h; 
    }
}

/// 2D circle defined by center (x, y) and radius r.
///
/// @example
/// ```lymar
/// var c = Circle(0.0, 0.0, 10.0);
/// assert(c.contains(5.0, 5.0));
/// ```
frame Circle {
    pub var x: float;
    pub var y: float;
    pub var r: float;
    
    pub init(x: float = 0.0, y: float = 0.0, r: float = 0.0) {
        contract(r >= 0.0, "radius must be non-negative");
        self.x = x;
        self.y = y;
        self.r = r;
    }
    
    /// Tests whether a 2D coordinate lies within or on this circle.
    ///
    /// @param px Target X coordinate.
    /// @param py Target Y coordinate.
    /// @return True if point is within radius.
    pub fn contains(px: float, py: float): bool {
        var dx = px - self.x;
        var dy = py - self.y;
        return dx * dx + dy * dy <= self.r * self.r;
    }
    
    /// Calculates the area enclosed by the circle.
    ///
    /// @return Circle area (π * r²).
    pub fn area(): float { 
        return math.PI * self.r * self.r; 
    }
}
