// std/geometry/index.lm
// Public entrypoint and facade for std.geometry. Geometric shapes, intersections,
// bounding boxes, containment, and 2D collision/raycast queries.

pub import std.geometry.shapes show Rect, Circle, rect;
pub import std.geometry.collision show
    Ray2D, ray2d,
    Contact2D, RayHit2D,
    test_aabb_aabb, test_circle_circle, test_circle_aabb,
    raycast_aabb, raycast_circle;
