// std/geometry/shapes.lm
// Canonical 2D geometric primitives: axis-aligned rectangles and circles.

import std.math as math;
import std.math.vector2 show Vector2;

/// Axis-aligned 2D rectangle defined by position (x, y) and dimensions (width, height).
frame Rect {
    pub var x: float = 0.0;
    pub var y: float = 0.0;
    pub var w: float = 0.0;
    pub var h: float = 0.0;

    pub init(x: float = 0.0, y: float = 0.0, w: float = 0.0, h: float = 0.0) {
        self.x = x;
        self.y = y;
        self.w = w;
        self.h = h;
    }

    pub fn contains(px: float, py: float): bool {
        return px >= self.x and px <= self.x + self.w and py >= self.y and py <= self.y + self.h;
    }

    pub fn contains_vec(p: Vector2): bool {
        return self.contains(p.x, p.y);
    }

    pub fn intersects(other: Rect): bool {
        return not (other.x > self.x + self.w or
            other.x + other.w < self.x or
            other.y > self.y + self.h or
            other.y + other.h < self.y);
    }

    pub fn intersection(other: Rect): Rect {
        val ix = math.max(self.x, other.x);
        val iy = math.max(self.y, other.y);
        val rx = math.min(self.x + self.w, other.x + other.w);
        val by = math.min(self.y + self.h, other.y + other.h);
        if (rx > ix and by > iy) {
            return Rect(x=ix, y=iy, w=rx - ix, h=by - iy);
        }
        return Rect();
    }

    pub fn union_rect(other: Rect): Rect {
        val min_x = math.min(self.x, other.x);
        val min_y = math.min(self.y, other.y);
        val max_x = math.max(self.x + self.w, other.x + other.w);
        val max_y = math.max(self.y + self.h, other.y + other.h);
        return Rect(x=min_x, y=min_y, w=max_x - min_x, h=max_y - min_y);
    }

    pub fn center(): Vector2 {
        return Vector2(self.x + self.w * 0.5, self.y + self.h * 0.5);
    }

    pub fn expand(amount: float): Rect {
        return Rect(
            x=self.x - amount,
            y=self.y - amount,
            w=self.w + amount * 2.0,
            h=self.h + amount * 2.0
        );
    }

    pub fn clamp_point(p: Vector2): Vector2 {
        val cx = math.clamp(p.x, self.x, self.x + self.w);
        val cy = math.clamp(p.y, self.y, self.y + self.h);
        return Vector2(cx, cy);
    }

    pub fn area(): float {
        return self.w * self.h;
    }
}

/// 2D circle defined by a center point and radius.
frame Circle {
    pub var center: Vector2;
    pub var radius: float;

    pub init(center: Vector2 = Vector2(), radius: float = 0.0) {
        contract(radius >= 0.0, "radius must be non-negative");
        self.center = center;
        self.radius = radius;
    }

    pub fn contains(p: Vector2): bool {
        return self.center.dist_sq(p) <= (self.radius * self.radius);
    }

    pub fn contains_point(px: float, py: float): bool {
        return self.contains(Vector2(px, py));
    }

    pub fn intersects_circle(other: Circle): bool {
        var r_sum = self.radius + other.radius;
        return self.center.dist_sq(other.center) <= (r_sum * r_sum);
    }

    pub fn intersects_rect(r: Rect): bool {
        var closest_x = math.clamp(self.center.x, r.x, r.x + r.w);
        var closest_y = math.clamp(self.center.y, r.y, r.y + r.h);
        var closest = Vector2(closest_x, closest_y);
        return self.center.dist_sq(closest) <= (self.radius * self.radius);
    }

    pub fn area(): float {
        return math.PI * self.radius * self.radius;
    }
}

/// Convenience constructor for an axis-aligned rectangle.
pub fn rect(x: float = 0.0, y: float = 0.0, w: float = 0.0, h: float = 0.0): Rect {
    return Rect(x=x, y=y, w=w, h=h);
}
