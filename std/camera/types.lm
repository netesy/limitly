// std/camera/types.lm
// Type definitions for 2D and 3D camera systems.

import std.math as math;

enum CameraType {
    Perspective,
    Orthographic
}

frame Vec2 {
    pub var x: float;
    pub var y: float;

    pub init(x: float = 0.0, y: float = 0.0) {
        self.x = x;
        self.y = y;
    }

    pub fn add(other: Vec2): Vec2 {
        return Vec2(x=self.x + other.x, y=self.y + other.y);
    }

    pub fn sub(other: Vec2): Vec2 {
        return Vec2(x=self.x - other.x, y=self.y - other.y);
    }

    pub fn scale(s: float): Vec2 {
        return Vec2(x=self.x * s, y=self.y * s);
    }

    pub fn mul(other: Vec2): Vec2 {
        return Vec2(x=self.x * other.x, y=self.y * other.y);
    }

    pub fn div(s: float): Vec2 {
        if (s == 0.0) { return Vec2(); }
        return Vec2(x=self.x / s, y=self.y / s);
    }

    pub fn dot(other: Vec2): float {
        return self.x * other.x + self.y * other.y;
    }

    pub fn cross(other: Vec2): float {
        return self.x * other.y - self.y * other.x;
    }

    pub fn mag_sq(): float {
        return self.x * self.x + self.y * self.y;
    }

    pub fn mag(): float {
        return math.sqrt(self.mag_sq());
    }

    pub fn normalize(): Vec2 {
        var m = self.mag();
        if (m > 0.0) {
            return Vec2(x=self.x / m, y=self.y / m);
        }
        return Vec2(x=0.0, y=0.0);
    }

    pub fn dist(other: Vec2): float {
        return self.sub(other).mag();
    }

    pub fn lerp(target_pos: Vec2, t: float): Vec2 {
        return Vec2(
            x=self.x + (target_pos.x - self.x) * t,
            y=self.y + (target_pos.y - self.y) * t
        );
    }

    pub fn rotate(radians: float): Vec2 {
        var c = math.cos(radians);
        var s = math.sin(radians);
        return Vec2(
            x=self.x * c - self.y * s,
            y=self.x * s + self.y * c
        );
    }

    pub fn perpendicular(): Vec2 {
        return Vec2(x=-self.y, y=self.x);
    }

    pub fn reflect(normal: Vec2): Vec2 {
        var d = self.dot(normal) * 2.0;
        return self.sub(normal.scale(d));
    }

    pub fn clamp_length(max_len: float): Vec2 {
        var l_sq = self.mag_sq();
        if (l_sq > max_len * max_len and l_sq > 0.0) {
            return self.normalize().scale(max_len);
        }
        return Vec2(x=self.x, y=self.y);
    }
}
