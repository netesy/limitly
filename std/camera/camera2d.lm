// std/camera/camera2d.lm
// Universal 2D Camera with projection, tracking, zoom, rotation, and trauma-based screen shake.

import std.math as math;
import std.camera.types show Vector2;

frame Camera2D {
    pub var target: Vector2;
    pub var offset: Vector2;
    pub var rotation: float;
    pub var zoom: float;

    // Screenshake (trauma-based shake system)
    pub var trauma: float;
    pub var trauma_decay: float;
    pub var max_shake_offset: float;
    pub var max_shake_angle: float;
    pub var shake_time: float;
    pub var shake_offset: Vector2;
    pub var shake_rotation: float;

    pub init(target: Vector2 = Vector2(), offset: Vector2 = Vector2(), zoom: float = 1.0, rotation: float = 0.0) {
        self.target = target;
        self.offset = offset;
        self.zoom = zoom;
        if (self.zoom <= 0.0) {
            self.zoom = 1.0;
        }
        self.rotation = rotation;

        self.trauma = 0.0;
        self.trauma_decay = 1.2;
        self.max_shake_offset = 18.0;
        self.max_shake_angle = 0.08;
        self.shake_time = 0.0;
        self.shake_offset = Vector2();
        self.shake_rotation = 0.0;
    }

    pub fn set_viewport(width: float, height: float): nil {
        self.offset = Vector2(width * 0.5, height * 0.5);
    }

    pub fn screen_to_world(screen_pos: Vector2): Vector2 {
        val total_shake_rot = self.rotation + self.shake_rotation;
        var p = screen_pos.sub(self.offset).sub(self.shake_offset);
        if (self.zoom != 0.0) {
            p = p.scale(1.0 / self.zoom);
        }
        if (total_shake_rot != 0.0) {
            p = p.rotate(-total_shake_rot);
        }
        return p.add(self.target);
    }

    pub fn world_to_screen(world_pos: Vector2): Vector2 {
        val total_shake_rot = self.rotation + self.shake_rotation;
        var p = world_pos.sub(self.target);
        if (total_shake_rot != 0.0) {
            p = p.rotate(total_shake_rot);
        }
        p = p.scale(self.zoom);
        return p.add(self.offset).add(self.shake_offset);
    }

    pub fn follow(target_pos: Vector2, smoothness: float = 0.1, dt: float = 0.016): nil {
        val s = math.clamp(smoothness * dt * 60.0, 0.0, 1.0);
        self.target = self.target.lerp(target_pos, s);
    }

    pub fn add_trauma(amount: float): nil {
        self.trauma = math.clamp(self.trauma + amount, 0.0, 1.0);
    }

    pub fn update(dt: float): nil {
        self.shake_time = self.shake_time + dt;
        if (self.trauma > 0.0) {
            self.trauma = math.max(0.0, self.trauma - self.trauma_decay * dt);
            val shake = self.trauma * self.trauma;

            val s1 = math.sin(self.shake_time * 38.0);
            val s2 = math.cos(self.shake_time * 47.0);
            val s3 = math.sin(self.shake_time * 31.0);

            self.shake_offset = Vector2(
                s1 * self.max_shake_offset * shake,
                s2 * self.max_shake_offset * shake
            );
            self.shake_rotation = s3 * self.max_shake_angle * shake;
        } else {
            self.shake_offset = Vector2(0.0, 0.0);
            self.shake_rotation = 0.0;
        }
    }
}
