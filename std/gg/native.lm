// std/gg/native.lm — Pure-Lymar hardware-accelerated 2D pipeline.
//
// Drives std.native.vulkan on Linux/Windows and std.native.d3d11 on
// Windows. Bypasses the C++ runtime's sokol_gfx layer entirely.
//
// Uses analytical Signed Distance Field (SDF) shaders for mathematically
// smooth sub-pixel anti-aliasing, rounded corners, hollow borders, and
// continuous Gaussian drop shadows in 1 single quad per primitive.
//
// Pipeline contract:
//   - attach(hwnd, w, h): binds the driver to a platform window.
//   - begin_pass(w, h, r, g, b, a): clears and opens a frame.
//   - draw_rect(x, y, w, h, r, g, b, a): emits an anti-aliased rectangle.
//   - draw_rect_rounded(x, y, w, h, rad, r, g, b, a): emits an anti-aliased rounded rectangle.
//   - draw_rect_border(x, y, w, h, rad, border_w, r, g, b, a): emits an anti-aliased outline border.
//   - draw_shadow(x, y, w, h, r, g, b, a, radius, blur): emits a soft Gaussian drop shadow.
//   - draw_tri(x1, y1, x2, y2, x3, y3, r, g, b, a): emits a solid triangle.
//   - draw_text(text, x, y, r, g, b, a, scale): emits glyphs from font atlas with pixel snapping.
//   - measure_text(text, scale): measures text advance width.
//   - get_line_height(scale): gets line height.
//   - push_clip / pop_clip: manages hardware scissor clip stack.
//   - end_pass(): finishes current pass.
//   - commit(): submits draw calls to GPU and presents swapchain.
//   - save_screenshot(path): saves current framebuffer to PNG.

import std.ffi as ffi;
import std.math as math;
import std.os.identity as osid;
import std.string.replace as replace;
import std.native.vulkan as vk;
import std.native.d3d11 as d3d;
import std.font.sdf_atlas as sdfatlas;
import std.font.cov_atlas as covatlas;
import std.text.utf8 as utf8;
import std.os.environment as osenv;

// ── state ────────────────────────────────────────────────────────────

var _prefer: str = "";
var _drv: str = "";
// _is_vk mirrors (_drv == "vulkan") as an int: str == allocates a boxed
// comparison result per call under AOT (~90MB/s in per-vertex hot loops).
var _is_vk: int = 0;
var _w: int = 0;
var _h: int = 0;
var _attached: int = 0;
var _frame_open: int = 0;
var _pipe_ready: int = 0;

var _vs: int = 0;
var _ps: int = 0;
var _il: int = 0;
var _blend: int = 0;
var _rast: int = 0;
var _depth: int = 0;
var _vb: int = 0;
var _vb_cap: int = 0;

var _atlas_rgba: int = 0;
var _atlas_tex: int = 0;
var _atlas_smp: int = 0;
var _sdf_tex: int = 0;      // SRV bound at slot 1
var _sdf_tex_raw: int = 0;  // ID3D11Texture2D for UpdateSubresource
var _sdf_smp: int = 0;
var _sdf_on: int = 0;
var _glyphs_buf: int = 0;
var _metrics_buf: int = 0;
var _sizes_buf: int = 0;


// persistent vertex scratch: raw ptr (p2i'd) + vert count
// 48 bytes per vertex (12 floats)
var _vdata: int = 0;
var _vdata_cap: int = 0;
var _vcount: int = 0;

// scissor stack: flat array [x0, y0, x1, y1, ...]
var _clip: [int] = [];
var _clip_n: int = 0;

// ── persistent allocation tracking ───────────────────────────────────

var _persist_pages: [int] = [];

fn alloc_persist(bytes: int): int {
    unsafe {
        var p = ffi.alloc(bytes);
        if (p == 0) { return 0; }
        ffi.memset(p, 0, bytes);
        _persist_pages.append(p);
        return p;
    }
}

// ── driver dispatch wrappers ─────────────────────────────────────────

fn drv_attach(hwnd: int, w: int, h: int): int {
    if (_is_vk != 0) { return vk.gfx_attach(hwnd, w, h); }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { return d3d.gfx_attach(hwnd, w, h); }
    return 0;
}
fn drv_detach(): nil {
    if (_is_vk != 0) { vk.gfx_detach(); return; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_detach(); return; }
}
fn drv_resize(w: int, h: int): int {
    if (_is_vk != 0) { return vk.gfx_resize(w, h); }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { return d3d.gfx_resize(w, h); }
    return 0;
}
fn drv_begin_frame(): int {
    if (_is_vk != 0) { return vk.gfx_begin_frame(); }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { return d3d.gfx_begin_frame(); }
    return 0;
}
fn drv_end_frame(): int {
    if (_is_vk != 0) { return vk.gfx_end_frame(); }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_end_frame(); return 1; }
    return 0;
}
fn drv_clear(r: float, g: float, b: float, a: float): nil {
    if (_is_vk != 0) { vk.gfx_clear(r, g, b, a); return; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_clear(r, g, b, a); return; }
}
fn drv_set_shaders(vs: int, ps: int): nil {
    if (_is_vk != 0) { vk.gfx_set_shaders(vs, ps); return; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_set_shaders(vs, ps); return; }
}
fn drv_set_input_layout(il: int): nil {
    if (_is_vk != 0) { vk.gfx_set_input_layout(il); return; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_set_input_layout(il); return; }
}
fn drv_set_blend_state(b: int): nil {
    if (_is_vk != 0) { vk.gfx_set_blend_state(b); return; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_set_blend_state(b); return; }
}
fn drv_set_raster_state(r: int): nil {
    if (_is_vk != 0) { vk.gfx_set_raster_state(r); return; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_set_raster_state(r); return; }
}
fn drv_set_depth_state(d: int, s: int): nil {
    if (_is_vk != 0) { vk.gfx_set_depth_state(d, s); return; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_set_depth_state(d, s); return; }
}
fn drv_set_topology(t: int): nil {
    if (_is_vk != 0) { vk.gfx_set_topology(t); return; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_set_topology(t); return; }
}
fn drv_dyn_buf(bytes: int, bind: int, stride: int): int {
    if (_is_vk != 0) { return vk.gfx_buffer_create_dynamic(bytes, bind, stride); }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { return d3d.gfx_buffer_create_dynamic(bytes, bind, stride); }
    return 0;
}
fn drv_buf_update(buf: int, src: int, bytes: int): int {
    if (_is_vk != 0) { return vk.gfx_buffer_update(buf, src, bytes, bytes); }
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        return d3d.gpu_buffer_write(buf, src, bytes);
    }
    return 0;
}
fn drv_set_vb(slot: int, buf: int, stride: int, off: int): nil {
    if (_is_vk != 0) { vk.gfx_set_vertex_buffer(slot, buf, stride, off); return; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_set_vertex_buffer(slot, buf, stride, off); return; }
}
fn drv_draw(count: int, start: int): nil {
    if (_is_vk != 0) { vk.gfx_draw(count, start); return; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_draw(count, start); return; }
}
fn drv_scissor(x: int, y: int, w: int, h: int): nil {
    if (_is_vk != 0) { vk.gfx_set_scissor(x, y, w, h); return; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_set_scissor(x, y, w, h); return; }
}

fn drv_create_tex_rgba(w: int, h: int, ptr: int): int {
    if (_is_vk != 0) { return vk.gfx_texture_create_rgba(w, h, ptr); }
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        var tex = d3d.gfx_texture_create_rgba(w, h, ptr);
        if (tex == 0) { return 0; }
        return d3d.gpu_srv_create(tex);
    }
    return 0;
}
fn drv_create_sampler(filter: int, addr_u: int, addr_v: int): int {
    if (_is_vk != 0) { return vk.gfx_sampler_create(filter, addr_u, addr_v); }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { return d3d.gfx_sampler_create(filter, addr_u, addr_v); }
    return 0;
}

fn drv_update_tex_rgba(tex: int, w: int, h: int, ptr: int): int {
    if (_is_vk != 0) { return vk.gfx_update_texture_rgba(tex, w, h, ptr); }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { return d3d.gfx_update_texture_rgba(tex, w, h, ptr); }
    return 0;
}

fn drv_set_texture(slot: int, srv: int): nil {
    if (_is_vk != 0) { vk.gfx_ps_set_shader_resource(slot, srv); return; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_ps_set_shader_resource(slot, srv); return; }
}
fn drv_set_sampler(slot: int, smp: int): nil {
    if (_is_vk != 0) { vk.gfx_ps_set_sampler(slot, smp); return; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_ps_set_sampler(slot, smp); return; }
}

fn ensure_font_atlas(): int {
    unsafe {
        if (_atlas_rgba == 0) {
            // Atlas: 2048x2048 packs 39 integer-px tiers (10..48).
            // Glyph/metric buffers are sized for the tier count;
            // size_idx*3456 stride is per-tier (96 records * 36 bytes).
            var atlas_w = 2048;
            var atlas_h = 2048;
            _atlas_rgba = alloc_persist(atlas_w * atlas_h * 4);
            _glyphs_buf = alloc_persist(39 * 96 * 36);
            _metrics_buf = alloc_persist(39 * 3 * 4);
            _sizes_buf = alloc_persist(39 * 4);
            if (_atlas_rgba == 0 or _glyphs_buf == 0 or _metrics_buf == 0 or _sizes_buf == 0) {
                return 0;
            }

            // One baked tier per integer pixel size 10..48 — near-free
            // font sizing: any requested px snaps to the nearest 1px tier.
            var ti = 0;
            var tpx = 10;
            while (tpx <= 48) {
                ffi.store_f32(ffi.ptr_add(_sizes_buf, ti * 4), tpx as float);
                ti = ti + 1;
                tpx = tpx + 1;
            }

            // Native bake — same buffers/semantics as the former stb
            // init_font_atlas_multi FFI call.
            var baked = covatlas.bake("", atlas_w, atlas_h, _sizes_buf, 39,
                                      _atlas_rgba, _glyphs_buf, _metrics_buf);
            if (baked != 1) { return 0; }
        }

        if (_atlas_tex == 0) {
            _atlas_tex = drv_create_tex_rgba(2048, 2048, _atlas_rgba);
            // 21 = linear filter (in both D3D11 and Vulkan)
            // 3 = clamp to edge (in both D3D11 and Vulkan)
            _atlas_smp = drv_create_sampler(21, 3, 3);
        }
        if (_atlas_tex == 0 or _atlas_smp == 0) { return 0; }
        return 1;
    }
}

