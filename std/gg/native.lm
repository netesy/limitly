fn brace_src(tmpl: str): str {
    var lb = _builtin_string_from_bytes([123]);
    var rb = _builtin_string_from_bytes([125]);
    var q = _builtin_string_from_bytes([34]);
    var r1 = replace(tmpl, "@", lb);
    var r2 = replace(r1, "#", rb);
    return replace(r2, "~", q);
}

// HLSL equivalents for the d3d11 driver (compiled via D3DCompile).
var _VS_HLSL: str = brace_src("struct VI @ float2 p : POSITION; float2 uv : TEXCOORD0; float4 col : COLOR; float4 params : NORMAL; #; struct VO @ float4 pos : SV_Position; float2 uv : TEXCOORD0; float4 col : COLOR; float4 params : NORMAL; #; VO main(VI i) @ VO o; o.pos = float4(i.p, 0.0, 1.0); o.uv = i.uv; o.col = i.col; o.params = i.params; return o; #");
var _PS_HLSL: str = brace_src("Texture2D tex : register(t0); SamplerState smp : register(s0); Texture2D sdftex : register(t1); SamplerState sdfsmp : register(s1); struct PI @ float4 pos : SV_Position; float2 uv : TEXCOORD0; float4 col : COLOR; float4 params : NORMAL; #; float round_rect_sdf(float2 p, float2 b, float r) @ float2 q = abs(p) - b + r; return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r; # float4 main(PI i) : SV_Target @ if (i.params.w < -0.5) @ float R = i.params.x; float a0 = i.params.y; float a1 = i.params.z; float2 p = i.uv; float r = length(p); float ang = atan2(p.y, p.x); float rel = ang - a0; rel = rel - 6.2831853 * floor(rel / 6.2831853); float sweep = a1 - a0; float d_ang; if (sweep >= 6.2831853) @ d_ang = -1000.0; # else if (rel <= sweep) @ d_ang = -min(rel, sweep - rel); # else @ d_ang = min(rel - sweep, 6.2831853 - rel); # float d = max(r - R, d_ang * R); return float4(i.col.rgb, i.col.a * saturate(0.5 - d * 0.7)); # if (i.params.w > 0.5) @ float v = sdftex.Sample(sdfsmp, i.uv).a * 255.0; float rr = i.params.x; float cov = saturate((v - (128.0 - rr)) / (2.0 * rr)); return float4(i.col.rgb, i.col.a * cov); # if (i.params.z <= 0.0) @ float a = tex.Sample(smp, i.uv).a; return float4(i.col.rgb, i.col.a * a); # float radius = i.params.x; float border_w = i.params.y; float2 half_size = i.params.zw; float2 p = i.uv; float d = round_rect_sdf(p, half_size, radius); float cov = 0.0; if (border_w < -0.001) @ float blur = -border_w; float t = max(d, 0.0) / blur; cov = (d < 0.0) ? 1.0 : exp(-t * t * 2.5); # else if (border_w > 0.001) @ float d_outer = d; float d_inner = -border_w - d; cov = saturate(0.5 - max(d_outer, d_inner)); # else @ cov = saturate(0.5 - d); # return float4(i.col.rgb, i.col.a * cov); #");

// ── pipeline init ───────────────────────────────────────────────────

fn spv_upload(words: [int]): int {
    unsafe {
        var n = len(words);
        var p = alloc_persist(n * 4);
        var i = 0;
        while (i < n) {
            ffi.store_u32(ffi.ptr_add(p, i * 4), words[i]);
            i = i + 1;
        }
        return p;
    }
}

fn pipeline_init(): int {
    unsafe {
        if (_pipe_ready != 0) { return 1; }
        var names: [str] = ["POSITION", "TEXCOORD", "COLOR", "NORMAL"];
        if (_is_vk != 0) {
            var vp = spv_upload(_VS_SPV);
            var pp = spv_upload(_PS_SPV);
            _vs = vk.gfx_vs_create(vp, len(_VS_SPV) * 4);
            _ps = vk.gfx_ps_create(pp, len(_PS_SPV) * 4);
            // POSITION@0 (8B), TEXCOORD@8 (8B), COLOR@16 (16B), NORMAL@32 (16B) = 48B stride
            _il = vk.gfx_input_layout_create_ex(names,
                [vk.DXGI_FMT_R32G32_FLOAT, vk.DXGI_FMT_R32G32_FLOAT, vk.DXGI_FMT_R32G32B32A32_FLOAT, vk.DXGI_FMT_R32G32B32A32_FLOAT],
                [0, 8, 16, 32], 0, 0);
        } elif (osid.TARGET_OS == osid.OS_WINDOWS) {
            var vb_ = d3d.gfx_compile(_VS_HLSL, "main", "vs_5_0");
            var pb_ = d3d.gfx_compile(_PS_HLSL, "main", "ps_5_0");
            if (vb_ == 0 or pb_ == 0) { return 0; }
            _vs = d3d.gfx_vs_create(d3d.gfx_blob_ptr(vb_), d3d.gfx_blob_size(vb_));
            _ps = d3d.gfx_ps_create(d3d.gfx_blob_ptr(pb_), d3d.gfx_blob_size(pb_));
            // POSITION@0 (8B), TEXCOORD@8 (8B), COLOR@16 (16B), NORMAL@32 (16B) = 48B stride
            _il = d3d.gfx_input_layout_create_ex(names,
                [d3d.DXGI_FMT_R32G32_FLOAT, d3d.DXGI_FMT_R32G32_FLOAT, d3d.DXGI_FMT_R32G32B32A32_FLOAT, d3d.DXGI_FMT_R32G32B32A32_FLOAT],
                [0, 8, 16, 32],
                d3d.gfx_blob_ptr(vb_),
                d3d.gfx_blob_size(vb_));
        }
        if (_vs == 0 or _ps == 0 or _il == 0) { return 0; }
        drv_set_shaders(_vs, _ps);
        drv_set_input_layout(_il);
        drv_set_topology(4); // D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST
        if (ensure_font_atlas() != 0) {
            drv_set_texture(0, _atlas_tex);
            drv_set_sampler(0, _atlas_smp);
        }
        // SDF glyph atlas on slot 1 — D3D11 only (the Vulkan SPIR-V blob has
        // no t1 binding; the SDF text path is gated to d3d11 in draw_text_px).
        if (_is_vk == 0 and _sdf_tex == 0) {
            if (sdfatlas.ensure() != 0) {
                // Keep the raw texture for UpdateSubresource AND the SRV
                // for slot-1 binding — drv_create_tex_rgba only returns SRV.
                _sdf_tex_raw = d3d.gfx_texture_create_rgba(
                    sdfatlas.ATLAS_W, sdfatlas.ATLAS_H, sdfatlas.atlas_ptr());
                if (_sdf_tex_raw != 0) {
                    _sdf_tex = d3d.gpu_srv_create(_sdf_tex_raw);
                }
                _sdf_smp = drv_create_sampler(21, 3, 3);
                if (_sdf_tex != 0 and _sdf_smp != 0) {
                    drv_set_texture(1, _sdf_tex);
                    drv_set_sampler(1, _sdf_smp);
                    _sdf_on = 1;
                }
            }
        }
        if (_is_vk != 0) {
            _blend = vk.gfx_blend_state_create_ex(1);
            _rast = vk.gfx_raster_state_create(0, 0);
            _depth = vk.gfx_depth_state_create(0, 0, 7);
        } elif (osid.TARGET_OS == osid.OS_WINDOWS) {
            _blend = d3d.gfx_blend_state_create_ex(1);
            // D3D11_FILL_MODE_SOLID=3, D3D11_CULL_MODE_NONE=1
            _rast = d3d.gfx_raster_state_create(3, 1);
            _depth = d3d.gfx_depth_state_create(0, 0, 7);
        }
        if (_blend != 0) { drv_set_blend_state(_blend); }
        if (_rast != 0) { drv_set_raster_state(_rast); }
        if (_depth != 0) { drv_set_depth_state(_depth, 0); }
        // dynamic vertex buffer, 48B stride; start at 384KB, grow on demand
        _vb_cap = 393216;
        _vb = drv_dyn_buf(_vb_cap, 1, 48);
        if (_vb == 0) { return 0; }
        drv_set_vb(0, _vb, 48, 0);
        // vertex scratch: 8192 verts * 48B = 393216 bytes persistent
        _vdata_cap = 393216;
        _vdata = alloc_persist(_vdata_cap);
        _pipe_ready = 1;
        return 1;
    }
}

// ── vertex emission ─────────────────────────────────────────────────

fn vtx(x: float, y: float, u: float, v: float,
       r: float, g: float, b: float, a: float,
       p0: float, p1: float, p2: float, p3: float): nil {
    unsafe {
        if (_vcount * 48 + 48 > _vdata_cap) { flush_verts(); }
        // Callers emit top-left-origin pixel coordinates; the drivers expect
        // clip-space position. D3D11 NDC has +y up (flip), Vulkan NDC has +y
        // down like the framebuffer (no flip).
        var fw = _w as float;
        var fh = _h as float;
        var nx = (x / fw) * 2.0 - 1.0;
        var ny = 0.0;
        if (_is_vk != 0) {
            ny = (y / fh) * 2.0 - 1.0;
        } else {
            ny = 1.0 - (y / fh) * 2.0;
        }
        var p = ffi.ptr_add(_vdata, _vcount * 48);
        ffi.store_f32(p, nx);
        ffi.store_f32(ffi.ptr_add(p, 4), ny);
        ffi.store_f32(ffi.ptr_add(p, 8), u);
        ffi.store_f32(ffi.ptr_add(p, 12), v);
        ffi.store_f32(ffi.ptr_add(p, 16), r);
        ffi.store_f32(ffi.ptr_add(p, 20), g);
        ffi.store_f32(ffi.ptr_add(p, 24), b);
        ffi.store_f32(ffi.ptr_add(p, 28), a);
        ffi.store_f32(ffi.ptr_add(p, 32), p0);
        ffi.store_f32(ffi.ptr_add(p, 36), p1);
        ffi.store_f32(ffi.ptr_add(p, 40), p2);
        ffi.store_f32(ffi.ptr_add(p, 44), p3);
        _vcount = _vcount + 1;
    }
}

pub fn flush_verts(): int {
    unsafe {
        if (_vcount == 0) { return 1; }
        if (pipeline_init() == 0) { _vcount = 0; return 0; }
        var bytes = _vcount * 48;
        if (bytes > _vb_cap) {
            // grow: double until it fits
            var ncap = _vb_cap * 2;
            while (ncap < bytes) { ncap = ncap * 2; }
            var nvb = drv_dyn_buf(ncap, 1, 48);
            if (nvb == 0) { _vcount = 0; return 0; }
            _vb = nvb; _vb_cap = ncap;
            drv_set_vb(0, _vb, 48, 0);
        }
        if (drv_buf_update(_vb, _vdata, bytes) == 0) { _vcount = 0; return 0; }
        drv_draw(_vcount, 0);
        _vcount = 0;
        return 1;
    }
}

// ── clip stack ──────────────────────────────────────────────────────

fn clip_rect(): (int, int, int, int) {
    if (_clip_n == 0) { return (0, 0, _w, _h); }
    return (_clip[_clip_n - 4], _clip[_clip_n - 3],
            _clip[_clip_n - 2], _clip[_clip_n - 1]);
}

fn clip_emit(): nil {
    unsafe {
        flush_verts();
        var r = clip_rect();
        drv_scissor(r.0, r.1, r.2 - r.0, r.3 - r.1);
    }
}

// ── public ops (called by std.gg routing) ───────────────────────────

pub fn set_prefer(p: str): nil { _prefer = p; }

pub fn driver(): str { return _drv; }

pub fn attach(hwnd: int, w: int, h: int): int {
    unsafe {
        if (_attached != 0) { return 1; }
        var env_vsync = osenv.getenv_or("LYMAR_VSYNC", "1");
        var sync = 1;
        if (env_vsync == "0") { sync = 0; }
        if (osid.TARGET_OS == osid.OS_WINDOWS) { d3d.gfx_set_vsync(sync); }
        vk.gfx_set_vsync(sync);

        _drv = "";
        _is_vk = 0;
        var first = _prefer;
        var second = "";
        if (first == "vulkan") {
            second = "d3d11";
        } else {
            first = "d3d11";
            second = "vulkan";
        }
        _drv = first;
        _is_vk = 0;
        if (first == "vulkan") { _is_vk = 1; }
        if (drv_attach(hwnd, w, h) != 0) {
            _w = w; _h = h; _attached = 1;
            return 1;
        }
        _drv = second;
        _is_vk = 0;
        if (second == "vulkan") { _is_vk = 1; }
        if (drv_attach(hwnd, w, h) != 0) {
            _w = w; _h = h; _attached = 1;
            return 1;
        }
        _drv = "";
        _is_vk = 0;
        return 0;
    }
}

pub fn detach(): nil {
    unsafe {
        flush_verts();
        if (_attached != 0) { drv_detach(); }
        _attached = 0; _frame_open = 0; _pipe_ready = 0;
        _vcount = 0; _clip_n = 0;
        _vs = 0; _ps = 0; _il = 0; _blend = 0; _rast = 0; _depth = 0; _vb = 0;
        _atlas_tex = 0; _atlas_smp = 0;
        _sdf_tex = 0; _sdf_tex_raw = 0; _sdf_smp = 0; _sdf_on = 0;
    }
}

pub fn resize(w: int, h: int): int {
    if (_attached == 0) { return 0; }
    var r = drv_resize(w, h);
    if (r != 0) { _w = w; _h = h; }
    return r;
}

pub fn save_screenshot(path: str): bool {
    if (_is_vk != 0) {
        return vk.gfx_save_screenshot(path) == 1;
    }
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        return d3d.gfx_save_screenshot(path) == 1;
    }
    return false;
}

// begin_pass equivalent: opens the driver frame and clears.
pub fn begin_pass(w: int, h: int, r: float, g: float, b: float, a: float): int {
    unsafe {
        if (_attached == 0) { return 0; }
        if (_frame_open != 0) { return 1; }
        if (drv_begin_frame() == 0) { return 0; }
        _frame_open = 1;
        _vcount = 0;
        _clip_n = 0;
        drv_clear(r, g, b, a);
        if (pipeline_init() == 0) { return 0; }
        drv_scissor(0, 0, w, h);
        return 1;
    }
}

// end_pass equivalent: draws are already recorded; just drop batch state.
pub fn end_pass(): nil {
    unsafe { flush_verts(); }
}

// commit equivalent: flush remaining verts and present.
pub fn commit(): int {
    unsafe {
        if (_frame_open == 0) { return 0; }
        flush_verts();
        var r = drv_end_frame();
        _frame_open = 0;
        return r;
    }
}

// ── geometric primitive emission (Analytical SDF with sub-pixel AA) ──

pub fn draw_rect_rounded(x: float, y: float, w: float, h: float, rad: float,
                         r: float, g: float, b: float, a: float): nil {
    if (w <= 0.0 or h <= 0.0 or a <= 0.001) { return; }
    var hw = w * 0.5;
    var hh = h * 0.5;
    var cr = rad;
    if (cr > hw) { cr = hw; }
    if (cr > hh) { cr = hh; }
    if (cr < 0.0) { cr = 0.0; }

    // Expand quad by 1.0px for complete sub-pixel anti-aliasing gradient
    var qx0 = x - 1.0;
    var qy0 = y - 1.0;
    var qx1 = x + w + 1.0;
    var qy1 = y + h + 1.0;
    var u0 = 0.0 - hw - 1.0;
    var v0 = 0.0 - hh - 1.0;
    var u1 = hw + 1.0;
    var v1 = hh + 1.0;

    unsafe {
        vtx(qx0, qy0, u0, v0, r, g, b, a, cr, 0.0, hw, hh);
        vtx(qx1, qy0, u1, v0, r, g, b, a, cr, 0.0, hw, hh);
        vtx(qx1, qy1, u1, v1, r, g, b, a, cr, 0.0, hw, hh);
        vtx(qx0, qy0, u0, v0, r, g, b, a, cr, 0.0, hw, hh);
        vtx(qx1, qy1, u1, v1, r, g, b, a, cr, 0.0, hw, hh);
        vtx(qx0, qy1, u0, v1, r, g, b, a, cr, 0.0, hw, hh);
    }
}

pub fn draw_rect(x: float, y: float, w: float, h: float,
                 r: float, g: float, b: float, a: float): nil {
    draw_rect_rounded(x, y, w, h, 0.0, r, g, b, a);
}

pub fn draw_rect_border(x: float, y: float, w: float, h: float, rad: float, border_w: float,
                        r: float, g: float, b: float, a: float): nil {
    if (w <= 0.0 or h <= 0.0 or border_w <= 0.0 or a <= 0.001) { return; }
    var hw = w * 0.5;
    var hh = h * 0.5;
    var cr = rad;
    if (cr > hw) { cr = hw; }
    if (cr > hh) { cr = hh; }
    if (cr < 0.0) { cr = 0.0; }

    var bw = border_w;
    if (bw > hw) { bw = hw; }
    if (bw > hh) { bw = hh; }

    // Expand quad by 1.0px for outer sub-pixel anti-aliasing
    var qx0 = x - 1.0;
    var qy0 = y - 1.0;
    var qx1 = x + w + 1.0;
    var qy1 = y + h + 1.0;
    var u0 = 0.0 - hw - 1.0;
    var v0 = 0.0 - hh - 1.0;
    var u1 = hw + 1.0;
    var v1 = hh + 1.0;

    unsafe {
        vtx(qx0, qy0, u0, v0, r, g, b, a, cr, bw, hw, hh);
        vtx(qx1, qy0, u1, v0, r, g, b, a, cr, bw, hw, hh);
        vtx(qx1, qy1, u1, v1, r, g, b, a, cr, bw, hw, hh);
        vtx(qx0, qy0, u0, v0, r, g, b, a, cr, bw, hw, hh);
        vtx(qx1, qy1, u1, v1, r, g, b, a, cr, bw, hw, hh);
        vtx(qx0, qy1, u0, v1, r, g, b, a, cr, bw, hw, hh);
    }
}

pub fn draw_shadow(x: float, y: float, w: float, h: float,
                   r: float, g: float, b: float, a: float,
                   radius: float, blur: float): nil {
    if (w <= 0.0 or h <= 0.0 or a <= 0.001) { return; }
    var bl = blur;
    if (bl < 0.5) { bl = 0.5; }

    var hw = w * 0.5;
    var hh = h * 0.5;
    var cr = radius;
    if (cr > hw) { cr = hw; }
    if (cr > hh) { cr = hh; }
    if (cr < 0.0) { cr = 0.0; }

    // Expand quad by blur * 2.5 for Gaussian falloff reach
    var ext = bl * 2.5;
    var qx0 = x - ext;
    var qy0 = y - ext;
    var qx1 = x + w + ext;
    var qy1 = y + h + ext;
    var u0 = 0.0 - hw - ext;
    var v0 = 0.0 - hh - ext;
    var u1 = hw + ext;
    var v1 = hh + ext;

    unsafe {
        // p1 = -bl encodes shadow mode (negative border_w)
        vtx(qx0, qy0, u0, v0, r, g, b, a, cr, 0.0 - bl, hw, hh);
        vtx(qx1, qy0, u1, v0, r, g, b, a, cr, 0.0 - bl, hw, hh);
        vtx(qx1, qy1, u1, v1, r, g, b, a, cr, 0.0 - bl, hw, hh);
        vtx(qx0, qy0, u0, v0, r, g, b, a, cr, 0.0 - bl, hw, hh);
        vtx(qx1, qy1, u1, v1, r, g, b, a, cr, 0.0 - bl, hw, hh);
        vtx(qx0, qy1, u0, v1, r, g, b, a, cr, 0.0 - bl, hw, hh);
    }
}

pub fn draw_tri(x1: float, y1: float, x2: float, y2: float,
                x3: float, y3: float,
                r: float, g: float, b: float, a: float): nil {
    unsafe {
        // UV (0.002, 0.002) samples solid white pixel at (0, 0)
        // p2 <= 0.0 signals text/textured mode (sample atlas)
        vtx(x1, y1, 0.002, 0.002, r, g, b, a, 0.0, 0.0, 0.0, 0.0);
        vtx(x2, y2, 0.002, 0.002, r, g, b, a, 0.0, 0.0, 0.0, 0.0);
        vtx(x3, y3, 0.002, 0.002, r, g, b, a, 0.0, 0.0, 0.0, 0.0);
    }
}

// Pie slice: D3D11 emits a single quad evaluated by the analytic wedge SDF
// in the pixel shader (params.w = -1 sentinel; params = radius, a0, a1).
// Vulkan's prebuilt SPIR-V predates the wedge mode, so it tessellates.
pub fn draw_pie_slice(cx: float, cy: float, radius: float, a0: float, a1: float,
                      r: float, g: float, b: float, a: float): nil {
    if (radius <= 0.0 or a <= 0.001) { return; }
    if (_is_vk != 0) {
        var sweep = a1 - a0;
        var n: float = sweep / 0.04;
        if (n < 2.0) { n = 2.0; }
        if (n > 256.0) { n = 256.0; }
        var da = sweep / n;
        var ang = a0;
        var i: float = 0.0;
        while (i < n) {
            var a2 = ang + da;
            if (i == n - 1.0) { a2 = a1; }
            var x1 = cx + radius * math.cos(ang);
            var y1 = cy + radius * math.sin(ang);
            var x2 = cx + radius * math.cos(a2);
            var y2 = cy + radius * math.sin(a2);
            draw_tri(cx, cy, x1, y1, x2, y2, r, g, b, a);
            ang = a2;
            i = i + 1.0;
        }
        return;
    }
    var x0 = cx - radius - 1.0;
    var y0 = cy - radius - 1.0;
    var x1 = cx + radius + 1.0;
    var y1 = cy + radius + 1.0;
    unsafe {
        vtx(x0, y0, x0 - cx, y0 - cy, r, g, b, a, radius, a0, a1, -1.0);
        vtx(x1, y0, x1 - cx, y0 - cy, r, g, b, a, radius, a0, a1, -1.0);
        vtx(x1, y1, x1 - cx, y1 - cy, r, g, b, a, radius, a0, a1, -1.0);
        vtx(x0, y0, x0 - cx, y0 - cy, r, g, b, a, radius, a0, a1, -1.0);
        vtx(x1, y1, x1 - cx, y1 - cy, r, g, b, a, radius, a0, a1, -1.0);
        vtx(x0, y1, x0 - cx, y1 - cy, r, g, b, a, radius, a0, a1, -1.0);
    }
}

pub fn push_clip(x: float, y: float, w: float, h: float,
                 shape: int, radius: float): nil {
    unsafe {
        var cur = clip_rect();
        var x0 = x as int; var y0 = y as int;
        var x1 = (x + w) as int; var y1 = (y + h) as int;
        if (x0 < cur.0) { x0 = cur.0; }
        if (y0 < cur.1) { y0 = cur.1; }
        if (x1 > cur.2) { x1 = cur.2; }
        if (y1 > cur.3) { y1 = cur.3; }
        if (x1 < x0) { x1 = x0; }
        if (y1 < y0) { y1 = y0; }
        if (len(_clip) < _clip_n + 4) {
            while (len(_clip) < _clip_n + 4) { _clip.append(0); }
        }
        _clip[_clip_n] = x0; _clip[_clip_n + 1] = y0;
        _clip[_clip_n + 2] = x1; _clip[_clip_n + 3] = y1;
        _clip_n = _clip_n + 4;
        clip_emit();
    }
}

pub fn pop_clip(): nil {
    unsafe {
        if (_clip_n >= 4) { _clip_n = _clip_n - 4; }
        clip_emit();
    }
}

// Atlas tiers are integer px 10..48 (39 tiers, index = px - 10).
fn size_index_for_scale(scale: int): int {
    if (scale <= 0) { return 1; }  // 11px
    if (scale == 1) { return 3; }  // 13px (standard UI)
    if (scale == 2) { return 12; } // 22px (standard headings)
    if (scale >= 3) { return 18; } // 28px (large display)
    return 3;
}

// Baked atlas pixel size for a size index (tier = index + 10).
fn atlas_px(size_idx: int): float {
    if (size_idx < 0) { return 10.0; }
    if (size_idx > 38) { return 48.0; }
    return (size_idx + 10) as float;
}

// Atlas size index for an explicit pixel size — snaps to the nearest
// integer-px tier (10..48), clamped at both ends.
fn size_index_for_px(px: float): int {
    var i = ((px + 0.5) as int) - 10;
    if (i < 0) { i = 0; }
    if (i > 38) { i = 38; }
    return i;
}

fn draw_text_at(text_str: str, x: float, y: float,
                r: float, g: float, b: float, a: float,
                size_idx: int): nil {
    unsafe {
        if (len(text_str) == 0 or a <= 0.001) { return; }
        if (pipeline_init() == 0) { return; }
        if (ensure_font_atlas() == 0) { return; }

        var gbuf = ffi.ptr_add(_glyphs_buf, size_idx * 3456); // 96 * 36 = 3456
        var lh = ffi.load_f32(ffi.ptr_add(_metrics_buf, size_idx * 12 + 8));

        var max_v = _vdata_cap / 48;
        if (_vcount + len(text_str) * 6 > max_v) {
            flush_verts();
        }

        var cur_x = x;
        var cur_y = y;
        var n = len(text_str);
        var i = 0;
        while (i < n) {
            var ch = _builtin_string_byte_at(text_str, i);
            if (ch == 10) {
                cur_y = cur_y + lh;
                cur_x = x;
            } elif (ch >= 32 and ch < 128) {
                var idx = ch - 32;
                var goff = idx * 36;
                var p = ffi.ptr_add(gbuf, goff);
                var ox0 = ffi.load_f32(p);
                var oy0 = ffi.load_f32(ffi.ptr_add(p, 4));
                var ox1 = ffi.load_f32(ffi.ptr_add(p, 8));
                var oy1 = ffi.load_f32(ffi.ptr_add(p, 12));
                var gu0 = ffi.load_f32(ffi.ptr_add(p, 16));
                var gv0 = ffi.load_f32(ffi.ptr_add(p, 20));
                var gu1 = ffi.load_f32(ffi.ptr_add(p, 24));
                var gv1 = ffi.load_f32(ffi.ptr_add(p, 28));
                var xadv = ffi.load_f32(ffi.ptr_add(p, 32));

                // Snap glyph placement to whole physical pixels to eliminate bilinear blur
                var sx = (cur_x + 0.5) as int as float;
                var sy = (cur_y + 0.5) as int as float;
                var gx0 = sx + ox0;
                var gy0 = sy + oy0;
                var gx1 = sx + ox1;
                var gy1 = sy + oy1;

                vtx(gx0, gy0, gu0, gv0, r, g, b, a, 0.0, 0.0, 0.0, 0.0);
                vtx(gx1, gy0, gu1, gv0, r, g, b, a, 0.0, 0.0, 0.0, 0.0);
                vtx(gx1, gy1, gu1, gv1, r, g, b, a, 0.0, 0.0, 0.0, 0.0);
                vtx(gx0, gy0, gu0, gv0, r, g, b, a, 0.0, 0.0, 0.0, 0.0);
                vtx(gx1, gy1, gu1, gv1, r, g, b, a, 0.0, 0.0, 0.0, 0.0);
                vtx(gx0, gy1, gu0, gv1, r, g, b, a, 0.0, 0.0, 0.0, 0.0);

                cur_x = cur_x + xadv;
            }
            i = i + 1;
        }
    }
}

pub fn draw_text(text_str: str, x: float, y: float,
                 r: float, g: float, b: float, a: float,
                 scale: int = 1): nil {
    draw_text_at(text_str, x, y, r, g, b, a, size_index_for_scale(scale));
}

// SDF glyph path (D3D11 only — the Vulkan SPIR-V has no t1 binding):
// one quad per glyph sampling the pure-Lymar SDF atlas; the pixel shader
// reconstructs coverage with smoothstep → analytic AA at any px size.
// SDF emit sink: module fn + module-var params. A closure created per
// draw call allocates a captured environment every frame under AOT.
var _se_r: float = 0.0;
var _se_g: float = 0.0;
var _se_b: float = 0.0;
var _se_a: float = 0.0;
var _se_srange: float = 0.0;

fn _sdf_emit(qx0: float, qy0: float, qx1: float, qy1: float,
             u0: float, v0: float, u1: float, v1: float): nil {
    if (_vcount + 6 > _vdata_cap / 48) { flush_verts(); }
    vtx(qx0, qy0, u0, v0, _se_r, _se_g, _se_b, _se_a, _se_srange, 0.0, 0.0, 1.0);
    vtx(qx1, qy0, u1, v0, _se_r, _se_g, _se_b, _se_a, _se_srange, 0.0, 0.0, 1.0);
    vtx(qx1, qy1, u1, v1, _se_r, _se_g, _se_b, _se_a, _se_srange, 0.0, 0.0, 1.0);
    vtx(qx0, qy0, u0, v0, _se_r, _se_g, _se_b, _se_a, _se_srange, 0.0, 0.0, 1.0);
    vtx(qx1, qy1, u1, v1, _se_r, _se_g, _se_b, _se_a, _se_srange, 0.0, 0.0, 1.0);
    vtx(qx0, qy1, u0, v1, _se_r, _se_g, _se_b, _se_a, _se_srange, 0.0, 0.0, 1.0);
}

fn draw_text_sdf_px(text_str: str, x: float, y: float,
                    r: float, g: float, b: float, a: float,
                    px: float): nil {
    unsafe {
        if (len(text_str) == 0 or a <= 0.001) { return; }
        if (pipeline_init() == 0 or _sdf_on == 0) { return; }

        _se_r = r; _se_g = g; _se_b = b; _se_a = a;
        _se_srange = sdfatlas.sdf_range(px);
        // Layout + glyph lookup happen inside sdf_atlas; emit receives
        // scalar quad args — no frames or closures cross the boundary.
        sdfatlas.emit_text(text_str, x, y, px, _sdf_emit);
        var was_dirty = sdfatlas.take_dirty();
        if (was_dirty != 0) {
            d3d.gfx_update_texture_rgba(_sdf_tex_raw, sdfatlas.ATLAS_W, sdfatlas.ATLAS_H, sdfatlas.atlas_ptr());
        }
    }
}

// Pixel-sized variant: SDF glyph atlas when available (D3D11), else the
// nearest baked coverage-atlas tier.
pub fn draw_text_px(text_str: str, x: float, y: float,
                    r: float, g: float, b: float, a: float,
                    px: float): nil {
    if (pipeline_init() != 0 and _sdf_on != 0) {
        draw_text_sdf_px(text_str, x, y, r, g, b, a, px);
        return;
    }
    draw_text_at(text_str, x, y, r, g, b, a, size_index_for_px(px));
}

fn measure_text_at(text_str: str, size_idx: int): float {
    unsafe {
        if (len(text_str) == 0) { return 0.0; }
        if (ensure_font_atlas() == 0) {
            return (len(text_str) * atlas_px(size_idx) * 0.6) as float;
        }
        return covatlas.measure_text_tier(text_str, size_idx);
    }
}

pub fn measure_text(text_str: str, scale: int = 1): float {
    return measure_text_at(text_str, size_index_for_scale(scale));
}

pub fn measure_text_px(text_str: str, px: float): float {
    if (pipeline_init() != 0 and _sdf_on != 0) {
        return sdfatlas.measure_text_px(text_str, px);
    }
    return measure_text_at(text_str, size_index_for_px(px));
}

fn line_height_at(size_idx: int): float {
    unsafe {
        if (ensure_font_atlas() == 0) {
            return atlas_px(size_idx) * 1.25;
        }
        return ffi.load_f32(ffi.ptr_add(_metrics_buf, size_idx * 12 + 8));
    }
}

pub fn get_line_height(scale: int = 1): float {
    return line_height_at(size_index_for_scale(scale));
}

pub fn get_line_height_px(px: float): float {
    if (pipeline_init() != 0 and _sdf_on != 0) { return sdfatlas.line_height_px(px); }
    return line_height_at(size_index_for_px(px));
}
