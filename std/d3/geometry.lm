// std/d3/geometry.lm
// Triangular mesh geometry data structure backed by staged BufferAttribute(T) storage.

import std.d3.buffer as buf;
import std.math.arithmetic as arith;
import std.math.trigonometry as trig;

frame Geometry {
    pub pos_attr: buf.FloatAttribute;
    pub normal_attr: buf.FloatAttribute;
    pub uv_attr: buf.FloatAttribute;
    pub color_attr: buf.FloatAttribute;
    pub index_attr: buf.IntAttribute;

    // Direct list views aliased to each BufferAttribute's backing buffer
    pub vertices: [float];
    pub normals: [float];
    pub uvs: [float];
    pub colors: [float];
    pub indices: [int];

    pub init() {
        self.vertices = [];
        self.normals = [];
        self.uvs = [];
        self.colors = [];
        self.indices = [];

        self.pos_attr = buf.float_attribute(self.vertices, 3);
        self.normal_attr = buf.float_attribute(self.normals, 3);
        self.uv_attr = buf.float_attribute(self.uvs, 2);
        self.color_attr = buf.float_attribute(self.colors, 3);
        self.index_attr = buf.int_attribute(self.indices, 3);
    }

    pub fn add_vertex(x: float, y: float, z: float): int {
        val idx = len(self.vertices) / 3;
        self.vertices.append(x);
        self.vertices.append(y);
        self.vertices.append(z);
        return idx;
    }

    pub fn add_normal(nx: float, ny: float, nz: float) {
        self.normals.append(nx);
        self.normals.append(ny);
        self.normals.append(nz);
    }

    pub fn add_uv(u: float, v: float) {
        self.uvs.append(u);
        self.uvs.append(v);
    }

    pub fn add_color(r: float, g: float, b: float) {
        self.colors.append(r);
        self.colors.append(g);
        self.colors.append(b);
    }

    pub fn add_face(i0: int, i1: int, i2: int) {
        self.indices.append(i0);
        self.indices.append(i1);
        self.indices.append(i2);
    }

    pub fn get_vertex_count(): int {
        return len(self.vertices) / 3;
    }

    pub fn get_face_count(): int {
        return len(self.indices) / 3;
    }

    pub fn get_vertex_x(idx: int): float {
        return self.vertices[idx * 3];
    }

    pub fn get_vertex_y(idx: int): float {
        return self.vertices[idx * 3 + 1];
    }

    pub fn get_vertex_z(idx: int): float {
        return self.vertices[idx * 3 + 2];
    }

    pub fn compute_vertex_normals() {
        val v_count = self.get_vertex_count();
        val total_floats = v_count * 3;
        var normal_accum: [float] = [];
        iter (i in 0..total_floats) {
            normal_accum.append(0.0);
        }

        val f_count = self.get_face_count();
        if (f_count >= 512) {
            // Parallel per-face normal computation across 4 workers
            var chunks: [[float]] = [[] as [float], [] as [float], [] as [float], [] as [float]];
            val workers = 4;
            val verts = self.vertices;
            val inds = self.indices;
            parallel(cores=4) {
                iter (wid in 0..4) {
                    var local_acc: [float] = [];
                    iter (k in 0..total_floats) {
                        local_acc.append(0.0);
                    }
                    val chunk_size = (f_count + workers - 1) / workers;
                    val start_f = wid * chunk_size;
                    var end_f = start_f + chunk_size;
                    if (end_f > f_count) { end_f = f_count; }
                    var f = start_f;
                    while (f < end_f) {
                        val i0 = inds[f * 3];
                        val i1 = inds[f * 3 + 1];
                        val i2 = inds[f * 3 + 2];
                        if (i0 < v_count and i1 < v_count and i2 < v_count) {
                            val ax = verts[i0 * 3];
                            val ay = verts[i0 * 3 + 1];
                            val az = verts[i0 * 3 + 2];
                            val abx = verts[i1 * 3] - ax;
                            val aby = verts[i1 * 3 + 1] - ay;
                            val abz = verts[i1 * 3 + 2] - az;
                            val acx = verts[i2 * 3] - ax;
                            val acy = verts[i2 * 3 + 1] - ay;
                            val acz = verts[i2 * 3 + 2] - az;
                            var nx = aby * acz - abz * acy;
                            var ny = abz * acx - abx * acz;
                            var nz = abx * acy - aby * acx;
                            val nsq = nx * nx + ny * ny + nz * nz;
                            if (nsq > 0.00000001) {
                                val inv_nlen = 1.0 / arith.sqrt(nsq);
                                nx = nx * inv_nlen;
                                ny = ny * inv_nlen;
                                nz = nz * inv_nlen;
                            } else {
                                nx = 0.0; ny = 1.0; nz = 0.0;
                            }
                            local_acc[i0 * 3] = local_acc[i0 * 3] + nx;
                            local_acc[i0 * 3 + 1] = local_acc[i0 * 3 + 1] + ny;
                            local_acc[i0 * 3 + 2] = local_acc[i0 * 3 + 2] + nz;
                            local_acc[i1 * 3] = local_acc[i1 * 3] + nx;
                            local_acc[i1 * 3 + 1] = local_acc[i1 * 3 + 1] + ny;
                            local_acc[i1 * 3 + 2] = local_acc[i1 * 3 + 2] + nz;
                            local_acc[i2 * 3] = local_acc[i2 * 3] + nx;
                            local_acc[i2 * 3 + 1] = local_acc[i2 * 3 + 1] + ny;
                            local_acc[i2 * 3 + 2] = local_acc[i2 * 3 + 2] + nz;
                        }
                        f = f + 1;
                    }
                    chunks[wid] = local_acc;
                }
            }
            iter (wid in 0..4) {
                val chunk = chunks[wid];
                iter (k in 0..total_floats) {
                    normal_accum[k] = normal_accum[k] + chunk[k];
                }
            }
        } else {
            iter (f in 0..f_count) {
                val i0 = self.indices[f * 3];
                val i1 = self.indices[f * 3 + 1];
                val i2 = self.indices[f * 3 + 2];

                if (i0 < v_count and i1 < v_count and i2 < v_count) {
                    val ax = self.vertices[i0 * 3];
                    val ay = self.vertices[i0 * 3 + 1];
                    val az = self.vertices[i0 * 3 + 2];

                    val abx = self.vertices[i1 * 3] - ax;
                    val aby = self.vertices[i1 * 3 + 1] - ay;
                    val abz = self.vertices[i1 * 3 + 2] - az;

                    val acx = self.vertices[i2 * 3] - ax;
                    val acy = self.vertices[i2 * 3 + 1] - ay;
                    val acz = self.vertices[i2 * 3 + 2] - az;

                    var nx = aby * acz - abz * acy;
                    var ny = abz * acx - abx * acz;
                    var nz = abx * acy - aby * acx;

                    val nsq = nx * nx + ny * ny + nz * nz;
                    if (nsq > 0.00000001) {
                        val inv_nlen = 1.0 / arith.sqrt(nsq);
                        nx = nx * inv_nlen;
                        ny = ny * inv_nlen;
                        nz = nz * inv_nlen;
                    } else {
                        nx = 0.0;
                        ny = 1.0;
                        nz = 0.0;
                    }

                    normal_accum[i0 * 3] = normal_accum[i0 * 3] + nx;
                    normal_accum[i0 * 3 + 1] = normal_accum[i0 * 3 + 1] + ny;
                    normal_accum[i0 * 3 + 2] = normal_accum[i0 * 3 + 2] + nz;

                    normal_accum[i1 * 3] = normal_accum[i1 * 3] + nx;
                    normal_accum[i1 * 3 + 1] = normal_accum[i1 * 3 + 1] + ny;
                    normal_accum[i1 * 3 + 2] = normal_accum[i1 * 3 + 2] + nz;

                    normal_accum[i2 * 3] = normal_accum[i2 * 3] + nx;
                    normal_accum[i2 * 3 + 1] = normal_accum[i2 * 3 + 1] + ny;
                    normal_accum[i2 * 3 + 2] = normal_accum[i2 * 3 + 2] + nz;
                }
            }
        }

        self.normals = [];
        iter (vi in 0..v_count) {
            val nx = normal_accum[vi * 3];
            val ny = normal_accum[vi * 3 + 1];
            val nz = normal_accum[vi * 3 + 2];
            val nsq = nx * nx + ny * ny + nz * nz;
            if (nsq > 0.00000001) {
                val inv_nlen = 1.0 / arith.sqrt(nsq);
                self.normals.append(nx * inv_nlen);
                self.normals.append(ny * inv_nlen);
                self.normals.append(nz * inv_nlen);
            } else {
                self.normals.append(0.0);
                self.normals.append(1.0);
                self.normals.append(0.0);
            }
        }
        self.normal_attr = buf.float_attribute(self.normals, 3);
    }

    pub fn scale(sx: float, sy: float, sz: float) {
        val v_count = self.get_vertex_count();
        iter (i in 0..v_count) {
            self.vertices[i * 3] = self.vertices[i * 3] * sx;
            self.vertices[i * 3 + 1] = self.vertices[i * 3 + 1] * sy;
            self.vertices[i * 3 + 2] = self.vertices[i * 3 + 2] * sz;
        }
    }

    pub fn translate(dx: float, dy: float, dz: float) {
        val v_count = self.get_vertex_count();
        iter (i in 0..v_count) {
            self.vertices[i * 3] = self.vertices[i * 3] + dx;
            self.vertices[i * 3 + 1] = self.vertices[i * 3 + 1] + dy;
            self.vertices[i * 3 + 2] = self.vertices[i * 3 + 2] + dz;
        }
    }

    pub fn add_quad(i0: int, i1: int, i2: int, i3: int) {
        self.add_face(i0, i1, i2);
        self.add_face(i0, i2, i3);
    }

    pub fn clone(): Geometry {
        val g = Geometry();
        iter (v in self.vertices) { g.vertices.append(v); }
        iter (n in self.normals) { g.normals.append(n); }
        iter (u in self.uvs) { g.uvs.append(u); }
        iter (c in self.colors) { g.colors.append(c); }
        iter (idx in self.indices) { g.indices.append(idx); }
        return g;
    }

    pub fn merge(other: Geometry, dx: float = 0.0, dy: float = 0.0, dz: float = 0.0) {
        val base_idx = self.get_vertex_count();
        val other_vcount = other.get_vertex_count();
        iter (vi in 0..other_vcount) {
            self.vertices.append(other.vertices[vi * 3] + dx);
            self.vertices.append(other.vertices[vi * 3 + 1] + dy);
            self.vertices.append(other.vertices[vi * 3 + 2] + dz);
        }

        iter (n in other.normals) { self.normals.append(n); }
        iter (u in other.uvs) { self.uvs.append(u); }
        iter (c in other.colors) { self.colors.append(c); }

        iter (idx in other.indices) {
            self.indices.append(base_idx + idx);
        }
    }

    pub fn mirror(axis: int = 0): Geometry {
        val g = Geometry();
        val v_count = self.get_vertex_count();
        iter (vi in 0..v_count) {
            var x = self.vertices[vi * 3];
            var y = self.vertices[vi * 3 + 1];
            var z = self.vertices[vi * 3 + 2];
            if (axis == 0) { x = 0.0 - x; }
            elif (axis == 1) { y = 0.0 - y; }
            else { z = 0.0 - z; }
            g.add_vertex(x, y, z);
        }

        val f_count = self.get_face_count();
        iter (fi in 0..f_count) {
            val i0 = self.indices[fi * 3];
            val i1 = self.indices[fi * 3 + 1];
            val i2 = self.indices[fi * 3 + 2];
            g.add_face(i0, i2, i1);
        }

        g.compute_vertex_normals();
        return g;
    }

    pub fn rotate_x(angle: float) {
        val ca = trig.cos(angle);
        val sa = trig.sin(angle);
        val v_count = self.get_vertex_count();
        iter (i in 0..v_count) {
            val y = self.vertices[i * 3 + 1];
            val z = self.vertices[i * 3 + 2];
            self.vertices[i * 3 + 1] = y * ca - z * sa;
            self.vertices[i * 3 + 2] = y * sa + z * ca;
        }
    }

    pub fn rotate_y(angle: float) {
        val ca = trig.cos(angle);
        val sa = trig.sin(angle);
        val v_count = self.get_vertex_count();
        iter (i in 0..v_count) {
            val x = self.vertices[i * 3];
            val z = self.vertices[i * 3 + 2];
            self.vertices[i * 3] = x * ca + z * sa;
            self.vertices[i * 3 + 2] = (0.0 - x) * sa + z * ca;
        }
    }

    pub fn rotate_z(angle: float) {
        val ca = trig.cos(angle);
        val sa = trig.sin(angle);
        val v_count = self.get_vertex_count();
        iter (i in 0..v_count) {
            val x = self.vertices[i * 3];
            val y = self.vertices[i * 3 + 1];
            self.vertices[i * 3] = x * ca - y * sa;
            self.vertices[i * 3 + 1] = x * sa + y * ca;
        }
    }
}
