// std/d3/renderer.lm
// 3D scene rasterizer and projection pipeline with pooled SoA triangle buffers,
// exhaustive shading/light dispatch, depth sorting, and face culling.

import std.d3.scene as sc;
import std.camera as cam;
import std.d3.mesh as msh;
import std.d3.light as lgt;
import std.d3.geometry as geom;
import std.d3.material as mtrl;
import std.d3.types as types;
import std.d3.culling as cull;
import std.d3.uniforms as uni;
import std.gg as gg;
import std.image.png as png;
import std.image.index as simg;
import std.ffi as ffi;
import std.math.arithmetic as arith;
import std.math.matrix show Matrix;

fn _quicksort_tri_order(order: [int], coords: [float], low: int, high: int) {
    if (low < high) {
        val pivot_idx = order[high];
        val pivot_z = coords[pivot_idx * 7 + 6];
        var i = low - 1;
        var j = low;
        while (j < high) {
            val oj = order[j];
            if (coords[oj * 7 + 6] >= pivot_z) {
                i = i + 1;
                val tmp = order[i];
                order[i] = oj;
                order[j] = tmp;
            }
            j = j + 1;
        }
        val p = i + 1;
        val tmp2 = order[p];
        order[p] = order[high];
        order[high] = tmp2;

        _quicksort_tri_order(order, coords, low, p - 1);
        _quicksort_tri_order(order, coords, p + 1, high);
    }
}

fn _project_vertices_parallel(
    g_verts: [float],
    m: [float],
    v_count: int,
    viewport_x: float,
    viewport_y: float,
    half_vw: float,
    half_vh: float,
    proj_buf: [float]
) {
    val m0 = m[0]; val m1 = m[1]; val m2 = m[2]; val m3 = m[3];
    val m4 = m[4]; val m5 = m[5]; val m6 = m[6]; val m7 = m[7];
    val m8 = m[8]; val m9 = m[9]; val m10 = m[10]; val m11 = m[11];
    val m12 = m[12]; val m13 = m[13]; val m14 = m[14]; val m15 = m[15];

    var p_chunks: [[float]] = [[] as [float], [] as [float], [] as [float], [] as [float]];
    val workers = 4;
    parallel(cores=4) {
        iter (wid in 0..4) {
            var lp: [float] = [];
            val chunk = (v_count + workers - 1) / workers;
            val start_v = wid * chunk;
            var end_v = start_v + chunk;
            if (end_v > v_count) { end_v = v_count; }
            var vi = start_v;
            while (vi < end_v) {
                val v_idx = vi * 3;
                val lx = g_verts[v_idx];
                val ly = g_verts[v_idx + 1];
                val lz = g_verts[v_idx + 2];

                val cw = m12 * lx + m13 * ly + m14 * lz + m15;
                var cx = m0 * lx + m1 * ly + m2 * lz + m3;
                var cy = m4 * lx + m5 * ly + m6 * lz + m7;
                var cz = m8 * lx + m9 * ly + m10 * lz + m11;

                if (cw != 0.0 and cw != 1.0) {
                    val inv_w = 1.0 / cw;
                    cx = cx * inv_w;
                    cy = cy * inv_w;
                    cz = cz * inv_w;
                }

                lp.append(viewport_x + (cx + 1.0) * half_vw);
                lp.append(viewport_y + (1.0 - cy) * half_vh);
                lp.append(cz);
                lp.append(cw);
                vi = vi + 1;
            }
            p_chunks[wid] = lp;
        }
    }
    var write_i = 0;
    iter (wid in 0..4) {
        iter (pv in p_chunks[wid]) {
            proj_buf[write_i] = pv;
            write_i = write_i + 1;
        }
    }
}

fn _render_mesh_item(
    renderer: Renderer3D,
    geo: geom.Geometry,
    material: mtrl.Material,
    world: Matrix,
    mvp: Matrix,
    lights: [lgt.Light],
    n_lights: int,
    amb_r: float,
    amb_g: float,
    amb_b: float,
    viewport_x: float,
    viewport_y: float,
    half_vw: float,
    half_vh: float,
    bound_w: float,
    bound_h: float,
    bound_min_x: float,
    bound_max_x: float,
    bound_min_y: float,
    bound_max_y: float
): nil {
            val rot_m: Matrix = world;
            val rm = rot_m.data;
            val rm0 = rm[0]; val rm1 = rm[1]; val rm2 = rm[2]; val rm3 = rm[3];
            val rm4 = rm[4]; val rm5 = rm[5]; val rm6 = rm[6]; val rm7 = rm[7];
            val rm8 = rm[8]; val rm9 = rm[9]; val rm10 = rm[10]; val rm11 = rm[11];

            val v_count = geo.get_vertex_count();
            val f_count = geo.get_face_count();

            val g_verts = geo.vertices;
            val g_inds = geo.indices;
            val g_norms = geo.normals;
            val has_norms = len(g_norms) >= v_count * 3;

            val mat_amb = material.ambient;
            val mat_diff = material.diffuse;
            val mat_spec = material.specular;
            val mat_shin = material.shininess;
            val mat_col_r = material.color_r;
            val mat_col_g = material.color_g;
            val mat_col_b = material.color_b;
            val mat_col_a = material.color_a;
            val mat_wire = material.wireframe;
            val mat_wire_w = material.wireframe_thickness;
            val mat_cull = material.cull_mode;
            val mat_shading = material.shading;

            val base_ill_r = mat_amb + amb_r;
            val base_ill_g = mat_amb + amb_g;
            val base_ill_b = mat_amb + amb_b;

            // Ensure pooled projection buffer capacity for v_count * 4 floats
            val needed_proj = v_count * 4;
            while (len(renderer.proj_buf) < needed_proj) {
                renderer.proj_buf.append(0.0);
            }

            val m = mvp.data;
            if (v_count >= 512) {
                _project_vertices_parallel(g_verts, m, v_count, viewport_x, viewport_y, half_vw, half_vh, renderer.proj_buf);
            } else {
                val m0 = m[0]; val m1 = m[1]; val m2 = m[2]; val m3 = m[3];
                val m4 = m[4]; val m5 = m[5]; val m6 = m[6]; val m7 = m[7];
                val m8 = m[8]; val m9 = m[9]; val m10 = m[10]; val m11 = m[11];
                val m12 = m[12]; val m13 = m[13]; val m14 = m[14]; val m15 = m[15];
                iter (vi in 0..v_count) {
                    val v_idx = vi * 3;
                    val lx = g_verts[v_idx];
                    val ly = g_verts[v_idx + 1];
                    val lz = g_verts[v_idx + 2];

                    val cw = m12 * lx + m13 * ly + m14 * lz + m15;
                    var cx = m0 * lx + m1 * ly + m2 * lz + m3;
                    var cy = m4 * lx + m5 * ly + m6 * lz + m7;
                    var cz = m8 * lx + m9 * ly + m10 * lz + m11;

                    if (cw != 0.0 and cw != 1.0) {
                        val inv_w = 1.0 / cw;
                        cx = cx * inv_w;
                        cy = cy * inv_w;
                        cz = cz * inv_w;
                    }

                    val b = vi * 4;
                    renderer.proj_buf[b] = viewport_x + (cx + 1.0) * half_vw;
                    renderer.proj_buf[b + 1] = viewport_y + (1.0 - cy) * half_vh;
                    renderer.proj_buf[b + 2] = cz;
                    renderer.proj_buf[b + 3] = cw;
                }
            }

            // Process faces
            iter (fi in 0..f_count) {
                val f_idx = fi * 3;
                val i0 = g_inds[f_idx];
                val i1 = g_inds[f_idx + 1];
                val i2 = g_inds[f_idx + 2];

                val b0 = i0 * 4;
                val w0 = renderer.proj_buf[b0 + 3];
                val b1 = i1 * 4;
                val w1 = renderer.proj_buf[b1 + 3];
                val b2 = i2 * 4;
                val w2 = renderer.proj_buf[b2 + 3];

                // Frustum near plane clip
                if (w0 > 0.1 and w1 > 0.1 and w2 > 0.1) {
                    val p0_x = renderer.proj_buf[b0];
                    val p0_y = renderer.proj_buf[b0 + 1];
                    val p1_x = renderer.proj_buf[b1];
                    val p1_y = renderer.proj_buf[b1 + 1];
                    val p2_x = renderer.proj_buf[b2];
                    val p2_y = renderer.proj_buf[b2 + 1];

                    var tri_min_x = p0_x;
                    if (p1_x < tri_min_x) { tri_min_x = p1_x; }
                    if (p2_x < tri_min_x) { tri_min_x = p2_x; }
                    var tri_max_x = p0_x;
                    if (p1_x > tri_max_x) { tri_max_x = p1_x; }
                    if (p2_x > tri_max_x) { tri_max_x = p2_x; }

                    var tri_min_y = p0_y;
                    if (p1_y < tri_min_y) { tri_min_y = p1_y; }
                    if (p2_y < tri_min_y) { tri_min_y = p2_y; }
                    var tri_max_y = p0_y;
                    if (p1_y > tri_max_y) { tri_max_y = p1_y; }
                    if (p2_y > tri_max_y) { tri_max_y = p2_y; }

                    if ((tri_max_x - tri_min_x < bound_w) and (tri_max_y - tri_min_y < bound_h) and
                        (tri_max_x > bound_min_x) and (tri_min_x < bound_max_x) and
                        (tri_max_y > bound_min_y) and (tri_min_y < bound_max_y)) {

                        // Backface culling in screen coordinates (Y down)
                        val e1x = p1_x - p0_x;
                        val e1y = p1_y - p0_y;
                        val e2x = p2_x - p0_x;
                        val e2y = p2_y - p0_y;
                        val cross_z = e1x * e2y - e1y * e2x;

                        var should_cull = false;
                        match (mat_cull) {
                            types.CullMode.Back => {
                                if (cross_z >= 0.0) { should_cull = true; }
                            },
                            types.CullMode.Front => {
                                if (cross_z <= 0.0) { should_cull = true; }
                            },
                            types.CullMode.None => {
                                should_cull = false;
                            }
                        }

                        if (not should_cull) {
                            var out_r = mat_col_r;
                            var out_g = mat_col_g;
                            var out_b = mat_col_b;
                            var is_wire = mat_wire;

                            match (mat_shading) {
                                types.ShadingModel.Unlit => {
                                    // Unlit bypasses normal transformation and lighting completely
                                },
                                types.ShadingModel.Wireframe => {
                                    is_wire = true;
                                },
                                types.ShadingModel.NormalVisualizer => {
                                    var fnx = 0.0; var fny = 1.0; var fnz = 0.0;
                                    if (has_norms) {
                                        val n_idx = i0 * 3;
                                        val lx = g_norms[n_idx];
                                        val ly = g_norms[n_idx + 1];
                                        val lz = g_norms[n_idx + 2];
                                        fnx = rm0 * lx + rm1 * ly + rm2 * lz;
                                        fny = rm4 * lx + rm5 * ly + rm6 * lz;
                                        fnz = rm8 * lx + rm9 * ly + rm10 * lz;
                                        val nlen = arith.sqrt(fnx * fnx + fny * fny + fnz * fnz);
                                        if (nlen > 0.000001) {
                                            val inv_n = 1.0 / nlen;
                                            fnx = fnx * inv_n; fny = fny * inv_n; fnz = fnz * inv_n;
                                        }
                                    }
                                    out_r = fnx * 0.5 + 0.5;
                                    out_g = fny * 0.5 + 0.5;
                                    out_b = fnz * 0.5 + 0.5;
                                },
                                types.ShadingModel.Flat => {
                                    var fnx = 0.0; var fny = 1.0; var fnz = 0.0;
                                    if (has_norms) {
                                        val n_idx = i0 * 3;
                                        val lx = g_norms[n_idx];
                                        val ly = g_norms[n_idx + 1];
                                        val lz = g_norms[n_idx + 2];
                                        fnx = rm0 * lx + rm1 * ly + rm2 * lz;
                                        fny = rm4 * lx + rm5 * ly + rm6 * lz;
                                        fnz = rm8 * lx + rm9 * ly + rm10 * lz;
                                        val nlen = arith.sqrt(fnx * fnx + fny * fny + fnz * fnz);
                                        if (nlen > 0.000001) {
                                            val inv_n = 1.0 / nlen;
                                            fnx = fnx * inv_n; fny = fny * inv_n; fnz = fnz * inv_n;
                                        }
                                    }
                                    val wcx = rm0 * g_verts[i0 * 3] + rm1 * g_verts[i0 * 3 + 1] + rm2 * g_verts[i0 * 3 + 2] + rm3;
                                    val wcy = rm4 * g_verts[i0 * 3] + rm5 * g_verts[i0 * 3 + 1] + rm6 * g_verts[i0 * 3 + 2] + rm7;
                                    val wcz = rm8 * g_verts[i0 * 3] + rm9 * g_verts[i0 * 3 + 1] + rm10 * g_verts[i0 * 3 + 2] + rm11;
                                    val ill = _accumulate_lights(lights, n_lights, base_ill_r, base_ill_g, base_ill_b, fnx, fny, fnz, wcx, wcy, wcz, mat_diff, mat_spec, mat_shin);
                                    out_r = mat_col_r * ill.0;
                                    out_g = mat_col_g * ill.1;
                                    out_b = mat_col_b * ill.2;
                                },
                                types.ShadingModel.Smooth => {
                                    var fnx = 0.0; var fny = 1.0; var fnz = 0.0;
                                    if (has_norms) {
                                        val n0 = i0 * 3;
                                        val n1 = i1 * 3;
                                        val n2 = i2 * 3;
                                        val lx = (g_norms[n0] + g_norms[n1] + g_norms[n2]) * 0.33333333;
                                        val ly = (g_norms[n0 + 1] + g_norms[n1 + 1] + g_norms[n2 + 1]) * 0.33333333;
                                        val lz = (g_norms[n0 + 2] + g_norms[n1 + 2] + g_norms[n2 + 2]) * 0.33333333;
                                        fnx = rm0 * lx + rm1 * ly + rm2 * lz;
                                        fny = rm4 * lx + rm5 * ly + rm6 * lz;
                                        fnz = rm8 * lx + rm9 * ly + rm10 * lz;
                                        val nlen = arith.sqrt(fnx * fnx + fny * fny + fnz * fnz);
                                        if (nlen > 0.000001) {
                                            val inv_n = 1.0 / nlen;
                                            fnx = fnx * inv_n; fny = fny * inv_n; fnz = fnz * inv_n;
                                        }
                                    }
                                    val lcx = (g_verts[i0 * 3] + g_verts[i1 * 3] + g_verts[i2 * 3]) * 0.33333333;
                                    val lcy = (g_verts[i0 * 3 + 1] + g_verts[i1 * 3 + 1] + g_verts[i2 * 3 + 1]) * 0.33333333;
                                    val lcz = (g_verts[i0 * 3 + 2] + g_verts[i1 * 3 + 2] + g_verts[i2 * 3 + 2]) * 0.33333333;
                                    val wcx = rm0 * lcx + rm1 * lcy + rm2 * lcz + rm3;
                                    val wcy = rm4 * lcx + rm5 * lcy + rm6 * lcz + rm7;
                                    val wcz = rm8 * lcx + rm9 * lcy + rm10 * lcz + rm11;
                                    val ill = _accumulate_lights(lights, n_lights, base_ill_r, base_ill_g, base_ill_b, fnx, fny, fnz, wcx, wcy, wcz, mat_diff, mat_spec, mat_shin);
                                    out_r = mat_col_r * ill.0;
                                    out_g = mat_col_g * ill.1;
                                    out_b = mat_col_b * ill.2;
                                }
                            }

                            val avg_z = (renderer.proj_buf[b0 + 2] + renderer.proj_buf[b1 + 2] + renderer.proj_buf[b2 + 2]) * 0.33333333;
                            renderer.push_triangle(p0_x, p0_y, p1_x, p1_y, p2_x, p2_y, avg_z, out_r, out_g, out_b, mat_col_a, is_wire, mat_wire_w);
                        }
                    }
                }
            }
}


// Builds (once) the interleaved pos+normal+uv vertex stream and index stream
// for a Geometry and uploads them as gg buffers. Local-space data is
// transformed by the MVP uniform at draw time, so one buffer serves every
// mesh/instance that shares the geometry. Vertex record: 8 floats
// (pos3, normal3, uv2); missing UVs default to (0,0).
fn _ensure_gpu_buffers(geo: geom.Geometry): nil {
    if (geo.gpu_vbuf > 0 and geo.gpu_ibuf > 0) {
        return;
    }
    val nv = geo.get_vertex_count();
    if (nv <= 0) {
        return;
    }
    val has_normals = len(geo.normals) >= nv * 3;
    val has_uvs = len(geo.uvs) >= nv * 2;

    var vd: [float] = [];
    var vi: int = 0;
    while (vi < nv) {
        val b = vi * 3;
        vd.append(geo.vertices[b]);
        vd.append(geo.vertices[b + 1]);
        vd.append(geo.vertices[b + 2]);
        if (has_normals) {
            vd.append(geo.normals[b]);
            vd.append(geo.normals[b + 1]);
            vd.append(geo.normals[b + 2]);
        } else {
            vd.append(0.0);
            vd.append(1.0);
            vd.append(0.0);
        }
        if (has_uvs) {
            vd.append(geo.uvs[vi * 2]);
            vd.append(geo.uvs[vi * 2 + 1]);
        } else {
            vd.append(0.0);
            vd.append(0.0);
        }
        vi = vi + 1;
    }

    var idf: [float] = [];
    iter (iv in geo.indices) {
        idf.append(iv as float);
    }
    if (len(idf) == 0) {
        var si: int = 0;
        while (si < nv) {
            idf.append(si as float);
            si = si + 1;
        }
    }

    geo.gpu_vbuf = gg.make_buffer_data(len(vd), false, vd).id;
    geo.gpu_ibuf = gg.make_buffer_data(len(idf), true, idf).id;
}

// Loads material.base_color_texture once and uploads it as a gg image.
// material.texture_state: 0 = not tried, 1 = ready (texture_id valid),
// -1 = failed (renderer falls back to flat material color).
fn _ensure_material_texture(material: mtrl.Material): nil {
    if (material.texture_state != 0) {
        return;
    }
    material.texture_state = -1;
    if (material.base_color_texture == "") {
        return;
    }
    // load_rgba returns (w, h, px) as a tuple — deliberately avoids the
    // Image frame, whose field layout is corrupted when another module
    // declares a same-named frame (bare-name registry collision).
    val rgba = png.load_rgba(material.base_color_texture);
    val t = rgba? else {
        return;
    };
    val w = t.0;
    val h = t.1;
    val px = t.2;
    if (w <= 0 or h <= 0 or len(px) != w * h * 4) {
        return;
    }
    material.texture_id = gg.make_image_data(w, h, px);
    material.texture_state = 1;
}

// Uniform blob layout consumed by the runtime vertex-stream pipeline.
// See src/runtime/software_graphics.hh draw_vertex_stream.
fn _uniform_shading_int(shading: types.ShadingModel, wireframe: bool): int {
    if (wireframe) {
        return uni.SHADING_WIREFRAME;
    }
    match (shading) {
        types.ShadingModel.Flat => { return uni.SHADING_FLAT; },
        types.ShadingModel.Smooth => { return uni.SHADING_SMOOTH; },
        types.ShadingModel.Unlit => { return uni.SHADING_UNLIT; },
        types.ShadingModel.Wireframe => { return uni.SHADING_WIREFRAME; },
        types.ShadingModel.NormalVisualizer => { return uni.SHADING_NORMAL_VIZ; }
    }
    return uni.SHADING_FLAT;
}

fn _uniform_cull_int(material: mtrl.Material): int {
    if (material.double_sided) {
        return uni.CULL_NONE;
    }
    match (material.cull_mode) {
        types.CullMode.None => { return uni.CULL_NONE; },
        types.CullMode.Back => { return uni.CULL_BACK; },
        types.CullMode.Front => { return uni.CULL_FRONT; }
    }
    return uni.CULL_NONE;
}

fn _uniform_light_type_int(light: lgt.Light): int {
    match (light.light_type) {
        types.LightType.Ambient => { return uni.LIGHT_AMBIENT; },
        types.LightType.Directional => { return uni.LIGHT_DIRECTIONAL; },
        types.LightType.Point => { return uni.LIGHT_POINT; }
    }
    return uni.LIGHT_AMBIENT;
}

// Fills renderer.uniform_scratch with the per-draw uniform blob. The scratch
// list is grown once and overwritten in place — no per-frame allocation.
fn _pack_mesh_uniforms(
    renderer: Renderer3D,
    geo: geom.Geometry,
    material: mtrl.Material,
    world: Matrix,
    mvp: Matrix,
    lights: [lgt.Light],
    n_lights: int,
    amb_r: float,
    amb_g: float,
    amb_b: float,
    viewport_x: float,
    viewport_y: float,
    viewport_w: float,
    viewport_h: float
): nil {
    // Header + MAX_LIGHTS light records (indices from std.d3.uniforms)
    val needed = uni.BLOB_FLOATS;
    while (len(renderer.uniform_scratch) < needed) {
        renderer.uniform_scratch.append(0.0);
    }
    val u = renderer.uniform_scratch;

    val md = mvp.data;
    val wd = world.data;
    var i = 0;
    while (i < 16) {
        u[uni.U_MVP + i] = md[i];
        u[uni.U_WORLD + i] = wd[i];
        i = i + 1;
    }
    u[uni.U_COLOR] = material.color_r;
    u[uni.U_COLOR + 1] = material.color_g;
    u[uni.U_COLOR + 2] = material.color_b;
    u[uni.U_COLOR + 3] = material.color_a;
    u[uni.U_AMBIENT] = material.ambient + amb_r;
    u[uni.U_AMBIENT + 1] = material.ambient + amb_g;
    u[uni.U_AMBIENT + 2] = material.ambient + amb_b;
    u[uni.U_MATERIAL] = material.diffuse;
    u[uni.U_MATERIAL + 1] = material.specular;
    u[uni.U_MATERIAL + 2] = material.shininess;
    u[uni.U_SHADING] = _uniform_shading_int(material.shading, material.wireframe) as float;
    u[uni.U_CULL] = _uniform_cull_int(material) as float;
    u[uni.U_WIRE_WIDTH] = material.wireframe_thickness;
    if (len(geo.normals) >= geo.get_vertex_count() * 3) {
        u[uni.U_HAS_NORMALS] = 1.0;
    } else {
        u[uni.U_HAS_NORMALS] = 0.0;
    }
    u[uni.U_VIEWPORT] = viewport_x;
    u[uni.U_VIEWPORT + 1] = viewport_y;
    u[uni.U_VIEWPORT + 2] = viewport_w;
    u[uni.U_VIEWPORT + 3] = viewport_h;
    if (material.texture_id > 0) {
        u[uni.U_HAS_TEXTURE] = 1.0;
    } else {
        u[uni.U_HAS_TEXTURE] = 0.0;
    }

    var n_cap = n_lights;
    if (n_cap > uni.MAX_LIGHTS) { n_cap = uni.MAX_LIGHTS; }
    if (n_cap < 0) { n_cap = 0; }
    u[uni.U_LIGHT_COUNT] = n_cap as float;
    var li = 0;
    while (li < n_cap) {
        val cl = lights[li];
        val lb = uni.U_LIGHT_BASE + li * uni.U_LIGHT_STRIDE;
        u[lb + uni.U_LIGHT_TYPE] = _uniform_light_type_int(cl) as float;
        if (cl.light_type == types.LightType.Point) {
            u[lb + uni.U_LIGHT_DIR] = cl.position_x;
            u[lb + uni.U_LIGHT_DIR + 1] = cl.position_y;
            u[lb + uni.U_LIGHT_DIR + 2] = cl.position_z;
        } else {
            u[lb + uni.U_LIGHT_DIR] = cl.direction_x;
            u[lb + uni.U_LIGHT_DIR + 1] = cl.direction_y;
            u[lb + uni.U_LIGHT_DIR + 2] = cl.direction_z;
        }
        u[lb + uni.U_LIGHT_COLOR] = cl.color_r;
        u[lb + uni.U_LIGHT_COLOR + 1] = cl.color_g;
        u[lb + uni.U_LIGHT_COLOR + 2] = cl.color_b;
        u[lb + uni.U_LIGHT_INT] = cl.intensity;
        li = li + 1;
    }
}

// GPU path: one vertex-stream draw call per visible mesh/instance through the
// gg buffer/pipeline/bindings handles. The runtime performs vertex transform,
// lighting, and z-buffered rasterization.
fn _draw_mesh_gpu(
    renderer: Renderer3D,
    geo: geom.Geometry,
    material: mtrl.Material,
    world: Matrix,
    mvp: Matrix,
    lights: [lgt.Light],
    n_lights: int,
    amb_r: float,
    amb_g: float,
    amb_b: float,
    viewport_x: float,
    viewport_y: float,
    viewport_w: float,
    viewport_h: float,
    frustum: [float]
): nil {
    _ensure_gpu_buffers(geo);
    if (geo.gpu_vbuf <= 0 or geo.gpu_ibuf <= 0) {
        return;
    }
    if (not cull.sphere_visible(frustum, geo, world)) {
        return;
    }
    _ensure_material_texture(material);
    _pack_mesh_uniforms(renderer, geo, material, world, mvp, lights, n_lights,
                        amb_r, amb_g, amb_b, viewport_x, viewport_y, viewport_w, viewport_h);
    gg.apply_bindings(geo.gpu_vbuf, geo.gpu_ibuf, renderer.uniform_scratch,
                      material.texture_id, 0);
    gg.draw(0, geo.get_face_count(), 1);
}

fn _render_scene_gpu(
    renderer: Renderer3D,
    target_scene: sc.Scene3D,
    target_camera: cam.Camera3D,
    viewport_x: float,
    viewport_y: float,
    viewport_w: float,
    viewport_h: float
) {
    var vw = viewport_w;
    var vh = viewport_h;
    if (vw <= 0.0) { vw = renderer.width as float; }
    if (vh <= 0.0) { vh = renderer.height as float; }

    if (renderer.pipeline_id < 0) {
        val shd = gg.make_shader("lymar_d3_vertex", "lymar_d3_pixel");
        // primitive_type 2 = VertexStream (see gg.PrimitiveType)
        renderer.pipeline_id = gg.make_pipeline(shd.id, 2).id;
    }
    gg.apply_pipeline(renderer.pipeline_id);

    if (renderer.clear_color) {
        gg.draw_rect_primitive(viewport_x, viewport_y, vw, vh,
                               target_scene.background_r, target_scene.background_g,
                               target_scene.background_b, target_scene.background_a);
    }

    val vp = target_camera.view_projection_matrix;
    val s_lights = target_scene.lights;
    val n_lights = len(s_lights);

    var amb_r: float = 0.0;
    var amb_g: float = 0.0;
    var amb_b: float = 0.0;
    iter (li in 0..n_lights) {
        val cl = s_lights[li];
        if (cl.light_type == types.LightType.Ambient) {
            amb_r = amb_r + cl.color_r * cl.intensity;
            amb_g = amb_g + cl.color_g * cl.intensity;
            amb_b = amb_b + cl.color_b * cl.intensity;
        }
    }

    val frustum = cull.frustum_planes(vp);

    val s_meshes = target_scene.meshes;
    iter (m_idx in 0..len(s_meshes)) {
        val cur_mesh = s_meshes[m_idx];
        if (cur_mesh.visible) {
            cur_mesh.update_world();
            val world_m = cur_mesh.world_matrix;
            _draw_mesh_gpu(renderer, cur_mesh.geometry, cur_mesh.material, world_m,
                           vp.multiply(world_m), s_lights, n_lights, amb_r, amb_g, amb_b,
                           viewport_x, viewport_y, vw, vh, frustum);
        }
    }

    iter (gi in 0..len(target_scene.instance_groups)) {
        val grp = target_scene.instance_groups[gi];
        val im = grp.mesh;
        if (im.visible) {
            im.update_world();
            iter (t in grp.transforms) {
                val eff_world = im.world_matrix.multiply(t);
                _draw_mesh_gpu(renderer, im.geometry, im.material, eff_world,
                               vp.multiply(eff_world), s_lights, n_lights, amb_r, amb_g, amb_b,
                               viewport_x, viewport_y, vw, vh, frustum);
            }
        }
    }
}

pub fn render_scene(renderer: Renderer3D, target_scene: sc.Scene3D, target_camera: cam.Camera3D, viewport_x: float, viewport_y: float, viewport_w: float, viewport_h: float) {
    if (gg.is_valid()) {
        _render_scene_gpu(renderer, target_scene, target_camera, viewport_x, viewport_y, viewport_w, viewport_h);
        return;
    }
    _render_scene_cpu(renderer, target_scene, target_camera, viewport_x, viewport_y, viewport_w, viewport_h);
}

fn _render_scene_cpu(
    renderer: Renderer3D,
    target_scene: sc.Scene3D,
    target_camera: cam.Camera3D,
    viewport_x: float,
    viewport_y: float,
    viewport_w: float,
    viewport_h: float
) {
    var vw = viewport_w;
    var vh = viewport_h;
    if (vw <= 0.0) { vw = renderer.width as float; }
    if (vh <= 0.0) { vh = renderer.height as float; }

    gg.begin_batch();

    if (renderer.clear_color) {
        gg.draw_rect_primitive(viewport_x, viewport_y, vw, vh, target_scene.background_r, target_scene.background_g, target_scene.background_b, target_scene.background_a);
    }

    val vp = target_camera.view_projection_matrix;
    val s_lights = target_scene.lights;
    val n_lights = len(s_lights);

    // Pre-accumulate ambient lights once per frame
    var amb_r: float = 0.0;
    var amb_g: float = 0.0;
    var amb_b: float = 0.0;
    iter (li in 0..n_lights) {
        val cl = s_lights[li];
        match (cl.light_type) {
            types.LightType.Ambient => {
                amb_r = amb_r + cl.color_r * cl.intensity;
                amb_g = amb_g + cl.color_g * cl.intensity;
                amb_b = amb_b + cl.color_b * cl.intensity;
            },
            _ => { }
        }
    }

    val half_vw = 0.5 * vw;
    val half_vh = 0.5 * vh;
    val bound_w = vw * 2.5;
    val bound_h = vh * 2.5;
    val bound_min_x = -vw * 0.5;
    val bound_max_x = vw * 1.5;
    val bound_min_y = -vh * 0.5;
    val bound_max_y = vh * 1.5;

    // Reset pooled SoA triangle buffer without reallocating backing lists
    renderer.tri_count = 0;

    val s_meshes = target_scene.meshes;
    val n_meshes = len(s_meshes);

    // Frustum planes from the view-projection for whole-mesh sphere culling.
    val frustum = cull.frustum_planes(vp);

    // Regular meshes
    iter (m_idx in 0..n_meshes) {
        val cur_mesh = s_meshes[m_idx];
        if (cur_mesh.visible) {
            cur_mesh.update_world();
            val world_m = cur_mesh.world_matrix;
            val geo: geom.Geometry = cur_mesh.geometry;
            if (cull.sphere_visible(frustum, geo, world_m)) {
                _render_mesh_item(renderer, geo, cur_mesh.material, world_m, vp.multiply(world_m),
                                  s_lights, n_lights, amb_r, amb_g, amb_b,
                                  viewport_x, viewport_y, half_vw, half_vh,
                                  bound_w, bound_h, bound_min_x, bound_max_x, bound_min_y, bound_max_y);
            }
        }
    }

    // Instanced groups: one draw per transform, geometry shared.
    val n_groups = len(target_scene.instance_groups);
    iter (gi in 0..n_groups) {
        val grp = target_scene.instance_groups[gi];
        val im = grp.mesh;
        if (im.visible) {
            im.update_world();
            iter (t in grp.transforms) {
                val eff_world = im.world_matrix.multiply(t);
                val geo: geom.Geometry = im.geometry;
                if (cull.sphere_visible(frustum, geo, eff_world)) {
                    _render_mesh_item(renderer, geo, im.material, eff_world, vp.multiply(eff_world),
                                      s_lights, n_lights, amb_r, amb_g, amb_b,
                                      viewport_x, viewport_y, half_vw, half_vh,
                                      bound_w, bound_h, bound_min_x, bound_max_x, bound_min_y, bound_max_y);
                }
            }
        }
    }

    // Depth Sort: Painter's algorithm over flat index array
    val n_tri = renderer.tri_count;
    if (n_tri > 1) {
        _quicksort_tri_order(renderer.tri_order, renderer.tri_coords, 0, n_tri - 1);
    }

    // Rasterize triangles to screen
    iter (r_i in 0..n_tri) {
        val tid = renderer.tri_order[r_i];
        val cb = tid * 7;
        val colb = tid * 4;
        val x0 = renderer.tri_coords[cb];
        val y0 = renderer.tri_coords[cb + 1];
        val x1 = renderer.tri_coords[cb + 2];
        val y1 = renderer.tri_coords[cb + 3];
        val x2 = renderer.tri_coords[cb + 4];
        val y2 = renderer.tri_coords[cb + 5];
        val cr = renderer.tri_colors[colb];
        val cg = renderer.tri_colors[colb + 1];
        val cblue = renderer.tri_colors[colb + 2];
        val ca = renderer.tri_colors[colb + 3];

        if (renderer.tri_wire[tid]) {
            val ww = renderer.tri_wire_w[tid];
            gg.draw_line_primitive(x0, y0, x1, y1, cr, cg, cblue, ca, ww);
            gg.draw_line_primitive(x1, y1, x2, y2, cr, cg, cblue, ca, ww);
            gg.draw_line_primitive(x2, y2, x0, y0, cr, cg, cblue, ca, ww);
        } else {
            gg.draw_triangle_primitive(x0, y0, x1, y1, x2, y2, cr, cg, cblue, ca);
        }
    }

    gg.end_batch();
}

fn _accumulate_lights(
    s_lights: [lgt.Light],
    n_lights: int,
    base_r: float,
    base_g: float,
    base_b: float,
    fnx: float,
    fny: float,
    fnz: float,
    wcx: float,
    wcy: float,
    wcz: float,
    mat_diff: float,
    mat_spec: float,
    mat_shin: float
): (float, float, float) {
    var ill_r = base_r;
    var ill_g = base_g;
    var ill_b = base_b;

    iter (l_i in 0..n_lights) {
        val cur_light = s_lights[l_i];
        match (cur_light.light_type) {
            types.LightType.Ambient => {
                // Already pre-accumulated once per frame
            },
            types.LightType.Directional => {
                val dot_val = fnx * cur_light.direction_x + fny * cur_light.direction_y + fnz * cur_light.direction_z;
                if (dot_val > 0.0) {
                    val diff = dot_val * mat_diff * cur_light.intensity;
                    ill_r = ill_r + cur_light.color_r * diff;
                    ill_g = ill_g + cur_light.color_g * diff;
                    ill_b = ill_b + cur_light.color_b * diff;

                    if (mat_spec > 0.0) {
                        val hx = cur_light.direction_x;
                        val hy = cur_light.direction_y;
                        val hz = cur_light.direction_z + 1.0;
                        val hlen = arith.sqrt(hx * hx + hy * hy + hz * hz);
                        if (hlen > 0.000001) {
                            val ndoth = (fnx * hx + fny * hy + fnz * hz) / hlen;
                            if (ndoth > 0.0) {
                                var spec_p = ndoth * ndoth * ndoth * ndoth;
                                if (mat_shin >= 16.0) { spec_p = spec_p * spec_p; }
                                if (mat_shin >= 32.0) { spec_p = spec_p * spec_p; }
                                val spec = spec_p * mat_spec * cur_light.intensity;
                                ill_r = ill_r + spec;
                                ill_g = ill_g + spec;
                                ill_b = ill_b + spec;
                            }
                        }
                    }
                }
            },
            types.LightType.Point => {
                val lx = cur_light.position_x - wcx;
                val ly = cur_light.position_y - wcy;
                val lz = cur_light.position_z - wcz;
                val dist_sq = lx * lx + ly * ly + lz * lz;
                if (dist_sq > 0.000001) {
                    val dist = arith.sqrt(dist_sq);
                    val inv_d = 1.0 / dist;
                    val pdot = (fnx * lx + fny * ly + fnz * lz) * inv_d;
                    if (pdot > 0.0) {
                        val atten = 1.0 / (1.0 + 0.09 * dist + 0.032 * dist_sq);
                        val pfact = pdot * mat_diff * cur_light.intensity * atten;
                        ill_r = ill_r + cur_light.color_r * pfact;
                        ill_g = ill_g + cur_light.color_g * pfact;
                        ill_b = ill_b + cur_light.color_b * pfact;
                    }
                }
            }
        }
    }

    if (ill_r > 1.0) { ill_r = 1.0; }
    if (ill_g > 1.0) { ill_g = 1.0; }
    if (ill_b > 1.0) { ill_b = 1.0; }
    return (ill_r, ill_g, ill_b);
}

frame Renderer3D {
    pub width: int;
    pub height: int;
    pub clear_color: bool;

    // Pooled SoA render buffers reused across frames
    pub proj_buf: [float];
    pub tri_coords: [float];
    pub tri_colors: [float];
    pub tri_wire: [bool];
    pub tri_wire_w: [float];
    pub tri_order: [int];
    pub tri_count: int;

    // GPU path state: vertex-stream pipeline id and pooled uniform scratch.
    pub pipeline_id: int;
    pub uniform_scratch: [float];

    pub init(w: int = 800, h: int = 600) {
        self.width = w;
        self.height = h;
        self.clear_color = false;
        self.proj_buf = [];
        self.tri_coords = [];
        self.tri_colors = [];
        self.tri_wire = [];
        self.tri_wire_w = [];
        self.tri_order = [];
        self.tri_count = 0;
        self.pipeline_id = -1;
        self.uniform_scratch = [];
    }

    pub fn push_triangle(
        x0: float, y0: float, x1: float, y1: float, x2: float, y2: float,
        avg_z: float, r: float, g: float, b: float, a: float,
        is_wire: bool, wire_w: float
    ) {
        val idx = self.tri_count;
        val cb = idx * 7;
        val colb = idx * 4;
        if (idx < len(self.tri_wire)) {
            self.tri_coords[cb] = x0;
            self.tri_coords[cb + 1] = y0;
            self.tri_coords[cb + 2] = x1;
            self.tri_coords[cb + 3] = y1;
            self.tri_coords[cb + 4] = x2;
            self.tri_coords[cb + 5] = y2;
            self.tri_coords[cb + 6] = avg_z;
            self.tri_colors[colb] = r;
            self.tri_colors[colb + 1] = g;
            self.tri_colors[colb + 2] = b;
            self.tri_colors[colb + 3] = a;
            self.tri_wire[idx] = is_wire;
            self.tri_wire_w[idx] = wire_w;
            self.tri_order[idx] = idx;
        } else {
            self.tri_coords.append(x0);
            self.tri_coords.append(y0);
            self.tri_coords.append(x1);
            self.tri_coords.append(y1);
            self.tri_coords.append(x2);
            self.tri_coords.append(y2);
            self.tri_coords.append(avg_z);
            self.tri_colors.append(r);
            self.tri_colors.append(g);
            self.tri_colors.append(b);
            self.tri_colors.append(a);
            self.tri_wire.append(is_wire);
            self.tri_wire_w.append(wire_w);
            self.tri_order.append(idx);
        }
        self.tri_count = idx + 1;
    }

    pub fn set_size(w: int, h: int) {
        self.width = w;
        self.height = h;
    }

    pub fn render(target_scene: sc.Scene3D, target_camera: cam.Camera3D, viewport_x: float = 0.0, viewport_y: float = 0.0, viewport_w: float = 0.0, viewport_h: float = 0.0) {
        render_scene(self, target_scene, target_camera, viewport_x, viewport_y, viewport_w, viewport_h);
    }
}
