// std/d3/transform.lm
// Zero-cost spatial transformation component embedding TRS and dirty-flagged matrix caching.

import std.math.matrix as mat;
pub import std.math.matrix show Matrix;

frame Transform3D {
    pub position_x: float;
    pub position_y: float;
    pub position_z: float;

    pub rotation_x: float;
    pub rotation_y: float;
    pub rotation_z: float;

    pub scale_x: float;
    pub scale_y: float;
    pub scale_z: float;

    pub local_matrix: Matrix;
    pub world_matrix: Matrix;
    pub matrix_auto_update: bool;
    pub dirty: bool;

    // Cached snapshot of last built TRS values to skip redundant trig & matrix work
    var _c_px: float;
    var _c_py: float;
    var _c_pz: float;
    var _c_rx: float;
    var _c_ry: float;
    var _c_rz: float;
    var _c_sx: float;
    var _c_sy: float;
    var _c_sz: float;

    pub init() {
        self.init_transform();
    }

    pub fn init_transform() {
        self.position_x = 0.0;
        self.position_y = 0.0;
        self.position_z = 0.0;

        self.rotation_x = 0.0;
        self.rotation_y = 0.0;
        self.rotation_z = 0.0;

        self.scale_x = 1.0;
        self.scale_y = 1.0;
        self.scale_z = 1.0;

        self.local_matrix = mat.Matrix();
        self.world_matrix = mat.Matrix();
        self.matrix_auto_update = true;
        self.dirty = false;

        self._c_px = 0.0; self._c_py = 0.0; self._c_pz = 0.0;
        self._c_rx = 0.0; self._c_ry = 0.0; self._c_rz = 0.0;
        self._c_sx = 1.0; self._c_sy = 1.0; self._c_sz = 1.0;
    }

    pub fn mark_dirty() {
        self.dirty = true;
    }

    pub fn set_position(x: float, y: float, z: float) {
        self.position_x = x;
        self.position_y = y;
        self.position_z = z;
        self.dirty = true;
        if (self.matrix_auto_update) {
            self.update_matrix();
        }
    }

    pub fn set_rotation(rx: float, ry: float, rz: float) {
        self.rotation_x = rx;
        self.rotation_y = ry;
        self.rotation_z = rz;
        self.dirty = true;
        if (self.matrix_auto_update) {
            self.update_matrix();
        }
    }

    pub fn set_scale(sx: float, sy: float, sz: float) {
        self.scale_x = sx;
        self.scale_y = sy;
        self.scale_z = sz;
        self.dirty = true;
        if (self.matrix_auto_update) {
            self.update_matrix();
        }
    }

    pub fn translate(dx: float, dy: float, dz: float) {
        self.position_x = self.position_x + dx;
        self.position_y = self.position_y + dy;
        self.position_z = self.position_z + dz;
        self.dirty = true;
        if (self.matrix_auto_update) {
            self.update_matrix();
        }
    }

    pub fn rotate_x(angle: float) {
        self.rotation_x = self.rotation_x + angle;
        self.dirty = true;
        if (self.matrix_auto_update) {
            self.update_matrix();
        }
    }

    pub fn rotate_y(angle: float) {
        self.rotation_y = self.rotation_y + angle;
        self.dirty = true;
        if (self.matrix_auto_update) {
            self.update_matrix();
        }
    }

    pub fn rotate_z(angle: float) {
        self.rotation_z = self.rotation_z + angle;
        self.dirty = true;
        if (self.matrix_auto_update) {
            self.update_matrix();
        }
    }

    pub fn update_matrix() {
        if (not self.dirty and
            self._c_px == self.position_x and self._c_py == self.position_y and self._c_pz == self.position_z and
            self._c_rx == self.rotation_x and self._c_ry == self.rotation_y and self._c_rz == self.rotation_z and
            self._c_sx == self.scale_x and self._c_sy == self.scale_y and self._c_sz == self.scale_z) {
            return;
        }
        self.local_matrix.make_trs(
            self.position_x, self.position_y, self.position_z,
            self.rotation_x, self.rotation_y, self.rotation_z,
            self.scale_x, self.scale_y, self.scale_z
        );
        // Copy into world_matrix in-place (avoids Matrix.clone() heap allocation)
        iter (i in 0..16) {
            self.world_matrix.data[i] = self.local_matrix.data[i];
        }
        self._c_px = self.position_x; self._c_py = self.position_y; self._c_pz = self.position_z;
        self._c_rx = self.rotation_x; self._c_ry = self.rotation_y; self._c_rz = self.rotation_z;
        self._c_sx = self.scale_x; self._c_sy = self.scale_y; self._c_sz = self.scale_z;
        self.dirty = false;
    }
}
