// Standard Library CLI Module
import std.strings as str;
import std.collections.hash as hash;

frame ArgParser {
    var program_name: str;
    var options: {str: bool};
    pub var args: [str];
    
    pub init(name: str = "app") {
        self.program_name = name;
        self.options = {};
        self.args = [];
    }
    
    pub fn parse(argv: [str]) {
        for (var i = 1; i < len(argv); i = i + 1) {
            var arg = argv[i];
            if (str.String(arg).starts_with("-")) {
                self.options[arg] = true;
            } else {
                self.args = self.args + [arg];
            }
        }
    }
    
    pub fn has_flag(flag: str): bool {
        return self.options[flag] != nil;
    }
    
    pub fn get_args(): [str] {
        return self.args;
    }
}
