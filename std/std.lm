import std.core as core;
import std.collections.index as collections;
import std.functional as functional;
import std.math as math;
// std.strings was removed: its `pub type String = s.String` alias collided with
// std.string's own `String` frame and broke method dispatch for callers importing
// both. std.string is the single string module and re-exports via `pub import`.
pub import std.string show String;
// Option is a staged frame template, not a frame: it must travel through `pub import`
// (which registers the template under its import spellings), never a `var` alias -- an
// alias would bind the name to an ordinary frame and lose the type-position request.
pub import std.core.option show Option;
import std.sort as sort;
import std.search as search;
import std.algorithm as algorithm;
import std.iterator as iterator;
import std.range as range;
import std.io as io;
import std.resource as resource;
import std.time as time;
import std.log as log;
import std.path as path;
import std.fs as fs;
import std.env as env;
// std.os answers the machine itself (environment, directories, platform); std.env
// is the variable API on top of it, and std.process is the process as an entity.
import std.os as os;
import std.process as process;
import std.testing as testing;
import std.random as random;
import std.parse as parse;
import std.format as format;
import std.validation.index as validation;
import std.config.index as config;
import std.json as json;
import std.toml as toml;
import std.yaml as yaml;
import std.net.tcp as tcp;
import std.net.udp as udp;
import std.net.dns as dns;
import std.http.client as http_client;
import std.http.server as http_server;
import std.crypto.hash as crypto_hash;
import std.crypto.hmac as crypto_hmac;
import std.crypto.random as crypto_random;
import std.encoding.index as encoding;
import std.serialization as serialization;
import std.url.index as url;
import std.mime.index as mime;
import std.uuid.index as uuid;
import std.debug as debug;
import std.ffi as ffi;
import std.app as app;

var List = collections.List;
var Error = core.Error;
var Int = math.Int;
var Float = math.Float;
var Iterator = iterator.Iterator;
var FunctionInt = functional.FunctionInt;
var FunctionIntBool = functional.FunctionIntBool;
var Console = io.Console;
var File = io.File;
var Resource = resource.Resource;
var Time = time.Time;
var Logger = log.Logger;
var Path = path.Path;
var FS = fs.FS;
var Env = env.Env;
var Process = process.Process;
var Testing = testing.Testing;
var Random = random.Random;
var Parse = parse.Parse;
var Format = format.Format;
var Validate = validation.Validate;
var Config = config.Config;
var JSONValue = json.JSONValue;
var TOMLValue = toml.TOMLValue;
var YAMLValue = yaml.YAMLValue;
var TCP = tcp.TCPClient;
var UDP = udp.UDP;
var DNS = dns.DNS;
var HTTPClient = http_client.HTTPClient;
var HTTPServer = http_server.HTTPServer;
var Hash = crypto_hash.Hasher;
var HMAC = crypto_hmac.HMAC;
var CryptoRandom = crypto_random.Random;
var Encoding = encoding.Encoding;
var URL = url.URL;
var URLBuilder = url.URLBuilder;
var QueryParams = url.QueryParams;
var MIMEType = mime.MIMEType;
var MIMEParams = mime.MIMEParams;
var UUID = uuid.UUID;
var Debug = debug.Debug;
var Range = range.Range;
