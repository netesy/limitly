// Standard Library Iterator Module

frame MapIterator {
    var source: any;
    var f: fn(any): any;
    
    pub init(source: any, f: fn(any): any) {
        self.source = source;
        self.f = f;
    }
    
    pub fn next(): any {
        var item = self.source.next();
        if (item == nil) return nil;
        return self.f(item);
    }
}

frame FilterIterator {
    var source: any;
    var p: fn(any): bool;
    
    pub init(source: any, p: fn(any): bool) {
        self.source = source;
        self.p = p;
    }
    
    pub fn next(): any {
        while (true) {
            var item = self.source.next();
            if (item == nil) return nil;
            if (self.p(item)) return item;
        }
    }
}

frame RangeIterator {
    var current: int;
    var stop: int;
    var step: int;
    
    pub init(start: int, stop: int, step: int = 1) {
        self.current = start;
        self.stop = stop;
        self.step = step;
    }
    
    pub fn next(): any {
        if (self.step > 0 and self.current >= self.stop) return nil;
        if (self.step < 0 and self.current <= self.stop) return nil;
        
        var res = self.current;
        self.current = self.current + self.step;
        return res;
    }
}

fn range(start: int, stop: int? = nil, step: int = 1): RangeIterator {
    if (stop == nil) {
        return RangeIterator(0, start, step);
    }
    return RangeIterator(start, stop, step);
}

fn map(it: any, f: fn(any): any): MapIterator {
    return MapIterator(it, f);
}

fn filter(it: any, p: fn(any): bool): FilterIterator {
    return FilterIterator(it, p);
}

fn collect(it: any): [any] {
    var res = [];
    var item = it.next();
    while (item != nil) {
        res = res + [item];
        item = it.next();
    }
    return res;
}
