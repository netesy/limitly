// Standard Library Iterator Module

trait Iterator {
    fn next(): any;
}

frame ListIterator: Iterator {
    var items: [any];
    var index: int;

    pub init(items: [any]) {
        self.items = items;
        self.index = 0;
    }

    pub fn next(): any {
        if (self.index >= len(self.items)) {
            return nil;
        }
        var item = self.items[self.index];
        self.index = self.index + 1;
        return item;
    }
}

frame MapIterator: Iterator {
    var source: Iterator;
    var f: fn(any): any;

    pub init(source: Iterator, f: fn(any): any) {
        self.source = source;
        self.f = f;
    }

    pub fn next(): any {
        var item = self.source.next();
        if (item == nil) {
            return nil;
        }
        return self.f(item);
    }
}

frame FilterIterator: Iterator {
    var source: Iterator;
    var p: fn(any): bool;

    pub init(source: Iterator, p: fn(any): bool) {
        self.source = source;
        self.p = p;
    }

    pub fn next(): any {
        while (true) {
            var item = self.source.next();
            if (item == nil) {
                return nil;
            }
            if (self.p(item)) {
                return item;
            }
        }
        return nil;
    }
}

frame EnumerateIterator: Iterator {
    var source: Iterator;
    var index: int;
    pub init(source: Iterator) { self.source = source; self.index = 0; }
    pub fn next(): any { var item = self.source.next(); if (item == nil) { return nil; } var pair = (self.index, item); self.index = self.index + 1; return pair; }
}

frame ZipIterator: Iterator {
    var left: Iterator;
    var right: Iterator;
    pub init(left: Iterator, right: Iterator) { self.left = left; self.right = right; }
    pub fn next(): any { var a = self.left.next(); var b = self.right.next(); if (a == nil or b == nil) { return nil; } return (a, b); }
}

frame ChainIterator: Iterator {
    var left: Iterator;
    var right: Iterator;
    var on_left: bool;
    pub init(left: Iterator, right: Iterator) { self.left = left; self.right = right; self.on_left = true; }
    pub fn next(): any { if (self.on_left) { var a = self.left.next(); if (a != nil) { return a; } self.on_left = false; } return self.right.next(); }
}

frame SkipIterator: Iterator {
    var source: Iterator;
    var remaining: int;
    pub init(source: Iterator, count: int) { self.source = source; self.remaining = count; }
    pub fn next(): any { while (self.remaining > 0) { var skipped = self.source.next(); if (skipped == nil) { return nil; } self.remaining = self.remaining - 1; } return self.source.next(); }
}

frame TakeIterator: Iterator {
    var source: Iterator;
    var remaining: int;
    pub init(source: Iterator, count: int) { self.source = source; self.remaining = count; }
    pub fn next(): any { if (self.remaining <= 0) { return nil; } self.remaining = self.remaining - 1; return self.source.next(); }
}

frame StepByIterator: Iterator {
    var source: Iterator;
    var step: int;
    pub init(source: Iterator, step: int) { self.source = source; self.step = step; }
    pub fn next(): any { var item = self.source.next(); var i = 1; while (i < self.step) { var skipped = self.source.next(); if (skipped == nil) { return item; } i = i + 1; } return item; }
}

frame ChunkIterator: Iterator {
    var source: Iterator;
    var size: int;
    pub init(source: Iterator, size: int) { self.source = source; self.size = size; }
    pub fn next(): any { var chunk: [any] = []; var i = 0; var j = 0; while (i < self.size) { var item = self.source.next(); if (item == nil) { if (j == 0) { return nil; } return chunk; } chunk[j] = item; j = j + 1; i = i + 1; } return chunk; }
}

frame CycleIterator: Iterator {
    var items: [any];
    var index: int;
    pub init(items: [any]) { self.items = items; self.index = 0; }
    pub fn next(): any { if (len(self.items) == 0) { return nil; } var item = self.items[self.index]; self.index = (self.index + 1) % len(self.items); return item; }
}

frame PeekableIterator: Iterator {
    var source: Iterator;
    var cached: any;
    pub init(source: Iterator) { self.source = source; self.cached = nil; }
    pub fn peek(): any { if (self.cached == nil) { self.cached = self.source.next(); } return self.cached; }
    pub fn next(): any { if (self.cached != nil) { var item = self.cached; self.cached = nil; return item; } return self.source.next(); }
}

fn iterator(items: [any]): ListIterator { return ListIterator(items); }
fn map(it: Iterator, f: fn(any): any): MapIterator { return MapIterator(it, f); }
fn filter(it: Iterator, p: fn(any): bool): FilterIterator { return FilterIterator(it, p); }
fn enumerate(it: Iterator): EnumerateIterator { return EnumerateIterator(it); }
fn zip(left: Iterator, right: Iterator): ZipIterator { return ZipIterator(left, right); }
fn chain(left: Iterator, right: Iterator): ChainIterator { return ChainIterator(left, right); }
fn flatten(it: Iterator): Iterator { return it; }
fn skip(it: Iterator, count: int): SkipIterator { return SkipIterator(it, count); }
fn take(it: Iterator, count: int): TakeIterator { return TakeIterator(it, count); }
fn step_by(it: Iterator, step: int): StepByIterator { return StepByIterator(it, step); }
fn chunk(it: Iterator, size: int): ChunkIterator { return ChunkIterator(it, size); }
fn cycle(items: [any]): CycleIterator { return CycleIterator(items); }
fn peekable(it: Iterator): PeekableIterator { return PeekableIterator(it); }
fn collect(it: Iterator): [any] {
    import std.collections.vector as vector;
    var res = vector.Vector();
    var item = it.next();
    while (item != nil) {
        res.push(item);
        item = it.next();
    }
    return res.data;
}
