// std/widget/geometry.lm
// Geometric primitives for UI, widgets, and layouts.
//
// Canonical types live in their domain modules and are re-exported here:
//   Rect    -> std.geometry.Rect
//   Vector2 -> std.math.vector2.Vector2
// Only Insets is widget-local.

pub import std.geometry show Rect;
pub import std.math.vector2 show Vector2;

frame Insets {
    pub var left: float;
    pub var top: float;
    pub var right: float;
    pub var bottom: float;

    pub init(left: float = 0.0, top: float = 0.0, right: float = 0.0, bottom: float = 0.0) {
        self.left = left;
        self.top = top;
        self.right = right;
        self.bottom = bottom;
    }

    pub fn horizontal(): float {
        return self.left + self.right;
    }

    pub fn vertical(): float {
        return self.top + self.bottom;
    }
}
