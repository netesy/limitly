// HTTP Server Module
// Built on the standard resource abstraction.

import std.core as core;
import std.resource as res;

frame ServerRequest {
    pub var method: str;
    pub var path: str;
    pub var query_string: str;
    pub var version: str;
    pub var headers: {str: str};
    pub var body: str;
    pub var remote_addr: str;
    pub var client_resource: res.Resource?;

    pub init(method: str = "GET", path: str = "/", query_string: str = "", version: str = "HTTP/1.1", headers: {str: str}? = nil, body: str = "", remote_addr: str = "", client_resource: res.Resource? = nil) {
        self.method = method;
        self.path = path;
        self.query_string = query_string;
        self.version = version;
        if (headers != nil) {
            self.headers = headers as {str: str};
        } else {
            self.headers = {};
        }
        self.body = body;
        self.remote_addr = remote_addr;
        self.client_resource = client_resource;
    }
}

frame ServerResponse {
    pub var status: int;
    pub var headers: {str: str};
    pub var body: str;

    pub init(status: int = 200, headers: {str: str}? = nil, body: str = "") {
        self.status = status;
        if (headers != nil) {
            self.headers = headers as {str: str};
        } else {
            self.headers = {};
        }
        self.body = body;
    }
}

pub type ResultServerRequest = ServerRequest | str; // Simplified Result pattern

frame HTTPServer {
    pub var host: str;
    pub var port: int;
    pub var handle: int;
    pub var running: bool;
    pub var resource: res.Resource?;
    pub var binder: res.Binder?;
    pub var listener: res.Listener?;
    pub var accepter: res.Accepter?;

    pub init() {
        self.host = "127.0.0.1";
        self.port = 8080;
        self.handle = -1;
        self.running = false;
        self.resource = nil;
        self.binder = nil;
        self.listener = nil;
        self.accepter = nil;
    }

    pub fn listen(host: str, port: int, backlog: int = 128): core.ResultInt {
        self.host = host;
        self.port = port;

        match (res.create_socket()) {
            val r => {
                var binder = res.Binder(r=r);
                if (not binder.bind(args=[host, port])) {
                    r.close();
                    return core.err_int("failed to bind to {host}:{port}");
                }

                var listener = res.Listener(r=r);
                if (not listener.listen(args=[backlog])) {
                    r.close();
                    return core.err_int("listen failed on port {port}");
                }

                self.resource = r;
                self.binder = binder;
                self.listener = listener;
                self.accepter = res.Accepter(r=r);
                self.handle = r._handle();
                self.running = true;
                return core.ok_int(self.handle);
            },
            err e => return core.err_int("failed to create socket")
        }
    }

    pub fn close(): nil {
        if (self.resource != nil) {
            var r = self.resource as res.Resource;
            r.close();
        }
        self.running = false;
    }

    pub fn accept_client(): res.Resource? {
        if (not self.running or self.accepter == nil) return nil;
        var accepter = self.accepter as res.Accepter;
        var fd = accepter.accept();
        if (fd < 0) return nil;
        return res.adopt_socket(fd);
    }

    pub fn read_request(client: res.Resource): ServerRequest? {
        var reader = res.Reader(r=client);
        var raw_bytes = reader.read_bytes();
        if (len(raw_bytes) == 0) return nil;
        
        var raw = _builtin_string_from_bytes(raw_bytes);
        return parse_server_request(raw);
    }

    pub fn send_response(client: res.Resource, resp: ServerResponse): bool {
        var writer = res.Writer(r=client);
        var raw = "HTTP/1.1 " + (resp.status as str) + " OK\r\n";
        var resp_headers = resp.headers;
        iter (k in resp_headers) {
            raw = raw + k + ": " + resp_headers[k] + "\r\n";
        }
        raw = raw + "\r\n" + resp.body;
        
        var bytes: [int] = [];
        for (var i = 0; i < len(raw); i = i + 1) {
            bytes.append(_builtin_string_byte_at(raw, i));
        }
        return writer.write(args=[bytes]) == true;
    }

    pub fn serve(handler: any): bool {
        if (not self.running) return false;
        
        match (self.accept_client()) {
            val client => {
                match (self.read_request(client)) {
                    val req => {
                        var resp = handler(req as any) as ServerResponse;
                        self.send_response(client, resp);
                        client.close();
                        return true;
                    },
                    nil => {
                        client.close();
                        return false;
                    }
                }
            },
            nil => return false
        }
    }
}

fn parse_server_request(raw: str): ServerRequest {
    if (len(raw) == 0) {
        var empty_h: {str: str} = {};
        return ServerRequest(method="", path="", query_string="", version="", headers=empty_h, body="", remote_addr="", client_resource=nil);
    }

    var header_end = index_of_h(raw, "\r\n\r\n");
    var body_str = "";
    var header_str = raw;
    if (header_end != -1) {
        header_str = substring(raw, 0, header_end);
        body_str = substring(raw, header_end + 4, len(raw));
    }

    var lines: [str] = [];
    var curr = "";
    var i = 0;
    while (i < len(header_str)) {
        if (i <= len(header_str) - 2 and substring(header_str, i, i + 2) == "\r\n") {
            lines.append(curr);
            curr = "";
            i = i + 2;
        } else {
            curr = curr + substring(header_str, i, i + 1);
            i = i + 1;
        }
    }
    if (len(curr) > 0) lines.append(curr);

    var method_val = "GET";
    var path_val = "/";
    var query_val = "";
    var version_val = "HTTP/1.1";
    var req_headers: {str: str} = {};

    if (len(lines) > 0) {
        var req_line = lines[0];
        var parts: [str] = [];
        var pcurr = "";
        var j = 0;
        while (j < len(req_line)) {
            var ch = substring(req_line, j, j + 1);
            if (ch == " ") {
                if (len(pcurr) > 0) parts.append(pcurr);
                pcurr = "";
            } else {
                pcurr = pcurr + ch;
            }
            j = j + 1;
        }
        if (len(pcurr) > 0) parts.append(pcurr);

        if (len(parts) >= 1) method_val = parts[0];
        if (len(parts) >= 2) {
            var full_path = parts[1];
            var q_idx = index_of_h(full_path, "?");
            if (q_idx != -1) {
                path_val = substring(full_path, 0, q_idx);
                query_val = substring(full_path, q_idx + 1, len(full_path));
            } else {
                path_val = full_path;
            }
        }
        if (len(parts) >= 3) version_val = parts[2];

        for (var k = 1; k < len(lines); k = k + 1) {
            var hline = lines[k];
            var colon = index_of_h(hline, ":");
            if (colon != -1) {
                var hkey = substring(hline, 0, colon);
                var hval = substring(hline, colon + 1, len(hline));
                while (len(hval) > 0 and substring(hval, 0, 1) == " ") {
                    hval = substring(hval, 1, len(hval));
                }
                req_headers[hkey] = hval;
            }
        }
    }

    return ServerRequest(
        method=method_val,
        path=path_val,
        query_string=query_val,
        version=version_val,
        headers=req_headers,
        body=body_str,
        remote_addr="",
        client_resource=nil
    );
}

fn index_of_h(s: str, pattern: str): int {
    var i: int = 0;
    while (i <= len(s) - len(pattern)) {
        if (substring(s, i, i + len(pattern)) == pattern) return i;
        i = i + 1;
    }
    return -1;
}

frame HTTP2Server {
    embed HTTPServer;
    pub var active_streams: int;

    pub init() {
        self.host = "127.0.0.1";
        self.port = 8080;
        self.handle = -1;
        self.running = false;
        self.resource = nil;
        self.binder = nil;
        self.listener = nil;
        self.accepter = nil;
        self.active_streams = 0;
    }

    pub fn handle_stream(stream_id: int, req: ServerRequest): ServerResponse {
        var h: {str: str} = {"content-type": "text/plain"};
        var resp = ServerResponse(
            status=200,
            headers=h,
            body="HTTP/2 Response Stream {stream_id}"
        );
        return resp;
    }
}
