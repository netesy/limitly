// HTTP Server Module
// Built on the standard resource abstraction.

import std.core as core;
import std.core show Error;
import std.resource as res;
import std.http.common as common;

frame ServerRequest {
    pub var method: str;
    pub var path: str;
    pub var query_string: str;
    pub var query_params: {str: str};
    pub var version: str;
    pub var headers: {str: str};
    pub var body: str;
    pub var remote_addr: str;
    pub var client_resource: res.Resource?;

    pub init(method: str = "GET", path: str = "/", query_string: str = "", version: str = "HTTP/1.1", headers: {str: str}? = nil, body: str = "", remote_addr: str = "", client_resource: res.Resource? = nil) {
        self.method = _builtin_string_to_upper(method);
        self.path = path;
        self.query_string = query_string;
        self.query_params = common.parse_query_string(query_string);
        self.version = version;
        if (headers != nil) {
            self.headers = headers as {str: str};
        } else {
            self.headers = {} as {str: str};
        }
        self.body = body;
        self.remote_addr = remote_addr;
        self.client_resource = client_resource;
    }

    pub fn header(name: str, fallback: str = ""): str {
        var lower = _builtin_string_to_lower(name);
        if (self.headers[lower] != nil) {
            return self.headers[lower];
        }
        return fallback;
    }

    pub fn query(name: str, fallback: str = ""): str {
        if (self.query_params[name] != nil) {
            return self.query_params[name];
        }
        return fallback;
    }

    pub fn is_json(): bool {
        var ct = self.header("content-type", "");
        return _builtin_string_contains(ct, "json");
    }

    pub fn cookies(): {str: str} {
        var cookie_hdr = self.header("cookie", "");
        return common.parse_cookies(cookie_hdr);
    }

    pub fn cookie(name: str): str {
        var c = self.cookies();
        if (c[name] != nil) return c[name];
        return "";
    }
}

frame ServerResponse {
    pub var status: int;
    pub var status_text: str;
    pub var headers: {str: str};
    pub var body: str;

    pub init(status: int = 200, headers: {str: str}? = nil, body: str = "", text: str = "") {
        self.status = status;
        if (text != "") {
            self.status_text = text;
        } else {
            self.status_text = common.status_text(status);
        }
        if (headers != nil) {
            self.headers = headers as {str: str};
        } else {
            self.headers = {} as {str: str};
        }
        self.body = body;
    }

    pub fn set_header(name: str, value: str): ServerResponse {
        var lower = _builtin_string_to_lower(_builtin_string_trim(name));
        self.headers[lower] = value;
        return self;
    }

    pub fn set_cookie(name: str, value: str, path: str = "/"): ServerResponse {
        var cookie_val = name + "=" + value + "; Path=" + path;
        self.set_header("set-cookie", cookie_val);
        return self;
    }

    pub fn header(name: str, fallback: str = ""): str {
        var lower = _builtin_string_to_lower(name);
        if (self.headers[lower] != nil) {
            return self.headers[lower];
        }
        return fallback;
    }

    pub fn text(status: int = 200, content: str = ""): ServerResponse {
        self.status = status;
        self.status_text = common.status_text(status);
        self.body = content;
        self.set_header("content-type", common.MIME_TEXT_PLAIN);
        self.set_header("content-length", len(content) as str);
        return self;
    }

    pub fn json(status: int = 200, json_str: str = ""): ServerResponse {
        self.status = status;
        self.status_text = common.status_text(status);
        self.body = json_str;
        self.set_header("content-type", common.MIME_APPLICATION_JSON);
        self.set_header("content-length", len(json_str) as str);
        return self;
    }

    pub fn html(status: int = 200, html_str: str = ""): ServerResponse {
        self.status = status;
        self.status_text = common.status_text(status);
        self.body = html_str;
        self.set_header("content-type", common.MIME_TEXT_HTML);
        self.set_header("content-length", len(html_str) as str);
        return self;
    }

    pub fn redirect(location: str, status: int = 302): ServerResponse {
        self.status = status;
        self.status_text = common.status_text(status);
        self.body = "";
        self.set_header("location", location);
        self.set_header("content-length", "0");
        return self;
    }

    pub fn not_found(message: str = "404 Not Found"): ServerResponse {
        return self.text(404, message);
    }
}

pub type ResultServerRequest = ServerRequest | str;

frame HTTPServer {
    pub var host: str;
    pub var port: int;
    pub var handle: int;
    pub var running: bool;
    pub var resource: res.Resource?;
    pub var binder: res.Binder?;
    pub var listener: res.Listener?;
    pub var accepter: res.Accepter?;

    pub init() {
        self.host = "127.0.0.1";
        self.port = 8080;
        self.handle = -1;
        self.running = false;
        self.resource = nil;
        self.binder = nil;
        self.listener = nil;
        self.accepter = nil;
    }

    pub fn listen(host: str, port: int, backlog: int = 128): int?Error {
        self.host = host;
        self.port = port;

        match (res.create_socket()) {
            val r => {
                var binder = res.Binder(r=r);
                if (not binder.bind(args=[host, port])) {
                    r.close();
                    return err(Error(code="BindError", message="failed to bind to " + host + ":" + (port as str)));
                }

                var listener = res.Listener(r=r);
                if (not listener.listen(args=[backlog])) {
                    r.close();
                    return err(Error(code="ListenError", message="listen failed on port " + (port as str)));
                }

                self.resource = r;
                self.binder = binder;
                self.listener = listener;
                self.accepter = res.Accepter(r=r);
                self.handle = r._handle();
                self.running = true;
                return ok(self.handle);
            },
            err e => return err(Error(code="SocketError", message="failed to create socket"))
        }
    }

    pub fn close(): nil {
        if (self.resource != nil) {
            var r = self.resource as res.Resource;
            r.close();
        }
        self.running = false;
    }

    pub fn accept_client(): res.Resource? {
        if (not self.running or self.accepter == nil) return nil;
        var accepter = self.accepter as res.Accepter;
        var fd = accepter.accept();
        if (fd < 0) return nil;
        return res.adopt_socket(fd);
    }

    pub fn read_request(client: res.Resource): ServerRequest? {
        var reader = res.Reader(r=client);
        var raw_bytes = reader.read_bytes();
        if (len(raw_bytes) == 0) return nil;
        
        var raw = _builtin_string_from_bytes(raw_bytes);
        return ok(parse_server_request(raw));
    }

    pub fn send_response(client: res.Resource, resp: ServerResponse): bool {
        var writer = res.Writer(r=client);
        var raw = "HTTP/1.1 " + (resp.status as str) + " " + resp.status_text + "\r\n";
        
        if (resp.headers["content-type"] == nil) {
            resp.headers["content-type"] = common.MIME_TEXT_PLAIN;
        }
        if (resp.headers["content-length"] == nil) {
            resp.headers["content-length"] = len(resp.body) as str;
        }
        if (resp.headers["connection"] == nil) {
            resp.headers["connection"] = "close";
        }

        iter (name, value in resp.headers) {
            raw = raw + name + ": " + value + "\r\n";
        }
        raw = raw + "\r\n" + resp.body;
        
        var bytes: [int] = [];
        var i = 0;
        while (i < len(raw)) {
            bytes.append(_builtin_string_byte_at(raw, i));
            i = i + 1;
        }
        return writer.write(args=[bytes]) == true;
    }

    pub fn serve(handler: any): bool {
        if (not self.running) return false;
        
        match (self.accept_client()) {
            val client => {
                match (self.read_request(client)) {
                    val req => {
                        var resp = handler(req as any) as ServerResponse;
                        self.send_response(client, resp);
                        client.close();
                        return true;
                    },
                    nil => {
                        client.close();
                        return false;
                    }
                }
            },
            nil => return false
        }
    }
}

pub fn parse_server_request(raw: str): ServerRequest {
    if (len(raw) == 0) {
        var empty_h: {str: str} = {};
        return ServerRequest(method="", path="", query_string="", version="", headers=empty_h, body="", remote_addr="", client_resource=nil);
    }

    var header_end = _builtin_string_index_of(raw, "\r\n\r\n");
    var body_str = "";
    var header_str = raw;
    if (header_end != -1) {
        header_str = _builtin_substring(raw, 0, header_end);
        body_str = _builtin_substring(raw, header_end + 4, len(raw));
    } else {
        header_end = _builtin_string_index_of(raw, "\n\n");
        if (header_end != -1) {
            header_str = _builtin_substring(raw, 0, header_end);
            body_str = _builtin_substring(raw, header_end + 2, len(raw));
        }
    }

    var lines: [str] = [];
    var curr = "";
    var i = 0;
    while (i < len(header_str)) {
        var ch = _builtin_substring(header_str, i, i + 1);
        if (ch == "\n") {
            if (len(curr) > 0 and _builtin_substring(curr, len(curr) - 1, len(curr)) == "\r") {
                curr = _builtin_substring(curr, 0, len(curr) - 1);
            }
            lines.append(curr);
            curr = "";
        } else {
            curr = curr + ch;
        }
        i = i + 1;
    }
    if (len(curr) > 0) lines.append(curr);

    var method_val = "GET";
    var path_val = "/";
    var query_val = "";
    var version_val = "HTTP/1.1";
    var req_headers: {str: str} = {};

    if (len(lines) > 0) {
        var req_line = lines[0];
        var parts: [str] = [];
        var pcurr = "";
        var j = 0;
        while (j < len(req_line)) {
            var ch = _builtin_substring(req_line, j, j + 1);
            if (ch == " ") {
                if (len(pcurr) > 0) parts.append(pcurr);
                pcurr = "";
            } else {
                pcurr = pcurr + ch;
            }
            j = j + 1;
        }
        if (len(pcurr) > 0) parts.append(pcurr);

        if (len(parts) >= 1) method_val = parts[0];
        if (len(parts) >= 2) {
            var full_path = parts[1];
            var q_idx = _builtin_string_index_of(full_path, "?");
            if (q_idx != -1) {
                path_val = _builtin_substring(full_path, 0, q_idx);
                query_val = _builtin_substring(full_path, q_idx + 1, len(full_path));
            } else {
                path_val = full_path;
            }
        }
        if (len(parts) >= 3) version_val = parts[2];

        var k = 1;
        while (k < len(lines)) {
            var hline = lines[k];
            var colon = _builtin_string_index_of(hline, ":");
            if (colon > 0) {
                var hkey = _builtin_string_to_lower(_builtin_string_trim(_builtin_substring(hline, 0, colon)));
                var hval = _builtin_string_trim(_builtin_substring(hline, colon + 1, len(hline)));
                req_headers[hkey] = hval;
            }
            k = k + 1;
        }
    }

    // Handle chunked transfer decoding if present
    if (req_headers["transfer-encoding"] == "chunked") {
        body_str = decode_chunked_body(body_str);
    }

    return ServerRequest(
        method=method_val,
        path=path_val,
        query_string=query_val,
        version=version_val,
        headers=req_headers,
        body=body_str,
        remote_addr="",
        client_resource=nil
    );
}

fn decode_chunked_body(body_str: str): str {
    var unchunked = "";
    var pos = 0;
    var b_len = len(body_str);
    while (pos < b_len) {
        var crlf = _builtin_string_index_of(_builtin_substring(body_str, pos, b_len), "\r\n");
        if (crlf == -1) {
            pos = b_len;
        } else {
            var chunk_head = _builtin_substring(body_str, pos, pos + crlf);
            pos = pos + crlf + 2;
            var chunk_size = parse_hex(chunk_head);
            if (chunk_size <= 0) {
                pos = b_len;
            } else {
                if (pos + chunk_size <= b_len) {
                    unchunked = unchunked + _builtin_substring(body_str, pos, pos + chunk_size);
                    pos = pos + chunk_size + 2;
                } else {
                    unchunked = unchunked + _builtin_substring(body_str, pos, b_len);
                    pos = b_len;
                }
            }
        }
    }
    return unchunked;
}

fn hex_digit_val(ch: str): int {
    if (ch >= "0" and ch <= "9") return (ch as int) - 48;
    if (ch == "a" or ch == "A") return 10;
    if (ch == "b" or ch == "B") return 11;
    if (ch == "c" or ch == "C") return 12;
    if (ch == "d" or ch == "D") return 13;
    if (ch == "e" or ch == "E") return 14;
    if (ch == "f" or ch == "F") return 15;
    return 0;
}

fn parse_hex(s: str): int {
    var value = 0;
    var i = 0;
    while (i < len(s)) {
        var ch = _builtin_substring(s, i, i + 1);
        if (ch == ";" or ch == " " or ch == "\r" or ch == "\n") {
            return value;
        }
        value = value * 16 + hex_digit_val(ch);
        i = i + 1;
    }
    return value;
}

frame HTTP2Server {
    embed HTTPServer;
    pub var active_streams: int;

    pub init() {
        self.host = "127.0.0.1";
        self.port = 8080;
        self.handle = -1;
        self.running = false;
        self.resource = nil;
        self.binder = nil;
        self.listener = nil;
        self.accepter = nil;
        self.active_streams = 0;
    }

    pub fn handle_stream(stream_id: int, req: ServerRequest): ServerResponse {
        var h: {str: str} = {"content-type": "text/plain"};
        var resp = ServerResponse(
            status=200,
            headers=h,
            body="HTTP/2 Response Stream " + (stream_id as str)
        );
        return resp;
    }
}
