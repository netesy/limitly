// Standard Library HTTP Module (Index)
// Re-exports client and server submodules.
//
// Usage:
//   import std.http as http;
//   var client = http.HTTPClient();
//   var response = client.get("http://example.com");

pub import std.http.client as client;
pub import std.http.server as server;

pub type HTTPClient = client.HTTPClient;
pub type HTTPRequest = client.HTTPRequest;
pub type HTTPResponse = client.HTTPResponse;
pub type HTTPServer = server.HTTPServer;
pub type ServerRequest = server.ServerRequest;
pub type ServerResponse = server.ServerResponse;
pub type Route = server.Route;
pub type Middleware = server.Middleware;