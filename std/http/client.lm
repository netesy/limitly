// Standard Library HTTP Client Module
// Full HTTP/1.1 client built on top of TCP and DNS resources.

import std.core as core;
import std.url as url;

// Resource constants
var RT_SOCKET: int = 1;
var RT_DNS: int = 13;
var OP_CONNECT: int = 6;
var OP_SEND: int = 4;
var OP_RECEIVE: int = 5;
var OP_CLOSE: int = 1;
var OP_RESOLVE: int = 26;

// ---- HTTP Request / Response frames ----

frame HTTPRequest {
    pub var method: str;
    pub var url_str: str;
    pub var headers: {str: str};
    pub var body: str;

    pub fn init(method: str, url_str: str) {
        self.method = method;
        self.url_str = url_str;
        self.headers = {};
        self.body = "";
        // Set default headers
        self.headers["User-Agent"] = "LimitlyHTTP/1.0";
        self.headers["Accept"] = "*/*";
        self.headers["Connection"] = "close";
    }

    pub fn set_header(name: str, value: str): HTTPRequest {
        self.headers[name] = value;
        return self;
    }

    pub fn set_body(body: str, content_type: str): HTTPRequest {
        self.body = body;
        if (content_type != "") self.headers["Content-Type"] = content_type;
        self.headers["Content-Length"] = len(body) as str;
        return self;
    }

    pub fn set_json_body(json_body: str): HTTPRequest {
        return self.set_body(json_body, "application/json");
    }

    pub fn set_form_body(form_data: str): HTTPRequest {
        return self.set_body(form_data, "application/x-www-form-urlencoded");
    }

    pub fn set_auth_basic(username: str, password: str): HTTPRequest {
        // Base64 encode "username:password"
        var encoded: str = base64_encode_str(username + ":" + password);
        self.headers["Authorization"] = "Basic " + encoded;
        return self;
    }

    pub fn set_bearer_token(token: str): HTTPRequest {
        self.headers["Authorization"] = "Bearer " + token;
        return self;
    }
}

frame HTTPResponse {
    pub var status_code: int;
    pub var status_text: str;
    pub var headers: {str: str};
    pub var body: str;
    pub var protocol: str;

    pub fn init() {
        self.status_code = 0;
        self.status_text = "";
        self.headers = {};
        self.body = "";
        self.protocol = "HTTP/1.1";
    }

    pub fn is_success(): bool {
        return self.status_code >= 200 and self.status_code < 300;
    }

    pub fn is_redirect(): bool {
        return self.status_code >= 300 and self.status_code < 400;
    }

    pub fn is_client_error(): bool {
        return self.status_code >= 400 and self.status_code < 500;
    }

    pub fn is_server_error(): bool {
        return self.status_code >= 500 and self.status_code < 600;
    }

    pub fn header(name: str): str {
        return self.headers[to_lower_header(name)];
    }

    pub fn content_type(): str {
        var ct: str = self.header("Content-Type");
        // Strip parameters (e.g., "text/html; charset=utf-8" -> "text/html")
        var semi: int = index_of_str(ct, ";");
        if (semi != -1) return substring(ct, 0, semi);
        return ct;
    }

    pub fn content_length(): int {
        var cl: str = self.header("Content-Length");
        if (cl == "") return len(self.body);
        return cl as int;
    }
}

// ---- HTTP Client ----

frame HTTPClient {
    var default_headers: {str: str};
    var follow_redirects: bool;
    var max_redirects: int;
    var timeout_ms: int;

    pub fn init() {
        self.default_headers = {};
        self.default_headers["User-Agent"] = "LimitlyHTTP/1.0";
        self.default_headers["Accept"] = "*/*";
        self.default_headers["Connection"] = "close";
        self.follow_redirects = true;
        self.max_redirects = 10;
        self.timeout_ms = 30000;
    }

    // Perform a GET request
    pub fn get(url_str: str): core.ResultHTTPResponse {
        var req: HTTPRequest = HTTPRequest("GET", url_str);
        return self.execute(req);
    }

    // Perform a POST request
    pub fn post(url_str: str, body: str, content_type: str): core.ResultHTTPResponse {
        var req: HTTPRequest = HTTPRequest("POST", url_str);
        req.set_body(body, content_type);
        return self.execute(req);
    }

    // Perform a POST with JSON body
    pub fn post_json(url_str: str, json_body: str): core.ResultHTTPResponse {
        return self.post(url_str, json_body, "application/json");
    }

    // Perform a PUT request
    pub fn put(url_str: str, body: str, content_type: str): core.ResultHTTPResponse {
        var req: HTTPRequest = HTTPRequest("PUT", url_str);
        req.set_body(body, content_type);
        return self.execute(req);
    }

    // Perform a PATCH request
    pub fn patch(url_str: str, body: str, content_type: str): core.ResultHTTPResponse {
        var req: HTTPRequest = HTTPRequest("PATCH", url_str);
        req.set_body(body, content_type);
        return self.execute(req);
    }

    // Perform a DELETE request
    pub fn delete(url_str: str): core.ResultHTTPResponse {
        var req: HTTPRequest = HTTPRequest("DELETE", url_str);
        return self.execute(req);
    }

    // Perform a HEAD request
    pub fn head(url_str: str): core.ResultHTTPResponse {
        var req: HTTPRequest = HTTPRequest("HEAD", url_str);
        return self.execute(req);
    }

    // Perform an OPTIONS request
    pub fn options(url_str: str): core.ResultHTTPResponse {
        var req: HTTPRequest = HTTPRequest("OPTIONS", url_str);
        return self.execute(req);
    }

    // Execute a request with optional redirect following
    pub fn execute(req: HTTPRequest): core.ResultHTTPResponse {
        var redirect_count: int = 0;
        var current_req: HTTPRequest = req;

        while (redirect_count <= self.max_redirects) {
            var result = self.execute_single(current_req);
            if (result.is_err()) return result;

            var resp: HTTPResponse = result.unwrap();
            if (self.follow_redirects and resp.is_redirect()) {
                var location: str = resp.header("Location");
                if (location == "") return core.ok_str("redirect");

                // Resolve relative URLs
                var base_url: url.URL = url.URL(current_req.url_str);
                var target: url.URL = base_url.resolve(location);
                current_req = HTTPRequest(current_req.method, target.to_string());
                current_req.headers = current_req.headers;
                current_req.body = current_req.body;
                redirect_count = redirect_count + 1;
            } else {
                return core.ok_str("response");
            }
        }
        return core.err_str("too many redirects (max " + self.max_redirects as str + ")");
    }

    // Execute a single HTTP request (no redirect handling)
    fn execute_single(req: HTTPRequest): core.ResultHTTPResponse {
        // Parse URL
        var parsed: url.URL = url.URL(req.url_str);
        if (not parsed.is_valid) return core.err_str("invalid URL: " + req.url_str);

        // Resolve hostname
        var host: str = parsed.host;
        if (not is_ipv4(host)) {
            var resolver = resource_create(RT_DNS);
            if (resolver == -1) return core.err_str("DNS resolver unavailable");
            var resolved = resource_call(resolver, OP_RESOLVE, host);
            resource_destroy(resolver);
            if (resolved == nil) return core.err_str("DNS resolution failed for: " + host);
            host = resolved as str;
        }

        // Connect TCP
        var sock = resource_create(RT_SOCKET);
        if (sock == -1) return core.err_str("failed to create socket");

        var connected = resource_call(sock, OP_CONNECT, host, parsed.port);
        if (connected != true) {
            resource_destroy(sock);
            return core.err_str("failed to connect to " + host + ":" + parsed.port as str);
        }

        // Build HTTP request
        var request_line: str = req.method + " " + parsed.path;
        if (parsed.query != "") request_line = request_line + "?" + parsed.query;
        request_line = request_line + " HTTP/1.1\r\n";

        // Set Host header if not present
        if (req.headers["Host"] == "") {
            var host_header: str = parsed.host;
            if (parsed.port != 80 and parsed.port != 443) {
                host_header = host_header + ":" + parsed.port as str;
            }
            req.headers["Host"] = host_header;
        }

        // Merge default headers
        var i: int = 0;
        // Build full request string
        var full_request: str = request_line;
        // Iterate over request headers and defaults
        // (Limited by language - we build the header block directly)
        full_request = full_request + "Host: " + req.headers["Host"] + "\r\n";
        if (req.headers["Content-Type"] != "") {
            full_request = full_request + "Content-Type: " + req.headers["Content-Type"] + "\r\n";
        }
        if (req.headers["Content-Length"] != "" and req.method != "GET" and req.method != "HEAD") {
            full_request = full_request + "Content-Length: " + req.headers["Content-Length"] + "\r\n";
        }
        if (req.headers["Authorization"] != "") {
            full_request = full_request + "Authorization: " + req.headers["Authorization"] + "\r\n";
        }
        full_request = full_request + "User-Agent: " + self.default_headers["User-Agent"] + "\r\n";
        full_request = full_request + "Accept: " + self.default_headers["Accept"] + "\r\n";
        full_request = full_request + "Connection: " + self.default_headers["Connection"] + "\r\n";
        full_request = full_request + "\r\n";

        // Add body for methods that have one
        if (req.body != "" and req.method != "GET" and req.method != "HEAD") {
            full_request = full_request + req.body;
        }

        // Send request
        var sent = resource_call(sock, OP_SEND, full_request);
        if (sent != true) {
            resource_call(sock, OP_CLOSE);
            resource_destroy(sock);
            return core.err_str("failed to send request");
        }

        // Receive response
        var response_data: str = "";
        while (true) {
            var chunk = resource_call(sock, OP_RECEIVE);
            if (chunk == nil) break;
            response_data = response_data + (chunk as str);
        }

        resource_call(sock, OP_CLOSE);
        resource_destroy(sock);

        // Parse response
        return parse_http_response(response_data);
    }
}

// ---- Response parser ----

fn parse_http_response(raw: str): core.ResultHTTPResponse {
    var resp: HTTPResponse = HTTPResponse();

    // Split headers and body at \r\n\r\n
    var header_end: int = index_of_str(raw, "\r\n\r\n");
    var header_section: str = "";
    var body: str = "";
    if (header_end != -1) {
        header_section = substring(raw, 0, header_end);
        body = substring(raw, header_end + 4, len(raw));
    } else {
        header_section = raw;
    }

    // Parse status line
    var first_line_end: int = index_of_str(header_section, "\r\n");
    var status_line: str = "";
    var rest_headers: str = "";
    if (first_line_end != -1) {
        status_line = substring(header_section, 0, first_line_end);
        rest_headers = substring(header_section, first_line_end + 2, len(header_section));
    } else {
        status_line = header_section;
    }

    // Parse "HTTP/1.1 200 OK"
    var parts: [str] = split_str_simple(status_line, " ");
    if (len(parts) >= 3) {
        resp.protocol = parts[0];
        resp.status_code = parts[1] as int;
        // Status text is everything after the code
        var text_start: int = len(parts[0]) + 1 + len(parts[1]) + 1;
        resp.status_text = substring(status_line, text_start, len(status_line));
    } else {
        return core.err_str("malformed HTTP status line: " + status_line);
    }

    // Parse headers
    var header_lines: [str] = split_str_simple(rest_headers, "\r\n");
    var i: int = 0;
    while (i < len(header_lines)) {
        var line: str = header_lines[i];
        if (line == "") {
            i = i + 1;
        } else {
            var colon_idx: int = index_of_str(line, ":");
            if (colon_idx != -1) {
                var name: str = to_lower_header(substring(line, 0, colon_idx));
                var value: str = trim_str(substring(line, colon_idx + 1, len(line)));
                resp.headers[name] = value;
            }
            i = i + 1;
        }
    }

    resp.body = body;
    return core.ok_str("response");
}

// ---- Internal helpers ----

fn is_ipv4(address: str): bool {
    var parts: [str] = split_str_simple(address, ".");
    if (len(parts) != 4) return false;
    var i: int = 0;
    while (i < 4) {
        var part: str = parts[i];
        if (len(part) == 0) return false;
        var j: int = 0;
        while (j < len(part)) {
            var ch: str = substring(part, j, j + 1);
            if (ch < "0" or ch > "9") return false;
            j = j + 1;
        }
        var val: int = part as int;
        if (val < 0 or val > 255) return false;
        i = i + 1;
    }
    return true;
}

fn to_lower_header(s: str): str {
    var result: str = "";
    var i: int = 0;
    while (i < len(s)) {
        var ch: str = substring(s, i, i + 1);
        if (ch >= "A" and ch <= "Z") {
            result = result + substring("abcdefghijklmnopqrstuvwxyz", (ch - "A"), (ch - "A") + 1);
        } else {
            result = result + ch;
        }
        i = i + 1;
    }
    return result;
}

fn trim_str(s: str): str {
    var start: int = 0;
    while (start < len(s) and (substring(s, start, start + 1) == " " or substring(s, start, start + 1) == "\t")) {
        start = start + 1;
    }
    var end: int = len(s) - 1;
    while (end >= start and (substring(s, end, end + 1) == " " or substring(s, end, end + 1) == "\t")) {
        end = end - 1;
    }
    if (start > end) return "";
    return substring(s, start, end + 1);
}

fn index_of_str(s: str, pattern: str): int {
    var i: int = 0;
    while (i <= len(s) - len(pattern)) {
        if (substring(s, i, i + len(pattern)) == pattern) return i;
        i = i + 1;
    }
    return -1;
}

fn split_str_simple(s: str, delimiter: str): [str] {
    var parts: [str] = [];
    var current: str = "";
    var i: int = 0;
    while (i < len(s)) {
        if (substring(s, i, i + 1) == delimiter) {
            parts = parts + [current];
            current = "";
        } else {
            current = current + substring(s, i, i + 1);
        }
        i = i + 1;
    }
    parts = parts + [current];
    return parts;
}

fn base64_encode_str(s: str): str {
    // Simple base64 encoding
    var chars: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var result: str = "";
    var i: int = 0;
    while (i < len(s)) {
        var b1: int = byte_ord(substring(s, i, i + 1));
        var b2: int = 0;
        if (i + 1 < len(s)) b2 = byte_ord(substring(s, i + 1, i + 2));
        var b3: int = 0;
        if (i + 2 < len(s)) b3 = byte_ord(substring(s, i + 2, i + 3));

        var c1: int = b1 >> 2;
        var c2: int = ((b1 & 0x3) << 4) | (b2 >> 4);
        var c3: int = ((b2 & 0xF) << 2) | (b3 >> 6);
        var c4: int = b3 & 0x3F;

        result = result + substring(chars, c1, c1 + 1);
        result = result + substring(chars, c2, c2 + 1);
        if (i + 1 < len(s)) {
            result = result + substring(chars, c3, c3 + 1);
        } else {
            result = result + "=";
        }
        if (i + 2 < len(s)) {
            result = result + substring(chars, c4, c4 + 1);
        } else {
            result = result + "=";
        }
        i = i + 3;
    }
    return result;
}

fn byte_ord(ch: str): int {
    if (ch >= "a" and ch <= "z") return 97 + (ch - "a");
    if (ch >= "A" and ch <= "Z") return 65 + (ch - "A");
    if (ch >= "0" and ch <= "9") return 48 + (ch - "0");
    if (ch == " ") return 32;
    if (ch == "\n") return 10;
    if (ch == "\r") return 13;
    if (ch == "\t") return 9;
    if (ch == ":") return 58;
    return 0;
}