// --- Default User-Agent string ---
pub const DEFAULT_USER_AGENT = "Lymar/1.0";

// --- Status code classification helpers ---
pub fn is_informational(code: int): bool { return code >= 100 and code < 200; }
pub fn is_success(code: int): bool { return code >= 200 and code < 300; }
pub fn is_redirect(code: int): bool { return code >= 300 and code < 400; }
pub fn is_client_error(code: int): bool { return code >= 400 and code < 500; }
pub fn is_server_error(code: int): bool { return code >= 500 and code < 600; }
pub fn is_error(code: int): bool { return code >= 400 and code < 600; }

pub fn is_valid_method(m: str): bool {
    var up = _builtin_string_to_upper(m);
    return up == "GET" or up == "POST" or up == "PUT" or up == "DELETE" or up == "PATCH" or up == "HEAD" or up == "OPTIONS" or up == "TRACE" or up == "CONNECT";
}

// --- Status code to reason phrase mapping ---
pub fn status_text(code: int): str {
    if (code == 100) return "Continue";
    if (code == 101) return "Switching Protocols";
    if (code == 200) return "OK";
    if (code == 201) return "Created";
    if (code == 202) return "Accepted";
    if (code == 204) return "No Content";
    if (code == 301) return "Moved Permanently";
    if (code == 302) return "Found";
    if (code == 303) return "See Other";
    if (code == 304) return "Not Modified";
    if (code == 307) return "Temporary Redirect";
    if (code == 308) return "Permanent Redirect";
    if (code == 400) return "Bad Request";
    if (code == 401) return "Unauthorized";
    if (code == 403) return "Forbidden";
    if (code == 404) return "Not Found";
    if (code == 405) return "Method Not Allowed";
    if (code == 408) return "Request Timeout";
    if (code == 409) return "Conflict";
    if (code == 410) return "Gone";
    if (code == 413) return "Payload Too Large";
    if (code == 415) return "Unsupported Media Type";
    if (code == 429) return "Too Many Requests";
    if (code == 500) return "Internal Server Error";
    if (code == 501) return "Not Implemented";
    if (code == 502) return "Bad Gateway";
    if (code == 503) return "Service Unavailable";
    if (code == 504) return "Gateway Timeout";
    return "Unknown";
}

// Parse status line: returns [version, code_str, reason]
pub fn parse_status_line(line: str): [str] {
    var parts: [str] = [];
    var p1 = _builtin_string_index_of(line, " ");
    if (p1 == -1) {
        parts.append(line);
        return parts;
    }
    var version = _builtin_substring(line, 0, p1);
    parts.append(version);

    var rest = _builtin_substring(line, p1 + 1, len(line));
    var p2 = _builtin_string_index_of(rest, " ");
    if (p2 == -1) {
        parts.append(rest);
        parts.append("");
        return parts;
    }
    var code_str = _builtin_substring(rest, 0, p2);
    var reason = _builtin_substring(rest, p2 + 1, len(rest));
    parts.append(code_str);
    parts.append(reason);
    return parts;
}

// Parse headers block into a dictionary mapping lowercase names to values
pub fn parse_headers(block: str): {str: str} {
    var headers: {str: str} = {};
    var start: int = 0;
    var i: int = 0;
    while (i < len(block)) {
        if (_builtin_substring(block, i, i + 1) == "\n") {
            var line = _builtin_substring(block, start, i);
            if (len(line) > 0 and _builtin_substring(line, len(line) - 1, len(line)) == "\r") {
                line = _builtin_substring(line, 0, len(line) - 1);
            }
            if (len(line) > 0) {
                var colon = _builtin_string_index_of(line, ":");
                if (colon > 0) {
                    var hname = _builtin_string_to_lower(_builtin_string_trim(_builtin_substring(line, 0, colon)));
                    var hval = _builtin_string_trim(_builtin_substring(line, colon + 1, len(line)));
                    headers[hname] = hval;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return headers;
}

// Build a serialized headers block string
pub fn build_headers_block(headers: {str: str}): str {
    var block = "";
    iter (name, value in headers) {
        block = block + name + ": " + value + "\r\n";
    }
    return block;
}

// Parse URL-encoded query string or form body into a dictionary
pub fn parse_query_string(qs: str): {str: str} {
    var result: {str: str} = {};
    if (len(qs) == 0) return result;
    var raw = qs;
    if (_builtin_substring(raw, 0, 1) == "?") {
        raw = _builtin_substring(raw, 1, len(raw));
    }
    var pairs: [str] = [];
    var start = 0;
    var i = 0;
    while (i < len(raw)) {
        if (_builtin_substring(raw, i, i + 1) == "&") {
            if (i > start) {
                pairs.append(_builtin_substring(raw, start, i));
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if (start < len(raw)) {
        pairs.append(_builtin_substring(raw, start, len(raw)));
    }

    var p = 0;
    while (p < len(pairs)) {
        var pair = pairs[p];
        var eq = _builtin_string_index_of(pair, "=");
        if (eq > 0) {
            var k = _builtin_substring(pair, 0, eq);
            var v = _builtin_substring(pair, eq + 1, len(pair));
            result[k] = v;
        } elif (len(pair) > 0) {
            result[pair] = "";
        }
        p = p + 1;
    }
    return result;
}

// Build URL query string from parameters
pub fn build_query_string(params: {str: str}): str {
    var out = "";
    var first = true;
    iter (k, v in params) {
        if (!first) {
            out = out + "&";
        } else {
            first = false;
        }
        out = out + k + "=" + v;
    }
    return out;
}

// Parse Cookie header into dictionary of cookie name-value pairs
pub fn parse_cookies(cookie_header: str): {str: str} {
    var cookies: {str: str} = {};
    if (len(cookie_header) == 0) return cookies;
    var start = 0;
    var i = 0;
    while (i <= len(cookie_header)) {
        if (i == len(cookie_header) or _builtin_substring(cookie_header, i, i + 1) == ";") {
            var part = _builtin_string_trim(_builtin_substring(cookie_header, start, i));
            if (len(part) > 0) {
                var eq = _builtin_string_index_of(part, "=");
                if (eq > 0) {
                    var k = _builtin_string_trim(_builtin_substring(part, 0, eq));
                    var v = _builtin_string_trim(_builtin_substring(part, eq + 1, len(part)));
                    cookies[k] = v;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return cookies;
}
