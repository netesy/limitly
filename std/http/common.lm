pub var STATUS_CONTINUE = 100;
pub var STATUS_SWITCHING_PROTOCOLS = 101;
pub var STATUS_OK = 200;
pub var STATUS_CREATED = 201;
pub var STATUS_ACCEPTED = 202;
pub var STATUS_NO_CONTENT = 204;
pub var STATUS_MOVED_PERMANENTLY = 301;
pub var STATUS_FOUND = 302;
pub var STATUS_SEE_OTHER = 303;
pub var STATUS_NOT_MODIFIED = 304;
pub var STATUS_TEMPORARY_REDIRECT = 307;
pub var STATUS_PERMANENT_REDIRECT = 308;
pub var STATUS_BAD_REQUEST = 400;
pub var STATUS_UNAUTHORIZED = 401;
pub var STATUS_FORBIDDEN = 403;
pub var STATUS_NOT_FOUND = 404;
