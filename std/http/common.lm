pub var STATUS_UNSUPPORTED_MEDIA_TYPE = 415;
pub var STATUS_TOO_MANY_REQUESTS = 429;
pub var STATUS_INTERNAL_SERVER_ERROR = 500;
pub var STATUS_NOT_IMPLEMENTED = 501;
pub var STATUS_BAD_GATEWAY = 502;
pub var STATUS_SERVICE_UNAVAILABLE = 503;
pub var STATUS_GATEWAY_TIMEOUT = 504;

