pub var METHOD_PUT = "PUT";
pub var METHOD_DELETE = "DELETE";
pub var METHOD_PATCH = "PATCH";
pub var METHOD_HEAD = "HEAD";
pub var METHOD_OPTIONS = "OPTIONS";
pub var METHOD_TRACE = "TRACE";
pub var METHOD_CONNECT = "CONNECT";

