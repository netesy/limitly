// std/algorithm/reduce.lm
// Reduce submodule for std.algorithm. Algorithmic utilities, searching, filtering, and sequence manipulation.

pub fn reduce(items: [any], f: fn(any, any): any, initial: any): any {
    var acc = initial;
    var i = 0;
    while (i < len(items)) {
        acc = f(acc, items[i]);
        i = i + 1;
    }
    return acc;
}

pub fn fold(items: [any], initial: any, f: fn(any, any): any): any {
    return reduce(items, f, initial);
}
