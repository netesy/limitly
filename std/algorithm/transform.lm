pub fn map(items: [any], f: fn(any): any): [any] {
    var res: [any] = [];
    var i = 0;
    while (i < len(items)) {
        res.append(f(items[i]));
        i = i + 1;
    }
    return res;
}

pub fn zip(left: [any], right: [any]): [any] {
    var res: [any] = [];
    var i = 0;
    var count = len(left);
    if (len(right) < count) {
        count = len(right);
    }
    while (i < count) {
        res.append((left[i], right[i]));
        i = i + 1;
    }
    return res;
}

pub fn unzip(pairs: [any]): ([any], [any]) {
    var left_res: [any] = [];
    var right_res: [any] = [];
    var i = 0;
    while (i < len(pairs)) {
        var pair = pairs[i] as (any, any);
        left_res.append(pair[0]);
        right_res.append(pair[1]);
        i = i + 1;
    }
    return (left_res, right_res);
}

pub fn transform(items: [any], f: fn(any): any): [any] {
    return map(items, f);
}

fn _reverse_range(items: [any], start: int, end: int) {
    var s = start;
    var e = end;
    while (s < e) {
        var tmp = items[s];
        items[s] = items[e];
        items[e] = tmp;
        s = s + 1;
        e = e - 1;
    }
}

pub fn reverse(items: [any]) {
    var n = len(items);
    var i = 0;
    while (i < n / 2) {
        var tmp = items[i];
        items[i] = items[n - 1 - i];
        items[n - 1 - i] = tmp;
        i = i + 1;
    }
}

pub fn rotate(items: [any], k: int) {
    var n = len(items);
    if (n == 0) return;
    var shift = k % n;
    if (shift < 0) shift = shift + n;
    if (shift == 0) return;

    _reverse_range(items, 0, n - 1);
    _reverse_range(items, 0, shift - 1);
    _reverse_range(items, shift, n - 1);
}
