// Standard Library Binary Search Submodule
//
// Fast logarithmic searching on sorted sequences.

/// Performs binary search on a sorted list to locate the index of a target value.
///
/// @param items Sorted list of elements.
/// @param value Target element to search for.
/// @return Zero-based index if found, or -1 if not present.
///
/// @example
/// ```lymar
/// var idx = binary_search([1, 3, 5, 7, 9], 5); // 2
/// ```
pub fn binary_search(items: [any], value): int {
    var low = 0;
    var high = len(items) - 1;
    while (low <= high) {
        var mid = (low + high) / 2;
        if (items[mid] == value) {
            return mid;
        }
        if (items[mid] < value) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    return -1;
}

/// Finds the index of the first element not less than value in a sorted list.
///
/// @param items Sorted list of elements.
/// @param value Target comparison value.
/// @return Index in range [0, len(items)].
pub fn lower_bound(items: [any], value): int {
    var low = 0;
    var high = len(items);
    while (low < high) {
        var mid = (low + high) / 2;
        if (items[mid] < value) {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

/// Finds the index of the first element strictly greater than value in a sorted list.
///
/// @param items Sorted list of elements.
/// @param value Target comparison value.
/// @return Index in range [0, len(items)].
pub fn upper_bound(items: [any], value): int {
    var low = 0;
    var high = len(items);
    while (low < high) {
        var mid = (low + high) / 2;
        if (items[mid] <= value) {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

/// Computes the [lower_bound, upper_bound) range for a value in a sorted list.
///
/// @param items Sorted list of elements.
/// @param value Target value.
/// @return Tuple containing (lower_bound, upper_bound).
pub fn equal_range(items: [any], value): (int, int) {
    return (lower_bound(items, value), upper_bound(items, value));
}
