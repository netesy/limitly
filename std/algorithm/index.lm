// Standard Library Algorithm Module
//
// Searching, sorting, sequence manipulation, filtering, and numerical utilities.

pub import std.algorithm.search show find, find_if, any_match, none, all, count, linear_search, interpolation_search;
pub import std.algorithm.sort show sort, quicksort, quicksort_descending, mergesort, heapsort, insertion_sort, counting_sort, radix_sort, timsort, stable_sort, partial_sort, compare_ordering;
pub import std.algorithm.partition show partition, partition_copy, is_partitioned;
pub import std.algorithm.transform show map, zip, unzip, transform, reverse, rotate;
pub import std.algorithm.reduce show reduce, fold;
pub import std.algorithm.filter show filter, remove_if;
pub import std.algorithm.unique show unique;
pub import std.algorithm.shuffle show shuffle;
pub import std.algorithm.binary_search show binary_search, lower_bound, upper_bound, equal_range;

/// Tests whether an integer is a prime number.
///
/// @param n Integer number to test.
/// @return `true` if prime, `false` otherwise.
pub fn is_prime(n: int): bool {
    if (n <= 1) return false;
    if (n <= 3) return true;
    if (n % 2 == 0 or n % 3 == 0) return false;
    var i = 5;
    while (i * i <= n) {
        if (n % i == 0 or n % (i + 2) == 0) return false;
        i = i + 6;
    }
    return true;
}
