// Standard Library Sequence Search Submodule
//
// Linear search, predicate search, quantifiers (all, any, none), and interpolation search.

/// Finds the first index of a matching value using linear traversal.
///
/// @param items Sequence to search.
/// @param value Target element to find.
/// @return Index if found, or -1 if not present.
///
/// @example
/// ```lymar
/// var idx = linear_search(["a", "b", "c"], "b"); // 1
/// ```
pub fn linear_search(items: [any], value): int {
    var i = 0;
    while (i < len(items)) {
        if (items[i] == value) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Alias for linear_search to find a matching value.
///
/// @param items Sequence to search.
/// @param value Target element.
/// @return Index if found, or -1.
pub fn find(items: [any], value): int {
    return linear_search(items, value);
}

/// Finds the index of the first element satisfying a predicate function.
///
/// @param items Sequence to search.
/// @param p Predicate callback returning boolean.
/// @return Index of matching item, or -1 if none match.
pub fn find_if(items: [any], p: fn(any): bool): int {
    var i = 0;
    while (i < len(items)) {
        if (p(items[i])) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Checks whether at least one element satisfies the predicate.
///
/// @param items Sequence to inspect.
/// @param p Predicate callback.
/// @return `true` if any element satisfies `p`, `false` otherwise.
pub fn any_match(items: [any], p: fn(any): bool): bool {
    var i = 0;
    while (i < len(items)) {
        if (p(items[i])) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Checks whether no elements satisfy the predicate.
///
/// @param items Sequence to inspect.
/// @param p Predicate callback.
/// @return `true` if no element satisfies `p`, `false` otherwise.
pub fn none(items: [any], p: fn(any): bool): bool {
    return not any_match(items, p);
}

/// Checks whether all elements satisfy the predicate.
///
/// @param items Sequence to inspect.
/// @param p Predicate callback.
/// @return `true` if every element satisfies `p`, `false` otherwise.
pub fn all(items: [any], p: fn(any): bool): bool {
    var i = 0;
    while (i < len(items)) {
        if (not p(items[i])) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Counts the number of occurrences of value within items.
///
/// @param items Sequence to scan.
/// @param value Value to count.
/// @return Occurrence count.
pub fn count(items: [any], value): int {
    var c = 0;
    var i = 0;
    while (i < len(items)) {
        if (items[i] == value) {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

/// Fast interpolation search on uniformly distributed sorted integer arrays.
///
/// @param items Sorted list of integer values.
/// @param target Integer value to locate.
/// @return Index if found, or -1 if absent.
pub fn interpolation_search(items: [int], target: int): int {
    var low = 0;
    var high = len(items) - 1;
    while (low <= high and target >= items[low] and target <= items[high]) {
        if (low == high) {
            if (items[low] == target) return low;
            return -1;
        }
        var pos = low + ((target - items[low]) * (high - low)) / (items[high] - items[low]);
        if (items[pos] == target) return pos;
        if (items[pos] < target) low = pos + 1;
        else high = pos - 1;
    }
    return -1;
}
