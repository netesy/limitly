pub fn linear_search(items: [any], value: any): int {
    var i = 0;
    while (i < len(items)) {
        if (items[i] == value) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn find(items: [any], value: any): int {
    return linear_search(items, value);
}

pub fn find_if(items: [any], p: fn(any): bool): int {
    var i = 0;
    while (i < len(items)) {
        if (p(items[i])) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn any_match(items: [any], p: fn(any): bool): bool {
    var i = 0;
    while (i < len(items)) {
        if (p(items[i])) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn none(items: [any], p: fn(any): bool): bool {
    return !any_match(items, p);
}

pub fn all(items: [any], p: fn(any): bool): bool {
    var i = 0;
    while (i < len(items)) {
        if (!p(items[i])) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn count(items: [any], value: any): int {
    var c = 0;
    var i = 0;
    while (i < len(items)) {
        if (items[i] == value) {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

pub fn interpolation_search(items: [int], target: int): int {
    var low = 0;
    var high = len(items) - 1;
    while (low <= high and target >= items[low] and target <= items[high]) {
        if (low == high) {
            if (items[low] == target) return low;
            return -1;
        }
        var pos = low + ((target - items[low]) * (high - low)) / (items[high] - items[low]);
        if (items[pos] == target) return pos;
        if (items[pos] < target) low = pos + 1;
        else high = pos - 1;
    }
    return -1;
}
