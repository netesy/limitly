// std/config/index.lm
// Public entrypoint and facade for std.config. Configuration parsing, environment settings, and configuration loaders.

import std.env as env;

pub import std.config.loader show load_json;
pub import std.config.environment show load_from_env;

/// In-memory configuration store supporting type-coerced lookups.
frame Config {
    pub keys: [str];
    pub vals: [str];

    /// Retrieves a configuration property with typed fallback default.
    ///
    /// Automatically converts string storage representations to boolean or integer
    /// if the value matches numeric or boolean literal patterns.
    ///
    /// @param key Property key name.
    /// @param default_val Fallback value returned if key is missing.
    /// @return Coerced value or default_val.
    /// @example
    /// ```lymar
    /// var port = cfg.get("port", 8080) as int;
    /// ```
    pub fn get(key: str, default_val: any): any {
        contract(len(key) > 0, "key cannot be empty");
        var i = 0;
        var length = len(self.keys);
        while (i < length) {
            if (self.keys[i] == key) {
                var val_str = self.vals[i];
                if (val_str == "true") return true;
                if (val_str == "false") return false;

                // Check if it's a number
                var j = 0;
                var is_num = true;
                var val_len = len(val_str);
                if (val_len == 0) is_num = false;
                while (j < val_len) {
                    var ch = _builtin_substring(val_str, j, j + 1);
                    if (ch < "0" or ch > "9") {
                        is_num = false;
                    }
                    j = j + 1;
                }
                if (is_num) {
                    return val_str as int;
                }
                return val_str;
            }
            i = i + 1;
        }
        return default_val;
    }

    /// Sets or updates a configuration key with a typed value.
    ///
    /// @param key Property key name.
    /// @param val_any Value to serialize and store.
    pub fn set(key: str, val_any: any) {
        contract(len(key) > 0, "key cannot be empty");
        var val_str = "{val_any}";

        // Find existing or append
        var i = 0;
        var length = len(self.keys);
        while (i < length) {
            if (self.keys[i] == key) {
                self.vals[i] = val_str;
                return nil;
            }
            i = i + 1;
        }
        self.keys.append(key);
        self.vals.append(val_str);
        return nil;
    }

    /// Checks if a configuration key exists.
    ///
    /// @param key Property key to query.
    /// @return `true` if key is present, `false` otherwise.
    pub fn has(key: str): bool {
        contract(len(key) > 0, "key cannot be empty");
        var i = 0;
        var length = len(self.keys);
        while (i < length) {
            if (self.keys[i] == key) return true;
            i = i + 1;
        }
        return false;
    }
}

/// Creates a new empty configuration instance.
///
/// @return Initialized `Config` instance.
pub fn new_config(): Config {
    var k: [str] = [];
    var v: [str] = [];
    return Config(keys=k, vals=v);
}

/// Parses a simple JSON string representation into a `Config` object.
///
/// @param json_str JSON formatted text.
/// @return Populated `Config` instance.
pub fn load_json(json_str: str): Config {
    contract(len(json_str) >= 0, "json_str must be a valid string");
    var cfg = new_config();
    var i: int = 0;
    var length = len(json_str);
    while (i < length) {
        var ch = _builtin_substring(json_str, i, i + 1);
        if (ch == "\"") {
            // Read key
            var key_start = i + 1;
            i = i + 1;
            while (i < length and _builtin_substring(json_str, i, i + 1) != "\"") {
                i = i + 1;
            }
            var key = _builtin_substring(json_str, key_start, i);
            i = i + 1; // skip closing quote

            // Find colon
            while (i < length and _builtin_substring(json_str, i, i + 1) != ":") {
                i = i + 1;
            }
            i = i + 1; // skip colon

            // Skip spaces
            while (i < length and (_builtin_substring(json_str, i, i + 1) == " " or _builtin_substring(json_str, i, i + 1) == "\t" or _builtin_substring(json_str, i, i + 1) == "\n" or _builtin_substring(json_str, i, i + 1) == "\r")) {
                i = i + 1;
            }

            // Read value
            if (i < length) {
                var c = _builtin_substring(json_str, i, i + 1);
                if (c == "\"") {
                    // String value
                    var val_start = i + 1;
                    i = i + 1;
                    while (i < length and _builtin_substring(json_str, i, i + 1) != "\"") {
                        i = i + 1;
                    }
                    var val_str = _builtin_substring(json_str, val_start, i);
                    cfg.set(key, val_str);
                    i = i + 1;
                } elif (c == "t" or c == "f") {
                    // Boolean value
                    var val_start = i;
                    while (i < length and _builtin_substring(json_str, i, i + 1) >= "a" and _builtin_substring(json_str, i, i + 1) <= "z") {
                        i = i + 1;
                    }
                    var val_str = _builtin_substring(json_str, val_start, i);
                    if (val_str == "true") {
                        cfg.set(key, true);
                    } else {
                        cfg.set(key, false);
                    }
                } elif ((c >= "0" and c <= "9") or c == "-") {
                    // Number value
                    var val_start = i;
                    while (i < length) {
                        var num_c = _builtin_substring(json_str, i, i + 1);
                        if ((num_c >= "0" and num_c <= "9") or num_c == "." or num_c == "-") {
                            i = i + 1;
                        } else {
                            break;
                        }
                    }
                    var val_str = _builtin_substring(json_str, val_start, i);
                    var val_int = val_str as int;
                    cfg.set(key, val_int);
                }
            }
        } else {
            i = i + 1;
        }
    }
    return cfg;
}

/// Loads specific environment variables into a `Config` instance.
///
/// @param keys List of environment variable names to import.
/// @return `Config` containing resolved environment variables.
pub fn load_from_env(keys: [str]): Config {
    contract(len(keys) >= 0, "keys must be a valid list");
    var cfg = new_config();
    var e = env.Env() as env.Env;
    var i = 0;
    while (i < len(keys)) {
        var key = keys[i];
        var value = e.get_or(key, "");
        if (value != "") {
            cfg.set(key, value);
        }
        i = i + 1;
    }
    return cfg;
}
