// Standard Library Config Module Index

import std.env as env;

pub frame Config {
    pub keys: [str];
    pub vals: [str];

    pub fn get(key: str, default_val: any): any {
        var i = 0;
        var length = len(self.keys);
        while (i < length) {
            if (self.keys[i] == key) {
                var val_str = self.vals[i];
                if (val_str == "true") return true;
                if (val_str == "false") return false;

                // Check if it's a number
                var j = 0;
                var is_num = true;
                var val_len = len(val_str);
                if (val_len == 0) is_num = false;
                while (j < val_len) {
                    var ch = val_str[j];
                    if (ch < "0" or ch > "9") {
                        is_num = false;
                    }
                    j = j + 1;
                }
                if (is_num) {
                    return val_str as int;
                }
                return val_str;
            }
            i = i + 1;
        }
        return default_val;
    }

    pub fn set(key: str, val_any: any) {
        var val_str = "";
        if (val_any as str != nil) {
            val_str = val_any as str;
        } elif (val_any as bool == true or val_any as bool == false) {
            var val_bool = val_any as bool;
            val_str = "{val_bool}";
        } else {
            var val_int = val_any as int;
            val_str = "{val_int}";
        }

        // Find existing or append
        var i = 0;
        var length = len(self.keys);
        while (i < length) {
            if (self.keys[i] == key) {
                self.vals[i] = val_str;
                return nil;
            }
            i = i + 1;
        }
        self.keys.append(key);
        self.vals.append(val_str);
        return nil;
    }

    pub fn has(key: str): bool {
        var i = 0;
        var length = len(self.keys);
        while (i < length) {
            if (self.keys[i] == key) return true;
            i = i + 1;
        }
        return false;
    }
}

pub fn new_config(): Config {
    var k: [str] = [];
    var v: [str] = [];
    return Config(keys=k, vals=v);
}

pub fn load_json(json_str: str): Config {
    var cfg = new_config();
    // A simple parser of key-value JSON pairs
    var i: int = 0;
    var length = len(json_str);
    while (i < length) {
        var ch = json_str[i];
        if (ch == "\"") {
            // Read key
            var key_start = i + 1;
            i = i + 1;
            while (i < length and json_str[i] != "\"") {
                i = i + 1;
            }
            var key = _builtin_substring(json_str, key_start, i);
            i = i + 1; // skip closing quote

            // Find colon
            while (i < length and json_str[i] != ":") {
                i = i + 1;
            }
            i = i + 1; // skip colon

            // Skip spaces
            while (i < length and (json_str[i] == " " or json_str[i] == "\t" or json_str[i] == "\n" or json_str[i] == "\r")) {
                i = i + 1;
            }

            // Read value
            if (i < length) {
                if (json_str[i] == "\"") {
                    // String value
                    var val_start = i + 1;
                    i = i + 1;
                    while (i < length and json_str[i] != "\"") {
                        i = i + 1;
                    }
                    var val_str = _builtin_substring(json_str, val_start, i);
                    cfg.set(key, val_str);
                    i = i + 1;
                } else if (json_str[i] == "t" or json_str[i] == "f") {
                    // Boolean value
                    var val_start = i;
                    while (i < length and json_str[i] >= "a" and json_str[i] <= "z") {
                        i = i + 1;
                    }
                    var val_str = _builtin_substring(json_str, val_start, i);
                    if (val_str == "true") {
                        cfg.set(key, true);
                    } else {
                        cfg.set(key, false);
                    }
                } else if ((json_str[i] >= "0" and json_str[i] <= "9") or json_str[i] == "-") {
                    // Number value
                    var val_start = i;
                    while (i < length and ((json_str[i] >= "0" and json_str[i] <= "9") or json_str[i] == "." or json_str[i] == "-")) {
                        i = i + 1;
                    }
                    var val_str = _builtin_substring(json_str, val_start, i);
                    var val_int = val_str as int;
                    cfg.set(key, val_int);
                }
            }
        } else {
            i = i + 1;
        }
    }
    return cfg;
}

pub fn load_from_env(keys: [str]): Config {
    var cfg = new_config();
    var e = env.Env() as env.Env;
    var i = 0;
    while (i < len(keys)) {
        var key = keys[i];
        var value_item = e.get(key);
        if (value_item != nil) {
            cfg.set(key, value_item as str);
        }
        i = i + 1;
    }
    return cfg;
}
