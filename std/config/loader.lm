// Configuration Loader Module

pub fn load_json(json_str: str): {str: any} {
    var conf = {} as {str: any};
    // A simple, robust parser of key-value JSON pairs
    // Parse strings, numbers, booleans, and simple objects.
    // e.g. {"key": "value", "port": 8080, "debug": true}

    var i: int = 0;
    var length = len(json_str);
    while (i < length) {
        var ch = json_str[i];
        if (ch == "\"") {
            // Read key
            var key_start = i + 1;
            i = i + 1;
            while (i < length and json_str[i] != "\"") {
                i = i + 1;
            }
            var key = _builtin_substring(json_str, key_start, i);
            i = i + 1; // skip closing quote

            // Find colon
            while (i < length and json_str[i] != ":") {
                i = i + 1;
            }
            i = i + 1; // skip colon

            // Skip spaces
            while (i < length and (json_str[i] == " " or json_str[i] == "\t" or json_str[i] == "\n" or json_str[i] == "\r")) {
                i = i + 1;
            }

            // Read value
            if (i < length) {
                if (json_str[i] == "\"") {
                    // String value
                    var val_start = i + 1;
                    i = i + 1;
                    while (i < length and json_str[i] != "\"") {
                        i = i + 1;
                    }
                    var val_str = _builtin_substring(json_str, val_start, i);
                    conf[key] = val_str;
                    i = i + 1;
                } else if (json_str[i] == "t" or json_str[i] == "f") {
                    // Boolean value
                    var val_start = i;
                    while (i < length and json_str[i] >= "a" and json_str[i] <= "z") {
                        i = i + 1;
                    }
                    var val_str = _builtin_substring(json_str, val_start, i);
                    if (val_str == "true") {
                        conf[key] = true;
                    } else {
                        conf[key] = false;
                    }
                } else if ((json_str[i] >= "0" and json_str[i] <= "9") or json_str[i] == "-") {
                    // Number value
                    var val_start = i;
                    while (i < length and ((json_str[i] >= "0" and json_str[i] <= "9") or json_str[i] == "." or json_str[i] == "-")) {
                        i = i + 1;
                    }
                    var val_str = _builtin_substring(json_str, val_start, i);
                    var val_int = val_str as int;
                    conf[key] = val_int;
                }
            }
        } else {
            i = i + 1;
        }
    }

    return conf;
}
