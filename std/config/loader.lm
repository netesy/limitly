// std/config/loader.lm
// Configuration Loader Module

/// Parses a simple JSON string representation into a key-value dictionary.
///
/// Supports string, boolean, integer, and float values.
///
/// @param json_str JSON formatted configuration text.
/// @return Dictionary mapping string keys to parsed values.
/// @example
/// ```lymar
/// var map = loader.load_json("{\"port\": 8080, \"debug\": true}");
/// ```
pub fn load_json(json_str: str): {str: any} {
    contract(len(json_str) >= 0, "json_str must be a valid string");
    var conf = {} as {str: any};

    var i: int = 0;
    var length = len(json_str);
    while (i < length) {
        var ch = _builtin_substring(json_str, i, i + 1);
        if (ch == "\"") {
            // Read key
            var key_start = i + 1;
            i = i + 1;
            while (i < length and _builtin_substring(json_str, i, i + 1) != "\"") {
                i = i + 1;
            }
            var key = _builtin_substring(json_str, key_start, i);
            i = i + 1; // skip closing quote

            // Find colon
            while (i < length and _builtin_substring(json_str, i, i + 1) != ":") {
                i = i + 1;
            }
            i = i + 1; // skip colon

            // Skip spaces
            while (i < length and (_builtin_substring(json_str, i, i + 1) == " " or _builtin_substring(json_str, i, i + 1) == "\t" or _builtin_substring(json_str, i, i + 1) == "\n" or _builtin_substring(json_str, i, i + 1) == "\r")) {
                i = i + 1;
            }

            // Read value
            if (i < length) {
                var c = _builtin_substring(json_str, i, i + 1);
                if (c == "\"") {
                    // String value
                    var val_start = i + 1;
                    i = i + 1;
                    while (i < length and _builtin_substring(json_str, i, i + 1) != "\"") {
                        i = i + 1;
                    }
                    var val_str = _builtin_substring(json_str, val_start, i);
                    conf[key] = val_str;
                    i = i + 1;
                } elif (c == "t" or c == "f") {
                    // Boolean value
                    var val_start = i;
                    while (i < length and _builtin_substring(json_str, i, i + 1) >= "a" and _builtin_substring(json_str, i, i + 1) <= "z") {
                        i = i + 1;
                    }
                    var val_str = _builtin_substring(json_str, val_start, i);
                    if (val_str == "true") {
                        conf[key] = true;
                    } else {
                        conf[key] = false;
                    }
                } elif ((c >= "0" and c <= "9") or c == "-") {
                    // Number value
                    var val_start = i;
                    while (i < length) {
                        var num_c = _builtin_substring(json_str, i, i + 1);
                        if ((num_c >= "0" and num_c <= "9") or num_c == "." or num_c == "-") {
                            i = i + 1;
                        } else {
                            break;
                        }
                    }
                    var val_str = _builtin_substring(json_str, val_start, i);
                    var val_int = val_str as int;
                    conf[key] = val_int;
                }
            }
        } else {
            i = i + 1;
        }
    }

    return conf;
}
