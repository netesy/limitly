// Configuration Environment Module

import std.env as env;

pub fn load_from_env(keys: [str]): {str: str} {
    var result = {"_Lymar_init": "nil"};
    var e = env.Env() as env.Env;
    var i: int = 0;
    while (i < len(keys)) {
        var key = keys[i];
        // get_or yields a plain str. Env.get yields an optional whose payload
        // needs `?` or a match to unwrap, and casting it with `as str` gives the
        // text "ok(...)" instead of the value.
        var value = e.get_or(key, "");
        if (value != "") {
            result[key] = value;
        }
        i = i + 1;
    }
    return result;
}
