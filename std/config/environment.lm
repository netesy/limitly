// std/config/environment.lm
// Configuration Environment Module

import std.env as env;

/// Loads configuration key-value mappings from environment variables.
///
/// @param keys List of environment variable names to query.
/// @return Dictionary mapping found environment variables to their string values.
/// @example
/// ```lymar
/// var env_cfg = environment.load_from_env(["PORT", "HOST"]);
/// ```
pub fn load_from_env(keys: [str]): {str: str} {
    contract(len(keys) >= 0, "keys must be a valid list");
    var result = {"_Lymar_init": "nil"};
    var e = env.Env() as env.Env;
    var i: int = 0;
    while (i < len(keys)) {
        var key = keys[i];
        // get_or yields a plain str. Env.get yields an optional whose payload
        // needs `?` or a match to unwrap, and casting it with `as str` gives the
        // text "ok(...)" instead of the value.
        var value = e.get_or(key, "");
        if (value != "") {
            result[key] = value;
        }
        i = i + 1;
    }
    return result;
}
