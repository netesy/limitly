// Standard phone validation

fn is_digit_char(ch: str): bool {
    if (ch == "0") return true;
    if (ch == "1") return true;
    if (ch == "2") return true;
    if (ch == "3") return true;
    if (ch == "4") return true;
    if (ch == "5") return true;
    if (ch == "6") return true;
    if (ch == "7") return true;
    if (ch == "8") return true;
    if (ch == "9") return true;
    return false;
}

pub fn is_phone(value: str): bool {
    if (value == "") return false;

    // Allows optional '+' at the start, followed by digits, spaces, hyphens, or parentheses
    var i: int = 0;
    var length = len(value);
    var first_ch = _builtin_substring(value, 0, 1);
    if (first_ch == "+") {
        i = 1;
    }

    var has_digit = false;
    while (i < length) {
        var ch = _builtin_substring(value, i, i + 1);
        if (is_digit_char(ch) == true) {
            has_digit = true;
        } else if (ch == " " or ch == "-" or ch == "(" or ch == ")") {
            // allowed separators
        } else {
            return false;
        }
        i = i + 1;
    }
    return has_digit;
}
