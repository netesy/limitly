// std/validation/phone.lm
// International and domestic telephone number validation.

fn is_digit_char(ch: str): bool {
    if (ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4") return true;
    if (ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9") return true;
    return false;
}

/// Validates whether a candidate string is a telephone number.
///
/// Allows an optional leading '+' country code prefix, digits, and standard separators (spaces, hyphens, parentheses).
///
/// @param value Candidate phone number string.
/// @return True if string matches telephone formatting rules.
pub fn is_phone(value: str): bool {
    if (value == "") return false;

    var i: int = 0;
    var length = len(value);
    var first_ch = _builtin_substring(value, 0, 1);
    if (first_ch == "+") {
        i = 1;
    }

    var has_digit = false;
    while (i < length) {
        var ch = _builtin_substring(value, i, i + 1);
        if (is_digit_char(ch)) {
            has_digit = true;
        } elif (ch != " " and ch != "-" and ch != "(" and ch != ")") {
            return false;
        }
        i = i + 1;
    }
    return has_digit;
}
