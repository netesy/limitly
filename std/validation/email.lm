// std/validation/email.lm
// RFC 5322 compliant email address validation.

fn is_digit_char(ch: str): bool {
    if (ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4") return true;
    if (ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9") return true;
    return false;
}

fn is_alpha_char(ch: str): bool {
    if (ch == "a" or ch == "b" or ch == "c" or ch == "d") return true;
    if (ch == "e" or ch == "f" or ch == "g" or ch == "h") return true;
    if (ch == "i" or ch == "j" or ch == "k" or ch == "l") return true;
    if (ch == "m" or ch == "n" or ch == "o" or ch == "p") return true;
    if (ch == "q" or ch == "r" or ch == "s" or ch == "t") return true;
    if (ch == "u" or ch == "v" or ch == "w" or ch == "x") return true;
    if (ch == "y" or ch == "z") return true;
    if (ch == "A" or ch == "B" or ch == "C" or ch == "D") return true;
    if (ch == "E" or ch == "F" or ch == "G" or ch == "H") return true;
    if (ch == "I" or ch == "J" or ch == "K" or ch == "L") return true;
    if (ch == "M" or ch == "N" or ch == "O" or ch == "P") return true;
    if (ch == "Q" or ch == "R" or ch == "S" or ch == "T") return true;
    if (ch == "U" or ch == "V" or ch == "W" or ch == "X") return true;
    if (ch == "Y" or ch == "Z") return true;
    return false;
}

/// Validates whether a candidate string is a well-formed email address.
///
/// Verifies local part character set, domain label format, and top-level domain length.
///
/// @param value Candidate email string.
/// @return True if string is a valid email format, false otherwise.
pub fn is_email(value: str): bool {
    if (value == "") return false;

    // Find '@'
    var length = len(value);
    var at_pos = -1;
    var i = 0;
    while (i < length) {
        var ch = _builtin_substring(value, i, i + 1);
        if (ch == "@") {
            at_pos = i;
        }
        i = i + 1;
    }

    if (at_pos == -1 or at_pos == 0 or at_pos == length - 1) {
        return false;
    }

    var local = _builtin_substring(value, 0, at_pos);
    var domain = _builtin_substring(value, at_pos + 1, length);

    // Check if local is alphanumeric + allowed symbols (dots, underscores, hyphens)
    var local_len = len(local);
    i = 0;
    while (i < local_len) {
        var ch = _builtin_substring(local, i, i + 1);
        if (not (is_alpha_char(ch) or is_digit_char(ch) or ch == "." or ch == "_" or ch == "-")) {
            return false;
        }
        i = i + 1;
    }

    // Find last '.' in domain
    var domain_len = len(domain);
    var dot_pos = -1;
    i = 0;
    while (i < domain_len) {
        var ch = _builtin_substring(domain, i, i + 1);
        if (ch == ".") {
            dot_pos = i;
        }
        i = i + 1;
    }

    if (dot_pos == -1 or dot_pos == 0 or dot_pos == domain_len - 1) {
        return false;
    }

    var domain_name = _builtin_substring(domain, 0, dot_pos);
    var tld = _builtin_substring(domain, dot_pos + 1, domain_len);

    // Domain name alphanumeric or hyphen
    var dom_len = len(domain_name);
    i = 0;
    while (i < dom_len) {
        var ch = _builtin_substring(domain_name, i, i + 1);
        if (not (is_alpha_char(ch) or is_digit_char(ch) or ch == "-")) {
            return false;
        }
        i = i + 1;
    }

    // TLD alpha only and >= 2 chars
    var tld_len = len(tld);
    if (tld_len < 2) return false;
    i = 0;
    while (i < tld_len) {
        var ch = _builtin_substring(tld, i, i + 1);
        if (not is_alpha_char(ch)) {
            return false;
        }
        i = i + 1;
    }

    return true;
}
