// std/validation/index.lm
// Comprehensive input, format, type, and pattern validation library.

/// Input validation library providing validators for numbers, emails, phone numbers,
/// URLs, domains, UUIDs, IP addresses, and custom compound rules.
///
/// @example
/// import std.validation as v;
/// print(v.is_email("user@example.com")); // true
/// print(v.is_number("-123.45")); // true
/// print(v.is_url("https://lymar.org")); // true

import std.validation.email as email;
import std.validation.phone as phone;
import std.validation.url as url;
import std.string.split as split;

pub import std.validation.email show is_email;
pub import std.validation.phone show is_phone;
pub import std.validation.url show is_url, is_domain;

fn starts_with(s: str, prefix: str): bool {
    var plen = len(prefix);
    var slen = len(s);
    if (plen > slen) return false;
    return _builtin_substring(s, 0, plen) == prefix;
}

fn ends_with(s: str, suffix: str): bool {
    var suflen = len(suffix);
    var slen = len(s);
    if (suflen > slen) return false;
    return _builtin_substring(s, slen - suflen, slen) == suffix;
}

fn contains(s: str, sub: str): bool {
    var sublen = len(sub);
    var slen = len(s);
    if (sublen > slen) return false;
    var i = 0;
    while (i <= slen - sublen) {
        if (_builtin_substring(s, i, i + sublen) == sub) return true;
        i = i + 1;
    }
    return false;
}

fn count(s: str, pattern: str): int {
    var plen = len(pattern);
    var slen = len(s);
    if (plen > slen or plen == 0) return 0;
    var occurrences = 0;
    var i = 0;
    while (i <= slen - plen) {
        if (_builtin_substring(s, i, i + plen) == pattern) {
            occurrences = occurrences + 1;
            i = i + plen;
        } else {
            i = i + 1;
        }
    }
    return occurrences;
}

fn is_digit_char(ch: str): bool {
    if (ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4") return true;
    if (ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9") return true;
    return false;
}

fn is_alpha_char(ch: str): bool {
    if (ch == "a" or ch == "b" or ch == "c" or ch == "d") return true;
    if (ch == "e" or ch == "f" or ch == "g" or ch == "h") return true;
    if (ch == "i" or ch == "j" or ch == "k" or ch == "l") return true;
    if (ch == "m" or ch == "n" or ch == "o" or ch == "p") return true;
    if (ch == "q" or ch == "r" or ch == "s" or ch == "t") return true;
    if (ch == "u" or ch == "v" or ch == "w" or ch == "x") return true;
    if (ch == "y" or ch == "z") return true;
    if (ch == "A" or ch == "B" or ch == "C" or ch == "D") return true;
    if (ch == "E" or ch == "F" or ch == "G" or ch == "H") return true;
    if (ch == "I" or ch == "J" or ch == "K" or ch == "L") return true;
    if (ch == "M" or ch == "N" or ch == "O" or ch == "P") return true;
    if (ch == "Q" or ch == "R" or ch == "S" or ch == "T") return true;
    if (ch == "U" or ch == "V" or ch == "W" or ch == "X") return true;
    if (ch == "Y" or ch == "Z") return true;
    return false;
}

/// Comprehensive validator providing string, numeric, pattern, and compound checks.
frame Validate {
    pub init() {}

    /// Checks if a string is empty ("").
    pub fn is_empty(value: str): bool {
        return value == "";
    }

    /// Checks if a string contains at least one character.
    pub fn is_not_empty(value: str): bool {
        return value != "";
    }

    /// Checks if a string consists exclusively of whitespace characters.
    pub fn is_blank(value: str): bool {
        var i: int = 0;
        var length = len(value);
        while (i < length) {
            var ch = _builtin_substring(value, i, i + 1);
            if (ch != " " and ch != "\t" and ch != "\n" and ch != "\r") {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /// Checks if a string represents a valid signed decimal or integer number.
    pub fn is_number(value: str): bool {
        if (value == "") return false;

        var i: int = 0;
        var has_digit = false;
        var has_decimal = false;
        var length = len(value);

        if (i < length) {
            var first_ch = _builtin_substring(value, i, i + 1);
            if (first_ch == "-" or first_ch == "+") {
                i = i + 1;
            }
        }

        while (i < length) {
            var ch = _builtin_substring(value, i, i + 1);
            if (is_digit_char(ch)) {
                has_digit = true;
            } elif (ch == "." and not has_decimal) {
                has_decimal = true;
            } else {
                return false;
            }
            i = i + 1;
        }

        return has_digit;
    }

    /// Checks if a string represents a valid signed integer.
    pub fn is_integer(value: str): bool {
        if (value == "") return false;

        var i: int = 0;
        var has_digit = false;
        var length = len(value);

        if (i < length) {
            var first_ch = _builtin_substring(value, i, i + 1);
            if (first_ch == "-" or first_ch == "+") {
                i = i + 1;
            }
        }

        while (i < length) {
            var ch = _builtin_substring(value, i, i + 1);
            if (is_digit_char(ch)) {
                has_digit = true;
            } else {
                return false;
            }
            i = i + 1;
        }

        return has_digit;
    }

    /// Checks if a string consists exclusively of alphabetic letters.
    pub fn is_alpha(value: str): bool {
        if (value == "") return false;

        var i: int = 0;
        var length = len(value);
        while (i < length) {
            var ch = _builtin_substring(value, i, i + 1);
            if (not is_alpha_char(ch)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /// Checks if a string consists exclusively of alphanumeric characters.
    pub fn is_alphanumeric(value: str): bool {
        if (value == "") return false;

        var i: int = 0;
        var length = len(value);
        while (i < length) {
            var ch = _builtin_substring(value, i, i + 1);
            if (not (is_alpha_char(ch) or is_digit_char(ch))) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /// Checks if a string is a valid email address.
    pub fn is_email(value: str): bool {
        return email.is_email(value);
    }

    /// Checks if a string is a valid phone number.
    pub fn is_phone(value: str): bool {
        return phone.is_phone(value);
    }

    /// Checks if a string is a valid URL.
    pub fn is_url(value: str): bool {
        return url.is_url(value);
    }

    /// Checks if a string is a valid domain name.
    pub fn is_domain(value: str): bool {
        return url.is_domain(value);
    }

    /// Checks if a string is a valid RFC 4122 UUID.
    pub fn is_uuid(value: str): bool {
        if (value == "") return false;
        var length = len(value);
        if (length != 36) return false;

        var expected_dashes = [8, 13, 18, 23];
        var i: int = 0;
        var dash_index: int = 0;

        while (i < length) {
            var ch = _builtin_substring(value, i, i + 1);

            if (dash_index < len(expected_dashes) and i == expected_dashes[dash_index]) {
                if (ch != "-") return false;
                dash_index = dash_index + 1;
            } else {
                var is_hex = is_digit_char(ch) or ch == "a" or ch == "b" or ch == "c" or ch == "d" or ch == "e" or ch == "f" or ch == "A" or ch == "B" or ch == "C" or ch == "D" or ch == "E" or ch == "F";
                if (not is_hex) {
                    return false;
                }
            }
            i = i + 1;
        }

        return true;
    }

    /// Checks if a string is a valid IPv4 or IPv6 address.
    pub fn is_ip_address(value: str): bool {
        return self.is_ipv4(value) or self.is_ipv6(value);
    }

    /// Checks if a string is a valid IPv4 address (e.g. 192.168.1.1).
    pub fn is_ipv4(value: str): bool {
        if (value == "") return false;

        var parts = split.split(value, ".");
        if (len(parts) != 4) return false;

        var i: int = 0;
        while (i < len(parts)) {
            var part = parts[i];
            if (not self.is_integer(part)) return false;

            var num = part as int;
            if (num < 0 or num > 255) return false;

            i = i + 1;
        }

        return true;
    }

    /// Checks if a string is a valid IPv6 address.
    pub fn is_ipv6(value: str): bool {
        if (value == "") return false;
        if (count(value, ":") < 2) return false;
        return true;
    }

    /// Checks if string length falls within inclusive range [min_val, max_val].
    ///
    /// @pre min_val <= max_val
    pub fn length_range(value: str, min_val: int, max_val: int): bool {
        contract(min_val <= max_val, "Minimum length must not exceed maximum length");
        var length = len(value);
        return length >= min_val and length <= max_val;
    }

    /// Checks if string length is at least `min_val`.
    pub fn min_length(value: str, min_val: int): bool {
        return len(value) >= min_val;
    }

    /// Checks if string length is at most `max_val`.
    pub fn max_length(value: str, max_val: int): bool {
        return len(value) <= max_val;
    }

    /// Checks if string has exact length `length`.
    pub fn exact_length(value: str, length: int): bool {
        return len(value) == length;
    }

    /// Checks if string contains `substring_val`.
    pub fn contains(value: str, substring_val: str): bool {
        return contains(value, substring_val);
    }

    /// Checks if string begins with `prefix`.
    pub fn starts_with(value: str, prefix: str): bool {
        return starts_with(value, prefix);
    }

    /// Checks if string ends with `suffix`.
    pub fn ends_with(value: str, suffix: str): bool {
        return ends_with(value, suffix);
    }

    /// Checks if string contains the given pattern.
    pub fn matches_pattern(value: str, pattern: str): bool {
        return contains(value, pattern);
    }

    /// Validates string using a custom predicate function.
    pub fn custom_validator(value: str, validator: fn(str): bool): bool {
        var v_func = validator;
        return v_func(value);
    }

    /// Checks if all validator predicates pass for `value`.
    pub fn all_valid(value: str, validators: [fn(str): bool]): bool {
        var i: int = 0;
        while (i < len(validators)) {
            var val_func = validators[i];
            if (not val_func(value)) return false;
            i = i + 1;
        }
        return true;
    }

    /// Checks if at least one validator predicate passes for `value`.
    pub fn any_valid(value: str, validators: [fn(str): bool]): bool {
        var i: int = 0;
        while (i < len(validators)) {
            var val_func = validators[i];
            if (val_func(value)) return true;
            i = i + 1;
        }
        return false;
    }
}

var _validator = Validate();

/// Checks if string is empty.
pub fn is_empty(value: str): bool {
    return _validator.is_empty(value);
}

/// Checks if string is numeric.
pub fn is_number(value: str): bool {
    return _validator.is_number(value);
}
