// std/validation/url.lm
// URL and domain name format validation.

fn starts_with(s: str, prefix: str): bool {
    var plen = len(prefix);
    var slen = len(s);
    if (plen > slen) return false;
    return _builtin_substring(s, 0, plen) == prefix;
}

fn index_of(s: str, pattern: str): int {
    var plen = len(pattern);
    var slen = len(s);
    if (plen > slen) return -1;
    var i = 0;
    while (i <= slen - plen) {
        if (_builtin_substring(s, i, i + plen) == pattern) return i;
        i = i + 1;
    }
    return -1;
}

fn last_index_of(s: str, pattern: str): int {
    var plen = len(pattern);
    var slen = len(s);
    if (plen > slen) return -1;
    var i = slen - plen;
    while (i >= 0) {
        if (_builtin_substring(s, i, i + plen) == pattern) return i;
        i = i - 1;
    }
    return -1;
}

fn is_digit_char(ch: str): bool {
    if (ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4") return true;
    if (ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9") return true;
    return false;
}

fn is_alpha_char(ch: str): bool {
    if (ch == "a" or ch == "b" or ch == "c" or ch == "d") return true;
    if (ch == "e" or ch == "f" or ch == "g" or ch == "h") return true;
    if (ch == "i" or ch == "j" or ch == "k" or ch == "l") return true;
    if (ch == "m" or ch == "n" or ch == "o" or ch == "p") return true;
    if (ch == "q" or ch == "r" or ch == "s" or ch == "t") return true;
    if (ch == "u" or ch == "v" or ch == "w" or ch == "x") return true;
    if (ch == "y" or ch == "z") return true;
    if (ch == "A" or ch == "B" or ch == "C" or ch == "D") return true;
    if (ch == "E" or ch == "F" or ch == "G" or ch == "H") return true;
    if (ch == "I" or ch == "J" or ch == "K" or ch == "L") return true;
    if (ch == "M" or ch == "N" or ch == "O" or ch == "P") return true;
    if (ch == "Q" or ch == "R" or ch == "S" or ch == "T") return true;
    if (ch == "U" or ch == "V" or ch == "W" or ch == "X") return true;
    if (ch == "Y" or ch == "Z") return true;
    return false;
}

/// Validates whether a candidate string is a well-formed HTTP or HTTPS URL.
///
/// @param value Candidate URL string.
/// @return True if string begins with http:// or https:// and contains a valid domain.
pub fn is_url(value: str): bool {
    if (value == "") return false;

    if (starts_with(value, "http://") or starts_with(value, "https://")) {
        var after_proto = "";
        var length = len(value);
        if (starts_with(value, "http://")) {
            after_proto = _builtin_substring(value, 7, length);
        } else {
            after_proto = _builtin_substring(value, 8, length);
        }
        var slash_pos = index_of(after_proto, "/");
        var domain = after_proto;
        if (slash_pos != -1) {
            domain = _builtin_substring(after_proto, 0, slash_pos);
        }

        return is_domain(domain);
    }

    return false;
}

/// Validates whether a string is a well-formed Internet domain name.
///
/// @param value Candidate domain name string.
/// @return True if domain and TLD follow standard naming conventions.
pub fn is_domain(value: str): bool {
    if (value == "") return false;

    var dot_pos = last_index_of(value, ".");
    if (dot_pos == -1 or dot_pos == 0 or dot_pos == len(value) - 1) {
        return false;
    }

    var domain_name = _builtin_substring(value, 0, dot_pos);
    var tld = _builtin_substring(value, dot_pos + 1, len(value));

    // domain name check
    var i: int = 0;
    var dom_len = len(domain_name);
    while (i < dom_len) {
        var ch = _builtin_substring(domain_name, i, i + 1);
        if (not (is_alpha_char(ch) or is_digit_char(ch) or ch == "-")) {
            return false;
        }
        i = i + 1;
    }

    // tld check
    i = 0;
    var tld_len = len(tld);
    while (i < tld_len) {
        var ch = _builtin_substring(tld, i, i + 1);
        if (not is_alpha_char(ch)) {
            return false;
        }
        i = i + 1;
    }

    return tld_len >= 2;
}
