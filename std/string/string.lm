// std/string/string.lm
// The String wrapper frame.
//
// Only `frame String` lives here; the free-function helpers are split across the
// sibling submodules (basic, search, casing, split, join, trim, replace) and
// re-exported by std/string/index.lm.

// Imported under an alias: calling the unqualified `split(...)` from inside the
// `String.split` method would resolve back to the method itself, not the helper.
import std.string.split as split_mod;

frame String {
    pub var value: str;

    pub init(value: str) {
        self.value = value;
    }

    pub fn length(): int { return len(self.value); }

    pub fn concat(other: str): str {
        return self.value + other;
    }

    pub fn trim(): str {
        return _builtin_string_trim(self.value);
    }

    pub fn to_upper(): str {
        return _builtin_string_to_upper(self.value);
    }

    pub fn to_lower(): str {
        return _builtin_string_to_lower(self.value);
    }

    pub fn contains(needle: str): bool {
        return _builtin_string_contains(self.value, needle);
    }

    pub fn split(delimiter: str): [str] {
        return split_mod.split(self.value, delimiter);
    }

    pub fn replace(old: str, replacement: str): str {
        return _builtin_string_replace(self.value, old, replacement);
    }

    pub fn starts_with(prefix: str): bool {
        return _builtin_string_starts_with(self.value, prefix);
    }

    pub fn ends_with(suffix: str): bool {
        return _builtin_string_ends_with(self.value, suffix);
    }

    // Clamped slice: out-of-range bounds yield "" / the tail instead of trapping.
    pub fn substring(start: int, end: int): str {
        if (start < 0) return "";
        var l = len(self.value);
        var end_idx = end;
        if (end_idx > l) end_idx = l;
        if (start >= l) return "";
        return _builtin_substring(self.value, start, end_idx);
    }

    pub fn char_at(index: int): str {
        if (index < 0 or index >= len(self.value)) return "";
        return _builtin_substring(self.value, index, index + 1);
    }

    pub fn byte_at(index: int): int {
        return _builtin_string_byte_at(self.value, index);
    }

    pub fn repeat(count: int): str {
        var res = "";
        var i = 0;
        while (i < count) {
            res = res + self.value;
            i = i + 1;
        }
        return res;
    }

    pub fn pad_left(width: int, fill: str = " "): str {
        var n = width - len(self.value);
        if (n <= 0) return self.value;
        return String(fill).repeat(n) + self.value;
    }

    pub fn pad_right(width: int, fill: str = " "): str {
        var n = width - len(self.value);
        if (n <= 0) return self.value;
        return self.value + String(fill).repeat(n);
    }

    pub fn index_of(sub: str): int {
        return _builtin_string_index_of(self.value, sub);
    }

    pub fn last_index_of(sub: str): int {
        if (sub == "") return len(self.value);
        var sub_len = len(sub);
        var val_len = len(self.value);
        if (sub_len > val_len) return -1;

        var i = val_len - sub_len;
        while (i >= 0) {
            if (_builtin_substring(self.value, i, i + sub_len) == sub) {
                return i;
            }
            i = i - 1;
        }
        return -1;
    }
}
