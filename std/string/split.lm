// std/string/split.lm
// Splitting a string on a delimiter.

/// Splits a string into substrings using a separator string.
///
/// If `delimiter` is empty, splits the string into individual single-character tokens.
///
/// @param value The string to split.
/// @param delimiter Separator string.
/// @return List of split string segments.
/// @example
/// ```lymar
/// var parts = split.split("apple,banana,orange", ",");
/// ```
pub fn split(value: str, delimiter: str): [str] {
    var dlen = len(delimiter);
    var vlen = len(value);
    var parts: [str] = [];
    if (dlen == 0) {
        var i = 0;
        while (i < vlen) {
            parts.append(_builtin_substring(value, i, i + 1));
            i = i + 1;
        }
        return parts;
    }
    var start = 0;
    var i = 0;
    while (i <= vlen - dlen) {
        val sub = _builtin_substring(value, i, i + dlen);
        if (sub == delimiter) {
            val part = _builtin_substring(value, start, i);
            parts.append(part);
            start = i + dlen;
            i = start;
        } else {
            i = i + 1;
        }
    }
    val rem = _builtin_substring(value, start, vlen);
    parts.append(rem);
    return parts;
}
