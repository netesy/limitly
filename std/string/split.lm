// Standard Library String Split Module

pub fn split(value: str, delimiter: str): [str] {
    var dlen = len(delimiter);
    var vlen = len(value);
    var parts: [str] = [];
    if (dlen == 0) {
        var i = 0;
        while (i < vlen) {
            parts.append(_builtin_substring(value, i, i + 1));
            i = i + 1;
        }
        return parts;
    }
    var start = 0;
    var i = 0;
    while (i <= vlen - dlen) {
        if (_builtin_substring(value, i, i + dlen) == delimiter) {
            parts.append(_builtin_substring(value, start, i));
            start = i + dlen;
            i = start;
        } else {
            i = i + 1;
        }
    }
    parts.append(_builtin_substring(value, start, vlen));
    return parts;
}
