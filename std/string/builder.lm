frame StringBuilder {
    pub var parts: [str] = [] as [str];

    pub init() {
        self.parts = [] as [str];
    }

    // Append a fragment. Returns nil (not the builder) on purpose: returning a
    // `StringBuilder` by value deep-copies the growing `parts` list on every call,
    // which made repeated appends quadratic. Callers use these as statements.
    pub fn append(s: str): nil {
        self.parts.append(s);
    }

    pub fn append_str(s: str): nil {
        self.append(s);
    }

    pub fn append_line(s: str): nil {
        self.parts.append(s);
        self.parts.append("\n");
    }

    pub fn append_char(cp: int): nil {
        var ch = _builtin_string_from_bytes([cp]);
        self.parts.append(ch);
    }

    pub fn clear(): nil {
        self.parts = [] as [str];
    }

    pub fn length(): int {
        var total = 0;
        var i = 0;
        while (i < len(self.parts)) {
            total = total + len(self.parts[i]);
            i = i + 1;
        }
        return total;
    }

    pub fn to_string(): str {
        return _builtin_string_join(self.parts, "");
    }
}

pub fn builder(): StringBuilder {
    return StringBuilder();
}
