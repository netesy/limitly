// Standard Library Sort Module

pub fn _compare(a: any, b: any, descending: bool = false, cmp: fn(any, any): int = nil): int {
    var result: int = 0;
    if (cmp != nil) {
        // Dynamic call on 'cmp' which is a function pointer
        var res = cmp(a, b);
        result = res as int;
    } else {
        if (a < b) {
            result = -1;
        } else {
            if (a > b) {
                result = 1;
            } else {
                result = 0;
            }
        }
    }
    if (descending == true) {
        return 0 - result;
    }
    return result;
}

pub fn _swap(items: [any], i: int, j: int) {
    var temp = items[i];
    items[i] = items[j];
    items[j] = temp;
}

pub fn insertion_sort(items: [any], descending: bool = false, cmp: fn(any, any): int = nil) {
    var n = len(items);
    var i = 1;
    while (i < n) {
        var key = items[i];
        var j = i - 1;
        while (j >= 0 and _compare(items[j], key, descending, cmp) > 0) {
            items[j + 1] = items[j];
            j = j - 1;
        }
        items[j + 1] = key;
        i = i + 1;
    }
}

pub fn _partition(items: [any], low: int, high: int, descending: bool, cmp: fn(any, any): int): int {
    var pivot = items[high];
    var i = low - 1;
    var j = low;
    while (j < high) {
        if (_compare(items[j], pivot, descending, cmp) <= 0) {
            i = i + 1;
            _swap(items, i, j);
        }
        j = j + 1;
    }
    _swap(items, i + 1, high);
    return i + 1;
}

pub fn _quicksort_range(items: [any], low: int, high: int, descending: bool, cmp: fn(any, any): int) {
    if (low < high) {
        var p = _partition(items, low, high, descending, cmp);
        _quicksort_range(items, low, p - 1, descending, cmp);
        _quicksort_range(items, p + 1, high, descending, cmp);
    }
}

pub fn quicksort(items: [any], descending: bool = false, cmp: fn(any, any): int = nil) {
    if (len(items) > 1) {
        _quicksort_range(items, 0, len(items) - 1, descending, cmp);
    }
}

pub fn _merge(items: [any], left: int, mid: int, right: int, descending: bool, cmp: fn(any, any): int) {
    var temp: [any] = [];
    var i = left;
    var j = mid + 1;
    while (i <= mid and j <= right) {
        if (_compare(items[i], items[j], descending, cmp) <= 0) {
            temp.append(items[i]);
            i = i + 1;
        } else {
            temp.append(items[j]);
            j = j + 1;
        }
    }
    while (i <= mid) {
        temp.append(items[i]);
        i = i + 1;
    }
    while (j <= right) {
        temp.append(items[j]);
        j = j + 1;
    }
    var k = 0;
    while (k < len(temp)) {
        items[left + k] = temp[k];
        k = k + 1;
    }
}

pub fn _mergesort_range(items: [any], left: int, right: int, descending: bool, cmp: fn(any, any): int) {
    if (left < right) {
        var mid = (left + right) / 2;
        _mergesort_range(items, left, mid, descending, cmp);
        _mergesort_range(items, mid + 1, right, descending, cmp);
        _merge(items, left, mid, right, descending, cmp);
    }
}

pub fn mergesort(items: [any], descending: bool = false, cmp: fn(any, any): int = nil) {
    if (len(items) > 1) {
        _mergesort_range(items, 0, len(items) - 1, descending, cmp);
    }
}

pub fn _heapify(items: [any], n: int, i: int, descending: bool, cmp: fn(any, any): int) {
    var best = i;
    var l = 2 * i + 1;
    var r = 2 * i + 2;
    if (l < n and _compare(items[l], items[best], descending, cmp) > 0) {
        best = l;
    }
    if (r < n and _compare(items[r], items[best], descending, cmp) > 0) {
        best = r;
    }
    if (best != i) {
        _swap(items, i, best);
        _heapify(items, n, best, descending, cmp);
    }
}

pub fn heapsort(items: [any], descending: bool = false, cmp: fn(any, any): int = nil) {
    var n = len(items);
    if (n <= 1) return;
    var i = n / 2 - 1;
    while (i >= 0) {
        _heapify(items, n, i, descending, cmp);
        i = i - 1;
    }
    i = n - 1;
    while (i > 0) {
        _swap(items, 0, i);
        _heapify(items, i, 0, descending, cmp);
        i = i - 1;
    }
    if (descending == false) {
        return;
    }
    var a = 0;
    var b = n - 1;
    while (a < b) {
        _swap(items, a, b);
        a = a + 1;
        b = b - 1;
    }
}

pub fn counting_sort(items: [int], descending: bool = false) {
    var n = len(items);
    if (n <= 1) {
        return;
    }
    var min_value = items[0];
    var max_value = items[0];
    var i = 1;
    while (i < n) {
        if (items[i] < min_value) {
            min_value = items[i];
        }
        if (items[i] > max_value) {
            max_value = items[i];
        }
        i = i + 1;
    }
    var counts: [int] = [];
    i = 0;
    while (i <= max_value - min_value) {
        var zero: int = 0;
        counts.append(zero);
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        counts[items[i] - min_value] = counts[items[i] - min_value] + 1;
        i = i + 1;
    }
    var out = 0;
    var c = 0;
    while (c < len(counts)) {
        while (counts[c] > 0) {
            if (descending == true) {
                items[out] = max_value - c;
            } else {
                items[out] = min_value + c;
            }
            out = out + 1;
            counts[c] = counts[c] - 1;
        }
        c = c + 1;
    }
}

pub fn radix_sort(items: [int], descending: bool = false) {
    counting_sort(items, descending);
}

pub fn timsort(items: [any], descending: bool = false, cmp: fn(any, any): int = nil) {
    stable_sort(items, descending, cmp);
}

pub fn stable_sort(items: [any], descending: bool = false, cmp: fn(any, any): int = nil) {
    mergesort(items, descending, cmp);
}

pub fn partial_sort(items: [any], count: int, descending: bool = false, cmp: fn(any, any): int = nil) {
    quicksort(items, descending, cmp);
    if (count < 0) {
        return;
    }
}

pub fn sort(items: [any], descending: bool = false, cmp: fn(any, any): int = nil) {
    quicksort(items, descending, cmp);
}
