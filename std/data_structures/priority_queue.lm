// Priority Queue Frame - Min-heap based priority queue

frame PriorityQueue {
    pub var data: [int];

    pub init() {
        self.data = [];
    }

    pub fn push(item: int) {
        self.data = self.data + [item];
        self._sift_up(len(self.data) - 1);
    }

    pub fn enqueue(item: int) {
        self.push(item);
    }

    pub fn insert(item: int) {
        self.push(item);
    }

    pub fn pop(): int? {
        var n = len(self.data);
        if (n == 0) {
            return nil;
        }
        var result = self.data[0];
        self.data[0] = self.data[n - 1];
        var next_data: [int] = [];
        var i = 0;
        while (i < n - 1) {
            next_data = next_data + [self.data[i]];
            i = i + 1;
        }
        self.data = next_data;
        if (len(self.data) > 0) {
            self._sift_down(0);
        }
        return result;
    }

    pub fn remove(): int? {
        return self.pop();
    }

    pub fn dequeue(): int? {
        return self.pop();
    }

    pub fn peek(): int? {
        if (len(self.data) == 0) {
            return nil;
        }
        return self.data[0];
    }

    pub fn length(): int {
        return len(self.data);
    }

    pub fn len(): int {
        return self.length();
    }

    pub fn size(): int {
        return self.length();
    }

    pub fn is_empty(): bool {
        return len(self.data) == 0;
    }

    pub fn clear() {
        self.data = [];
    }

    pub fn contains(value: int): bool {
        var i = 0;
        while (i < len(self.data)) {
            if (self.data[i] == value) return true;
            i = i + 1;
        }
        return false;
    }

    pub fn to_array(): [int] {
        import std.collections.vector as vector;
        var result = vector.Vector();
        var i = 0;
        while (i < len(self.data)) {
            result.push(self.data[i]);
            i = i + 1;
        }
        return result.data;
    }

    fn _sift_up(idx: int) {
        while (idx > 0) {
            var parent = (idx - 1) / 2;
            if (self.data[idx] < self.data[parent]) {
                var tmp = self.data[idx];
                self.data[idx] = self.data[parent];
                self.data[parent] = tmp;
                idx = parent;
            } else {
                return;
            }
        }
    }

    fn _sift_down(idx: int) {
        var n = len(self.data);
        while (true) {
            var smallest = idx;
            var left = 2 * idx + 1;
            var right = 2 * idx + 2;
            if (left < n and self.data[left] < self.data[smallest]) {
                smallest = left;
            }
            if (right < n and self.data[right] < self.data[smallest]) {
                smallest = right;
            }
            if (smallest != idx) {
                var tmp = self.data[idx];
                self.data[idx] = self.data[smallest];
                self.data[smallest] = tmp;
                idx = smallest;
            } else {
                return;
            }
        }
    }
}

fn priority_queue(): PriorityQueue {
    return PriorityQueue();
}

fn priority_queue_from_array(arr: [int]): PriorityQueue {
    var pq = PriorityQueue();
    var i = 0;
    while (i < len(arr)) {
        pq.push(arr[i]);
        i = i + 1;
    }
    return pq;
}
