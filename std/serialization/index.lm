// Serialization module - JSON and binary data serialization

import std.core as core;
import std.encoding as encoding;

frame Serialization {
    
    // JSON serialization
    pub fn json_encode(value: str): core.ResultStr {
        if (value == "") return core.ok_str("\"\"");
        
        var result = "\"";
        var i: int = 0;
        var length: int = len(value);
        
        while (i < length) {
            var ch = _builtin_substring(value, i, i + 1);
            
            if (ch == "\"") {
                result = result + "\\\"";
            } else if (ch == "\\") {
                result = result + "\\\\";
            } else if (ch == "\n") {
                result = result + "\\n";
            } else if (ch == "\r") {
                result = result + "\\r";
            } else if (ch == "\t") {
                result = result + "\\t";
            } else {
                result = result + ch;
            }
            
            i = i + 1;
        }
        
        result = result + "\"";
        return core.ok_str(result);
    }

    pub fn json_decode(value: str): core.ResultStr {
        if (value == "") return core.ok_str("");
        var length: int = len(value);
        if (length < 2 or _builtin_substring(value, 0, 1) != "\"" or _builtin_substring(value, length - 1, length) != "\"") {
            return core.err_str("Invalid JSON string");
        }
        
        var result = "";
        var i: int = 1;
        
        while (i < length - 1) {
            var ch = _builtin_substring(value, i, i + 1);
            
            if (ch == "\\") {
                if (i + 1 < length - 1) {
                    var next_ch = _builtin_substring(value, i + 1, i + 2);
                    
                    if (next_ch == "\"") {
                        result = result + "\"";
                    } else if (next_ch == "\\") {
                        result = result + "\\";
                    } else if (next_ch == "n") {
                        result = result + "\n";
                    } else if (next_ch == "r") {
                        result = result + "\r";
                    } else if (next_ch == "t") {
                        result = result + "\t";
                    } else {
                        result = result + next_ch;
                    }
                    i = i + 1;
                }
            } else {
                result = result + ch;
            }
            
            i = i + 1;
        }
        
        return core.ok_str(result);
    }

    // JSON object serialization (basic)
    pub fn json_encode_object(obj: {str: str}): core.ResultStr {
        var d = obj;
        var result = "{";
        var first = true;
        
        iter (key in d) {
            var value = d[key];
            if (not first) {
                result = result + ",";
            }
            var encoded_key = self.json_encode(key);
            var encoded_value = self.json_encode(value);
            if (encoded_key.is_ok() and encoded_value.is_ok()) {
                result = result + encoded_key.unwrap() + ":" + encoded_value.unwrap();
                first = false;
            }
        }
        
        result = result + "}";
        return core.ok_str(result);
    }

    // JSON array serialization (basic)
    pub fn json_encode_array(arr: [str]): core.ResultStr {
        if (len(arr) == 0) return core.ok_str("[]");
        
        var result = "[";
        var i: int = 0;
        
        while (i < len(arr)) {
            if (i > 0) result = result + ",";
            
            var encoded = self.json_encode(arr[i]);
            if (encoded.is_ok()) {
                result = result + encoded.unwrap();
            }
            
            i = i + 1;
        }
        
        result = result + "]";
        return core.ok_str(result);
    }

    // Binary serialization (simple format)
    pub fn binary_encode(value: str): core.ResultStr {
        var length = len(value);
        var length_bytes = self.int_to_bytes(length, 4);
        var data_bytes = value;
        return core.ok_str(length_bytes + data_bytes);
    }

    pub fn binary_decode(value: str): core.ResultStr {
        var vlen = len(value);
        if (vlen < 4) {
            return core.err_str("Invalid binary data: too short");
        }
        
        var length_bytes = _builtin_substring(value, 0, 4);
        var length = self.bytes_to_int(length_bytes);
        
        if (vlen < 4 + length) {
            return core.err_str("Invalid binary data: length mismatch");
        }
        
        var data = _builtin_substring(value, 4, 4 + length);
        return core.ok_str(data);
    }

    // Advanced binary serialization with type information
    pub fn binary_encode_typed(data: str, type_id: int): core.ResultStr {
        var type_byte = _builtin_string_from_bytes([type_id % 256]);
        var length_bytes = self.int_to_bytes(len(data), 4);
        return core.ok_str(type_byte + length_bytes + data);
    }

    pub fn binary_decode_typed(value: str): core.ResultStr {
        var vlen = len(value);
        if (vlen < 5) {
            return core.err_str("Invalid typed binary data: too short");
        }
        
        var length_bytes = _builtin_substring(value, 1, 5);
        var length = self.bytes_to_int(length_bytes);
        
        if (vlen < 5 + length) {
            return core.err_str("Invalid typed binary data: length mismatch");
        }
        
        var data = _builtin_substring(value, 5, 5 + length);
        return core.ok_str(data);
    }

    // Utility methods
    fn int_to_bytes(value: int, num_bytes: int): str {
        var bytes: [int] = [];
        var i: int = 0;
        
        while (i < num_bytes) {
            var b = (value >> ((num_bytes - 1 - i) * 8)) & 0xFF;
            bytes.append(b);
            i = i + 1;
        }
        
        return _builtin_string_from_bytes(bytes);
    }

    fn bytes_to_int(bytes: str): int {
        var blen = len(bytes);
        if (blen == 0) return 0;
        
        var result = 0;
        var i: int = 0;
        
        while (i < blen) {
            var byte = _builtin_string_byte_at(bytes, i);
            result = (result << 8) | byte;
            i = i + 1;
        }
        
        return result;
    }

    fn get_dict_keys(dict: {str: str}): [str] {
        var keys: [str] = [];
        var d = dict;
        iter (k in d) {
            keys.append(k);
        }
        return keys;
    }
}

// Utility functions
pub fn json_encode(value: str): core.ResultStr {
    var s = Serialization();
    return s.json_encode(value);
}

pub fn json_decode(value: str): core.ResultStr {
    var s = Serialization();
    return s.json_decode(value);
}

pub fn binary_encode(value: str): core.ResultStr {
    var s = Serialization();
    return s.binary_encode(value);
}

pub fn binary_decode(value: str): core.ResultStr {
    var s = Serialization();
    return s.binary_decode(value);
}

pub fn json_encode_object(obj: {str: str}): core.ResultStr {
    var s = Serialization();
    return s.json_encode_object(obj);
}

pub fn json_encode_array(arr: [str]): core.ResultStr {
    var s = Serialization();
    return s.json_encode_array(arr);
}
