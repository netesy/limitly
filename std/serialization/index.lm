// Serialization: JSON string escaping and length-prefixed binary framing.
//
// Both halves are pure functions over a `str`, so this module exports free
// functions rather than a frame that holds no state and only exists to let its
// methods call one another. Operations that can reject their input return
// `str?Error`; unwrap with `?`, `? else { return ...; }` or
// `match (v) { val x => ..., err e => ... }`.
//
// The binary format is deliberately minimal: a payload is prefixed with its
// byte length as a big-endian 32-bit value, and the typed variant adds a
// one-byte type id in front of that length.

import std.core show Error;

// ---------------------------------------------------------------------------
// JSON strings
// ---------------------------------------------------------------------------

// Escape `value` and wrap the result in double quotes. Never fails.
pub fn json_encode(value: str): str {
    var result = "\"";
    var i: int = 0;
    var length: int = len(value);

    while (i < length) {
        var ch = _builtin_substring(value, i, i + 1);

        if (ch == "\"") {
            result = result + "\\\"";
        } else if (ch == "\\") {
            result = result + "\\\\";
        } else if (ch == "\n") {
            result = result + "\\n";
        } else if (ch == "\r") {
            result = result + "\\r";
        } else if (ch == "\t") {
            result = result + "\\t";
        } else {
            result = result + ch;
        }

        i = i + 1;
    }

    return result + "\"";
}

// Undo json_encode. Rejects input that is not wrapped in double quotes, which
// is what an unquoted JSON scalar or an empty string looks like here.
pub fn json_decode(value: str): str?Error {
    var length: int = len(value);
    if (length < 2) {
        return err(Error(code="DecodeError", message="not a JSON string: too short"));
    }
    if (_builtin_substring(value, 0, 1) != "\""
        or _builtin_substring(value, length - 1, length) != "\"") {
        return err(Error(code="DecodeError", message="not a JSON string: missing quotes"));
    }

    var result = "";
    var i: int = 1;

    while (i < length - 1) {
        var ch = _builtin_substring(value, i, i + 1);

        if (ch == "\\") {
            if (i + 1 < length - 1) {
                var next_ch = _builtin_substring(value, i + 1, i + 2);

                if (next_ch == "\"") {
                    result = result + "\"";
                } else if (next_ch == "\\") {
                    result = result + "\\";
                } else if (next_ch == "n") {
                    result = result + "\n";
                } else if (next_ch == "r") {
                    result = result + "\r";
                } else if (next_ch == "t") {
                    result = result + "\t";
                } else {
                    result = result + next_ch;
                }
                i = i + 1;
            }
        } else {
            result = result + ch;
        }

        i = i + 1;
    }

    return ok(result);
}

// `{"key":value,...}` in dictionary iteration order. Dictionaries are walked
// with the two-variable form, `iter (key, value in dict)`.
pub fn json_encode_object(obj: {str: str}): str {
    var result = "{";
    var first = true;

    iter (key, value in obj) {
        if (not first) {
            result = result + ",";
        }
        result = result + json_encode(key) + ":" + json_encode(value);
        first = false;
    }

    return result + "}";
}

// `[value,...]` in list order.
pub fn json_encode_array(arr: [str]): str {
    var result = "[";
    var i: int = 0;

    while (i < len(arr)) {
        if (i > 0) {
            result = result + ",";
        }
        result = result + json_encode(arr[i]);
        i = i + 1;
    }

    return result + "]";
}

// ---------------------------------------------------------------------------
// Binary framing
// ---------------------------------------------------------------------------

pub fn binary_encode(value: str): str {
    return int_to_bytes(len(value), 4) + value;
}

pub fn binary_decode(value: str): str?Error {
    var vlen = len(value);
    if (vlen < 4) {
        return err(Error(code="DecodeError", message="binary frame: too short for a length prefix"));
    }

    var length = bytes_to_int(_builtin_substring(value, 0, 4));
    if (length < 0 or vlen < 4 + length) {
        return err(Error(code="DecodeError", message="binary frame: length prefix exceeds payload"));
    }

    return ok(_builtin_substring(value, 4, 4 + length));
}

// `[type_id:1][length:4][payload]`.
pub fn binary_encode_typed(data: str, type_id: int): str {
    var type_byte = _builtin_string_from_bytes([type_id % 256]);
    return type_byte + int_to_bytes(len(data), 4) + data;
}

pub fn binary_decode_typed(value: str): str?Error {
    var vlen = len(value);
    if (vlen < 5) {
        return err(Error(code="DecodeError", message="typed binary frame: too short for a header"));
    }

    var length = bytes_to_int(_builtin_substring(value, 1, 5));
    if (length < 0 or vlen < 5 + length) {
        return err(Error(code="DecodeError", message="typed binary frame: length prefix exceeds payload"));
    }

    return ok(_builtin_substring(value, 5, 5 + length));
}

// The type id stored by binary_encode_typed, so a decoder can dispatch on it
// before reading the payload.
pub fn binary_type_of(value: str): int?Error {
    if (len(value) < 1) {
        return err(Error(code="DecodeError", message="typed binary frame: empty"));
    }
    return ok(_builtin_string_byte_at(value, 0));
}

// ---------------------------------------------------------------------------
// Internals
// ---------------------------------------------------------------------------

// Big-endian, most significant byte first.
fn int_to_bytes(value: int, num_bytes: int): str {
    var bytes: [int] = [];
    var i: int = 0;

    while (i < num_bytes) {
        var b = (value >> ((num_bytes - 1 - i) * 8)) & 0xFF;
        bytes.append(b);
        i = i + 1;
    }

    return _builtin_string_from_bytes(bytes);
}

fn bytes_to_int(bytes: str): int {
    var blen = len(bytes);
    if (blen == 0) return 0;

    var result = 0;
    var i: int = 0;

    while (i < blen) {
        var byte = _builtin_string_byte_at(bytes, i);
        result = (result << 8) | byte;
        i = i + 1;
    }

    return result;
}
