// std/xml/writer.lm
// XML Writer Module

import std.xml.document as doc;

/// Serializes an XML `Node` AST element into formatted XML text.
///
/// @param val_node XML node to serialize.
/// @return Formatted XML element string.
pub fn stringify_node(val_node: doc.Node): str {
    if (val_node == nil) {
        return "";
    }

    var res = "<" + val_node.name;
    var i = 0;
    var keys_len = len(val_node.attrs_keys);
    while (i < keys_len) {
        res = res + " " + val_node.attrs_keys[i] + "=\"" + val_node.attrs_vals[i] + "\"";
        i = i + 1;
    }

    var children_len = len(val_node.children);
    if (children_len == 0 and val_node.text == "") {
        res = res + "/>";
        return res;
    }

    res = res + ">";
    res = res + val_node.text;

    i = 0;
    while (i < children_len) {
        var child_node = val_node.children[i] as doc.Node;
        res = res + stringify_node(child_node);
        i = i + 1;
    }

    res = res + "</" + val_node.name + ">";
    return res;
}

/// Serializes an entire `Document` to its XML string representation.
///
/// @param doc_val XML document instance.
/// @return Serialized XML string.
pub fn stringify(doc_val: doc.Document): str {
    return stringify_node(doc_val.root);
}
