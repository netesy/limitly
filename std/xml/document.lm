// XML Document and Node representation

frame Node {
    pub name: str;
    pub text: str;
    pub attrs_keys: [str];
    pub attrs_vals: [str];
    pub children: [any];
}

frame Document {
    pub root: any; // Node as any
}

pub fn make_node(name: str, text: str, keys: [str], vals: [str], children: [any]): Node {
    return Node(name=name, text=text, attrs_keys=keys, attrs_vals=vals, children=children);
}

pub fn make_document(root: any): Document {
    return Document(root=root);
}
