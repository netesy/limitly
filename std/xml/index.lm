// XML Module Gateway Index

import std.xml.document as doc;
import std.xml.parser as parser;
import std.xml.writer as writer;

pub import std.xml.document show Node, Document;
pub import std.xml.parser show Parser;

pub fn parse(text: str): doc.Document {
    return parser.parse(text);
}

pub fn stringify(node_val: any): str {
    return writer.stringify_node(node_val);
}
