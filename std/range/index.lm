import std.traits show Iterator;

frame Range {
    pub var start: int;
    pub var stop: int;
    pub var step: int;
    pub var inclusive: bool;
    pub var infinite: bool;

    pub init(start: int = 0, stop: int = 0, step: int = 1, inclusive: bool = false, infinite: bool = false) {
        self.start = start;
        self.stop = stop;
        self.step = step;
        self.inclusive = inclusive;
        self.infinite = infinite;
    }

    pub fn iterator(): RangeIterator {
        return RangeIterator(self.start, self.stop, self.step, self.inclusive, self.infinite);
    }
}

frame RangeIterator : Iterator {
    var current: int;
    var stop: int;
    var step: int;
    var inclusive: bool;
    var infinite: bool;

    pub init(start: int, stop: int, step: int = 1, inclusive: bool = false, infinite: bool = false) {
        self.current = start;
        self.stop = stop;
        if (step == 0) { self.step = 1; } else { self.step = step; }
        self.inclusive = inclusive;
        self.infinite = infinite;
    }

    pub fn has_next(): bool {
        if (self.infinite) {
            return true;
        }
        if (self.step > 0) {
            if (self.inclusive) {
                return self.current <= self.stop;
            }
            return self.current < self.stop;
        }
        if (self.inclusive) {
            return self.current >= self.stop;
        }
        return self.current > self.stop;
    }

    // Yields a plain int. The previous `int?` return type leaked `ok(...)`
    // wrappers into every consumer's element stream.
    pub fn next(): any {
        var value = self.current;
        self.current = self.current + self.step;
        return value;
    }
}

pub fn exclusive(start: int, stop: int, step: int = 1): Range {
    return Range(start, stop, step, false, false);
}

pub fn inclusive(start: int, stop: int, step: int = 1): Range {
    return Range(start, stop, step, true, false);
}

pub fn stepped(start: int, stop: int, step: int): Range {
    return Range(start, stop, step, false, false);
}

pub fn reverse(start: int, stop: int, step: int = -1): Range {
    return Range(start, stop, step, true, false);
}

pub fn infinite(start: int = 0, step: int = 1): Range {
    return Range(start, 0, step, false, true);
}
