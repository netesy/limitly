// std/game/app.lm
// High-level game loop, event polling, timing driver, and application runner for std.game

import std.app as app;
import std.events as events;
import std.gg as gg;


import std.time.timer show Timer, Duration;
import std.gui show GUI;
import std.theme show Theme;
import std.math.vector2 show Vector2;
import std.game.input show InputManager;
import std.color as color;
import std.scene show Scene, SceneManager;

frame Config {
    pub var title: str;
    pub var width: int;
    pub var height: int;
    pub var resizable: bool;
    pub var bg_color: color.Color;
    pub var fixed_dt: float;

    pub init(title: str = "Lymar Game", width: int = 800, height: int = 600, resizable: bool = true) {
        self.title = title;
        self.width = width;
        self.height = height;
        self.resizable = resizable;
        // Scene/renderer clear color (e.g. d3.Scene3D.background or a custom
        // 2D backdrop). Does not affect the GUI chrome clear, which always
        // comes from the active theme's bg_window.
        self.bg_color = color.hex(0x1e1e24, 1.0);
        self.fixed_dt = 1.0 / 60.0;
    }
}

pub fn default_config(): Config {
    return Config();
}

frame Game {
    pub var config: Config;
    pub var gui: GUI;
    pub var input: InputManager;
    pub var scenes: SceneManager;
    pub var is_running: bool;

    // Window dimensions
    pub var width: int;
    pub var height: int;

    // High-resolution timing & loop state
    pub var timer: Timer;
    pub var delta_time: float;
    pub var unscaled_delta_time: float;
    pub var time_scale: float;
    pub var total_time: float;
    pub var frame_count: int;
    pub var fps: float;
    pub var accumulator: float;
    pub var fixed_dt: float;

    pub init(cfg: Config | nil = nil) {
        if (cfg == nil) {
            self.config = default_config();
        } else {
            self.config = cfg as Config;
        }
        self.gui = GUI();
        self.input = InputManager();
        self.scenes = SceneManager();
        self.is_running = false;

        self.width = self.config.width;
        self.height = self.config.height;

        self.timer = Timer();
        self.delta_time = 0.01666667;
        self.unscaled_delta_time = 0.01666667;
        self.time_scale = 1.0;
        self.total_time = 0.0;
        self.frame_count = 0;
        self.fps = 60.0;
        self.accumulator = 0.0;
        self.fixed_dt = self.config.fixed_dt;
    }

    pub fn setup(): bool {
        var r_val = 0;
        if (self.config.resizable) {
            r_val = 1;
        }
        var wc = app.WindowConfig(
            width=self.config.width,
            height=self.config.height,
            title=self.config.title,
            resizable=r_val,
            fullscreen=0,
            high_dpi=1,
            sample_count=1,
            swap_interval=1
        );
        var ok_init = app.app_init(wc);
        if (ok_init != 0) {
            app.show_window();
            self.is_running = true;
            self.timer.reset();

            // Warm-up present: the window is already visible but nothing has
            // been committed yet, so it would show a black framebuffer until
            // the first loop frame finishes (shader/pipeline creation makes
            // that gap noticeable). On the GPU backend frames are only
            // published by poll_events -> commit_frame, so present the clear
            // explicitly instead of relying on gg.commit() (a no-op there).
            var bg = color.hex(0x1e1e24, 1.0);
            if (self.gui != nil and self.gui.theme != nil) {
                bg = self.gui.theme.bg_window;
            }
            gg.begin_pass(self.width, self.height, bg.r, bg.g, bg.b, bg.a);
            gg.end_pass();
            // events.pump_events (not gg.poll_events) so any events arriving
            // during startup land in the typed queue for the first drain.
            events.pump_events();
        } else {
            self.is_running = false;
        }
        return self.is_running;
    }

    pub fn begin_frame(): nil {
        // High-precision frame delta calculation
        var el: Duration = self.timer.elapsed();
        self.timer.reset();
        var raw_dt = el.to_seconds();
        if (raw_dt <= 0.00001) {
            raw_dt = 0.01666667;
        } elif (raw_dt > 0.1) {
            raw_dt = 0.1; // Clamp maximum delta to avoid spiral of death
        }

        self.unscaled_delta_time = raw_dt;
        self.delta_time = raw_dt * self.time_scale;
        self.total_time = self.total_time + self.delta_time;
        self.frame_count = self.frame_count + 1;
        self.accumulator = self.accumulator + self.delta_time;

        // Exponential smoothing for FPS
        var current_inst_fps = 1.0 / raw_dt;
        self.fps = self.fps * 0.9 + current_inst_fps * 0.1;

        // Reset per-frame input transients
        self.input.begin_frame();

        // Events: std.events owns the single raw->typed pump (pump_events
        // calls gg.poll_events, the frame-publish boundary on the GPU
        // backend). We read pending_events() non-destructively — the Fluent
        // path observes the same stream via app.dispatch_ui_events, so a game
        // can drive IMGUI and Fluent widgets from one event source.
        events.pump_events();
        iter (ev in events.pending_events()) {
            match (ev.event_type) {
                events.EventType.Quit => { self.is_running = false; },
                events.EventType.Resize => { self.width = ev.x; self.height = ev.y; },
                events.EventType.MouseMove => { self.input.on_mouse_move(ev.x as float, ev.y as float); },
                events.EventType.MouseDown => {
                    self.input.on_mouse_down(ev.key_code, ev.x as float, ev.y as float);
                },
                events.EventType.MouseUp => {
                    self.input.on_mouse_up(ev.key_code, ev.x as float, ev.y as float);
                },
                events.EventType.MouseWheel => { self.input.on_mouse_wheel(ev.y as float); },
                events.EventType.KeyDown => { self.input.on_key_down(ev.key_code); },
                events.EventType.KeyUp => { self.input.on_key_up(ev.key_code); },
                events.EventType.Char => { self.input.on_char(ev.key_code); },
                _ => {}
            }
        }

        // Synchronize input to IMGUI engine
        self.gui.keys_down = self.input.keys_down;
        self.gui.keys_pressed = self.input.keys_pressed;
        self.gui.typed_chars = self.input.typed_chars;
        self.gui.active_modifiers = self.input.active_modifiers;

        // Clear pass: the GUI theme window background always drives the chrome
        // clear. config.bg_color is the scene/renderer clear color — apps feed
        // it to their renderer (e.g. d3.Scene3D.background) rather than
        // overriding the window clear here.
        var bg = color.hex(0x1e1e24, 1.0);
        if (self.gui != nil and self.gui.theme != nil) {
            bg = self.gui.theme.bg_window;
        }
        gg.begin_pass(self.width, self.height, bg.r, bg.g, bg.b, bg.a);

        // Begin IMGUI
        self.gui.begin(self.input.mouse_x, self.input.mouse_y, self.input.is_mouse_down(0), self.input.mouse_wheel, self.delta_time, self.input.is_mouse_pressed(0), self.input.is_mouse_released(0));

        // Update active scenes
        if (self.scenes.has_scenes()) {
            self.scenes.update(self.delta_time);
        }
    }

    pub fn end_frame(): nil {
        // Draw scene layers before finishing IMGUI & render pass
        if (self.scenes.has_scenes()) {
            self.scenes.draw();
            self.scenes.draw_gui();
        }
        self.gui.end();
        gg.end_pass();
        gg.commit();
    }

    pub fn dt(): float {
        return self.delta_time;
    }

    pub fn step_physics(): bool {
        if (self.accumulator >= self.fixed_dt) {
            self.accumulator = self.accumulator - self.fixed_dt;
            if (self.scenes.has_scenes()) {
                self.scenes.fixed_update(self.fixed_dt);
            }
            return true;
        }
        return false;
    }

    // Scene state machine helpers
    pub fn register_scene(name: str, sc: Scene): nil { self.scenes.register(name, sc); }
    pub fn switch_scene(name: str, transition_duration: float = 0.0): nil { self.scenes.switch_to(name, transition_duration); }
    pub fn push_scene(name: str): nil { self.scenes.push(name); }
    pub fn pop_scene(): Scene | nil { return self.scenes.pop(); }
    pub fn current_scene(): Scene | nil { return self.scenes.current(); }

    // Direct input query helpers
    pub fn is_key_down(key: int): bool { return self.input.is_key_down(key); }
    pub fn is_key_pressed(key: int): bool { return self.input.is_key_pressed(key); }
    pub fn is_key_released(key: int): bool { return self.input.is_key_released(key); }
    pub fn is_mouse_down(button: int = 0): bool { return self.input.is_mouse_down(button); }
    pub fn is_mouse_pressed(button: int = 0): bool { return self.input.is_mouse_pressed(button); }
    pub fn is_mouse_released(button: int = 0): bool { return self.input.is_mouse_released(button); }
    pub fn mouse_pos(): Vector2 { return self.input.mouse_pos(); }
    pub fn mouse_delta(): Vector2 { return self.input.mouse_delta(); }

    pub fn bind_action(action: str, keys: [int]): nil { self.input.bind_action(action, keys); }
    pub fn is_action_down(action: str): bool { return self.input.is_action_down(action); }
    pub fn is_action_pressed(action: str): bool { return self.input.is_action_pressed(action); }
    pub fn is_action_released(action: str): bool { return self.input.is_action_released(action); }

    pub fn bind_axis(axis: str, neg_key: int, pos_key: int): nil { self.input.bind_axis(axis, neg_key, pos_key); }
    pub fn get_axis(axis: str): float { return self.input.get_axis(axis); }

    pub fn set_resolution(w: int, h: int): nil {
        self.width = w;
        self.height = h;
        self.config.width = w;
        self.config.height = h;
        // Route through std.app so window state, framebuffer size and the
        // Fluent viewport all stay in sync — single windowing owner.
        app.set_window_size(w, h);
    }

    pub fn set_size(w: int, h: int): nil {
        self.set_resolution(w, h);
    }

    pub fn quit(): nil {
        self.is_running = false;
    }

    pub fn shutdown(): nil {
        self.is_running = false;
        // app.app_shutdown() stops the sokol runtime AND resets std.app's
        // global state (is_initialized, event queue, ui context) — calling
        // gg.shutdown() alone would leave app_init permanently latched and
        // break any subsequent Game.setup() in the same process.
        app.app_shutdown();
    }
}
