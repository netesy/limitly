// std/game/math.lm
// 2D Game Math, Geometry, Collision Detection, and Raycasting Primitives

import std.math as math;
import std.game.types as types;

// Re-export core types
pub fn Vec2(x: float = 0.0, y: float = 0.0): types.Vec2 { return types.Vec2(x=x, y=y); }
pub fn vec2(x: float, y: float): types.Vec2 { return types.Vec2(x=x, y=y); }
pub fn Rect(x: float = 0.0, y: float = 0.0, w: float = 0.0, h: float = 0.0): types.Rect { return types.Rect(x=x, y=y, w=w, h=h); }
pub fn rect(x: float, y: float, w: float, h: float): types.Rect { return types.Rect(x=x, y=y, w=w, h=h); }

// ── Circle Primitive ──────────────────────────────────────────────────────────

frame Circle {
    pub var center: types.Vec2;
    pub var radius: float;

    pub init(center: types.Vec2 = types.Vec2(), radius: float = 10.0) {
        self.center = center;
        self.radius = radius;
    }

    pub fn contains(p: types.Vec2): bool {
        return self.center.dist_sq(p) <= (self.radius * self.radius);
    }

    pub fn intersects_circle(other: Circle): bool {
        var r_sum = self.radius + other.radius;
        return self.center.dist_sq(other.center) <= (r_sum * r_sum);
    }

    pub fn intersects_rect(r: types.Rect): bool {
        var closest_x = math.clamp(self.center.x, r.x, r.x + r.w);
        var closest_y = math.clamp(self.center.y, r.y, r.y + r.h);
        var closest = types.Vec2(x=closest_x, y=closest_y);
        return self.center.dist_sq(closest) <= (self.radius * self.radius);
    }
}

pub fn circle(center: types.Vec2 = types.Vec2(), radius: float = 10.0): Circle {
    return Circle(center=center, radius=radius);
}

// ── Ray2D Primitive ───────────────────────────────────────────────────────────

frame Ray2D {
    pub var origin: types.Vec2;
    pub var direction: types.Vec2;

    pub init(origin: types.Vec2 = types.Vec2(), direction: types.Vec2 = types.Vec2(1.0, 0.0)) {
        self.origin = origin;
        if (direction.x == 0.0 and direction.y == 0.0) {
            self.direction = types.Vec2(x=1.0, y=0.0);
        } else {
            self.direction = direction.normalize();
        }
    }

    pub fn point_at(t: float): types.Vec2 {
        return self.origin.add(self.direction.scale(t));
    }
}

pub fn ray2d(origin: types.Vec2 = types.Vec2(), direction: types.Vec2 = types.Vec2(1.0, 0.0)): Ray2D {
    return Ray2D(origin=origin, direction=direction);
}

// ── Contact & Hit Result Types ────────────────────────────────────────────────

frame Contact2D {
    pub var collided: bool;
    pub var normal: types.Vec2;
    pub var penetration: float;
    pub var point: types.Vec2;

    pub init(collided: bool = false, normal: types.Vec2 = types.Vec2(), penetration: float = 0.0, point: types.Vec2 = types.Vec2()) {
        self.collided = collided;
        self.normal = normal;
        self.penetration = penetration;
        self.point = point;
    }
}

frame RayHit2D {
    pub var hit: bool;
    pub var point: types.Vec2;
    pub var normal: types.Vec2;
    pub var distance: float;

    pub init(hit: bool = false, point: types.Vec2 = types.Vec2(), normal: types.Vec2 = types.Vec2(), distance: float = 0.0) {
        self.hit = hit;
        self.point = point;
        self.normal = normal;
        self.distance = distance;
    }
}

// ── Collision Detection & Resolution Functions ────────────────────────────────

pub fn test_aabb_aabb(a: types.Rect, b: types.Rect): Contact2D {
    if (not a.intersects(b)) {
        return Contact2D(collided=false);
    }

    var a_center = a.center();
    var b_center = b.center();
    var diff = b_center.sub(a_center);

    var a_half_w = a.w * 0.5;
    var a_half_h = a.h * 0.5;
    var b_half_w = b.w * 0.5;
    var b_half_h = b.h * 0.5;

    var overlap_x = (a_half_w + b_half_w) - math.abs(diff.x);
    var overlap_y = (a_half_h + b_half_h) - math.abs(diff.y);

    var normal = types.Vec2();
    var penetration = 0.0;
    var point = types.Vec2();

    if (overlap_x < overlap_y) {
        penetration = overlap_x;
        if (diff.x > 0.0) {
            normal = types.Vec2(x=1.0, y=0.0);
            point = types.Vec2(x=a.x + a.w, y=b_center.y);
        } else {
            normal = types.Vec2(x=-1.0, y=0.0);
            point = types.Vec2(x=a.x, y=b_center.y);
        }
    } else {
        penetration = overlap_y;
        if (diff.y > 0.0) {
            normal = types.Vec2(x=0.0, y=1.0);
            point = types.Vec2(x=b_center.x, y=a.y + a.h);
        } else {
            normal = types.Vec2(x=0.0, y=-1.0);
            point = types.Vec2(x=b_center.x, y=a.y);
        }
    }

    return Contact2D(collided=true, normal=normal, penetration=penetration, point=point);
}

pub fn test_circle_circle(a: Circle, b: Circle): Contact2D {
    var diff = b.center.sub(a.center);
    var dist = diff.mag();
    var r_sum = a.radius + b.radius;

    if (dist >= r_sum or dist <= 0.0) {
        if (dist <= 0.0 and (a.radius > 0.0 or b.radius > 0.0)) {
            return Contact2D(
                collided=true,
                normal=types.Vec2(x=1.0, y=0.0),
                penetration=r_sum,
                point=a.center
            );
        }
        return Contact2D(collided=false);
    }

    var normal = diff.scale(1.0 / dist);
    var penetration = r_sum - dist;
    var point = a.center.add(normal.scale(a.radius));

    return Contact2D(collided=true, normal=normal, penetration=penetration, point=point);
}

pub fn test_circle_aabb(c: Circle, b: types.Rect): Contact2D {
    var closest_x = math.clamp(c.center.x, b.x, b.x + b.w);
    var closest_y = math.clamp(c.center.y, b.y, b.y + b.h);
    var closest = types.Vec2(x=closest_x, y=closest_y);

    var diff = closest.sub(c.center);
    var dist = diff.mag();

    if (dist > c.radius) {
        return Contact2D(collided=false);
    }

    if (dist == 0.0) {
        var left = c.center.x - b.x;
        var right = (b.x + b.w) - c.center.x;
        var top = c.center.y - b.y;
        var bottom = (b.y + b.h) - c.center.y;

        var min_d = math.min(math.min(left, right), math.min(top, bottom));
        var normal = types.Vec2(x=0.0, y=-1.0);
        if (min_d == left) { normal = types.Vec2(x=-1.0, y=0.0); }
        elif (min_d == right) { normal = types.Vec2(x=1.0, y=0.0); }
        elif (min_d == top) { normal = types.Vec2(x=0.0, y=-1.0); }
        else { normal = types.Vec2(x=0.0, y=1.0); }

        return Contact2D(
            collided=true,
            normal=normal,
            penetration=c.radius + min_d,
            point=closest
        );
    }

    var normal = diff.scale(1.0 / dist);
    var penetration = c.radius - dist;
    return Contact2D(collided=true, normal=normal, penetration=penetration, point=closest);
}

pub fn raycast_aabb(ray: Ray2D, b: types.Rect, max_dist: float = 10000.0): RayHit2D {
    var inv_x = 0.0;
    if (ray.direction.x != 0.0) {
        inv_x = 1.0 / ray.direction.x;
    } else {
        inv_x = 1000000.0;
    }

    var inv_y = 0.0;
    if (ray.direction.y != 0.0) {
        inv_y = 1.0 / ray.direction.y;
    } else {
        inv_y = 1000000.0;
    }

    var t1 = (b.x - ray.origin.x) * inv_x;
    var t2 = (b.x + b.w - ray.origin.x) * inv_x;
    var t3 = (b.y - ray.origin.y) * inv_y;
    var t4 = (b.y + b.h - ray.origin.y) * inv_y;

    var tmin = math.max(math.min(t1, t2), math.min(t3, t4));
    var tmax = math.min(math.max(t1, t2), math.max(t3, t4));

    if (tmax < 0.0 or tmin > tmax or tmin > max_dist) {
        return RayHit2D(hit=false);
    }

    var t = tmin;
    if (t < 0.0) { t = tmax; }
    if (t < 0.0 or t > max_dist) {
        return RayHit2D(hit=false);
    }

    var hit_point = ray.point_at(t);
    var normal = types.Vec2();

    var eps = 0.001;
    if (math.abs(hit_point.x - b.x) < eps) { normal = types.Vec2(x=-1.0, y=0.0); }
    elif (math.abs(hit_point.x - (b.x + b.w)) < eps) { normal = types.Vec2(x=1.0, y=0.0); }
    elif (math.abs(hit_point.y - b.y) < eps) { normal = types.Vec2(x=0.0, y=-1.0); }
    elif (math.abs(hit_point.y - (b.y + b.h)) < eps) { normal = types.Vec2(x=0.0, y=1.0); }

    return RayHit2D(hit=true, point=hit_point, normal=normal, distance=t);
}

pub fn raycast_circle(ray: Ray2D, c: Circle, max_dist: float = 10000.0): RayHit2D {
    var oc = ray.origin.sub(c.center);
    var b = oc.dot(ray.direction);
    var c_term = oc.dot(oc) - c.radius * c.radius;

    if (c_term > 0.0 and b > 0.0) {
        return RayHit2D(hit=false);
    }

    var discriminant = b * b - c_term;
    if (discriminant < 0.0) {
        return RayHit2D(hit=false);
    }

    var t = -b - math.sqrt(discriminant);
    if (t < 0.0) {
        t = -b + math.sqrt(discriminant);
    }

    if (t < 0.0 or t > max_dist) {
        return RayHit2D(hit=false);
    }

    var hit_point = ray.point_at(t);
    var normal = hit_point.sub(c.center).normalize();

    return RayHit2D(hit=true, point=hit_point, normal=normal, distance=t);
}
