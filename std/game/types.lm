// std/game/types.lm
// Canonical math, geometry, and theme imports for std.game

pub import std.math.vector2 show Vector2;
pub import std.geometry show Rect;
pub import std.theme show
    ThemeMode, ColorRole, StyleVar,
    color_role_from_index, style_var_from_index,
    SpacingTokens, TypographyTokens, ShapeTokens, Theme,
    default_theme, dark_theme, light_theme, cyberpunk_theme, retro_theme, nord_theme;

pub fn Vec2(x: float = 0.0, y: float = 0.0): Vector2 {
    return Vector2(x, y);
}

pub fn vec2(x: float, y: float): Vector2 {
    return Vector2(x, y);
}

pub fn rect(x: float, y: float, w: float, h: float): Rect {
    return Rect(x=x, y=y, w=w, h=h);
}

// Style Color Indices for Moddable Stack (delegated to std.theme.color_role_from_index)
pub const COLOR_WINDOW_BG: int = 0;
pub const COLOR_WINDOW_TITLE: int = 1;
pub const COLOR_PANEL_BG: int = 2;
pub const COLOR_TEXT: int = 3;
pub const COLOR_TEXT_MUTED: int = 4;
pub const COLOR_ACCENT: int = 5;
pub const COLOR_BUTTON: int = 6;
pub const COLOR_BUTTON_HOVER: int = 7;
pub const COLOR_BUTTON_ACTIVE: int = 8;
pub const COLOR_SLIDER_TRACK: int = 9;
pub const COLOR_SLIDER_THUMB: int = 10;
pub const COLOR_CHECKBOX_BORDER: int = 11;
pub const COLOR_CHECKBOX_CHECK: int = 12;
pub const COLOR_SEPARATOR: int = 13;
pub const COLOR_FRAME_BG: int = 14;
pub const COLOR_FRAME_BG_HOVER: int = 15;
pub const COLOR_FRAME_BG_ACTIVE: int = 16;
pub const COLOR_TAB: int = 17;
pub const COLOR_TAB_ACTIVE: int = 18;
pub const COLOR_PLOT_LINES: int = 19;
pub const COLOR_PLOT_HISTOGRAM: int = 20;

// Style Var Indices
pub const VAR_PADDING: int = 0;
pub const VAR_SPACING: int = 1;
pub const VAR_ITEM_HEIGHT: int = 2;
pub const VAR_ROUNDING: int = 3;

pub type GUITheme = Theme;
pub fn GUITheme(): Theme {
    return Theme();
}
