    t.text_muted         = hex(0x808080, 1.0);
    t.accent             = hex(0x000080, 1.0);
    t.btn_normal         = hex(0xc0c0c0, 1.0);
    t.btn_hover          = hex(0xd4d0c8, 1.0);
    t.btn_active         = hex(0x808080, 1.0);
    t.slider_track       = hex(0x808080, 1.0);
    t.slider_thumb       = hex(0xc0c0c0, 1.0);
    t.slider_thumb_hover = hex(0xffffff, 1.0);
    t.checkbox_border    = hex(0x808080, 1.0);
    t.checkbox_check     = hex(0x000000, 1.0);
    t.separator          = hex(0x808080, 1.0);
    t.frame_bg           = hex(0xffffff, 1.0);
    t.frame_bg_hover     = hex(0xffffff, 1.0);
    t.frame_bg_active    = hex(0xe0e0e0, 1.0);
    t.tab_normal         = hex(0xc0c0c0, 1.0);
    t.tab_active         = hex(0xffffff, 1.0);
    t.plot_lines         = hex(0x008000, 1.0);
    t.plot_histogram     = hex(0x000080, 1.0);
