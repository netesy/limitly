// std/game/types.lm
// Fundamental math primitives, color definitions, and themes for std.game IMGUI

import std.math as math;
pub import std.graphics.shadow show Shadow, shadow;

frame Vec2 {
    pub var x: float;
    pub var y: float;

    pub init(x: float = 0.0, y: float = 0.0) {
        self.x = x;
        self.y = y;
    }

    pub fn add(other: Vec2): Vec2 {
        return Vec2(x=self.x + other.x, y=self.y + other.y);
    }

    pub fn sub(other: Vec2): Vec2 {
        return Vec2(x=self.x - other.x, y=self.y - other.y);
    }

    pub fn scale(s: float): Vec2 {
        return Vec2(x=self.x * s, y=self.y * s);
    }

    pub fn mul(other: Vec2): Vec2 {
        return Vec2(x=self.x * other.x, y=self.y * other.y);
    }

    pub fn div(s: float): Vec2 {
        if (s == 0.0) { return Vec2(); }
        return Vec2(x=self.x / s, y=self.y / s);
    }

    pub fn dot(other: Vec2): float {
        return self.x * other.x + self.y * other.y;
    }

    pub fn cross(other: Vec2): float {
        return self.x * other.y - self.y * other.x;
    }

    pub fn mag_sq(): float {
        return self.x * self.x + self.y * self.y;
    }

    pub fn mag(): float {
        return math.sqrt(self.x * self.x + self.y * self.y);
    }

    pub fn length(): float {
        return self.mag();
    }

    pub fn length_sq(): float {
        return self.mag_sq();
    }

    pub fn normalize(): Vec2 {
        var m = self.mag();
        if (m == 0.0) { return Vec2(); }
        return self.scale(1.0 / m);
    }

    pub fn dist_sq(other: Vec2): float {
        var dx = self.x - other.x;
        var dy = self.y - other.y;
        return dx * dx + dy * dy;
    }

    pub fn dist(other: Vec2): float {
        return math.sqrt(self.dist_sq(other));
    }

    pub fn lerp(target: Vec2, t: float): Vec2 {
        return Vec2(
            x=self.x + (target.x - self.x) * t,
            y=self.y + (target.y - self.y) * t
        );
    }

    pub fn angle(): float {
        return math.atan2(self.y, self.x);
    }

    pub fn rotate(radians: float): Vec2 {
        var c = math.cos(radians);
        var s = math.sin(radians);
        return Vec2(
            x=self.x * c - self.y * s,
            y=self.x * s + self.y * c
        );
    }

    pub fn perpendicular(): Vec2 {
        return Vec2(x=-self.y, y=self.x);
    }

    pub fn reflect(normal: Vec2): Vec2 {
        var d = self.dot(normal) * 2.0;
        return self.sub(normal.scale(d));
    }

    pub fn clamp_length(max_len: float): Vec2 {
        var l_sq = self.mag_sq();
        if (l_sq > max_len * max_len and l_sq > 0.0) {
            return self.normalize().scale(max_len);
        }
        return Vec2(x=self.x, y=self.y);
    }
}

pub fn vec2(x: float, y: float): Vec2 {
    return Vec2(x=x, y=y);
}

frame Rect {
    pub var x: float;
    pub var y: float;
    pub var w: float;
    pub var h: float;

    pub init(x: float = 0.0, y: float = 0.0, w: float = 0.0, h: float = 0.0) {
        self.x = x;
        self.y = y;
        self.w = w;
        self.h = h;
    }

    pub fn contains(px: float, py: float): bool {
        return px >= self.x and px <= (self.x + self.w) and py >= self.y and py <= (self.y + self.h);
    }

    pub fn contains_vec(p: Vec2): bool {
        return self.contains(p.x, p.y);
    }

    pub fn intersects(other: Rect): bool {
        return not (self.x + self.w < other.x or
                    other.x + other.w < self.x or
                    self.y + self.h < other.y or
                    other.y + other.h < self.y);
    }

    pub fn intersection(other: Rect): Rect {
        var ix = math.max(self.x, other.x);
        var iy = math.max(self.y, other.y);
        var rx = math.min(self.x + self.w, other.x + other.w);
        var by = math.min(self.y + self.h, other.y + other.h);
        if (rx > ix and by > iy) {
            return Rect(x=ix, y=iy, w=rx - ix, h=by - iy);
        }
        return Rect();
    }

    pub fn union_rect(other: Rect): Rect {
        var min_x = math.min(self.x, other.x);
        var min_y = math.min(self.y, other.y);
        var max_x = math.max(self.x + self.w, other.x + other.w);
        var max_y = math.max(self.y + self.h, other.y + other.h);
        return Rect(x=min_x, y=min_y, w=max_x - min_x, h=max_y - min_y);
    }

    pub fn center(): Vec2 {
        return Vec2(x=self.x + self.w * 0.5, y=self.y + self.h * 0.5);
    }

    pub fn expand(amount: float): Rect {
        return Rect(
            x=self.x - amount,
            y=self.y - amount,
            w=self.w + amount * 2.0,
            h=self.h + amount * 2.0
        );
    }

    pub fn clamp_point(p: Vec2): Vec2 {
        var cx = math.clamp(p.x, self.x, self.x + self.w);
        var cy = math.clamp(p.y, self.y, self.y + self.h);
        return Vec2(x=cx, y=cy);
    }
}

pub fn rect(x: float, y: float, w: float, h: float): Rect {
    return Rect(x=x, y=y, w=w, h=h);
}

// ── Canonical Game Color ───────────────────────────────────────────────────
import std.color as color;

// Style Color Role Enum
enum ColorRole {
    WindowBg,
    WindowTitle,
    PanelBg,
    Text,
    TextMuted,
    Accent,
    Button,
    ButtonHover,
    ButtonActive,
    SliderTrack,
    SliderThumb,
    CheckboxBorder,
    CheckboxCheck,
    Separator,
    FrameBg,
    FrameBgHover,
    FrameBgActive,
    Tab,
    TabActive,
    PlotLines,
    PlotHistogram
}

// Style Variable Enum
enum StyleVar {
    Padding,
    Spacing,
    ItemHeight,
    Rounding
}

// Style Color Indices for Moddable Stack
pub const COLOR_WINDOW_BG: int = 0;
pub const COLOR_WINDOW_TITLE: int = 1;
pub const COLOR_PANEL_BG: int = 2;
pub const COLOR_TEXT: int = 3;
pub const COLOR_TEXT_MUTED: int = 4;
pub const COLOR_ACCENT: int = 5;
pub const COLOR_BUTTON: int = 6;
pub const COLOR_BUTTON_HOVER: int = 7;
pub const COLOR_BUTTON_ACTIVE: int = 8;
pub const COLOR_SLIDER_TRACK: int = 9;
pub const COLOR_SLIDER_THUMB: int = 10;
pub const COLOR_CHECKBOX_BORDER: int = 11;
pub const COLOR_CHECKBOX_CHECK: int = 12;
pub const COLOR_SEPARATOR: int = 13;
pub const COLOR_FRAME_BG: int = 14;
pub const COLOR_FRAME_BG_HOVER: int = 15;
pub const COLOR_FRAME_BG_ACTIVE: int = 16;
pub const COLOR_TAB: int = 17;
pub const COLOR_TAB_ACTIVE: int = 18;
pub const COLOR_PLOT_LINES: int = 19;
pub const COLOR_PLOT_HISTOGRAM: int = 20;

// Style Var Indices
pub const VAR_PADDING: int = 0;
pub const VAR_SPACING: int = 1;
pub const VAR_ITEM_HEIGHT: int = 2;
pub const VAR_ROUNDING: int = 3;



pub fn color_role_from_index(idx: int): ColorRole {
    match (idx) {
        0 => { return ColorRole.WindowBg; },
        1 => { return ColorRole.WindowTitle; },
        2 => { return ColorRole.PanelBg; },
        3 => { return ColorRole.Text; },
        4 => { return ColorRole.TextMuted; },
        5 => { return ColorRole.Accent; },
        6 => { return ColorRole.Button; },
        7 => { return ColorRole.ButtonHover; },
        8 => { return ColorRole.ButtonActive; },
        9 => { return ColorRole.SliderTrack; },
        10 => { return ColorRole.SliderThumb; },
        11 => { return ColorRole.CheckboxBorder; },
        12 => { return ColorRole.CheckboxCheck; },
        13 => { return ColorRole.Separator; },
        14 => { return ColorRole.FrameBg; },
        15 => { return ColorRole.FrameBgHover; },
        16 => { return ColorRole.FrameBgActive; },
        17 => { return ColorRole.Tab; },
        18 => { return ColorRole.TabActive; },
        19 => { return ColorRole.PlotLines; },
        20 => { return ColorRole.PlotHistogram; },
        _ => { return ColorRole.Text; }
    }
}

pub fn style_var_from_index(idx: int): StyleVar {
    match (idx) {
        0 => { return StyleVar.Padding; },
        1 => { return StyleVar.Spacing; },
        2 => { return StyleVar.ItemHeight; },
        3 => { return StyleVar.Rounding; },
        _ => { return StyleVar.Padding; }
    }
}

frame GUITheme {
    pub var bg_window: color.Color;
    pub var bg_window_title: color.Color;
    pub var bg_panel: color.Color;
    pub var text: color.Color;
    pub var text_muted: color.Color;
    pub var accent: color.Color;
    pub var btn_normal: color.Color;
    pub var btn_hover: color.Color;
    pub var btn_active: color.Color;
    pub var slider_track: color.Color;
    pub var slider_thumb: color.Color;
    pub var slider_thumb_hover: color.Color;
    pub var checkbox_border: color.Color;
    pub var checkbox_check: color.Color;
    pub var separator: color.Color;
    pub var frame_bg: color.Color;
    pub var frame_bg_hover: color.Color;
    pub var frame_bg_active: color.Color;
    pub var tab_normal: color.Color;
    pub var tab_active: color.Color;
    pub var plot_lines: color.Color;
    pub var plot_histogram: color.Color;
    pub var padding: float;
    pub var spacing: float;
    pub var item_height: float;
    pub var rounding: float;
    pub var font_scale: int;
    pub var hover_duration: float;
    pub var press_duration: float;
    pub var enter_duration: float;
    pub var exit_duration: float;
    pub var button_shadow: Shadow?;
    pub var window_shadow: Shadow?;
    pub var popup_shadow: Shadow?;

    pub init() {
        // Modern game engine slate/dark palette
        self.bg_window          = color.hex(0x181a1f, 0.95);
        self.bg_window_title    = color.hex(0x21252b, 1.0);
        self.bg_panel           = color.hex(0x282c34, 0.90);
        self.text               = color.hex(0xabb2bf, 1.0);
        self.text_muted         = color.hex(0x5c6370, 1.0);
        self.accent             = color.hex(0x61afef, 1.0);
        self.btn_normal         = color.hex(0x2c313a, 1.0);
        self.btn_hover          = color.hex(0x3e4451, 1.0);
        self.btn_active         = color.hex(0x4b5263, 1.0);
        self.slider_track       = color.hex(0x1e2227, 1.0);
        self.slider_thumb       = color.hex(0x61afef, 1.0);
        self.slider_thumb_hover = color.hex(0x98c379, 1.0);
        self.checkbox_border    = color.hex(0x4b5263, 1.0);
        self.checkbox_check     = color.hex(0x98c379, 1.0);
        self.separator          = color.hex(0x3e4451, 0.6);
        self.frame_bg           = color.hex(0x21252b, 1.0);
        self.frame_bg_hover     = color.hex(0x2c313a, 1.0);
        self.frame_bg_active    = color.hex(0x3e4451, 1.0);
        self.tab_normal         = color.hex(0x21252b, 1.0);
        self.tab_active         = color.hex(0x61afef, 1.0);
        self.plot_lines         = color.hex(0x98c379, 1.0);
        self.plot_histogram     = color.hex(0xe5c07b, 1.0);
        self.padding            = 10.0;
        self.spacing            = 6.0;
        self.item_height        = 24.0;
        self.rounding           = 4.0;
        self.font_scale         = 1;
        self.hover_duration     = 0.15;
        self.press_duration     = 0.08;
        self.enter_duration     = 0.25;
        self.exit_duration      = 0.20;
        self.button_shadow      = nil;
        self.window_shadow      = nil;
        self.popup_shadow       = nil;
    }
}

pub fn default_theme(): GUITheme {
    return GUITheme();
}

pub fn dark_theme(): GUITheme {
    return GUITheme();
}

pub fn light_theme(): GUITheme {
    var t = GUITheme();
    t.bg_window          = color.hex(0xf0f2f5, 0.98);
    t.bg_window_title    = color.hex(0xdde1e6, 1.0);
    t.bg_panel           = color.hex(0xffffff, 1.0);
    t.text               = color.hex(0x161616, 1.0);
    t.text_muted         = color.hex(0x6f6f6f, 1.0);
    t.accent             = color.hex(0x0f62fe, 1.0);
    t.btn_normal         = color.hex(0xe0e0e0, 1.0);
    t.btn_hover          = color.hex(0xd1d1d1, 1.0);
    t.btn_active         = color.hex(0x0f62fe, 1.0);
    t.slider_track       = color.hex(0xd0d0d0, 1.0);
    t.slider_thumb       = color.hex(0x0f62fe, 1.0);
    t.slider_thumb_hover = color.hex(0x0043ce, 1.0);
    t.checkbox_border    = color.hex(0x8d8d8d, 1.0);
    t.checkbox_check     = color.hex(0x0f62fe, 1.0);
    t.separator          = color.hex(0xc6c6c6, 0.8);
    t.frame_bg           = color.hex(0xffffff, 1.0);
    t.frame_bg_hover     = color.hex(0xebebeb, 1.0);
    t.frame_bg_active    = color.hex(0xdddddd, 1.0);
    t.tab_normal         = color.hex(0xe0e0e0, 1.0);
    t.tab_active         = color.hex(0x0f62fe, 1.0);
    t.plot_lines         = color.hex(0x198038, 1.0);
    t.plot_histogram     = color.hex(0x0f62fe, 1.0);
    return t;
}

