// std/game/sprite.lm
// 2D Sprites, SpriteSheets, Frame Animations, and Textured Quad Rendering

import std.math as math;
import std.gg as gg;
import std.game.types as types;
import std.game.camera as camera_mod;

frame Texture2D {
    pub var id: int;
    pub var width: int;
    pub var height: int;

    pub init(id: int = -1, width: int = 0, height: int = 0) {
        self.id = id;
        self.width = width;
        self.height = height;
    }
}

pub fn texture2d(id: int, w: int, h: int): Texture2D {
    return Texture2D(id=id, width=w, height=h);
}

frame Sprite {
    pub var texture: Texture2D;
    pub var position: types.Vec2;
    pub var src_rect: types.Rect;
    pub var origin: types.Vec2;     // 0.0,0.0 = top-left; 0.5,0.5 = center
    pub var scale: types.Vec2;
    pub var rotation: float;        // in radians
    pub var tint: types.Color;
    pub var flip_x: bool;
    pub var flip_y: bool;

    pub init(
        texture: any = nil,
        position: any = nil,
        src_rect: any = nil,
        origin: any = nil,
        scale: any = nil,
        rotation: float = 0.0,
        tint: any = nil
    ) {
        if (texture == nil) {
            self.texture = Texture2D();
        } else {
            self.texture = texture as Texture2D;
        }

        if (position == nil) {
            self.position = types.Vec2();
        } else {
            self.position = position as types.Vec2;
        }

        if (src_rect == nil) {
            self.src_rect = types.Rect(x=0.0, y=0.0, w=self.texture.width as float, h=self.texture.height as float);
        } else {
            self.src_rect = src_rect as types.Rect;
        }

        if (origin == nil) {
            self.origin = types.Vec2(x=0.5, y=0.5);
        } else {
            self.origin = origin as types.Vec2;
        }

        if (scale == nil) {
            self.scale = types.Vec2(x=1.0, y=1.0);
        } else {
            self.scale = scale as types.Vec2;
        }

        self.rotation = rotation;

        if (tint == nil) {
            self.tint = types.white;
        } else {
            self.tint = tint as types.Color;
        }

        self.flip_x = false;
        self.flip_y = false;
    }

    pub fn draw(camera: any = nil): nil {
        var screen_pos = self.position;
        var zoom = 1.0;
        var cam_rot = 0.0;

        if (camera != nil) {
            var cam = camera as camera_mod.Camera2D;
            screen_pos = cam.world_to_screen(self.position);
            zoom = cam.zoom;
            cam_rot = cam.rotation + cam.shake_rotation;
        }

        var w = self.src_rect.w * self.scale.x * zoom;
        var h = self.src_rect.h * self.scale.y * zoom;
        var ox = w * self.origin.x;
        var oy = h * self.origin.y;

        var total_rot = self.rotation + cam_rot;
        if (total_rot == 0.0) {
            var draw_x = screen_pos.x - ox;
            var draw_y = screen_pos.y - oy;
            gg.draw_rect_primitive(draw_x, draw_y, w, h, self.tint.r, self.tint.g, self.tint.b, self.tint.a);
        } else {
            var cos_a = math.cos(total_rot);
            var sin_a = math.sin(total_rot);

            var p1_x = -ox;
            var p1_y = -oy;
            var p2_x = w - ox;
            var p2_y = -oy;
            var p3_x = w - ox;
            var p3_y = h - oy;
            var p4_x = -ox;
            var p4_y = h - oy;

            var v1_x = screen_pos.x + p1_x * cos_a - p1_y * sin_a;
            var v1_y = screen_pos.y + p1_x * sin_a + p1_y * cos_a;
            var v2_x = screen_pos.x + p2_x * cos_a - p2_y * sin_a;
            var v2_y = screen_pos.y + p2_x * sin_a + p2_y * cos_a;
            var v3_x = screen_pos.x + p3_x * cos_a - p3_y * sin_a;
            var v3_y = screen_pos.y + p3_x * sin_a + p3_y * cos_a;
            var v4_x = screen_pos.x + p4_x * cos_a - p4_y * sin_a;
            var v4_y = screen_pos.y + p4_x * sin_a + p4_y * cos_a;

            gg.draw_triangle_primitive(v1_x, v1_y, v2_x, v2_y, v3_x, v3_y, self.tint.r, self.tint.g, self.tint.b, self.tint.a);
            gg.draw_triangle_primitive(v1_x, v1_y, v3_x, v3_y, v4_x, v4_y, self.tint.r, self.tint.g, self.tint.b, self.tint.a);
        }
    }
}

pub fn sprite(texture: any = nil, position: any = nil): Sprite {
    return Sprite(texture=texture, position=position);
}

// ── SpriteSheet & Atlas ───────────────────────────────────────────────────────

frame SpriteSheet {
    pub var texture: Texture2D;
    pub var cell_width: int;
    pub var cell_height: int;
    pub var columns: int;
    pub var rows: int;

    pub init(texture: any = nil, cell_w: int = 16, cell_h: int = 16) {
        if (texture == nil) {
            self.texture = Texture2D();
        } else {
            self.texture = texture as Texture2D;
        }
        self.cell_width = cell_w;
        self.cell_height = cell_h;

        if (cell_w > 0) {
            self.columns = self.texture.width / cell_w;
        } else {
            self.columns = 1;
        }

        if (cell_h > 0) {
            self.rows = self.texture.height / cell_h;
        } else {
            self.rows = 1;
        }
    }

    pub fn get_frame(col: int, row: int): types.Rect {
        var x = (col * self.cell_width) as float;
        var y = (row * self.cell_height) as float;
        return types.Rect(x=x, y=y, w=self.cell_width as float, h=self.cell_height as float);
    }

    pub fn get_frame_index(index: int): types.Rect {
        if (self.columns <= 0) {
            return types.Rect(x=0.0, y=0.0, w=self.cell_width as float, h=self.cell_height as float);
        }
        var col = index % self.columns;
        var row = index / self.columns;
        return self.get_frame(col, row);
    }
}

// ── Animation Clip ────────────────────────────────────────────────────────────

frame AnimationClip {
    pub var name: str;
    pub var frames: [types.Rect];
    pub var fps: float;
    pub var loop: bool;

    pub init(name: str = "", frames: any = nil, fps: float = 10.0, loop: bool = true) {
        self.name = name;
        if (frames == nil) {
            self.frames = [] as [types.Rect];
        } else {
            self.frames = frames as [types.Rect];
        }
        self.fps = fps;
        self.loop = loop;
    }
}

// ── Animated Sprite ───────────────────────────────────────────────────────────

frame AnimatedSprite {
    pub var texture: Texture2D;
    pub var position: types.Vec2;
    pub var origin: types.Vec2;
    pub var scale: types.Vec2;
    pub var rotation: float;
    pub var tint: types.Color;
    pub var flip_x: bool;
    pub var flip_y: bool;

    pub var clips: {str: AnimationClip};
    pub var current_clip: str;
    pub var frame_index: int;
    pub var frame_timer: float;
    pub var is_playing: bool;

    pub init(texture: any = nil, position: any = nil) {
        if (texture == nil) {
            self.texture = Texture2D();
        } else {
            self.texture = texture as Texture2D;
        }

        if (position == nil) {
            self.position = types.Vec2();
        } else {
            self.position = position as types.Vec2;
        }

        self.origin = types.Vec2(x=0.5, y=0.5);
        self.scale = types.Vec2(x=1.0, y=1.0);
        self.rotation = 0.0;
        self.tint = types.white;
        self.flip_x = false;
        self.flip_y = false;

        self.clips = {} as {str: AnimationClip};
        self.current_clip = "";
        self.frame_index = 0;
        self.frame_timer = 0.0;
        self.is_playing = false;
    }

    pub fn add_clip(clip: any): nil {
        var c = clip as AnimationClip;
        self.clips[c.name] = c;
        if (self.current_clip == "") {
            self.current_clip = c.name;
        }
    }

    pub fn play(clip_name: str, restart: bool = false): nil {
        if (self.current_clip != clip_name or restart) {
            self.current_clip = clip_name;
            self.frame_index = 0;
            self.frame_timer = 0.0;
        }
        self.is_playing = true;
    }

    pub fn pause(): nil {
        self.is_playing = false;
    }

    pub fn resume(): nil {
        self.is_playing = true;
    }

    pub fn stop(): nil {
        self.is_playing = false;
        self.frame_index = 0;
        self.frame_timer = 0.0;
    }

    pub fn update(dt: float): nil {
        if (not self.is_playing or self.current_clip == "") {
            return;
        }

        var clip = self.clips[self.current_clip];
        if (clip == nil or len(clip.frames) == 0) {
            return;
        }

        var frame_duration = 1.0 / clip.fps;
        if (clip.fps <= 0.0) { frame_duration = 0.1; }

        self.frame_timer = self.frame_timer + dt;
        while (self.frame_timer >= frame_duration) {
            self.frame_timer = self.frame_timer - frame_duration;
            self.frame_index = self.frame_index + 1;
            if (self.frame_index >= len(clip.frames)) {
                if (clip.loop) {
                    self.frame_index = 0;
                } else {
                    self.frame_index = len(clip.frames) - 1;
                    self.is_playing = false;
                }
            }
        }
    }

    pub fn draw(camera: any = nil): nil {
        var clip = self.clips[self.current_clip];
        var src = types.Rect(x=0.0, y=0.0, w=self.texture.width as float, h=self.texture.height as float);
        if (clip != nil and self.frame_index < len(clip.frames)) {
            src = clip.frames[self.frame_index];
        }

        var spr = Sprite(
            texture=self.texture,
            position=self.position,
            src_rect=src,
            origin=self.origin,
            scale=self.scale,
            rotation=self.rotation,
            tint=self.tint
        );
        spr.flip_x = self.flip_x;
        spr.flip_y = self.flip_y;
        spr.draw(camera);
    }
}
