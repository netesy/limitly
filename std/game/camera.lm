// std/game/camera.lm
// Canonical 2D Camera facade routing directly to std.camera.Camera2D plus world-space drawing helpers.

import std.math as math;
import std.gg as gg;
import std.math.vector2 show Vector2;
import std.geometry show Rect;
pub import std.camera show Camera2D;

pub fn draw_world_rect(cam: Camera2D, world_rect: Rect, r: float, g: float, b: float, a: float): nil {
    val screen_pos = cam.world_to_screen(Vector2(world_rect.x, world_rect.y));
    val sw = world_rect.w * cam.zoom;
    val sh = world_rect.h * cam.zoom;
    gg.draw_rect_primitive(screen_pos.x, screen_pos.y, sw, sh, r, g, b, a);
}

pub fn draw_world_circle(cam: Camera2D, world_center: Vector2, radius: float, r: float, g: float, b: float, a: float, segments: int = 16): nil {
    val screen_center = cam.world_to_screen(world_center);
    val sr = radius * cam.zoom;
    var segs = segments;
    if (segs < 8) { segs = 8; }
    val step = math.TAU / (segs as float);
    iter (i in 0..segs) {
        val a1 = (i as float) * step;
        val a2 = ((i + 1) as float) * step;
        val p1_x = screen_center.x + math.cos(a1) * sr;
        val p1_y = screen_center.y + math.sin(a1) * sr;
        val p2_x = screen_center.x + math.cos(a2) * sr;
        val p2_y = screen_center.y + math.sin(a2) * sr;
        gg.draw_triangle_primitive(screen_center.x, screen_center.y, p1_x, p1_y, p2_x, p2_y, r, g, b, a);
    }
}

pub fn draw_world_line(cam: Camera2D, p1: Vector2, p2: Vector2, thickness: float, r: float, g: float, b: float, a: float): nil {
    val sp1 = cam.world_to_screen(p1);
    val sp2 = cam.world_to_screen(p2);
    gg.draw_line_primitive(sp1.x, sp1.y, sp2.x, sp2.y, r, g, b, a, thickness * cam.zoom);
}
