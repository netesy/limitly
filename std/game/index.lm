// std/game/index.lm
// Clean unified standard library facade for std.game

import std.game.types;
import std.game.math;
import std.game.input;
import std.game.camera;
import std.game.sprite;
import std.game.particles;
pub import std.game.gui show GUI, default_gui;
pub import std.game.scene show Scene, SceneManager, default_scene_manager, TRANSITION_NONE, TRANSITION_FADE;
pub import std.game.app show Config, Game;
pub import std.graphics.shadow show Shadow, shadow;

// ── Types & Math ───────────────────────────────────────────────────────────
pub fn Vec2(x: float = 0.0, y: float = 0.0): types.Vec2 {
    return types.Vec2(x=x, y=y);
}
pub fn vec2(x: float, y: float): types.Vec2 {
    return types.Vec2(x=x, y=y);
}

pub fn Rect(x: float = 0.0, y: float = 0.0, w: float = 0.0, h: float = 0.0): types.Rect {
    return types.Rect(x=x, y=y, w=w, h=h);
}
pub fn rect(x: float, y: float, w: float, h: float): types.Rect {
    return types.Rect(x=x, y=y, w=w, h=h);
}

pub fn Circle(center: any = nil, radius: float = 10.0): math.Circle {
    return math.Circle(center=center, radius=radius);
}
pub fn circle(center: any = nil, radius: float = 10.0): math.Circle {
    return math.Circle(center=center, radius=radius);
}

pub fn Ray2D(origin: any = nil, direction: any = nil): math.Ray2D {
    return math.Ray2D(origin=origin, direction=direction);
}
pub fn ray2d(origin: any = nil, direction: any = nil): math.Ray2D {
    return math.Ray2D(origin=origin, direction=direction);
}

// Collision functions
pub fn test_aabb_aabb(a: any, b: any): math.Contact2D {
    return math.test_aabb_aabb(a, b);
}
pub fn test_circle_circle(a: any, b: any): math.Contact2D {
    return math.test_circle_circle(a, b);
}
pub fn test_circle_aabb(c: any, b: any): math.Contact2D {
    return math.test_circle_aabb(c, b);
}
pub fn raycast_aabb(ray: any, b: any, max_dist: float = 10000.0): math.RayHit2D {
    return math.raycast_aabb(ray, b, max_dist);
}
pub fn raycast_circle(ray: any, c: any, max_dist: float = 10000.0): math.RayHit2D {
    return math.raycast_circle(ray, c, max_dist);
}

// Colors & Themes
pub fn Color(r: float = 0.0, g: float = 0.0, b: float = 0.0, a: float = 1.0): types.Color {
    return types.Color(r=r, g=g, b=b, a=a);
}
pub fn rgb(r: int, g: int, b: int): types.Color {
    return types.rgb(r, g, b);
}
pub fn rgba(r: int, g: int, b: int, a: float): types.Color {
    return types.rgba(r, g, b, a);
}
pub fn hex(c: int, a: float = 1.0): types.Color {
    return types.hex(c, a);
}

pub fn GUITheme(): types.GUITheme {
    return types.GUITheme();
}
pub var default_theme: types.GUITheme = types.default_theme();
pub fn dark_theme(): types.GUITheme { return types.dark_theme(); }
pub fn light_theme(): types.GUITheme { return types.light_theme(); }
pub fn cyberpunk_theme(): types.GUITheme { return types.cyberpunk_theme(); }
pub fn retro_theme(): types.GUITheme { return types.retro_theme(); }

