pub const MOUSE_LEFT: int        = input_mod.MOUSE_LEFT;
pub const MOUSE_RIGHT: int       = input_mod.MOUSE_RIGHT;
pub const MOUSE_MIDDLE: int      = input_mod.MOUSE_MIDDLE;

pub const MOD_SHIFT: int         = input_mod.MOD_SHIFT;
