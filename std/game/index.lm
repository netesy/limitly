pub const COLOR_PLOT_LINES: int      = types.COLOR_PLOT_LINES;
pub const COLOR_PLOT_HISTOGRAM: int  = types.COLOR_PLOT_HISTOGRAM;

// Style Var Indices
pub const VAR_PADDING: int           = types.VAR_PADDING;
pub const VAR_SPACING: int           = types.VAR_SPACING;
pub const VAR_ITEM_HEIGHT: int       = types.VAR_ITEM_HEIGHT;
pub const VAR_ROUNDING: int          = types.VAR_ROUNDING;

// Built-in Colors
pub const white: types.Color = types.white;
pub const black: types.Color = types.black;
pub const transparent: types.Color = types.transparent;
pub const red: types.Color = types.red;
pub const green: types.Color = types.green;
pub const blue: types.Color = types.blue;
pub const yellow: types.Color = types.yellow;
pub const cyan: types.Color = types.cyan;

// ── 2D Camera ──────────────────────────────────────────────────────────────
pub fn Camera(target: any = nil, offset: any = nil, zoom: float = 1.0): camera.Camera2D {
    return camera.Camera2D(target=target, offset=offset, zoom=zoom);
}
pub fn Camera2D(target: any = nil, offset: any = nil, zoom: float = 1.0, rotation: float = 0.0): camera.Camera2D {
    return camera.Camera2D(target=target, offset=offset, zoom=zoom, rotation=rotation);
}

// ── Sprites & Animation ───────────────────────────────────────────────────
pub fn Texture(id: int = -1, width: int = 0, height: int = 0): sprite.Texture2D {
    return sprite.Texture2D(id=id, width=width, height=height);
}
pub fn Sprite(
    texture: any = nil,
    position: any = nil,
    src_rect: any = nil,
    origin: any = nil,
    scale: any = nil,
    rotation: float = 0.0,
    tint: any = nil
): sprite.Sprite {
    return sprite.Sprite(
        texture=texture,
        position=position,
        src_rect=src_rect,
        origin=origin,
        scale=scale,
        rotation=rotation,
        tint=tint
    );
}
pub fn SpriteSheet(texture: any = nil, cell_w: int = 16, cell_h: int = 16): sprite.SpriteSheet {
    return sprite.SpriteSheet(texture=texture, cell_w=cell_w, cell_h=cell_h);
}
pub fn AnimationClip(name: str = "", frames: any = nil, fps: float = 10.0, loop: bool = true): sprite.AnimationClip {
    return sprite.AnimationClip(name=name, frames=frames, fps=fps, loop=loop);
}
pub fn AnimatedSprite(texture: any = nil, position: any = nil): sprite.AnimatedSprite {
    return sprite.AnimatedSprite(texture=texture, position=position);
}

// ── Particles ─────────────────────────────────────────────────────────────
pub fn ParticleEmitter(max_count: int = 150): particles.ParticleEmitter2D {
    return particles.ParticleEmitter2D(max_count=max_count);
}
pub fn ParticleEmitter2D(max_count: int = 150): particles.ParticleEmitter2D {
    return particles.ParticleEmitter2D(max_count=max_count);
}

// ── Input System ──────────────────────────────────────────────────────────
pub fn InputManager(): input.InputManager {
    return input.InputManager();
}

