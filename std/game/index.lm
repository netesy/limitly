pub const KEY_DOWN: int          = input.KEY_DOWN;
pub const KEY_W: int             = input.KEY_W;
pub const KEY_A: int             = input.KEY_A;
pub const KEY_S: int             = input.KEY_S;
pub const KEY_D: int             = input.KEY_D;
pub const KEY_F: int             = input.KEY_F;
pub const KEY_H: int             = input.KEY_H;
pub const KEY_F3: int            = input.KEY_F3;
pub const KEY_TAB: int           = input.KEY_TAB;
pub const KEY_BACKSPACE: int     = input.KEY_BACKSPACE;

pub const MOUSE_LEFT: int        = input.MOUSE_LEFT;
pub const MOUSE_RIGHT: int       = input.MOUSE_RIGHT;
pub const MOUSE_MIDDLE: int      = input.MOUSE_MIDDLE;

// Key Modifiers
pub const KEY_MOD_NONE: int      = 0;
pub const KEY_MOD_SHIFT: int     = input.MOD_SHIFT;
pub const KEY_MOD_CTRL: int      = input.MOD_CONTROL;
pub const KEY_MOD_CONTROL: int   = input.MOD_CONTROL;
pub const KEY_MOD_ALT: int       = input.MOD_ALT;
pub const KEY_MOD_SUPER: int     = input.MOD_SUPER;

pub const MOD_NONE: int          = 0;
pub const MOD_SHIFT: int         = input.MOD_SHIFT;
pub const MOD_CTRL: int          = input.MOD_CONTROL;
pub const MOD_CONTROL: int       = input.MOD_CONTROL;
pub const MOD_ALT: int           = input.MOD_ALT;
pub const MOD_SUPER: int         = input.MOD_SUPER;
pub var input: input.InputManager = input.default_input;

// ── IMGUI Engine ───────────────────────────────────────────────────────────
pub var gui: GUI = default_gui;

// ── Scene State Machine ────────────────────────────────────────────────────
pub fn scene(name: str = "Scene"): Scene {
    return Scene(name=name);
}
pub var scenes: SceneManager = default_scene_manager;
