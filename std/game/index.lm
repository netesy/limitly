// std/game/index.lm
// Clean unified standard library facade for std.game
//
// Game runtime: application shell, input, 2D sprites, particles, camera helpers,
// and component state. Immediate-mode debug UI lives in std.gui; the scene state
// machine lives in std.scene; collision/raycast queries live in std.geometry;
// Camera2D lives in std.camera.

pub import std.game.camera show
    draw_world_rect, draw_world_circle, draw_world_line;

pub import std.game.sprite show
    Texture2D, texture2d,
    Sprite, sprite,
    SpriteSheet, AnimationClip, AnimatedSprite;

pub import std.game.particles show
    Particle, ParticleEmitter2D, ParticleEmitter;

pub import std.game.input show
    InputManager,
    KEY_SPACE, KEY_ENTER, KEY_ESCAPE,
    KEY_LEFT, KEY_RIGHT, KEY_UP, KEY_DOWN,
    KEY_W, KEY_A, KEY_S, KEY_D, KEY_Q, KEY_E, KEY_R,
    KEY_1, KEY_2, KEY_3, KEY_4,
    KEY_F, KEY_H, KEY_F3, KEY_TAB, KEY_BACKSPACE,
    MOUSE_LEFT, MOUSE_RIGHT, MOUSE_MIDDLE,
    MOD_SHIFT, MOD_CONTROL, MOD_ALT, MOD_SUPER;

pub import std.game.components show WidgetState, Transform2D;
pub import std.game.app show Config, default_config, Game;
