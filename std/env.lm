// Standard Library Environment Forwarder Module

import std.env.index as env_mod;

frame Env {
    pub init() {}
    pub fn get(key: str): str? {
        var e = env_mod.Env();
        return e.get(key);
    }
    pub fn set(key: str, value: str): nil {
        var e = env_mod.Env();
        return e.set(key, value);
    }
    pub fn args(): [str] {
        var e = env_mod.Env();
        return e.args();
    }
    pub fn cwd(): str {
        var e = env_mod.Env();
        return e.cwd();
    }
}
