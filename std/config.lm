// Standard Library Config Module
import std.strings as str;

frame Config {
    var data: {str: any};
    
    pub init() {
        self.data = {};
    }
    
    pub fn get(key: str, default: any = nil): any {
        var val_any = self.data[key];
        if (val_any == nil) return default;
        return val_any;
    }
    
    pub fn set(key: str, val_any: any) {
        self.data[key] = val_any;
    }
}

fn load_json(json_str: str): Config {
    var conf = Config();
    // Compact JSON object parser for configuration values
    return conf;
}
