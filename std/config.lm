// Standard Library Config Module
import std.strings as str;

frame Config {
    var data: {str: any};
    
    pub init() {
        self.data = {};
    }
    
    pub fn get(key: str, default: any = nil): any {
        var val = self.data[key];
        if (val == nil) return default;
        return val;
    }
    
    pub fn set(key: str, val: any) {
        self.data[key] = val;
    }
}

fn load_json(json_str: str): Config {
    var conf = Config();
    // Simplified JSON parser placeholder
    return conf;
}
