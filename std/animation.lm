// std/animation.lm
// Shared Generic Animation Core Engine for Limit
// Time-based, interruptible, easing curves, spring physics, transitions, keyframes, composition, and ID-keyed state store

import std.graphics.shadow as shadow_mod;

pub var Shadow = shadow_mod.Shadow;
pub var shadow = shadow_mod.shadow;

// Easing Curve Type Identifiers
pub var EASE_LINEAR: int = 0;
pub var EASE_IN: int = 1;
pub var EASE_OUT: int = 2;
pub var EASE_IN_OUT: int = 3;
pub var EASE_BOUNCE: int = 4;
pub var EASE_ELASTIC: int = 5;
pub var EASE_CUBIC: int = 6;
pub var EASE_BACK: int = 7;

// Animation Lifecycle States
pub var STATE_IDLE: int = 0;
pub var STATE_RUNNING: int = 1;
pub var STATE_PAUSED: int = 2;
pub var STATE_COMPLETED: int = 3;
pub var STATE_CANCELLED: int = 4;

// ── Global Preferences & Accessibility ────────────────────────────────────

frame AnimationPreferences {
    pub var enabled: bool;
    pub var reduce_motion: bool;
    pub var duration_scale: float;

    pub init(enabled: bool = true, reduce_motion: bool = false, duration_scale: float = 1.0) {
        self.enabled = enabled;
        self.reduce_motion = reduce_motion;
        self.duration_scale = duration_scale;
    }
}

pub var global_animation_preferences: AnimationPreferences = AnimationPreferences(true, false, 1.0);

// ── Easing Resolver ─────────────────────────────────────────────────────────

pub fn apply_easing(t: float, type_val: int): float {
    var progress = t;
    if (progress < 0.0) progress = 0.0;
    if (progress > 1.0) progress = 1.0;

    if (type_val == EASE_LINEAR) {
        return progress;
    } elif (type_val == EASE_IN) {
        return progress * progress;
    } elif (type_val == EASE_OUT) {
        return progress * (2.0 - progress);
    } elif (type_val == EASE_IN_OUT) {
        if (progress < 0.5) {
            return 2.0 * progress * progress;
        }
        return -1.0 + (4.0 - 2.0 * progress) * progress;
    } elif (type_val == EASE_CUBIC) {
        return progress * progress * progress;
    } elif (type_val == EASE_BOUNCE) {
        if (progress < 0.363) {
            return 7.5625 * progress * progress;
        } elif (progress < 0.727) {
            var p2 = progress - 0.545;
            return 7.5625 * p2 * p2 + 0.75;
        } elif (progress < 0.909) {
            var p3 = progress - 0.818;
            return 7.5625 * p3 * p3 + 0.9375;
        }
        var p4 = progress - 0.954;
        return 7.5625 * p4 * p4 + 0.984375;
    } elif (type_val == EASE_BACK) {
        var s = 1.70158;
        return progress * progress * ((s + 1.0) * progress - s);
    }
    return progress;
}

// ── Spring Physics Model ───────────────────────────────────────────────────

frame Spring {
    pub var stiffness: float;
    pub var damping: float;
    pub var mass: float;
    pub var velocity: float;

    pub init(stiffness: float = 180.0, damping: float = 12.0, mass: float = 1.0) {
        self.stiffness = stiffness;
        self.damping = damping;
        self.mass = mass;
        self.velocity = 0.0;
    }

    pub fn update(current: float, target: float, dt: float): float {
        if (dt <= 0.0) return current;
        var force = -self.stiffness * (current - target);
        var damping_force = -self.damping * self.velocity;
        var accel = (force + damping_force) / self.mass;

        self.velocity = self.velocity + accel * dt;
        var next_val = current + self.velocity * dt;
        return next_val;
    }

    pub fn is_at_rest(current: float, target: float, eps: float = 0.001): bool {
        var diff = current - target;
        if (diff < 0.0) diff = -diff;
        var vel = self.velocity;
        if (vel < 0.0) vel = -vel;
        return (diff < eps and vel < eps);
    }
}

// ── Interpolation Helpers ──────────────────────────────────────────────────

pub fn lerp_float(a: float, b: float, t: float): float {
    return a + (b - a) * t;
}

pub fn lerp_rgba(r1: float, g1: float, b1: float, a1: float, r2: float, g2: float, b2: float, a2: float, t: float): [float] {
    return [
        lerp_float(r1, r2, t),
        lerp_float(g1, g2, t),
        lerp_float(b1, b2, t),
        lerp_float(a1, a2, t)
    ];
}

pub fn lerp_shadow(s1: shadow_mod.Shadow, s2: shadow_mod.Shadow, t: float): shadow_mod.Shadow {
    return shadow_mod.lerp_shadow(s1, s2, t);
}

// ── Multi-Stage Keyframe Animation ─────────────────────────────────────────

frame Keyframe {
    pub var progress: float; // 0.0 to 1.0
    pub var value: float;

    pub init(progress: float = 0.0, value: float = 0.0) {
        self.progress = progress;
        self.value = value;
    }
}

frame Keyframes {
    pub var frames: [Keyframe];

    pub init() {
        self.frames = [] as [Keyframe];
    }

    pub fn add(progress: float, value: float): Keyframes {
        self.frames.append(Keyframe(progress, value));
        return self;
    }

    pub fn evaluate(t: float): float {
        var p = t;
        if (p < 0.0) p = 0.0;
        if (p > 1.0) p = 1.0;

        var n = len(self.frames);
        if (n == 0) return 0.0;
        if (n == 1 or p <= self.frames[0].progress) return self.frames[0].value;
        if (p >= self.frames[n - 1].progress) return self.frames[n - 1].value;

        var i = 0;
        while (i < n - 1) {
            var k1 = self.frames[i];
            var k2 = self.frames[i + 1];
            if (p >= k1.progress and p <= k2.progress) {
                var range = k2.progress - k1.progress;
                if (range <= 0.0) return k1.value;
                var local_t = (p - k1.progress) / range;
                return lerp_float(k1.value, k2.value, local_t);
            }
            i = i + 1;
        }
        return self.frames[n - 1].value;
    }
}

// ── Generic Property Animation Instance ────────────────────────────────────

frame PropertyAnimation {
    pub var start_val: float;
    pub var target_val: float;
    pub var current_val: float;
    pub var duration: float;
    pub var elapsed: float;
    pub var delay: float;
    pub var easing_type: int;
    pub var state: int;
    pub var is_spring: bool;
    pub var is_repeat: bool;
    pub var is_reverse: bool;
    pub var spring_model: Spring;
    pub var keyframes_model: Keyframes;

    pub init(start_v: float = 0.0, target_v: float = 1.0, dur: float = 0.25, easing: int = 0) {
        self.start_val = start_v;
        self.target_val = target_v;
        self.current_val = start_v;
        self.duration = dur;
        self.elapsed = 0.0;
        self.delay = 0.0;
        self.easing_type = easing;
        self.state = STATE_IDLE;
        self.is_spring = false;
        self.is_repeat = false;
        self.is_reverse = false;
        self.spring_model = Spring();
        self.keyframes_model = Keyframes();
    }

    pub fn play(): nil {
        if (not global_animation_preferences.enabled or global_animation_preferences.reduce_motion) {
            self.current_val = self.target_val;
            self.state = STATE_COMPLETED;
            return;
        }
        self.state = STATE_RUNNING;
    }

    pub fn pause(): nil {
        self.state = STATE_PAUSED;
    }

    pub fn resume(): nil {
        if (self.state == STATE_PAUSED) {
            self.state = STATE_RUNNING;
        }
    }

    pub fn stop(): nil {
        self.state = STATE_COMPLETED;
        self.current_val = self.target_val;
    }

    pub fn reset(): nil {
        self.elapsed = 0.0;
        self.current_val = self.start_val;
        self.state = STATE_IDLE;
    }

    pub fn set_delay(d: float): PropertyAnimation {
        self.delay = d;
        return self;
    }

    pub fn reverse(): PropertyAnimation {
        var tmp = self.start_val;
        self.start_val = self.target_val;
        self.target_val = tmp;
        self.elapsed = 0.0;
        return self;
    }

    pub fn repeat_mode(rep: bool = true, rev: bool = false): PropertyAnimation {
        self.is_repeat = rep;
        self.is_reverse = rev;
        return self;
    }

    pub fn seek(progress: float): float {
        var p = progress;
        if (p < 0.0) p = 0.0;
        if (p > 1.0) p = 1.0;
        self.elapsed = p * self.duration;
        var eased_t = apply_easing(p, self.easing_type);
        self.current_val = lerp_float(self.start_val, self.target_val, eased_t);
        return self.current_val;
    }

    pub fn set_target(new_target: float): nil {
        if (self.target_val != new_target) {
            self.start_val = self.current_val; // Interruptible: continue from current visual position!
            self.target_val = new_target;
            self.elapsed = 0.0;
            self.state = STATE_RUNNING;
        }
    }

    pub fn update(dt: float): float {
        if (not global_animation_preferences.enabled or global_animation_preferences.reduce_motion) {
            self.current_val = self.target_val;
            self.state = STATE_COMPLETED;
            return self.current_val;
        }

        if (self.state != STATE_RUNNING) {
            return self.current_val;
        }

        if (self.delay > 0.0) {
            self.delay = self.delay - dt;
            if (self.delay > 0.0) {
                return self.current_val;
            }
        }

        var effective_dur = self.duration * global_animation_preferences.duration_scale;

        if (self.is_spring) {
            self.current_val = self.spring_model.update(self.current_val, self.target_val, dt);
            if (self.spring_model.is_at_rest(self.current_val, self.target_val)) {
                self.current_val = self.target_val;
                self.state = STATE_COMPLETED;
            }
        } else {
            self.elapsed = self.elapsed + dt;
            if (effective_dur <= 0.0) {
                if (len(self.keyframes_model.frames) > 0) {
                    self.current_val = self.keyframes_model.evaluate(1.0);
                } else {
                    self.current_val = self.target_val;
                }
                self.state = STATE_COMPLETED;
            } else {
                var progress = self.elapsed / effective_dur;
                if (progress >= 1.0) {
                    if (self.is_repeat) {
                        self.elapsed = 0.0;
                        if (self.is_reverse) {
                            var tmp = self.start_val;
                            self.start_val = self.target_val;
                            self.target_val = tmp;
                        }
                    } else {
                        progress = 1.0;
                        if (len(self.keyframes_model.frames) > 0) {
                            self.current_val = self.keyframes_model.evaluate(1.0);
                        } else {
                            self.current_val = self.target_val;
                        }
                        self.state = STATE_COMPLETED;
                    }
                } else {
                    if (len(self.keyframes_model.frames) > 0) {
                        self.current_val = self.keyframes_model.evaluate(progress);
                    } else {
                        var eased_t = apply_easing(progress, self.easing_type);
                        self.current_val = lerp_float(self.start_val, self.target_val, eased_t);
                    }
                }
            }
        }
        return self.current_val;
    }
}

// ── Animation Composition Helpers ──────────────────────────────────────────

frame AnimationSequence {
    pub var anims: [PropertyAnimation];
    pub var current_idx: int;

    pub init() {
        self.anims = [] as [PropertyAnimation];
        self.current_idx = 0;
    }

    pub fn add(anim: PropertyAnimation): AnimationSequence {
        self.anims.append(anim);
        return self;
    }

    pub fn update(dt: float): float {
        if (self.current_idx >= len(self.anims)) {
            if (len(self.anims) > 0) return self.anims[len(self.anims) - 1].current_val;
            return 0.0;
        }
        var cur = self.anims[self.current_idx];
        if (cur.state == STATE_IDLE) {
            cur.play();
        }
        var v_out = cur.update(dt);
        if (cur.state == STATE_COMPLETED) {
            self.current_idx = self.current_idx + 1;
        }
        return v_out;
    }
}

pub fn sequence(a1: PropertyAnimation, a2: PropertyAnimation): AnimationSequence {
    var seq = AnimationSequence();
    seq.add(a1);
    seq.add(a2);
    return seq;
}

frame AnimationParallel {
    pub var anims: [PropertyAnimation];

    pub init() {
        self.anims = [] as [PropertyAnimation];
    }

    pub fn add(anim: PropertyAnimation): AnimationParallel {
        self.anims.append(anim);
        return self;
    }

    pub fn update(dt: float): nil {
        var i = 0;
        while (i < len(self.anims)) {
            var a = self.anims[i];
            if (a.state == STATE_IDLE) {
                a.play();
            }
            a.update(dt);
            i = i + 1;
        }
    }

    pub fn is_completed(): bool {
        var i = 0;
        while (i < len(self.anims)) {
            if (self.anims[i].state != STATE_COMPLETED) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
}

pub fn parallel_group(a1: PropertyAnimation, a2: PropertyAnimation): AnimationParallel {
    var p = AnimationParallel();
    p.add(a1);
    p.add(a2);
    return p;
}

// ── Transition Abstraction ─────────────────────────────────────────────────

frame Transition {
    pub var opacity_anim: PropertyAnimation;
    pub var scale_anim: PropertyAnimation;
    pub var slide_x_anim: PropertyAnimation;
    pub var slide_y_anim: PropertyAnimation;
    pub var active: bool;

    pub init() {
        self.opacity_anim = PropertyAnimation(0.0, 1.0, 0.25, EASE_OUT);
        self.scale_anim = PropertyAnimation(0.9, 1.0, 0.25, EASE_OUT);
        self.slide_x_anim = PropertyAnimation(0.0, 0.0, 0.25, EASE_OUT);
        self.slide_y_anim = PropertyAnimation(20.0, 0.0, 0.25, EASE_OUT);
        self.active = true;
    }

    pub fn play(): Transition {
        self.active = true;
        self.opacity_anim.play();
        self.scale_anim.play();
        self.slide_x_anim.play();
        self.slide_y_anim.play();
        return self;
    }

    pub fn fade(start_a: float = 0.0, end_a: float = 1.0, dur: float = 0.25): Transition {
        self.opacity_anim = PropertyAnimation(start_a, end_a, dur, EASE_OUT);
        return self;
    }

    pub fn scale(start_s: float = 0.9, end_s: float = 1.0, dur: float = 0.25): Transition {
        self.scale_anim = PropertyAnimation(start_s, end_s, dur, EASE_OUT);
        return self;
    }

    pub fn slide(start_y: float = 20.0, end_y: float = 0.0, dur: float = 0.25): Transition {
        self.slide_y_anim = PropertyAnimation(start_y, end_y, dur, EASE_OUT);
        return self;
    }

    pub fn update(dt: float): nil {
        if (self.active) {
            self.opacity_anim.update(dt);
            self.scale_anim.update(dt);
            self.slide_x_anim.update(dt);
            self.slide_y_anim.update(dt);
        }
    }
}

// ── Shared Animation Manager ───────────────────────────────────────────────

frame AnimationManager {
    pub var active_animations: [PropertyAnimation];

    pub init() {
        self.active_animations = [] as [PropertyAnimation];
    }

    pub fn add(anim: PropertyAnimation): PropertyAnimation {
        anim.play();
        self.active_animations.append(anim);
        return anim;
    }

    pub fn update_all(dt: float): nil {
        var remaining: [PropertyAnimation] = [];
        var i = 0;
        while (i < len(self.active_animations)) {
            var anim = self.active_animations[i];
            anim.update(dt);
            if (anim.state == STATE_RUNNING or anim.state == STATE_PAUSED) {
                remaining.append(anim);
            }
            i = i + 1;
        }
        self.active_animations = remaining;
    }
}

// ── Immediate Mode Transient Animation State Store (Keyed by Stable ID) ────

frame IMGUIAnimationState {
    pub var id: str;
    pub var float_anims: {str: PropertyAnimation};
    pub var last_used_frame: int;

    pub init(id: str = "") {
        self.id = id;
        self.float_anims = {} as {str: PropertyAnimation};
        self.last_used_frame = 0;
    }

    pub fn animate_property(prop_name: str, target: float, dur: float = 0.15, easing: int = 2, dt: float = 0.016): float {
        var anim = self.float_anims[prop_name] as PropertyAnimation;
        if (anim == nil) {
            anim = PropertyAnimation(target, target, dur, easing);
            anim.current_val = target;
            anim.state = STATE_COMPLETED;
            self.float_anims[prop_name] = anim;
            return target;
        }
        anim.set_target(target);
        return anim.update(dt);
    }
}

frame IMGUIAnimationStore {
    pub var states: {str: IMGUIAnimationState};
    pub var active_ids: [str];
    pub var frame_counter: int;

    pub init() {
        self.states = {} as {str: IMGUIAnimationState};
        self.active_ids = [] as [str];
        self.frame_counter = 0;
    }

    pub fn get_or_create(id: str): IMGUIAnimationState {
        var st = self.states[id] as IMGUIAnimationState;
        if (st == nil) {
            st = IMGUIAnimationState(id);
            self.states[id] = st;
            self.active_ids.append(id);
        }
        st.last_used_frame = self.frame_counter;
        return st;
    }

    pub fn step_frame(): nil {
        self.frame_counter = self.frame_counter + 1;
    }

    pub fn prune_stale(max_age_frames: int = 120): nil {
        var threshold = self.frame_counter - max_age_frames;
        if (threshold < 0) threshold = 0;

        var remaining_ids: [str] = [];
        var remaining_states = {} as {str: IMGUIAnimationState};
        var i = 0;
        while (i < len(self.active_ids)) {
            var k = self.active_ids[i];
            var st = self.states[k] as IMGUIAnimationState;
            if (st != nil and st.last_used_frame >= threshold) {
                remaining_ids.append(k);
                remaining_states[k] = st;
            }
            i = i + 1;
        }
        self.active_ids = remaining_ids;
        self.states = remaining_states;
    }
}

pub var global_animation_manager: AnimationManager = AnimationManager();
pub var global_imgui_anim_store: IMGUIAnimationStore = IMGUIAnimationStore();
