// std/log/index.lm
// Public facade for std.log: Structured diagnostic logging.

/// Diagnostic logging module providing leveled console output.
///
/// Supports standardized prefixes and logging levels (`INFO`, `WARN`, `ERROR`).
///
/// @example
/// import std.log as log;
/// log.info("Application initialized successfully");
/// log.warn("Connection retry attempt 1/3");
/// log.error("Unhandled socket disconnection");

/// Logger frame providing leveled log emission methods.
frame Logger {
    pub init() {}

    /// Logs an informational message.
    ///
    /// @param msg Message text.
    pub fn log(msg: str): nil { print("[INFO] " + msg); }

    /// Logs an informational message.
    ///
    /// @param msg Message text.
    pub fn info(msg: str): nil { print("[INFO] " + msg); }

    /// Logs a warning message.
    ///
    /// @param msg Message text.
    pub fn warn(msg: str): nil { print("[WARN] " + msg); }

    /// Logs an error message.
    ///
    /// @param msg Message text.
    pub fn error(msg: str): nil { print("[ERROR] " + msg); }
}

var _default_logger: Logger = Logger();

/// Emits an informational message to standard output using the default logger.
///
/// @param msg Message text.
pub fn log(msg: str): nil {
    _default_logger.log(msg);
}

/// Emits an informational message to standard output using the default logger.
///
/// @param msg Message text.
pub fn info(msg: str): nil {
    _default_logger.info(msg);
}

/// Emits a warning message to standard output using the default logger.
///
/// @param msg Message text.
pub fn warn(msg: str): nil {
    _default_logger.warn(msg);
}

/// Emits an error message to standard output using the default logger.
///
/// @param msg Message text.
pub fn error(msg: str): nil {
    _default_logger.error(msg);
}
