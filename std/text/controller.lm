// std/text/controller.lm
// Controller submodule for std.text. Rich text editing, text layout, cursors, and text selection.

import std.text.document as doc;
import std.text.cursor as cursor;
import std.text.grapheme as grapheme;

frame EditorController {
    pub var document: doc.Document;
    pub var cursor: cursor.Cursor;
    pub var selection: cursor.Selection;
    pub var get_clipboard: (fn(): str)?;
    pub var set_clipboard: (fn(str): nil)?;
    pub var history: [str];
    pub var history_idx: int;

    pub init(initial_text: str = "") {
        self.document = doc.Document(initial_text);
        self.cursor = cursor.Cursor();
        self.selection = cursor.Selection();
        self.get_clipboard = nil;
        self.set_clipboard = nil;
        self.history = [initial_text];
        self.history_idx = 0;
    }

    pub fn save_history(): nil {
        var current = self.document.get_text();
        if (len(self.history) == 0 or self.history[self.history_idx] != current) {
            var new_hist: [str] = [];
            var i = 0;
            while (i <= self.history_idx) {
                new_hist.append(self.history[i]);
                i = i + 1;
            }
            new_hist.append(current);
            self.history = new_hist;
            self.history_idx = self.history_idx + 1;
        }
    }

    pub fn undo(): nil {
        if (self.history_idx > 0) {
            self.history_idx = self.history_idx - 1;
            self.document = doc.Document(self.history[self.history_idx]);
            self.cursor.set(0, 0);
            self.selection.set(0, 0);
        }
    }

    pub fn redo(): nil {
        if (self.history_idx < len(self.history) - 1) {
            self.history_idx = self.history_idx + 1;
            self.document = doc.Document(self.history[self.history_idx]);
            self.cursor.set(0, 0);
            self.selection.set(0, 0);
        }
    }

    pub fn insert_text(s: str): nil {
        if (not self.selection.is_empty()) {
            var r = self.selection.get_range();
            self.document.delete_range(r[0], r[1], r[2], r[3]);
            self.cursor.set(r[0], r[1]);
            self.selection.set(r[0], r[1]);
        }
        var res = self.document.insert_string(self.cursor.line, self.cursor.col, s);
        self.cursor.set(res[0], res[1]);
        self.selection.set(res[0], res[1]);
        self.save_history();
    }

    pub fn insert_newline(): nil {
        if (not self.selection.is_empty()) {
            var r = self.selection.get_range();
            self.document.delete_range(r[0], r[1], r[2], r[3]);
            self.cursor.set(r[0], r[1]);
            self.selection.set(r[0], r[1]);
        }
        var res = self.document.insert_newline(self.cursor.line, self.cursor.col);
        self.cursor.set(res[0], res[1]);
        self.selection.set(res[0], res[1]);
        self.save_history();
    }

    pub fn backspace(): nil {
        if (not self.selection.is_empty()) {
            var r = self.selection.get_range();
            self.document.delete_range(r[0], r[1], r[2], r[3]);
            self.cursor.set(r[0], r[1]);
            self.selection.set(r[0], r[1]);
        } else {
            if (self.cursor.col > 0) {
                // Cluster-aware: never split a multi-byte UTF-8 sequence
                // or orphan a combining mark.
                val line_txt = self.document.lines[self.cursor.line];
                val prev_c = grapheme.prev_boundary(line_txt, self.cursor.col);
                self.document.delete_range(self.cursor.line, prev_c, self.cursor.line, self.cursor.col);
                self.cursor.set(self.cursor.line, prev_c);
                self.selection.set(self.cursor.line, self.cursor.col);
            } elif (self.cursor.line > 0) {
                var prev_line_len = len(self.document.lines[self.cursor.line - 1]);
                self.document.delete_range(self.cursor.line - 1, prev_line_len, self.cursor.line, 0);
                self.cursor.set(self.cursor.line - 1, prev_line_len);
                self.selection.set(self.cursor.line, self.cursor.col);
            }
        }
        self.save_history();
    }

    pub fn move_left(shift: bool = false): nil {
        if (self.cursor.col > 0) {
            val lt = self.document.lines[self.cursor.line];
            self.cursor.col = grapheme.prev_boundary(lt, self.cursor.col);
            self.cursor.pref_col = self.cursor.col;
        } elif (self.cursor.line > 0) {
            self.cursor.line = self.cursor.line - 1;
            self.cursor.col = len(self.document.lines[self.cursor.line]);
            self.cursor.pref_col = self.cursor.col;
        }
        if (shift) {
            self.selection.extend_to(self.cursor.line, self.cursor.col);
        } else {
            if (not self.selection.is_empty()) {
                var r = self.selection.get_range();
                self.cursor.set(r[0], r[1]);
            }
            self.selection.set(self.cursor.line, self.cursor.col);
        }
    }

    pub fn move_right(shift: bool = false): nil {
        if (self.cursor.col < len(self.document.lines[self.cursor.line])) {
            val rt = self.document.lines[self.cursor.line];
            self.cursor.col = grapheme.next_boundary(rt, self.cursor.col);
            self.cursor.pref_col = self.cursor.col;
        } elif (self.cursor.line < len(self.document.lines) - 1) {
            self.cursor.line = self.cursor.line + 1;
            self.cursor.col = 0;
            self.cursor.pref_col = 0;
        }
        if (shift) {
            self.selection.extend_to(self.cursor.line, self.cursor.col);
        } else {
            if (not self.selection.is_empty()) {
                var r = self.selection.get_range();
                self.cursor.set(r[2], r[3]);
            }
            self.selection.set(self.cursor.line, self.cursor.col);
        }
    }

    pub fn move_up(shift: bool = false): nil {
        if (self.cursor.line > 0) {
            self.cursor.line = self.cursor.line - 1;
            val ul = self.document.lines[self.cursor.line];
            if (self.cursor.pref_col > len(ul)) {
                self.cursor.col = len(ul);
            } else {
                self.cursor.col = grapheme.prev_boundary(ul, self.cursor.pref_col);
            }
        } else {
            self.cursor.col = 0;
            self.cursor.pref_col = 0;
        }
        if (shift) {
            self.selection.extend_to(self.cursor.line, self.cursor.col);
        } else {
            self.selection.set(self.cursor.line, self.cursor.col);
        }
    }

    pub fn move_down(shift: bool = false): nil {
        if (self.cursor.line < len(self.document.lines) - 1) {
            self.cursor.line = self.cursor.line + 1;
            val dl = self.document.lines[self.cursor.line];
            if (self.cursor.pref_col > len(dl)) {
                self.cursor.col = len(dl);
            } else {
                self.cursor.col = grapheme.prev_boundary(dl, self.cursor.pref_col);
            }
        } else {
            self.cursor.col = len(self.document.lines[self.cursor.line]);
            self.cursor.pref_col = self.cursor.col;
        }
        if (shift) {
            self.selection.extend_to(self.cursor.line, self.cursor.col);
        } else {
            self.selection.set(self.cursor.line, self.cursor.col);
        }
    }


    // Text covered by the current selection, or the cursor line when
    // nothing is selected. Byte cols are already cluster-aligned.
    pub fn selection_text(): str {
        if (self.selection.is_empty()) {
            return self.document.lines[self.cursor.line] + "\n";
        }
        var r = self.selection.get_range();
        if (r.0 == r.2) {
            var l = self.document.lines[r.0];
            return _builtin_substring(l, r.1, r.3);
        }
        var parts: [str] = [] as [str];
        var i: int = r.0;
        while (i <= r.2 and i < len(self.document.lines)) {
            var lt = self.document.lines[i];
            var lo: int = 0;
            var hi: int = len(lt);
            if (i == r.0) { lo = r.1; }
            if (i == r.2) { hi = r.3; }
            parts.append(_builtin_substring(lt, lo, hi));
            i = i + 1;
        }
        return _builtin_string_join(parts, "\n");
    }

    pub fn copy(): nil {
        if (self.set_clipboard != nil) {
            var cb: fn(str): nil = self.set_clipboard as fn(str): nil;
            cb(self.selection_text());
        }
    }

    // Delete the cluster under the cursor (Delete key). Cluster-aware:
    // removes base + trailing marks as one unit. At line end it joins
    // the next line up.
    pub fn delete_char(): nil {
        var lt = self.document.lines[self.cursor.line];
        if (self.cursor.col >= len(lt)) {
            if (self.cursor.line < len(self.document.lines) - 1) {
                // Join next line up: delete_range merges first-line prefix
                // with last-line suffix and drops the lines between.
                self.document.delete_range(self.cursor.line, len(lt), self.cursor.line + 1, 0);
            }
        } else {
            var nxt_c = grapheme.next_boundary(lt, self.cursor.col);
            self.document.delete_range(self.cursor.line, self.cursor.col, self.cursor.line, nxt_c);
        }
        self.save_history();
    }

    pub fn cut(): nil {
        self.copy();
        if (not self.selection.is_empty()) {
            var r = self.selection.get_range();
            self.document.delete_range(r[0], r[1], r[2], r[3]);
            self.cursor.set(r[0], r[1]);
            self.selection.set(r[0], r[1]);
            self.save_history();
        }
    }

    pub fn paste(): nil {
        if (self.get_clipboard != nil) {
            var cb: fn(): str = self.get_clipboard as fn(): str;
            var s = cb();
            if (len(s) > 0) {
                self.insert_text(s);
            }
        }
    }

    pub fn get_text(): str {
        return self.document.get_text();
    }

    pub fn get_line_count(): int {
        return len(self.document.lines);
    }

    pub fn get_line(idx: int): str {
        return self.document.lines[idx];
    }

    pub fn get_cursor_line(): int {
        return self.cursor.line;
    }

    pub fn get_cursor_col(): int {
        return self.cursor.col;
    }

    pub fn get_lines(): [str] {
        return self.document.lines;
    }

    pub fn set_cursor(line: int, col: int): nil {
        self.cursor.set(line, col);
        self.selection.set(line, col);
    }

    pub fn set_selection(line: int, col: int): nil {
        self.selection.extend_to(line, col);
    }

    pub fn has_selection(): int {
        if (self.selection.is_empty()) {
            return 0;
        }
        return 1;
    }

    pub fn is_selected(): bool {
        return not self.selection.is_empty();
    }

    pub fn get_selection_range(): [int] {
        if (self.selection.is_empty()) {
            return [-1, -1, -1, -1];
        }
        var r = self.selection.get_range();
        return [r.0, r.1, r.2, r.3];
    }

    pub fn set_text(new_text: str): nil {
        self.document = doc.Document(new_text);
        self.cursor.set(0, 0);
        self.selection.set(0, 0);
        self.history = [new_text];
        self.history_idx = 0;
    }
}
