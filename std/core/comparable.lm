// Standard Library Core Comparable Trait
//
// Behavioral contract for ordering and comparison.

/// Interface for objects that can be compared for ordering.
///
/// Implementations must return:
/// - `< 0` if `self < other`
/// - `0` if `self == other`
/// - `> 0` if `self > other`
///
/// @example
/// ```lymar
/// frame Priority : Comparable {
    ///     pub level: int;
    ///     pub fn compare(other: any): int {
        ///         var o = other as Priority;
        ///         if (self.level < o.level) return -1;
        ///         if (self.level > o.level) return 1;
        ///         return 0;
        ///     }
        /// }
        /// ```
        trait Comparable {
            /// Compares this object against another instance.
            ///
            /// @param other Instance to compare with.
            /// @return Negative integer, zero, or positive integer.
            fn compare(other: any): int;
        }
