// Standard Library Core Option Module (using staged type functions)

frame OptionInstance {
    pub present: bool;
    pub value: any;

    pub init(present: bool, value: any) {
        self.present = present;
        self.value = value;
    }

    pub fn is_some(): bool {
        return self.present;
    }

    pub fn is_none(): bool {
        return not self.present;
    }

    pub fn unwrap(): any {
        return self.value;
    }

    pub fn unwrap_or(default_value: any): any {
        if (self.present) {
            return self.value;
        }
        return default_value;
    }

    pub fn map(f: fn(any): any): OptionInstance {
        if (self.present) {
            return Some(f(self.value));
        }
        return None();
    }

    pub fn filter(predicate: fn(any): bool): OptionInstance {
        if (self.present and predicate(self.value)) {
            return self;
        }
        return None();
    }
}

staged fn Option(T: type): type {
    return OptionInstance;
}

pub fn Some(value: any): OptionInstance {
    return OptionInstance(true, value);
}

pub fn None(): OptionInstance {
    return OptionInstance(false, nil);
}
