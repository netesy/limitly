// Standard Library URL Module
// Complete RFC 3986 URI parser with query string support.

import std.core as core;

frame URL {
    pub var scheme: str;
    pub var username: str;
    pub var password: str;
    pub var host: str;
    pub var port: int;
    pub var path: str;
    pub var query: str;       // raw query string (without "?")
    pub var fragment: str;    // fragment identifier (without "#")
    pub var is_valid: bool;

    pub init(url_str: str) {
        self.scheme = "";
        self.username = "";
        self.password = "";
        self.host = "";
        self.port = -1;
        self.path = "";
        self.query = "";
        self.fragment = "";
        self.is_valid = false;
        if (url_str != "") self.parse(url_str);
    }

    // Parse a URL string into its components
    pub fn parse(url_str: str) {
        var remaining: str = url_str;
        var i: int = 0;
        var len: int = len(url_str);

        // ---- Extract fragment ----
        var frag_idx: int = find_last(remaining, "#");
        if (frag_idx != -1) {
            self.fragment = url_decode_component(substring(remaining, frag_idx + 1, len));
            remaining = substring(remaining, 0, frag_idx);
            len = len(remaining);
        }

        // ---- Extract scheme ----
        var colon_idx: int = index_of(remaining, ":");
        if (colon_idx != -1) {
            var after_scheme: str = "";
            if (colon_idx + 2 < len) {
                after_scheme = substring(remaining, colon_idx + 1, colon_idx + 3);
            }
            if (after_scheme == "//") {
                self.scheme = to_lower(substring(remaining, 0, colon_idx));
                remaining = substring(remaining, colon_idx + 3, len);
                len = len(remaining);
            }
        }

        // ---- Extract query ----
        var query_idx: int = index_of(remaining, "?");
        if (query_idx != -1) {
            self.query = substring(remaining, query_idx + 1, len);
            remaining = substring(remaining, 0, query_idx);
            len = len(remaining);
        }

        // ---- Extract userinfo and host ----
        var slash_idx: int = index_of(remaining, "/");
        var authority: str = "";
        if (slash_idx != -1) {
            authority = substring(remaining, 0, slash_idx);
            self.path = url_decode_component(substring(remaining, slash_idx, len));
        } else {
            authority = remaining;
            self.path = "";
        }

        // Parse authority: [userinfo@]host[:port]
        var at_idx: int = find_last(authority, "@");
        if (at_idx != -1) {
            var userinfo: str = substring(authority, 0, at_idx);
            authority = substring(authority, at_idx + 1, len(authority));
            // Split userinfo into username:password
            var colon_in_user: int = index_of(userinfo, ":");
            if (colon_in_user != -1) {
                self.username = url_decode_component(substring(userinfo, 0, colon_in_user));
                self.password = url_decode_component(substring(userinfo, colon_in_user + 1, len(userinfo)));
            } else {
                self.username = url_decode_component(userinfo);
            }
        }

        // Parse host and port from authority
        // Handle IPv6 addresses in brackets
        if (len(authority) > 0 and substring(authority, 0, 1) == "[") {
            // IPv6: [::1]:port
            var close_bracket: int = index_of(authority, "]");
            if (close_bracket != -1) {
                self.host = substring(authority, 0, close_bracket + 1);
                if (close_bracket + 1 < len(authority) and substring(authority, close_bracket + 1, close_bracket + 2) == ":") {
                    var port_str: str = substring(authority, close_bracket + 2, len(authority));
                    self.port = port_str as int;
                }
            } else {
                self.host = authority;
            }
        } else {
            var host_colon: int = find_last(authority, ":");
            if (host_colon != -1) {
                self.host = url_decode_component(substring(authority, 0, host_colon));
                self.port = substring(authority, host_colon + 1, len(authority)) as int;
            } else {
                self.host = url_decode_component(authority);
            }
        }

        // Set default port based on scheme
        if (self.port == -1) {
            if (self.scheme == "http") self.port = 80;
            else if (self.scheme == "https") self.port = 443;
            else if (self.scheme == "ftp") self.port = 21;
            else if (self.scheme == "ssh") self.port = 22;
            else if (self.scheme == "ws") self.port = 80;
            else if (self.scheme == "wss") self.port = 443;
            else if (self.scheme == "smtp") self.port = 25;
            else if (self.scheme == "mysql") self.port = 3306;
            else if (self.scheme == "postgresql") self.port = 5432;
            else if (self.scheme == "redis") self.port = 6379;
            else if (self.scheme == "mongodb") self.port = 27017;
        }

        // Default path
        if (self.path == "") self.path = "/";

        self.is_valid = (self.host != "" or self.scheme == "file" or self.scheme == "data");
    }

    // Reconstruct the URL from components
    pub fn to_string(): str {
        var result: str = "";
        if (self.scheme != "") result = result + self.scheme + "://";
        if (self.username != "") {
            result = result + url_encode_component(self.username);
            if (self.password != "") result = result + ":" + url_encode_component(self.password);
            result = result + "@";
        }
        result = result + self.host;
        if (self.port != -1) {
            var is_default: bool = false;
            if (self.scheme == "http" and self.port == 80) is_default = true;
            if (self.scheme == "https" and self.port == 443) is_default = true;
            if (self.scheme == "ws" and self.port == 80) is_default = true;
            if (self.scheme == "wss" and self.port == 443) is_default = true;
            if (not is_default) result = result + ":" + self.port as str;
        }
        result = result + self.path;
        if (self.query != "") result = result + "?" + self.query;
        if (self.fragment != "") result = result + "#" + self.fragment;
        return result;
    }

    // Parse the query string into key-value pairs
    pub fn query_params(): {str: str} {
        return parse_query_string(self.query);
    }

    // Build a URL from individual components
    pub fn build(scheme: str, host: str, port: int, path: str, query: str, fragment: str): URL {
        var u: URL = URL("");
        u.scheme = scheme;
        u.host = host;
        u.port = port;
        u.path = path;
        u.query = query;
        u.fragment = fragment;
        u.is_valid = (host != "");
        return u;
    }

    // Get the origin (scheme + host + port)
    pub fn origin(): str {
        var result: str = self.scheme + "://" + self.host;
        if (self.port != -1) {
            var is_default: bool = false;
            if (self.scheme == "http" and self.port == 80) is_default = true;
            if (self.scheme == "https" and self.port == 443) is_default = true;
            if (not is_default) result = result + ":" + self.port as str;
        }
        return result;
    }

    // Resolve a relative URL against this base URL
    pub fn resolve(relative: str): URL {
        // Simple absolute/relative resolution
        if (index_of(relative, "://") != -1) {
            return URL(relative);
        }
        var base_path: str = self.path;
        var new_path: str = "";
        if (len(relative) > 0 and substring(relative, 0, 1) == "/") {
            new_path = normalize_path(relative);
        } else {
            // Relative path
            var last_slash: int = find_last(base_path, "/");
            var dir: str = "/";
            if (last_slash != -1) dir = substring(base_path, 0, last_slash + 1);
            new_path = normalize_path(dir + relative);
        }
        var u: URL = URL("");
        u.scheme = self.scheme;
        u.host = self.host;
        u.port = self.port;
        u.username = self.username;
        u.password = self.password;
        u.path = new_path;

        // Extract query and fragment from relative
        var q_idx: int = index_of(relative, "?");
        if (q_idx != -1) u.query = substring(relative, q_idx + 1, len(relative));
        var f_idx: int = index_of(relative, "#");
        if (f_idx != -1) u.fragment = substring(relative, f_idx + 1, len(relative));

        u.is_valid = true;
        return u;
    }
}

// ---- URL encoding / decoding ----

fn url_encode_component(s: str): str {
    // Encode characters that are not unreserved (RFC 3986)
    // Unreserved: A-Z a-z 0-9 - _ . ~
    var result: str = "";
    var hex: str = "0123456789ABCDEF";
    var i: int = 0;
    while (i < len(s)) {
        var ch: str = substring(s, i, i + 1);
        if (is_unreserved(ch)) {
            result = result + ch;
        } else {
            var b: int = byte_ord(ch);
            result = result + "%" + substring(hex, (b >> 4) & 0xF, ((b >> 4) & 0xF) + 1);
            result = result + substring(hex, b & 0xF, (b & 0xF) + 1);
        }
        i = i + 1;
    }
    return result;
}

fn url_decode_component(s: str): str {
    var result: str = "";
    var i: int = 0;
    while (i < len(s)) {
        if (substring(s, i, i + 1) == "%" and i + 2 < len(s)) {
            var hex_str: str = substring(s, i + 1, i + 3);
            var val: int = hex_to_int(hex_str);
            result = result + chr(val);
            i = i + 3;
        } else if (substring(s, i, i + 1) == "+") {
            result = result + " ";
            i = i + 1;
        } else {
            result = result + substring(s, i, i + 1);
            i = i + 1;
        }
    }
    return result;
}

fn parse_query_string(qs: str): {str: str} {
    var params: {str: str} = {};
    if (qs == "") return params;
    var pairs: [str] = split_str(qs, "&");
    var i: int = 0;
    while (i < len(pairs)) {
        var pair: str = pairs[i];
        if (pair == "") {
            i = i + 1;
        } else {
            var eq_idx: int = index_of(pair, "=");
            if (eq_idx != -1) {
                var key: str = url_decode_component(substring(pair, 0, eq_idx));
                var value: str = url_decode_component(substring(pair, eq_idx + 1, len(pair)));
                params[key] = value;
            } else {
                params[url_decode_component(pair)] = "";
            }
            i = i + 1;
        }
    }
    return params;
}

fn build_query_string(params: {str: str}): str {
    var parts: [str] = [];
    // Note: iterating over map keys requires language support
    // This is a best-effort implementation
    return "";
}

// ---- Internal helpers ----

fn is_unreserved(ch: str): bool {
    if (ch >= "a" and ch <= "z") return true;
    if (ch >= "A" and ch <= "Z") return true;
    if (ch >= "0" and ch <= "9") return true;
    if (ch == "-") return true;
    if (ch == "_") return true;
    if (ch == ".") return true;
    if (ch == "~") return true;
    return false;
}

fn to_lower(s: str): str {
    var result: str = "";
    var i: int = 0;
    while (i < len(s)) {
        var ch: str = substring(s, i, i + 1);
        if (ch >= "A" and ch <= "Z") {
            result = result + substring("abcdefghijklmnopqrstuvwxyz", (ch - "A"), (ch - "A") + 1);
        } else {
            result = result + ch;
        }
        i = i + 1;
    }
    return result;
}

fn normalize_path(path: str): str {
    // Remove dot segments (simplified)
    var parts: [str] = [];
    var segments: [str] = split_str(path, "/");
    var i: int = 0;
    while (i < len(segments)) {
        var seg: str = segments[i];
        if (seg == ".") {
            // Skip
        } else if (seg == "..") {
            if (len(parts) > 0) {
                // Remove last segment (but not the root)
                var new_parts: [str] = [];
                var j: int = 0;
                while (j < len(parts) - 1) {
                    new_parts = new_parts + [parts[j]];
                    j = j + 1;
                }
                parts = new_parts;
            }
        } else {
            parts = parts + [seg];
        }
        i = i + 1;
    }
    var result: str = "";
    if (len(path) > 0 and substring(path, 0, 1) == "/") result = "/";
    var k: int = 0;
    while (k < len(parts)) {
        if (k > 0 or result == "") {
            if (k > 0) result = result + "/";
        }
        result = result + parts[k];
        k = k + 1;
    }
    return result;
}

fn find_last(s: str, ch: str): int {
    var i: int = len(s) - 1;
    while (i >= 0) {
        if (substring(s, i, i + 1) == ch) return i;
        i = i - 1;
    }
    return -1;
}

fn index_of(s: str, pattern: str): int {
    var i: int = 0;
    while (i <= len(s) - len(pattern)) {
        if (substring(s, i, i + len(pattern)) == pattern) return i;
        i = i + 1;
    }
    return -1;
}

fn split_str(s: str, delimiter: str): [str] {
    var parts: [str] = [];
    var current: str = "";
    var i: int = 0;
    while (i < len(s)) {
        if (substring(s, i, i + 1) == delimiter) {
            parts = parts + [current];
            current = "";
        } else {
            current = current + substring(s, i, i + 1);
        }
        i = i + 1;
    }
    parts = parts + [current];
    return parts;
}

fn byte_ord(ch: str): int {
    if (ch >= "a" and ch <= "z") return 97 + (ch - "a");
    if (ch >= "A" and ch <= "Z") return 65 + (ch - "A");
    if (ch >= "0" and ch <= "9") return 48 + (ch - "0");
    if (ch == " ") return 32;
    if (ch == "\n") return 10;
    if (ch == "\r") return 13;
    if (ch == "\t") return 9;
    if (ch == "-") return 45;
    if (ch == "_") return 95;
    if (ch == ".") return 46;
    if (ch == "~") return 126;
    if (ch == "/") return 47;
    if (ch == ":") return 58;
    if (ch == "?") return 63;
    if (ch == "#") return 35;
    if (ch == "[") return 91;
    if (ch == "]") return 93;
    if (ch == "@") return 64;
    if (ch == "!") return 33;
    if (ch == "$") return 36;
    if (ch == "&") return 38;
    if (ch == "'") return 39;
    if (ch == "(") return 40;
    if (ch == ")") return 41;
    if (ch == "*") return 42;
    if (ch == "+") return 43;
    if (ch == ",") return 44;
    if (ch == ";") return 59;
    if (ch == "=") return 61;
    if (ch == "%") return 37;
    return 0;
}

fn hex_to_int(hex: str): int {
    var result: int = 0;
    var i: int = 0;
    while (i < len(hex)) {
        var ch: str = substring(hex, i, i + 1);
        var val: int = 0;
        if (ch >= "0" and ch <= "9") val = ch - "0";
        else if (ch >= "a" and ch <= "f") val = 10 + (ch - "a");
        else if (ch >= "A" and ch <= "F") val = 10 + (ch - "A");
        result = result * 16 + val;
        i = i + 1;
    }
    return result;
}

fn chr(b: int): str {
    if (b >= 97 and b <= 122) return substring("abcdefghijklmnopqrstuvwxyz", b - 97, b - 96);
    if (b >= 65 and b <= 90) return substring("ABCDEFGHIJKLMNOPQRSTUVWXYZ", b - 65, b - 64);
    if (b >= 48 and b <= 57) return substring("0123456789", b - 48, b - 47);
    if (b == 32) return " ";
    if (b == 10) return "\n";
    if (b == 13) return "\r";
    if (b == 9) return "\t";
    if (b == 0) return "";
    return " ";
}