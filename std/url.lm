// Standard Library URL Module
import std.strings as str;

frame URL {
    pub var scheme: str;
    pub var host: str;
    pub var port: int;
    pub var path: str;
    pub var query: str;
    pub var fragment: str;
    
    pub init(url_str: str = "") {
        self.scheme = "";
        self.host = "";
        self.port = 80;
        self.path = "/";
        self.query = "";
        self.fragment = "";
        if (url_str != "") self.parse(url_str);
    }
    
    pub fn parse(url_str: str) {
        // Very basic parser
        var s = str.String(url_str);
        var scheme_idx = s.index_of("://");
        if (scheme_idx != nil) {
            self.scheme = substring(url_str, 0, scheme_idx);
            var rest = substring(url_str, scheme_idx + 3, len(url_str));
            var path_idx = str.String(rest).index_of("/");
            if (path_idx != nil) {
                self.host = substring(rest, 0, path_idx);
                self.path = substring(rest, path_idx, len(rest));
            } else {
                self.host = rest;
            }
        }
    }
    
    pub fn to_string(): str {
        var res = self.scheme + "://" + self.host;
        if (self.port != 80 and self.port != 443) res = res + ":" + (self.port as str);
        res = res + self.path;
        if (self.query != "") res = res + "?" + self.query;
        if (self.fragment != "") res = res + "#" + self.fragment;
        return res;
    }
}
