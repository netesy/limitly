// std/toml/index.lm
// Public facade for std.toml: TOML parsing and serialization.

/// TOML (Tom's Obvious Minimal Language) configuration parsing and serialization.
///
/// @example
/// import std.toml as toml;
/// var doc = toml.parse("title = \"Lymar\"\nport = 8080");
/// print(doc.is_object()); // true

import std.toml.parser as parser;
import std.toml.writer as writer;
import std.toml.value as value;

pub import std.toml.value show Value, Type, make_string, make_number, make_bool, make_object;

/// Parses TOML formatted text into an AST `Value` table.
///
/// @param text Raw TOML text.
/// @return Root `Value` object node.
pub fn parse(text: str): value.Value {
    return parser.parse(text);
}

/// Serializes a TOML `Value` node into a TOML formatted document string.
///
/// @param val_obj Target value node.
/// @return Formatted TOML text.
pub fn stringify(val_obj: value.Value): str {
    return writer.stringify(val_obj);
}
