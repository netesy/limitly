// std/toml/writer.lm
// TOML text serializer.

import std.toml.value as value;

/// Serializes a TOML `Value` node into formatted TOML configuration text.
///
/// @param val_obj Value AST node to format.
/// @return Serialized TOML text.
pub fn stringify(val_obj: value.Value): str {
    if (val_obj == nil) {
        return "";
    }

    match (val_obj.kind) {
        value.Type.String => {
            return "\"" + val_obj.str_val + "\"";
        },
        value.Type.Number => {
            var num = val_obj.num_val;
            return "{num}";
        },
        value.Type.Bool => {
            if (val_obj.bool_val) {
                return "true";
            }
            return "false";
        },
        value.Type.Object => {
            var res = "";
            var i = 0;
            var keys_len = len(val_obj.obj_keys);
            while (i < keys_len) {
                var child_val = val_obj.obj_vals[i] as value.Value;
                res = res + val_obj.obj_keys[i] + " = " + stringify(child_val) + "\n";
                i = i + 1;
            }
            return res;
        },
        _ => {
            return "";
        }
    }
}
