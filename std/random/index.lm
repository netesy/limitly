// std/random/index.lm
// Public entrypoint and facade for std.random. Random number generation and statistical distributions.

/// # Random and Distributions Module (`std.random`)
///
/// Complete suite for pseudo-random number generation (Xorshift64*),
/// hardware entropy-backed secure random values (`SecureRandom`),
/// and continuous uniform probability distributions.
///
/// @tip Use top-level `random.random_int(min, max)` for quick random numbers,
/// or instantiate `Random(seed=...)` for reproducible sequences.
///
/// @example
/// import std.random as rand;
/// var num = rand.random_int(1, 100);
/// var str = rand.random_string(16);
/// print("Random int: {num}, string: {str}");

pub import std.random.random show Random, SecureRandom, random_int, random_float, random_bool, random_bytes, random_string;
pub import std.random.distributions show Uniform;
