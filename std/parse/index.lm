import std.parse.numbers as numbers;
import std.parse.bool as bool_parser;
import std.time.datetime as datetime;

pub import std.time.datetime show DateTime;

frame Parse {
    pub init() {}
    pub fn parse_int(value: str): any { return numbers.parse_int(value); }
    pub fn parse_float(value: str): any { return numbers.parse_float(value); }
    pub fn parse_bool(value: str): bool { return bool_parser.parse_bool(value); }
}

pub fn parse_int(value: str): any {
    return numbers.parse_int(value);
}

pub fn parse_float(value: str): any {
    return numbers.parse_float(value);
}

pub fn parse_bool(value: str): bool {
    return bool_parser.parse_bool(value);
}

pub fn parse_datetime(value: str): datetime.DateTime? {
    return datetime.parse_datetime(value);
}
