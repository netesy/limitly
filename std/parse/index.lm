// Standard Library Parsing Module
//
// String to primitive numbers, booleans, and date-time converters.

import std.parse.bool as b;
import std.parse.numbers as n;
import std.parse.datetime as dt;
import std.time.datetime as datetime;

/// Facade frame for parsing operations.
frame Parse {
    pub init() {}
    pub fn parse_bool(value: str): bool { return b.parse_bool(value); }
    pub fn parse_int(value: str): int? { return n.parse_int(value); }
    pub fn parse_float(value: str): str? { return n.parse_float(value); }
    pub fn parse_datetime(value: str): datetime.DateTime? { return dt.parse_datetime(value); }
}

/// Parses a boolean literal ("true", "false", "1", "0").
pub fn parse_bool(value: str): bool {
    return b.parse_bool(value);
}

/// Parses a signed integer from string.
pub fn parse_int(value: str): int? {
    return n.parse_int(value);
}

/// Parses a float from string.
pub fn parse_float(value: str): str? {
    return n.parse_float(value);
}

/// Parses a date-time string in ISO format.
pub fn parse_datetime(value: str): datetime.DateTime? {
    return dt.parse_datetime(value);
}
