// Standard Library Parse Numbers Submodule

import std.core as core;

fn char_to_digit(ch: str): int {
    if (ch == "0") return 0;
    if (ch == "1") return 1;
    if (ch == "2") return 2;
    if (ch == "3") return 3;
    if (ch == "4") return 4;
    if (ch == "5") return 5;
    if (ch == "6") return 6;
    if (ch == "7") return 7;
    if (ch == "8") return 8;
    if (ch == "9") return 9;
    return -1;
}

pub fn parse_int(value: str): any {
    if (value == "") return err();

    var n = len(value);
    var i = 0;
    var sign = 1;
    var result = 0;
    var seen_digit = false;

    var first = _builtin_substring(value, 0, 1);
    if (first == "+") {
        i = 1;
    } else if (first == "-") {
        sign = -1;
        i = 1;
    }

    if (i >= n) {
        return err();
    }

    while (i < n) {
        var ch = _builtin_substring(value, i, i + 1);
        var digit = char_to_digit(ch);
        if (digit == -1) {
            return err();
        }
        result = result * 10 + digit;
        seen_digit = true;
        i = i + 1;
    }

    if (!seen_digit) {
        return err();
    }

    return ok(sign * result);
}

pub fn parse_float(value: str): any {
    if (value == "") return err();
    // Simplified parsing of float (return string as ok for now, or just basic parse)
    return ok(value);
}
