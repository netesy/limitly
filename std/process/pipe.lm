// Standard Library Inter-Process Pipe Stream Module

import std.resource as res;

frame PipeReader {
    pub var resource: res.Resource;

    pub init(r: res.Resource) {
        self.resource = r;
    }

    pub fn read(buffer_size: int = 1024): str {
        if (!self.resource.is_open()) return "";
        var result = res._call(self.resource.handle, res.OP_READ, [buffer_size]);
        if (result == nil) return "";
        return result as str;
    }

    pub fn read_all(): str {
        var total = "";
        var keep_reading = true;
        while (self.is_open() and keep_reading) {
            var chunk = self.read(4096);
            if (len(chunk) == 0) {
                keep_reading = false;
            } else {
                total = total + chunk;
            }
        }
        return total;
    }

    pub fn read_line(): str {
        var line = "";
        var keep_reading = true;
        while (self.is_open() and keep_reading) {
            var ch = self.read(1);
            if (len(ch) == 0 or ch == "\n") {
                keep_reading = false;
            } else {
                if (ch != "\r") {
                    line = line + ch;
                }
            }
        }
        return line;
    }

    pub fn is_open(): bool {
        return self.resource.is_open();
    }

    pub fn close(): nil {
        if (self.resource.is_open()) {
            self.resource.close();
        }
    }
}

frame PipeWriter {
    pub var resource: res.Resource;

    pub init(r: res.Resource) {
        self.resource = r;
    }

    pub fn write(content: str): bool {
        if (!self.resource.is_open()) return false;
        var result = res._call(self.resource.handle, res.OP_WRITE, [content]);
        return (result == true);
    }

    pub fn write_line(line: str): bool {
        return self.write(line + "\n");
    }

    pub fn flush(): bool {
        if (!self.resource.is_open()) return false;
        var result = res._call(self.resource.handle, res.OP_FLUSH, []);
        return (result == true);
    }

    pub fn is_open(): bool {
        return self.resource.is_open();
    }

    pub fn close(): nil {
        if (self.resource.is_open()) {
            self.resource.close();
        }
    }
}

frame PipePair {
    pub var reader: PipeReader;
    pub var writer: PipeWriter;

    pub init(r: PipeReader, w: PipeWriter) {
        self.reader = r;
        self.writer = w;
    }

    pub fn write(content: str): bool {
        return self.writer.write(content);
    }

    pub fn write_line(line: str): bool {
        return self.writer.write_line(line);
    }

    pub fn read(buffer_size: int = 1024): str {
        return self.reader.read(buffer_size);
    }

    pub fn read_all(): str {
        return self.reader.read_all();
    }

    pub fn read_line(): str {
        return self.reader.read_line();
    }

    pub fn is_open(): bool {
        return self.reader.is_open() or self.writer.is_open();
    }

    pub fn close(): nil {
        self.reader.close();
        self.writer.close();
    }
}

frame Pipe {
    pub reader: PipeReader;
    pub writer: PipeWriter;

    pub init() {
        var pair = create_pipe();
        self.reader = pair.reader;
        self.writer = pair.writer;
    }

    pub fn write(content: str): bool {
        return self.writer.write(content);
    }

    pub fn write_line(line: str): bool {
        return self.writer.write_line(line);
    }

    pub fn read(buffer_size: int = 1024): str {
        return self.reader.read(buffer_size);
    }

    pub fn read_all(): str {
        return self.reader.read_all();
    }

    pub fn read_line(): str {
        return self.reader.read_line();
    }

    pub fn is_open(): bool {
        return self.reader.is_open() or self.writer.is_open();
    }

    pub fn close(): nil {
        self.reader.close();
        self.writer.close();
    }
}

pub fn create_pipe(): PipePair {
    var r_res = res.create(res.KIND_FILE, ["pipe_read"])? else {
        return PipePair(PipeReader(res.Resource(-1, res.KIND_FILE)), PipeWriter(res.Resource(-1, res.KIND_FILE)));
    };
    var w_res = res.create(res.KIND_FILE, ["pipe_write"])? else {
        return PipePair(PipeReader(r_res), PipeWriter(res.Resource(-1, res.KIND_FILE)));
    };
    return PipePair(PipeReader(r_res), PipeWriter(w_res));
}
