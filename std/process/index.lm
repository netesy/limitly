// std/process/index.lm
// Public facade for std.process: the process as an entity.
//
// No implementation lives here. std.process owns identity (id, program name,
// arguments), lifecycle (exit), memory (resident set) and children (run, exec,
// Command). Facts about the surrounding machine - environment variables, working
// directory, home/temp locations, platform identity - belong to std.os.

import std.process.process as process_mod;
pub import std.process.command show Command;
pub import std.process.pipe show Pipe;

frame Process {
    pub init() {}
    pub fn exit(code: int): nil { return process_mod.exit(code); }
    pub fn run(cmd_str: str): int { return process_mod.run(cmd_str); }
    pub fn id(): int { return process_mod.id(); }
    pub fn args(): [str] { return process_mod.args(); }
    pub fn command(): str { return process_mod.command(); }
    pub fn memory(): int { return process_mod.memory(); }
    pub fn peak_memory(): int { return process_mod.peak_memory(); }
    pub fn current_rss(): int { return process_mod.current_rss(); }
    pub fn peak_rss(): int { return process_mod.peak_rss(); }
}

pub fn exit(code: int): nil {
    return process_mod.exit(code);
}

pub fn run(cmd_str: str): int {
    return process_mod.run(cmd_str);
}

pub fn exec(program: str, arguments: [str]): int {
    return process_mod.exec(program, arguments);
}

pub fn id(): int {
    return process_mod.id();
}

pub fn args(): [str] {
    return process_mod.args();
}

pub fn command(): str {
    return process_mod.command();
}

pub fn memory(): int {
    return process_mod.memory();
}

pub fn peak_memory(): int {
    return process_mod.peak_memory();
}

// Aliases for the names used before the shared OS layer; see std.process.memory.
pub fn current_rss(): int {
    return process_mod.current_rss();
}

pub fn peak_rss(): int {
    return process_mod.peak_rss();
}
