// std/process/process.lm
// Process identity, arguments, memory inspection, and subprocess execution.

import std.process.service as service;
import std.internal.runtime as rt;

/// Terminates the process immediately with the given exit code.
///
/// @warning Flushes standard streams and terminates without executing frame destructors.
///
/// @param code Operating system exit code.
pub fn exit(code: int): nil {
    service.request_with(rt.OP_PROC_EXIT, [code]);
    return nil;
}

/// Returns the operating system Process ID (PID).
///
/// @return Process ID integer (0 when unavailable).
pub fn id(): int {
    var result = service.request(rt.OP_PROC_ID);
    if (result == nil) return 0;
    return result as int;
}

/// Alias for `id()`.
///
/// @return Process ID integer.
pub fn pid(): int {
    return id();
}

/// Returns the command line arguments passed to the program, excluding the binary name.
///
/// @return List of argument strings.
pub fn args(): [str] {
    var result = service.request(rt.OP_PROC_ARGS);
    if (result == nil) return [] as [str];
    return result as [str];
}

/// Returns the program name as invoked (argv[0]).
///
/// @return Executable invocation name.
pub fn command(): str {
    var result = service.request(rt.OP_PROC_COMMAND);
    if (result == nil) return "";
    return result as str;
}

/// Returns the current resident set size (RSS) in kilobytes.
///
/// @return Memory usage in KB.
pub fn memory(): int {
    var result = service.request(rt.OP_PROC_RSS);
    if (result == nil) return 0;
    return result as int;
}

/// Returns the peak resident set size (RSS) in kilobytes since launch.
///
/// @return Peak memory usage in KB.
pub fn peak_memory(): int {
    var result = service.request(rt.OP_PROC_PEAK_RSS);
    if (result == nil) return 0;
    return result as int;
}

/// Alias for `memory()`.
///
/// @return Resident set size in KB.
pub fn current_rss(): int {
    return memory();
}

/// Alias for `peak_memory()`.
///
/// @return Peak resident set size in KB.
pub fn peak_rss(): int {
    return peak_memory();
}

fn is_space_at(text: str, index: int): bool {
    var character = _builtin_substring(text, index, index + 1);
    return character == " " or character == "\t";
}

fn to_argv(command_line: str): [any] {
    var argv = [] as [any];
    var i: int = 0;
    var n: int = len(command_line);
    while (i < n) {
        while (i < n and is_space_at(command_line, i)) {
            i = i + 1;
        }
        if (i >= n) break;
        var start: int = i;
        while (i < n and not is_space_at(command_line, i)) {
            i = i + 1;
        }
        argv.append(_builtin_substring(command_line, start, i));
    }
    return argv;
}

/// Spawns a shell or process command string and waits for its exit code.
///
/// @pre len(command_line) > 0
/// @param command_line Raw command string to execute.
/// @return Exit code (0 for success, non-zero for error, -1 if spawn failed).
pub fn run(command_line: str): int {
    contract(len(command_line) > 0, "Command line must not be empty");
    var result = service.request_with(rt.OP_SPAWN, to_argv(command_line));
    if (result == nil) return -1;
    return result as int;
}

/// Executes a program binary directly with discrete arguments and waits for its exit code.
///
/// @pre len(program) > 0
/// @param program Executable binary name or path.
/// @param arguments Vector of arguments.
/// @return Exit code.
pub fn exec(program: str, arguments: [str]): int {
    contract(len(program) > 0, "Program name must not be empty");
    var argv = [] as [any];
    argv.append(program);
    var i = 0;
    while (i < len(arguments)) {
        argv.append(arguments[i]);
        i = i + 1;
    }
    var result = service.request_with(rt.OP_SPAWN, argv);
    if (result == nil) return -1;
    return result as int;
}
