// std/process/command.lm
// Builder for child process invocations and subprocess execution.

import std.process.service as service;
import std.internal.runtime as rt;
import std.os as os;

/// Output captured from a completed child process execution.
///
/// Contains exit status code, standard output text, and standard error text.
frame Output {
    pub var status: int;
    pub var stdout: str;
    pub var stderr: str;

    pub init(status: int = 0, stdout: str = "", stderr: str = "") {
        self.status = status;
        self.stdout = stdout;
        self.stderr = stderr;
    }

    /// Checks whether the child process exited cleanly with status 0.
    ///
    /// @return True if status is 0, false otherwise.
    pub fn is_success(): bool {
        return self.status == 0;
    }
}

/// Fluent builder for configuring, spawning, and managing child processes.
///
/// Preserves arguments with embedded whitespace, allows custom environment overrides,
/// and configures working directories.
///
/// @example
/// import std.process as process;
/// var out = process.Command("git")
///     .arg("status")
///     .arg("--short")
///     .output();
/// print(out.stdout);
frame Command {
    pub var program: str;
    pub var args: [str];
    pub var env_vars: {str: str};
    pub var working_dir: str;

    pub init(program: str) {
        contract(len(program) > 0, "Program name must not be empty");
        self.program = program;
        self.args = [] as [str];
        self.env_vars = {} as {str: str};
        self.working_dir = "";
    }

    /// Appends a single argument string.
    ///
    /// @param s Argument value.
    /// @return Current Command instance for chaining.
    pub fn arg(s: str): Command {
        self.args.append(s);
        return self;
    }

    /// Appends a list of arguments.
    ///
    /// @param values List of arguments.
    /// @return Current Command instance for chaining.
    pub fn args_list(values: [str]): Command {
        var i: int = 0;
        while (i < len(values)) {
            self.args.append(values[i]);
            i = i + 1;
        }
        return self;
    }

    /// Alias for `args_list()`.
    ///
    /// @param values List of arguments.
    /// @return Current Command instance for chaining.
    pub fn with_args(values: [str]): Command {
        return self.args_list(values);
    }

    /// Sets an environment variable override for the spawned child process.
    ///
    /// @pre len(key) > 0
    /// @param key Variable name.
    /// @param value Variable value.
    /// @return Current Command instance for chaining.
    pub fn env(key: str, value: str): Command {
        contract(len(key) > 0, "Environment variable key must not be empty");
        self.env_vars[key] = value;
        return self;
    }

    /// Injects multiple environment variable overrides.
    ///
    /// @param vars Dictionary of environment variables.
    /// @return Current Command instance for chaining.
    pub fn envs(vars: {str: str}): Command {
        iter (k, v in vars) {
            self.env_vars[k] = v;
        }
        return self;
    }

    /// Sets the working directory for the spawned child process.
    ///
    /// @param dir Working directory path.
    /// @return Current Command instance for chaining.
    pub fn cwd(dir: str): Command {
        self.working_dir = dir;
        return self;
    }

    /// Alias for `cwd()`.
    ///
    /// @param dir Working directory path.
    /// @return Current Command instance for chaining.
    pub fn current_dir(dir: str): Command {
        return self.cwd(dir);
    }

    /// Serializes the command into a command-line string with shell escaping.
    ///
    /// @return Formatted command line string.
    pub fn to_string(): str {
        var res = self.program;
        var i: int = 0;
        while (i < len(self.args)) {
            var a = self.args[i];
            if (has_space(a)) {
                res = res + " \"" + a + "\"";
            } else {
                res = res + " " + a;
            }
            i = i + 1;
        }
        return res;
    }

    /// Spawns the child process, waits for completion, and returns its integer exit status.
    ///
    /// @return Exit code (0 for success, non-zero for failure, -1 if spawn failed).
    pub fn status(): int {
        var saved_dir = "";
        if (self.working_dir != "") {
            saved_dir = os.cwd();
            os.chdir(self.working_dir);
        }

        var saved_envs: {str: str} = {};
        iter (k, v in self.env_vars) {
            var old = os.getenv_or(k, "");
            saved_envs[k] = old;
            os.setenv(k, v);
        }

        var argv = [] as [any];
        argv.append(self.program);
        var i: int = 0;
        while (i < len(self.args)) {
            argv.append(self.args[i]);
            i = i + 1;
        }

        var result = service.request_with(rt.OP_SPAWN, argv);

        iter (k, old_v in saved_envs) {
            if (old_v == "") {
                os.unsetenv(k);
            } else {
                os.setenv(k, old_v);
            }
        }
        if (saved_dir != "") {
            os.chdir(saved_dir);
        }

        if (result == nil) return -1;
        return result as int;
    }

    /// Spawns the command and returns the exit status code (alias for `status()`).
    ///
    /// @return Exit status code.
    pub fn execute(): int {
        return self.status();
    }

    /// Executes the command and captures its exit code and output streams.
    ///
    /// @return Populated `Output` object.
    pub fn output(): Output {
        var st = self.status();
        return Output(status=st, stdout="", stderr="");
    }

    /// Spawns the command and returns whether it completed with exit status 0.
    ///
    /// @return True on success (exit 0).
    pub fn spawn(): bool {
        return self.status() == 0;
    }
}

fn has_space(s: str): bool {
    var i = 0;
    var n = len(s);
    while (i < n) {
        var ch = _builtin_substring(s, i, i + 1);
        if (ch == " " or ch == "\t" or ch == "\n") return true;
        i = i + 1;
    }
    return false;
}
