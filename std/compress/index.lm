// std/compress/index.lm
// Clean standard library entrypoint for data compression

import std.compress.zlib as zlib;

pub import std.compress.zlib show Zlib;

pub fn Zlib(): zlib.Zlib {
    return zlib.Zlib();
}

pub fn compress(data: str, level: int = 6): str? {
    return zlib.compress(data, level);
}

pub fn decompress(compressed: str, max_limit: int = 10485760): str? {
    return zlib.decompress(compressed, max_limit);
}

pub fn compress_hex(data: str, level: int = 6): str? {
    return zlib.compress_hex(data, level);
}

pub fn decompress_hex(compressed_hex: str, max_limit: int = 10485760): str? {
    return zlib.decompress_hex(compressed_hex, max_limit);
}
