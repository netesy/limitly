// HTML Module Gateway Index

import std.html.escape as esc;
import std.html.parser as parser;
pub import std.html.parser show Node;

pub fn escape(text: str): str {
    return esc.escape(text);
}

pub fn unescape(text: str): str {
    return esc.unescape(text);
}

pub fn parse(text: str): Node {
    return parser.parse(text);
}
