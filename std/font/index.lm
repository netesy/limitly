// std/font/index.lm
// TrueType & OpenType Font Loading, Typography Metrics, and Antialiased Text Rasterization.

import std.font.reader as r;
import std.font.tables as t;
import std.font.glyph as g;
import std.font.rasterizer as rast;
import std.io.file as _iof;

pub type GlyphBitmap = rast.GlyphBitmap;

frame FontMetrics {
    pub var ascent: float;
    pub var descent: float;
    pub var line_gap: float;
    pub var line_height: float;
    pub var units_per_em: int;

    pub init(asc: float = 0.0, desc: float = 0.0, gap: float = 0.0, h: float = 0.0, upem: int = 1000) {
        self.ascent = asc;
        self.descent = desc;
        self.line_gap = gap;
        self.line_height = h;
        self.units_per_em = upem;
    }
}

frame TypoMetrics {
    pub var ascent: float;
    pub var descent: float;
    pub var line_gap: float;
    pub var line_height: float;

    pub init(asc: float = 0.0, desc: float = 0.0, gap: float = 0.0, h: float = 0.0) {
        self.ascent = asc;
        self.descent = desc;
        self.line_gap = gap;
        self.line_height = h;
    }
}

frame GlyphMetrics {
    pub var glyph_index: int;
    pub var advance_width: float;
    pub var left_side_bearing: float;
    pub var width: float;
    pub var height: float;

    pub init(idx: int = 0, adv: float = 0.0, lsb: float = 0.0, w: float = 0.0, h: float = 0.0) {
        self.glyph_index = idx;
        self.advance_width = adv;
        self.left_side_bearing = lsb;
        self.width = w;
        self.height = h;
    }
}

frame Font {
    pub var path: str;
    pub var is_valid: bool;
    pub var info: t.FontInfo;
    pub var reader: r.ByteReader;

    pub init(font_path: str = "", font_info: t.FontInfo = t.FontInfo(), rdr: r.ByteReader = r.ByteReader([] as [int])) {
        self.path = font_path;
        self.info = font_info;
        self.reader = rdr;
        self.is_valid = font_info.is_valid;
    }

    pub fn get_metrics(font_size: float = 16.0): FontMetrics {
        if (!self.is_valid) {
            return FontMetrics();
        }
        var upem = self.info.units_per_em;
        if (upem <= 0) upem = 1000;
        var scale = font_size / (upem as float);

        var asc = (self.info.ascent as float) * scale;
        var desc = (self.info.descent as float) * scale;
        var gap = (self.info.line_gap as float) * scale;
        var lh = (asc - desc) + gap;
        if (lh < font_size) lh = font_size;

        return FontMetrics(asc, desc, gap, lh, upem);
    }

    pub fn get_glyph_index(codepoint: int): int {
        if (!self.is_valid) { return 0; }
        return self.info.get_glyph_index(self.reader, codepoint);
    }

    pub fn get_glyph_metrics(glyph_idx: int, font_size: float = 16.0): GlyphMetrics {
        if (!self.is_valid) { return GlyphMetrics(); }
        var upem = self.info.units_per_em;
        if (upem <= 0) upem = 1000;
        var scale = font_size / (upem as float);

        var hmet = self.info.get_glyph_hmetrics(self.reader, glyph_idx);
        var adv = (hmet[0] as float) * scale;
        var lsb = (hmet[1] as float) * scale;

        return GlyphMetrics(glyph_idx, adv, lsb, adv, font_size);
    }

    pub fn get_kern_advance(glyph1: int, glyph2: int, font_size: float = 16.0): float {
        if (!self.is_valid) { return 0.0; }
        var kern = self.info.get_kern_advance(glyph1, glyph2);
        var upem = self.info.units_per_em;
        if (upem <= 0) upem = 1000;
        var scale = font_size / (upem as float);
        return (kern as float) * scale;
    }

    pub fn get_kern_advance_codepoint(ch1: int, ch2: int, font_size: float = 16.0): float {
        if (!self.is_valid) { return 0.0; }
        var g1 = self.get_glyph_index(ch1);
        var g2 = self.get_glyph_index(ch2);
        return self.get_kern_advance(g1, g2, font_size);
    }

    pub fn get_typo_metrics(font_size: float = 16.0): TypoMetrics {
        if (!self.is_valid or !self.info.has_os2) {
            return TypoMetrics();
        }
        var upem = self.info.units_per_em;
        if (upem <= 0) upem = 1000;
        var scale = font_size / (upem as float);

        var asc = (self.info.typo_ascent as float) * scale;
        var desc = (self.info.typo_descent as float) * scale;
        var gap = (self.info.typo_line_gap as float) * scale;
        var lh = (asc - desc) + gap;
        if (lh < font_size) lh = font_size;

        return TypoMetrics(asc, desc, gap, lh);
    }

    pub fn text_width(text: str, font_size: float = 16.0): float {
        if (!self.is_valid or text == "") { return 0.0; }

        var upem = self.info.units_per_em;
        if (upem <= 0) upem = 1000;
        var scale = font_size / (upem as float);
        var total_w = 0.0;

        var prev_gid = -1;
        for (var i = 0; i < len(text); i = i + 1) {
            var ch = text[i];
            var gid = self.get_glyph_index(ch);
            var hmet = self.info.get_glyph_hmetrics(self.reader, gid);
            total_w = total_w + ((hmet[0] as float) * scale);

            // Add kerning if available
            if (prev_gid >= 0 and self.info.has_kern) {
                var kern = self.info.get_kern_advance(prev_gid, gid);
                total_w = total_w + ((kern as float) * scale);
            }

            prev_gid = gid;
        }

        return total_w;
    }

    pub fn text_height(text: str, font_size: float = 16.0): float {
        if (!self.is_valid or text == "") { return 0.0; }

        var m = self.get_metrics(font_size);
        return m.line_height;
    }

    pub fn render_glyph(glyph_idx: int, font_size: float = 16.0): rast.GlyphBitmap {
        if (!self.is_valid) {
            return rast.GlyphBitmap(0, 0, 0, 0, [] as [int]);
        }
        var upem = self.info.units_per_em;
        if (upem <= 0) upem = 1000;
        var scale = font_size / (upem as float);

        var outline = g.parse_glyph(self.reader, self.info, glyph_idx);
        return rast.rasterize_glyph(outline, scale);
    }

    pub fn render_glyph_subpixel(glyph_idx: int, font_size: float = 16.0, oversample_x: int = 1, oversample_y: int = 1, shift_x: float = 0.0, shift_y: float = 0.0): rast.GlyphBitmap {
        if (!self.is_valid) {
            return rast.GlyphBitmap(0, 0, 0, 0, [] as [int]);
        }
        var upem = self.info.units_per_em;
        if (upem <= 0) upem = 1000;
        var scale = font_size / (upem as float);

        var outline = g.parse_glyph(self.reader, self.info, glyph_idx);
        return rast.rasterize_glyph_subpixel(outline, scale, oversample_x, oversample_y, shift_x, shift_y);
    }

    pub fn render_glyph_sdf(glyph_idx: int, font_size: float = 16.0, padding: int = 0, onedge_value: float = 128.0, pixel_dist_scale: float = 1.0): rast.GlyphBitmap {
        if (!self.is_valid) {
            return rast.GlyphBitmap(0, 0, 0, 0, [] as [int]);
        }
        var upem = self.info.units_per_em;
        if (upem <= 0) upem = 1000;
        var scale = font_size / (upem as float);

        var outline = g.parse_glyph(self.reader, self.info, glyph_idx);
        return rast.rasterize_glyph_sdf(outline, scale, padding, onedge_value, pixel_dist_scale);
    }
}

pub fn load_font_from_bytes(bytes: [int], filepath: str = "", font_index: int = 0): Font? {
    var reader = r.ByteReader(bytes);

    // Get font offset for TTC files
    var font_offset = t.get_font_offset(reader, font_index);
    if (font_offset < 0) {
        return err();
    }

    reader.seek(font_offset);
    match (t.parse_tables(reader)) {
        val info => return ok(Font(font_path=filepath, font_info=info, rdr=reader)),
        err e => return err()
    }
}

pub fn get_num_fonts_from_bytes(bytes: [int]): int {
    var reader = r.ByteReader(bytes);
    return t.get_num_fonts(reader);
}

pub fn load_font(filepath: str, font_index: int = 0): Font? {
    match (_iof.open(filepath, "rb")) {
        val f => {
            match (f.read_bytes()) {
                val bytes => {
                    return load_font_from_bytes(bytes, filepath, font_index);
                },
                err e => { return err(); }
            }
        },
        err e => { return err(); }
    }
}

pub fn get_num_fonts(filepath: str): int {
    match (_iof.open(filepath, "rb")) {
        val f => {
            match (f.read_bytes()) {
                val bytes => {
                    return get_num_fonts_from_bytes(bytes);
                },
                err e => { return 0; }
            }
        },
        err e => { return 0; }
    }
}
