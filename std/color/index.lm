// Standard Library Color Module
//
// Canonical Color frame, RGBA / Hex / HSL constructors, linear interpolation,
// base palette, and Tailwind-inspired shade palettes.
//
// The Color implementation lives in std.color.core (shared with
// std.color.palette); this facade re-exports it so there is exactly one
// nominal Color type across std.color. Color constants are re-declared as
// `pub const` aliases because `pub import show` does not preserve frame
// constants at runtime.

import std.color.core as core;

pub import std.color.core show
    Color,
    rgb, rgba, hex, color_rgb, color_rgba, hsl, lerp;

pub const white: Color       = core.white;
pub const black: Color       = core.black;
pub const transparent: Color = core.transparent;
pub const red: Color         = core.red;
pub const green: Color       = core.green;
pub const blue: Color        = core.blue;
pub const indigo: Color      = core.indigo;
pub const yellow: Color      = core.yellow;
pub const cyan: Color        = core.cyan;
pub const gray: Color        = core.gray;
pub const dark_gray: Color   = core.dark_gray;
pub const light_gray: Color  = core.light_gray;

pub import std.color.palette show Shades, shade, palette, slate, zinc, neutral, stone, orange, amber, lime, emerald, teal, sky, violet, purple, fuchsia, pink, rose, crimson, cool_gray, warm_gray, tw;
