// std/color/index.lm
// Canonical Color frame, constructors, operations, palettes, and palette integration.

// Color Palette Integration
pub import std.color.palette show Shades, shade, palette, slate, zinc, neutral, stone, orange, amber, lime, emerald, teal, sky, violet, purple, fuchsia, pink, rose, crimson, cool_gray, warm_gray, tw;

import std.math as math;

frame Color {
    pub var r: float; // 0.0 to 1.0
    pub var g: float;
    pub var b: float;
    pub var a: float;

    pub init(r: float = 0.0, g: float = 0.0, b: float = 0.0, a: float = 1.0) {
        self.r = r;
        self.g = g;
        self.b = b;
        self.a = a;
    }

    pub fn to_hex(): str {
        var ri = (self.r * 255.0) as int;
        var gi = (self.g * 255.0) as int;
        var bi = (self.b * 255.0) as int;
        if (ri < 0) ri = 0;
        if (ri > 255) ri = 255;
        if (gi < 0) gi = 0;
        if (gi > 255) gi = 255;
        if (bi < 0) bi = 0;
        if (bi > 255) bi = 255;
        return "#" + hex_byte(ri) + hex_byte(gi) + hex_byte(bi);
    }

    pub fn with_alpha(new_a: float): Color {
        return Color(r=self.r, g=self.g, b=self.b, a=new_a);
    }
}

fn hex_digit(v: int): str {
    match (v) {
        0 => { return "0"; },
        1 => { return "1"; },
        2 => { return "2"; },
        3 => { return "3"; },
        4 => { return "4"; },
        5 => { return "5"; },
        6 => { return "6"; },
        7 => { return "7"; },
        8 => { return "8"; },
        9 => { return "9"; },
        10 => { return "a"; },
        11 => { return "b"; },
        12 => { return "c"; },
        13 => { return "d"; },
        14 => { return "e"; },
        _ => { return "f"; }
    }
}

fn hex_byte(v: int): str {
    var hi = v / 16;
    var lo = v % 16;
    return hex_digit(hi) + hex_digit(lo);
}

pub fn rgb(r: int, g: int, b: int): Color {
    return Color(r=(r as float) / 255.0, g=(g as float) / 255.0, b=(b as float) / 255.0, a=1.0);
}

pub fn rgba(r: int, g: int, b: int, a: float): Color {
    return Color(r=(r as float) / 255.0, g=(g as float) / 255.0, b=(b as float) / 255.0, a=a);
}

pub fn hex(c: int, a: float = 1.0): Color {
    var r = (c >> 16) & 255;
    var g = (c >> 8) & 255;
    var b = c & 255;
    return Color(r=(r as float) / 255.0, g=(g as float) / 255.0, b=(b as float) / 255.0, a=a);
}

pub fn color_rgb(r: float, g: float, b: float): Color {
    return Color(r=r, g=g, b=b, a=1.0);
}

pub fn color_rgba(r: float, g: float, b: float, a: float): Color {
    return Color(r=r, g=g, b=b, a=a);
}

fn hue_to_rgb(p: float, q: float, t: float): float {
    var tv = t;
    if (tv < 0.0) tv = tv + 1.0;
    if (tv > 1.0) tv = tv - 1.0;
    if (tv < 0.1667) return p + (q - p) * 6.0 * tv;
    if (tv < 0.5) return q;
    if (tv < 0.6667) return p + (q - p) * (0.6667 - tv) * 6.0;
    return p;
}

pub fn hsl(h: float, s: float, l: float): Color {
    var hn = h;
    while (hn < 0.0) { hn = hn + 360.0; }
    while (hn >= 360.0) { hn = hn - 360.0; }
    var sn = s;
    if (sn < 0.0) sn = 0.0;
    if (sn > 1.0) sn = 1.0;
    var ln = l;
    if (ln < 0.0) ln = 0.0;
    if (ln > 1.0) ln = 1.0;

    if (sn == 0.0) {
        return Color(r = ln, g = ln, b = ln, a = 1.0);
    }

    var q = 0.0;
    if (ln < 0.5) {
        q = ln * (1.0 + sn);
    } else {
        q = ln + sn - ln * sn;
    }
    var p = 2.0 * ln - q;
    var hk = hn / 360.0;

    var r = hue_to_rgb(p, q, hk + 0.3333);
    var g = hue_to_rgb(p, q, hk);
    var b = hue_to_rgb(p, q, hk - 0.3333);
    return Color(r = r, g = g, b = b, a = 1.0);
}

pub fn lerp(c1: Color, c2: Color, t: float): Color {
    return Color(
        c1.r + (c2.r - c1.r) * t,
        c1.g + (c2.g - c1.g) * t,
        c1.b + (c2.b - c1.b) * t,
        c1.a + (c2.a - c1.a) * t
    );
}

// Built-in standard palette constants
pub const white: Color       = Color(r=1.0, g=1.0, b=1.0, a=1.0);
pub const black: Color       = Color(r=0.0, g=0.0, b=0.0, a=1.0);
pub const transparent: Color = Color(r=0.0, g=0.0, b=0.0, a=0.0);
pub const red: Color         = Color(r=0.92, g=0.25, b=0.25, a=1.0);
pub const green: Color       = Color(r=0.25, g=0.85, b=0.35, a=1.0);
pub const blue: Color        = Color(r=0.25, g=0.55, b=0.95, a=1.0);
pub const indigo: Color      = Color(r=0.35, g=0.35, b=0.90, a=1.0);
pub const yellow: Color      = Color(r=0.95, g=0.85, b=0.20, a=1.0);
pub const cyan: Color        = Color(r=0.20, g=0.85, b=0.90, a=1.0);
pub const gray: Color        = Color(r=0.55, g=0.55, b=0.55, a=1.0);
pub const dark_gray: Color   = Color(r=0.15, g=0.15, b=0.18, a=1.0);
pub const light_gray: Color  = Color(r=0.85, g=0.85, b=0.88, a=1.0);
