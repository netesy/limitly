// std/path/index.lm
// Path module - Cross-platform path manipulation.
//
// The separator that gets written is the platform one (std.os.path_separator);
// both "/" and "\" are always accepted when reading, so a POSIX path can be
// manipulated on Windows and vice versa.

/// # Cross-Platform Path Manipulation (`std.path`)
///
/// Flexible, cross-platform filesystem path manipulation. Accepts both POSIX (`/`)
/// and Windows (`\`) separators transparently on any operating system, while normalizing
/// and emitting the host platform separator (`os.path_separator()`).
///
/// @tip Use `Path` to construct, decompose, join, and normalize filesystem paths safely.
///
/// @example
/// import std.path as path;
/// var p = path.Path("src").join("main.lm");
/// print("Path: {p.display()} (ext: {p.extension()})");

import std.io as io;
import std.os as os;

/// Represents a filesystem path, providing methods for component decomposition,
/// joining, normalization, and filesystem inspection.
///
/// @tip All join operations normalize redundant separators automatically.
///
/// @param value The raw string path backing this Path instance.
///
/// @example
/// var p = Path("/usr/local/bin");
/// print("Basename: {p.basename()}"); // "bin"
frame Path {
    pub value: str;

    pub init(value: str) {
        self.value = value;
    }

    /// Creates a new Path instance from a raw string.
    ///
    /// @param path Raw string path.
    /// @return New Path instance.
    pub fn from_string(path: str): Path {
        return Path(path);
    }

    /// Appends a child segment to this path, inserting the platform separator if needed.
    ///
    /// @tip Correctly prevents double separators and honors platform separator rules.
    ///
    /// @param other Path segment to append.
    /// @return Joined Path instance.
    pub fn join(other: str): Path {
        if (self.value == "") return Path(other);
        if (other == "") return Path(self.value);

        // Handle path separators: emit the platform separator, but never
        // duplicate one that is already present on either side.
        var separator = os.path_separator();
        if (ends_with_separator(self.value) or starts_with_separator(other)) {
            return Path(self.value + other);
        }
        var joined = self.value + separator;
        return Path(joined + other);
    }

    /// Sequentially joins multiple path segments to this path.
    ///
    /// @param parts Array of path segments to append in order.
    /// @return Cumulative joined Path.
    pub fn join_multiple(parts: [str]): Path {
        var p = Path(self.value);
        var i: int = 0;
        while (i < len(parts)) {
            p = p.join(parts[i]);
            i = i + 1;
        }
        return p;
    }

    /// Returns the parent directory path, or nil if at filesystem root or empty.
    ///
    /// @return Optional parent Path, or nil.
    pub fn parent(): Path? {
        if (len(self.value) == 0 or is_root_text(self.value)) {
            var fallback: Path? = nil;
            return fallback;
        }

        var last_sep = last_separator_index(self.value);
        if (last_sep == -1) return Path("");

        var parent_path = substring(self.value, 0, last_sep);
        if (parent_path != "") {
            return Path(parent_path);
        } else {
            return Path(os.path_separator());
        }
    }

    /// Returns the final component of the path (filename or leaf directory name).
    ///
    /// @return Basename string.
    pub fn basename(): str {
        if (len(self.value) == 0 or is_root_text(self.value)) return self.value;

        var last_sep = last_separator_index(self.value);
        if (last_sep == -1) return self.value;

        if (last_sep + 1 < len(self.value)) {
            return substring(self.value, last_sep + 1, len(self.value));
        } else {
            return "";
        }
    }

    /// Returns the file stem (the basename without its final file extension).
    ///
    /// @return File stem string.
    pub fn stem(): str {
        var base = self.basename();
        var last_dot = last_index_of(base, ".");
        if (last_dot == -1 or last_dot == 0) return base;

        return substring(base, 0, last_dot);
    }

    /// Returns the file extension without the leading dot, or empty string if none.
    ///
    /// @return File extension string (e.g. "lm", "txt", "tar").
    pub fn extension(): str {
        var base = self.basename();
        var last_dot = last_index_of(base, ".");
        if (last_dot == -1 or last_dot == 0 or last_dot == len(base) - 1) return "";

        return substring(base, last_dot + 1, len(base));
    }

    /// Normalizes path syntax: resolves `.` and `..`, collapses duplicate separators,
    /// and ensures uniform host platform separators.
    ///
    /// @tip Normalization operates purely on strings without filesystem I/O.
    /// @return Normalized Path instance.
    pub fn normalize(): Path {
        var text = self.value;
        if (len(text) == 0) return Path("");

        var separator = os.path_separator();
        var absolute = is_absolute_text(text);

        var result = "";
        if (absolute and has_drive_prefix(text)) {
            result = substring(text, 0, 2);
            text = substring(text, 2, len(text));
        } elif (absolute) {
            result = separator;
        }

        var parts = [] as [str];
        var depth: int = 0;
        var i: int = 0;
        var n: int = len(text);
        while (i < n) {
            var start: int = i;
            while (i < n and not is_separator(substring(text, i, i + 1))) {
                i = i + 1;
            }
            var part = substring(text, start, i);
            if (part != "" and part != ".") {
                if (part == "..") {
                    if (depth > 0 and parts[depth - 1] != "..") {
                        // Discard the pending component by shrinking the live
                        // depth; the slot is reused by the next assignment.
                        depth = depth - 1;
                    } elif (not absolute) {
                        parts[depth] = part;
                        depth = depth + 1;
                    }
                } else {
                    parts[depth] = part;
                    depth = depth + 1;
                }
            }
            i = i + 1;
        }

        var k: int = 0;
        while (k < depth) {
            if (result == "" or ends_with_separator(result)) {
                result = result + parts[k];
            } else {
                var with_sep = result + separator;
                result = with_sep + parts[k];
            }
            k = k + 1;
        }

        if (result == "") {
            if (absolute) return Path(separator);
            return Path(".");
        }
        return Path(result);
    }

    /// Resolves redundant components in the path (alias for `normalize()`).
    ///
    /// @return Normalized Path instance.
    pub fn resolve(): Path {
        return self.normalize();
    }

    /// Checks whether the path begins with a root separator or drive specification.
    ///
    /// @return True if absolute, false if relative.
    pub fn is_absolute(): bool {
        return is_absolute_text(self.value);
    }

    /// Checks whether the path is relative to the current working directory.
    ///
    /// @return True if relative, false if absolute.
    pub fn is_relative(): bool {
        return not self.is_absolute();
    }

    /// Checks whether this path exists on the host filesystem.
    ///
    /// @return True if the file or directory exists.
    pub fn exists(): bool {
        return io.exists(self.value);
    }

    /// Returns a new Path with the file extension replaced by the given one.
    ///
    /// @param extension New file extension string (without leading dot).
    /// @return Updated Path.
    pub fn with_extension(extension: str): Path {
        var base = self.stem();
        var parent_val = self.parent();
        match (parent_val) {
            val parent_path => return parent_path.join(base + "." + extension),
            nil => return Path(base + "." + extension)
        }
    }

    /// Returns a new Path with its leaf filename replaced by the given one.
    ///
    /// @param basename New basename string.
    /// @return Updated Path.
    pub fn with_basename(basename: str): Path {
        var parent_val = self.parent();
        match (parent_val) {
            val parent_path => return parent_path.join(basename),
            nil => return Path(basename)
        }
    }

    /// Compares two paths for semantic equivalence after normalization.
    ///
    /// @pre other != nil
    /// @param other The target Path to compare against.
    /// @return True if both normalized paths are identical.
    pub fn equals(other: Path): bool {
        contract(other != nil, "Comparison target must not be nil");
        return self.normalize().value == other.normalize().value;
    }

    /// Checks whether this normalized path starts with the given prefix path.
    ///
    /// @pre prefix != nil
    /// @param prefix Prefix Path to test.
    /// @return True if this path begins with prefix.
    pub fn starts_with(prefix: Path): bool {
        contract(prefix != nil, "Prefix must not be nil");
        return starts_with(self.normalize().value, prefix.normalize().value);
    }

    /// Checks whether this normalized path ends with the given suffix path.
    ///
    /// @pre suffix != nil
    /// @param suffix Suffix Path to test.
    /// @return True if this path ends with suffix.
    pub fn ends_with(suffix: Path): bool {
        contract(suffix != nil, "Suffix must not be nil");
        return ends_with(self.normalize().value, suffix.normalize().value);
    }

    /// Returns the raw underlying string representation of this path.
    ///
    /// @return String representation.
    pub fn to_string(): str {
        return self.value;
    }

    /// Returns the display string for printing and log outputs.
    ///
    /// @return Display string.
    pub fn display(): str {
        return self.to_string();
    }
}

/// Creates a new Path instance from a raw string.
///
/// @param v Raw path string.
/// @return New Path instance.
pub fn from_string(v: str): Path {
    return Path.from_string(v);
}

/// Joins an array of path strings using platform separator logic.
///
/// @param paths Array of path segments.
/// @return Joined Path instance.
pub fn join(paths: [str]): Path {
    if (len(paths) == 0) return Path("");
    if (len(paths) == 1) return Path.from_string(paths[0]);

    var result = Path.from_string(paths[0]);
    var i: int = 1;
    while (i < len(paths)) {
        result = result.join(paths[i]);
        i = i + 1;
    }
    return result;
}

/// Normalizes a path string, resolving `.` and `..` segments.
///
/// @param path_str Raw path string.
/// @return Normalized Path instance.
pub fn normalize(path_str: str): Path {
    return Path.from_string(path_str).normalize();
}

/// Checks whether a path string represents a relative path.
///
/// @param path_str Path string to inspect.
/// @return True if relative, false if absolute.
pub fn is_relative(path_str: str): bool {
    return Path(path_str).is_relative();
}

// Helper functions for string operations since primitive strings don't have methods
fn starts_with(s: str, prefix: str): bool {
    var plen: int = len(prefix);
    var slen: int = len(s);
    if (plen > slen) return false;
    return substring(s, 0, plen) == prefix;
}

fn ends_with(s: str, suffix: str): bool {
    var suflen: int = len(suffix);
    var slen: int = len(s);
    if (suflen > slen) return false;
    return substring(s, slen - suflen, slen) == suffix;
}

fn last_index_of(s: str, pattern: str): int {
    var plen: int = len(pattern);
    var slen: int = len(s);
    if (plen > slen) return -1;
    var i: int = slen - plen;
    while (i >= 0) {
        if (substring(s, i, i + plen) == pattern) return i;
        i = i - 1;
    }
    return -1;
}

// Separator helpers. Parsing accepts both separators on every platform; writing
// always uses the platform separator. Indexing a string yields its character
// code, so characters are extracted with substring() to stay in the str type.
fn is_separator(c: str): bool {
    return c == "/" or c == "\\";
}

fn ends_with_separator(s: str): bool {
    var n: int = len(s);
    if (n == 0) return false;
    return is_separator(substring(s, n - 1, n));
}

fn starts_with_separator(s: str): bool {
    if (len(s) == 0) return false;
    return is_separator(substring(s, 0, 1));
}

// Index of the final separator in s, counting either separator, or -1.
fn last_separator_index(s: str): int {
    var i: int = len(s) - 1;
    while (i >= 0) {
        if (is_separator(substring(s, i, i + 1))) return i;
        i = i - 1;
    }
    return -1;
}

// A path that is nothing but separators is a root ("/", "\\", "//").
fn is_root_text(s: str): bool {
    var n: int = len(s);
    if (n == 0) return false;
    var i: int = 0;
    while (i < n) {
        if (not is_separator(substring(s, i, i + 1))) return false;
        i = i + 1;
    }
    return true;
}

// Windows drive prefix, e.g. the "C:" of "C:/Users".
fn has_drive_prefix(s: str): bool {
    if (len(s) < 2) return false;
    if (substring(s, 1, 2) != ":") return false;
    return not is_separator(substring(s, 0, 1));
}

fn is_absolute_text(s: str): bool {
    if (len(s) == 0) return false;
    if (is_separator(substring(s, 0, 1))) return true;
    return has_drive_prefix(s);
}

/// The platform separator used for writing paths (`\` on Windows, `/` on POSIX).
///
/// @return Host platform path separator string.
pub fn separator(): str {
    return os.path_separator();
}

/// The separator between entries of a search-path environment variable (`:` on POSIX, `;` on Windows).
///
/// @return Search list separator string.
pub fn list_separator(): str {
    return os.path_list_separator();
}

/// Resolves an array of subpaths relative to the process's current working directory.
///
/// @param parts Subpath components to join with the current directory.
/// @return Absolute Path instance.
pub fn absolute(parts: [str]): Path {
    var base = Path(os.cwd());
    return base.join_multiple(parts);
}
