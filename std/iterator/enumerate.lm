// Standard Library Enumerate Iterator

import std.iterator.iterator as it;

frame EnumerateIterator: it.Iterator {
    pub index: int;
    pub source: it.Iterator;

    pub init(source: it.Iterator) {
        self.source = source;
        self.index = 0;
    }

    pub fn has_next(): bool {
        return self.source.has_next();
    }

    pub fn next(): any {
        var index = self.index;
        var item = self.source.next();
        self.index = self.index + 1;
        return (index, item);
    }
}

pub fn enumerate(source: it.Iterator): it.Iterator {
    return EnumerateIterator(source);
}
