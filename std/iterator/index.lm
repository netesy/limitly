import std.iterator.iterator as it;
import std.iterator.iterable as iterable;
import std.iterator.map as map;
import std.iterator.filter as filter;
import std.iterator.take as take;
import std.iterator.skip as skip;
import std.iterator.zip as zip;
import std.iterator.chain as chain;
import std.iterator.enumerate as enumerate;

// Types
pub import std.iterator.iterator show Iterator, PeekableIterator;
pub import std.iterator.iterable show Iterable;

// Common iterator helpers
pub fn iterator(items: [any]): Iterator {
    return it.iterator(items);
}

pub fn collect(source: Iterator): [any] {
    return it.collect(source);
}

// Submodule functions
pub fn map(source: Iterator, f: fn(any): any): Iterator {
    return map.map(source, f);
}

pub fn filter(source: Iterator, p: fn(any): bool): Iterator {
    return filter.filter(source, p);
}

pub fn take(source: Iterator, count: int): Iterator {
    return take.take(source, count);
}

pub fn skip(source: Iterator, count: int): Iterator {
    return skip.skip(source, count);
}

pub fn zip(left: Iterator, right: Iterator): Iterator {
    return zip.zip(left, right);
}

pub fn chain(left: Iterator, right: Iterator): Iterator {
    return chain.chain(left, right);
}

pub fn enumerate(source: Iterator): Iterator {
    return enumerate.enumerate(source);
}

pub fn chunk(source: Iterator, size: int): Iterator {
    return it.chunk(source, size);
}

pub fn cycle(items: [any]): Iterator {
    return it.cycle(items);
}

pub fn step_by(source: Iterator, step: int): Iterator {
    return it.step_by(source, step);
}

pub fn peekable(source: Iterator): PeekableIterator {
    return it.peekable(source);
}
