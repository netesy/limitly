// Standard Library Concrete Map Iterator

import std.iterator.iterator as it;

frame ListMapIterator {
    pub source: it.ListIterator;
    pub f: fn(any): any;

    pub init(source: it.ListIterator, f: fn(any): any) {
        self.source = source;
        self.f = f;
    }

    pub fn next(): any {
        var item = self.source.next();
        if (item == nil) {
            return nil;
        }
        return self.f(item);
    }
}

pub fn map_list(source: it.ListIterator, f: fn(any): any): ListMapIterator {
    return ListMapIterator(source, f);
}
