// Standard Library Chain Iterator

import std.iterator.iterator as it;

frame ChainIterator: it.Iterator {
    pub left: it.Iterator;
    pub on_left: bool;
    pub right: it.Iterator;

    pub init(left: it.Iterator, right: it.Iterator) {
        self.left = left;
        self.right = right;
        self.on_left = true;
    }

    pub fn has_next(): bool {
        if (self.on_left) {
            if (self.left.has_next()) {
                return true;
            }
            self.on_left = false;
        }
        return self.right.has_next();
    }

    pub fn next(): any {
        if (not self.has_next()) {
            return nil;
        }
        if (self.on_left) {
            return self.left.next();
        }
        return self.right.next();
    }
}

pub fn chain(left: it.Iterator, right: it.Iterator): it.Iterator {
    return ChainIterator(left, right);
}
