// RT_OS operations (see src/backend/vm/resource_types.hh).
pub const OP_ENV_GET: int = 49;
pub const OP_ENV_SET: int = 50;
pub const OP_ENV_UNSET: int = 51;
pub const OP_ENV_LIST: int = 52;
pub const OP_CWD: int = 53;
pub const OP_CHDIR: int = 54;
pub const OP_HOME_DIR: int = 55;
pub const OP_TEMP_DIR: int = 56;
pub const OP_EXE_PATH: int = 57;
pub const OP_OS_NAME: int = 58;
pub const OP_ARCH: int = 59;
pub const OP_HOSTNAME: int = 60;
