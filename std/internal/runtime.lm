// RT_PROCESS operations. Child processes reuse OP_SPAWN (9).
pub const OP_PROC_ARGS: int = 62;
pub const OP_PROC_EXIT: int = 63;
pub const OP_PROC_ID: int = 64;
pub const OP_PROC_RSS: int = 65;
pub const OP_PROC_PEAK_RSS: int = 66;
pub const OP_PROC_COMMAND: int = 67;

pub fn create_resource(kind: ResourceKind, args: any): int {
    return create(resource_kind_id(kind), args);
}

pub fn create(type_id: int, args: any): int {
    unsafe {
        return resource_create(type_id, args);
    }
}

pub fn call(handle: int, op_id: int, args: any): any {
    unsafe {
        return resource_call(handle, op_id, args);
    }
}

pub fn destroy(handle: int): nil {
    unsafe {
        resource_destroy(handle);
    }
}
