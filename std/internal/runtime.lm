// std/internal/runtime.lm
// Runtime submodule for std.internal. Internal runtime support and resource identifiers.

enum ResourceKind {
    File,
    Socket,
    Process,
    Stdout,
    Stderr,
    Memory,
    Entropy,
    DnsResolver,
    UdpSocket,
    WebSocket,
    HashEngine,
    Graphics,
    Os
}

pub fn resource_kind_id(k: ResourceKind): int {
    match (k) {
        ResourceKind.File => { return 0; },
        ResourceKind.Socket => { return 1; },
        ResourceKind.Process => { return 4; },
        ResourceKind.Stdout => { return 9; },
        ResourceKind.Stderr => { return 10; },
        ResourceKind.Memory => { return 11; },
        ResourceKind.Entropy => { return 12; },
        ResourceKind.DnsResolver => { return 13; },
        ResourceKind.UdpSocket => { return 14; },
        ResourceKind.WebSocket => { return 15; },
        ResourceKind.HashEngine => { return 16; },
        ResourceKind.Graphics => { return 17; },
        ResourceKind.Os => { return 18; }
    }
}

// This module provides thin wrappers around VM builtins.

pub const RT_FILE: int = 0;
pub const RT_SOCKET: int = 1;
pub const RT_PROCESS: int = 4;
pub const RT_STDOUT: int = 9;
pub const RT_STDERR: int = 10;
pub const RT_MEMORY: int = 11;
pub const RT_ENTROPY: int = 12;
pub const RT_DNS_RESOLVER: int = 13;
pub const RT_UDP_SOCKET: int = 14;
pub const RT_WEBSOCKET: int = 15;
pub const RT_HASH_ENGINE: int = 16;
pub const RT_GRAPHICS: int = 17;
pub const RT_OS: int = 18;

pub const OP_OPEN: int = 0;
pub const OP_CLOSE: int = 1;
pub const OP_READ: int = 2;
pub const OP_WRITE: int = 3;
pub const OP_CONNECT: int = 6;
pub const OP_DRAW_RECT: int = 7;
