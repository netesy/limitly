pub const OP_POLL: int = 10;
pub const OP_PUSH: int = 11;
pub const OP_POP: int = 12;
pub const OP_PUSH_CLIP: int = 11;
pub const OP_POP_CLIP: int = 12;
pub const OP_GET_STATE: int = 13;
pub const OP_SET_STATE: int = 14;
pub const OP_FILL: int = 16;
pub const OP_BIND: int = 23;
pub const OP_LISTEN: int = 24;
pub const OP_ACCEPT: int = 25;
pub const OP_RESOLVE: int = 26;
pub const OP_SEND_TO: int = 27;
pub const OP_RECV_FROM: int = 28;
pub const OP_FLUSH: int = 29;
pub const OP_MKDIR: int = 30;
pub const OP_READDIR: int = 31;
pub const OP_RENAME: int = 32;
pub const OP_EXISTS: int = 33;
pub const OP_DELETE: int = 34;
pub const OP_HMAC: int = 35;
pub const OP_DRAW_TRIANGLE: int = 36;
pub const OP_APPLY_PIPELINE: int = 37;
pub const OP_APPLY_BINDINGS: int = 38;
pub const OP_DRAW: int = 39;
pub const OP_MAKE_BUFFER: int = 40;
pub const OP_MAKE_IMAGE: int = 41;
pub const OP_MAKE_PIPELINE: int = 42;
pub const OP_MAKE_BINDINGS: int = 43;
pub const OP_END_PASS: int = 44;
