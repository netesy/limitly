// Standard Library Low-Level Graphics Abstraction (std.gg)
// Inspired by Sokol GFX: backend-independent, low-level graphics commands.
// Contains NO window management, OS event handling, or UI logic.

import std.resource as res;
import std.internal.runtime as rt;

pub frame Buffer {
    pub var id: int;
    pub var size: int;
}

pub frame Shader {
    pub var id: int;
}

pub frame Pipeline {
    pub var id: int;
}

pub frame PassAction {
    pub var r: float;
    pub var g: float;
    pub var b: float;
    pub var a: float;
}

// Low-Level Pass & Drawing API
pub fn begin_pass(win_handle: int, r: float, g: float, b: float, a: float) {
    rt.call(win_handle, rt.OP_CLEAR, [r, g, b, a]);
}

pub fn draw_rect(win_handle: int, x: int, y: int, w: int, h: int, r: float, g: float, b: float, a: float, filled: bool) {
    var f_val = 0;
    if (filled) { f_val = 1; }
    rt.call(win_handle, rt.OP_DRAW_RECT, [x, y, w, h, r, g, b, a, f_val]);
}

pub fn draw_text(win_handle: int, x: int, y: int, text: str, r: float, g: float, b: float, a: float) {
    rt.call(win_handle, rt.OP_DRAW_TEXT, [x, y, text, r, g, b, a]);
}

pub fn end_pass(win_handle: int) {
    // End pass hook
}

pub fn commit(win_handle: int) {
    rt.call(win_handle, rt.OP_PRESENT, []);
}

pub fn setup() {}
pub fn shutdown() {}
pub fn apply_bindings(v_id: int, i_id: int) {}
pub fn apply_pipeline(pip_id: int) {}
pub fn draw(base: int, count: int, instances: int) {}
pub fn make_buffer(data_ptr: int, data_size: int, index: bool): int { return 0; }
pub fn make_shader(vs: str, fs: str): int { return 0; }
pub fn make_pipeline(shd_id: int, primitive_type: int): int { return 0; }
