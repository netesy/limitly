// std/mime/types.lm
// Types submodule for std.mime. MIME type registry and content-type detection.

/// Key-value parameters associated with a MIME type (e.g., `charset=utf-8`).
frame Params {
    pub keys: [str];
    pub values: [str];

    pub init() {
        self.keys = [] as [str];
        self.values = [] as [str];
    }

    /// Retrieves a parameter value by case-sensitive key name.
    ///
    /// @param key Parameter key to look up.
    /// @return Associated value string, or empty string if not present.
    pub fn get(key: str): str {
        var i: int = 0;
        var length: int = len(self.keys);
        while (i < length) {
            if (self.keys[i] == key) {
                return self.values[i];
            }
            i = i + 1;
        }
        return "";
    }

    /// Sets or updates a parameter key-value pair.
    ///
    /// @param key Parameter name.
    /// @param value Parameter value.
    pub fn set(key: str, value: str) {
        contract(len(key) > 0, "key cannot be empty");
        var i: int = 0;
        var length: int = len(self.keys);
        var found: bool = false;
        while (i < length) {
            if (self.keys[i] == key) {
                self.values[i] = value;
                found = true;
            }
            i = i + 1;
        }
        if (not found) {
            self.keys.append(key);
            self.values.append(value);
        }
    }

    /// Checks if a parameter key exists in this collection.
    ///
    /// @param key Parameter name to check.
    /// @return `true` if key exists, `false` otherwise.
    pub fn has(key: str): bool {
        var i: int = 0;
        var length: int = len(self.keys);
        while (i < length) {
            if (self.keys[i] == key) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /// Appends a parameter pair without checking for duplicates.
    ///
    /// @param key Parameter name.
    /// @param value Parameter value.
    pub fn add(key: str, value: str) {
        contract(len(key) > 0, "key cannot be empty");
        self.keys.append(key);
        self.values.append(value);
    }

    /// Removes a parameter by key name if present.
    ///
    /// @param key Parameter name to remove.
    pub fn remove(key: str) {
        contract(len(key) > 0, "key cannot be empty");
        var new_keys: [str] = [] as [str];
        var new_values: [str] = [] as [str];
        var i: int = 0;
        var length: int = len(self.keys);
        while (i < length) {
            if (self.keys[i] != key) {
                new_keys.append(self.keys[i]);
                new_values.append(self.values[i]);
            }
            i = i + 1;
        }
        self.keys = new_keys;
        self.values = new_values;
    }

    /// Serializes parameters to a semicolon-delimited string (e.g. `; charset=utf-8`).
    ///
    /// @return Formatted parameter suffix string.
    pub fn to_string(): str {
        var result: str = "";
        var i: int = 0;
        var length: int = len(self.keys);
        while (i < length) {
            result = result + "; " + self.keys[i] + "=" + self.values[i];
            i = i + 1;
        }
        return result;
    }
}

/// Represents a parsed MIME media type with main type, subtype, and parameters.
frame Type {
    pub is_valid: bool;
    pub main_type: str;
    pub params: Params;
    pub subtype: str;

    pub init(m: str, s: str, p: Params, v: bool) {
        self.is_valid = v;
        self.main_type = m;
        self.params = p;
        self.subtype = s;
    }

    /// Serializes this MIME type back to standardized format (e.g. `"text/html; charset=utf-8"`).
    ///
    /// @return Formatted MIME type string, or empty string if invalid.
    pub fn to_string(): str {
        if (not self.is_valid) {
            return "";
        }
        return self.main_type + "/" + self.subtype + self.params.to_string();
    }

    /// Checks if this is a textual media type (`text/*`).
    ///
    /// @return `true` if main type is "text", `false` otherwise.
    pub fn is_text(): bool {
        return self.main_type == "text";
    }

    /// Checks if this is an image media type (`image/*`).
    ///
    /// @return `true` if main type is "image", `false` otherwise.
    pub fn is_image(): bool {
        return self.main_type == "image";
    }

    /// Checks if this is an audio media type (`audio/*`).
    ///
    /// @return `true` if main type is "audio", `false` otherwise.
    pub fn is_audio(): bool {
        return self.main_type == "audio";
    }

    /// Checks if this is a video media type (`video/*`).
    ///
    /// @return `true` if main type is "video", `false` otherwise.
    pub fn is_video(): bool {
        return self.main_type == "video";
    }

    /// Checks if this is an application media type (`application/*`).
    ///
    /// @return `true` if main type is "application", `false` otherwise.
    pub fn is_application(): bool {
        return self.main_type == "application";
    }
}

/// Parses a raw MIME / Content-Type string into structured `Type`.
///
/// @param mime_str Raw MIME string (e.g. `"text/html; charset=utf-8"`).
/// @return Parsed `Type` structure.
pub fn parse(mime_str: str): Type {
    contract(len(mime_str) >= 0, "mime_str must be a valid string");
    var s = trim(mime_str);
    if (s == "") {
        return Type("", "", Params(), false);
    }

    var parts = split_str(s, ";");
    var type_part = trim(parts[0]);

    var slash_idx = index_of(type_part, "/");
    if (slash_idx == -1) {
        return Type("", "", Params(), false);
    }

    var main_type = to_lower(trim(_builtin_substring(type_part, 0, slash_idx)));
    var subtype = to_lower(trim(_builtin_substring(type_part, slash_idx + 1, len(type_part))));

    if (main_type == "" or subtype == "") {
        return Type("", "", Params(), false);
    }

    var params = Params();
    var i = 1;
    while (i < len(parts)) {
        var param_part = trim(parts[i]);
        if (param_part != "") {
            var eq_idx = index_of(param_part, "=");
            if (eq_idx != -1) {
                var key = to_lower(trim(_builtin_substring(param_part, 0, eq_idx)));
                var val_str = trim(_builtin_substring(param_part, eq_idx + 1, len(param_part)));
                if (key != "") {
                    // Remove quotes if present
                    if (len(val_str) >= 2 and _builtin_substring(val_str, 0, 1) == "\"" and _builtin_substring(val_str, len(val_str) - 1, len(val_str)) == "\"") {
                        val_str = _builtin_substring(val_str, 1, len(val_str) - 1);
                    }
                    params.add(key, val_str);
                }
            }
        }
        i = i + 1;
    }

    return Type(main_type, subtype, params, true);
}

/// Maps a file extension to its corresponding MIME type.
///
/// @param ext File extension (e.g. `"html"` or `".png"`).
/// @return Matching MIME type string, or `"application/octet-stream"` if unknown.
pub fn extension_to_mime(ext: str): str {
    contract(len(ext) > 0, "ext cannot be empty");
    var clean_ext = to_lower(trim(ext));
    if (len(clean_ext) > 0 and _builtin_substring(clean_ext, 0, 1) == ".") {
        clean_ext = _builtin_substring(clean_ext, 1, len(clean_ext));
    }

    var extensions = [
    "html", "htm", "css", "js", "json", "xml", "csv", "txt",
    "png", "jpg", "jpeg", "gif", "webp", "svg", "bmp", "tiff", "ico",
    "mp3", "wav", "ogg", "mp4", "webm", "mpeg", "pdf", "zip", "gzip"
    ] as [str];

    var mime_types = [
    "text/html", "text/html", "text/css", "text/javascript", "application/json", "text/xml", "text/csv", "text/plain",
    "image/png", "image/jpeg", "image/jpeg", "image/gif", "image/webp", "image/svg+xml", "image/bmp", "image/tiff", "image/x-icon",
    "audio/mpeg", "audio/wav", "audio/ogg", "video/mp4", "video/webm", "video/mpeg", "application/pdf", "application/zip", "application/gzip"
    ] as [str];

    var i = 0;
    while (i < len(extensions)) {
        if (extensions[i] == clean_ext) {
            return mime_types[i];
        }
        i = i + 1;
    }

    return "application/octet-stream";
}

/// Maps a MIME type string to its canonical file extension (including leading dot).
///
/// @param mime_str MIME type string (e.g. `"text/html"`).
/// @return File extension starting with dot, or empty string if unknown.
pub fn mime_to_extension(mime_str: str): str {
    contract(len(mime_str) > 0, "mime_str cannot be empty");
    var parsed = parse(mime_str);
    if (not parsed.is_valid) {
        return "";
    }
    var clean_mime = parsed.main_type + "/" + parsed.subtype;

    var extensions = [
    "html", "css", "js", "json", "xml", "csv", "txt",
    "png", "jpg", "gif", "webp", "svg", "bmp", "tiff", "ico",
    "mp3", "wav", "ogg", "mp4", "webm", "mpeg", "pdf", "zip", "gzip"
    ] as [str];

    var mime_types = [
    "text/html", "text/css", "text/javascript", "application/json", "text/xml", "text/csv", "text/plain",
    "image/png", "image/jpeg", "image/gif", "image/webp", "image/svg+xml", "image/bmp", "image/tiff", "image/x-icon",
    "audio/mpeg", "audio/wav", "audio/ogg", "video/mp4", "video/webm", "video/mpeg", "application/pdf", "application/zip", "application/gzip"
    ] as [str];

    var i = 0;
    while (i < len(mime_types)) {
        if (mime_types[i] == clean_mime) {
            return "." + extensions[i];
        }
        i = i + 1;
    }

    return "";
}

// ---- Internal helpers ----

fn trim(s: str): str {
    var start = 0;
    while (start < len(s) and (_builtin_substring(s, start, start + 1) == " " or _builtin_substring(s, start, start + 1) == "\t" or _builtin_substring(s, start, start + 1) == "\n" or _builtin_substring(s, start, start + 1) == "\r")) {
        start = start + 1;
    }
    var end = len(s) - 1;
    while (end >= start and (_builtin_substring(s, end, end + 1) == " " or _builtin_substring(s, end, end + 1) == "\t" or _builtin_substring(s, end, end + 1) == "\n" or _builtin_substring(s, end, end + 1) == "\r")) {
        end = end - 1;
    }
    if (start > end) {
        return "";
    }
    return _builtin_substring(s, start, end + 1);
}

fn to_lower(s: str): str {
    var result: str = "";
    var i: int = 0;
    var alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    var lower_alphabet = "abcdefghijklmnopqrstuvwxyz";
    while (i < len(s)) {
        var ch: str = _builtin_substring(s, i, i + 1);
        var idx = index_of(alphabet, ch);
        if (idx != -1) {
            result = result + _builtin_substring(lower_alphabet, idx, idx + 1);
        } else {
            result = result + ch;
        }
        i = i + 1;
    }
    return result;
}

fn index_of(s: str, pattern: str): int {
    var i: int = 0;
    while (i <= len(s) - len(pattern)) {
        if (_builtin_substring(s, i, i + len(pattern)) == pattern) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn split_str(s: str, delimiter: str): [str] {
    var parts: [str] = [] as [str];
    var current: str = "";
    var i: int = 0;
    while (i < len(s)) {
        if (_builtin_substring(s, i, i + 1) == delimiter) {
            parts.append(current);
            current = "";
        } else {
            current = current + _builtin_substring(s, i, i + 1);
        }
        i = i + 1;
    }
    parts.append(current);
    return parts;
}
