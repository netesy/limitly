import std.mime.types as types;

pub import std.mime.types show MIMEType, MIMEParams;

pub fn MIMEType(m: str, s: str, p: any, v: bool): types.MIMEType {
    return types.MIMEType(m, s, p as types.MIMEParams, v);
}

pub fn MIMEParams(): types.MIMEParams {
    return types.MIMEParams();
}

pub fn parse(mime_str: str): types.MIMEType {
    return types.parse(mime_str);
}

pub fn extension_to_mime(ext: str): str {
    return types.extension_to_mime(ext);
}

pub fn mime_to_extension(mime_str: str): str {
    return types.mime_to_extension(mime_str);
}
