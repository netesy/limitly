import std.mime.types as types;

pub import std.mime.types show Type, Params;

pub fn Type(m: str, s: str, p: any, v: bool): types.Type {
    return types.Type(m, s, p as types.Params, v);
}

pub fn Params(): types.Params {
    return types.Params();
}

pub fn parse(mime_str: str): types.Type {
    return types.parse(mime_str);
}

pub fn extension_to_mime(ext: str): str {
    return types.extension_to_mime(ext);
}

pub fn mime_to_extension(mime_str: str): str {
    return types.mime_to_extension(mime_str);
}
