import std.collections.vector as vector;

frame ByteBuffer {
    pub var data: [int] = [];
    
    pub init(initial: [int] = []) {
        self.data = initial;
    }
    
    pub fn append(byte: int) {
        var vec = vector.Vector();
        vec.data = self.data;
        vec.push(byte % 256);
        self.data = vec.data;
    }
    
    pub fn append_all(bytes: [int]) {
        var vec = vector.Vector();
        vec.data = self.data;
        var i = 0;
        while (i < len(bytes)) {
            vec.push(bytes[i]);
            i = i + 1;
        }
        self.data = vec.data;
    }
    
    pub fn get(idx: int): int {
        return self.data[idx];
    }
    
    pub fn len(): int { return len(self.data); }
    
    pub fn to_hex(): str {
        var hex = "0123456789abcdef";
        var res = "";
        for (var i = 0; i < len(self.data); i = i + 1) {
            var b = self.data[i];
            res = res + substring(hex, (b / 16) % 16, (b / 16) % 16 + 1);
            res = res + substring(hex, b % 16, b % 16 + 1);
        }
        return res;
    }
}

fn encode_i32_be(value: int): [int] {
    return [
        (value >> 24) & 0xFF,
        (value >> 16) & 0xFF,
        (value >> 8) & 0xFF,
        value & 0xFF
    ];
}

fn encode_i32_le(value: int): [int] {
    return [
        value & 0xFF,
        (value >> 8) & 0xFF,
        (value >> 16) & 0xFF,
        (value >> 24) & 0xFF
    ];
}

fn decode_i32_be(bytes: [int]): int {
    return (bytes[0] << 24) | (bytes[1] << 16) | (bytes[2] << 8) | bytes[3];
}
