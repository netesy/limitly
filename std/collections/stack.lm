// Stack Frame - LIFO (Last In, First Out) implementation

import std.core as core;

frame Stack {
    pub data: [any];

    pub init() {
        self.data = [] as [any];
    }

    pub fn push(value: any) {
        self.data.append(value);
    }

    pub fn pop(): any {
        var n = len(self.data);
        if (n == 0) return nil;
        var value = self.data[n - 1];
        
        var new_data = [] as [any];
        var i = 0;
        while (i < n - 1) {
            new_data[i] = self.data[i];
            i = i + 1;
        }
        self.data = new_data;
        return value;
    }

    pub fn peek(): any {
        if (len(self.data) == 0) return nil;
        return self.data[len(self.data) - 1];
    }

    pub fn length(): int {
        return len(self.data);
    }

    pub fn len(): int {
        return self.length();
    }

    pub fn is_empty(): bool {
        return len(self.data) == 0;
    }

    pub fn clear() {
        self.data = [] as [any];
    }
}
