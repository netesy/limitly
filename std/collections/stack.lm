// Stack Frame - LIFO (Last In, First Out) implementation


staged frame Stack(T: type) {
    pub data: [T];

    pub init() {
        self.data = [];
    }

    pub fn push(value: T) {
        self.data[len(self.data)] = value;
    }

    pub fn pop(): T | nil {
        var n = len(self.data);
        if (n == 0) return nil;
        var value = self.data[n - 1];

        var new_data: [T] = [];
        var i = 0;
        while (i < n - 1) {
            new_data[i] = self.data[i];
            i = i + 1;
        }
        self.data = new_data;
        return value;
    }

    pub fn peek(): T | nil {
        if (len(self.data) == 0) return nil;
        return self.data[len(self.data) - 1];
    }

    pub fn length(): int {
        return len(self.data);
    }

    pub fn len(): int {
        return self.length();
    }

    pub fn is_empty(): bool {
        return len(self.data) == 0;
    }

    pub fn clear() {
        self.data = [];
    }
}
