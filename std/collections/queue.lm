// Standard Library Queue, PriorityQueue, Stack, and BitSet Collections
import std.collections.vector as vector;

pub frame Queue {
    var data: Deque;

    pub init() {
        self.data = vector.Deque();
    }

    pub fn enqueue(item: any) {
        self.data.push_back(item);
    }

    pub fn dequeue(): any {
        return self.data.pop_front();
    }

    pub fn peek(): any {
        return self.data.peek_front();
    }

    pub fn length(): int {
        return self.data.len();
    }

    pub fn len(): int {
        return self.length();
    }
}

pub frame PriorityQueue {
    pub var heap: vector.Vector;
    var comparator: any;

    pub init(comparator: any) {
        self.heap = vector.Vector();
        self.comparator = comparator;
    }

    fn _compare(left: any, right: any): int {
        if (self.comparator != nil) {
            var comp = self.comparator;
            return comp(left, right);
        }
        if (left < right) {
            return -1;
        }
        if (left > right) {
            return 1;
        }
        return 0;
    }

    pub fn insert(item: any) {
        self.push(item);
    }

    pub fn push(item: any) {
        self.heap.push(item);
        var current_len = self.heap.len();
        self._sift_up(current_len - 1);
    }

    pub fn peek(): any {
        if (self.heap.len() == 0) {
            return nil;
        }
        return self.heap.data[0];
    }

    pub fn remove(): any {
        return self.pop();
    }

    pub fn pop(): any {
        var n = self.heap.len();
        if (n == 0) {
            return nil;
        }
        var result = self.heap.data[0];
        self.heap.data[0] = self.heap.data[n - 1];
        self.heap.pop();
        if (self.heap.len() > 0) {
            self._sift_down(0);
        }
        return result;
    }

    pub fn len(): int {
        return self.heap.len();
    }

    pub fn length(): int {
        return self.len();
    }

    fn _sift_up(idx: int) {
        while (idx > 0) {
            var parent = (idx - 1) / 2;
            if (self._compare(self.heap.data[idx], self.heap.data[parent]) < 0) {
                var tmp = self.heap.data[idx];
                self.heap.data[idx] = self.heap.data[parent];
                self.heap.data[parent] = tmp;
                idx = parent;
            } else {
                return;
            }
        }
    }

    fn _sift_down(idx: int) {
        var n = self.heap.len();
        while (true) {
            var smallest = idx;
            var left = 2 * idx + 1;
            var right = 2 * idx + 2;
            if (left < n and self._compare(self.heap.data[left], self.heap.data[smallest]) < 0) {
                smallest = left;
            }
            if (right < n and self._compare(self.heap.data[right], self.heap.data[smallest]) < 0) {
                smallest = right;
            }
            if (smallest != idx) {
                var tmp = self.heap.data[idx];
                self.heap.data[idx] = self.heap.data[smallest];
                self.heap.data[smallest] = tmp;
                idx = smallest;
            } else {
                return;
            }
        }
    }
}

pub frame Stack {
    var data: Vector;

    pub init() {
        self.data = vector.Vector();
    }

    pub fn push(item: any) {
        self.data.push(item);
    }

    pub fn pop(): any {
        return self.data.pop();
    }

    pub fn peek(): any {
        return self.data.peek();
    }

    pub fn len(): int {
        return self.data.len();
    }

    pub fn length(): int {
        return self.len();
    }
}

pub frame BitSet {
    pub var words: [int];
    var size: int;

    pub init(size: int = 64) {
        self.words = [] as [int];
        self.size = size;
        if (self.size < 1) {
            self.size = 1;
        }
        var word_count = (self.size + 63) / 64;
        var i = 0;
        while (i < word_count) {
            self.words.append(0);
            i = i + 1;
        }
    }

    fn _mask(bit: int): int {
        return 1 << (bit % 64);
    }

    fn _valid(bit: int): bool {
        return bit >= 0 and bit < self.size;
    }

    pub fn set(bit: int) {
        if (self._valid(bit)) {
            var word = bit / 64;
            self.words[word] = self.words[word] | self._mask(bit);
        }
    }

    pub fn unset(bit: int) {
        if (self.contains(bit)) {
            var word = bit / 64;
            self.words[word] = self.words[word] ^ self._mask(bit);
        }
    }

    pub fn toggle(bit: int) {
        if (self._valid(bit)) {
            var word = bit / 64;
            self.words[word] = self.words[word] ^ self._mask(bit);
        }
    }

    pub fn contains(bit: int): bool {
        if (not self._valid(bit)) {
            return false;
        }
        var word = bit / 64;
        return (self.words[word] & self._mask(bit)) != 0;
    }

    pub fn get(bit: int): bool {
        return self.contains(bit);
    }

    pub fn count(): int {
        var total = 0;
        var bit = 0;
        while (bit < self.size) {
            if (self.contains(bit)) {
                total = total + 1;
            }
            bit = bit + 1;
        }
        return total;
    }

    pub fn get_size(): int {
        return self.size;
    }

    pub fn iterator(): BitSetIterator {
        return BitSetIterator(bitset=self, current=0);
    }
}

pub frame BitSetIterator {
    var bitset: BitSet;
    var current: int;

    pub fn next(): any {
        while (self.current < self.bitset.get_size()) {
            if (self.bitset.contains(self.current)) {
                var result = self.current;
                self.current = self.current + 1;
                return result;
            }
            self.current = self.current + 1;
        }
        return nil;
    }
}
