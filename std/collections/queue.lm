// Standard Library Queue Collection
pub import std.collections.stack show Stack;
pub import std.collections.bitset show BitSet, BitSetIterator;

frame Queue {
    pub items: [any];

    pub init() {
        self.items = [];
    }

    pub fn enqueue(item: any) {
        self.items.append(item);
    }

    pub fn dequeue(): any {
        if (len(self.items) == 0) {
            return nil;
        }
        var first = self.items[0];
        self.items = _builtin_list_slice(self.items, 1, len(self.items));
        return first;
    }

    pub fn peek(): any {
        if (len(self.items) == 0) {
            return nil;
        }
        return self.items[0];
    }

    pub fn length(): int {
        return len(self.items);
    }

    pub fn len(): int {
        return len(self.items);
    }

    pub fn is_empty(): bool {
        return len(self.items) == 0;
    }

    pub fn clear() {
        self.items = [];
    }
}
