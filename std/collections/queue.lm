// Standard Library Queue Collection
pub import std.collections.stack show Stack;
pub import std.collections.bitset show BitSet, BitSetIterator;

frame Queue {
    pub items: [any];

    pub init() {
        self.items = [];
    }

    pub fn enqueue(item: any) {
        self.items.append(item);
    }

    pub fn dequeue(): any {
        if (len(self.items) == 0) {
            return nil;
        }
        var first = self.items[0];
        var new_items: [any] = [];
        var i = 1;
        while (i < len(self.items)) {
            new_items.append(self.items[i]);
            i = i + 1;
        }
        self.items = new_items;
        return first;
    }

    pub fn peek(): any {
        if (len(self.items) == 0) {
            return nil;
        }
        return self.items[0];
    }

    pub fn length(): int {
        return len(self.items);
    }

    pub fn len(): int {
        return len(self.items);
    }

    pub fn is_empty(): bool {
        return len(self.items) == 0;
    }

    pub fn clear() {
        self.items = [];
    }
}
