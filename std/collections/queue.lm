// Standard Library Queue Collection

staged frame Queue(T: type) {
    pub items: [T];

    pub init() {
        self.items = [];
    }

    pub fn enqueue(item: T) {
        self.items[len(self.items)] = item;
    }

    pub fn dequeue(): T | nil {
        if (len(self.items) == 0) {
            return nil;
        }
        var first = self.items[0];
        var n = len(self.items);
        var rest: [T] = [];
        var i = 1;
        while (i < n) {
            rest[i - 1] = self.items[i];
            i = i + 1;
        }
        self.items = rest;
        return first;
    }

    pub fn peek(): T | nil {
        if (len(self.items) == 0) {
            return nil;
        }
        return self.items[0];
    }

    pub fn length(): int {
        return len(self.items);
    }

    pub fn len(): int {
        return len(self.items);
    }

    pub fn is_empty(): bool {
        return len(self.items) == 0;
    }

    pub fn clear() {
        self.items = [];
    }
}
