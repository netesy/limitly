// Standard Library Queue & PriorityQueue Collections
import std.collections.vector as vec;

frame Queue {
    var data: vec.Deque;
    
    pub init() {
        this.data = vec.Deque();
    }
    
    pub fn enqueue(item: any) {
        this.data.push_back(item);
    }
    
    pub fn dequeue(): any {
        return this.data.pop_front();
    }
    
    pub fn peek(): any {
        return this.data.peek_front();
    }
    
    pub fn len(): int { return this.data.len(); }
}

frame PriorityQueue {
    var heap: [any];
    
    pub init() {
        this.heap = [];
    }
    
    pub fn push(item: any) {
        this.heap = this.heap + [item];
        this._sift_up(len(this.heap) - 1);
    }
    
    pub fn pop(): any {
        var n = len(this.heap);
        if (n == 0) return nil;
        var res = this.heap[0];
        this.heap[0] = this.heap[n-1];
        // Shrink heap... slow in pure limit currently
        var next_heap = [];
        for (var i = 0; i < n - 1; i = i + 1) next_heap = next_heap + [this.heap[i]];
        this.heap = next_heap;
        if (len(this.heap) > 0) this._sift_down(0);
        return res;
    }
    
    pub fn len(): int { return len(this.heap); }
    
    private fn _sift_up(idx: int) {
        while (idx > 0) {
            var parent = (idx - 1) / 2;
            if (this.heap[idx] < this.heap[parent]) {
                var tmp = this.heap[idx];
                this.heap[idx] = this.heap[parent];
                this.heap[parent] = tmp;
                idx = parent;
            } else break;
        }
    }
    
    private fn _sift_down(idx: int) {
        var n = len(this.heap);
        while (true) {
            var smallest = idx;
            var l = 2 * idx + 1;
            var r = 2 * idx + 2;
            if (l < n and this.heap[l] < this.heap[smallest]) smallest = l;
            if (r < n and this.heap[r] < this.heap[smallest]) smallest = r;
            if (smallest != idx) {
                var tmp = this.heap[idx];
                this.heap[idx] = this.heap[smallest];
                this.heap[smallest] = tmp;
                idx = smallest;
            } else break;
        }
    }
}

frame Stack {
    var data: vec.Vector;
    
    pub init() {
        this.data = vec.Vector();
    }
    
    pub fn push(item: any) {
        this.data.push(item);
    }
    
    pub fn pop(): any {
        return this.data.pop();
    }

    pub fn peek(): any {
        return this.data.peek();
    }
    
    pub fn len(): int { return this.data.len(); }
}

frame BitSet {
    var bits: [int];
    
    pub init(size: int = 64) {
        this.bits = [];
        var words = (size + 63) / 64;
        for (var i = 0; i < words; i = i + 1) this.bits = this.bits + [0];
    }
    
    pub fn set(bit: int) {
        var word = bit / 64;
        var pos = bit % 64;
        if (word < len(this.bits)) {
            // Need bitwise OR
            // this.bits[word] = this.bits[word] | (1 << pos);
            // Placeholder:
            this.bits[word] = 1; 
        }
    }
    
    pub fn get(bit: int): bool {
        var word = bit / 64;
        var pos = bit % 64;
        if (word < len(this.bits)) {
            // return (this.bits[word] & (1 << pos)) != 0;
            return this.bits[word] != 0;
        }
        return false;
    }
}
