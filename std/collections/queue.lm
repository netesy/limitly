// Standard Library Queue, PriorityQueue, Stack, and BitSet Collections
import std.collections.vector as vector;

pub frame Queue {
    var data: Deque;

    pub init() {
        self.data = vector.Deque();
    }

    pub fn enqueue(item: any) {
        self.data.push_back(item);
    }

    pub fn dequeue(): any {
        return self.data.pop_front();
    }

    pub fn peek(): any {
        return self.data.peek_front();
    }

    pub fn length(): int {
        return self.data.len();
    }

    pub fn len(): int {
        return self.length();
    }
}

pub frame PriorityQueue {
    pub var heap: vector.Vector;
    var comparator: any;

    pub init(comparator: any) {
        self.heap = vector.Vector();
        self.comparator = comparator;
    }

    fn _compare(left: any, right: any): int {
        if (self.comparator != nil) {
            var comp = self.comparator;
            return comp(left, right);
        }
        if (left < right) {
            return -1;
        }
        if (left > right) {
            return 1;
        }
        return 0;
    }

    pub fn insert(item: any) {
        self.push(item);
    }

    pub fn push(item: any) {
        self.heap.push(item);
        var current_len = self.heap.len();
        self._sift_up(current_len - 1);
    }

    pub fn peek(): any {
        if (self.heap.len() == 0) {
            return nil;
        }
        return self.heap.data[0];
    }

    pub fn remove(): any {
        return self.pop();
    }

    pub fn pop(): any {
        var n = self.heap.len();
        if (n == 0) {
            return nil;
        }
        var result = self.heap.data[0];
        self.heap.data[0] = self.heap.data[n - 1];
        self.heap.pop();
        if (self.heap.len() > 0) {
            self._sift_down(0);
        }
        return result;
    }

    pub fn len(): int {
        return self.heap.len();
    }

    pub fn length(): int {
        return self.len();
    }

    fn _sift_up(idx: int) {
        while (idx > 0) {
            var parent = (idx - 1) / 2;
            if (self._compare(self.heap.data[idx], self.heap.data[parent]) < 0) {
                var tmp = self.heap.data[idx];
                self.heap.data[idx] = self.heap.data[parent];
                self.heap.data[parent] = tmp;
                idx = parent;
            } else {
                return;
            }
        }
    }

    fn _sift_down(idx: int) {
        var n = self.heap.len();
        while (true) {
            var smallest = idx;
            var left = 2 * idx + 1;
            var right = 2 * idx + 2;
            if (left < n and self._compare(self.heap.data[left], self.heap.data[smallest]) < 0) {
                smallest = left;
            }
            if (right < n and self._compare(self.heap.data[right], self.heap.data[smallest]) < 0) {
                smallest = right;
            }
            if (smallest != idx) {
                var tmp = self.heap.data[idx];
                self.heap.data[idx] = self.heap.data[smallest];
                self.heap.data[smallest] = tmp;
                idx = smallest;
            } else {
                return;
            }
        }
    }
}

pub frame Stack {
    var data: Vector;

    pub init() {
        self.data = vector.Vector();
    }

    pub fn push(item: any) {
        self.data.push(item);
    }

    pub fn pop(): any {
        return self.data.pop();
    }

    pub fn peek(): any {
        return self.data.peek();
    }

    pub fn len(): int {
        return self.data.len();
    }

    pub fn length(): int {
        return self.len();
    }
}

pub frame BitSet {
    var w0: int;
    var w1: int;
    var w2: int;
    var w3: int;
    var size: int;
    var used: int;

    pub init(size: int = 64) {
        self.w0 = 0; self.w1 = 0; self.w2 = 0; self.w3 = 0; self.used = 0;
        self.size = size;
        if (self.size < 1) { self.size = 1; }
    }

    fn _mask(bit: int): int {
        var offset = bit % 64; var mask = 1; var i = 0;
        while (i < offset) { mask = mask * 2; i = i + 1; }
        return mask;
    }

    fn _valid(bit: int): bool { return bit >= 0 and bit < self.size; }

    fn _word_value(word: int): int {
        if (word == 0) return self.w0; if (word == 1) return self.w1; if (word == 2) return self.w2; return self.w3;
    }

    fn _set_word(word: int, value: int) {
        if (word == 0) { self.w0 = value; } elif (word == 1) { self.w1 = value; } elif (word == 2) { self.w2 = value; } else { self.w3 = value; }
    }

    pub fn set(bit: int) {
        if (self._valid(bit) and not self.contains(bit)) {
            var word = bit / 64; self._set_word(word, self._word_value(word) + self._mask(bit));
            self.used = self.used + 1;
        }
    }

    pub fn unset(bit: int) {
        if (self.contains(bit)) {
            var word = bit / 64; self._set_word(word, self._word_value(word) - self._mask(bit));
            self.used = self.used - 1;
        }
    }

    pub fn toggle(bit: int) {
        if (self.contains(bit)) { self.unset(bit); } elif (self._valid(bit)) { var word = bit / 64; self._set_word(word, self._word_value(word) + self._mask(bit)); self.used = self.used + 1; }
    }

    pub fn contains(bit: int): bool {
        if (not self._valid(bit)) { return false; }
        var word = bit / 64; var mask = self._mask(bit);
        return ((self._word_value(word) / mask) % 2) == 1;
    }

    pub fn get(bit: int): bool { return self.contains(bit); }

    pub fn count(): int { return self.used; }

    pub fn get_size(): int { return self.size; }

    pub fn iterator(): BitSetIterator { return BitSetIterator(bitset=self, current=0, yielded=0); }
}
pub frame BitSetIterator {
    var bitset: BitSet;
    var current: int;
    var yielded: int;

    pub fn next(): any {
        if (self.yielded >= self.bitset.count()) {
            return nil;
        }
        while (self.current < self.bitset.get_size()) {
            if (self.bitset.contains(self.current)) {
                var result = self.current;
                self.current = self.current + 1;
                self.yielded = self.yielded + 1;
                return result;
            }
            self.current = self.current + 1;
        }
        return nil;
    }
}
