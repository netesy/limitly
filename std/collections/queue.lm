// Standard Library Queue & PriorityQueue Collections
import std.collections.vector as vec;

frame Queue {
    var data: vec.Deque;
    
    pub init() {
        self.data = vec.Deque();
    }
    
    pub fn enqueue(item: any) {
        self.data.push_back(item);
    }
    
    pub fn dequeue(): any {
        return self.data.pop_front();
    }
    
    pub fn peek(): any {
        return self.data.peek_front();
    }
    
    pub fn len(): int { return self.data.len(); }
}

frame PriorityQueue {
    pub var heap: [any];
    
    pub init() {
        self.heap = [];
    }
    
    pub fn push(item: any) {
        self.heap = self.heap + [item];
        self._sift_up(len(self.heap) - 1);
    }
    
    pub fn pop(): any {
        var n = len(self.heap);
        if (n == 0) return nil;
        var res = self.heap[0];
        self.heap[0] = self.heap[n-1];
        // Shrink heap... slow in pure limit currently
        var next_heap = [];
        for (var i = 0; i < n - 1; i = i + 1) next_heap = next_heap + [self.heap[i]];
        self.heap = next_heap;
        if (len(self.heap) > 0) self._sift_down(0);
        return res;
    }
    
    pub fn len(): int { return len(self.heap); }
    
    fn _sift_up(idx: int) {
        while (idx > 0) {
            var parent = (idx - 1) / 2;
            if (self.heap[idx] < self.heap[parent]) {
                var tmp = self.heap[idx];
                self.heap[idx] = self.heap[parent];
                self.heap[parent] = tmp;
                idx = parent;
            } else break;
        }
    }
    
    fn _sift_down(idx: int) {
        var n = len(self.heap);
        while (true) {
            var smallest = idx;
            var l = 2 * idx + 1;
            var r = 2 * idx + 2;
            if (l < n and self.heap[l] < self.heap[smallest]) smallest = l;
            if (r < n and self.heap[r] < self.heap[smallest]) smallest = r;
            if (smallest != idx) {
                var tmp = self.heap[idx];
                self.heap[idx] = self.heap[smallest];
                self.heap[smallest] = tmp;
                idx = smallest;
            } else break;
        }
    }
}

frame Stack {
    var data: vec.Vector;
    
    pub init() {
        self.data = vec.Vector();
    }
    
    pub fn push(item: any) {
        self.data.push(item);
    }
    
    pub fn pop(): any {
        return self.data.pop();
    }

    pub fn peek(): any {
        return self.data.peek();
    }
    
    pub fn len(): int { return self.data.len(); }
}

frame BitSet {
    pub var bits: [int];
    
    pub init(size: int = 64) {
        self.bits = [];
        var words = (size + 63) / 64;
        for (var i = 0; i < words; i = i + 1) self.bits = self.bits + [0];
    }
    
    pub fn set(bit: int) {
        var word = bit / 64;
        var pos = bit % 64;
        if (word < len(self.bits)) {
            // Need bitwise OR
            // self.bits[word] = self.bits[word] | (1 << pos);
            // Placeholder:
            self.bits[word] = 1; 
        }
    }
    
    pub fn get(bit: int): bool {
        var word = bit / 64;
        var pos = bit % 64;
        if (word < len(self.bits)) {
            // return (self.bits[word] & (1 << pos)) != 0;
            return self.bits[word] != 0;
        }
        return false;
    }
}
