// Standard Library Deque Collection

import std.collections.vector as vector;

frame DoubleEndedQueue {
    pub impl: vector.Deque;

    pub init() {
        self.impl = vector.Deque();
    }

    pub fn push_back(item: any): DoubleEndedQueue {
        self.impl.push_back(item);
        return self;
    }

    pub fn push_front(item: any): DoubleEndedQueue {
        self.impl.push_front(item);
        return self;
    }

    pub fn pop_back(): any {
        return self.impl.pop_back();
    }

    pub fn pop_front(): any {
        return self.impl.pop_front();
    }

    pub fn peek_back(): any {
        return self.impl.peek_back();
    }

    pub fn peek_front(): any {
        return self.impl.peek_front();
    }

    pub fn length(): int {
        return self.impl.length();
    }

    pub fn is_empty(): bool {
        return (self.length() == 0);
    }

    pub fn clear(): nil {
        self.impl = vector.Deque();
    }
}

pub fn Deque(): DoubleEndedQueue {
    return DoubleEndedQueue();
}
