// Standard Library Deque Collection

frame Deque {
    pub var data: [any];

    pub init() {
        self.data = [];
    }

    pub fn push_back(item: any): Deque {
        self.data.append(item);
        return self;
    }

    pub fn push_front(item: any): Deque {
        var new_data: [any] = [];
        new_data.append(item);
        var i = 0;
        while (i < len(self.data)) {
            new_data.append(self.data[i]);
            i = i + 1;
        }
        self.data = new_data;
        return self;
    }

    pub fn peek_back(): any {
        var n = len(self.data);
        if (n == 0) {
            return nil;
        }
        return self.data[n - 1];
    }

    pub fn peek_front(): any {
        if (len(self.data) == 0) {
            return nil;
        }
        return self.data[0];
    }

    pub fn pop_back(): any {
        var n = len(self.data);
        if (n == 0) {
            return nil;
        }
        var item = self.data[n - 1];
        var new_data: [any] = [];
        var i = 0;
        while (i < n - 1) {
            new_data.append(self.data[i]);
            i = i + 1;
        }
        self.data = new_data;
        return item;
    }

    pub fn pop_front(): any {
        if (len(self.data) == 0) {
            return nil;
        }
        var item = self.data[0];
        var new_data: [any] = [];
        var i = 1;
        while (i < len(self.data)) {
            new_data.append(self.data[i]);
            i = i + 1;
        }
        self.data = new_data;
        return item;
    }

    pub fn length(): int {
        return len(self.data);
    }

    pub fn len(): int {
        return len(self.data);
    }

    pub fn is_empty(): bool {
        return len(self.data) == 0;
    }

    pub fn clear() {
        self.data = [];
    }
}

pub type DoubleEndedQueue = Deque;

pub fn DoubleEndedQueue(): Deque {
    return Deque();
}
