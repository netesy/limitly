// Standard Library TreeMap & TreeSet Collection

frame AVLNode {
    pub key: any;
    pub value: any;
    pub left: any;
    pub right: any;

    pub init(key: any, value: any) {
        self.key = key;
        self.value = value;
        self.left = nil;
        self.right = nil;
    }
}

frame TreeMap {
    pub root: any;
    pub size: int;

    pub init() {
        self.root = nil;
        self.size = 0;
    }

    pub fn put(key: any, value: any) {
        if (self.root == nil) {
            self.root = AVLNode(key, value);
            self.size = 1;
            return;
        }

        var curr = self.root;
        while (curr != nil) {
            var n = curr as AVLNode;
            if (key == n.key) {
                n.value = value;
                return;
            } elif (key < n.key) {
                if (n.left == nil) {
                    n.left = AVLNode(key, value);
                    self.size = self.size + 1;
                    return;
                }
                curr = n.left;
            } else {
                if (n.right == nil) {
                    n.right = AVLNode(key, value);
                    self.size = self.size + 1;
                    return;
                }
                curr = n.right;
            }
        }
    }

    pub fn get(key: any): any {
        var curr = self.root;
        while (curr != nil) {
            var n = curr as AVLNode;
            if (key == n.key) return n.value;
            if (key < n.key) curr = n.left;
            else curr = n.right;
        }
        return nil;
    }

    pub fn contains(key: any): bool {
        return self.get(key) != nil;
    }

    pub fn remove(key: any): bool {
        if (self.root == nil) return false;

        var parent: any = nil;
        var curr = self.root;
        var is_left_child = false;
        var found = false;

        while (curr != nil and not found) {
            var n = curr as AVLNode;
            if (key == n.key) {
                found = true;
            } else {
                parent = curr;
                if (key < n.key) {
                    is_left_child = true;
                    curr = n.left;
                } else {
                    is_left_child = false;
                    curr = n.right;
                }
            }
        }

        if (curr == nil or not found) return false;

        var target = curr as AVLNode;
        // Case 1: Leaf node
        if (target.left == nil and target.right == nil) {
            if (parent == nil) self.root = nil;
            elif (is_left_child) (parent as AVLNode).left = nil;
            else (parent as AVLNode).right = nil;
        }
        // Case 2: One child (right)
        elif (target.left == nil) {
            if (parent == nil) self.root = target.right;
            elif (is_left_child) (parent as AVLNode).left = target.right;
            else (parent as AVLNode).right = target.right;
        }
        // Case 2: One child (left)
        elif (target.right == nil) {
            if (parent == nil) self.root = target.left;
            elif (is_left_child) (parent as AVLNode).left = target.left;
            else (parent as AVLNode).right = target.left;
        }
        // Case 3: Two children
        else {
            var succ_parent = curr;
            var succ = target.right;
            while ((succ as AVLNode).left != nil) {
                succ_parent = succ;
                succ = (succ as AVLNode).left;
            }
            var succ_node = succ as AVLNode;
            target.key = succ_node.key;
            target.value = succ_node.value;
            if (succ_parent == curr) (succ_parent as AVLNode).right = succ_node.right;
            else (succ_parent as AVLNode).left = succ_node.right;
        }

        self.size = self.size - 1;
        return true;
    }

    pub fn len(): int { return self.size; }
    pub fn length(): int { return self.size; }
}

frame TreeSet {
    pub map: TreeMap;

    pub init() {
        self.map = TreeMap();
    }

    pub fn add(item: any) {
        self.map.put(item, true);
    }

    pub fn contains(item: any): bool {
        return self.map.get(item) != nil;
    }

    pub fn remove(item: any): bool {
        return self.map.remove(item);
    }

    pub fn len(): int { return self.map.len(); }
    pub fn length(): int { return self.map.length(); }
}

frame BTree {
    pub map: TreeMap;
    pub order: int;

    pub init(order: int = 3) {
        self.map = TreeMap();
        self.order = order;
    }

    pub fn put(key: any, value: any) { self.map.put(key, value); }
    pub fn get(key: any): any { return self.map.get(key); }
    pub fn remove(key: any): bool { return self.map.remove(key); }
    pub fn len(): int { return self.map.len(); }
    pub fn length(): int { return self.map.length(); }
}
