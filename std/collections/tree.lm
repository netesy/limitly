// Standard Library TreeMap (AVL Tree implementation)

frame AVLNode {
    pub key: any;
    pub value: any;
    pub left: any;  // AVLNode?
    pub right: any; // AVLNode?
    pub height: int;
    
    pub init(key: any, value: any) {
        self.key = key;
        self.value = value;
        self.left = nil;
        self.right = nil;
        self.height = 1;
    }
}

frame TreeMap {
    pub root: any; // AVLNode?
    pub size: int;
    
    pub init() {
        self.root = nil;
        self.size = 0;
    }
    
    pub fn put(key: any, value: any) {
        self.root = self._insert(self.root, key, value);
    }
    
    pub fn get(key: any): any {
        var curr = self.root;
        while (curr != nil) {
            var n = curr as AVLNode;
            if (key == n.key) return n.value;
            if (key < n.key) curr = n.left;
            else curr = n.right;
        }
        return nil;
    }
    
    pub fn len(): int { return self.size; }
    pub fn length(): int { return self.size; }
    
    fn _get_height(node: any): int {
        if (node == nil) return 0;
        var n = node as AVLNode;
        return n.height;
    }
    
    fn _get_balance(node: any): int {
        if (node == nil) return 0;
        var n = node as AVLNode;
        return self._get_height(n.left) - self._get_height(n.right);
    }
    
    fn _update_height(node: any) {
        var n = node as AVLNode;
        var hl = self._get_height(n.left);
        var hr = self._get_height(n.right);
        if (hl > hr) n.height = hl + 1;
        else n.height = hr + 1;
    }
    
    fn _rotate_right(y: any): any {
        var y_node = y as AVLNode;
        var x = y_node.left;
        var x_node = x as AVLNode;
        var T2 = x_node.right;
        x_node.right = y_node;
        y_node.left = T2;
        self._update_height(y_node);
        self._update_height(x_node);
        return x;
    }
    
    fn _rotate_left(x: any): any {
        var x_node = x as AVLNode;
        var y = x_node.right;
        var y_node = y as AVLNode;
        var T2 = y_node.left;
        y_node.left = x_node;
        x_node.right = T2;
        self._update_height(x_node);
        self._update_height(y_node);
        return y;
    }
    
    fn _insert(node: any, key: any, value: any): any {
        if (node == nil) {
            self.size = self.size + 1;
            return AVLNode(key, value);
        }
        
        var n = node as AVLNode;
        if (key < n.key) {
            n.left = self._insert(n.left, key, value);
        } else if (key > n.key) {
            n.right = self._insert(n.right, key, value);
        } else {
            n.value = value;
            return n;
        }
        
        self._update_height(n);
        var balance = self._get_balance(n);
        
        // Left Left Case
        if (balance > 1) {
            var n_left = n.left as AVLNode;
            if (key < n_left.key) return self._rotate_right(n);
        }
        
        // Right Right Case
        if (balance < -1) {
            var n_right = n.right as AVLNode;
            if (key > n_right.key) return self._rotate_left(n);
        }
        
        // Left Right Case
        if (balance > 1) {
            var n_left = n.left as AVLNode;
            if (key > n_left.key) {
                n.left = self._rotate_left(n.left);
                return self._rotate_right(n);
            }
        }
        
        // Right Left Case
        if (balance < -1) {
            var n_right = n.right as AVLNode;
            if (key < n_right.key) {
                n.right = self._rotate_right(n.right);
                return self._rotate_left(n);
            }
        }
        
        return n;
    }
}

frame TreeSet {
    pub map: TreeMap;
    
    pub init() {
        self.map = TreeMap();
    }
    
    pub fn add(item: any) {
        self.map.put(item, true);
    }
    
    pub fn contains(item: any): bool {
        return self.map.get(item) != nil;
    }
    
    pub fn len(): int { return self.map.len(); }
    pub fn length(): int { return self.map.length(); }
}

frame BTree {
    pub map: TreeMap;
    pub init() { self.map = TreeMap(); }
    pub fn put(key: any, value: any) { self.map.put(key, value); }
    pub fn get(key: any): any { return self.map.get(key); }
    pub fn len(): int { return self.map.len(); }
    pub fn length(): int { return self.map.length(); }
}
