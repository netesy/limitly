// Standard Library TreeMap (AVL Tree implementation)

frame AVLNode {
    pub var key: any;
    pub var value: any;
    pub var left: any;  // AVLNode?
    pub var right: any; // AVLNode?
    pub var height: int;
    
    pub init(key: any, value: any) {
        self.key = key;
        self.value = value;
        self.left = nil;
        self.right = nil;
        self.height = 1;
    }
}

frame TreeMap {
    var root: any; // AVLNode?
    var size: int;
    
    pub init() {
        self.root = nil;
        self.size = 0;
    }
    
    pub fn put(key: any, value: any) {
        self.root = self._insert(self.root, key, value);
    }
    
    pub fn get(key: any): any {
        var curr = self.root;
        while (curr != nil) {
            if (key == curr.key) return curr.value;
            if (key < curr.key) curr = curr.left;
            else curr = curr.right;
        }
        return nil;
    }
    
    pub fn len(): int { return self.size; }
    
    fn _get_height(node: any): int {
        if (node == nil) return 0;
        return node.height;
    }
    
    fn _get_balance(node: any): int {
        if (node == nil) return 0;
        return self._get_height(node.left) - self._get_height(node.right);
    }
    
    fn _update_height(node: any) {
        var hl = self._get_height(node.left);
        var hr = self._get_height(node.right);
        if (hl > hr) node.height = hl + 1;
        else node.height = hr + 1;
    }
    
    fn _rotate_right(y: any): any {
        var x = y.left;
        var T2 = x.right;
        x.right = y;
        y.left = T2;
        self._update_height(y);
        self._update_height(x);
        return x;
    }
    
    fn _rotate_left(x: any): any {
        var y = x.right;
        var T2 = y.left;
        y.left = x;
        x.right = T2;
        self._update_height(x);
        self._update_height(y);
        return y;
    }
    
    fn _insert(node: any, key: any, value: any): any {
        if (node == nil) {
            self.size = self.size + 1;
            return AVLNode(key, value);
        }
        
        if (key < node.key) {
            node.left = self._insert(node.left, key, value);
        } else if (key > node.key) {
            node.right = self._insert(node.right, key, value);
        } else {
            node.value = value;
            return node;
        }
        
        self._update_height(node);
        var balance = self._get_balance(node);
        
        // Left Left Case
        if (balance > 1 and key < node.left.key) return self._rotate_right(node);
        
        // Right Right Case
        if (balance < -1 and key > node.right.key) return self._rotate_left(node);
        
        // Left Right Case
        if (balance > 1 and key > node.left.key) {
            node.left = self._rotate_left(node.left);
            return self._rotate_right(node);
        }
        
        // Right Left Case
        if (balance < -1 and key < node.right.key) {
            node.right = self._rotate_right(node.right);
            return self._rotate_left(node);
        }
        
        return node;
    }
}

frame TreeSet {
    var map: TreeMap;
    
    pub init() {
        self.map = TreeMap();
    }
    
    pub fn add(item: any) {
        self.map.put(item, true);
    }
    
    pub fn contains(item: any): bool {
        return self.map.get(item) != nil;
    }
    
    pub fn len(): int { return self.map.len(); }
}

frame BTree {
    var map: TreeMap;
    pub init() { self.map = TreeMap(); }
    pub fn put(key: any, value: any) { self.map.put(key, value); }
    pub fn get(key: any): any { return self.map.get(key); }
    pub fn len(): int { return self.map.len(); }
}
