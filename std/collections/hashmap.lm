// HashMap Frame - $O(1)$ amortized bucket hash table

import std.core as core;

frame HashEntry {
    pub key: str;
    pub value: any;

    pub init(k: str, v: any) {
        self.key = k;
        self.value = v;
    }
}

frame HashMap {
    pub buckets: [[HashEntry]];
    pub capacity: int;
    pub count: int;

    pub init(initial_cap: int = 16) {
        self.capacity = initial_cap;
        self.count = 0;
        self.buckets = [] as [[HashEntry]];
        var i = 0;
        while (i < self.capacity) {
            self.buckets.append([] as [HashEntry]);
            i = i + 1;
        }
    }

    fn _hash(key: str): int {
        var h = 5381;
        var i = 0;
        while (i < len(key)) {
            var ch = substring(key, i, i + 1);
            h = ((h * 33) + (ch as int)) % 2147483647;
            i = i + 1;
        }
        if (h < 0) h = 0 - h;
        return h % self.capacity;
    }

    pub fn put(key: str, value: any): HashMap {
        var idx = self._hash(key);
        var bucket = self.buckets[idx];
        var i = 0;
        while (i < len(bucket)) {
            if (bucket[i].key == key) {
                bucket[i].value = value;
                return self;
            }
            i = i + 1;
        }
        bucket.append(HashEntry(key, value));
        self.count = self.count + 1;
        return self;
    }

    pub fn get(key: str): any {
        var idx = self._hash(key);
        var bucket = self.buckets[idx];
        var i = 0;
        while (i < len(bucket)) {
            if (bucket[i].key == key) {
                return bucket[i].value;
            }
            i = i + 1;
        }
        return nil;
    }

    pub fn contains_key(key: str): bool {
        return (self.get(key) != nil);
    }

    pub fn size(): int {
        return self.count;
    }

    pub fn is_empty(): bool {
        return (self.count == 0);
    }

    pub fn clear(): HashMap {
        self.count = 0;
        self.buckets = [] as [[HashEntry]];
        var i = 0;
        while (i < self.capacity) {
            self.buckets.append([] as [HashEntry]);
            i = i + 1;
        }
        return self;
    }
}

pub fn hashmap(): HashMap {
    return HashMap();
}
