// HashMap Frame - Parallel-array open-addressed hash table for cache-efficient O(1) operations

frame HashMap {
    pub ctrl: [int];      // 0 = EMPTY, 1 = DELETED, 2 = OCCUPIED
    pub keys: [str];
    pub values: [any];
    pub capacity: int;
    pub count: int;
    pub tombstone_count: int;

    pub init(initial_cap: int = 16) {
        self.capacity = initial_cap;
        if (self.capacity < 4) self.capacity = 4;
        self.count = 0;
        self.tombstone_count = 0;
        self.ctrl = [] as [int];
        self.keys = [] as [str];
        self.values = [] as [any];
        var i = 0;
        while (i < self.capacity) {
            self.ctrl.append(0);
            self.keys.append("");
            self.values.append(nil);
            i = i + 1;
        }
    }

    fn _hash(key: str): int {
        var h = _builtin_string_hash_bytes(key) % self.capacity;
        if (h < 0) {
            h = h + self.capacity;
        }
        return h;
    }

    fn _rehash(new_cap: int) {
        var old_ctrl = self.ctrl;
        var old_keys = self.keys;
        var old_values = self.values;

        self.capacity = new_cap;
        if (self.capacity < 4) self.capacity = 4;
        self.count = 0;
        self.tombstone_count = 0;
        self.ctrl = [] as [int];
        self.keys = [] as [str];
        self.values = [] as [any];

        var i = 0;
        while (i < self.capacity) {
            self.ctrl.append(0);
            self.keys.append("");
            self.values.append(nil);
            i = i + 1;
        }

        i = 0;
        while (i < len(old_ctrl)) {
            if (old_ctrl[i] == 2) {
                var k = old_keys[i];
                var v = old_values[i];
                var idx = self._hash(k);
                var j = 0;
                while (j < self.capacity) {
                    var curr_idx = (idx + j) % self.capacity;
                    if (self.ctrl[curr_idx] == 0) {
                        self.ctrl[curr_idx] = 2;
                        self.keys[curr_idx] = k;
                        self.values[curr_idx] = v;
                        self.count = self.count + 1;
                        j = self.capacity; // break
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }

    pub fn put(key: str, value: any): HashMap {
        if ((self.count + self.tombstone_count + 1) * 2 >= self.capacity) {
            self._rehash(self.capacity * 2);
        }

        var idx = self._hash(key);
        var first_tombstone = -1;
        var i = 0;

        while (i < self.capacity) {
            var curr_idx = (idx + i) % self.capacity;
            var c = self.ctrl[curr_idx];

            if (c == 2) {
                if (self.keys[curr_idx] == key) {
                    self.values[curr_idx] = value;
                    return self;
                }
            } else if (c == 1) {
                if (first_tombstone == -1) {
                    first_tombstone = curr_idx;
                }
            } else { // c == 0 (EMPTY)
                if (first_tombstone != -1) {
                    curr_idx = first_tombstone;
                    self.tombstone_count = self.tombstone_count - 1;
                }
                self.ctrl[curr_idx] = 2;
                self.keys[curr_idx] = key;
                self.values[curr_idx] = value;
                self.count = self.count + 1;
                return self;
            }
            i = i + 1;
        }

        if (first_tombstone != -1) {
            self.ctrl[first_tombstone] = 2;
            self.keys[first_tombstone] = key;
            self.values[first_tombstone] = value;
            self.tombstone_count = self.tombstone_count - 1;
            self.count = self.count + 1;
        }
        return self;
    }

    pub fn get(key: str): any? {
        var idx = self._hash(key);
        var i = 0;

        while (i < self.capacity) {
            var curr_idx = (idx + i) % self.capacity;
            var c = self.ctrl[curr_idx];

            if (c == 0) {
                return err();
            }
            if (c == 2 and self.keys[curr_idx] == key) {
                return ok(self.values[curr_idx]);
            }
            i = i + 1;
        }
        return err();
    }

    pub fn contains_key(key: str): bool {
        var res = self.get(key);
        match (res) {
            val value => { return true; },
            err error => { return false; }
        }
        return false;
    }

    pub fn size(): int {
        return self.count;
    }

    pub fn is_empty(): bool {
        return (self.count == 0);
    }

    pub fn remove(key: str): HashMap {
        var idx = self._hash(key);
        var i = 0;

        while (i < self.capacity) {
            var curr_idx = (idx + i) % self.capacity;
            var c = self.ctrl[curr_idx];

            if (c == 0) {
                return self;
            }
            if (c == 2 and self.keys[curr_idx] == key) {
                self.ctrl[curr_idx] = 1; // DELETED
                self.keys[curr_idx] = "";
                self.values[curr_idx] = nil;
                self.count = self.count - 1;
                self.tombstone_count = self.tombstone_count + 1;
                return self;
            }
            i = i + 1;
        }
        return self;
    }

    pub fn clear(): HashMap {
        self.count = 0;
        self.tombstone_count = 0;
        self.ctrl = [] as [int];
        self.keys = [] as [str];
        self.values = [] as [any];
        var i = 0;
        while (i < self.capacity) {
            self.ctrl.append(0);
            self.keys.append("");
            self.values.append(nil);
            i = i + 1;
        }
        return self;
    }
}

pub fn hashmap(initial_cap: int = 16): HashMap {
    return HashMap(initial_cap);
}
