// Standard Library Map Collection
import std.collections.hashmap as hashmap;

pub import std.collections.hashmap show HashMap, hashmap;

frame HashMapWrapper {
    pub impl: hashmap.HashMap;

    pub init(initial_cap: int = 16) {
        self.impl = hashmap.hashmap(initial_cap);
    }

    pub fn put(key: str, value: any) {
        self.impl.put(key, value);
    }

    pub fn get(key: str): any? {
        return self.impl.get(key);
    }

    pub fn remove(key: str) {
        self.impl.remove(key);
    }

    pub fn contains_key(key: str): bool {
        return self.impl.contains_key(key);
    }

    pub fn size(): int {
        return self.impl.size();
    }

    pub fn length(): int {
        return self.impl.size();
    }

    pub fn is_empty(): bool {
        return self.impl.is_empty();
    }

    pub fn clear() {
        self.impl.clear();
    }
}

staged fn MapOf(K: type, V: type): type {
    return HashMapWrapper;
}

pub fn Map(): HashMapWrapper {
    return HashMapWrapper();
}
