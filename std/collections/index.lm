// Collections Module Index - Re-exports all collection frames

// Import all collection frames
import std.collections.list as list;
import std.collections.hash as hash;
import std.collections.tree as tree;
import std.collections.queue as queue;
import std.collections.vector as vector;

// Re-export frames for easy access
// In Limit, variables can hold frame types for instantiation
var LinkedList = list.LinkedList;
var HashMap = hash.HashMap;
var HashSet = hash.HashSet;
var TreeMap = tree.TreeMap;
var TreeSet = tree.TreeSet;
var Queue = queue.Queue;
var PriorityQueue = queue.PriorityQueue;
var Stack = queue.Stack;
var Vector = vector.Vector;
var Deque = vector.Deque;
var BitSet = queue.BitSet;

