// Collections Module Index - Re-exports all collection frames

// Import all collection frames
import std.collections.linkedlist as list;
import std.collections.hash as hash;
import std.collections.queue as queue;
import std.collections.vector as vector;

// Re-export frames for easy access
// In Limit, variables can hold frame types for instantiation
pub var LinkedList = list.LinkedList;
pub var HashMap = hash.HashMap;
pub var HashSet = hash.HashSet;
pub var Queue = queue.Queue;
pub var PriorityQueue = queue.PriorityQueue;
pub var Stack = queue.Stack;
pub var Vector = vector.Vector;
pub var Deque = vector.Deque;
pub var ArrayList = vector.ArrayList;
pub var RingBuffer = vector.RingBuffer;
pub var BitSet = queue.BitSet;

fn main(): int {
    return 0;
}
