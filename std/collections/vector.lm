// Standard Library Vector, ArrayList, and RingBuffer Collections

import std.iterator as iterator;
import std.iterator show Iterator;

staged frame Vector(T: type) {
    pub var data: [T];
    var size: int;
    var capacity: int;

    pub init(initial_capacity: int = 8) {
        self.data = [];
        self.size = 0;
        self.capacity = initial_capacity;
        if (self.capacity < 1) {
            self.capacity = 1;
        }
    }

    fn _copy_without(index_to_skip: int): [T] {
        var out: [T] = [];
        var i = 0;
        var j = 0;
        while (i < self.size) {
            if (i != index_to_skip) {
                out[j] = self.data[i];
                j = j + 1;
            }
            i = i + 1;
        }
        return out;
    }

    fn _grow_for(count: int) {
        if (self.capacity < 1) {
            self.capacity = 1;
        }
        while (self.capacity < count) {
            self.capacity = self.capacity * 2;
        }
    }

    pub fn append(item: T) {
        self.push(item);
    }

    pub fn push(item: T) {
        self._grow_for(self.size + 1);
        self.data[self.size] = item;
        self.size = self.size + 1;
    }

    pub fn insert(index: int, item: T) {
        if (index < 0) {
            index = 0;
        }
        if (index > self.size) {
            index = self.size;
        }
        self._grow_for(self.size + 1);
        var i = self.size;
        while (i > index) {
            self.data[i] = self.data[i - 1];
            i = i - 1;
        }
        self.data[index] = item;
        self.size = self.size + 1;
    }

    pub fn remove(index: int): T | nil {
        if (index < 0 or index >= self.size) {
            return nil;
        }
        var item = self.data[index];
        self.data = self._copy_without(index);
        self.size = self.size - 1;
        return item;
    }

    pub fn pop(): T | nil {
        return self.remove(self.size - 1);
    }

    pub fn get(index: int): T | nil {
        if (index < 0 or index >= self.size) {
            return nil;
        }
        return self.data[index];
    }

    pub fn set(index: int, item: T): bool {
        if (index < 0 or index >= self.size) {
            return false;
        }
        self.data[index] = item;
        return true;
    }

    pub fn peek(): T | nil {
        return self.get(self.size - 1);
    }

    pub fn len(): int {
        return self.size;
    }

    pub fn length(): int {
        return self.size;
    }

    pub fn size(): int {
        return self.size;
    }

    pub fn is_empty(): bool {
        return self.size == 0;
    }

    pub fn reserve(new_capacity: int) {
        if (new_capacity > self.capacity) {
            self.capacity = new_capacity;
        }
    }

    pub fn resize(new_size: int, fill: T) {
        if (new_size < 0) {
            new_size = 0;
        }
        self._grow_for(new_size);
        while (self.size < new_size) {
            self.data[self.size] = fill;
            self.size = self.size + 1;
        }
        while (self.size > new_size) {
            self.pop();
        }
    }

    pub fn clear() {
        self.data = [];
        self.size = 0;
    }

    pub fn iterator(): Iterator {
        var it: VectorIterator(T) = VectorIterator(self.data);
        return it;
    }
}

staged frame VectorIterator(T: type): Iterator {
    var data: [T];
    var index: int;

    pub init(data: [T]) {
        self.data = data;
        self.index = 0;
    }

    // The list handle is shared with the owning Vector, so the length is read
    // on each query: growth is observed instead of frozen at construction time.
    pub fn has_next(): bool {
        return self.index < len(self.data);
    }

    pub fn next(): any {
        if (self.index >= len(self.data)) {
            return nil;
        }
        var item = self.data[self.index];
        self.index = self.index + 1;
        return item;
    }
}


staged frame ArrayList(T: type) {
    var data: Vector(T);

    pub init() {
        var v: Vector(T) = Vector();
        self.data = v;
    }

    pub fn push(item: T) {
        self.data.push(item);
    }

    pub fn pop(): T | nil {
        return self.data.pop();
    }

    pub fn remove(index: int): T | nil {
        return self.data.remove(index);
    }

    pub fn resize(new_size: int, fill: T) {
        self.data.resize(new_size, fill);
    }

    pub fn get(index: int): T | nil {
        return self.data.get(index);
    }

    pub fn set(index: int, item: T): bool {
        return self.data.set(index, item);
    }

    pub fn len(): int {
        return self.data.len();
    }

    pub fn length(): int {
        return self.data.length();
    }

    pub fn size(): int {
        return self.data.size();
    }

    pub fn iterator(): Iterator {
        return self.data.iterator();
    }
}

staged frame RingBuffer(T: type) {
    var data: [T];
    var capacity: int;
    var start: int;
    var count: int;

    pub init(capacity: int = 16) {
        self.data = [];
        self.capacity = capacity;
        if (self.capacity < 1) {
            self.capacity = 1;
        }
        self.start = 0;
        self.count = 0;
    }

    pub fn push(item: T) {
        if (self.count < self.capacity) {
            self.data[self.count] = item;
            self.count = self.count + 1;
        } else {
            self.data[self.start] = item;
            self.start = (self.start + 1) % self.capacity;
        }
    }

    pub fn pop(): T | nil {
        if (self.count == 0) {
            return nil;
        }
        var item = self.data[self.start];
        self.start = (self.start + 1) % self.capacity;
        self.count = self.count - 1;
        return item;
    }

    pub fn len(): int {
        return self.count;
    }

    pub fn length(): int {
        return self.count;
    }

    pub fn size(): int {
        return self.count;
    }
}
