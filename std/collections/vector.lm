// Standard Library Vector Collection

frame Vector {
    pub var data: [any];
    var size: int;

    pub init(initial_capacity: int = 10) {
        self.data = [];
        self.size = 0;
    }

    pub fn push(item: any) {
        self.data = self.data + [item];
        self.size = self.size + 1;
    }

    pub fn pop(): any {
        if (self.size == 0) return nil;
        var item = self.data[self.size - 1];
        // Note: Shrinking array is hard without better slice support
        self.size = self.size - 1;
        return item;
    }

    pub fn get(index: int): any {
        if (index < 0 or index >= self.size) return nil;
        return self.data[index];
    }

    pub fn set(index: int, item: any) {
        if (index < 0 or index >= self.size) return;
        self.data[index] = item;
    }

    pub fn peek(): any {
        if (self.size == 0) return nil;
        return self.data[self.size - 1];
    }

    pub fn len(): int { return self.size; }

    pub fn clear() {
        self.data = [];
        self.size = 0;
    }
}

frame Deque {
    pub var data: [any];
    
    pub init() {
        self.data = [];
    }
    
    pub fn push_back(item: any) {
        self.data = self.data + [item];
    }
    
    pub fn push_front(item: any) {
        self.data = [item] + self.data;
    }
    
    pub fn peek_back(): any {
        var n = len(self.data);
        if (n == 0) return nil;
        return self.data[n-1];
    }

    pub fn peek_front(): any {
        var n = len(self.data);
        if (n == 0) return nil;
        return self.data[0];
    }

    pub fn pop_back(): any {
        var n = len(self.data);
        if (n == 0) return nil;
        var item = self.data[n-1];
        // Slice simulation if supported, otherwise self is slow
        var next_data = [];
        for (var i = 0; i < n - 1; i = i + 1) next_data = next_data + [self.data[i]];
        self.data = next_data;
        return item;
    }
    
    pub fn pop_front(): any {
        var n = len(self.data);
        if (n == 0) return nil;
        var item = self.data[0];
        var next_data = [];
        for (var i = 1; i < n; i = i + 1) next_data = next_data + [self.data[i]];
        self.data = next_data;
        return item;
    }
    
    pub fn len(): int { return len(self.data); }
}
