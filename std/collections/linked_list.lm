// Standard Library LinkedList Collection

import std.traits show Iterator;

staged frame Node(T: type) {
    pub var value: T;
    pub var next: any;

    pub init(value: T) {
        self.value = value;
        self.next = nil;
    }
}

staged frame LinkedListIterator(T: type): Iterator {
    var current: any;

    pub init(head: any) {
        self.current = head;
    }

    pub fn has_next(): bool {
        return self.current != nil;
    }

    pub fn next(): any {
        if (self.current == nil) {
            return nil;
        }
        var node: Node(T) = self.current;
        var vals = node.value;
        self.current = node.next;
        return vals;
    }
}

staged frame LinkedList(T: type) {
    pub var head: any;
    pub var tail: any;
    pub var size: int;

    pub init() {
        self.head = nil;
        self.tail = nil;
        self.size = 0;
    }

    pub fn push_back(value: T) {
        var node: Node(T) = Node(value);
        if (self.tail == nil) {
            self.head = node;
            self.tail = node;
        } else {
            var last_node: Node(T) = self.tail;
            last_node.next = node;
            self.tail = node;
        }
        self.size = self.size + 1;
    }

    pub fn push_front(value: T) {
        var node: Node(T) = Node(value);
        if (self.head == nil) {
            self.head = node;
            self.tail = node;
        } else {
            node.next = self.head;
            self.head = node;
        }
        self.size = self.size + 1;
    }

    pub fn pop_back(): T | nil {
        if (self.tail == nil) return nil;
        if (self.head == self.tail) {
            var node: Node(T) = self.head;
            var vals = node.value;
            self.head = nil;
            self.tail = nil;
            self.size = 0;
            return vals;
        }

        var curr: Node(T) = self.head;
        while (curr.next != self.tail) {
            curr = curr.next;
        }
        var last_node: Node(T) = self.tail;
        var vals = last_node.value;
        curr.next = nil;
        self.tail = curr;
        self.size = self.size - 1;
        return vals;
    }

    pub fn pop_front(): T | nil {
        if (self.head == nil) return nil;
        var node: Node(T) = self.head;
        var vals = node.value;
        self.head = node.next;
        if (self.head == nil) {
            self.tail = nil;
        }
        self.size = self.size - 1;
        return vals;
    }

    pub fn len(): int { return self.size; }
    pub fn length(): int { return self.size; }
    pub fn is_empty(): bool { return self.size == 0; }

    pub fn iterator(): LinkedListIterator(T) {
        var it: LinkedListIterator(T) = LinkedListIterator(self.head);
        return it;
    }
}
