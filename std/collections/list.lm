// Standard Library LinkedList Collection

frame Node {
    pub var value: any;
    pub var next: any; // Node?
    pub var prev: any; // Node?
    
    pub init(value: any) {
        self.value = value;
        self.next = nil;
        self.prev = nil;
    }
}

frame LinkedList {
    var head: any; // Node?
    var tail: any; // Node?
    var size: int;
    
    pub init() {
        self.head = nil;
        self.tail = nil;
        self.size = 0;
    }
    
    pub fn push_back(value: any) {
        var node = Node(value);
        if (self.tail == nil) {
            self.head = node;
            self.tail = node;
        } else {
            node.prev = self.tail;
            self.tail.next = node;
            self.tail = node;
        }
        self.size = self.size + 1;
    }
    
    pub fn push_front(value: any) {
        var node = Node(value);
        if (self.head == nil) {
            self.head = node;
            self.tail = node;
        } else {
            node.next = self.head;
            self.head.prev = node;
            self.head = node;
        }
        self.size = self.size + 1;
    }
    
    pub fn pop_back(): any {
        if (self.tail == nil) return nil;
        var node = self.tail;
        var val = node.value;
        self.tail = node.prev;
        if (self.tail == nil) {
            self.head = nil;
        } else {
            self.tail.next = nil;
        }
        self.size = self.size - 1;
        return val;
    }
    
    pub fn pop_front(): any {
        if (self.head == nil) return nil;
        var node = self.head;
        var val = node.value;
        self.head = node.next;
        if (self.head == nil) {
            self.tail = nil;
        } else {
            self.head.prev = nil;
        }
        self.size = self.size - 1;
        return val;
    }
    
    pub fn len(): int { return self.size; }
}
