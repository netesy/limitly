// Standard Library LinkedList Collection

frame Node {
    pub var value: any;
    pub var next: any; // Node?
    pub var prev: any; // Node?
    
    pub init(value: any) {
        this.value = value;
        this.next = nil;
        this.prev = nil;
    }
}

frame LinkedList {
    var head: any; // Node?
    var tail: any; // Node?
    var size: int;
    
    pub init() {
        this.head = nil;
        this.tail = nil;
        this.size = 0;
    }
    
    pub fn push_back(value: any) {
        var node = Node(value);
        if (this.tail == nil) {
            this.head = node;
            this.tail = node;
        } else {
            node.prev = this.tail;
            this.tail.next = node;
            this.tail = node;
        }
        this.size = this.size + 1;
    }
    
    pub fn push_front(value: any) {
        var node = Node(value);
        if (this.head == nil) {
            this.head = node;
            this.tail = node;
        } else {
            node.next = this.head;
            this.head.prev = node;
            this.head = node;
        }
        this.size = this.size + 1;
    }
    
    pub fn pop_back(): any {
        if (this.tail == nil) return nil;
        var node = this.tail;
        var val = node.value;
        this.tail = node.prev;
        if (this.tail == nil) {
            this.head = nil;
        } else {
            this.tail.next = nil;
        }
        this.size = this.size - 1;
        return val;
    }
    
    pub fn pop_front(): any {
        if (this.head == nil) return nil;
        var node = this.head;
        var val = node.value;
        this.head = node.next;
        if (this.head == nil) {
            this.tail = nil;
        } else {
            this.head.prev = nil;
        }
        this.size = this.size - 1;
        return val;
    }
    
    pub fn len(): int { return this.size; }
}
