// Standard Library List Collection

import std.collections.traits show Collection, Indexable, Mutable;

frame List : Collection, Indexable, Mutable {
    pub data: [any];

    pub init() {
        self.data = [] as [any];
    }

    pub fn is_empty(): bool {
        return len(self.data) == 0;
    }

    pub fn append(item: any): nil {
        self.data.append(item);
    }

    pub fn push(item: any) {
        self.data.append(item);
    }

    pub fn pop(): any {
        var n = len(self.data);
        if (n == 0) {
            return nil;
        }
        var item = self.data[n - 1];

        var new_data = [] as [any];
        var i = 0;
        while (i < n - 1) {
            new_data[i] = self.data[i];
            i = i + 1;
        }
        self.data = new_data;
        return item;
    }

    pub fn remove(index: int): any {
        if (index < 0 or index >= len(self.data)) {
            return nil;
        }
        var item = self.data[index];
        var new_data = [] as [any];
        var i = 0;
        while (i < len(self.data)) {
            if (i != index) {
                new_data.append(self.data[i]);
            }
            i = i + 1;
        }
        self.data = new_data;
        return item;
    }

    pub fn get(index: int): any {
        if (index < 0 or index >= len(self.data)) {
            return nil;
        }
        return self.data[index];
    }

    pub fn set(index: int, item: any): bool {
        if (index < 0 or index >= len(self.data)) {
            return false;
        }
        self.data[index] = item;
        return true;
    }

    pub fn len(): int {
        return len(self.data);
    }

    pub fn length(): int {
        return len(self.data);
    }

    pub fn clear(): nil {
        self.data = [] as [any];
    }
}

staged fn ListOf(T: type): type {
    return List;
}
