// Standard Library PriorityQueue Collection
//
// Min-heap ordered by a caller-supplied comparator. `PriorityQueue(T)` is a
// staged frame: instantiate it with a type argument (e.g. `PriorityQueue(int)`)
// and pass a `fn(T, T): int` comparator to `init`. The comparator returns a
// negative value when `left` should sort ahead of `right`, zero when equal, and
// a positive value when `left` should sort behind `right`.

staged frame PriorityQueue(T: type) {
    pub var heap: [T];
    var size: int;
    var comparator: fn(T, T): int;

    pub init(comparator: fn(T, T): int) {
        self.heap = [];
        self.size = 0;
        self.comparator = comparator;
    }

    fn _compare(left: T, right: T): int {
        return self.comparator(left, right);
    }

    pub fn insert(item: T) {
        self.push(item);
    }

    pub fn push(item: T) {
        self.heap[self.size] = item;
        self.size = self.size + 1;
        self._sift_up(self.size - 1);
    }

    pub fn peek(): T | nil {
        if (self.size == 0) {
            return nil;
        }
        return self.heap[0];
    }

    pub fn remove(): T | nil {
        return self.pop();
    }

    pub fn pop(): T | nil {
        if (self.size == 0) {
            return nil;
        }
        var result = self.heap[0];
        self.heap[0] = self.heap[self.size - 1];

        var new_heap: [T] = [];
        var i = 0;
        while (i < self.size - 1) {
            new_heap[i] = self.heap[i];
            i = i + 1;
        }
        self.heap = new_heap;
        self.size = self.size - 1;

        if (self.size > 0) {
            self._sift_down(0);
        }
        return result;
    }

    pub fn len(): int {
        return self.size;
    }

    pub fn length(): int {
        return self.size;
    }

    pub fn is_empty(): bool {
        return self.size == 0;
    }

    pub fn clear() {
        self.heap = [];
        self.size = 0;
    }

    fn _sift_up(idx: int) {
        while (idx > 0) {
            var parent = (idx - 1) / 2;
            if (self._compare(self.heap[idx], self.heap[parent]) < 0) {
                var tmp = self.heap[idx];
                self.heap[idx] = self.heap[parent];
                self.heap[parent] = tmp;
                idx = parent;
            } else {
                return;
            }
        }
    }

    fn _sift_down(idx: int) {
        while (true) {
            var smallest = idx;
            var left = 2 * idx + 1;
            var right = 2 * idx + 2;
            if (left < self.size and self._compare(self.heap[left], self.heap[smallest]) < 0) {
                smallest = left;
            }
            if (right < self.size and self._compare(self.heap[right], self.heap[smallest]) < 0) {
                smallest = right;
            }
            if (smallest != idx) {
                var tmp = self.heap[idx];
                self.heap[idx] = self.heap[smallest];
                self.heap[smallest] = tmp;
                idx = smallest;
            } else {
                return;
            }
        }
    }
}
