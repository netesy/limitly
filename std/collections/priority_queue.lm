// Standard Library PriorityQueue Collection

frame PriorityQueue {
    pub var heap: [any];
    var comparator: any;

    pub init(comparator: any) {
        self.heap = [];
        self.comparator = comparator;
    }

    fn _compare(left: any, right: any): int {
        if (self.comparator != nil) {
            var comp = self.comparator;
            return comp(left, right);
        }
        if (left < right) {
            return -1;
        }
        if (left > right) {
            return 1;
        }
        return 0;
    }

    pub fn insert(item: any) {
        self.push(item);
    }

    pub fn push(item: any) {
        self.heap.append(item);
        var current_len = len(self.heap);
        self._sift_up(current_len - 1);
    }

    pub fn peek(): any {
        if (len(self.heap) == 0) {
            return nil;
        }
        return self.heap[0];
    }

    pub fn remove(): any {
        return self.pop();
    }

    pub fn pop(): any {
        var n = len(self.heap);
        if (n == 0) {
            return nil;
        }
        var result = self.heap[0];
        self.heap[0] = self.heap[n - 1];
        
        var new_heap: [any] = [];
        var i = 0;
        while (i < n - 1) {
            new_heap.append(self.heap[i]);
            i = i + 1;
        }
        self.heap = new_heap;

        if (len(self.heap) > 0) {
            self._sift_down(0);
        }
        return result;
    }

    pub fn len(): int {
        return len(self.heap);
    }

    pub fn length(): int {
        return len(self.heap);
    }

    fn _sift_up(idx: int) {
        while (idx > 0) {
            var parent = (idx - 1) / 2;
            if (self._compare(self.heap[idx], self.heap[parent]) < 0) {
                var tmp = self.heap[idx];
                self.heap[idx] = self.heap[parent];
                self.heap[parent] = tmp;
                idx = parent;
            } else {
                return;
            }
        }
    }

    fn _sift_down(idx: int) {
        var n = len(self.heap);
        while (true) {
            var smallest = idx;
            var left = 2 * idx + 1;
            var right = 2 * idx + 2;
            if (left < n and self._compare(self.heap[left], self.heap[smallest]) < 0) {
                smallest = left;
            }
            if (right < n and self._compare(self.heap[right], self.heap[smallest]) < 0) {
                smallest = right;
            }
            if (smallest != idx) {
                var tmp = self.heap[idx];
                self.heap[idx] = self.heap[smallest];
                self.heap[smallest] = tmp;
                idx = smallest;
            } else {
                return;
            }
        }
    }
}

pub type PriorityQueueWrapper = PriorityQueue;

pub fn PriorityQueueWrapper(comparator: any): PriorityQueue {
    return PriorityQueue(comparator);
}
