// std/scene/group.lm
// Group submodule for std.scene. Scene graph nodes, 2D/3D scene trees, and transformation hierarchies.

import std.scene.node as node;

frame Group {
    pub var root_node: node.Node;
    pub var name: str;

    pub init(r: node.Node = node.Node(), n: str = "Group") {
        self.root_node = r;
        self.name = n;
    }
}
