import std.scene.node as node;
import std.graphics.vector2 as vector2;

frame HitTest {
    pub init() {}

    pub fn test(root: node.Node, point: vector2.Vector2): node.Node? {
        if (not root.visible) return nil;

        var i = len(root.children) - 1;
        while (i >= 0) {
            var child = root.children[i];
            var hit = self.test(child as node.Node, point);
            if (hit != nil) return hit;
            i = i - 1;
        }

        return root;
    }
}
