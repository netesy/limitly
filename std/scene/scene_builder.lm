// std/scene/scene_builder.lm
// Scene Builder submodule for std.scene. Scene graph nodes, 2D/3D scene trees, and transformation hierarchies.

import std.scene.scene as scene;

/// Fluent builder for constructing and composing hierarchical scenes.
///
/// @example
/// ```lymar
/// var b = Builder();
/// var s = b.build();
/// ```
frame Builder {
    pub var active_scene: scene.Scene;

    pub init(s: scene.Scene = scene.Scene()) {
        self.active_scene = s;
    }

    /// Finalizes construction and returns the built scene instance.
    ///
    /// @return Built Scene instance.
    pub fn build(): scene.Scene {
        return self.active_scene;
    }
}
