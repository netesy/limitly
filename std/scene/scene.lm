import std.scene.node as node;
import std.scene.camera as camera;
import std.scene.viewport as viewport;

frame Scene {
    pub var root: node.Node;
    pub var active_camera: camera.Camera;
    pub var vp: viewport.Viewport;

    pub init(r: node.Node? = nil, cam: camera.Camera? = nil, v: viewport.Viewport? = nil) {
        if (r != nil) {
            self.root = r as node.Node;
        } else {
            self.root = node.Node();
        }
        if (cam != nil) {
            self.active_camera = cam as camera.Camera;
        } else {
            self.active_camera = camera.Camera();
        }
        if (v != nil) {
            self.vp = v as viewport.Viewport;
        } else {
            self.vp = viewport.Viewport();
        }
    }
}
