import std.scene.node as node;
import std.graphics.transform as transform; // required: promoted apply_base body resolves in host scope
import std.graphics.animation as animation;

frame AnimationNode : node.NodeTrait {
    embed node.Node;
    pub var anim: animation.Animation;

    pub init(b: node.Node? = nil, a: animation.Animation? = nil) {
        self.apply_base(b);
        if (a != nil) {
            self.anim = a as animation.Animation;
        } else {
            self.anim = animation.Animation();
        }
    }
}
