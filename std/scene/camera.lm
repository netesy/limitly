// std/scene/camera.lm
// Camera submodule for std.scene. Scene graph nodes, 2D/3D scene trees, and transformation hierarchies.

import std.graphics.matrix as matrix;

frame Camera {
    pub var projection: matrix.Matrix;
    pub var view: matrix.Matrix;

    pub init(proj: matrix.Matrix? = nil, v: matrix.Matrix? = nil) {
        if (proj != nil) {
            self.projection = proj as matrix.Matrix;
        } else {
            self.projection = matrix.Matrix();
        }
        if (v != nil) {
            self.view = v as matrix.Matrix;
        } else {
            self.view = matrix.Matrix();
        }
    }
}
