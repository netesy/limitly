import std.scene.node as node;
import std.graphics.transform as transform;

frame TransformNode : node.NodeTrait {
    embed node.Node;
    pub var local_transform: transform.Transform;

    pub init(b: node.Node? = nil, t: transform.Transform? = nil) {
        self.apply_base(b);
        if (t != nil) {
            self.local_transform = t as transform.Transform;
        } else {
            self.local_transform = transform.Transform();
        }
    }
}
