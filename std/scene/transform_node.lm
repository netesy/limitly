import std.scene.node as node;
import std.graphics.transform as transform;

frame TransformNode {
    embed node.Node;
    pub var local_transform: transform.Transform;

    pub init(b: node.Node? = nil, t: transform.Transform? = nil) {
        if (b != nil) {
            var bn = b as node.Node;
            self.id = bn.id;
            self.children = bn.children;
            self.transform_val = bn.transform_val;
            self.visible = bn.visible;
        } else {
            self.id = 0;
            self.children = [] as [node.Node];
            self.transform_val = transform.Transform();
            self.visible = true;
        }
        if (t != nil) {
            self.local_transform = t as transform.Transform;
        } else {
            self.local_transform = transform.Transform();
        }
    }
}
