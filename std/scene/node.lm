import std.graphics.transform as transform;

trait NodeTrait {
    fn add_child(child: Node): nil;
}

mixin NodeState {
    pub var id: int;
    pub var children: [Node];
    pub var transform_val: transform.Transform;
    pub var visible: bool;
}

frame Node : NodeTrait {
    mixin NodeState;

    pub init(id: int = 0, ch: [Node]? = nil, t: transform.Transform? = nil, vis: bool = true) {
        self.id = id;
        if (ch != nil) {
            self.children = ch as [Node];
        } else {
            self.children = [] as [Node];
        }
        if (t != nil) {
            self.transform_val = t as transform.Transform;
        } else {
            self.transform_val = transform.Transform();
        }
        self.visible = vis;
    }

    pub fn add_child(child: Node): nil {
        self.children.append(child);
    }

    // Shared base-field initializer, promoted to frames that `embed node.Node`.
    // Copies id/children/transform/visible from `b`, or applies Node defaults.
    pub fn apply_base(b: Node?): nil {
        if (b != nil) {
            var bn = b as Node;
            self.id = bn.id;
            self.children = bn.children;
            self.transform_val = bn.transform_val;
            self.visible = bn.visible;
        } else {
            self.id = 0;
            self.children = [] as [Node];
            self.transform_val = transform.Transform();
            self.visible = true;
        }
    }
}
