import std.graphics.transform as transform;

trait NodeTrait {
    fn add_child(child: Node): nil;
}

mixin NodeState {
    pub var id: int;
    pub var children: [Node];
    pub var transform_val: transform.Transform;
    pub var visible: bool;
}

frame Node : NodeTrait {
    mixin NodeState;

    pub init(id: int = 0, ch: [Node]? = nil, t: transform.Transform? = nil, vis: bool = true) {
        self.id = id;
        if (ch != nil) {
            self.children = ch as [Node];
        } else {
            self.children = [] as [Node];
        }
        if (t != nil) {
            self.transform_val = t as transform.Transform;
        } else {
            self.transform_val = transform.Transform();
        }
        self.visible = vis;
    }

    pub fn add_child(child: Node): nil {
        self.children.append(child);
    }
}
