import std.scene.node as node;
import std.graphics.transform as transform; // required: promoted apply_base body resolves in host scope
import std.graphics.rect as rect;

frame ClipNode {
    embed node.Node;
    pub var clip_rect: rect.Rect;

    pub init(b: node.Node? = nil, r: rect.Rect? = nil) {
        self.apply_base(b);
        if (r != nil) {
            self.clip_rect = r as rect.Rect;
        } else {
            self.clip_rect = rect.Rect();
        }
    }
}
