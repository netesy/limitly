// std/scene/clip_node.lm
// Clip Node submodule for std.scene. Scene graph nodes, 2D/3D scene trees, and transformation hierarchies.

import std.scene.node as node;
import std.graphics.transform as transform; // required: promoted apply_base body resolves in host scope
import std.geometry show Rect;

frame ClipNode : node.NodeTrait {
    embed node.Node;
    pub var clip_rect: Rect;

    pub init(b: node.Node? = nil, r: Rect? = nil) {
        self.apply_base(b);
        if (r != nil) {
            self.clip_rect = r as Rect;
        } else {
            self.clip_rect = Rect();
        }
    }
}
