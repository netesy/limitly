// std/scene/layer.lm
// Layer submodule for std.scene. Scene graph nodes, 2D/3D scene trees, and transformation hierarchies.

import std.scene.node as node;

frame Layer {
    pub var root_node: node.Node;
    pub var opacity: float;
    pub var z_order: int;

    pub init(r: node.Node = node.Node(), op: float = 1.0, z: int = 0) {
        self.root_node = r;
        self.opacity = op;
        self.z_order = z;
    }
}
