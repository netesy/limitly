// Standard Library Filesystem Forwarder Module

import std.fs.index as fs_mod;
import std.path as path;

pub type Permissions = fs_mod.Permissions;
pub type IOError = fs_mod.IOError;

frame FS {
    pub init() {}
    pub fn exists(p: path.Path): bool {
        var f = fs_mod.FS();
        return f.exists(p);
    }
    pub fn create_dir(p: path.Path): any {
        var f = fs_mod.FS();
        return f.create_dir(p);
    }
    pub fn remove(p: path.Path): any {
        var f = fs_mod.FS();
        return f.remove(p);
    }
    pub fn rename(from_path: path.Path, to_path: path.Path): any {
        var f = fs_mod.FS();
        return f.rename(from_path, to_path);
    }
    pub fn list_dir(p: path.Path): any {
        var f = fs_mod.FS();
        return f.list_dir(p);
    }
}
