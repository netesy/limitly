// JSON Value representation

pub frame JSONValue {
    pub type_tag: str; // "object", "array", "string", "number", "bool", "null"
    pub str_val: str;
    pub num_val: int;
    pub bool_val: bool;
    pub list_val: [any];
    pub obj_keys: [str];
    pub obj_vals: [any];
}

pub fn make_string(v: str): JSONValue {
    var list: [any] = [];
    var keys: [str] = [];
    var vals: [any] = [];
    return JSONValue(type_tag="string", str_val=v, num_val=0, bool_val=false, list_val=list, obj_keys=keys, obj_vals=vals);
}

pub fn make_number(v: int): JSONValue {
    var list: [any] = [];
    var keys: [str] = [];
    var vals: [any] = [];
    return JSONValue(type_tag="number", str_val="", num_val=v, bool_val=false, list_val=list, obj_keys=keys, obj_vals=vals);
}

pub fn make_bool(v: bool): JSONValue {
    var list: [any] = [];
    var keys: [str] = [];
    var vals: [any] = [];
    return JSONValue(type_tag="bool", str_val="", num_val=0, bool_val=v, list_val=list, obj_keys=keys, obj_vals=vals);
}

pub fn make_null(): JSONValue {
    var list: [any] = [];
    var keys: [str] = [];
    var vals: [any] = [];
    return JSONValue(type_tag="null", str_val="", num_val=0, bool_val=false, list_val=list, obj_keys=keys, obj_vals=vals);
}

pub fn make_array(v: [any]): JSONValue {
    var keys: [str] = [];
    var vals: [any] = [];
    return JSONValue(type_tag="array", str_val="", num_val=0, bool_val=false, list_val=v, obj_keys=keys, obj_vals=vals);
}

pub fn make_object(k: [str], v: [any]): JSONValue {
    var list: [any] = [];
    return JSONValue(type_tag="object", str_val="", num_val=0, bool_val=false, list_val=list, obj_keys=k, obj_vals=v);
}
