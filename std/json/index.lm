// JSON Module Gateway Index

import std.json.parser as parser;
import std.json.writer as writer;
pub import std.json.value show Value, Type, make_string, make_number, make_bool, make_null, make_array, make_object;

pub fn parse(text: str): Value? {
    var res: any = parser.parse(text);
    if (res == nil) {
        return err();
    }
    return ok(res as Value);
}

pub fn stringify(val_obj: Value): str {
    return writer.stringify(val_obj);
}

pub fn encode_pair(key: str, val_str: str): str {
    return writer.encode_pair(key, val_str);
}

pub fn encode_object(keys: [str], vals: [str]): str {
    return writer.encode_object(keys, vals);
}
