// JSON Writer Module

import std.json.value as value;

pub fn stringify(val_any: any): str {
    var jval = val_any as value.Value;
    if (jval == nil) {
        return "null";
    }

    match (jval.kind) {
        value.Type.String => {
            return "\"" + jval.str_val + "\"";
        },
        value.Type.Number => {
            var num = jval.num_val;
            return "{num}";
        },
        value.Type.Bool => {
            if (jval.bool_val == true) {
                return "true";
            }
            return "false";
        },
        value.Type.Null => {
            return "null";
        },
        value.Type.Array => {
            var res = "[";
            var i = 0;
            var list_len = len(jval.list_val);
            while (i < list_len) {
                res = res + stringify(jval.list_val[i]);
                if (i < list_len - 1) {
                    res = res + ",";
                }
                i = i + 1;
            }
            res = res + "]";
            return res;
        },
        value.Type.Object => {
            var res = "{";
            var i = 0;
            var keys_len = len(jval.obj_keys);
            while (i < keys_len) {
                res = res + "\"" + jval.obj_keys[i] + "\":" + stringify(jval.obj_vals[i]);
                if (i < keys_len - 1) {
                    res = res + ",";
                }
                i = i + 1;
            }
            res = res + "}";
            return res;
        },
        _ => {
            return "null";
        }
    }
}

pub fn encode_pair(key: str, val_str: str): str {
    return "\"" + key + "\":\"" + val_str + "\"";
}

pub fn encode_object(keys: [str], vals: [str]): str {
    var res = "{";
    var i = 0;
    var n = len(keys);
    while (i < n) {
        res = res + "\"" + keys[i] + "\":\"" + vals[i] + "\"";
        if (i < n - 1) {
            res = res + ",";
        }
        i = i + 1;
    }
    res = res + "}";
    return res;
}
