// std/json/writer.lm
// JSON text serializer and encoder.

import std.json.value as value;

/// Serializes a JSON `Value` AST node into formatted JSON text.
///
/// @param val_obj Target JSON value node to serialize.
/// @return Serialized JSON string.
pub fn stringify(val_obj: value.Value): str {
    if (val_obj == nil) {
        return "null";
    }

    match (val_obj.kind) {
        value.Type.String => {
            return "\"" + val_obj.str_val + "\"";
        },
        value.Type.Number => {
            var num = val_obj.num_val;
            return "{num}";
        },
        value.Type.Bool => {
            if (val_obj.bool_val) {
                return "true";
            }
            return "false";
        },
        value.Type.Null => {
            return "null";
        },
        value.Type.Array => {
            var res = "[";
            var i = 0;
            var list_len = len(val_obj.list_val);
            while (i < list_len) {
                var item = val_obj.list_val[i] as value.Value;
                res = res + stringify(item);
                if (i < list_len - 1) {
                    res = res + ",";
                }
                i = i + 1;
            }
            res = res + "]";
            return res;
        },
        value.Type.Object => {
            var res = "{";
            var i = 0;
            var keys_len = len(val_obj.obj_keys);
            while (i < keys_len) {
                var child_val = val_obj.obj_vals[i] as value.Value;
                res = res + "\"" + val_obj.obj_keys[i] + "\":" + stringify(child_val);
                if (i < keys_len - 1) {
                    res = res + ",";
                }
                i = i + 1;
            }
            res = res + "}";
            return res;
        },
        _ => {
            return "null";
        }
    }
}

/// Encodes a single key-value pair as a JSON object entry `"key":"value"`.
///
/// @param key Key name.
/// @param val_str Value text.
/// @return Encoded pair string.
pub fn encode_pair(key: str, val_str: str): str {
    return "\"" + key + "\":\"" + val_str + "\"";
}

/// Encodes parallel lists of keys and string values into a JSON object literal.
///
/// @pre len(keys) == len(vals)
/// @param keys List of object key names.
/// @param vals Parallel list of serialized value strings.
/// @return Formatted JSON object string.
pub fn encode_object(keys: [str], vals: [str]): str {
    contract(len(keys) == len(vals), "Key and value counts must match");
    var res = "{";
    var i = 0;
    var n = len(keys);
    while (i < n) {
        res = res + "\"" + keys[i] + "\":\"" + vals[i] + "\"";
        if (i < n - 1) {
            res = res + ",";
        }
        i = i + 1;
    }
    res = res + "}";
    return res;
}
