// JSON Parser Module

import std.json.value as value;

fn is_digit_char(ch: str): bool {
    match (ch) {
        "0" => { return true; },
        "1" => { return true; },
        "2" => { return true; },
        "3" => { return true; },
        "4" => { return true; },
        "5" => { return true; },
        "6" => { return true; },
        "7" => { return true; },
        "8" => { return true; },
        "9" => { return true; },
        _ => { return false; }
    }
}

frame Parser {
    pub idx: int;
    pub text: str;

    pub fn skip_whitespace() {
        var length = len(self.text);
        var skip = true;
        while (self.idx < length and skip == true) {
            var ch = _builtin_substring(self.text, self.idx, self.idx + 1);
            if (ch == " " or ch == "\t" or ch == "\n" or ch == "\r") {
                self.idx = self.idx + 1;
            } else {
                skip = false;
            }
        }
    }

    pub fn peek_char(): str {
        self.skip_whitespace();
        if (self.idx >= len(self.text)) return "";
        return _builtin_substring(self.text, self.idx, self.idx + 1);
    }

    pub fn parse_value(): any {
        self.skip_whitespace();
        var length = len(self.text);
        if (self.idx >= length) return value.make_null() as any;

        var ch = _builtin_substring(self.text, self.idx, self.idx + 1);
        match (ch) {
            "\"" => {
                return self.parse_string() as any;
            },
            "{" => {
                return self.parse_object() as any;
            },
            "[" => {
                return self.parse_array() as any;
            },
            "t" => {
                return self.parse_bool() as any;
            },
            "f" => {
                return self.parse_bool() as any;
            },
            "n" => {
                return self.parse_null() as any;
            },
            _ => {
                if (ch == "-" or is_digit_char(ch) == true) {
                    return self.parse_number() as any;
                }
                return value.make_null() as any;
            }
        }
    }

    pub fn parse_string(): value.Value {
        self.idx = self.idx + 1; // skip leading "
        var start = self.idx;
        var length = len(self.text);
        var keep_going = true;
        while (self.idx < length and keep_going == true) {
            var ch = _builtin_substring(self.text, self.idx, self.idx + 1);
            if (ch == "\"") {
                keep_going = false;
            } else {
                self.idx = self.idx + 1;
            }
        }
        var s = _builtin_substring(self.text, start, self.idx);
        self.idx = self.idx + 1; // skip trailing "
        return value.make_string(s);
    }

    pub fn parse_bool(): value.Value {
        var ch = _builtin_substring(self.text, self.idx, self.idx + 1);
        if (ch == "t") {
            self.idx = self.idx + 4; // skip true
            return value.make_bool(true);
        } else {
            self.idx = self.idx + 5; // skip false
            return value.make_bool(false);
        }
    }

    pub fn parse_null(): value.Value {
        self.idx = self.idx + 4; // skip null
        return value.make_null();
    }

    pub fn parse_number(): value.Value {
        var start = self.idx;
        var length = len(self.text);
        var keep_going = true;
        while (self.idx < length and keep_going == true) {
            var ch = _builtin_substring(self.text, self.idx, self.idx + 1);
            if (ch == "-" or ch == "." or is_digit_char(ch) == true) {
                self.idx = self.idx + 1;
            } else {
                keep_going = false;
            }
        }
        var num_str = _builtin_substring(self.text, start, self.idx);
        var num_val = num_str as int;
        return value.make_number(num_val);
    }

    pub fn parse_array(): value.Value {
        self.idx = self.idx + 1; // skip [
        var list: [any] = [];
        self.skip_whitespace();
        var next_ch = _builtin_substring(self.text, self.idx, self.idx + 1);
        if (next_ch == "]") {
            self.idx = self.idx + 1;
            return value.make_array(list);
        }

        var keep_going = true;
        while (keep_going == true) {
            var item_val = self.parse_value();
            list.append(item_val);
            self.skip_whitespace();
            var ch = _builtin_substring(self.text, self.idx, self.idx + 1);
            if (ch == ",") {
                self.idx = self.idx + 1;
                self.skip_whitespace();
            } elif (ch == "]") {
                self.idx = self.idx + 1;
                keep_going = false;
            } else {
                keep_going = false;
            }
        }
        return value.make_array(list);
    }

    pub fn parse_object(): value.Value {
        self.idx = self.idx + 1; // skip {
        var keys: [str] = [];
        var vals: [any] = [];
        self.skip_whitespace();
        var next_ch = _builtin_substring(self.text, self.idx, self.idx + 1);
        if (next_ch == "}") {
            self.idx = self.idx + 1;
            return value.make_object(keys, vals);
        }

        var keep_going = true;
        while (keep_going == true) {
            self.skip_whitespace();
            var key_ch = _builtin_substring(self.text, self.idx, self.idx + 1);
            var key = "";
            if (key_ch == "\"") {
                var key_val = self.parse_string();
                key = key_val.str_val;
            }
            self.skip_whitespace();
            // Skip colon
            var colon_ch = _builtin_substring(self.text, self.idx, self.idx + 1);
            if (colon_ch == ":") {
                self.idx = self.idx + 1;
            }
            var item_val = self.parse_value();
            keys.append(key);
            vals.append(item_val);
            self.skip_whitespace();
            var ch = _builtin_substring(self.text, self.idx, self.idx + 1);
            if (ch == ",") {
                self.idx = self.idx + 1;
                self.skip_whitespace();
            } elif (ch == "}") {
                self.idx = self.idx + 1;
                keep_going = false;
            } else {
                keep_going = false;
            }
        }
        return value.make_object(keys, vals);
    }
}

pub fn parse(text: str): any {
    var p = Parser(idx=0, text=text);
    return p.parse_value();
}
