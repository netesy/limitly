// Standard Library Statistics Module
import std.math as math;
import std.sort as sort;

fn sum(items: [any]): float {
    var s = 0.0;
    for (var i = 0; i < len(items); i = i + 1) {
        s = s + items[i] as float;
    }
    return s;
}

fn mean(items: [any]): float {
    if (len(items) == 0) return 0.0;
    return sum(items) / (len(items) as float);
}

fn median(items: [any]): float {
    var n = len(items);
    if (n == 0) return 0.0;
    
    // Create copy for sorting
    var copy = [];
    for (var i = 0; i < n; i = i + 1) copy = copy + [items[i]];
    sort.sort(copy);
    
    if (n % 2 == 1) {
        return copy[n / 2] as float;
    } else {
        return (copy[n / 2 - 1] as float + copy[n / 2] as float) / 2.0;
    }
}

fn variance(items: [any]): float {
    var n = len(items);
    if (n < 2) return 0.0;
    var m = mean(items);
    var s = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var diff = (items[i] as float) - m;
        s = s + diff * diff;
    }
    return s / (n as float);
}

fn stddev(items: [any]): float {
    return math.sqrt(variance(items));
}
