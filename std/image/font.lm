// std/image/font.lm
// TrueType font loading, metrics, and CPU coverage rasterization —
// native std.font pipeline (table parsing + glyph outlines + scanline
// rasterizer). No stb_truetype dependency.
//
// API-compatible with the previous stb-backed implementation:
//   load_font / load_system_font / detect_system_font
//   Font.text_width / Font.text_height / Font.render / Font.free
//
// Differences vs the stb path (intentional improvements):
//   - Text is decoded as UTF-8, so Vietnamese/CJK/etc. measure and
//     render correctly (stb iterated raw bytes).
//   - Kerning uses the font's kern table via std.font, matching
//     sdf_atlas semantics.

import std.font.tables as tables;
import std.font.reader as reader;
import std.font.glyph as glyph;
import std.font.rasterizer as rast;
import std.image.index as image;
import std.io.file as _iof;
import std.ffi as ffi;
import std.os.identity as osid;

frame Metrics {
    pub var ascent: float;
    pub var descent: float;
    pub var line_gap: float;
    pub var line_height: float;

    pub init(ascent: float = 0.0, descent: float = 0.0, line_gap: float = 0.0, line_height: float = 0.0) {
        self.ascent = ascent;
        self.descent = descent;
        self.line_gap = line_gap;
        self.line_height = line_height;
    }
}

// _uu_mem: two i64 cells for _utf8_next's (cp, next_index) outputs —
// raw ffi memory avoids frame/tuple allocation in decode loops.
var _uu_mem: int = 0;

fn _utf8_next(text: str, i: int): int {
    // Returns the codepoint at byte offset i; stores the next byte
    // offset in _uu_mem[1]. Same decode as std.font.sdf_atlas.
    unsafe {
        if (_uu_mem == 0) { _uu_mem = ffi.alloc(16); }
        var cp = 0;
        var ni = i + 1;
        var b0 = _builtin_string_byte_at(text, i);
        if (b0 < 128) {
            cp = b0;
        } elif (b0 < 224) {
            var b1 = _builtin_string_byte_at(text, i + 1);
            cp = ((b0 & 31) << 6) | (b1 & 63);
            ni = i + 2;
        } elif (b0 < 240) {
            var b1 = _builtin_string_byte_at(text, i + 1);
            var b2 = _builtin_string_byte_at(text, i + 2);
            cp = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
            ni = i + 3;
        } else {
            var b1 = _builtin_string_byte_at(text, i + 1);
            var b2 = _builtin_string_byte_at(text, i + 2);
            var b3 = _builtin_string_byte_at(text, i + 3);
            cp = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63);
            ni = i + 4;
        }
        ffi.store_i64(_uu_mem, cp);
        ffi.store_i64(ffi.ptr_add(_uu_mem, 8), ni);
        return cp;
    }
}

fn _uu_next(): int {
    unsafe { return ffi.load_i64(ffi.ptr_add(_uu_mem, 8)) as int; }
}

frame Font {
    pub var path: str;
    pub var is_valid: bool;
    var _info: tables.Info = tables.Info();
    var _rdr: reader.ByteReader = reader.ByteReader([] as [int]);

    pub init(path: str = "", info: tables.Info = tables.Info(), rdr: reader.ByteReader = reader.ByteReader([] as [int])) {
        self.path = path;
        self._info = info;
        self._rdr = rdr;
        self.is_valid = info.is_valid;
    }

    pub fn free(): nil {
        // Native font data is region-managed — no external handle to
        // release. Marking invalid drops the reference.
        self.is_valid = false;
        self._info = tables.Info();
        self._rdr = reader.ByteReader([] as [int]);
    }

    // Advance width in px, honouring UTF-8 and kerning. Matches the
    // previous measure_text_width_int contract: result rounded up to
    // the next integer pixel.
    pub fn text_width(text: str, font_size: float = 16.0): float {
        if (not self.is_valid or text == "") { return 0.0; }
        var info = self._info;
        var rdr = self._rdr;
        // stbtt_ScaleForPixelHeight parity: font_size maps to the
        // hhea ascent-descent extent, not the em square.
        var upem = info.ascent - info.descent;
        if (upem <= 0) { upem = 1000; }
        var scale = font_size / (upem as float);
        var total_w = 0.0;
        var prev_gid = -1;
        var i = 0;
        var n = len(text);
        while (i < n) {
            var cp = _utf8_next(text, i);
            i = _uu_next();
            if (cp == 10) { prev_gid = -1; continue; }
            var gid = info.get_glyph_index(rdr, cp);
            var hmet = info.get_glyph_hmetrics(rdr, gid);
            total_w = total_w + ((hmet[0] as float) * scale);
            if (prev_gid >= 0 and info.has_kern) {
                var kern = info.get_kern_advance(prev_gid, gid);
                total_w = total_w + ((kern as float) * scale);
            }
            prev_gid = gid;
        }
        return ((total_w + 0.999) as int) as float;
    }

    // Line height in px for the font at font_size — ceil to int like
    // the previous measure_text_height_int.
    pub fn text_height(text: str, font_size: float = 16.0): float {
        if (not self.is_valid or text == "") { return 0.0; }
        var info = self._info;
        // stbtt_ScaleForPixelHeight parity: font_size maps to the
        // hhea ascent-descent extent, not the em square.
        var upem = info.ascent - info.descent;
        if (upem <= 0) { upem = 1000; }
        var scale = font_size / (upem as float);
        var line_h = ((info.ascent - info.descent + info.line_gap) as float) * scale;
        if (line_h < font_size) { line_h = font_size; }
        return ((line_h + 0.999) as int) as float;
    }

    // Rasterize `text` into an RGBA image, alpha-compositing `color`
    // over transparency. Layout matches the previous stb renderer:
    // 2px origin margin, per-line advance with kerning.
pub fn render(text: str, font_size: float = 16.0, color: any = nil): image.Image? {
        if (not self.is_valid or text == "") { return err(); }
        var c: image.Pixel = image.white;
        if (color != nil) {
            c = color as image.Pixel;
        }

        var info = self._info;
        var rdr = self._rdr;
        // stbtt_ScaleForPixelHeight parity: font_size maps to the
        // hhea ascent-descent extent, not the em square.
        var upem = info.ascent - info.descent;
        if (upem <= 0) { upem = 1000; }
        var scale = font_size / (upem as float);
        var ascent = (info.ascent as float) * scale;
        var line_h = ((info.ascent - info.descent + info.line_gap) as float) * scale;
        if (line_h < font_size) { line_h = font_size; }

        // Measure pass: widest line + line count.
        var num_lines = 1;
        var max_w = 0.0;
        var cur_w = 0.0;
        var prev_gid = -1;
        var i = 0;
        var n = len(text);
        while (i < n) {
            var cp = _utf8_next(text, i);
            i = _uu_next();
            if (cp == 10) {
                if (cur_w > max_w) { max_w = cur_w; }
                cur_w = 0.0;
                prev_gid = -1;
                num_lines = num_lines + 1;
            } else {
                var gid = info.get_glyph_index(rdr, cp);
                var hmet = info.get_glyph_hmetrics(rdr, gid);
                cur_w = cur_w + ((hmet[0] as float) * scale);
                if (prev_gid >= 0 and info.has_kern) {
                    var kern = info.get_kern_advance(prev_gid, gid);
                    cur_w = cur_w + ((kern as float) * scale);
                }
                prev_gid = gid;
            }
        }
        if (cur_w > max_w) { max_w = cur_w; }

        var total_w = (max_w + 1.5) as int;
        if (total_w < 1) { total_w = 1; }
        var total_h = (((num_lines as float) * line_h) + 1.5) as int;
        if (total_h < 1) { total_h = 1; }
        total_w = total_w + 4;
        total_h = total_h + 4;

        unsafe {
            var buf: int = ffi.alloc(total_w * total_h * 4);
            if (buf == nil) { return err(); }
            ffi.memset(buf, 0, total_w * total_h * 4);

            var line_idx = 0;
            var x_pos = 2.0;
            var y_base = 2.0 + ascent;
            i = 0;
            prev_gid = -1;
            while (i < n) {
                var cp = _utf8_next(text, i);
                i = _uu_next();
                if (cp == 10) {
                    line_idx = line_idx + 1;
                    x_pos = 2.0;
                    y_base = 2.0 + (line_idx as float) * line_h + ascent;
                    prev_gid = -1;
                    continue;
                }
                var gid = info.get_glyph_index(rdr, cp);
                if (prev_gid >= 0 and info.has_kern) {
                    var kern = info.get_kern_advance(prev_gid, gid);
                    x_pos = x_pos + ((kern as float) * scale);
                }
                var outline = glyph.parse_glyph(rdr, info, gid);
                var cov = rast.rasterize_glyph(outline, scale);
                if (cov.width > 0 and cov.height > 0) {
                    var dst_x0 = (x_pos + (cov.x_offset as float)) as int;
                    var dst_y0 = (y_base + (cov.y_offset as float)) as int;
                    var cw = cov.width;
                    var ch = cov.height;
                    var gy = 0;
                    while (gy < ch) {
                        var dy = dst_y0 + gy;
                        if (dy >= 0 and dy < total_h) {
                            var gx = 0;
                            while (gx < cw) {
                                var coverage = cov.pixels[gy * cw + gx];
                                if (coverage > 0) {
                                    var dx = dst_x0 + gx;
                                    if (dx >= 0 and dx < total_w) {
                                        var idx = (dy * total_w + dx) * 4;
                                        var cov_f = (coverage as float) / 255.0;
                                        var alpha_f = ((c.a as float) / 255.0) * cov_f;
                                        var px_p = buf + idx;
                                        var cur_a = (ffi.load_u8(px_p + 3) as float) / 255.0;
                                        var new_a = alpha_f + cur_a * (1.0 - alpha_f);
                                        if (new_a > 0.0) {
                                            var dst_r = ffi.load_u8(px_p) as float;
                                            var dst_g = ffi.load_u8(px_p + 1) as float;
                                            var dst_b = ffi.load_u8(px_p + 2) as float;
                                            var nr = ((c.r as float) * alpha_f + dst_r * cur_a * (1.0 - alpha_f)) / new_a;
                                            var ng = ((c.g as float) * alpha_f + dst_g * cur_a * (1.0 - alpha_f)) / new_a;
                                            var nb = ((c.b as float) * alpha_f + dst_b * cur_a * (1.0 - alpha_f)) / new_a;
                                            ffi.store_u8(px_p, (nr + 0.5) as int);
                                            ffi.store_u8(px_p + 1, (ng + 0.5) as int);
                                            ffi.store_u8(px_p + 2, (nb + 0.5) as int);
                                            ffi.store_u8(px_p + 3, (new_a * 255.0 + 0.5) as int);
                                        }
                                    }
                                }
                                gx = gx + 1;
                            }
                        }
                        gy = gy + 1;
                    }
                }
                var hmet = info.get_glyph_hmetrics(rdr, gid);
                x_pos = x_pos + ((hmet[0] as float) * scale);
                prev_gid = gid;
            }

            return ok(image.Image(w=total_w, h=total_h, c=4, p=buf));
        }
    }
}

// ── System font detection ────────────────────────────────────────────────
// Native port of the previous stb_wrapper detect_system_font_path:
// preferred name searched in platform font dirs, then a fallback list.

fn _font_dirs(): [str] {
    var dirs: [str] = [];
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        dirs.append("C:/Windows/Fonts/");
        dirs.append("C:/WinNT/Fonts/");
    } elif (osid.TARGET_OS == osid.OS_MACOS) {
        dirs.append("/System/Library/Fonts/");
        dirs.append("/Library/Fonts/");
        dirs.append("/System/Library/Fonts/Supplemental/");
    } else {
        dirs.append("/usr/share/fonts/truetype/dejavu/");
        dirs.append("/usr/share/fonts/TTF/");
        dirs.append("/usr/share/fonts/truetype/liberation/");
        dirs.append("/usr/share/fonts/truetype/freefont/");
        dirs.append("/usr/share/fonts/truetype/ubuntu/");
        dirs.append("/usr/share/fonts/");
        dirs.append("/usr/local/share/fonts/");
    }
    return dirs;
}

fn _file_exists(path: str): int {
    var f = _iof.open(path, "rb")? else { return 0; };
    f.close()? else { return 0; };
    return 1;
}

fn _has_font_ext(name: str): int {
    // True when `name` already ends in .ttf/.ttc/.otf (any case).
    var n = len(name);
    if (n < 4) { return 0; }
    if ((name[n - 4] as int) != 46) { return 0; } // '.'
    var e3 = (name[n - 3] as int) | 32;
    var e2 = (name[n - 2] as int) | 32;
    var e1 = (name[n - 1] as int) | 32;
    if (e3 == 116 and e2 == 116 and (e1 == 102 or e1 == 99)) { return 1; } // .ttf/.ttc
    if (e3 == 111 and e2 == 116 and e1 == 102) { return 1; }                // .otf
    return 0;
}

pub fn detect_system_font(preferred_name: str = ""): str {
    var dirs = _font_dirs();
    if (preferred_name != "") {
        var i = 0;
        while (i < len(dirs)) {
            var p1 = dirs[i] + preferred_name;
            if (_file_exists(p1) != 0) { return p1; }
            if (_has_font_ext(preferred_name) == 0) {
                var p2 = dirs[i] + preferred_name + ".ttf";
                if (_file_exists(p2) != 0) { return p2; }
            }
            i = i + 1;
        }
    }
    var fallbacks: [str] = [];
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        fallbacks.append("C:/Windows/Fonts/segoeui.ttf");
        fallbacks.append("C:/Windows/Fonts/arial.ttf");
        fallbacks.append("C:/Windows/Fonts/tahoma.ttf");
        fallbacks.append("C:/Windows/Fonts/calibri.ttf");
        fallbacks.append("C:/Windows/Fonts/consola.ttf");
    } elif (osid.TARGET_OS == osid.OS_MACOS) {
        fallbacks.append("/System/Library/Fonts/SFNS.ttf");
        fallbacks.append("/System/Library/Fonts/Helvetica.ttc");
        fallbacks.append("/Library/Fonts/Arial.ttf");
        fallbacks.append("/System/Library/Fonts/Supplemental/Arial.ttf");
    } else {
        fallbacks.append("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
        fallbacks.append("/usr/share/fonts/TTF/DejaVuSans.ttf");
        fallbacks.append("/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf");
        fallbacks.append("/usr/share/fonts/truetype/freefont/FreeSans.ttf");
        fallbacks.append("/usr/share/fonts/truetype/ubuntu/Ubuntu-R.ttf");
    }
    i = 0;
    while (i < len(fallbacks)) {
        if (_file_exists(fallbacks[i]) != 0) { return fallbacks[i]; }
        i = i + 1;
    }
    return "";
}

pub fn load_font(filepath: str): Font? {
    // Same pipeline as std.font.load_font, but resolved through this
    // module's own tables/reader aliases — naming fnt.Font here would
    // leak std.font's private `t`/`r` import aliases into this scope.
    var file = _iof.open(filepath, "rb")? else { return err(); };
    var bytes = file.read_bytes()? else { return err(); };
    file.close()? else { return err(); };

    var rdr = reader.ByteReader(bytes);
    var font_offset = tables.get_font_offset(rdr, 0);
    if (font_offset < 0) { return err(); }
    rdr.seek(font_offset);
    match (tables.parse_tables(rdr)) {
        val info => { return ok(Font(path=filepath, info=info, rdr=rdr)); },
        err e => { return err(); }
    }
}

pub fn load_system_font(preferred_name: str = ""): Font? {
    var path: str = detect_system_font(preferred_name);
    if (path == "") {
        return err();
    }
    return load_font(path);
}
