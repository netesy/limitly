// Standard Library I/O Reader Submodule

import std.resource show Resource, Reader;

trait Reader {
    fn read(args: [any]): any;
}

frame StreamReader : Reader {
    pub var r: Reader;

    pub init(resource: Resource) {
        self.r = Reader(resource);
    }

    pub fn read(args: [any]): any {
        return self.r.read(args);
    }
}
