// Standard Library I/O Writer Submodule

import std.resource show Resource, Writer;

trait Writer {
    fn write(args: [any]): any;
}

frame StreamWriter : Writer {
    pub var w: Writer;

    pub init(resource: Resource) {
        self.w = Writer(resource);
    }

    pub fn write(args: [any]): any {
        return self.w.write(args);
    }
}
