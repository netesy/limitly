// std/io/writer.lm
// Abstract writer interface for character and byte streams.

import std.resource show Resource, Writer;

/// Contract for writable stream handles.
trait Writer {
    /// Writes argument data to the underlying stream.
    ///
    /// @param args Data payload list.
    /// @return Fallible unit completion.
    fn write(args: [any]): nil?;
}

/// Stream writer wrapper around an operating system resource handle.
frame StreamWriter : Writer {
    pub var w: Writer;

    pub init(resource: Resource) {
        self.w = Writer(resource);
    }

    /// Writes data payload list to the underlying resource handle.
    ///
    /// @param args Data arguments to write.
    /// @return Fallible unit completion.
    pub fn write(args: [any]): nil? {
        var success = self.w.write(args);
        if (success == nil) return err();
        return ok(nil);
    }
}
