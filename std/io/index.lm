// std/io/index.lm
// Public entrypoint and facade for std.io. Input/output, console, file, and stream abstractions.

/// Input/Output (I/O) module providing standard console streams, file handles,
/// filesystem queries, and stream readers/writers.
///
/// @example
/// import std.io as io;
/// io.print("Hello from std.io!");
/// if (io.exists("config.txt")) {
///     var f = io.open("config.txt", "r")? else { return; };
///     var text = f.read()? else { return; };
///     f.close();
/// }

import std.io.console as console;
import std.io.file as file;
import std.resource as res;

pub import std.io.console show Console;
pub import std.io.file show File, IOError;
pub import std.io.reader show Reader;
pub import std.io.writer show Writer;

/// Instantiates a file stream binding directly to an existing operating system resource handle.
///
/// @param p Filesystem path.
/// @param r Resource handle.
/// @return Configured `File` handle.
pub fn create_file_resource(p: str, r: res.Resource): file.File {
    return file.File(p, r);
}

/// Global standard console instance.
pub var out: Console = console.Console();

/// Opens a file at the specified path with the given access mode ('r', 'w', 'a').
///
/// @pre len(path) > 0 and len(mode) > 0
/// @param path Relative or absolute path to the file.
/// @param mode Access mode string.
/// @return Fallible `File` handle.
pub fn open(path: str, mode: str): file.File? {
    contract(len(path) > 0 and len(mode) > 0, "Path and mode must not be empty");
    return file.open(path, mode);
}

/// Prints a string message to standard output.
///
/// @param msg Message to display.
pub fn print(msg: str): nil {
    var w = res.Writer(res.stdout);
    w.write([msg]);
}

/// Internal file system resource wrapper for path operations.
frame FileSystem {
    pub resource: res.Resource;

    pub init(r: res.Resource) {
        self.resource = r;
    }

    pub fn exists(path: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_EXISTS, args=[path]);
        return (result == true);
    }

    pub fn delete(path: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_DELETE, args=[path]);
        return (result == true);
    }

    pub fn rename(old: str, new: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_RENAME, args=[old, new]);
        return (result == true);
    }

    pub fn mkdir(path: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_MKDIR, args=[path]);
        return (result == true);
    }

    pub fn readdir(path: str): any {
        return res._call(h=self.resource.handle, op=res.OP_READDIR, args=[path]);
    }
}

/// Checks whether a file or directory exists at the given path.
///
/// @pre len(path) > 0
/// @param path Candidate filesystem path.
/// @return True if target exists, false otherwise.
pub fn exists(path: str): bool {
    contract(len(path) > 0, "Path must not be empty");
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r);
            var result = fs.exists(path);
            r.close();
            return result;
        },
        err e => return false
    }
}

/// Deletes a file or empty directory at the given path.
///
/// @pre len(path) > 0
/// @param path Path to delete.
/// @return True if deletion succeeded, false otherwise.
pub fn delete(path: str): bool {
    contract(len(path) > 0, "Path must not be empty");
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r);
            var result = fs.delete(path);
            r.close();
            return result;
        },
        err e => return false
    }
}

/// Renames or moves a file or directory from `old_path` to `new_path`.
///
/// @pre len(old_path) > 0 and len(new_path) > 0
/// @param old_path Source path.
/// @param new_path Target destination path.
/// @return True if rename succeeded, false otherwise.
pub fn rename(old_path: str, new_path: str): bool {
    contract(len(old_path) > 0 and len(new_path) > 0, "Source and destination paths must not be empty");
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r);
            var result = fs.rename(old_path, new_path);
            r.close();
            return result;
        },
        err e => return false
    }
}

/// Creates a new directory at the specified path.
///
/// @pre len(path) > 0
/// @param path Directory path to create.
/// @return Fallible unit result.
pub fn create_directory(path: str): nil? {
    contract(len(path) > 0, "Directory path must not be empty");
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r);
            var result = fs.mkdir(path);
            r.close();
            if (result) return ok(nil);
            return err();
        },
        err e => {
            return err();
        }
    }
}

/// Lists directory entries as a list of filename strings.
///
/// @pre len(path) > 0
/// @param path Directory path to inspect.
/// @return Fallible list of directory entry names.
pub fn list_directory(path: str): [str]? {
    contract(len(path) > 0, "Directory path must not be empty");
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r);
            var result = fs.readdir(path);
            r.close();
            if (result == nil) {
                return err();
            } else {
                var s = result as str;
                var parts: [str] = [];
                var current = "";
                for (var i = 0; i < len(s); i = i + 1) {
                    var ch = _builtin_substring(s, i, i + 1);
                    if (ch == "\n") {
                        if (len(current) > 0) parts.append(current);
                        current = "";
                    } else {
                        current = current + ch;
                    }
                }
                if (len(current) > 0) parts.append(current);
                return ok(parts);
            }
        },
        err e => {
            return err();
        }
    }
}
