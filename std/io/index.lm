// Standard Library I/O Entrypoint Module

import std.io.console;
import std.io.file;
import std.io.reader;
import std.io.writer;
import std.resource as res;

// Re-exports
pub import std.io.console show Console;
pub import std.io.file show File;
pub import std.io.reader show Reader;
pub import std.io.writer show Writer;

pub fn create_file_resource(p: str, r: res.Resource): file.File {
    return file.File(p, r);
}

// Global Variables
pub var out: Console = console.Console();

// Functions Re-exports
pub fn open(path: str, mode: str): any {
    return file.open(path, mode);
}

pub fn print(msg: any): nil {
    var w = res.ResourceWriter(res.stdout);
    w.write([msg]);
}

frame FileSystem {
    pub resource: res.Resource;
    pub init(r: res.Resource) { self.resource = r; }
    pub fn exists(path: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_EXISTS, args=[path]);
        return (result == true);
    }
    pub fn delete(path: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_DELETE, args=[path]);
        return (result == true);
    }
    pub fn rename(old: str, new: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_RENAME, args=[old, new]);
        return (result == true);
    }
    pub fn mkdir(path: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_MKDIR, args=[path]);
        return (result == true);
    }
    pub fn readdir(path: str): any {
        return res._call(h=self.resource.handle, op=res.OP_READDIR, args=[path]);
    }
}

pub fn exists(path: str): bool {
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r);
            var result = fs.exists(path);
            r.close();
            return result;
        },
        err e => return false
    }
}

pub fn delete(path: str): bool {
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r);
            var result = fs.delete(path);
            r.close();
            return result;
        },
        err e => return false
    }
}

pub fn rename(old_path: str, new_path: str): bool {
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r);
            var result = fs.rename(old_path, new_path);
            r.close();
            return result;
        },
        err e => return false
    }
}

pub fn create_directory(path: str): any {
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r);
            var result = fs.mkdir(path);
            r.close();
            if (result) return ok(nil);
            var unknown_e = file.UnknownError(message="fail");
            return err(unknown_e);
        },
        err e => {
            var unknown_e2 = file.UnknownError(message="fail");
            return err(unknown_e2);
        }
    }
}

pub fn list_directory(path: str): any {
    var final_result: any = nil;
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r);
            var result = fs.readdir(path);
            r.close();
            if (result == nil) {
                var unknown_e = file.UnknownError(message="fail");
                final_result = err(unknown_e);
            } else {
                var s = result as str;
                var parts: [str] = [];
                var current = "";
                for (var i = 0; i < len(s); i = i + 1) {
                    var ch = substring(s, i, i + 1);
                    if (ch == "\n") {
                        if (len(current) > 0) parts.append(current);
                        current = "";
                    } else {
                        current = current + ch;
                    }
                }
                if (len(current) > 0) parts.append(current);
                final_result = ok(parts);
            }
        },
        err e => {
            var unknown_e2 = file.UnknownError(message="fail");
            final_result = err(unknown_e2);
        }
    }
    return final_result;
}
