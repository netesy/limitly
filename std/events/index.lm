// std/events
// Typed OS/window event pump and per-frame event queue.
//
// This is the SINGLE translation point from raw gg.poll_events() records into
// typed Event values. Both std.app (Fluent ui_context dispatch) and std.game
// (InputManager/IMGUI) consume the SAME per-frame event stream — neither
// calls gg.poll_events() directly, so events are never stolen between
// frameworks.
//
// Fan-out model: pump_events() builds a fresh event_queue once per frame.
// Every consumer reads events.pending_events() non-destructively, so any
// number of frameworks can observe the same stream. Events pushed via
// push_event() land in injected_events and are merged into the queue at the
// next pump — they live exactly one frame.
//
// pump_events() is also the frame-publish boundary on the GPU backend, so it
// must run exactly once per frame.

import std.gg as gg;

// Event type enumeration
enum EventType {
    Quit,
    Resize,
    KeyDown,
    KeyUp,
    MouseDown,
    MouseUp,
    MouseMove,
    Char,
    MouseWheel
}

fn event_type_from_int(code: int): EventType {
    match (code) {
        0 => { return EventType.Quit; },
        1 => { return EventType.Resize; },
        2 => { return EventType.KeyDown; },
        3 => { return EventType.KeyUp; },
        4 => { return EventType.MouseDown; },
        5 => { return EventType.MouseUp; },
        6 => { return EventType.MouseMove; },
        7 => { return EventType.Char; },
        8 => { return EventType.MouseWheel; },
        _ => { return EventType.Quit; }
    }
}

// Key Modifier Enumeration
enum KeyModifier {
    Shift,
    Control,
    Alt,
    Super
}

// Modifier key flags
pub const MOD_SHIFT: int = 1;
pub const MOD_CONTROL: int = 2;
pub const MOD_ALT: int = 4;
pub const MOD_SUPER: int = 8;

// Event frame
frame Event {
    pub var event_type: EventType;
    pub var timestamp: int;
    pub var window_id: int;
    pub var x: int;
    pub var y: int;
    pub var key_code: int;
    pub var xdest: int;
    pub var ydest: int;

    pub init(event_type: EventType = EventType.Quit, timestamp: int = 0, window_id: int = 0, x: int = 0, y: int = 0, key_code: int = 0, xdest: int = 0, ydest: int = 0) {
        self.event_type = event_type;
        self.timestamp = timestamp;
        self.window_id = window_id;
        self.x = x;
        self.y = y;
        self.key_code = key_code;
        self.xdest = xdest;
        self.ydest = ydest;
    }
}

// Key event frame
frame KeyEvent {
    embed Event;
    pub var modifiers: int;
    pub var repeat: int;
}

// Mouse event frame
frame MouseEvent {
    embed Event;
    pub var button: int;
    pub var modifiers: int;
}

// Resize event frame
frame ResizeEvent {
    embed Event;
    pub var width: int;
    pub var height: int;
    pub var framebuffer_width: int;
    pub var framebuffer_height: int;
}

// event_queue holds the CURRENT frame's events (injected + native, merged by
// pump_events). injected_events holds events pushed between pumps; they are
// merged into event_queue on the next pump and then cleared.
pub var event_queue: [Event] = [] as [Event];
pub var injected_events: [Event] = [] as [Event];

// Reset both queues (call on app/window init and shutdown).
pub fn clear(): nil {
    event_queue = [] as [Event];
    injected_events = [] as [Event];
}

// The current frame's event list. Returns a copy — read-only for consumers,
// safe to hold across the next pump_events() (which replaces event_queue).
// Every consumer sees the same stream.
pub fn pending_events(): [Event] {
    var out: [Event] = [] as [Event];
    var i: int = 0;
    while (i < len(event_queue)) {
        out.append(event_queue[i]);
        i = i + 1;
    }
    return out;
}

// pump_events builds this frame's queue: it merges injected_events (synthetic
// pushes since the last pump) with freshly decoded native events from
// gg.poll_events(), then clears injected_events. It is the ONLY caller of
// gg.poll_events() above the gg layer — and the frame-publish boundary on the
// GPU backend — so it must run exactly once per frame.
pub fn pump_events(): nil {
    // Copy injected events into the new frame queue — never move the module
    // bindings (the ownership checker rejects reassigning a moved binding).
    var q: [Event] = [] as [Event];
    var inj_i: int = 0;
    while (inj_i < len(injected_events)) {
        q.append(injected_events[inj_i]);
        inj_i = inj_i + 1;
    }
    injected_events = [] as [Event];

    var raw_events = gg.poll_events();
    if (raw_events != nil) {
        var native_events: [int] = raw_events as [int];
        var i: int = 0;
        var num_events = len(native_events);
        while (i + 3 < num_events) {
            var ev_code: int = native_events[i];
            var ev_x: int = native_events[i + 1];
            var ev_y: int = native_events[i + 2];
            var ev_k: int = native_events[i + 3];
            var ev_type: EventType = event_type_from_int(ev_code);
            q.append(Event(event_type=ev_type, timestamp=0, window_id=1, x=ev_x, y=ev_y, key_code=ev_k));
            i = i + 4;
        }
    }

    event_queue = q;
}

// Queue a synthetic event for delivery at the next pump_events().
pub fn push_event(event: Event): nil {
    injected_events.append(event);
}

pub fn push_mouse_click(x: int, y: int): nil {
    push_event(Event(event_type=EventType.MouseDown, timestamp=0, window_id=1, x=x, y=y, key_code=0));
    push_event(Event(event_type=EventType.MouseUp, timestamp=0, window_id=1, x=x, y=y, key_code=0));
}

pub fn push_quit_event(): nil {
    push_event(Event(event_type=EventType.Quit, timestamp=0, window_id=1, x=0, y=0));
}
