// std/algorithms/index.lm
// Compatibility re-export for std.algorithm

import std.algorithm as algo;

pub fn is_prime(n: int): bool {
    return algo.is_prime(n);
}

pub fn sort(items: [any]) {
    algo.sort(items);
}

pub fn find(items: [any], value: any): int {
    return algo.find(items, value);
}

pub fn binary_search(items: [any], value: any): int {
    return algo.binary_search(items, value);
}
