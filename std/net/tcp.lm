// Standard Library Networking Module (Unified Resource System)

import std.core as core;

frame TCP {
    pub fn connect(address: str, port: int): core.ResultInt {
        var h = resource_create(1); // RT_SOCKET
        if (h == -1) return core.err_int("Failed to create socket resource");
        
        var success = resource_call(h, 6, address, port); // OP_CONNECT
        if (!success) {
            resource_destroy(h);
            return core.err_int("Failed to connect to " + address);
        }
        
        return core.ok_int(h);
    }

    pub fn send(handle: int, data: str): core.ResultInt {
        var bytes = resource_call(handle, 4, data); // OP_SEND
        if (bytes == nil) return core.err_int("Send failed");
        return core.ok_int(bytes as int);
    }

    pub fn recv(handle: int): core.ResultStr {
        var data = resource_call(handle, 5); // OP_RECEIVE
        if (data == nil) return core.err_str("Receive failed");
        return core.ok_str(data as str);
    }

    pub fn close(handle: int): core.ResultInt {
        resource_call(handle, 1); // OP_CLOSE
        resource_destroy(handle);
        return core.ok_int(0);
    }
}
