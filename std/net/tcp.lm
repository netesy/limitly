// Standard Library TCP Module (Unified Resource System)
// Supports both client and server operations.

import std.core as core;

var RT_SOCKET: int = 1;
var OP_CLOSE: int = 1;
var OP_SEND: int = 4;
var OP_RECEIVE: int = 5;
var OP_CONNECT: int = 6;
var OP_BIND: int = 23;
var OP_LISTEN: int = 24;
var OP_ACCEPT: int = 25;
var OP_POLL: int = 10;

frame TCPClient {
    pub var handle: int;

    pub fn init() {
        self.handle = -1;
    }

    // Connect to a remote host:port
    pub fn connect(address: str, port: int): int?core.Error {
        var h = resource_create(RT_SOCKET, []);
        if (h == -1) return err(core.Error { code: "ERR", message: "Failed to create socket resource" });

        var success = resource_call(h, OP_CONNECT, [address, port]);
        if (success != true) {
            resource_destroy(h);
            return err(core.Error { code: "ERR", message: "Failed to connect to " + address + ":" + port as str });
        }

        self.handle = h;
        return ok(h);
    }

    // Send raw string data over the connection
    pub fn send(data: str): int?core.Error {
        if (self.handle <= 0) return err(core.Error { code: "ERR", message: "socket not connected" });
        var result = resource_call(self.handle, OP_SEND, [data]);
        if (result == true) return ok(len(data));
        return err(core.Error { code: "ERR", message: "send failed" });
    }

    // Receive data from the connection (up to 64KB)
    pub fn recv(): str?core.Error {
        if (self.handle <= 0) return err(core.Error { code: "ERR", message: "socket not connected" });
        var data = resource_call(self.handle, OP_RECEIVE, []);
        if (data == nil) return err(core.Error { code: "ERR", message: "connection closed or recv failed" });
        return ok(data as str);
    }

    // Check if data is available to read (non-blocking)
    pub fn has_data(): bool {
        if (self.handle <= 0) return false;
        var result = resource_call(self.handle, OP_POLL, []);
        return result == true;
    }

    // Close the connection
    pub fn close(): nil?core.Error {
        if (self.handle <= 0) return ok(nil);
        resource_call(self.handle, OP_CLOSE, []);
        resource_destroy(self.handle);
        self.handle = -1;
        return ok(nil);
    }

    // Check if the socket is connected
    pub fn is_connected(): bool {
        return self.handle > 0;
    }
}

frame TCPServer {
    pub var handle: int;

    pub fn init() {
        self.handle = -1;
    }

    // Bind to a specific address and port
    pub fn bind(address: str, port: int): int?core.Error {
        var h = resource_create(RT_SOCKET, []);
        if (h == -1) return err(core.Error { code: "ERR", message: "Failed to create socket" });

        var success = resource_call(h, OP_BIND, [address, port]);
        if (success != true) {
            resource_destroy(h);
            return err(core.Error { code: "ERR", message: "Failed to bind to " + address + ":" + port as str });
        }
        self.handle = h;
        return ok(h);
    }

    // Listen for incoming connections
    pub fn listen(backlog: int): int?core.Error {
        if (self.handle <= 0) return err(core.Error { code: "ERR", message: "socket not bound" });
        var success = resource_call(self.handle, OP_LISTEN, [backlog]);
        if (success != true) return err(core.Error { code: "ERR", message: "listen failed" });
        return ok(self.handle);
    }

    // Accept a new connection, returns a TCPClient
    pub fn accept(): TCPClient?core.Error {
        if (self.handle <= 0) return err(core.Error { code: "ERR", message: "socket not listening" });
        var client_fd = resource_call(self.handle, OP_ACCEPT, []);
        if (client_fd == nil) return err(core.Error { code: "ERR", message: "accept failed or no pending connection" });

        // Create a new socket resource wrapping the accepted fd
        var client_handle = resource_create(RT_SOCKET, [client_fd]);
        if (client_handle == -1) return err(core.Error { code: "ERR", message: "failed to adopt client socket" });

        var client = TCPClient();
        client.handle = client_handle;
        return ok(client);
    }

    // Close the server socket
    pub fn close(): nil?core.Error {
        if (self.handle <= 0) return ok(nil);
        resource_call(self.handle, OP_CLOSE, []);
        resource_destroy(self.handle);
        self.handle = -1;
        return ok(nil);
    }
}
