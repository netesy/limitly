// Standard Library TCP Module

import std.core as core;
import std.core show Error;
import std.resource as res;

frame Connector {
    var resource: res.Resource;
    pub init(r: res.Resource) { self.resource = r; }
    pub fn connect(args: [any]): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_CONNECT, args=args);
        return (result == true);
    }
}

frame Binder {
    var resource: res.Resource;
    pub init(r: res.Resource) { self.resource = r; }
    pub fn bind(args: [any]): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_BIND, args=args);
        return (result == true);
    }
}

frame Listener {
    var resource: res.Resource;
    pub init(r: res.Resource) { self.resource = r; }
    pub fn listen(args: [any]): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_LISTEN, args=args);
        return (result == true);
    }
}

frame Accepter {
    var resource: res.Resource;
    pub init(r: res.Resource) { self.resource = r; }
    pub fn accept(): int {
        var result = res._call(h=self.resource.handle, op=res.OP_ACCEPT, args=[]);
        if (result == nil) return -1;
        return result as int;
    }
}

frame TCPClient {
    pub var resource: res.Resource?;
    pub var reader: res.Reader?;
    pub var writer: res.Writer?;
    pub var poller: res.Pollable?;

    pub fn init() {
        self.resource = nil;
        self.reader = nil;
        self.writer = nil;
        self.poller = nil;
    }

    pub fn connect(address: str, port: int): int?core.Error {
        match (res.create_socket()) {
            val r => {
                var c = Connector(r=r);
                if (c.connect(args=[address, port])) {
                    self.resource = r;
                    self.reader = res.Reader(r=r);
                    self.writer = res.Writer(r=r);
                    self.poller = res.Pollable(r=r);
                    return ok(r.handle);
                }
                r.close();
                return err(Error(code="ERR", message="fail"));
            },
            err e => {
                return err(Error(code="ERR", message="fail"));
            }
        }
    }

    pub fn send(data: str): int?core.Error {
        match (self.writer) {
            val w => {
                var result = w.write(args=[data]);
                if (result == true) {
                    return ok(len(data));
                }
                return err(Error(code="ERR", message="fail"));
            },
            nil => {
                return err(Error(code="ERR", message="fail"));
            }
        }
    }

    pub fn recv(): str?core.Error {
        match (self.reader) {
            val rd => {
                var data = rd.read(args=[]);
                if (data == nil) {
                    return err(Error(code="ERR", message="fail"));
                }
                return ok(data as str);
            },
            nil => {
                return err(Error(code="ERR", message="fail"));
            }
        }
    }

    pub fn has_data(): bool {
        match (self.poller) {
            val p => return p.poll(),
            nil => return false
        }
    }

    pub fn close(): nil?core.Error {
        match (self.resource) {
            val r => {
                r.close();
                self.resource = nil;
                self.reader = nil;
                self.writer = nil;
                self.poller = nil;
                return ok(nil);
            },
            nil => return ok(nil)
        }
    }

    pub fn is_connected(): bool {
        match (self.resource) {
            val r => return r.is_open(),
            nil => return false
        }
    }

    pub fn handle(): int {
        match (self.resource) {
            val r => return r.handle,
            nil => return -1
        }
    }
}

frame TCPServer {
    pub var resource: res.Resource?;
    pub var binder: Binder?;
    pub var listener: Listener?;
    pub var accepter: Accepter?;

    pub fn init() {
        self.resource = nil;
        self.binder = nil;
        self.listener = nil;
        self.accepter = nil;
    }

    pub fn bind(address: str, port: int): int?core.Error {
        match (res.create_socket()) {
            val r => {
                var b = Binder(r=r);
                if (b.bind(args=[address, port])) {
                    self.resource = r;
                    self.binder = b;
                    return ok(r.handle);
                }
                r.close();
                return err(Error(code="ERR", message="fail"));
            },
            err e => {
                return err(Error(code="ERR", message="fail"));
            }
        }
    }

    pub fn listen(backlog: int): int?core.Error {
        match (self.resource) {
            val r => {
                var l = Listener(r=r);
                if (l.listen(args=[backlog])) {
                    self.listener = l;
                    self.accepter = Accepter(r=r);
                    return ok(r.handle);
                }
                return err(Error(code="ERR", message="fail"));
            },
            nil => {
                return err(Error(code="ERR", message="fail"));
            }
        }
    }

    pub fn accept(): TCPClient?core.Error {
        match (self.accepter) {
            val acc => {
                var fd = acc.accept();
                if (fd == -1) {
                    return err(Error(code="ERR", message="fail"));
                }
                var cr = res.adopt_socket(fd=fd);
                var client = TCPClient();
                client.resource = cr;
                client.reader = res.Reader(r=cr);
                client.writer = res.Writer(r=cr);
                client.poller = res.Pollable(r=cr);
                return ok(client);
            },
            nil => {
                return err(Error(code="ERR", message="fail"));
            }
        }
    }

    pub fn close(): nil?core.Error {
        match (self.resource) {
            val r => {
                r.close();
                self.resource = nil;
                self.binder = nil;
                self.listener = nil;
                self.accepter = nil;
                return ok(nil);
            },
            nil => return ok(nil)
        }
    }
}
