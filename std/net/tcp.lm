// Standard Library TCP Module (Unified Resource System)
// Supports both client and server operations.

import std.core as core;
import std.resource as res;

frame TCPClient {
    var resource: res.Resource?;
    var reader: res.Reader?;
    var writer: res.Writer?;
    var connector: res.Connector?;
    var poller: res.Poller?;

    pub fn init() {
        self.resource = nil;
        self.reader = nil;
        self.writer = nil;
        self.connector = nil;
        self.poller = nil;
    }

    // Connect to a remote host:port
    pub fn connect(address: str, port: int): int?core.Error {
        match (res.create_socket()) {
            case ok(r) => {
                var connector = res.Connector(r);
                if (connector.connect([address, port])) {
                    self.resource = ok(r);
                    self.reader = ok(res.Reader(r));
                    self.writer = ok(res.Writer(r));
                    self.connector = ok(connector);
                    self.poller = ok(res.Poller(r));
                    return ok(r._handle());
                } else {
                    r.close();
                    return err(core.Error { code: "ERR", message: "Failed to connect to " + address + ":" + port as str });
                }
            }
            case err(e) => return err(core.Error { code: "ERR", message: "Failed to create socket resource" });
        }
    }

    // Send raw string data over the connection
    pub fn send(data: str): int?core.Error {
        match (self.writer) {
            case ok(w) => {
                var result = w.write([data]);
                if (result == true) return ok(len(data));
                return err(core.Error { code: "ERR", message: "send failed" });
            }
            case nil => return err(core.Error { code: "ERR", message: "socket not connected" });
        }
    }

    // Receive data from the connection (up to 64KB)
    pub fn recv(): str?core.Error {
        match (self.reader) {
            case ok(rd) => {
                var data = rd.read([]);
                if (data == nil) return err(core.Error { code: "ERR", message: "connection closed or recv failed" });
                return ok(data as str);
            }
            case nil => return err(core.Error { code: "ERR", message: "socket not connected" });
        }
    }

    // Check if data is available to read (non-blocking)
    pub fn has_data(): bool {
        match (self.poller) {
            case ok(p) => return p.poll();
            case nil => return false;
        }
    }

    // Close the connection
    pub fn close(): nil?core.Error {
        match (self.resource) {
            case ok(r) => {
                r.close();
                self.resource = nil;
                self.reader = nil;
                self.writer = nil;
                self.connector = nil;
                self.poller = nil;
                return ok(nil);
            }
            case nil => return ok(nil);
        }
    }

    // Check if the socket is connected
    pub fn is_connected(): bool {
        match (self.resource) {
            case ok(r) => return r.is_open();
            case nil => return false;
        }
    }

    pub fn handle(): int {
        match (self.resource) {
            case ok(r) => return r._handle();
            case nil => return -1;
        }
    }
}

frame TCPServer {
    var resource: res.Resource?;
    var binder: res.Binder?;
    var listener: res.Listener?;
    var accepter: res.Accepter?;

    pub fn init() {
        self.resource = nil;
        self.binder = nil;
        self.listener = nil;
        self.accepter = nil;
    }

    // Bind to a specific address and port
    pub fn bind(address: str, port: int): int?core.Error {
        match (res.create_socket()) {
            case ok(r) => {
                var binder = res.Binder(r);
                if (binder.bind([address, port])) {
                    self.resource = ok(r);
                    self.binder = ok(binder);
                    return ok(r._handle());
                } else {
                    r.close();
                    return err(core.Error { code: "ERR", message: "Failed to bind to " + address + ":" + port as str });
                }
            }
            case err(e) => return err(core.Error { code: "ERR", message: "Failed to create socket" });
        }
    }

    // Listen for incoming connections
    pub fn listen(backlog: int): int?core.Error {
        match (self.resource) {
            case ok(r) => {
                var listener = res.Listener(r);
                if (listener.listen([backlog])) {
                    self.listener = ok(listener);
                    self.accepter = ok(res.Accepter(r));
                    return ok(r._handle());
                } else {
                    return err(core.Error { code: "ERR", message: "listen failed" });
                }
            }
            case nil => return err(core.Error { code: "ERR", message: "socket not bound" });
        }
    }

    // Accept a new connection, returns a TCPClient
    pub fn accept(): TCPClient?core.Error {
        match (self.accepter) {
            case ok(acc) => {
                var client_fd = acc.accept();
                if (client_fd == -1) return err(core.Error { code: "ERR", message: "accept failed or no pending connection" });

                var cr = res.adopt_socket(client_fd);
                var client = TCPClient();
                client.resource = ok(cr);
                client.reader = ok(res.Reader(cr));
                client.writer = ok(res.Writer(cr));
                client.poller = ok(res.Poller(cr));
                return ok(client);
            }
            case nil => return err(core.Error { code: "ERR", message: "socket not listening" });
        }
    }

    // Close the server socket
    pub fn close(): nil?core.Error {
        match (self.resource) {
            case ok(r) => {
                r.close();
                self.resource = nil;
                self.binder = nil;
                self.listener = nil;
                self.accepter = nil;
                return ok(nil);
            }
            case nil => return ok(nil);
        }
    }

    pub fn handle(): int {
        match (self.resource) {
            case ok(r) => return r._handle();
            case nil => return -1;
        }
    }
}
