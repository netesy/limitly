// TLS (Transport Layer Security) Abstraction Module
// Provides a frame-based API for TLS/SSL connections.
// Note: The current VM resource manager does not have a native TLS resource type.
// This module provides the API surface and a clear path to native TLS integration.
// When a native TLS resource type is added, this module will delegate to it.
// For now, it documents the full API and provides TCP passthrough.

import std.core as core;
import std.net.tcp as tcp;
import std.resource as res;

frame TLSConfig {
    pub var cert_path: str;
    pub var key_path: str;
    pub var ca_path: str;
    pub var verify_peer: bool;
    pub var min_version: str;  // "1.2", "1.3"
    pub var server_name: str; // SNI

    pub fn init() {
        self.cert_path = "";
        self.key_path = "";
        self.ca_path = "";
        self.verify_peer = true;
        self.min_version = "1.2";
        self.server_name = "";
    }

    pub fn with_cert(cert_path: str): TLSConfig {
        self.cert_path = cert_path;
        return self;
    }

    pub fn with_key(key_path: str): TLSConfig {
        self.key_path = key_path;
        return self;
    }

    pub fn with_ca(ca_path: str): TLSConfig {
        self.ca_path = ca_path;
        return self;
    }

    pub fn with_verify(verify: bool): TLSConfig {
        self.verify_peer = verify;
        return self;
    }

    pub fn with_server_name(name: str): TLSConfig {
        self.server_name = name;
        return self;
    }

    pub fn with_min_version(version: str): TLSConfig {
        self.min_version = version;
        return self;
    }
}

frame TLSClient {
    var tcp_client: tcp.TCPClient;
    var config: TLSConfig;
    var encrypted: bool;

    pub fn init(config: TLSConfig) {
        self.config = config;
        self.tcp_client = tcp.TCPClient();
        self.encrypted = false;
    }

    // Connect with TLS handshake
    pub fn connect(host: str, port: int): core.ResultInt {
        // Resolve hostname first
        var resolved = resolve_or_passthrough(host);
        if (resolved.is_err()) return core.err_int("DNS resolution failed: " + resolved.unwrap());

        // Connect TCP
        var tcp_result = self.tcp_client.connect(resolved.unwrap(), port);
        if (tcp_result.is_err()) return tcp_result;

        // TODO: When native TLS resource is available, perform TLS handshake here.
        // For now, mark as connected (unencrypted passthrough).
        self.encrypted = false;
        return core.ok_int(tcp_result.unwrap());
    }

    // Send encrypted data
    pub fn send(data: str): core.ResultInt {
        if (self.encrypted) {
            // TODO: encrypt data before sending
        }
        return self.tcp_client.send(data);
    }

    // Receive and decrypt data
    pub fn recv(): core.ResultStr {
        var result = self.tcp_client.recv();
        if (result.is_err()) return result;
        if (self.encrypted) {
            // TODO: decrypt data after receiving
        }
        return result;
    }

    // Close the TLS connection
    pub fn close(): core.ResultInt {
        return self.tcp_client.close();
    }

    pub fn is_connected(): bool {
        return self.tcp_client.is_connected();
    }

    pub fn is_encrypted(): bool {
        return self.encrypted;
    }
}

frame TLSServer {
    var tcp_server: tcp.TCPServer;
    var config: TLSConfig;
    var listening: bool;

    pub fn init(config: TLSConfig) {
        self.config = config;
        self.tcp_server = tcp.TCPServer();
        self.listening = false;
    }

    // Bind and listen with TLS
    pub fn listen(address: str, port: int, backlog: int): core.ResultInt {
        var bind_result = self.tcp_server.bind(address, port);
        if (bind_result.is_err()) return bind_result;

        var listen_result = self.tcp_server.listen(backlog);
        if (listen_result.is_err()) return listen_result;

        self.listening = true;
        return core.ok_int(bind_result.unwrap());
    }

    // Accept a new TLS connection
    pub fn accept(): core.ResultInt {
        var client_result = self.tcp_server.accept();
        if (client_result.is_err()) return core.err_int(client_result.unwrap());
        // TODO: When native TLS resource is available, perform TLS handshake here
        return core.ok_int(0);
    }

    pub fn close(): core.ResultInt {
        self.listening = false;
        return self.tcp_server.close();
    }
}

// ---- DNS helper (inline to avoid circular import) ----
fn resolve_or_passthrough(host: str): core.ResultStr {
    // Quick check for IPv4
    var has_only_digits_dots: bool = true;
    var dot_count: int = 0;
    var i: int = 0;
    while (i < len(host)) {
        var ch: str = substring(host, i, i + 1);
        if (ch == ".") {
            dot_count = dot_count + 1;
        } else if (ch < "0" or ch > "9") {
            has_only_digits_dots = false;
            i = len(host);
        }
        i = i + 1;
    }
    if (has_only_digits_dots and dot_count == 3) return core.ok_str(host);

    // Use DNS resolver
    match res.create("dns", []) {
        case ok(resolver) => {
            var result = resolver._call("resolve", [host]);
            resolver.close();
            if (result == nil) return core.err_str("DNS resolution failed for: " + host);
            return core.ok_str(result as str);
        }
        case err(e) => return core.err_str("DNS resolver unavailable");
    }
}
