// std/net/dns.lm
// DNS resolution and IP address validation module.

import std.core as core;
import std.core show Error;
import std.resource as res;

frame DNSRecord {
    pub var name: str;
    pub var record_type: str;
    pub var value: str;
    pub var ttl: int;

    pub init(name: str, record_type: str = "A", value: str = "", ttl: int = 300) {
        self.name = name;
        self.record_type = record_type;
        self.value = value;
        self.ttl = ttl;
    }
}

frame Resolver {
    pub var cache: {str: str};
    pub var timeout_ms: int;

    pub init(timeout: int = 5000) {
        self.cache = {} as {str: str};
        self.timeout_ms = timeout;
    }

    pub fn resolve(host: str): str?Error {
        if (host == "") return err(Error(code="InvalidHost", message="host cannot be empty"));
        if (self.cache[host] != nil) {
            return ok(self.cache[host]);
        }
        var r = res.create_dns_resolver()?;
        var result = res._call(h=r.handle, op=res.OP_RESOLVE, args=[host]);
        r.close();
        if (result == nil) return err(Error(code="DNSError", message="failed to resolve host: " + host));
        var ip = result as str;
        self.cache[host] = ip;
        return ok(ip);
    }

    pub fn resolve_all(host: str): [str]?Error {
        if (host == "") return err(Error(code="InvalidHost", message="host cannot be empty"));
        var single = self.resolve(host)?;
        var list: [str] = [];
        list.append(single);
        return ok(list);
    }

    pub fn resolve_or_passthrough(host: str): str?Error {
        if (is_ipv4(host) or is_ipv6(host)) return ok(host);
        return self.resolve(host);
    }

    pub fn reverse_lookup(ip: str): str?Error {
        if (!is_ipv4(ip) and !is_ipv6(ip)) {
            return err(Error(code="InvalidIP", message="not a valid IP address"));
        }
        if (ip == "127.0.0.1" or ip == "::1") return ok("localhost");
        return ok(ip);
    }

    pub fn clear_cache(): nil {
        self.cache = {} as {str: str};
    }
}

frame DNS {
    pub init() {}

    pub fn resolve(host: str): str?Error {
        return resolve(host);
    }

    pub fn resolve_all(host: str): [str]?Error {
        return resolve_all(host);
    }

    pub fn lookup(host: str): str?Error {
        return resolve(host);
    }

    pub fn is_ip(address: str): bool {
        return is_ip(address);
    }

    pub fn is_ipv4(address: str): bool {
        return is_ipv4(address);
    }

    pub fn is_ipv6(address: str): bool {
        return is_ipv6(address);
    }

    pub fn is_loopback(address: str): bool {
        return is_loopback(address);
    }

    pub fn is_private(address: str): bool {
        return is_private(address);
    }

    pub fn is_multicast(address: str): bool {
        return is_multicast(address);
    }

    pub fn parse_ipv4(address: str): [int]? {
        return parse_ipv4(address);
    }

    pub fn format_ipv4(octets: [int]): str {
        return format_ipv4(octets);
    }

    pub fn resolve_or_passthrough(host: str): str?Error {
        return resolve_or_passthrough(host);
    }

    pub fn reverse_lookup(ip: str): str?Error {
        return reverse_lookup(ip);
    }
}

pub fn resolve(host: str): str?Error {
    if (host == "") return err(Error(code="InvalidHost", message="host cannot be empty"));
    if (host == "localhost") return ok("127.0.0.1");
    var r = res.create_dns_resolver()?;
    var result = res._call(h=r.handle, op=res.OP_RESOLVE, args=[host]);
    r.close();
    if (result == nil) return err(Error(code="DNSError", message="failed to resolve host: " + host));
    return ok(result as str);
}

pub fn resolve_all(host: str): [str]?Error {
    if (host == "") return err(Error(code="InvalidHost", message="host cannot be empty"));
    var ip = resolve(host)?;
    var result: [str] = [];
    result.append(ip);
    return ok(result);
}

pub fn lookup(host: str): str?Error {
    return resolve(host);
}

pub fn resolve_or_passthrough(host: str): str?Error {
    if (is_ipv4(host) or is_ipv6(host)) return ok(host);
    return resolve(host);
}

pub fn reverse_lookup(ip: str): str?Error {
    if (!is_ipv4(ip) and !is_ipv6(ip)) {
        return err(Error(code="InvalidIP", message="not a valid IP address"));
    }
    if (ip == "127.0.0.1" or ip == "::1") return ok("localhost");
    return ok(ip);
}

pub fn is_ip(address: str): bool {
    return is_ipv4(address) or is_ipv6(address);
}

pub fn is_ipv4(address: str): bool {
    var parts: [str] = split_string(address, ".");
    if (len(parts) != 4) return false;
    var i: int = 0;
    while (i < 4) {
        var part: str = parts[i];
        if (len(part) == 0 or len(part) > 3) return false;
        var j: int = 0;
        while (j < len(part)) {
            var ch: str = _builtin_substring(part, j, j + 1);
            if (not is_digit(ch)) return false;
            j = j + 1;
        }
        var val_int: int = part as int;
        if (val_int < 0 or val_int > 255) return false;
        // Avoid leading zero for values > 0 (e.g. 01)
        if (len(part) > 1 and _builtin_substring(part, 0, 1) == "0") return false;
        i = i + 1;
    }
    return true;
}

pub fn parse_ipv4(address: str): [int]? {
    if (!is_ipv4(address)) return nil;
    var parts: [str] = split_string(address, ".");
    var octets: [int] = [];
    var i = 0;
    while (i < 4) {
        octets.append(parts[i] as int);
        i = i + 1;
    }
    return octets;
}

pub fn format_ipv4(octets: [int]): str {
    if (len(octets) != 4) return "";
    return (octets[0] as str) + "." + (octets[1] as str) + "." + (octets[2] as str) + "." + (octets[3] as str);
}

pub fn is_ipv6(address: str): bool {
    if (len(address) < 2) return false;
    var colon_count: int = 0;
    var double_colon_count: int = 0;
    var i: int = 0;
    while (i < len(address)) {
        var ch: str = _builtin_substring(address, i, i + 1);
        if (ch == ":") {
            colon_count = colon_count + 1;
            if (i + 1 < len(address) and _builtin_substring(address, i + 1, i + 2) == ":") {
                double_colon_count = double_colon_count + 1;
            }
        } elif (not is_hex_digit(ch)) {
            return false;
        }
        i = i + 1;
    }
    if (colon_count < 2) return false;
    if (double_colon_count > 1) return false;
    return true;
}

pub fn is_loopback(address: str): bool {
    if (address == "::1" or address == "0:0:0:0:0:0:0:1") return true;
    if (!is_ipv4(address)) return false;
    var octets = parse_ipv4(address);
    if (octets == nil) return false;
    var o = octets as [int];
    return o[0] == 127;
}

pub fn is_private(address: str): bool {
    if (!is_ipv4(address)) {
        if (len(address) >= 2) {
            var prefix2 = _builtin_string_to_lower(_builtin_substring(address, 0, 2));
            if (prefix2 == "fc" or prefix2 == "fd" or prefix2 == "fe") return true;
        }
        return is_loopback(address);
    }
    var octets = parse_ipv4(address);
    if (octets == nil) return false;
    var o = octets as [int];
    if (o[0] == 10) return true;
    if (o[0] == 127) return true;
    if (o[0] == 172 and o[1] >= 16 and o[1] <= 31) return true;
    if (o[0] == 192 and o[1] == 168) return true;
    if (o[0] == 169 and o[1] == 254) return true;
    return false;
}

pub fn is_multicast(address: str): bool {
    if (is_ipv4(address)) {
        var octets = parse_ipv4(address);
        if (octets == nil) return false;
        var o = octets as [int];
        return o[0] >= 224 and o[0] <= 239;
    }
    if (is_ipv6(address)) {
        return len(address) >= 2 and _builtin_string_to_lower(_builtin_substring(address, 0, 2)) == "ff";
    }
    return false;
}

fn split_string(s: str, delimiter: str): [str] {
    var parts: [str] = [] as [str];
    var current: str = "";
    var i: int = 0;
    while (i < len(s)) {
        if (_builtin_substring(s, i, i + 1) == delimiter) {
            parts.append(current);
            current = "";
        } else {
            current = current + _builtin_substring(s, i, i + 1);
        }
        i = i + 1;
    }
    parts.append(current);
    return parts;
}

fn is_digit(ch: str): bool {
    return ch >= "0" and ch <= "9";
}

fn is_hex_digit(ch: str): bool {
    if (is_digit(ch)) return true;
    if (ch >= "a" and ch <= "f") return true;
    if (ch >= "A" and ch <= "F") return true;
    return false;
}
