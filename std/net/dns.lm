// Standard Library DNS Module (Unified Resource System)
// Uses the native DNS_RESOLVER resource (type 13) with RESOLVE=26 operation.

import std.core as core;

var RT_DNS: int = 13;
var OP_RESOLVE: int = 26;

frame DNS {

    // Resolve a hostname to an IPv4 address.
    pub fn resolve(host: str): str?core.Error {
        if (host == "") return err(core.Error { code: "ERR", message: "empty host name" });
        
        var resolver = resource_create(RT_DNS, []);
        if (resolver == -1) return err(core.Error { code: "ERR", message: "failed to create DNS resolver resource" });

        var result = resource_call(resolver, OP_RESOLVE, [host]);
        resource_destroy(resolver);

        if (result == nil) return err(core.Error { code: "ERR", message: "DNS resolution failed for host: " + host });
        return ok(result as str);
    }

    // Check if a string looks like a valid IPv4 address
    pub fn is_ipv4(address: str): bool {
        var parts: [str] = split_string(address, ".");
        if (len(parts) != 4) return false;
        var i: int = 0;
        while (i < 4) {
            var part: str = parts[i];
            if (len(part) == 0 or len(part) > 3) return false;
            var j: int = 0;
            while (j < len(part)) {
                var ch: str = substring(part, j, j + 1);
                if (ch < "0" or ch > "9") return false;
                j = j + 1;
            }
            var val: int = part as int;
            if (val < 0 or val > 255) return false;
            i = i + 1;
        }
        return true;
    }

    // Check if a string looks like a valid IPv6 address (simplified)
    pub fn is_ipv6(address: str): bool {
        if (len(address) < 2) return false;
        var has_colon: bool = false;
        var i: int = 0;
        while (i < len(address)) {
            var ch: str = substring(address, i, i + 1);
            if (ch == ":") {
                has_colon = true;
            } else if (not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f") or (ch >= "A" and ch <= "F"))) {
                return false;
            }
            i = i + 1;
        }
        return has_colon;
    }

    // Resolve a hostname, handling the case where it might already be an IP.
    pub fn resolve_or_passthrough(host: str): str?core.Error {
        if (self.is_ipv4(host)) return ok(host);
        if (self.is_ipv6(host)) return ok(host);
        return self.resolve(host);
    }
}

// ---- Internal helper ----
fn split_string(s: str, delimiter: str): [str] {
    var parts: [str] = [];
    var current: str = "";
    var i: int = 0;
    while (i < len(s)) {
        if (substring(s, i, i + 1) == delimiter) {
            parts = parts + [current];
            current = "";
        } else {
            current = current + substring(s, i, i + 1);
        }
        i = i + 1;
    }
    parts = parts + [current];
    return parts;
}
