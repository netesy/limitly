// Re-exports all networking submodules for convenient access.
//
// Usage:
//   import std.net as net;
//   var result = net.DNS.resolve("example.com");
//   var client = net.TCPClient();
//   client.connect("127.0.0.1", 8080);

pub import std.net.tcp as tcp;
pub import std.net.udp as udp;
pub import std.net.dns as dns;
pub import std.net.tls as tls;

// Re-export key frames and functions at the net namespace level
// TCP
pub type TCPClient = tcp.TCPClient;
pub type TCPServer = tcp.TCPServer;

// UDP
pub type UDP = udp.UDP;

// DNS
pub type DNS = dns.DNS;

// TLS
pub type TLSConfig = tls.TLSConfig;
pub type TLSSocket = tls.TLSSocket;
pub fn TLSConfig(): tls.TLSConfig { return tls.TLSConfig(); }
pub fn connect_tls(host: str, port: int, cfg: any = nil): any { return tls.connect(host, port, cfg); }

pub var TCP = tcp;
pub var UDP = udp;
pub var DNS = dns;