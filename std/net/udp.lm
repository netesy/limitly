// Standard Library UDP Module (Unified Resource System)
// Uses the native UDP_SOCKET resource (type 14) for real datagram I/O.
// Operations: BIND=23, SEND_TO=27, RECV_FROM=28, CLOSE=1, POLL=10

import std.core as core;

var RT_UDP: int = 14;
var OP_CLOSE: int = 1;
var OP_BIND: int = 23;
var OP_SEND_TO: int = 27;
var OP_RECV_FROM: int = 28;
var OP_POLL: int = 10;

frame UDP {
    var handle: int;

    pub fn init() {
        self.handle = -1;
    }

    // Create and optionally bind a UDP socket to a port
    pub fn bind(address: str, port: int): core.ResultInt {
        var h = resource_create(RT_UDP);
        if (h == -1) return core.err_int("failed to create UDP socket");

        var success = resource_call(h, OP_BIND, address, port);
        if (success != true) {
            resource_destroy(h);
            return core.err_int("failed to bind UDP socket to " + address + ":" + port as str);
        }

        self.handle = h;
        return core.ok_int(h);
    }

    // Create an unbound UDP socket (for sending only)
    pub fn create(): core.ResultInt {
        var h = resource_create(RT_UDP);
        if (h == -1) return core.err_int("failed to create UDP socket");
        self.handle = h;
        return core.ok_int(h);
    }

    // Send a datagram to a specific address:port
    pub fn send_to(address: str, port: int, data: str): core.ResultInt {
        if (self.handle <= 0) return core.err_int("UDP socket not initialized");
        var result = resource_call(self.handle, OP_SEND_TO, address, port, data);
        if (result == nil) return core.err_int("send_to failed to " + address + ":" + port as str);
        return core.ok_int(result as int);
    }

    // Receive a datagram. Returns "ip:port\ndata" format.
    // Use parse_recv to split into components.
    pub fn recv_from(): core.ResultStr {
        if (self.handle <= 0) return core.err_str("UDP socket not initialized");
        var result = resource_call(self.handle, OP_RECV_FROM);
        if (result == nil) return core.err_str("recv_from failed (no data or socket error)");
        return core.ok_str(result as str);
    }

    // Parse the "ip:port\ndata" format from recv_from
    // Returns a tuple-like string "ip|port|data"
    pub fn parse_recv(raw: str): [str] {
        var newline_idx: int = -1;
        var i: int = 0;
        while (i < len(raw)) {
            if (substring(raw, i, i + 1) == "\n") {
                newline_idx = i;
                i = len(raw);
            } else {
                i = i + 1;
            }
        }
        if (newline_idx == -1) return [raw, "0", ""];

        var header: str = substring(raw, 0, newline_idx);
        var data: str = substring(raw, newline_idx + 1, len(raw));

        // Find the last colon in the header (IPv6 addresses have colons)
        var colon_idx: int = -1;
        var j: int = len(header) - 1;
        while (j >= 0) {
            if (substring(header, j, j + 1) == ":") {
                colon_idx = j;
                j = -1;
            } else {
                j = j - 1;
            }
        }
        if (colon_idx == -1) return [header, "0", data];

        var ip: str = substring(header, 0, colon_idx);
        var port: str = substring(header, colon_idx + 1, len(header));
        return [ip, port, data];
    }

    // Check if data is available (non-blocking poll)
    pub fn has_data(): bool {
        if (self.handle <= 0) return false;
        var result = resource_call(self.handle, OP_POLL);
        return result == true;
    }

    // Close the UDP socket
    pub fn close(): core.ResultInt {
        if (self.handle <= 0) return core.ok_int(0);
        resource_call(self.handle, OP_CLOSE);
        resource_destroy(self.handle);
        self.handle = -1;
        return core.ok_int(0);
    }

    // Check if socket is active
    pub fn is_bound(): bool {
        return self.handle > 0;
    }

    // Join a multicast group (simplified — sets up for receiving multicast)
    pub fn join_multicast(group_address: str, interface_address: str): core.ResultInt {
        // Multicast requires setsockopt(IP_ADD_MEMBERSHIP) which is not
        // exposed through the current resource ops. This is a placeholder
        // for future resource operation support.
        return core.err_int("multicast join not yet supported via resource ops; use FFI for setsockopt");
    }

    // Set broadcast option
    pub fn set_broadcast(enabled: bool): core.ResultInt {
        // Requires setsockopt(SO_BROADCAST) — future resource op
        return core.err_int("set_broadcast not yet supported via resource ops");
    }
}

// ---- Convenience functions ----
fn udp_bind(address: str, port: int): core.ResultInt {
    var sock = UDP();
    return sock.bind(address, port);
}

fn udp_send(handle: int, address: str, port: int, data: str): core.ResultInt {
    var sock = UDP();
    sock.handle = handle;
    return sock.send_to(address, port, data);
}

fn udp_recv(handle: int): core.ResultStr {
    var sock = UDP();
    sock.handle = handle;
    return sock.recv_from();
}