import std.core as core;
import std.core show Error;
import std.resource as res;

frame Datagram {
    var resource: res.Resource;
    pub init(r: res.Resource) { self.resource = r; }
    pub fn send_to(addr: str, port: int, data: str): any {
        return res._call(h=self.resource.handle, op=res.OP_SEND_TO, args=[addr, port, data]);
    }
    pub fn recv_from(): any {
        return res._call(h=self.resource.handle, op=res.OP_RECV_FROM, args=[]);
    }
}

frame UDP {
    var resource: res.Resource?;
    var binder: res.Binder?;
    var datagram: Datagram?;
    var poller: res.Pollable?;

    pub fn init() {
        self.resource = nil;
        self.binder = nil;
        self.datagram = nil;
        self.poller = nil;
    }

    pub fn bind(address: str, port: int): int?core.Error {
        match (res.create_udp_socket()) {
            val r => {
                var b = res.Binder(r=r);
                if (b.bind(args=[address, port])) {
                    self.resource = r;
                    self.binder = b;
                    self.datagram = Datagram(r=r);
                    self.poller = res.Pollable(r=r);
                    return ok(r.handle);
                }
                r.close();
                return err(Error(code="ERR", message="fail"));
            },
            err e => {
                return err(Error(code="ERR", message="fail"));
            }
        }
    }

    pub fn create(): int?core.Error {
        match (res.create_udp_socket()) {
            val r => {
                self.resource = r;
                self.datagram = Datagram(r=r);
                self.poller = res.Pollable(r=r);
                return ok(r.handle);
            },
            err e => {
                return err(Error(code="ERR", message="fail"));
            }
        }
    }

    pub fn send_to(address: str, port: int, data: str): int?core.Error {
        match (self.datagram) {
            val d => {
                var result = d.send_to(addr=address, port=port, data=data);
                if (result == nil) return err(Error(code="ERR", message="fail"));
                return ok(result as int);
            },
            _ => return err(Error(code="ERR", message="fail"))
        }
    }

    pub fn recv_from(): str?core.Error {
        match (self.datagram) {
            val d => {
                var result = d.recv_from();
                if (result == nil) return err(Error(code="ERR", message="fail"));
                return ok(result as str);
            },
            _ => return err(Error(code="ERR", message="fail"))
        }
    }

    pub fn has_data(): bool {
        match (self.poller) {
            val p => { return p.poll(); },
            _ => { return false; }
        }
    }

    pub fn close(): nil?core.Error {
        match (self.resource) {
            val r => {
                r.close();
                self.resource = nil;
                self.binder = nil;
                self.datagram = nil;
                self.poller = nil;
                return ok(nil);
            },
            _ => return ok(nil)
        }
    }
}
