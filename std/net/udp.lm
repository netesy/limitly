// Standard Library UDP Module (Unified Resource System)
// Uses the native UDP_SOCKET resource (type 14) for real datagram I/O.

import std.core as core;

var RT_UDP: int = 14;
var OP_CLOSE: int = 1;
var OP_BIND: int = 23;
var OP_SEND_TO: int = 27;
var OP_RECV_FROM: int = 28;
var OP_POLL: int = 10;

frame UDP {
    pub var handle: int;

    pub fn init() {
        self.handle = -1;
    }

    // Create and optionally bind a UDP socket to a port
    pub fn bind(address: str, port: int): int?core.Error {
        var h = resource_create(RT_UDP, []);
        if (h == -1) return err(core.Error { code: "ERR", message: "failed to create UDP socket" });

        var success = resource_call(h, OP_BIND, [address, port]);
        if (success != true) {
            resource_destroy(h);
            return err(core.Error { code: "ERR", message: "failed to bind UDP socket to " + address + ":" + port as str });
        }

        self.handle = h;
        return ok(h);
    }

    // Create an unbound UDP socket (for sending only)
    pub fn create(): int?core.Error {
        var h = resource_create(RT_UDP, []);
        if (h == -1) return err(core.Error { code: "ERR", message: "failed to create UDP socket" });
        self.handle = h;
        return ok(h);
    }

    // Send a datagram to a specific address:port
    pub fn send_to(address: str, port: int, data: str): int?core.Error {
        if (self.handle <= 0) return err(core.Error { code: "ERR", message: "UDP socket not initialized" });
        var result = resource_call(self.handle, OP_SEND_TO, [address, port, data]);
        if (result == nil) return err(core.Error { code: "ERR", message: "send_to failed to " + address + ":" + port as str });
        return ok(result as int);
    }

    // Receive a datagram. Returns "ip:port\ndata" format.
    pub fn recv_from(): str?core.Error {
        if (self.handle <= 0) return err(core.Error { code: "ERR", message: "UDP socket not initialized" });
        var result = resource_call(self.handle, OP_RECV_FROM, []);
        if (result == nil) return err(core.Error { code: "ERR", message: "recv_from failed (no data or socket error)" });
        return ok(result as str);
    }

    // Check if data is available (non-blocking poll)
    pub fn has_data(): bool {
        if (self.handle <= 0) return false;
        var result = resource_call(self.handle, OP_POLL, []);
        return result == true;
    }

    // Close the UDP socket
    pub fn close(): nil?core.Error {
        if (self.handle <= 0) return ok(nil);
        resource_call(self.handle, OP_CLOSE, []);
        resource_destroy(self.handle);
        self.handle = -1;
        return ok(nil);
    }
}
