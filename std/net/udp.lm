// Standard Library UDP Module (Unified Resource System)
// Uses the native UDP_SOCKET resource for real datagram I/O.

import std.core as core;
import std.resource as res;

frame UDP {
    var resource: res.Resource?;
    var binder: res.Binder?;
    var datagram: res.Datagram?;
    var poller: res.Poller?;

    pub fn init() {
        self.resource = nil;
        self.binder = nil;
        self.datagram = nil;
        self.poller = nil;
    }

    // Create and optionally bind a UDP socket to a port
    pub fn bind(address: str, port: int): int?core.Error {
        match (res.create_udp_socket()) {
            case ok(r) => {
                var binder = res.Binder(r);
                if (binder.bind([address, port])) {
                    self.resource = ok(r);
                    self.binder = ok(binder);
                    self.datagram = ok(res.Datagram(r));
                    self.poller = ok(res.Poller(r));
                    return ok(r._handle());
                } else {
                    r.close();
                    return err(core.Error { code: "ERR", message: "failed to bind UDP socket to " + address + ":" + port as str });
                }
            }
            case err(e) => return err(core.Error { code: "ERR", message: "failed to create UDP socket" });
        }
    }

    // Create an unbound UDP socket (for sending only)
    pub fn create(): int?core.Error {
        match (res.create_udp_socket()) {
            case ok(r) => {
                self.resource = ok(r);
                self.datagram = ok(res.Datagram(r));
                self.poller = ok(res.Poller(r));
                return ok(r._handle());
            }
            case err(e) => return err(core.Error { code: "ERR", message: "failed to create UDP socket" });
        }
    }

    // Send a datagram to a specific address:port
    pub fn send_to(address: str, port: int, data: str): int?core.Error {
        match (self.datagram) {
            case ok(d) => {
                var result = d.send_to(address, port, data);
                if (result == nil) return err(core.Error { code: "ERR", message: "send_to failed to " + address + ":" + port as str });
                return ok(result as int);
            }
            case nil => return err(core.Error { code: "ERR", message: "UDP socket not initialized" });
        }
    }

    // Receive a datagram. Returns "ip:port\ndata" format.
    pub fn recv_from(): str?core.Error {
        match (self.datagram) {
            case ok(d) => {
                var result = d.recv_from();
                if (result == nil) return err(core.Error { code: "ERR", message: "recv_from failed (no data or socket error)" });
                return ok(result as str);
            }
            case nil => return err(core.Error { code: "ERR", message: "UDP socket not initialized" });
        }
    }

    // Check if data is available (non-blocking poll)
    pub fn has_data(): bool {
        match (self.poller) {
            case ok(p) => return p.poll();
            case nil => return false;
        }
    }

    // Close the UDP socket
    pub fn close(): nil?core.Error {
        match (self.resource) {
            case ok(r) => {
                r.close();
                self.resource = nil;
                self.binder = nil;
                self.datagram = nil;
                self.poller = nil;
                return ok(nil);
            }
            case nil => return ok(nil);
        }
    }
}
