// Standard Library NOL Serializer / Dumper
// Netesy Object Language (NOL)

import std.nol.value as value;

fn _make_indent(spaces: int): str {
    var res = "";
    var i = 0;
    while (i < spaces) {
        res = res + " ";
        i = i + 1;
    }
    return res;
}

fn _escape_str(s: str): str {
    var res = "\"";
    var length = len(s);
    var i = 0;
    while (i < length) {
        var ch = _builtin_substring(s, i, i + 1);
        if (ch == "\"") res = res + "\\\"";
        elif (ch == "\\") res = res + "\\\\";
        elif (ch == "\n") res = res + "\\n";
        elif (ch == "\r") res = res + "\\r";
        elif (ch == "\t") res = res + "\\t";
        else res = res + ch;
        i = i + 1;
    }
    return res + "\"";
}

/// Dumps a NOL `Value` AST node to its text representation.
///
/// @param val_obj Target value node to format.
/// @param indent Spaces per indentation level (default: 2).
/// @param level Current indentation nesting level (default: 0).
/// @param is_root True if formatting root level of document (default: true).
/// @return Serialized NOL string representation.
pub fn dump(val_obj: value.Value, indent: int = 2, level: int = 0, is_root: bool = true): str {
    contract(indent >= 0, "indent must be non-negative");
    contract(level >= 0, "level must be non-negative");
    if (val_obj == nil) return "null";

    var lbrace = "{";
    var rbrace = "}";

    match (val_obj.kind) {
        value.Type.Null => {
            return "null";
        },
        value.Type.Bool => {
            if (val_obj.bool_val) return "true";
            return "false";
        },
        value.Type.Int => {
            var num = val_obj.int_val;
            return "{num}";
        },
        value.Type.Float => {
            var fl = val_obj.float_val;
            return "{fl}";
        },
        value.Type.String => {
            return _escape_str(val_obj.str_val);
        },
        value.Type.Array => {
            var res = "[";
            var total = len(val_obj.array_val);
            var i = 0;
            while (i < total) {
                var elem = val_obj.array_val[i] as value.Value;
                res = res + dump(elem, indent, level + 1, false);
                if (i + 1 < total) res = res + ", ";
                i = i + 1;
            }
            return res + "]";
        },
        value.Type.Object => {
            var total = len(val_obj.obj_keys);
            if (total == 0) {
                if (is_root) return "";
                return lbrace + rbrace;
            }

            var pad = _make_indent(level * indent);
            var next_pad = _make_indent((level + 1) * indent);
            var s = "";
            if (!is_root) s = lbrace + "\n";

            var i = 0;
            while (i < total) {
                var k = val_obj.obj_keys[i];
                var v = val_obj.obj_vals[i] as value.Value;

                if (!is_root) s = s + next_pad;
                s = s + k + ": " + dump(v, indent, level + 1, false);

                if (is_root) {
                    s = s + "\n";
                } else {
                    if (i + 1 < total) s = s + ",\n";
                    else s = s + "\n";
                }
                i = i + 1;
            }

            if (!is_root) s = s + pad + rbrace;
            return s;
        },
        _ => {
            return "null";
        }
    }
}

/// Serializes a NOL `Value` into formatted text.
///
/// @param val_obj Target value node to serialize.
/// @param indent Spaces per indentation level (default: 2).
/// @return Formatted NOL string.
pub fn stringify(val_obj: value.Value, indent: int = 2): str {
    contract(indent >= 0, "indent must be non-negative");
    return dump(val_obj, indent, 0, true);
}
