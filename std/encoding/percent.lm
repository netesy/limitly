// std/encoding/percent.lm
// URL Percent-Encoding and Decoding (RFC 3986).

/// Percent-encodes reserved URL characters in a string.
///
/// @tip Escapes spaces (`%20`), slashes, colons, question marks, and query delimiters.
///
/// @param s Source string.
/// @return URL percent-encoded string.
///
/// @example
/// import std.encoding.percent as percent;
/// var encoded = percent.encode("hello world/path");
/// print("Encoded: {encoded}");
pub fn encode(s: str): str {
    var res: str = "";
    var i: int = 0;
    var length = len(s);
    while (i < length) {
        var ch = _builtin_substring(s, i, i + 1);
        if (ch == " ") {
            res = res + "%20";
        } else if (ch == "/") {
            res = res + "%2" + "F";
        } else if (ch == ":") {
            res = res + "%3" + "A";
        } else if (ch == "?") {
            res = res + "%3" + "F";
        } else if (ch == "=") {
            res = res + "%3" + "D";
        } else if (ch == "&") {
            res = res + "%26";
        } else if (ch == "%") {
            res = res + "%25";
        } else if (ch == "+") {
            res = res + "%2" + "B";
        } else if (ch == "#") {
            res = res + "%23";
        } else {
            res = res + ch;
        }
        i = i + 1;
    }
    return res;
}

/// Decodes a URL percent-encoded string back to its raw character form.
///
/// @tip Supports both uppercase (`%2F`) and lowercase (`%2f`) hex tokens.
///
/// @param s Percent-encoded string.
/// @return Decoded string.
///
/// @example
/// import std.encoding.percent as percent;
/// var decoded = percent.decode("hello%20world");
/// print("Decoded: {decoded}");
pub fn decode(s: str): str {
    var res: str = "";
    var i: int = 0;
    var length = len(s);
    while (i < length) {
        var ch = _builtin_substring(s, i, i + 1);
        if (ch == "%" and i + 2 < length) {
            var h = _builtin_substring(s, i + 1, i + 3);
            if (h == "20") {
                res = res + " ";
            } else if (h == "2" + "F") {
                res = res + "/";
            } else if (h == "2" + "f") {
                res = res + "/";
            } else if (h == "3" + "A") {
                res = res + ":";
            } else if (h == "3" + "a") {
                res = res + ":";
            } else if (h == "3" + "F") {
                res = res + "?";
            } else if (h == "3" + "f") {
                res = res + "?";
            } else if (h == "3" + "D") {
                res = res + "=";
            } else if (h == "3" + "d") {
                res = res + "=";
            } else if (h == "26") {
                res = res + "&";
            } else if (h == "25") {
                res = res + "%";
            } else if (h == "2" + "B") {
                res = res + "+";
            } else if (h == "2" + "b") {
                res = res + "+";
            } else if (h == "23") {
                res = res + "#";
            } else {
                res = res + "%" + h;
            }
            i = i + 3;
        } else {
            res = res + ch;
            i = i + 1;
        }
    }
    return res;
}
