// std/encoding/hex.lm
// Hexadecimal Encoding and Decoding.

/// Converts a single hexadecimal ASCII character to its 0-15 integer nibble value.
fn hex_char_to_val(ch: str): int {
    if (ch == "0") return 0;
    if (ch == "1") return 1;
    if (ch == "2") return 2;
    if (ch == "3") return 3;
    if (ch == "4") return 4;
    if (ch == "5") return 5;
    if (ch == "6") return 6;
    if (ch == "7") return 7;
    if (ch == "8") return 8;
    if (ch == "9") return 9;
    if (ch == "a" or ch == "A") return 10;
    if (ch == "b" or ch == "B") return 11;
    if (ch == "c" or ch == "C") return 12;
    if (ch == "d" or ch == "D") return 13;
    if (ch == "e" or ch == "E") return 14;
    if (ch == "f" or ch == "F") return 15;
    return 0;
}

/// Encodes an array of bytes into a lowercase hexadecimal string.
///
/// @tip Every byte produces exactly two hexadecimal characters.
///
/// @param bytes Array of byte values (0-255).
/// @return Lowercase hexadecimal representation.
///
/// @example
/// import std.encoding.hex as hex;
/// var h = hex.to_hex([255, 0, 127]);
/// print("Hex: {h}"); // "ff007f"
pub fn to_hex(bytes: [int]): str {
    var hex: str = "0123456789abcdef";
    var res: str = "";
    var i: int = 0;
    var length = len(bytes);
    while (i < length) {
        var b: int = bytes[i];
        var idx1 = (b >> 4) & 15;
        var idx2 = b & 15;
        res = res + _builtin_substring(hex, idx1, idx1 + 1);
        res = res + _builtin_substring(hex, idx2, idx2 + 1);
        i = i + 1;
    }
    return res;
}

/// Decodes a hexadecimal string into an array of byte integers.
///
/// @pre len(s) % 2 == 0
/// @tip Case-insensitive; accepts uppercase (A-F) and lowercase (a-f) characters.
///
/// @param s Hexadecimal string (must have an even length).
/// @return Decoded byte array [int].
///
/// @example
/// import std.encoding.hex as hex;
/// var bytes = hex.from_hex("48656c6c6f");
/// print("Decoded byte count: {len(bytes)}");
pub fn from_hex(s: str): [int] {
    contract(len(s) % 2 == 0, "Hex string length must be even");
    var res: [int] = [];
    var i: int = 0;
    var length = len(s);
    while (i < length) {
        if (i + 1 < length) {
            var h: int = hex_char_to_val(_builtin_substring(s, i, i + 1));
            var l: int = hex_char_to_val(_builtin_substring(s, i + 1, i + 2));
            res.append((h << 4) | l);
        }
        i = i + 2;
    }
    return res;
}

/// Converts a single byte integer into a 2-character lowercase hex string.
///
/// @pre b >= 0 and b <= 255
/// @param b Byte value between 0 and 255.
/// @return 2-character lowercase hex string.
///
/// @example
/// print("Hex: {hex.byte_to_hex(254)}"); // "fe"
pub fn byte_to_hex(b: int): str {
    contract(b >= 0 and b <= 255, "Byte value must be within range 0-255");
    var hex: str = "0123456789abcdef";
    var hi: int = (b >> 4) & 15;
    var lo: int = b & 15;
    return _builtin_substring(hex, hi, hi + 1) + _builtin_substring(hex, lo, lo + 1);
}

/// Parses a 2-character hex string into a single byte integer (0-255).
///
/// @pre len(h) >= 2
/// @param h Hex string of at least 2 characters.
/// @return Parsed byte integer.
///
/// @example
/// print("Byte: {hex.hex_to_byte(\"ff\")}"); // 255
pub fn hex_to_byte(h: str): int {
    contract(len(h) >= 2, "Hex string must have at least 2 characters");
    if (len(h) < 2) {
        return 0;
    }
    var hi: int = hex_char_to_val(_builtin_substring(h, 0, 1));
    var lo: int = hex_char_to_val(_builtin_substring(h, 1, 2));
    return (hi << 4) | lo;
}
