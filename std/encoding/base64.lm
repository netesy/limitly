// Base64 Encoding Module

fn get_b64_index(ch: str): int {
    var chars: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var i: int = 0;
    while (i < 64) {
        if (_builtin_substring(chars, i, i + 1) == ch) {
            return i;
        }
        i = i + 1;
    }
    return 0;
}

pub fn encode_base64(bytes: [int]): str {
    var chars: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var res: str = "";
    var i: int = 0;
    var length = len(bytes);
    while (i < length) {
        var b1: int = bytes[i];
        var b2: int = 0;
        if (i + 1 < length) {
            b2 = bytes[i + 1];
        }
        var b3: int = 0;
        if (i + 2 < length) {
            b3 = bytes[i + 2];
        }

        var c1: int = b1 >> 2;
        var c2: int = ((b1 & 3) << 4) | (b2 >> 4);
        var c3: int = ((b2 & 15) << 2) | (b3 >> 6);
        var c4: int = b3 & 63;

        res = res + _builtin_substring(chars, c1, c1 + 1);
        res = res + _builtin_substring(chars, c2, c2 + 1);
        if (i + 1 < length) {
            res = res + _builtin_substring(chars, c3, c3 + 1);
        } else {
            res = res + "=";
        }
        if (i + 2 < length) {
            res = res + _builtin_substring(chars, c4, c4 + 1);
        } else {
            res = res + "=";
        }

        i = i + 3;
    }
    return res;
}

pub fn decode_base64(s: str): [int] {
    var res: [int] = [];
    var j: int = 0;
    var length = len(s);
    while (j < length) {
        if (j + 4 > length) {
            break;
        }
        var c1: str = _builtin_substring(s, j, j + 1);
        var c2: str = _builtin_substring(s, j + 1, j + 2);
        var c3: str = _builtin_substring(s, j + 2, j + 3);
        var c4: str = _builtin_substring(s, j + 3, j + 4);

        if (c1 == "=" or c2 == "=") {
            break;
        }

        var v1: int = get_b64_index(c1);
        var v2: int = get_b64_index(c2);
        var v3: int = 0;
        if (c3 != "=") {
            v3 = get_b64_index(c3);
        }
        var v4: int = 0;
        if (c4 != "=") {
            v4 = get_b64_index(c4);
        }

        var b1: int = (v1 << 2) | (v2 >> 4);
        res.append(b1);

        if (c3 != "=") {
            var b2: int = ((v2 & 15) << 4) | (v3 >> 2);
            res.append(b2);
        }
        if (c4 != "=") {
            var b3: int = ((v3 & 3) << 6) | v4;
            res.append(b3);
        }

        j = j + 4;
    }
    return res;
}
