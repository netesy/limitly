    t.separator          = color.hex(0x4c566a, 0.6);
    t.frame_bg           = color.hex(0x3b4252, 1.0);
    t.frame_bg_hover     = color.hex(0x434c5e, 1.0);
    t.frame_bg_active    = color.hex(0x4c566a, 1.0);
    t.tab_normal         = color.hex(0x3b4252, 1.0);
    t.tab_active         = color.hex(0x88c0d0, 1.0);
    t.plot_lines         = color.hex(0xa3be8c, 1.0);
