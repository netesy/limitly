// std/ui/container.lm
// M2 layout containers: Flow (row/column), Container (padded box), ScrollView.
//
// All children are [Component] trait objects. measure asks each child for
// its intrinsic size under loose constraints; arrange distributes the
// parent's Rect; paint recurses in order; on_event hit-tests children in
// reverse paint order (topmost first).
//
// Events arrive as scalars (trait dispatch cannot take managed args);
// ScrollView reconstitutes a scroll offset by adjusting the y coordinate
// before forwarding — children see content-space coordinates.

import std.ui.component as comp;
import std.ui.component show Placed;
import std.ui.types as ui_types;
import std.ui.event as uievent;
import std.ui.draw_list as dl;
import std.ui.state as state;
import std.ui.tree as tree;
import std.events as events;
import std.color as color;

// ── Flow ─────────────────────────────────────────────────────────────────────
// Linear row or column of children with spacing.

frame Flow {
    embed Placed;
    pub var children: [comp.Component];
    pub var spacing: float;
    pub var pad_x: float;
    pub var pad_y: float;
    pub var vertical: int;
    pub var fg: color.Color;
    // Arrange/measure scratch MUST live in fields, not locals: the AOT
    // backend can clobber float registers holding local variables across
    // trait-object dynamic calls (verified — column/row children all
    // stacked at y=0 in AOT while the VM was correct). Frame fields are
    // heap-stable. Each is reset at the top of measure/arrange.
    pub var _cur: float = 0.0;
    pub var _cross: float = 0.0;
    pub var _ox: float = 0.0;
    pub var _oy: float = 0.0;
    pub var _aw: float = 0.0;
    pub var _ah: float = 0.0;
    pub var _rw: float = 0.0;
    pub var _rh: float = 0.0;

    pub init(v: int = 0, sp: float = 4.0) {
        self.children = [];
        self.spacing = sp;
        self.pad_x = 0.0;
        self.pad_y = 0.0;
        self.vertical = v;
        self.fg = color.white;
        self.id = comp.next_widget_id();
    }

    pub fn add(c: comp.Component): nil {
        self.children.append(c);
    }

    pub fn child_count(): int {
        return len(self.children);
    }

    pub fn child_at(i: int): any {
        if (i < 0 or i >= len(self.children)) {
            return nil;
        }
        return self.children[i];
    }

    pub fn kind(): ui_types.WidgetKind { return ui_types.WidgetKind.Container; }
    pub fn on_theme_changed(): nil { }
    pub fn on_overlay_dismiss(): nil { }

    pub fn wants_pointer_capture(): int { return 0; }

    pub fn measure(min_w: float, max_w: float, min_h: float, max_h: float): comp.Size {
        // Accumulate in fields — see the scratch-field comment above.
        self._cur = 0.0;
        self._cross = 0.0;
        var i = 0;
        while (i < len(self.children)) {
            val c = self.children[i];
            val s = c.measure(0.0, comp.MEASURE_LOOSE, 0.0, comp.MEASURE_LOOSE);
            if (self.vertical != 0) {
                if (s.w > self._cross) { self._cross = s.w; }
                self._cur = self._cur + s.h + self.spacing;
            } else {
                self._cur = self._cur + s.w + self.spacing;
                if (s.h > self._cross) { self._cross = s.h; }
            }
            i = i + 1;
        }
        // _cur = flow-axis total (incl. trailing spacing), _cross = cross-axis
        // max. Map back to w/h by orientation. Results go through the scratch
        // fields: bare field reads assigned to float locals mis-lower under
        // AOT (erased word vs double slot confusion).
        if (self.vertical != 0) {
            self._rw = self._cross;
            self._rh = self._cur;
            if (len(self.children) > 0) { self._rh = self._rh - self.spacing; }
        } else {
            self._rw = self._cur;
            self._rh = self._cross;
            if (len(self.children) > 0) { self._rw = self._rw - self.spacing; }
        }
        var w: float = self._rw + self.pad_x * 2.0;
        var h: float = self._rh + self.pad_y * 2.0;
        if (w < min_w) { w = min_w; }
        if (w > max_w) { w = max_w; }
        if (h < min_h) { h = min_h; }
        if (h > max_h) { h = max_h; }
        return comp.Size(w=w, h=h);
    }

    pub fn arrange(x: float, y: float, w: float, h: float): nil {
        self.rect.x = x;
        self.rect.y = y;
        self.rect.w = w;
        self.rect.h = h;
        // Geometry + running cursor live in fields: float locals do not
        // reliably survive trait-object dynamic calls under AOT.
        self._ox = x + self.pad_x;
        self._oy = y + self.pad_y;
        self._aw = w - self.pad_x * 2.0;
        self._ah = h - self.pad_y * 2.0;
        self._cur = 0.0;
        var i = 0;
        while (i < len(self.children)) {
            val c = self.children[i];
            // Remaining space along each axis after the consumed offset —
            // expandable children (e.g. ScrollView) clamp to the leftover
            // instead of overflowing.
            // Remaining space lives in fields, not locals: AOT Mov-copies of
            // erased-word float fields read back as denormal garbage.
            if (self.vertical != 0) {
                self._rw = self._aw;
                self._rh = self._ah - self._cur;
            } else {
                self._rw = self._aw - self._cur;
                self._rh = self._ah;
            }
            if (self._rw < 0.0) { self._rw = 0.0; }
            if (self._rh < 0.0) { self._rh = 0.0; }
            val s = c.measure(0.0, self._rw, 0.0, self._rh);
            if (self.vertical != 0) {
                c.arrange(self._ox, self._oy + self._cur, self._aw, s.h);
                self._cur = self._cur + s.h + self.spacing;
            } else {
                c.arrange(self._ox + self._cur, self._oy, s.w, self._ah);
                self._cur = self._cur + s.w + self.spacing;
            }
            i = i + 1;
        }
    }

    pub fn paint(): nil {
        var i = 0;
        while (i < len(self.children)) {
            self.children[i].paint();
            i = i + 1;
        }
    }

    pub fn on_event(t: events.EventType, x: int, y: int, key: int): uievent.EventResult {
        // Reverse order: topmost (last painted) gets first chance.
        // MouseMove is forwarded to EVERY child regardless of bounds —
        // hover widgets (Button, Tooltip, ...) must see the pointer leave
        // their rect to clear state; they self-filter via contains().
        var i = len(self.children) - 1;
        var handled: bool = false;
        while (i >= 0) {
            val c = self.children[i];
            var hit: bool = true;
            if (t != events.EventType.MouseMove and t != events.EventType.MouseUp and t != events.EventType.MouseWheel) {
                hit = c.bounds().contains(x as float, y as float);
            } elif (tree.captured_id != 0) {
                hit = tree.subtree_has_widget(c, tree.captured_id);
            }
            if (hit) {
                val res = c.on_event(t, x, y, key);
                if (res == uievent.EventResult.Handled) {
                    if (t == events.EventType.MouseMove) {
                        handled = true;
                    } else {
                        return uievent.EventResult.Handled;
                    }
                }
            }
            i = i - 1;
        }
        if (handled) {
            return uievent.EventResult.Handled;
        }
        return uievent.EventResult.Ignored;
    }
}

pub fn row(spacing: float = 4.0): Flow {
    return Flow(0, spacing);
}

pub fn column(spacing: float = 4.0): Flow {
    return Flow(1, spacing);
}

// ── Container ────────────────────────────────────────────────────────────────
// Single-child padded box — the "padding" primitive.

frame Container {
    embed Placed;
    pub var child: comp.Component;
    pub var pad_x: float;
    pub var pad_y: float;
    pub var bg: color.Color;

    pub init(c: comp.Component, px: float = 4.0, py: float = 4.0) {
        self.child = c;
        self.pad_x = px;
        self.pad_y = py;
        self.bg = color.Color(r=0.0, g=0.0, b=0.0, a=0.0);
        self.id = comp.next_widget_id();
    }

    pub fn kind(): ui_types.WidgetKind { return ui_types.WidgetKind.Container; }
    pub fn on_theme_changed(): nil { }
    pub fn on_overlay_dismiss(): nil { }

    pub fn child_count(): int {
        return 1;
    }

    pub fn child_at(i: int): any {
        if (i == 0) {
            return self.child;
        }
        return nil;
    }

    pub fn wants_pointer_capture(): int { return 0; }

    pub fn measure(min_w: float, max_w: float, min_h: float, max_h: float): comp.Size {
        val s = self.child.measure(0.0, comp.MEASURE_LOOSE, 0.0, comp.MEASURE_LOOSE);
        var w: float = s.w + self.pad_x * 2.0;
        var h: float = s.h + self.pad_y * 2.0;
        if (w < min_w) { w = min_w; }
        if (w > max_w) { w = max_w; }
        if (h < min_h) { h = min_h; }
        if (h > max_h) { h = max_h; }
        return comp.Size(w=w, h=h);
    }

    pub fn arrange(x: float, y: float, w: float, h: float): nil {
        self.rect.x = x;
        self.rect.y = y;
        self.rect.w = w;
        self.rect.h = h;
        if (self.bg.a > 0.001) {
            dl.dl_emit_rect(dl.paint_ctx.dl, x, y, w, h,
                self.bg.r, self.bg.g, self.bg.b, self.bg.a);
        }
        self.child.arrange(x + self.pad_x, y + self.pad_y,
            w - self.pad_x * 2.0, h - self.pad_y * 2.0);
    }

    pub fn paint(): nil {
        self.child.paint();
    }

    pub fn on_event(t: events.EventType, x: int, y: int, key: int): uievent.EventResult {
        val r = self.child.bounds();
        if (not r.contains(x as float, y as float)) {
            return uievent.EventResult.Ignored;
        }
        return self.child.on_event(t, x, y, key);
    }
}

// ── ScrollView ───────────────────────────────────────────────────────────────
// Clips its child to its Rect and forwards pointer events with a y offset,
// so children hit-test in content space. Scroll via mouse wheel.

frame ScrollView {
    embed Placed;
    pub var child: comp.Component;
    pub var scroll_y: float;
    pub var scroll_target: float;
    pub var max_scroll: float;
    pub var scroll_sig: state.FloatSignal?;

    pub init(c: comp.Component) {
        self.child = c;
        self.scroll_y = 0.0;
        self.scroll_target = 0.0;
        self.max_scroll = 0.0;
        self.scroll_sig = nil;
        self.id = comp.next_widget_id();
    }

    pub fn child_count(): int {
        return 1;
    }

    pub fn child_at(i: int): any {
        if (i == 0) {
            return self.child;
        }
        return nil;
    }

    // Bind an external FloatSignal two-way: wheel scrolling writes it,
    // external set() is polled into scroll_y on the next arrange.
    pub fn bind_scroll(sig: state.FloatSignal): nil {
        self.scroll_sig = sig;
        self.scroll_y = sig.get();
        self.scroll_target = sig.get();
    }

    pub fn kind(): ui_types.WidgetKind { return ui_types.WidgetKind.Container; }
    pub fn on_theme_changed(): nil { }
    pub fn on_overlay_dismiss(): nil { }

    pub fn wants_pointer_capture(): int { return 0; }

    pub fn measure(min_w: float, max_w: float, min_h: float, max_h: float): comp.Size {
        // Report the child's intrinsic size clamped to our constraints —
        // under a bounded parent this caps the scrollable extent so the
        // view itself stays inside the viewport.
        val s = self.child.measure(0.0, comp.MEASURE_LOOSE, 0.0, comp.MEASURE_LOOSE);
        var w: float = s.w + 0.0;
        var h: float = s.h + 0.0;
        if (w < min_w) { w = min_w; }
        if (w > max_w) { w = max_w; }
        if (h < min_h) { h = min_h; }
        if (h > max_h) { h = max_h; }
        return comp.Size(w=w, h=h);
    }

    pub fn arrange(x: float, y: float, w: float, h: float): nil {
        self.rect.x = x;
        self.rect.y = y;
        self.rect.w = w;
        self.rect.h = h;
        // Child gets its measured height but is clipped to our height.
        val s = self.child.measure(0.0, w, 0.0, comp.MEASURE_LOOSE);
        var overflow: float = s.h - h;
        if (overflow < 0.0) { overflow = 0.0; }
        self.max_scroll = overflow;
        // External writes land on the target; wheel deltas accumulate there.
        // scroll_y eases toward it each frame for smooth scrolling.
        if (self.scroll_sig != nil) {
            self.scroll_target = (self.scroll_sig as state.FloatSignal).get();
        }
        if (self.scroll_target > self.max_scroll) { self.scroll_target = self.max_scroll; }
        if (self.scroll_target < 0.0) { self.scroll_target = 0.0; }
        var diff: float = self.scroll_target - self.scroll_y;
        if (diff > 0.0 - 0.01 and diff < 0.01) {
            self.scroll_y = self.scroll_target;
        } else {
            self.scroll_y = self.scroll_y + diff * 0.35;
            tree.request_repaint();
        }
        if (self.scroll_y > self.max_scroll) { self.scroll_y = self.max_scroll; }
        if (self.scroll_y < 0.0) { self.scroll_y = 0.0; }
        self.child.arrange(x, y - self.scroll_y, w, s.h);
    }

    pub fn paint(): nil {
        dl.dl_push_clip(dl.paint_ctx.dl, self.rect.x, self.rect.y, self.rect.w, self.rect.h);
        self.child.paint();
        dl.dl_pop_clip(dl.paint_ctx.dl);
    }

    pub fn on_event(t: events.EventType, x: int, y: int, key: int): uievent.EventResult {
        if (t == events.EventType.MouseWheel) {
            // Wheel contract: delta rides in Event.y (~120/notch, positive
            // = wheel up); the pointer's y is not delivered, so hit-test
            // against the last tracked pointer position instead.
            var inside: bool = self.rect.contains(tree.pointer_x, tree.pointer_y);
            if (inside) {
                self.scroll_target = self.scroll_target - (y as float) * 0.5;
                if (self.scroll_target < 0.0) { self.scroll_target = 0.0; }
                if (self.scroll_target > self.max_scroll) { self.scroll_target = self.max_scroll; }
                if (self.scroll_sig != nil) {
                    (self.scroll_sig as state.FloatSignal).set(self.scroll_target);
                }
                tree.request_repaint();
                return uievent.EventResult.Handled;
            }
        }
        // Child rects are already in screen space — arrange() placed the
        // content at y - scroll_y, so pointer coords pass through unchanged.
        // Press/key events must land inside the *viewport* (not the full
        // content bounds) so clipped overflow can't be clicked. MouseMove
        // skips the gate so hover state can clear when the pointer leaves;
        // MouseUp is exempt for pointer-capture release.
        var inside: bool = self.rect.contains(x as float, y as float);
        if (t == events.EventType.MouseMove or t == events.EventType.MouseUp or t == events.EventType.MouseWheel) {
            inside = true;
        }
        if (not inside) {
            return uievent.EventResult.Ignored;
        }
        return self.child.on_event(t, x, y, key);
    }
}

pub fn scroll_view(c: comp.Component): ScrollView {
    return ScrollView(c);
}
