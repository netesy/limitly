// std/ui/gesture - Gesture recognition and handling
import std.ui.components as comp;

frame GestureState {
    pub var pointer_down_time: float;
    pub var pointer_down_x: float;
    pub var pointer_down_y: float;
    pub var last_tap_time: float;
    pub var tap_count: int;
    pub var is_long_press_active: int;

    pub init() {
        self.pointer_down_time = 0.0;
        self.pointer_down_x = 0.0;
        self.pointer_down_y = 0.0;
        self.last_tap_time = 0.0;
        self.tap_count = 0;
        self.is_long_press_active = 0;
    }
}

pub var gesture_states: {str: GestureState} = {};

pub fn detect_tap(child: comp.Button, on_tap: (fn(): nil) | nil): comp.Button {
    child.on_click_action = on_tap;
    return child;
}

pub fn detect_long_press(child: comp.Button, on_long_press: (fn(): nil) | nil): comp.Button {
    child.a11y_hint = "long_press";
    child.on_click_action = on_long_press;
    return child;
}

pub fn detect_double_tap(child: comp.Button, on_double_tap: (fn(): nil) | nil): comp.Button {
    child.a11y_hint = "double_tap";
    child.on_click_action = on_double_tap;
    return child;
}

pub fn detect_swipe(child: comp.Container, on_swipe: (fn(): nil) | nil): comp.Container {
    child.a11y_hint = "swipe_gesture";
    child.on_click_action = on_swipe;
    return child;
}

pub fn detect_pan(child: comp.Container, on_pan: (fn(): nil) | nil): comp.Container {
    child.a11y_live = "pan_gesture";
    child.on_click_action = on_pan;
    return child;
}

pub fn update_gesture_on_pointer_down(gesture_key: str, x: float, y: float, current_time: float): nil {
    var st = GestureState();
    if (gesture_states[gesture_key] != nil) {
        st = gesture_states[gesture_key];
    }
    val time_since_last = current_time - st.last_tap_time;
    if (time_since_last < 0.3) {
        st.tap_count = st.tap_count + 1;
    } else {
        st.tap_count = 1;
    }
    st.pointer_down_time = current_time;
    st.pointer_down_x = x;
    st.pointer_down_y = y;
    st.is_long_press_active = 0;
    gesture_states[gesture_key] = st;
}

pub fn update_gesture_on_pointer_move(gesture_key: str, x: float, y: float): float {
    if (gesture_states[gesture_key] != nil) {
        val st = gesture_states[gesture_key];
        val dx = x - st.pointer_down_x;
        val dy = y - st.pointer_down_y;
        return dx * dx + dy * dy;
    }
    return 0.0;
}

pub fn update_gesture_on_pointer_up(gesture_key: str, current_time: float): int {
    if (gesture_states[gesture_key] != nil) {
        val st = gesture_states[gesture_key];
        val hold_duration = current_time - st.pointer_down_time;
        st.last_tap_time = current_time;
        if (hold_duration >= 0.5) {
            st.is_long_press_active = 1;
            gesture_states[gesture_key] = st;
            return 2;
        } elif (st.tap_count >= 2) {
            gesture_states[gesture_key] = st;
            return 3;
        }
        gesture_states[gesture_key] = st;
        return 1;
    }
    return 0;
}
