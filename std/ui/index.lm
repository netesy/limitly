// std/ui/index.lm
// Facade for the retained component UI — the only application UI system.
//
// This is the canonical surface: `import std.ui as ui` yields the typed
// Component contract, geometry, widgets, containers, signals and the
// frame driver under one namespace.
//
//   import std.ui as ui;
//   import std.app as app;
//
//   var root = ui.column(6.0);
//   root.add(ui.label("Hello"));
//   root.add(ui.button("Fire", nil, on_fire));
//   root.add(ui.checkbox("Enable", false));
//   var a = app.App("Title", 800, 600);
//   a.ui(root);
//   a.run();
//
// State flows through signals (ui.signal_int/ui.signal_float/ui.signal_str/
// ui.signal_bool, ui.computed_str), never through callbacks — bind before
// add() and the tree sees live values across the trait snapshot.

import std.ui.file_dialog as filedlg;

pub import std.ui.component show Component, Placed, TextBound, Size, Rect, MEASURE_LOOSE, next_widget_id, label;

pub import std.ui.widgets show Button, TextInput, Checkbox, Toggle, Slider, ProgressBar;
pub import std.ui.widgets show button, text_input, checkbox, toggle, slider, progress_bar;
pub import std.ui.widgets show Link, Spacer, Badge, Alert, Stat, Indicator, Steps, Timeline;
pub import std.ui.widgets show Diff, Image, ColorPicker, Calendar, FileInput;
pub import std.ui.widgets show Card, Accordion, FormField, TreeNode, Tabs, Select, Stepper;
pub import std.ui.widgets show RangeSlider, Filter, Table, Chart;
pub import std.ui.widgets show link, spacer, badge, alert, toast, stat, indicator, steps, timeline;
pub import std.ui.widgets show diff, image, color_picker, calendar, file_input;
pub import std.ui.widgets show card, accordion, form_field, tree_node, tabs, select, multi_select, stepper;
pub import std.ui.widgets show range_slider, filter, table, table_text, chart, bar_chart, line_chart, pie_chart, plot_histogram, plot_lines;

pub import std.ui.container show Flow, Container, ScrollView;
pub import std.ui.container show row, column, scroll_view;

pub import std.ui.containers show Stack, Grid, Mask, Overlay, Tooltip;
pub import std.ui.containers show stack, grid, mask, overlay, tooltip;

pub import std.ui.theme show Palette, palette;
pub import std.ui.theme show current, theme_version, set_theme, set_default, set_dark, set_light;
pub import std.ui.theme show set_cyberpunk, set_retro, set_nord, elevation_shadow;

pub import std.ui.state show SignalNode, Signal, ComputedSignal, Effect;
pub import std.ui.state show BoolSignal, IntSignal, FloatSignal, StrSignal, ComputedStr;
pub import std.ui.state show signal_bool, signal_int, signal_float, signal_str, computed_str;
pub import std.ui.state show effect, effect_with_cleanup, batch_updates, dispose_all_effects;
pub import std.ui.state show bind_text, bind_bool, bind_float, bind_int;

pub import std.ui.tree show update, submit, dispatch, set_focus, clear_focus, focused;
pub import std.ui.tree show enable_reactive, request_repaint, on_state_dirty, find_widget, apply_theme;
// NOTE: tree's mutable audit vars (dirty, repaint_elision, repainted_frames,
// skipped_frames, last_w/last_h) are deliberately NOT re-exported — a
// `pub import show` of a `pub var` captures a value snapshot, not a live
// alias. Read them via `import std.ui.tree as tree` when needed.

pub import std.ui.event show EventKind, EventResult;

// Native file dialogs (std.ui.file_dialog) — Win32-backed pick_file/pick_save.
pub fn pick_file(owner: int = 0, title: str = "Open File"): str? {
    return filedlg.pick_file(owner, title);
}
pub fn pick_save(owner: int = 0, title: str = "Save File"): str? {
    return filedlg.pick_save(owner, title);
}
pub fn file_dialog_owner(hwnd: int): nil {
    filedlg.set_owner(hwnd);
}
