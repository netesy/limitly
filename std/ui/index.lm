// std.ui - Public Fluent & Composable UI Framework for Lymar
// Canonical entry point for Lymar Retained UI System

import std.ui.types as ui_types;
pub import std.ui.types show Widget, Style, Alignment;

import std.ui.color as color_mod;
pub import std.ui.types show Color;

import std.ui.state as state_mod;
pub import std.ui.state show Signal, ComputedSignal, Effect;

import std.ui.viewport as viewport_mod;

import std.ui.layout as layout_mod;
pub import std.ui.layout show LayoutBox, GridSpec, Breakpoint;

import std.ui.navigation as nav_mod;
pub import std.ui.navigation show Router, RouterParams, Route;

import std.ui.charts as charts_mod;

import std.ui.application as app_mod;
pub import std.ui.application show Application;

import std.ui.window as win_mod;
pub import std.ui.window show Window;

import std.ui.theme as theme_mod;
import std.ui.dialog as dialog_mod;

import std.ui.grid as grid_mod;
pub import std.ui.grid show GridLayout;

import std.animation as anim_mod;
pub import std.animation as animation;

import std.graphics.shadow as shadow_mod;
import std.ui.builder as builder_mod;

import std.ui.draw_list as dl_mod;
pub import std.ui.draw_list show DrawList, HitZone;

import std.ui.replay as replay_mod;

// ── Colors ────────────────────────────────────────────────────────────────────
pub var white: Color = color_mod.white;
pub var black: Color = color_mod.black;
pub var red: Color = color_mod.red;
pub var green: Color = color_mod.green;
pub var blue: Color = color_mod.blue;
pub var indigo: Color = color_mod.indigo;
pub var yellow: Color = color_mod.yellow;
pub var gray: Color = color_mod.gray;
pub var dark_gray: Color = color_mod.dark_gray;
pub var light_gray: Color = color_mod.light_gray;
pub var transparent: Color = color_mod.transparent;

pub fn rgb(r: int, g: int, b: int): Color { return color_mod.rgb(r, g, b); }
pub fn rgba(r: int, g: int, b: int, a: float): Color { return color_mod.rgba(r, g, b, a); }
pub fn rgb_f(r: float, g: float, b: float): Color { return color_mod.color_rgb(r, g, b); }
pub fn rgba_f(r: float, g: float, b: float, a: float): Color { return color_mod.color_rgba(r, g, b, a); }
pub fn color_rgb(r: float, g: float, b: float): Color { return color_mod.color_rgb(r, g, b); }
pub fn color_rgba(r: float, g: float, b: float, a: float): Color { return color_mod.color_rgba(r, g, b, a); }
pub fn color_rgb8(r: int, g: int, b: int): Color { return color_mod.rgb(r, g, b); }
pub fn hex(h: int): Color { return color_mod.hex(h); }
pub fn hsl(h: float, s: float, l: float): Color { return color_mod.hsl(h, s, l); }

