// std.ui - Public Fluent & Composable UI Framework for Lymar
// Canonical entry point for Lymar Retained UI System

import std.ui.types as ui_types;
pub import std.ui.types show Widget, Style, WidgetKind, LifecycleState;
// Nominal dispatch enums (Alignment/Axis magic ints are gone).
pub import std.ui.types show Align, Axis, Weight, Semantic, AlertKind, DotState, MaskShape, BlueprintVariant, ConstraintMode, Role;
pub import std.ui.types show align_start, align_center, align_end, AXIS_HORIZONTAL, AXIS_VERTICAL, AXIS_STACKED;

// Import Color directly from std.color - no transitive re-exports
pub import std.color show Color;

import std.ui.state as state;
pub import std.ui.state show Signal, ComputedSignal, Effect;

import std.ui.viewport as viewport;

import std.ui.layout as layout;
pub import std.ui.layout show LayoutBox, GridSpec, Breakpoint;

import std.ui.navigation as nav;
pub import std.ui.navigation show Router, RouterParams, Route;

import std.ui.charts as charts;

import std.ui.application as app;
pub import std.ui.application show Application;

import std.ui.window as win;
pub import std.ui.window show Window;

import std.ui.theme as theme;
import std.ui.dialog as dialog;

import std.ui.grid as grid;
pub import std.ui.grid show GridLayout;

import std.animation as anim;
pub import std.animation as animation;

import std.graphics.shadow as shadow;
pub import std.graphics.shadow show Shadow;
import std.ui.builder as builder;

import std.ui.draw_list as dlist;
pub import std.ui.draw_list show DrawList, HitZone;

import std.ui.replay as replay;
import std.color as color;

// ── Styles & Layout Constants ─────────────────────────────────────────────────
// align_start/center/end and AXIS_* are re-exported via `pub import show` above
// (type-safe; the old `var` aliases were invisible in type position).
pub fn style(): Style { return ui_types.style(); }

