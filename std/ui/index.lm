// ── Application & Window ──────────────────────────────────────────────────────
pub var Shadow = shadow_mod.Shadow;
pub var shadow = shadow_mod.shadow;

// ── State Management ───────────────────────────────────────────────────────────
pub fn signal(init_val: any): Signal { return state_mod.signal(init_val); }
pub fn signal_bool(init_val: bool): Signal { return state_mod.signal_bool(init_val); }
pub fn signal_int(init_val: int): Signal { return state_mod.signal_int(init_val); }
pub fn signal_float(init_val: float): Signal { return state_mod.signal_float(init_val); }
pub fn signal_str(init_val: str): Signal { return state_mod.signal_str(init_val); }
pub fn computed(compute_fn: fn(): any, deps: [Signal]): ComputedSignal { return state_mod.computed(compute_fn, deps); }
pub fn effect(effect_fn: fn(): nil, deps: [Signal]): Effect { return state_mod.effect(effect_fn, deps); }
pub fn effect_with_cleanup(effect_fn: fn(): nil, cleanup_fn: fn(): nil, deps: [Signal]): Effect { return state_mod.effect_with_cleanup(effect_fn, cleanup_fn, deps); }
pub fn batch_updates(updates: fn(): nil): nil { return state_mod.batch_updates(updates); }
pub fn dispose_all_effects(): nil { return state_mod.dispose_all_effects(); }

// ── Layout Helpers ───────────────────────────────────────────────────────────
pub fn compute_layout(widget: Widget, x: float, y: float, available_w: float, available_h: float): LayoutBox { return layout_mod.compute_layout(widget, x, y, available_w, available_h); }
pub fn compute_layout_enhanced(widget: Widget, x: float, y: float, available_w: float, available_h: float): LayoutBox { return layout_mod.compute_layout_enhanced(widget, x, y, available_w, available_h); }
pub fn flatten_layout(box: LayoutBox): [LayoutBox] { return layout_mod.flatten_layout(box); }
pub fn hit_test_boxes(boxes: [LayoutBox], px: float, py: float): LayoutBox { return layout_mod.hit_test_boxes(boxes, px, py); }
pub fn compute_grid_layout(spec: GridSpec, children: [Widget], x: float, y: float, available_w: float, available_h: float): [LayoutBox] { return layout_mod.compute_grid_layout(spec, children, x, y, available_w, available_h); }
pub fn responsive_layout(breakpoints: [Breakpoint], viewport_w: float, default_widget: Widget): Widget { return layout_mod.responsive_layout(breakpoints, viewport_w, default_widget); }
pub fn responsive(mobile: Widget, tablet: Widget, desktop: Widget, viewport_w: float): Widget { return layout_mod.responsive(mobile, tablet, desktop, viewport_w); }
pub fn breakpoint(small: Widget, large: Widget, threshold: float = 768.0, viewport_w: float): Widget { return layout_mod.breakpoint(small, large, threshold, viewport_w); }

// ── Grid Layout ─────────────────────────────────────────────────────────────
pub fn grid_two_column(left: Widget, right: Widget, gap: float = 16.0): Widget { return grid_mod.grid_two_column(left, right, gap); }
pub fn grid_three_column(a: Widget, b: Widget, c: Widget, gap: float = 12.0): Widget { return grid_mod.grid_three_column(a, b, c, gap); }
pub fn grid_with_aspect(columns_count: int, children: [Widget], aspect_ratio: float, spacing_val: float = 8.0): Widget { return grid_mod.grid_with_aspect(columns_count, children, aspect_ratio, spacing_val); }
pub fn grid_enhanced(spec: GridSpec, children: [Widget]): Widget { return grid_mod.grid_enhanced(spec, children); }

// ── Navigation & Routing ─────────────────────────────────────────────────────
pub fn make_router(): Router { return nav_mod.make_router(); }
pub fn make_router_with_base(base: str): Router { return nav_mod.make_router_with_base(base); }
pub fn router_link(label: str, path: str, router: Router): Widget { return nav_mod.router_link(label, path, router); }
pub fn tab_bar(routes: [(str, str)], router: Router): Widget { return nav_mod.tab_bar(routes, router); }
pub fn breadcrumbs(router: Router): Widget { return nav_mod.breadcrumbs(router); }

// ── Semantic Widget Constructors ──────────────────────────────────────────────
pub fn accordion(title: str, content: Widget, default_open: bool = false): Widget { return ui_types.accordion(title, content, default_open); }
pub fn alert(message: str, type_val: str = "info"): Widget { return ui_types.alert(message, type_val); }
pub fn badge(label: str): Widget { return ui_types.badge(label); }
pub fn bar_chart(label: str, values: [float], labels: [str] = [] as [str]): Widget { return ui_types.bar_chart(label, values, labels); }
pub fn bubble_chart(label: str, values: [float]): Widget { return ui_types.bubble_chart(label, values); }
pub fn button(label: str, on_click: any = nil): Widget { return ui_types.button(label, on_click); }
pub fn calendar(selected_date: str = "2025-01-01"): Widget { return ui_types.calendar(selected_date); }
pub fn card(title: str, content: Widget): Widget { return ui_types.card(title, content); }
pub fn checkbox(checked: bool = false, on_change: any = nil): Widget { return ui_types.checkbox(checked, on_change); }
pub fn color_picker(label: str, color: Color, on_change: any = nil): Widget { return ui_types.color_picker(label, color, on_change); }
pub fn column(children: [Widget]): Widget { return ui_types.column(children); }
pub fn dialog(title: str, content: Widget, is_open: bool = true, width: float = 400.0, height: float = 300.0, on_close: any = nil): Widget { return dialog_mod.dialog(title, content, is_open, width, height, on_close); }
pub fn alert_dialog(title: str, message: str, on_ok: any = nil): Widget { return dialog_mod.alert_dialog(title, message, on_ok); }
pub fn confirm(title: str, message: str, on_yes: any = nil, on_no: any = nil): Widget { return dialog_mod.confirm(title, message, on_yes, on_no); }
pub fn confirm_dialog(title: str, message: str, on_yes: any = nil, on_no: any = nil): Widget { return dialog_mod.confirm(title, message, on_yes, on_no); }
pub fn modal_backdrop(alpha: float = 0.6): Widget { return dialog_mod.modal_backdrop(alpha); }
pub fn diff(old_text: str, new_text: str): Widget { return ui_types.diff(old_text, new_text); }
pub fn dock(items: [Widget]): Widget { return ui_types.dock(items); }
pub fn doughnut_chart(label: str, values: [float], labels: [str] = [] as [str]): Widget { return ui_types.doughnut_chart(label, values, labels); }
pub fn empty(): Widget { return ui_types.empty(); }
pub fn file_input(label: str = "Choose File...", on_select: any = nil): Widget { return ui_types.file_input(label, on_select); }
pub fn filter(query: str = "", placeholder: str = "Filter...", on_change: any = nil): Widget { return ui_types.filter(query, placeholder, on_change); }
pub fn form_field(label_text: str, control: Widget, help_text: str = "", error_text: str = ""): Widget { return ui_types.form_field(label_text, control, help_text, error_text); }
pub fn grid(columns_count: int, children: [Widget], spacing_val: float = 8.0): Widget { return ui_types.grid(columns_count, children, spacing_val); }
pub fn image(source: str = ""): Widget { return ui_types.image(source); }
pub fn indicator(status: str = "online", label: str = ""): Widget { return ui_types.indicator(status, label); }
pub fn input(value: str = "", placeholder: str = "Type here...", on_change: any = nil): Widget { return ui_types.input(value, placeholder, on_change); }
pub fn join(items: [Widget]): Widget { return ui_types.join(items); }
pub fn line_chart(label: str, values: [float]): Widget { return ui_types.line_chart(label, values); }
pub fn link(text_val: str, url: str): Widget { return ui_types.link(text_val, url); }
pub fn list(items: [Widget]): Widget { return ui_types.list(items); }
pub fn mask(shape: str = "circle", child: Widget = empty()): Widget { return ui_types.mask(shape, child); }
pub fn overlay(content: Widget, x: float = 0.0, y: float = 0.0, width_val: float = 0.0, height_val: float = 0.0): Widget { return ui_types.overlay(content, x, y, width_val, height_val); }
pub fn pie_chart(label: str, values: [float], labels: [str] = [] as [str]): Widget { return ui_types.pie_chart(label, values, labels); }
pub fn plot_histogram(label: str, values: [float], min_val: float = 0.0, max_val: float = 1.0): Widget { return ui_types.plot_histogram(label, values, min_val, max_val); }
pub fn plot_lines(label: str, values: [float], min_val: float = 0.0, max_val: float = 1.0): Widget { return ui_types.plot_lines(label, values, min_val, max_val); }
pub fn polar_area_chart(label: str, values: [float], labels: [str] = [] as [str]): Widget { return ui_types.polar_area_chart(label, values, labels); }
pub fn progress(fraction: float = 0.0, width_val: float = 160.0): Widget { return ui_types.progress(fraction, width_val); }
pub fn radar_chart(label: str, values: [float], labels: [str] = [] as [str]): Widget { return ui_types.radar_chart(label, values, labels); }
pub fn range_slider(low: float = 20.0, high: float = 80.0, min_val: float = 0.0, max_val: float = 100.0): Widget { return ui_types.range_slider(low, high, min_val, max_val); }
pub fn row(children: [Widget]): Widget { return ui_types.row(children); }
pub fn scatter_chart(label: str, values: [float]): Widget { return ui_types.scatter_chart(label, values); }
pub fn scroll(content: Widget): Widget { return ui_types.scroll(content); }
pub fn select(options: [str], selected_idx: int = 0, on_change: any = nil): Widget { return ui_types.select(options, selected_idx, on_change); }
pub fn slider(value: float = 50.0, min_val: float = 0.0, max_val: float = 100.0, on_change: any = nil): Widget { return ui_types.slider(value, min_val, max_val, on_change); }
pub fn spacer(flex: float = 1.0): Widget { return ui_types.spacer(flex); }
pub fn stack(children: [Widget]): Widget { return ui_types.stack(children); }
pub fn stat(title: str, value: str, desc: str = ""): Widget { return ui_types.stat(title, value, desc); }
pub fn stepper(value: int = 0, step: int = 1, min_val: int = 0, max_val: int = 100, on_change: any = nil): Widget { return ui_types.stepper(value, step, min_val, max_val, on_change); }
pub fn steps(step_titles: [str], active_step: int = 0): Widget { return ui_types.steps(step_titles, active_step); }
pub fn table(headers: [str], rows: [[Widget]]): Widget { return ui_types.table(headers, rows); }
pub fn tabs(titles: [str], pages: [Widget], active: int = 0, on_change: any = nil): Widget { return ui_types.tabs(titles, pages, active, on_change); }
pub fn text(content: str): Widget { return ui_types.text(content); }
pub fn text_area(value: str = "", placeholder: str = "Type here...", on_change: any = nil): Widget { return ui_types.text_area(value, placeholder, on_change); }
pub fn textarea(content: str): Widget { return ui_types.textarea(content); }
pub fn timeline(events: [Widget]): Widget { return ui_types.timeline(events); }
pub fn toast(message: str, type_val: str = "info"): Widget { return ui_types.toast(message, type_val); }
pub fn toggle(enabled: bool = false, on_change: any = nil): Widget { return ui_types.toggle(enabled, on_change); }
pub fn tooltip(label: str, content: Widget): Widget { return ui_types.tooltip(label, content); }
pub fn tree_node(label: str, children: [Widget], default_open: bool = false): Widget { return ui_types.tree_node(label, children, default_open); }

// ── Hybrid UI Execution Engine ────────────────────────────────────────────────
pub fn build(root: Widget, vw: float, vh: float, ts: any = nil, x: float = 0.0, y: float = 0.0): dl_mod.DrawList {
    return builder_mod.build(root, vw, vh, ts, x, y);
}
pub fn replay(dl: dl_mod.DrawList): nil {
    replay_mod.replay(dl);
}
pub fn dl_hit_test(dl: dl_mod.DrawList, px: float, py: float): dl_mod.HitZone {
    return dl_mod.dl_hit_test(dl, px, py);
}
