// Standard Library UI Module Index
// Re-exports windowing, context, retained nodes, layout, and widget constructors

import std.ui.window as window;
import std.ui.context as context;

var Window = window.Window;
var UIContext = context.UIContext;
var Node = context.Node;

fn create_window(title: str, width: int, height: int): window.Window? {
    return window.create_window(width, height, title);
}

fn create_label(id: int, text: str): context.Node {
    return context.create_label(id, text);
}

fn create_button(id: int, text: str): context.Node {
    return context.create_button(id, text);
}

fn create_slider(id: int, value: float): context.Node {
    return context.create_slider(id, value);
}

fn create_switch(id: int, checked: bool): context.Node {
    return context.create_switch(id, checked);
}

fn create_textfield(id: int, text: str): context.Node {
    return context.create_textfield(id, text);
}

fn create_progress(id: int, value: float): context.Node {
    return context.create_progress(id, value);
}

fn create_container(id: int, bg: context.Color): context.Node {
    return context.create_container(id, bg);
}
