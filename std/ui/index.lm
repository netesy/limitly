// UI Module Index
// Main entry point for the UI framework and widget toolkit

import std.ui.builder as builder;
import std.ui.window as window;
import std.ui.types as ui_types;

var Window = window.Window;

fn vstack(children: [ui_types.Blueprint]): ui_types.Blueprint {
    return builder.vstack(children);
}

fn hstack(children: [ui_types.Blueprint]): ui_types.Blueprint {
    return builder.hstack(children);
}

fn column(children: [ui_types.Blueprint]): ui_types.Blueprint {
    return builder.vstack(children);
}

fn row(children: [ui_types.Blueprint]): ui_types.Blueprint {
    return builder.hstack(children);
}

fn text(content: str): ui_types.Blueprint {
    return builder.text(content);
}

fn text_color(content: str, c: ui_types.Color): ui_types.Blueprint {
    return builder.text_color(content, c);
}

fn label(content: str): ui_types.Blueprint {
    return builder.text(content);
}

fn button(lbl: str): ui_types.Blueprint {
    return builder.button(lbl);
}

fn button_background(lbl: str, bg: ui_types.Color): ui_types.Blueprint {
    return builder.button_background(lbl, bg);
}

fn empty(): ui_types.Blueprint {
    return builder.empty();
}

fn color_rgb8(r: int, g: int, b: int): ui_types.Color {
    return builder.color_rgb8(r, g, b);
}
