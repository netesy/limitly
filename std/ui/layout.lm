// std/ui/layout - Layout measurement and box model over embedded UI components
import std.ui.types as ui_types;
import std.ui.components as comp;

// Layout box representing a measured widget with position and size
frame LayoutBox {
    pub var x: float;
    pub var y: float;
    pub var width: float;
    pub var height: float;
    pub var widget: comp.Fluent;
    pub var children: [LayoutBox];

    pub init(widget_val: comp.Fluent = comp.empty()) {
        self.x = 0.0;
        self.y = 0.0;
        self.width = 0.0;
        self.height = 0.0;
        self.widget = widget_val;
        self.children = [] as [LayoutBox];
    }
}

// Grid layout specification
frame GridSpec {
    pub var columns: int;
    pub var rows: int;
    pub var column_gap: float;
    pub var row_gap: float;

    pub init(cols: int = 2, rows: int = 0, col_gap: float = 8.0, row_gap: float = 8.0) {
        self.columns = cols;
        self.rows = rows;
        self.column_gap = col_gap;
        self.row_gap = row_gap;
    }
}

// Responsive breakpoint specification
frame Breakpoint {
    pub var min_width: float;
    pub var widget: comp.Fluent;

    pub init(min_w: float, w: comp.Fluent) {
        self.min_width = min_w;
        self.widget = w;
    }
}

// Measure widget height
fn measure_height(w: comp.Fluent): float {
    val wh = w.get_height();
    val pt = w.get_pad_t();
    val pb = w.get_pad_b();
    if (wh > 0.0) {
        return wh + pt + pb;
    }
    match (w.widget_kind()) {
        ui_types.WidgetKind.Text => { return 16.0 + pt + pb; },
        ui_types.WidgetKind.Button => { return 28.0 + pt + pb; },
        ui_types.WidgetKind.Container => {
            val c = w as comp.Container;
            var h = pt + pb;
            val n = len(c.children);
            if (n > 0) {
                iter (i in 0..n) {
                    h = h + measure_height(c.children[i]);
                    if (i < n - 1) {
                        h = h + c.spacing_val;
                    }
                }
            }
            return h;
        },
        _ => { return 16.0; }
    }
    return 16.0;
}

// Measure widget width
fn measure_width(w: comp.Fluent, available_w: float): float {
    val ww = w.get_width();
    val pl = w.get_pad_l();
    val pr = w.get_pad_r();
    if (ww > 0.0) {
        return ww + pl + pr;
    }
    match (w.widget_kind()) {
        ui_types.WidgetKind.Text => {
            val lbl = w as comp.Label;
            return ((len(lbl.resolved_text()) as float) * 8.0) + pl + pr;
        },
        ui_types.WidgetKind.Button => {
            val btn = w as comp.Button;
            var tw = ((len(btn.label) as float) * 8.0) + pl + pr + 16.0;
            if (tw > available_w) { tw = available_w; }
            return tw;
        },
        ui_types.WidgetKind.Container => {
            val c = w as comp.Container;
            if (not c.is_vertical()) {
                var total = pl + pr;
                val n = len(c.children);
                if (n > 0) {
                    iter (i in 0..n) {
                        total = total + measure_width(c.children[i], available_w);
                        if (i < n - 1) {
                            total = total + c.spacing_val;
                        }
                    }
                }
                if (total > available_w) { total = available_w; }
                return total;
            }
            return available_w;
        },
        _ => { return available_w; }
    }
    return available_w;
}

// Compute full layout tree with positions and sizes
pub fn compute_layout(widget: comp.Fluent, x: float, y: float, available_w: float, available_h: float): LayoutBox {
    val box = LayoutBox(widget);
    box.x = x;
    box.y = y;
    box.width = available_w;
    box.height = available_h;

    if (widget.widget_kind() == ui_types.WidgetKind.Container) {
        val c = widget as comp.Container;
        var curr_x = x + c.pad_l;
        var curr_y = y + c.pad_t;
        val inner_w = available_w - c.pad_l - c.pad_r;
        val n = len(c.children);

        if (c.is_vertical()) {
            if (n > 0) {
                iter (i in 0..n) {
                    val child = c.children[i];
                    val child_h = measure_height(child);
                    var child_w = inner_w;
                    val cw = child.get_width();
                    if (cw > 0.0) {
                        child_w = cw;
                    }
                    val child_box = compute_layout(child, curr_x, curr_y, child_w, child_h);
                    box.children.append(child_box);
                    curr_y = curr_y + child_h + c.spacing_val;
                }
            }
        } else {
            var fixed_w = 0.0;
            var num_spacers = 0;
            var total_flex = 0.0;
            if (n > 0) {
                iter (i in 0..n) {
                    val child = c.children[i];
                    if (child.widget_kind() == ui_types.WidgetKind.Spacer) {
                        num_spacers = num_spacers + 1;
                        total_flex = total_flex + child.get_flex();
                    } else {
                        fixed_w = fixed_w + measure_width(child, inner_w);
                    }
                }
            }

            var spacing_total = 0.0;
            if (n > 1) {
                spacing_total = ((n - 1) as float) * c.spacing_val;
            }
            val remaining_w = inner_w - fixed_w - spacing_total;
            var spacer_unit = 0.0;
            if (num_spacers > 0 and remaining_w > 0.0 and total_flex > 0.0) {
                spacer_unit = remaining_w / total_flex;
            }

            if (n > 0) {
                iter (i in 0..n) {
                    val child = c.children[i];
                    val child_h = measure_height(child);
                    var child_w = 0.0;
                    if (child.widget_kind() == ui_types.WidgetKind.Spacer) {
                        child_w = spacer_unit * child.get_flex();
                    } else {
                        child_w = measure_width(child, inner_w);
                    }
                    val child_box = compute_layout(child, curr_x, curr_y, child_w, child_h);
                    box.children.append(child_box);
                    curr_x = curr_x + child_w + c.spacing_val;
                }
            }
        }
    }

    return box;
}

// Flatten layout tree to list for efficient rendering and hit-testing
pub fn flatten_layout(box: LayoutBox): [LayoutBox] {
    val result: [LayoutBox] = [box];
    val n = len(box.children);
    var i = 0;
    while (i < n) {
        val child_list = flatten_layout(box.children[i]);
        val m = len(child_list);
        var j = 0;
        while (j < m) {
            result.append(child_list[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

// Hit-test a flat layout box list
pub fn hit_test_boxes(boxes: [LayoutBox], px: float, py: float): LayoutBox {
    val result = LayoutBox();
    var i = len(boxes) - 1;
    while (i >= 0) {
        val box = boxes[i];
        if (px >= box.x and px <= box.x + box.width and py >= box.y and py <= box.y + box.height) {
            return box;
        }
        i = i - 1;
    }
    return result;
}

fn apply_aspect_ratio(box: LayoutBox, ratio: float): LayoutBox {
    if (ratio <= 0.0) {
        return box;
    }
    if (box.width > 0.0) {
        box.height = box.width / ratio;
    } elif (box.height > 0.0) {
        box.width = box.height * ratio;
    }
    return box;
}

pub fn compute_grid_layout(spec: GridSpec, children: [comp.Fluent], x: float, y: float, available_w: float, available_h: float): [LayoutBox] {
    val result: [LayoutBox] = [];
    if (spec.columns <= 0) {
        return result;
    }

    val col_width = (available_w - (spec.column_gap * ((spec.columns - 1) as float))) / (spec.columns as float);
    var num_rows = 0;
    if (spec.rows > 0) {
        num_rows = spec.rows;
    } else {
        num_rows = (len(children) + spec.columns - 1) / spec.columns;
    }
    val row_height = (available_h - (spec.row_gap * ((num_rows - 1) as float))) / (num_rows as float);

    val n = len(children);
    if (n > 0) {
        iter (i in 0..n) {
            val col = i % spec.columns;
            val row = i / spec.columns;
            val child_x = x + (col as float) * (col_width + spec.column_gap);
            val child_y = y + (row as float) * (row_height + spec.row_gap);

            var child_box = LayoutBox(children[i]);
            child_box.x = child_x;
            child_box.y = child_y;
            child_box.width = col_width;
            child_box.height = row_height;

            val ar = children[i].get_aspect_ratio();
            if (ar > 0.0) {
                child_box = apply_aspect_ratio(child_box, ar);
            }
            result.append(child_box);
        }
    }
    return result;
}

pub fn responsive_layout(breakpoints: [Breakpoint], viewport_w: float, default_widget: comp.Fluent): comp.Fluent {
    var selected = default_widget;
    var i = 0;
    while (i < len(breakpoints)) {
        if (viewport_w >= breakpoints[i].min_width) {
            selected = breakpoints[i].widget;
        }
        i = i + 1;
    }
    return selected;
}

pub fn responsive(mobile: comp.Fluent, tablet: comp.Fluent, desktop: comp.Fluent, viewport_w: float): comp.Fluent {
    if (viewport_w < 768.0) {
        return mobile;
    } elif (viewport_w < 1024.0) {
        return tablet;
    }
    return desktop;
}

pub fn breakpoint(small: comp.Fluent, large: comp.Fluent, threshold: float = 768.0, viewport_w: float = 800.0): comp.Fluent {
    if (viewport_w < threshold) {
        return small;
    }
    return large;
}

fn apply_size_constraints(box: LayoutBox, widget: comp.Fluent): LayoutBox {
    val min_w = widget.get_min_width();
    val max_w = widget.get_max_width();
    val min_h = widget.get_min_height();
    val max_h = widget.get_max_height();
    if (min_w > 0.0 and box.width < min_w) { box.width = min_w; }
    if (max_w > 0.0 and box.width > max_w) { box.width = max_w; }
    if (min_h > 0.0 and box.height < min_h) { box.height = min_h; }
    if (max_h > 0.0 and box.height > max_h) { box.height = max_h; }
    return box;
}

pub fn compute_layout_enhanced(widget: comp.Fluent, x: float, y: float, available_w: float, available_h: float): LayoutBox {
    var box = compute_layout(widget, x, y, available_w, available_h);
    box = apply_size_constraints(box, widget);
    val ar = widget.get_aspect_ratio();
    if (ar > 0.0) {
        box = apply_aspect_ratio(box, ar);
    }
    return box;
}
