// std/ui/icon - Icon widget with Unicode symbols
import std.ui.types as ui_types;
import std.color as color;

// Common icon symbols (Unicode)
pub const ICON_CLOSE: str = "✕";
pub const ICON_MENU: str = "☰";
pub const ICON_HOME: str = "🏠";
pub const ICON_SETTINGS: str = "⚙";
pub const ICON_STAR: str = "★";
pub const ICON_HEART: str = "♥";
pub const ICON_ALERT: str = "⚠";
pub const ICON_CHECK: str = "✓";
pub const ICON_CROSS: str = "✗";
pub const ICON_ARROW_UP: str = "▲";
pub const ICON_ARROW_DOWN: str = "▼";
pub const ICON_ARROW_LEFT: str = "◀";
pub const ICON_ARROW_RIGHT: str = "▶";
pub const ICON_SEARCH: str = "🔍";
pub const ICON_LOCK: str = "🔒";
pub const ICON_USER: str = "👤";
pub const ICON_TRASH: str = "🗑";
pub const ICON_EDIT: str = "✎";

// Create an icon widget
pub fn icon(glyph: str, size: float = 24.0, color_val: color.Color = color.white): ui_types.Widget {
    var w = ui_types.text(glyph);
    w.font_size_val = size;
    w.width_val = size;
    w.height_val = size;
    w.foreground_color = color_val;
    w.is_a11y_hidden = true;
    return w;
}

// Icon button (icon + optional label)
pub fn icon_button(glyph: str, label: str = "", on_click: any = nil, size: float = 20.0): ui_types.Widget {
    if (len(label) > 0) {
        var row = ui_types.row([
            icon(glyph, size),
            ui_types.text(label)
        ]);
        row.spacing_val = 8.0;
        var btn = ui_types.button("").on_click(on_click);
        btn.children = [row];
        return btn;
    }
    var ic = icon(glyph, size);
    var btn = ui_types.button("").on_click(on_click);
    btn.children = [ic];
    return btn;
}
