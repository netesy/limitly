// std/ui/icon - Icon widget with Unicode symbols
import std.ui.components as comp;
import std.color as color;

pub const ICON_CLOSE: str = "✕";
pub const ICON_MENU: str = "☰";
pub const ICON_HOME: str = "🏠";
pub const ICON_SETTINGS: str = "⚙";
pub const ICON_STAR: str = "★";
pub const ICON_HEART: str = "♥";
pub const ICON_ALERT: str = "⚠";
pub const ICON_CHECK: str = "✓";
pub const ICON_CROSS: str = "✗";
pub const ICON_ARROW_UP: str = "▲";
pub const ICON_ARROW_DOWN: str = "▼";
pub const ICON_ARROW_LEFT: str = "◀";
pub const ICON_ARROW_RIGHT: str = "▶";
pub const ICON_SEARCH: str = "🔍";
pub const ICON_LOCK: str = "🔒";
pub const ICON_USER: str = "👤";
pub const ICON_TRASH: str = "🗑";
pub const ICON_EDIT: str = "✎";

pub fn icon(glyph: str, size: float = 24.0, color_val: color.Color = color.white): comp.Label {
    val w = comp.Label(glyph);
    w.font_size_val = size;
    w.width_val = size;
    w.height_val = size;
    w.fg = color_val;
    w.a11y_role = "presentation";
    return w;
}

pub fn icon_button(glyph: str, label: str = "", on_click: (fn(): nil) | nil = nil, size: float = 20.0): comp.Button {
    var text_val = glyph;
    if (len(label) > 0) {
        text_val = glyph + " " + label;
    }
    val btn = comp.Button(text_val, on_click);
    btn.font_size_val = size;
    return btn;
}
