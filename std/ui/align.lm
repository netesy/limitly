// std/ui/align - Alignment and justification control
import std.ui.types as ui_types;

pub fn align_start(): ui_types.Alignment {
    return ui_types.align_start;
}

pub fn align_center(): ui_types.Alignment {
    return ui_types.align_center;
}

pub fn align_end(): ui_types.Alignment {
    return ui_types.align_end;
}

pub fn center(child: ui_types.Widget): ui_types.Widget {
    var w = ui_types.column([child]);
    w.align_val = ui_types.align_center.align_type;
    return w;
}
