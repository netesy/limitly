import std.ui.widget as widget;

frame Align {
    pub var child: widget.Widget;
    pub var alignment: int; // 0 = Center, 1 = TopLeft, etc.

    pub init(ch: widget.Widget = widget.Widget(), align: int = 0) {
        self.child = ch;
        self.alignment = align;
    }

    pub fn build(): widget.Widget {
        return self;
    }
}
