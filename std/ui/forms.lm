// std/ui/forms - Type-Safe Form State Management with Validation
// Uses `staged frame ValidationRule(T: type)` and typed reactive signals (`StrSignal`,
// `BoolSignal`, `FloatSignal`) — zero `any` in validators or field bindings.

import std.ui.components as comp;
import std.ui.state as state;
import std.color as color;
import std.string show contains;

// ── Validation Result ───────────────────────────────────────────────────────
frame ValidationResult {
    pub var is_valid: bool;
    pub var error_message: str;
    pub var field_name: str;

    pub init(valid: bool = true, error: str = "", field: str = "") {
        self.is_valid = valid;
        self.error_message = error;
        self.field_name = field;
    }

    pub fn valid(): ValidationResult {
        return ValidationResult(valid=true, error="", field="");
    }

    pub fn error(message: str, field: str): ValidationResult {
        return ValidationResult(valid=false, error=message, field=field);
    }
}

// ── Typed Validation Rules ─────────────────────────────────────────────────
staged frame ValidationRule(T: type) {
    pub var field_name: str;
    pub var validator: fn(T): ValidationResult;
    pub var is_required: bool;

    pub init(field: str, validator_fn: fn(T): ValidationResult, required: bool = false) {
        self.field_name = field;
        self.validator = validator_fn;
        self.is_required = required;
    }
}

type StrRule = ValidationRule(str);
type FloatRule = ValidationRule(float);

// ── Common Validators ────────────────────────────────────────────────────────
pub fn required_validator(field_name: str): StrRule {
    return StrRule(
        field=field_name,
        validator_fn=fn(value: str): ValidationResult {
            if (len(value) == 0) {
                return ValidationResult().error(field_name + " is required", field_name);
            }
            return ValidationResult().valid();
        },
        required=true
    );
}

pub fn min_length_validator(field_name: str, min_len: int): StrRule {
    return StrRule(
        field=field_name,
        validator_fn=fn(value: str): ValidationResult {
            if (len(value) < min_len) {
                return ValidationResult().error(field_name + " must be at least " + (min_len as str) + " characters", field_name);
            }
            return ValidationResult().valid();
        },
        required=false
    );
}

pub fn max_length_validator(field_name: str, max_len: int): StrRule {
    return StrRule(
        field=field_name,
        validator_fn=fn(value: str): ValidationResult {
            if (len(value) > max_len) {
                return ValidationResult().error(field_name + " must be at most " + (max_len as str) + " characters", field_name);
            }
            return ValidationResult().valid();
        },
        required=false
    );
}

pub fn email_validator(field_name: str): StrRule {
    return StrRule(
        field=field_name,
        validator_fn=fn(value: str): ValidationResult {
            if (not contains(value, "@")) {
                return ValidationResult().error(field_name + " must be a valid email", field_name);
            }
            return ValidationResult().valid();
        },
        required=false
    );
}

pub fn min_value_validator(field_name: str, min_val: float): FloatRule {
    return FloatRule(
        field=field_name,
        validator_fn=fn(value: float): ValidationResult {
            if (value < min_val) {
                return ValidationResult().error(field_name + " must be at least " + (min_val as str), field_name);
            }
            return ValidationResult().valid();
        },
        required=false
    );
}

pub fn max_value_validator(field_name: str, max_val: float): FloatRule {
    return FloatRule(
        field=field_name,
        validator_fn=fn(value: float): ValidationResult {
            if (value > max_val) {
                return ValidationResult().error(field_name + " must be at most " + (max_val as str), field_name);
            }
            return ValidationResult().valid();
        },
        required=false
    );
}

pub fn pattern_validator(field_name: str, pattern: str): StrRule {
    return StrRule(
        field=field_name,
        validator_fn=fn(value: str): ValidationResult {
            if (len(value) == 0 or len(pattern) == 0) {
                return ValidationResult().valid();
            }
            if (not contains(value, pattern)) {
                return ValidationResult().error(field_name + " does not match expected pattern", field_name);
            }
            return ValidationResult().valid();
        },
        required=false
    );
}

// ── Form State ─────────────────────────────────────────────────────────────
frame FormState {
    pub var str_values: {str: state.StrSignal};
    pub var bool_values: {str: state.BoolSignal};
    pub var float_values: {str: state.FloatSignal};
    pub var errors: {str: state.StrSignal};
    pub var touched: {str: state.BoolSignal};
    pub var str_rules: [StrRule];
    pub var float_rules: [FloatRule];
    pub var is_valid: state.BoolSignal;
    pub var is_submitting: state.BoolSignal;
    pub var on_submit: ({str: str}) -> nil;
    pub var on_success: ({str: str}) -> nil;
    pub var on_error: ([ValidationResult]) -> nil;
    pub var initial_str: {str: str};
    pub var initial_bool: {str: bool};
    pub var initial_float: {str: float};

    pub init() {
        self.str_values = {};
        self.bool_values = {};
        self.float_values = {};
        self.errors = {};
        self.touched = {};
        self.str_rules = [] as [StrRule];
        self.float_rules = [] as [FloatRule];
        self.is_valid = state.signal_bool(true);
        self.is_submitting = state.signal_bool(false);
        self.on_submit = fn(values: {str: str}): nil {};
        self.on_success = fn(values: {str: str}): nil {};
        self.on_error = fn(errors: [ValidationResult]): nil {};
        self.initial_str = {};
        self.initial_bool = {};
        self.initial_float = {};
    }

    pub fn add_field(field_name: str, initial_value: str = ""): nil {
        self.str_values[field_name] = state.signal_str(initial_value);
        self.errors[field_name] = state.signal_str("");
        self.touched[field_name] = state.signal_bool(false);
        self.initial_str[field_name] = initial_value;
    }

    pub fn add_bool_field(field_name: str, initial_value: bool = false): nil {
        self.bool_values[field_name] = state.signal_bool(initial_value);
        self.errors[field_name] = state.signal_str("");
        self.touched[field_name] = state.signal_bool(false);
        self.initial_bool[field_name] = initial_value;
    }

    pub fn add_float_field(field_name: str, initial_value: float = 0.0): nil {
        self.float_values[field_name] = state.signal_float(initial_value);
        self.errors[field_name] = state.signal_str("");
        self.touched[field_name] = state.signal_bool(false);
        self.initial_float[field_name] = initial_value;
    }

    pub fn add_rule(rule: StrRule): nil {
        self.str_rules.append(rule);
    }

    pub fn add_float_rule(rule: FloatRule): nil {
        self.float_rules.append(rule);
    }

    pub fn set_value(field_name: str, value: str): nil {
        if (self.str_values[field_name] != nil) {
            self.str_values[field_name].set(value);
            self.validate_field(field_name);
        }
    }

    pub fn set_bool_value(field_name: str, value: bool): nil {
        if (self.bool_values[field_name] != nil) {
            self.bool_values[field_name].set(value);
        }
    }

    pub fn set_float_value(field_name: str, value: float): nil {
        if (self.float_values[field_name] != nil) {
            self.float_values[field_name].set(value);
            self.validate_field(field_name);
        }
    }

    pub fn get_value(field_name: str): str {
        if (self.str_values[field_name] != nil) {
            return self.str_values[field_name].get();
        }
        return "";
    }

    pub fn get_float_value(field_name: str): float {
        if (self.float_values[field_name] != nil) {
            return self.float_values[field_name].get();
        }
        return 0.0;
    }

    pub fn mark_touched(field_name: str): nil {
        if (self.touched[field_name] != nil) {
            self.touched[field_name].set(true);
        }
    }

    pub fn validate_field(field_name: str): ValidationResult {
        var res_valid = true;
        var res_err = "";
        var res_field = "";

        if (self.str_values[field_name] != nil) {
            val s = self.str_values[field_name].get();
            iter (rule in self.str_rules) {
                if (rule.field_name == field_name) {
                    val v_res = rule.validator(s);
                    if (not v_res.is_valid) {
                        res_valid = false;
                        res_err = v_res.error_message;
                        res_field = v_res.field_name;
                        break;
                    }
                }
            }
        }

        if (res_valid and self.float_values[field_name] != nil) {
            val f = self.float_values[field_name].get();
            iter (rule in self.float_rules) {
                if (rule.field_name == field_name) {
                    val v_res = rule.validator(f);
                    if (not v_res.is_valid) {
                        res_valid = false;
                        res_err = v_res.error_message;
                        res_field = v_res.field_name;
                        break;
                    }
                }
            }
        }

        if (self.errors[field_name] != nil) {
            self.errors[field_name].set(res_err);
        }

        self.validate_all();
        return ValidationResult(valid=res_valid, error=res_err, field=res_field);
    }

    pub fn validate_all(): nil {
        var all_valid = true;
        iter (rule in self.str_rules) {
            val s = self.get_value(rule.field_name);
            val v_res = rule.validator(s);
            if (not v_res.is_valid) {
                all_valid = false;
                if (self.errors[rule.field_name] != nil) {
                    self.errors[rule.field_name].set(v_res.error_message);
                }
            } else {
                if (self.errors[rule.field_name] != nil) {
                    self.errors[rule.field_name].set("");
                }
            }
        }
        iter (rule in self.float_rules) {
            val f = self.get_float_value(rule.field_name);
            val v_res = rule.validator(f);
            if (not v_res.is_valid) {
                all_valid = false;
                if (self.errors[rule.field_name] != nil) {
                    self.errors[rule.field_name].set(v_res.error_message);
                }
            } elif (self.str_values[rule.field_name] == nil) {
                if (self.errors[rule.field_name] != nil) {
                    self.errors[rule.field_name].set("");
                }
            }
        }
        self.is_valid.set(all_valid);
    }

    pub fn get_values(): {str: str} {
        val result: {str: str} = {};
        iter (k, sig in self.str_values) {
            result[k] = sig.get();
        }
        return result;
    }

    pub fn get_errors(): [ValidationResult] {
        val errs: [ValidationResult] = [];
        iter (rule in self.str_rules) {
            val v_res = rule.validator(self.get_value(rule.field_name));
            if (not v_res.is_valid) {
                errs.append(v_res);
            }
        }
        iter (rule in self.float_rules) {
            val v_res = rule.validator(self.get_float_value(rule.field_name));
            if (not v_res.is_valid) {
                errs.append(v_res);
            }
        }
        return errs;
    }

    pub fn submit(): nil {
        self.validate_all();
        if (self.is_valid.get()) {
            self.is_submitting.set(true);
            val cb = self.on_submit;
            cb(self.get_values());
        } else {
            val cb = self.on_error;
            cb(self.get_errors());
        }
    }

    pub fn submit_success(values: {str: str}): nil {
        self.is_submitting.set(false);
        val cb = self.on_success;
        cb(values);
    }

    pub fn submit_failure(errors: [ValidationResult]): nil {
        self.is_submitting.set(false);
        val cb = self.on_error;
        cb(errors);
    }

    pub fn reset(): nil {
        iter (k, sig in self.touched) {
            sig.set(false);
        }
        iter (k, sig in self.errors) {
            sig.set("");
        }
        iter (k, sig in self.str_values) {
            if (self.initial_str[k] != nil) {
                sig.set(self.initial_str[k]);
            }
        }
        iter (k, sig in self.bool_values) {
            if (self.initial_bool[k] != nil) {
                sig.set(self.initial_bool[k]);
            }
        }
        iter (k, sig in self.float_values) {
            if (self.initial_float[k] != nil) {
                sig.set(self.initial_float[k]);
            }
        }
        self.is_valid.set(true);
        self.is_submitting.set(false);
    }
}

// ── Form Builder ───────────────────────────────────────────────────────────
frame FormBuilder {
    pub var form_state: FormState;

    pub init() {
        self.form_state = FormState();
    }

    pub fn field(name: str, initial: str = ""): FormBuilder {
        self.form_state.add_field(name, initial);
        return self;
    }

    pub fn bool_field(name: str, initial: bool = false): FormBuilder {
        self.form_state.add_bool_field(name, initial);
        return self;
    }

    pub fn float_field(name: str, initial: float = 0.0): FormBuilder {
        self.form_state.add_float_field(name, initial);
        return self;
    }

    pub fn rule(rule: StrRule): FormBuilder {
        self.form_state.add_rule(rule);
        return self;
    }

    pub fn float_rule(rule: FloatRule): FormBuilder {
        self.form_state.add_float_rule(rule);
        return self;
    }

    pub fn required(field_name: str): FormBuilder {
        self.form_state.add_rule(required_validator(field_name));
        return self;
    }

    pub fn min_length(field_name: str, min_len: int): FormBuilder {
        self.form_state.add_rule(min_length_validator(field_name, min_len));
        return self;
    }

    pub fn max_length(field_name: str, max_len: int): FormBuilder {
        self.form_state.add_rule(max_length_validator(field_name, max_len));
        return self;
    }

    pub fn email(field_name: str): FormBuilder {
        self.form_state.add_rule(email_validator(field_name));
        return self;
    }

    pub fn min_value(field_name: str, min_val: float): FormBuilder {
        self.form_state.add_float_rule(min_value_validator(field_name, min_val));
        return self;
    }

    pub fn max_value(field_name: str, max_val: float): FormBuilder {
        self.form_state.add_float_rule(max_value_validator(field_name, max_val));
        return self;
    }

    pub fn pattern(field_name: str, pattern: str): FormBuilder {
        self.form_state.add_rule(pattern_validator(field_name, pattern));
        return self;
    }

    pub fn submit_handler(handler: ({str: str}) -> nil): FormBuilder {
        self.form_state.on_submit = handler;
        return self;
    }

    pub fn success_handler(handler: ({str: str}) -> nil): FormBuilder {
        self.form_state.on_success = handler;
        return self;
    }

    pub fn error_handler(handler: ([ValidationResult]) -> nil): FormBuilder {
        self.form_state.on_error = handler;
        return self;
    }

    pub fn build(): FormState {
        return self.form_state;
    }
}

// ── Factory Functions ──────────────────────────────────────────────────────
pub fn form_builder(): FormBuilder {
    return FormBuilder();
}

pub fn create_form(): FormState {
    return FormState();
}

// ── Field Binding Helpers ───────────────────────────────────────────────────
pub fn bind_text_field(form: FormState, field_name: str, widget: comp.TextInput): comp.TextInput {
    val sig = form.str_values[field_name];
    if (sig != nil) {
        widget.bind_text(sig);
    }
    val err_sig = form.errors[field_name];
    if (err_sig != nil) {
        err_sig.subscribe(fn(err_msg: str): nil {
            if (len(err_msg) > 0) {
                widget.fg = color.rgb(255, 100, 100);
            } else {
                widget.fg = color.white;
            }
        });
    }
    return widget;
}

pub fn bind_checkbox_field(form: FormState, field_name: str, widget: comp.Checkbox): comp.Checkbox {
    val sig = form.bool_values[field_name];
    if (sig != nil) {
        widget.bind_checked(sig);
    }
    return widget;
}

pub fn bind_slider_field(form: FormState, field_name: str, widget: comp.Slider): comp.Slider {
    val sig = form.float_values[field_name];
    if (sig != nil) {
        widget.bind_value(sig);
    }
    return widget;
}

pub fn field_error_widget(form: FormState, field_name: str): comp.Label {
    val err_sig = form.errors[field_name];
    val err_widget = comp.Label("");
    if (err_sig != nil) {
        err_widget.bind_text(err_sig);
        err_widget.fg = color.rgb(255, 100, 100);
        err_widget.font_size_val = 12.0;
    }
    return err_widget;
}
