// std/ui/radio - Radio button widget (single selection in group)
import std.ui.types as ui_types;

pub fn radio(checked: bool = false, on_change: any = nil): ui_types.Widget {
    var w = ui_types.checkbox(checked, on_change);
    w.text_val = "(•)";
    if (not checked) {
        w.text_val = "( )";
    }
    return w;
}
