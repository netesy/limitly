// std/ui/state.lm
// Type-Safe Reactive State Management (Zero `any` via Staged Frame Templates)

pub var _dirty_notifier: (fn(): nil) | nil = nil;
pub var _batch_depth: int = 0;

pub fn register_dirty_notifier(cb: fn(): nil): nil {
    _dirty_notifier = cb;
}

fn mark_element_dirty_signal(): nil {
    if (_dirty_notifier != nil) {
        val f = _dirty_notifier as fn(): nil;
        f();
    }
}

pub fn batch_begin(): nil {
    _batch_depth = _batch_depth + 1;
}

pub fn batch_end(): nil {
    _batch_depth = _batch_depth - 1;
    if (_batch_depth == 0) {
        mark_element_dirty_signal();
    }
}

pub fn batch_updates(updates: fn(): nil): nil {
    batch_begin();
    updates();
    batch_end();
}

// ── Type-Erased Dependency Graph Edge (No `any` payload) ──────────────────────

frame SignalNode {
    pub var listeners: [fn(): nil];

    pub init() {
        self.listeners = [] as [fn(): nil];
    }

    pub fn attach(cb: fn(): nil): nil {
        self.listeners.append(cb);
    }

    pub fn notify(): nil {
        iter (i in 0..len(self.listeners)) {
            val cb = self.listeners[i];
            cb();
        }
    }

    pub fn listener_count(): int {
        return len(self.listeners);
    }
}

// ── Staged Type-Safe Reactive Primitives ─────────────────────────────────────

staged frame Signal(T: type) {
    pub var value: T;
    pub var subscribers: [fn(T): nil];
    pub var node: SignalNode;

    pub init(init_val: T) {
        self.value = init_val;
        self.subscribers = [] as [fn(T): nil];
        self.node = SignalNode();
    }

    pub fn subscriber_count(): int {
        return len(self.subscribers);
    }

    pub fn subscribe(callback: fn(T): nil): nil {
        self.subscribers.append(callback);
    }

    pub fn get(): T {
        return self.value;
    }

    pub fn set(new_val: T): nil {
        self.value = new_val;
        iter (i in 0..len(self.subscribers)) {
            val sub = self.subscribers[i];
            sub(new_val);
        }
        self.node.notify();
        if (_batch_depth == 0) {
            mark_element_dirty_signal();
        }
    }
}

staged frame ComputedSignal(T: type) {
    pub var compute_fn: fn(): T;
    pub var value: T;
    pub var is_dirty: int;
    pub var subscribers: [fn(T): nil];
    pub var dependencies: [SignalNode];
    pub var node: SignalNode;

    pub init(compute: fn(): T, deps: [SignalNode]) {
        self.compute_fn = compute;
        self.dependencies = deps;
        self.value = compute();
        self.subscribers = [] as [fn(T): nil];
        self.is_dirty = 0;
        self.node = SignalNode();
        iter (i in 0..len(deps)) {
            deps[i].attach(fn(): nil { self.poke(); });
        }
    }

    pub fn subscribe(callback: fn(T): nil): nil {
        self.subscribers.append(callback);
    }

    pub fn dep_count(): int {
        return len(self.dependencies);
    }

    pub fn get(): T {
        if (self.is_dirty == 1) {
            self.value = self.compute_fn();
            self.is_dirty = 0;
        }
        return self.value;
    }

    pub fn poke(): nil {
        self.is_dirty = 1;
        val nv = self.get();
        iter (i in 0..len(self.subscribers)) {
            val sub = self.subscribers[i];
            sub(nv);
        }
        self.node.notify();
        if (_batch_depth == 0) {
            mark_element_dirty_signal();
        }
    }
}

frame Effect {
    pub var effect_fn: fn(): nil;
    pub var cleanup_fn: (fn(): nil) | nil;
    pub var is_active: int;
    pub var dependencies: [SignalNode];

    pub init(user_effect: fn(): nil, deps: [SignalNode]) {
        self.effect_fn = user_effect;
        self.dependencies = deps;
        self.cleanup_fn = nil;
        self.is_active = 1;
        iter (i in 0..len(deps)) {
            deps[i].attach(fn(): nil { self._effect_dep_changed(); });
        }
        user_effect();
    }

    pub fn dispose(): nil {
        if (self.is_active == 1 and self.cleanup_fn != nil) {
            val cleanup = self.cleanup_fn as fn(): nil;
            cleanup();
        }
        self.is_active = 0;
    }

    pub fn dep_count(): int {
        return len(self.dependencies);
    }

    fn _effect_dep_changed(): nil {
        if (self.is_active == 1) {
            if (self.cleanup_fn != nil) {
                val cleanup = self.cleanup_fn as fn(): nil;
                cleanup();
            }
            self.effect_fn();
        }
    }
}

pub var _active_effects: [Effect] = [] as [Effect];

pub fn effect(effect_fn: fn(): nil, deps: [SignalNode]): Effect {
    val eff = Effect(effect_fn, deps);
    _active_effects.append(eff);
    return eff;
}

pub fn effect_with_cleanup(effect_fn: fn(): nil, cleanup_fn: fn(): nil, deps: [SignalNode]): Effect {
    val eff = Effect(effect_fn, deps);
    eff.cleanup_fn = cleanup_fn;
    _active_effects.append(eff);
    return eff;
}

pub fn dispose_all_effects(): nil {
    iter (i in 0..len(_active_effects)) {
        _active_effects[i].dispose();
    }
    _active_effects = [] as [Effect];
}

// ── Concrete Typed Signal Wrappers (Cross-Module Safe) ───────────────────────

frame BoolSignal {
    pub var value: bool;
    pub var subscribers: [fn(bool): nil];
    pub var node: SignalNode;

    pub init(init_val: bool = false) {
        self.value = init_val;
        self.subscribers = [] as [fn(bool): nil];
        self.node = SignalNode();
    }

    pub fn subscribe(callback: fn(bool): nil): nil { self.subscribers.append(callback); }
    pub fn get(): bool { return self.value; }
    pub fn set(new_val: bool): nil {
        self.value = new_val;
        iter (i in 0..len(self.subscribers)) {
            val sub = self.subscribers[i];
            sub(new_val);
        }
        self.node.notify();
        if (_batch_depth == 0) { mark_element_dirty_signal(); }
    }
}

