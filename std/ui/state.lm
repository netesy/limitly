}

frame StrSignal {
    pub var value: str;
    pub var subscribers: [fn(str): nil];
    pub var node: SignalNode;

    pub init(init_val: str = "") {
        self.value = init_val;
        self.subscribers = [] as [fn(str): nil];
        self.node = SignalNode();
    }

    pub fn subscribe(callback: fn(str): nil): nil { self.subscribers.append(callback); }
    pub fn get(): str { return self.value; }
    pub fn set(new_val: str): nil {
        self.value = new_val;
        iter (i in 0..len(self.subscribers)) {
            val sub = self.subscribers[i];
            sub(new_val);
        }
        self.node.notify();
        if (_batch_depth == 0) { mark_element_dirty_signal(); }
    }
}

frame ComputedStr {
    pub var compute_fn: fn(): str;
    pub var value: str;
    pub var is_dirty: int;
    pub var subscribers: [fn(str): nil];
    pub var dependencies: [SignalNode];
    pub var node: SignalNode;

    pub init(compute: fn(): str, deps: [SignalNode]) {
        self.compute_fn = compute;
        self.dependencies = deps;
        self.value = compute();
        self.subscribers = [] as [fn(str): nil];
        self.is_dirty = 0;
        self.node = SignalNode();
        iter (i in 0..len(deps)) {
            deps[i].attach(fn(): nil { self.poke(); });
        }
    }

    pub fn subscribe(callback: fn(str): nil): nil { self.subscribers.append(callback); }
    pub fn get(): str {
        if (self.is_dirty == 1) {
            self.value = self.compute_fn();
            self.is_dirty = 0;
        }
        return self.value;
    }

    pub fn poke(): nil {
        self.is_dirty = 1;
        val nv = self.get();
        iter (i in 0..len(self.subscribers)) {
            val sub = self.subscribers[i];
            sub(nv);
        }
        self.node.notify();
        if (_batch_depth == 0) { mark_element_dirty_signal(); }
    }
}

pub fn signal_bool(init_val: bool): BoolSignal { return BoolSignal(init_val); }
pub fn signal_int(init_val: int): IntSignal { return IntSignal(init_val); }
pub fn signal_float(init_val: float): FloatSignal { return FloatSignal(init_val); }
pub fn signal_str(init_val: str): StrSignal { return StrSignal(init_val); }
pub fn computed_str(compute_fn: fn(): str, deps: [SignalNode]): ComputedStr { return ComputedStr(compute_fn, deps); }

pub fn bind_text(sig: StrSignal, widget_mutator: fn(str): nil): nil {
    sig.subscribe(widget_mutator);
}

pub fn bind_bool(sig: BoolSignal, widget_mutator: fn(bool): nil): nil {
    sig.subscribe(widget_mutator);
}

pub fn bind_float(sig: FloatSignal, widget_mutator: fn(float): nil): nil {
    sig.subscribe(widget_mutator);
}

pub fn bind_int(sig: IntSignal, widget_mutator: fn(int): nil): nil {
    sig.subscribe(widget_mutator);
}
