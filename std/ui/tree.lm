// std/ui/tree.lm
// M2 frame driver: focus ownership + per-frame update/event dispatch.
//
// update() clears the shared draw list (dl.paint_ctx), arranges the root
// to the viewport and paints the whole tree into it. submit() replays it
// through std.ui.replay. Widgets never receive the DrawList — they emit
// into dl.paint_ctx.dl directly (trait dispatch can't take managed args).
//
// dispatch() routes one std.events.Event: pointer events go through
// recursive hit-testing (topmost child wins); keyboard/text events go to
// the focused component first, then fall through to the root.
//
// Focus rule: single owner. Clicking inside a widget that claims focus
// (TextInput) sets it; any MouseDown that lands outside the focused
// widget's bounds clears it.

import std.ui.component as comp;
import std.ui.event as uievent;
import std.ui.draw_list as dl;
import std.ui.replay as replay;
import std.ui.state as state;
import std.events as events;

pub var focused_component: comp.Component? = nil;

// Dirty flag: set by signal notifications (state.register_dirty_notifier),
// by dispatch() on Handled events, and by request_repaint(); cleared by
// update() after a successful paint.
pub var dirty: int = 1;

// M5 repaint elision: enable_reactive() turns it on. While enabled,
// update() skips arrange+paint entirely when nothing changed (dirty == 0)
// and the viewport size is unchanged — submit() then replays the retained
// draw list, which is still valid. Audit counters expose the hit rate.
pub var repaint_elision: int = 0;
pub var repainted_frames: int = 0;
pub var skipped_frames: int = 0;
pub var last_w: float = -1.0;
pub var last_h: float = -1.0;

// Overlay channel: transient popups (Select dropdowns, tooltips) whose
// bounds may extend past their laid-out siblings. Overlays paint AFTER
// the root (on top) and get first chance at pointer events whose coords
// fall inside their bounds. Widgets push themselves on open and remove
// themselves on close; order is open-order, last opened on top.
pub var overlays: [comp.Component] = [];

// Pointer capture: widget_id of the component holding an active
// press/drag (Component.wants_pointer_capture). While nonzero, pointer
// motion and the release are routed only to that widget's subtree —
// through the normal container path so scroll/clip coord adjustment
// still applies — regardless of where the pointer is.
pub var captured_id: int = 0;

// Last known pointer position in window coords. MouseWheel events carry
// their delta in Event.y (the position y is not delivered), so scroll
// hit-testing uses this instead.
pub var pointer_x: float = 0.0;
pub var pointer_y: float = 0.0;

// True when `id` is `c` itself or any descendant (child_at walk).
pub fn subtree_has_widget(c: comp.Component, id: int): bool {
    if (c.widget_id() == id) { return true; }
    var i = 0;
    while (i < c.child_count()) {
        val ch = c.child_at(i);
        if (ch != nil and subtree_has_widget(ch as comp.Component, id)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Deepest/topmost component wanting capture, or 0. Children are walked
// in reverse paint order so the visually-topmost claimant wins.
fn find_capture(c: comp.Component): int {
    var i = c.child_count() - 1;
    while (i >= 0) {
        val ch = c.child_at(i);
        if (ch != nil) {
            var id = find_capture(ch as comp.Component);
            if (id != 0) { return id; }
        }
        i = i - 1;
    }
    if (c.wants_pointer_capture() != 0) {
        return c.widget_id();
    }
    return 0;
}

pub fn push_overlay(c: comp.Component): nil {
    overlays.append(c);
}

pub fn remove_overlay(c: comp.Component): nil {
    var kept: [comp.Component] = [];
    var i = 0;
    while (i < len(overlays)) {
        if (overlays[i].widget_id() != c.widget_id()) {
            kept.append(overlays[i]);
        }
        i = i + 1;
    }
    overlays = kept;
}

pub fn request_repaint(): nil {
    dirty = 1;
}

// Wire signal notifications into the dirty flag AND enable repaint
// elision. Call once at startup:
//   tree.enable_reactive();
pub fn enable_reactive(): nil {
    repaint_elision = 1;
    state.register_dirty_notifier(on_state_dirty);
}

pub fn on_state_dirty(): nil {
    dirty = 1;
}

pub fn set_focus(c: comp.Component): nil {
    focused_component = c;
}

pub fn clear_focus(): nil {
    focused_component = nil;
}

pub fn focused(): comp.Component? {
    return focused_component;
}

// Arrange the root to the full viewport and paint the tree into the
// shared paint-context draw list. Call submit() to replay it to gg.
pub fn update(root: comp.Component, w: float, h: float): nil {
    if (repaint_elision != 0 and dirty == 0 and w == last_w and h == last_h) {
        skipped_frames = skipped_frames + 1;
        return;
    }
    dl.paint_ctx.dl.clear();
    root.arrange(0.0, 0.0, w, h);
    root.paint();
    var oi = 0;
    while (oi < len(overlays)) {
        overlays[oi].paint();
        oi = oi + 1;
    }
    dirty = 0;
    last_w = w;
    last_h = h;
    repainted_frames = repainted_frames + 1;
}

// Replay the painted frame to the GPU backend.
pub fn submit(): nil {
    replay.replay(dl.paint_ctx.dl);
}

// Route one event through the tree. Returns the deepest handler's result.
pub fn dispatch(root: comp.Component, ev: events.Event): uievent.EventResult {
    if (ev.event_type == events.EventType.MouseMove
        or ev.event_type == events.EventType.MouseDown
        or ev.event_type == events.EventType.MouseUp) {
        pointer_x = ev.x as float;
        pointer_y = ev.y as float;
    }
    var result = uievent.EventResult.Ignored;
    var is_text_event: int = 0;
    if (ev.event_type == events.EventType.KeyDown or ev.event_type == events.EventType.KeyUp or ev.event_type == events.EventType.Char) {
        is_text_event = 1;
    }
    if (is_text_event != 0) {
        if (focused_component != nil) {
            var fw = focused_component as comp.Component;
            result = fw.on_event(ev.event_type, ev.x, ev.y, ev.key_code);
            if (result == uievent.EventResult.Handled) {
                dirty = 1;
                return result;
            }
        }
        result = root.on_event(ev.event_type, ev.x, ev.y, ev.key_code);
    } else {
        // Pointer events: overlays get first chance (topmost last-opened).
        // While a widget holds pointer capture, an overlay only sees the
        // event when the capturer lives inside it; the capturer's own
        // subtree filter does the rest.
        var captured_move: int = 0;
        if (captured_id != 0 and (ev.event_type == events.EventType.MouseMove
            or ev.event_type == events.EventType.MouseUp)) {
            captured_move = 1;
        }
        var handled_by: any = nil;
        var oi = len(overlays) - 1;
        var overlay_done: int = 0;
        while ((oi >= 0) and (overlay_done == 0)) {
            val ov = overlays[oi];
            var ov_hit: bool = true;
            val ovb = ov.bounds();
            if (captured_move != 0) {
                ov_hit = subtree_has_widget(ov, captured_id);
            } else {
                // bounds() returns a frame by value — bind before calling
                // methods on it (rvalue receivers misbehave in the VM).
                ov_hit = ovb.contains(ev.x as float, ev.y as float);
            }
            // Click-away dismiss: a MouseDown outside an overlay's bounds
            // never reaches its on_event, so notify it directly.
            if (ev.event_type == events.EventType.MouseDown and not ov_hit) {
                ov.on_overlay_dismiss();
            }
            if (ov_hit) {
                val ores = ov.on_event(ev.event_type, ev.x, ev.y, ev.key_code);
                if (ores == uievent.EventResult.Handled) {
                    result = ores;
                    handled_by = ov;
                    dirty = 1;
                    overlay_done = 1;
                }
            }
            oi = oi - 1;
        }
        if (handled_by == nil) {
            result = root.on_event(ev.event_type, ev.x, ev.y, ev.key_code);
            if (result == uievent.EventResult.Handled) {
                handled_by = root;
            }
        }
        // The release always ends capture, handled or not.
        if (captured_move != 0 and ev.event_type == events.EventType.MouseUp) {
            captured_id = 0;
        }
        // A handled press arms capture for whatever is dragging/pressed.
        if (ev.event_type == events.EventType.MouseDown and result == uievent.EventResult.Handled
            and handled_by != nil) {
            captured_id = find_capture(handled_by as comp.Component);
        }
    }

    // Focus clearing: a MouseDown outside the focused widget's bounds
    // releases focus (clicking another focusable widget re-sets it inside
    // its own on_event before this check runs).
    if (ev.event_type == events.EventType.MouseDown and focused_component != nil) {
        var fw = focused_component as comp.Component;
        if (not fw.bounds().contains(ev.x as float, ev.y as float)) {
            clear_focus();
        }
    }
    // A Handled event means some widget state changed — the next update()
    // must repaint even under elision.
    if (result == uievent.EventResult.Handled) {
        dirty = 1;
    }
    return result;
}

// Depth-first search for a widget by its stable construction-time id
// (component.next_widget_id). Returns the Component as `any`, or nil when
// absent — `T?`/`Component?` returns ok-wrap the trait object and break
// later dispatch, so `any` is the honest optional-trait channel here.
// Walks through child_count/child_at across Flow/Container/ScrollView.
pub fn find_widget(root: comp.Component, id: int): any {
    if (root.widget_id() == id) {
        return root;
    }
    var n: int = root.child_count();
    var i: int = 0;
    while (i < n) {
        val c = root.child_at(i);
        if (c != nil) {
            val found = find_widget(c as comp.Component, id);
            if (found != nil) {
                return found;
            }
        }
        i = i + 1;
    }
    return nil;
}

// Walk the tree calling on_theme_changed() on every component, then
// request a repaint. Pair with uitheme.set_*/set_theme — widgets that
// snapshot palette() at init re-apply theme-derived fields here.
pub fn apply_theme(root: comp.Component): nil {
    root.on_theme_changed();
    var n: int = root.child_count();
    var i: int = 0;
    while (i < n) {
        val c = root.child_at(i);
        if (c != nil) {
            apply_theme(c as comp.Component);
        }
        i = i + 1;
    }
    request_repaint();
}
