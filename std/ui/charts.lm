// std/ui/charts.lm
// Charts & Data Visualization Module for std.ui backed by embedded Chart frame.

import std.ui.types as ui;
import std.ui.components as comp;
import std.color as color;

pub fn plot_lines(label: str, values: [float], min_val: float = 0.0, max_val: float = 1.0): comp.Chart {
    val w = comp.Chart(ui.WidgetKind.PlotLines, label, values, [] as [str], min_val, max_val);
    w.width_val = 180.0;
    w.height_val = 60.0;
    w.fg = color.rgb(100, 180, 255);
    return w;
}

pub fn plot_histogram(label: str, values: [float], min_val: float = 0.0, max_val: float = 1.0): comp.Chart {
    val w = comp.Chart(ui.WidgetKind.PlotHistogram, label, values, [] as [str], min_val, max_val);
    w.width_val = 180.0;
    w.height_val = 60.0;
    w.fg = color.rgb(80, 220, 130);
    return w;
}

pub fn bar_chart(label: str, values: [float], labels: [str] = [] as [str]): comp.Chart {
    val w = comp.Chart(ui.WidgetKind.BarChart, label, values, labels);
    w.width_val = 200.0;
    w.height_val = 100.0;
    w.fg = color.rgb(80, 180, 255);
    return w;
}

pub fn line_chart(label: str, values: [float]): comp.Chart {
    val w = comp.Chart(ui.WidgetKind.LineChart, label, values);
    w.width_val = 200.0;
    w.height_val = 100.0;
    w.fg = color.rgb(100, 220, 160);
    return w;
}

pub fn pie_chart(label: str, values: [float], labels: [str] = [] as [str]): comp.Chart {
    val w = comp.Chart(ui.WidgetKind.PieChart, label, values, labels);
    w.width_val = 120.0;
    w.height_val = 120.0;
    return w;
}

pub fn doughnut_chart(label: str, values: [float], labels: [str] = [] as [str]): comp.Chart {
    val w = comp.Chart(ui.WidgetKind.DoughnutChart, label, values, labels);
    w.width_val = 120.0;
    w.height_val = 120.0;
    return w;
}

pub fn bubble_chart(label: str, values: [float]): comp.Chart {
    val w = comp.Chart(ui.WidgetKind.BubbleChart, label, values);
    w.width_val = 180.0;
    w.height_val = 100.0;
    w.fg = color.rgb(255, 180, 90);
    return w;
}

pub fn scatter_chart(label: str, values: [float]): comp.Chart {
    val w = comp.Chart(ui.WidgetKind.ScatterChart, label, values);
    w.width_val = 180.0;
    w.height_val = 100.0;
    w.fg = color.rgb(220, 120, 255);
    return w;
}

pub fn polar_area_chart(label: str, values: [float], labels: [str] = [] as [str]): comp.Chart {
    val w = comp.Chart(ui.WidgetKind.PolarAreaChart, label, values, labels);
    w.width_val = 120.0;
    w.height_val = 120.0;
    return w;
}

pub fn radar_chart(label: str, values: [float], labels: [str] = [] as [str]): comp.Chart {
    val w = comp.Chart(ui.WidgetKind.RadarChart, label, values, labels);
    w.width_val = 120.0;
    w.height_val = 120.0;
    w.fg = color.rgb(100, 200, 255);
    return w;
}
