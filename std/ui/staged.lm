// std/ui/staged.lm
// Compile-Time Staged Evaluation for Lymar UI
//
// Folds static layouts, bounding boxes, and theme tokens into read-only
// constants at stage 0 using `staged fn`, and provides type-safe
// compile-time generic bindings via `staged frame Binding(T: type)`.

// ── Intra-Module Stage-0 Folding Primitives ──────────────────────────────────
// Note: In Lymar, `staged fn` executes strictly at stage 0 (no runtime LIR body),
// so module constants pre-fold here while exported runtime helpers remain callable
// across module boundaries.

staged fn _staged_item_width(char_count: int, font_scale: int, pad_x: int): int {
    return (char_count * 8 * font_scale) + pad_x * 2;
}

staged fn _staged_box_width(content_w: int, pad_x: int, border: int): int {
    return content_w + pad_x * 2 + border * 2;
}

staged fn _staged_box_height(content_h: int, pad_y: int, border: int): int {
    return content_h + pad_y * 2 + border * 2;
}

enum ThemeRole {
    WindowBg,
    Text,
    Accent,
    Muted,
    Danger,
    Success
}

staged fn _staged_theme_argb(role: ThemeRole): int {
    if (role == ThemeRole.WindowBg) { return 0xff1e2127; }
    if (role == ThemeRole.Text) { return 0xfff1f5f9; }
    if (role == ThemeRole.Accent) { return 0xff6366f1; }
    if (role == ThemeRole.Muted) { return 0xff94a3b8; }
    if (role == ThemeRole.Danger) { return 0xef4444ff; }
    return 0x22c55eff;
}

// Pre-folded read-only theme constants computed at compile time via staged fn
pub const THEME_WINDOW_BG_ARGB: int = _staged_theme_argb(ThemeRole.WindowBg);
pub const THEME_TEXT_ARGB: int      = _staged_theme_argb(ThemeRole.Text);
pub const THEME_ACCENT_ARGB: int    = _staged_theme_argb(ThemeRole.Accent);
pub const THEME_MUTED_ARGB: int     = _staged_theme_argb(ThemeRole.Muted);
pub const THEME_DANGER_ARGB: int    = _staged_theme_argb(ThemeRole.Danger);
pub const THEME_SUCCESS_ARGB: int   = _staged_theme_argb(ThemeRole.Success);

// ── Exported Layout & Theme Helpers ──────────────────────────────────────────

pub fn compute_item_width(char_count: int, font_scale: int, pad_x: int): int {
    val base_w = char_count * 8 * font_scale;
    return base_w + pad_x * 2;
}

pub fn compute_grid_column_width(container_w: int, num_cols: int, gap: int): int {
    if (num_cols <= 1) { return container_w; }
    val total_gaps = (num_cols - 1) * gap;
    return (container_w - total_gaps) / num_cols;
}

pub fn compute_constrained_size(desired: int, min_bound: int, max_bound: int): int {
    if (desired < min_bound) { return min_bound; }
    if (max_bound > 0 and desired > max_bound) { return max_bound; }
    return desired;
}

pub fn fold_box_width(content_w: int, pad_x: int, border: int): int {
    return content_w + pad_x * 2 + border * 2;
}

pub fn fold_box_height(content_h: int, pad_y: int, border: int): int {
    return content_h + pad_y * 2 + border * 2;
}

pub fn fold_stack_extent(count: int, child_size: int, gap: int): int {
    if (count <= 0) { return 0; }
    return count * child_size + (count - 1) * gap;
}

pub fn fold_child_offset(index: int, origin: int, child_size: int, gap: int): int {
    return origin + index * (child_size + gap);
}

pub fn theme_argb(role: ThemeRole): int {
    match (role) {
        ThemeRole.WindowBg => { return THEME_WINDOW_BG_ARGB; },
        ThemeRole.Text => { return THEME_TEXT_ARGB; },
        ThemeRole.Accent => { return THEME_ACCENT_ARGB; },
        ThemeRole.Muted => { return THEME_MUTED_ARGB; },
        ThemeRole.Danger => { return THEME_DANGER_ARGB; },
        ThemeRole.Success => { return THEME_SUCCESS_ARGB; }
    }
    return THEME_SUCCESS_ARGB;
}

// ── Type-Safe Compile-Time State Binding ──────────────────────────────────────

staged frame Binding(T: type) {
    pub var value: T;

    pub init(initial: T) {
        self.value = initial;
    }

    pub fn get(): T {
        return self.value;
    }

    pub fn set(new_val: T): nil {
        self.value = new_val;
    }
}
