// std/ui/containers/mask.lm
// Container — clips its child via draw-list ClipPush/ClipPop
// (gg.push_clip → scissor + shader coverage). shape names:
//   "rect"      — plain rectangle (scissor only)
//   "rounded"   — rounded rect, radius = min(w,h)*0.25 (default)
//   "squircle"  — approximated as rounded rect, radius = min(w,h)*0.35
//   "pill"      — stadium shape, radius = min(w,h)*0.5
//   "circle"    — ellipse inscribed in the rect
// Shaped clips apply to rect/triangle draws (surfaces, borders, lines,
// charts); text keeps rectangular clipping — glyph quads near a shaped
// edge can overdraw slightly outside the silhouette.

import std.ui.component as comp;
import std.ui.component show Placed;
import std.ui.types as ui_types;
import std.ui.event as uievent;
import std.ui.context as uictx;
import std.ui.draw_list as dl;
import std.ui.state as state;
import std.ui.tree as tree;
import std.events as events;
import std.color as color;

frame Mask {
    embed Placed;
    pub var child: comp.Component?;
    pub var shape: str;

    pub init(c: any = nil, shape_name: str = "rounded") {
        self.child = nil;
        if (c != nil) {
            self.child = c as comp.Component;
        }
        self.shape = shape_name;
        self.id = comp.next_widget_id();
    }

    pub fn set_child(c: comp.Component): nil {
        self.child = c;
    }

    pub fn kind(): ui_types.WidgetKind { return ui_types.WidgetKind.Mask; }
    pub fn on_theme_changed(): nil { }
    pub fn on_overlay_dismiss(): nil { }

    pub fn child_count(): int {
        if (self.child == nil) { return 0; }
        return 1;
    }

    pub fn child_at(i: int): any {
        if (i == 0 and self.child != nil) {
            return self.child;
        }
        return nil;
    }

    pub fn wants_pointer_capture(): int { return 0; }

    pub fn measure(min_w: float, max_w: float, min_h: float, max_h: float): comp.Size {
        if (self.child == nil) {
            return comp.Size(w=0.0, h=0.0);
        }
        return (self.child as comp.Component).measure(min_w, max_w, min_h, max_h);
    }

    pub fn arrange(x: float, y: float, w: float, h: float): nil {
        self.rect.x = x;
        self.rect.y = y;
        self.rect.w = w;
        self.rect.h = h;
        if (self.child != nil) {
            (self.child as comp.Component).arrange(x, y, w, h);
        }
    }

    fn clip_args(): any {
        // Returns (shape:int, radius:float) for the configured shape.
        var m: float = self.rect.w;
        if (self.rect.h < m) { m = self.rect.h; }
        if (self.shape == "rect") {
            return (0, 0.0);
        } elif (self.shape == "circle") {
            return (2, 0.0);
        } elif (self.shape == "pill") {
            return (1, m * 0.5);
        } elif (self.shape == "squircle") {
            return (1, m * 0.35);
        }
        // "rounded" and unknown shapes.
        return (1, m * 0.25);
    }

    pub fn paint(): nil {
        if (self.child == nil) { return; }
        val ca = self.clip_args();
        dl.dl_add(dl.paint_ctx.dl, dl.dcmd_clip_push(self.rect.x, self.rect.y, self.rect.w, self.rect.h,
            ca.0, ca.1));
        (self.child as comp.Component).paint();
        dl.dl_add(dl.paint_ctx.dl, dl.dcmd_clip_pop());
    }

    pub fn on_event(t: events.EventType, x: int, y: int, key: int): uievent.EventResult {
        if (self.child != nil) {
            var inside: bool = true;
            if (t != events.EventType.MouseMove and t != events.EventType.MouseUp and t != events.EventType.MouseWheel) {
                inside = (self.child as comp.Component).bounds().contains(x as float, y as float);
            }
            if (inside) {
                val res = (self.child as comp.Component).on_event(t, x, y, key);
                if (res == uievent.EventResult.Handled) {
                    return uievent.EventResult.Handled;
                }
            }
        }
        return uievent.EventResult.Ignored;
    }
}

pub fn mask(c: any = nil, shape_name: str = "rounded"): Mask {
    return Mask(c, shape_name);
}
