// std/ui/draw_list.lm
// Flat, ordered GPU draw command list with zero-allocation buffer reuse.
// Emitted by widgets during tree.update's paint pass; replayed by
// replay.lm without recursion. Hit-testing lives in std.ui.tree — this
// module carries draw commands only.

// ── Draw command kinds ────────────────────────────────────────────────────────
// Real enum: dispatch on `cmd.kind` is type-checked and lowered to the tag
// compare the LIR generator defines once for `==`/`match`. Directly dispatched via DrawCmdKind.
enum DrawCmdKind {
    None,
    Rect,
    RectRounded,
    Text,
    Line,
    Circle,
    ClipPush,
    ClipPop,
    Triangle,
    Image,
    Shadow,
    Wedge
}

// ── DrawCmd ───────────────────────────────────────────────────────────────────
// A single GPU-ready draw instruction. Approx 80 bytes vs Widget's ~400 bytes.
frame DrawCmd {
    pub var kind: DrawCmdKind;
    pub var x: float;
    pub var y: float;
    pub var w: float;
    pub var h: float;
    pub var r: float;
    pub var g: float;
    pub var b: float;
    pub var a: float;
    pub var radius: float;
    pub var border_width: float;
    pub var text: str;
    pub var font_scale: float;
    pub var x2: float;  // for lines / triangles / shadow offsets
    pub var y2: float;
    pub var x3: float;
    pub var y3: float;
    pub var clip_shape: int;  // ClipPush: 0=rect, 1=rounded, 2=ellipse

    pub init() {
        self.kind = DrawCmdKind.None;
        self.x = 0.0; self.y = 0.0;
        self.w = 0.0; self.h = 0.0;
        self.r = 1.0; self.g = 1.0; self.b = 1.0; self.a = 1.0;
        self.radius = 0.0;
        self.border_width = 0.0;
        self.text = "";
        self.font_scale = 1.0;
        self.x2 = 0.0; self.y2 = 0.0;
        self.x3 = 0.0; self.y3 = 0.0;
        self.clip_shape = 0;
    }
}

pub fn dcmd_rect(x: float, y: float, w: float, h: float, r: float, g: float, b: float, a: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.Rect;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.r = r; c.g = g; c.b = b; c.a = a;
    return c;
}

pub fn dcmd_rect_rounded(x: float, y: float, w: float, h: float, radius: float, r: float, g: float, b: float, a: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.RectRounded;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.radius = radius;
    c.border_width = 0.0;
    c.r = r; c.g = g; c.b = b; c.a = a;
    return c;
}

pub fn dcmd_border_rounded(x: float, y: float, w: float, h: float, radius: float, border_width: float, r: float, g: float, b: float, a: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.RectRounded;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.radius = radius;
    c.border_width = border_width;
    c.r = r; c.g = g; c.b = b; c.a = a;
    return c;
}

pub fn dcmd_text(text: str, x: float, y: float, r: float, g: float, b: float, a: float, font_scale: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.Text;
    c.text = text;
    c.x = x; c.y = y;
    c.r = r; c.g = g; c.b = b; c.a = a;
    c.font_scale = font_scale;
    return c;
}

pub fn dcmd_line(x1: float, y1: float, x2: float, y2: float, r: float, g: float, b: float, a: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.Line;
    c.x = x1; c.y = y1; c.x2 = x2; c.y2 = y2;
    c.r = r; c.g = g; c.b = b; c.a = a;
    return c;
}

pub fn dcmd_triangle(x1: float, y1: float, x2: float, y2: float, x3: float, y3: float, r: float, g: float, b: float, a: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.Triangle;
    c.x = x1; c.y = y1;
    c.x2 = x2; c.y2 = y2;
    c.x3 = x3; c.y3 = y3;
    c.r = r; c.g = g; c.b = b; c.a = a;
    return c;
}

pub fn dcmd_clip_push(x: float, y: float, w: float, h: float, shape: int = 0, radius: float = 0.0): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.ClipPush;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.clip_shape = shape;
    c.radius = radius;
    return c;
}

// Soft drop shadow: x2=off_x, y2=off_y, x3=blur, y3=spread (reuses the
// line/triangle coordinate fields — Shadow never draws geometry).
pub fn dcmd_shadow(x: float, y: float, w: float, h: float, r: float, g: float, b: float, a: float,
                   off_x: float, off_y: float, blur: float, spread: float, radius: float = 6.0): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.Shadow;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.r = r; c.g = g; c.b = b; c.a = a;
    c.x2 = off_x; c.y2 = off_y; c.x3 = blur; c.y3 = spread;
    c.radius = radius;
    return c;
}

// Pie slice wedge: x=cx, y=cy, w=radius, x2=a0 (rad), y2=a1 (rad).
pub fn dcmd_wedge(cx: float, cy: float, radius: float, a0: float, a1: float,
                  r: float, g: float, b: float, a: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.Wedge;
    c.x = cx; c.y = cy; c.w = radius;
    c.x2 = a0; c.y2 = a1;
    c.r = r; c.g = g; c.b = b; c.a = a;
    return c;
}

pub fn dcmd_clip_pop(): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.ClipPop;
    return c;
}

// ── DrawList ──────────────────────────────────────────────────────────────────
// Keeps backing lists and pre-allocated DrawCmd slots across rebuilds
// so `clear()` resets cursor counts in O(1) with zero per-frame allocations.
frame DrawList {
    pub var cmds: [DrawCmd];
    pub var overlay_cmds: [DrawCmd];
    pub var cmd_count: int;
    pub var overlay_cmd_count: int;
    pub var is_valid: int;

    pub init() {
        self.cmds = [] as [DrawCmd];
        self.overlay_cmds = [] as [DrawCmd];
        self.cmd_count = 0;
        self.overlay_cmd_count = 0;
        self.is_valid = 0;
    }

    pub fn clear(): nil {
        self.cmd_count = 0;
        self.overlay_cmd_count = 0;
        self.is_valid = 0;
    }
}

pub fn draw_list(): DrawList {
    return DrawList();
}

pub fn dl_alloc_cmd(dl: DrawList): DrawCmd {
    val idx = dl.cmd_count;
    dl.cmd_count = idx + 1;
    if (idx < len(dl.cmds)) {
        val c = dl.cmds[idx];
        c.kind = DrawCmdKind.None;
        c.radius = 0.0;
        c.border_width = 0.0;
        c.text = "";
        c.font_scale = 1.0;
        return c;
    }
    val c = DrawCmd();
    dl.cmds.append(c);
    return c;
}

pub fn dl_alloc_overlay_cmd(dl: DrawList): DrawCmd {
    val idx = dl.overlay_cmd_count;
    dl.overlay_cmd_count = idx + 1;
    if (idx < len(dl.overlay_cmds)) {
        val c = dl.overlay_cmds[idx];
        c.kind = DrawCmdKind.None;
        c.radius = 0.0;
        c.border_width = 0.0;
        c.text = "";
        c.font_scale = 1.0;
        return c;
    }
    val c = DrawCmd();
    dl.overlay_cmds.append(c);
    return c;
}

pub fn dl_emit_rect(dl: DrawList, x: float, y: float, w: float, h: float, r: float, g: float, b: float, a: float = 1.0): nil {
    val c = dl_alloc_cmd(dl);
    c.kind = DrawCmdKind.Rect;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.r = r; c.g = g; c.b = b; c.a = a;
}

pub fn dl_emit_rect_rounded(dl: DrawList, x: float, y: float, w: float, h: float, rad: float, r: float, g: float, b: float, a: float = 1.0): nil {
    val c = dl_alloc_cmd(dl);
    c.kind = DrawCmdKind.RectRounded;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.radius = rad;
    c.r = r; c.g = g; c.b = b; c.a = a;
}

pub fn dl_emit_rect_border(dl: DrawList, x: float, y: float, w: float, h: float, rad: float, bw: float, r: float, g: float, b: float, a: float = 1.0): nil {
    val c = dl_alloc_cmd(dl);
    c.kind = DrawCmdKind.RectRounded;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.radius = rad; c.border_width = bw;
    c.r = r; c.g = g; c.b = b; c.a = a;
}

pub fn dl_emit_shadow(dl: DrawList, x: float, y: float, w: float, h: float,
                      r: float, g: float, b: float, a: float,
                      off_x: float, off_y: float, blur: float, spread: float, radius: float = 6.0): nil {
    val c = dl_alloc_cmd(dl);
    c.kind = DrawCmdKind.Shadow;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.r = r; c.g = g; c.b = b; c.a = a;
    c.x2 = off_x; c.y2 = off_y; c.x3 = blur; c.y3 = spread;
    c.radius = radius;
}

pub fn dl_emit_text(dl: DrawList, txt: str, x: float, y: float, r: float, g: float, b: float, a: float = 1.0, scale: float = 1.0): nil {
    val c = dl_alloc_cmd(dl);
    c.kind = DrawCmdKind.Text;
    c.text = txt;
    c.x = x; c.y = y;
    c.r = r; c.g = g; c.b = b; c.a = a;
    c.font_scale = scale;
}

pub fn dl_add(dl: DrawList, cmd: DrawCmd): nil {
    val idx = dl.cmd_count;
    dl.cmd_count = idx + 1;
    if (idx < len(dl.cmds)) {
        dl.cmds[idx] = cmd;
    } else {
        dl.cmds.append(cmd);
    }
}

pub fn dl_add_overlay_cmd(dl: DrawList, cmd: DrawCmd): nil {
    val idx = dl.overlay_cmd_count;
    dl.overlay_cmd_count = idx + 1;
    if (idx < len(dl.overlay_cmds)) {
        dl.overlay_cmds[idx] = cmd;
    } else {
        dl.overlay_cmds.append(cmd);
    }
}

pub fn dl_flush_overlays(dl: DrawList): nil {
    if (dl.overlay_cmd_count > 0) {
        iter (c_i in 0..dl.overlay_cmd_count) {
            dl_add(dl, dl.overlay_cmds[c_i]);
        }
        dl.overlay_cmd_count = 0;
    }
}

pub fn dl_clear(dl: DrawList): nil {
    dl.clear();
}

// M5 batching audit: clip push/pop must balance over the emitted command
// stream or the GPU clip stack leaks state into the next frame. Returns
// the net balance — 0 means every ClipPush was matched by a ClipPop.
pub fn dl_clip_balance(d: DrawList): int {
    var bal: int = 0;
    var i: int = 0;
    while (i < d.cmd_count) {
        if (d.cmds[i].kind == DrawCmdKind.ClipPush) {
            bal = bal + 1;
        } elif (d.cmds[i].kind == DrawCmdKind.ClipPop) {
            bal = bal - 1;
        }
        i = i + 1;
    }
    return bal;
}

// ── Paint context ────────────────────────────────────────────────────────────
// Owns the frame's DrawList so widgets can emit without receiving it as a
// trait-dispatch argument (the ownership checker rejects managed args
// through dynamic dispatch). tree.update() clears it, widgets emit into it,
// tree.submit() replays it.

frame PaintContext {
    pub var dl: DrawList;

    pub init() {
        self.dl = DrawList();
    }
}

pub var paint_ctx: PaintContext = PaintContext();

pub fn dl_push_clip(d: DrawList, x: float, y: float, w: float, h: float): nil {
    dl_add(d, dcmd_clip_push(x, y, w, h));
}

pub fn dl_pop_clip(d: DrawList): nil {
    dl_add(d, dcmd_clip_pop());
}
