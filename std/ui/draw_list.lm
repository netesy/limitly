// std/ui/draw_list.lm
// Flat, ordered GPU draw command list with zero-allocation buffer reuse.
// Emitted by builder.lm in a single pass; replayed by replay.lm without recursion.

import std.ui.components as comp;

// ── Draw command kinds ────────────────────────────────────────────────────────
// Real enum: dispatch on `cmd.kind` is type-checked and lowered to the tag
// compare the LIR generator defines once for `==`/`match`. Directly dispatched via DrawCmdKind.
enum DrawCmdKind {
    None,
    Rect,
    RectRounded,
    Text,
    Line,
    Circle,
    ClipPush,
    ClipPop,
    Triangle,
    Image
}

// Hit zone kinds (mirrors Widget kinds for dispatch)
enum HitZoneKind {
    None,
    Button,
    Slider,
    Checkbox,
    Input,
    Toggle,
    Select,
    Tab,
    TreeNode,
    Custom
}

// ── DrawCmd ───────────────────────────────────────────────────────────────────
// A single GPU-ready draw instruction. Approx 80 bytes vs Widget's ~400 bytes.
frame DrawCmd {
    pub var kind: DrawCmdKind;
    pub var x: float;
    pub var y: float;
    pub var w: float;
    pub var h: float;
    pub var r: float;
    pub var g: float;
    pub var b: float;
    pub var a: float;
    pub var radius: float;
    pub var border_width: float;
    pub var text: str;
    pub var font_scale: float;
    pub var x2: float;  // for lines / triangles
    pub var y2: float;
    pub var x3: float;
    pub var y3: float;

    pub init() {
        self.kind = DrawCmdKind.None;
        self.x = 0.0; self.y = 0.0;
        self.w = 0.0; self.h = 0.0;
        self.r = 1.0; self.g = 1.0; self.b = 1.0; self.a = 1.0;
        self.radius = 0.0;
        self.border_width = 0.0;
        self.text = "";
        self.font_scale = 1.0;
        self.x2 = 0.0; self.y2 = 0.0;
        self.x3 = 0.0; self.y3 = 0.0;
    }
}

pub fn dcmd_rect(x: float, y: float, w: float, h: float, r: float, g: float, b: float, a: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.Rect;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.r = r; c.g = g; c.b = b; c.a = a;
    return c;
}

pub fn dcmd_rect_rounded(x: float, y: float, w: float, h: float, radius: float, r: float, g: float, b: float, a: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.RectRounded;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.radius = radius;
    c.border_width = 0.0;
    c.r = r; c.g = g; c.b = b; c.a = a;
    return c;
}

pub fn dcmd_border_rounded(x: float, y: float, w: float, h: float, radius: float, border_width: float, r: float, g: float, b: float, a: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.RectRounded;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.radius = radius;
    c.border_width = border_width;
    c.r = r; c.g = g; c.b = b; c.a = a;
    return c;
}

pub fn dcmd_text(text: str, x: float, y: float, r: float, g: float, b: float, a: float, font_scale: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.Text;
    c.text = text;
    c.x = x; c.y = y;
    c.r = r; c.g = g; c.b = b; c.a = a;
    c.font_scale = font_scale;
    return c;
}

pub fn dcmd_line(x1: float, y1: float, x2: float, y2: float, r: float, g: float, b: float, a: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.Line;
    c.x = x1; c.y = y1; c.x2 = x2; c.y2 = y2;
    c.r = r; c.g = g; c.b = b; c.a = a;
    return c;
}

pub fn dcmd_triangle(x1: float, y1: float, x2: float, y2: float, x3: float, y3: float, r: float, g: float, b: float, a: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.Triangle;
    c.x = x1; c.y = y1;
    c.x2 = x2; c.y2 = y2;
    c.x3 = x3; c.y3 = y3;
    c.r = r; c.g = g; c.b = b; c.a = a;
    return c;
}

pub fn dcmd_clip_push(x: float, y: float, w: float, h: float): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.ClipPush;
    c.x = x; c.y = y; c.w = w; c.h = h;
    return c;
}

pub fn dcmd_clip_pop(): DrawCmd {
    var c = DrawCmd();
    c.kind = DrawCmdKind.ClipPop;
    return c;
}

// ── HitZone ───────────────────────────────────────────────────────────────────
// Parallel list to DrawCmd list — built simultaneously during build pass.
// Hit tested as a simple linear scan — no recursion needed.
frame HitZone {
    pub var id: str;
    pub var kind: HitZoneKind;
    pub var x: float;
    pub var y: float;
    pub var w: float;
    pub var h: float;
    pub var clip_x: float;
    pub var clip_y: float;
    pub var clip_w: float;
    pub var clip_h: float;
    pub var on_click: (fn(): nil) | nil;
    pub var on_change: (fn(): nil) | nil;
    // Slider-specific data
    pub var slider_min: float;
    pub var slider_max: float;
    pub var slider_val: float;
    // Tab-specific
    pub var tab_index: int;
    // Checkbox/toggle
    pub var is_checked: int;
    // Widget reference for retained-state mutation
    pub var widget: comp.Fluent | nil;

    pub init() {
        self.id = "";
        self.kind = HitZoneKind.None;
        self.x = 0.0; self.y = 0.0;
        self.w = 0.0; self.h = 0.0;
        self.clip_x = 0.0; self.clip_y = 0.0;
        self.clip_w = 0.0; self.clip_h = 0.0;
        self.on_click = nil;
        self.on_change = nil;
        self.slider_min = 0.0;
        self.slider_max = 1.0;
        self.slider_val = 0.0;
        self.tab_index = 0;
        self.is_checked = 0;
        self.widget = nil;
    }
}

pub fn make_button_zone(
    id: str, x: float, y: float, w: float, h: float,
    on_click: (fn(): nil) | nil = nil, widget: comp.Fluent | nil = nil
): HitZone {
    val hz = HitZone();
    hz.id = id; hz.kind = HitZoneKind.Button;
    hz.x = x; hz.y = y; hz.w = w; hz.h = h;
    hz.on_click = on_click;
    hz.widget = widget;
    return hz;
}

pub fn make_button_zone_for(
    id: str, x: float, y: float, w: float, h: float,
    on_click: (fn(): nil) | nil, widget: comp.Fluent
): HitZone {
    val hz = make_button_zone(id, x, y, w, h, on_click, nil);
    hz.widget = widget;
    return hz;
}

pub fn make_slider_zone(
    id: str, x: float, y: float, w: float, h: float,
    min_v: float, max_v: float, cur_v: float,
    on_change: (fn(): nil) | nil = nil, widget: comp.Fluent | nil = nil
): HitZone {
    val hz = HitZone();
    hz.id = id; hz.kind = HitZoneKind.Slider;
    hz.x = x; hz.y = y; hz.w = w; hz.h = h;
    hz.slider_min = min_v; hz.slider_max = max_v; hz.slider_val = cur_v;
    hz.on_change = on_change;
    hz.widget = widget;
    return hz;
}

pub fn make_slider_zone_for(
    id: str, x: float, y: float, w: float, h: float,
    min_v: float, max_v: float, cur_v: float,
    on_change: (fn(): nil) | nil, widget: comp.Fluent
): HitZone {
    val hz = make_slider_zone(id, x, y, w, h, min_v, max_v, cur_v, on_change, nil);
    hz.widget = widget;
    return hz;
}

pub fn make_checkbox_zone(
    id: str, x: float, y: float, w: float, h: float, checked: int,
    on_change: (fn(): nil) | nil = nil, widget: comp.Fluent | nil = nil
): HitZone {
    val hz = HitZone();
    hz.id = id; hz.kind = HitZoneKind.Checkbox;
    hz.x = x; hz.y = y; hz.w = w; hz.h = h;
    hz.is_checked = checked;
    hz.on_change = on_change;
    hz.widget = widget;
    return hz;
}

pub fn make_checkbox_zone_for(
    id: str, x: float, y: float, w: float, h: float, checked: int,
    on_change: (fn(): nil) | nil, widget: comp.Fluent
): HitZone {
    val hz = make_checkbox_zone(id, x, y, w, h, checked, on_change, nil);
    hz.widget = widget;
    return hz;
}

pub fn make_input_zone(
    id: str, x: float, y: float, w: float, h: float,
    widget: comp.Fluent | nil = nil
): HitZone {
    val hz = HitZone();
    hz.id = id; hz.kind = HitZoneKind.Input;
    hz.x = x; hz.y = y; hz.w = w; hz.h = h;
    hz.widget = widget;
    return hz;
}

pub fn make_input_zone_for(
    id: str, x: float, y: float, w: float, h: float,
    widget: comp.Fluent
): HitZone {
    val hz = make_input_zone(id, x, y, w, h, nil);
    hz.widget = widget;
    return hz;
}

// ── DrawList ──────────────────────────────────────────────────────────────────
// Keeps backing lists and pre-allocated DrawCmd/HitZone slots across rebuilds
// so `clear()` resets cursor counts in O(1) with zero per-frame allocations.
frame DrawList {
    pub var cmds: [DrawCmd];
    pub var hits: [HitZone];
    pub var overlay_cmds: [DrawCmd];
    pub var overlay_hits: [HitZone];
    pub var cmd_count: int;
    pub var hit_count: int;
    pub var overlay_cmd_count: int;
    pub var overlay_hit_count: int;
    pub var is_valid: int;

    pub init() {
        self.cmds = [] as [DrawCmd];
        self.hits = [] as [HitZone];
        self.overlay_cmds = [] as [DrawCmd];
        self.overlay_hits = [] as [HitZone];
        self.cmd_count = 0;
        self.hit_count = 0;
        self.overlay_cmd_count = 0;
        self.overlay_hit_count = 0;
        self.is_valid = 0;
    }

    pub fn clear(): nil {
        self.cmd_count = 0;
        self.hit_count = 0;
        self.overlay_cmd_count = 0;
        self.overlay_hit_count = 0;
        self.is_valid = 0;
    }
}

pub fn draw_list(): DrawList {
    return DrawList();
}

pub fn dl_alloc_cmd(dl: DrawList): DrawCmd {
    val idx = dl.cmd_count;
    dl.cmd_count = idx + 1;
    if (idx < len(dl.cmds)) {
        val c = dl.cmds[idx];
        c.kind = DrawCmdKind.None;
        c.radius = 0.0;
        c.border_width = 0.0;
        c.text = "";
        c.font_scale = 1.0;
        return c;
    }
    val c = DrawCmd();
    dl.cmds.append(c);
    return c;
}

pub fn dl_alloc_overlay_cmd(dl: DrawList): DrawCmd {
    val idx = dl.overlay_cmd_count;
    dl.overlay_cmd_count = idx + 1;
    if (idx < len(dl.overlay_cmds)) {
        val c = dl.overlay_cmds[idx];
        c.kind = DrawCmdKind.None;
        c.radius = 0.0;
        c.border_width = 0.0;
        c.text = "";
        c.font_scale = 1.0;
        return c;
    }
    val c = DrawCmd();
    dl.overlay_cmds.append(c);
    return c;
}

pub fn dl_emit_rect(dl: DrawList, x: float, y: float, w: float, h: float, r: float, g: float, b: float, a: float = 1.0): nil {
    val c = dl_alloc_cmd(dl);
    c.kind = DrawCmdKind.Rect;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.r = r; c.g = g; c.b = b; c.a = a;
}

pub fn dl_emit_rect_rounded(dl: DrawList, x: float, y: float, w: float, h: float, rad: float, r: float, g: float, b: float, a: float = 1.0): nil {
    val c = dl_alloc_cmd(dl);
    c.kind = DrawCmdKind.RectRounded;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.radius = rad;
    c.r = r; c.g = g; c.b = b; c.a = a;
}

pub fn dl_emit_rect_border(dl: DrawList, x: float, y: float, w: float, h: float, rad: float, bw: float, r: float, g: float, b: float, a: float = 1.0): nil {
    val c = dl_alloc_cmd(dl);
    c.kind = DrawCmdKind.RectRounded;
    c.x = x; c.y = y; c.w = w; c.h = h;
    c.radius = rad; c.border_width = bw;
    c.r = r; c.g = g; c.b = b; c.a = a;
}

pub fn dl_emit_text(dl: DrawList, txt: str, x: float, y: float, r: float, g: float, b: float, a: float = 1.0, scale: float = 1.0): nil {
    val c = dl_alloc_cmd(dl);
    c.kind = DrawCmdKind.Text;
    c.text = txt;
    c.x = x; c.y = y;
    c.r = r; c.g = g; c.b = b; c.a = a;
    c.font_scale = scale;
}

pub fn dl_add(dl: DrawList, cmd: DrawCmd): nil {
    val idx = dl.cmd_count;
    dl.cmd_count = idx + 1;
    if (idx < len(dl.cmds)) {
        dl.cmds[idx] = cmd;
    } else {
        dl.cmds.append(cmd);
    }
}

pub fn dl_add_hit(dl: DrawList, hz: HitZone): nil {
    val idx = dl.hit_count;
    dl.hit_count = idx + 1;
    if (idx < len(dl.hits)) {
        dl.hits[idx] = hz;
    } else {
        dl.hits.append(hz);
    }
}

pub fn dl_add_overlay_cmd(dl: DrawList, cmd: DrawCmd): nil {
    val idx = dl.overlay_cmd_count;
    dl.overlay_cmd_count = idx + 1;
    if (idx < len(dl.overlay_cmds)) {
        dl.overlay_cmds[idx] = cmd;
    } else {
        dl.overlay_cmds.append(cmd);
    }
}

pub fn dl_add_overlay_hit(dl: DrawList, hz: HitZone): nil {
    val idx = dl.overlay_hit_count;
    dl.overlay_hit_count = idx + 1;
    if (idx < len(dl.overlay_hits)) {
        dl.overlay_hits[idx] = hz;
    } else {
        dl.overlay_hits.append(hz);
    }
}

pub fn dl_flush_overlays(dl: DrawList): nil {
    if (dl.overlay_cmd_count > 0) {
        iter (c_i in 0..dl.overlay_cmd_count) {
            dl_add(dl, dl.overlay_cmds[c_i]);
        }
        dl.overlay_cmd_count = 0;
    }

    if (dl.overlay_hit_count > 0) {
        iter (h_i in 0..dl.overlay_hit_count) {
            dl_add_hit(dl, dl.overlay_hits[h_i]);
        }
        dl.overlay_hit_count = 0;
    }
}

// Hit test: returns the topmost HitZone under (px, py), or empty HitZone.
// O(n) linear scan — no recursion.
pub fn dl_hit_test(dl: DrawList, px: float, py: float): HitZone {
    val empty = HitZone();
    val n = dl.hit_count;
    var i = n - 1;
    while (i >= 0) {
        val hz = dl.hits[i];
        if (hz.clip_w > 0.0 and hz.clip_h > 0.0) {
            if (px < hz.clip_x or px > hz.clip_x + hz.clip_w or py < hz.clip_y or py > hz.clip_y + hz.clip_h) {
                i = i - 1;
                continue;
            }
        }
        if (px >= hz.x and px <= hz.x + hz.w and py >= hz.y and py <= hz.y + hz.h) {
            return hz;
        }
        i = i - 1;
    }
    return empty;
}

pub fn dl_clear(dl: DrawList): nil {
    dl.clear();
}
