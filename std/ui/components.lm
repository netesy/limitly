// std/ui/components.lm
// Zero-Cost Component Embedding Architecture for Lymar Retained UI.
//
// Replaces monolithic 60-field God objects with fine-grained, composable
// component frames utilizing Lymar's `embed` mechanism.
// Flattened fields have zero pointer overhead; promoted methods provide
// fluent builder ergonomics without wrapper allocations.
//
// Interaction slots are typed optional functions -- `(fn(): nil)?` -- never
// raw `any`, and every invocation routes through a fallible `EventResult?`
// pipeline so call sites carry no nil-check ladders.

import std.color as color;
import std.math as math;
pub import std.color show Color;
pub import std.ui.event show EventResult;

// ── Structural Contract ───────────────────────────────────────────────────────
// Typed children: containers hold `[Fluent]`, not `[any]`. Every concrete
// component declares conformance, so the compiler checks composition shapes.

trait Fluent {
    fn kind_name(): str;
}

// ── Reusable Component Primitives ─────────────────────────────────────────────

frame LayoutMetrics {
    pub var width_val: float;
    pub var height_val: float;
    pub var pad_l: float;
    pub var pad_t: float;
    pub var pad_r: float;
    pub var pad_b: float;
    pub var spacing_val: float;
    pub var flex_val: float;

    pub init() {
        self.width_val = 0.0;
        self.height_val = 0.0;
        self.pad_l = 0.0;
        self.pad_t = 0.0;
        self.pad_r = 0.0;
        self.pad_b = 0.0;
        self.spacing_val = 0.0;
        self.flex_val = 0.0;
    }

    pub fn set_dimensions(w: float, h: float): nil {
        self.width_val = w;
        self.height_val = h;
    }

    pub fn set_padding(p: float): nil {
        self.pad_l = p;
        self.pad_t = p;
        self.pad_r = p;
        self.pad_b = p;
    }
}

type LayoutBox = LayoutMetrics;

frame VisualStyle {
    pub var bg: Color;
    pub var fg: Color;
    pub var radius: float;
    pub var opacity_val: float;

    pub init() {
        self.bg = color.transparent;
        self.fg = color.white;
        self.radius = 0.0;
        self.opacity_val = 1.0;
    }

    pub fn set_colors(background: Color, foreground: Color): nil {
        self.bg = background;
        self.fg = foreground;
    }

    pub fn set_radius(r: float): nil {
        self.radius = r;
    }
}

frame Clickable {
    pub var is_pressed: bool;
    pub var is_hovered: bool;
    pub var on_click_action: (fn(): nil)?;
    pub var click_count: int;

    pub init() {
        self.is_pressed = false;
        self.is_hovered = false;
        self.on_click_action = nil;
        self.click_count = 0;
    }

    pub fn set_on_click(action: fn(): nil): nil {
        self.on_click_action = action as (fn(): nil)?;
    }

    // Fallible invocation: an absent handler is `Unhandled`, not a crash.
    pub fn click(): EventResult? {
        var slot = self.on_click_action;
        if (slot == nil) {
            return ok(EventResult.Unhandled);
        }
        var f: fn(): nil = slot as fn(): nil;
        f();
        self.click_count = self.click_count + 1;
        return ok(EventResult.Handled);
    }

    pub fn trigger_click(): nil {
        self.click_count = self.click_count + 1;
    }
}

frame Changeable {
    pub var on_change_action: (fn(): nil)?;
    pub var change_count: int;

    pub init() {
        self.on_change_action = nil;
        self.change_count = 0;
    }

    pub fn set_on_change(action: fn(): nil): nil {
        self.on_change_action = action as (fn(): nil)?;
    }

    pub fn notify_change(): EventResult? {
        var slot = self.on_change_action;
        if (slot == nil) {
            return ok(EventResult.Unhandled);
        }
        var f: fn(): nil = slot as fn(): nil;
        f();
        self.change_count = self.change_count + 1;
        return ok(EventResult.Handled);
    }
}

frame Focusable {
    pub var is_focused: bool;
    pub var cursor_pos: int;

    pub init() {
        self.is_focused = false;
        self.cursor_pos = 0;
    }

    pub fn focus(): nil {
        self.is_focused = true;
    }

    pub fn blur(): nil {
        self.is_focused = false;
        self.cursor_pos = 0;
    }
}

// ── Nominal Flow Direction ────────────────────────────────────────────────────

enum Flow {
    Vertical,
    Horizontal
}

// ── Specialized Embedded UI Components ────────────────────────────────────────

frame Button: Fluent {
    embed LayoutMetrics;
    embed VisualStyle;
    embed Clickable;

    pub var label: str;

    pub init(text: str, on_click: (fn(): nil)? = nil) {
        self.label = text;
        self.on_click_action = on_click;
        self.bg = color.slate(700);
        self.fg = color.white;
        self.radius = 4.0;
        self.pad_l = 16.0;
        self.pad_t = 8.0;
        self.pad_r = 16.0;
        self.pad_b = 8.0;
    }

    pub fn kind_name(): str { return "Button"; }

    pub fn background(c: Color): Button {
        self.bg = c;
        return self;
    }

    pub fn foreground(c: Color): Button {
        self.fg = c;
        return self;
    }

    pub fn padding(p: float): Button {
        self.set_padding(p);
        return self;
    }

    pub fn corner_radius(r: float): Button {
        self.set_radius(r);
        return self;
    }

    pub fn width(w: float): Button {
        self.width_val = w;
        return self;
    }

    pub fn height(h: float): Button {
        self.height_val = h;
        return self;
    }
}

frame Label: Fluent {
    embed LayoutMetrics;
    embed VisualStyle;

    pub var text: str;
    pub var font_size_val: float;
    pub var is_bold: bool;

    pub init(txt: str) {
        self.text = txt;
        self.font_size_val = 14.0;
        self.is_bold = false;
        self.fg = color.slate(100);
    }

    pub fn kind_name(): str { return "Label"; }

    pub fn color(c: Color): Label {
        self.fg = c;
        return self;
    }

    pub fn font_size(sz: float): Label {
        self.font_size_val = sz;
        return self;
    }

    pub fn bold(): Label {
        self.is_bold = true;
        return self;
    }
}

frame Slider: Fluent {
    embed LayoutMetrics;
    embed VisualStyle;
    embed Changeable;

    pub var value: float;
    pub var min_val: float;
    pub var max_val: float;

    pub init(v: float = 0.0, min_v: float = 0.0, max_v: float = 1.0) {
        self.value = v;
        self.min_val = min_v;
        self.max_val = max_v;
        self.height_val = 20.0;
        self.bg = color.slate(800);
        self.fg = color.shade("indigo", 600);
    }

    pub fn kind_name(): str { return "Slider"; }

    pub fn set_range(min_v: float, max_v: float): Slider {
        self.min_val = min_v;
        self.max_val = max_v;
        return self;
    }

    // Host-side slot write: paired with the host-side invocation in
    // `value_of`, the callback is stored and read from the same frame
    // context. Prefer this over the promoted `set_on_change`.
    pub fn on_change(action: fn(): nil): Slider {
        self.on_change_action = action as (fn(): nil)?;
        return self;
    }

    // Clamped write + change notification in one fluent step. The invoke
    // logic is inlined here: nested fallible (`?`) calls of promoted methods
    // would propagate through the host frame, so the slot is fired directly.
    pub fn set_value(v: float): Slider {
        return self.value_of(v);
    }

    pub fn value_of(v: float): Slider {
        self.value = math.clamp(v, self.min_val, self.max_val);
        var slot = self.on_change_action;
        if (slot != nil) {
            var f: fn(): nil = slot as fn(): nil;
            f();
            self.change_count = self.change_count + 1;
        }
        return self;
    }

    pub fn ratio(): float {
        if (self.max_val <= self.min_val) {
            return 0.0;
        }
        return (self.value - self.min_val) / (self.max_val - self.min_val);
    }
}

frame Checkbox: Fluent {
    embed LayoutMetrics;
    embed VisualStyle;
    embed Clickable;
    embed Changeable;

    pub var label: str;
    pub var is_checked: bool;

    pub init(text: str, on_change: (fn(): nil)? = nil) {
        self.label = text;
        self.is_checked = false;
        self.on_change_action = on_change;
        self.fg = color.slate(100);
    }

    pub fn kind_name(): str { return "Checkbox"; }

    pub fn on_change(action: fn(): nil): Checkbox {
        self.on_change_action = action as (fn(): nil)?;
        return self;
    }

    pub fn toggle(): EventResult? {
        self.is_checked = not self.is_checked;
        self.click_count = self.click_count + 1;
        var slot = self.on_change_action;
        if (slot == nil) {
            return ok(EventResult.Unhandled);
        }
        var f: fn(): nil = slot as fn(): nil;
        f();
        self.change_count = self.change_count + 1;
        return ok(EventResult.Handled);
    }
}

frame TextInput: Fluent {
    embed LayoutMetrics;
    embed VisualStyle;
    embed Focusable;
    embed Changeable;

    pub var text: str;
    pub var placeholder: str;

    pub init(txt: str = "", hint: str = "") {
        self.text = txt;
        self.placeholder = hint;
        self.bg = color.slate(900);
        self.fg = color.white;
        self.radius = 4.0;
        self.pad_l = 8.0;
        self.pad_t = 6.0;
        self.pad_r = 8.0;
        self.pad_b = 6.0;
    }

    pub fn kind_name(): str { return "TextInput"; }

    pub fn on_change(action: fn(): nil): TextInput {
        self.on_change_action = action as (fn(): nil)?;
        return self;
    }

    pub fn set_text(next: str): TextInput {
        self.text = next;
        var slot = self.on_change_action;
        if (slot != nil) {
            var f: fn(): nil = slot as fn(): nil;
            f();
            self.change_count = self.change_count + 1;
        }
        return self;
    }

    pub fn display_text(): str {
        if (self.text == "") {
            return self.placeholder;
        }
        return self.text;
    }
}

frame ProgressBar: Fluent {
    embed LayoutMetrics;
    embed VisualStyle;

    pub var value: float;
    pub var max_val: float;

    pub init(v: float = 0.0, max_v: float = 1.0) {
        self.value = v;
        self.max_val = max_v;
        self.height_val = 8.0;
        self.radius = 4.0;
        self.bg = color.slate(800);
        self.fg = color.shade("indigo", 500);
    }

    pub fn kind_name(): str { return "ProgressBar"; }

    pub fn set_progress(v: float): ProgressBar {
        self.value = math.clamp(v, 0.0, self.max_val);
        return self;
    }

    pub fn ratio(): float {
        if (self.max_val <= 0.0) {
            return 0.0;
        }
        return self.value / self.max_val;
    }
}

frame Container: Fluent {
    embed LayoutMetrics;
    embed VisualStyle;

    pub var children: [Fluent];
    pub var flow: Flow;

    pub init(vertical: bool = true) {
        self.children = [];
        if (vertical) {
            self.flow = Flow.Vertical;
        } else {
            self.flow = Flow.Horizontal;
        }
    }

    pub fn kind_name(): str { return "Container"; }

    pub fn add(c: Fluent): Container {
        self.children.append(c);
        return self;
    }

    pub fn layout(f: Flow): Container {
        self.flow = f;
        return self;
    }

    pub fn is_vertical(): bool {
        return self.flow == Flow.Vertical;
    }

    pub fn background(c: Color): Container {
        self.bg = c;
        return self;
    }

    pub fn padding(p: float): Container {
        self.set_padding(p);
        return self;
    }

    pub fn spacing(s: float): Container {
        self.spacing_val = s;
        return self;
    }
}

frame Spacer: Fluent {
    embed LayoutMetrics;

    pub init(flex: float = 1.0) {
        self.flex_val = flex;
    }

    pub fn kind_name(): str { return "Spacer"; }

    pub fn flex(f: float): Spacer {
        self.flex_val = f;
        return self;
    }
}

pub fn column(children: [any] = []): Container {
    var c = Container(true);
    iter (child in children) {
        c.add(child as Fluent);
    }
    return c;
}

pub fn row(children: [any] = []): Container {
    var c = Container(false);
    iter (child in children) {
        c.add(child as Fluent);
    }
    return c;
}

