        self.alert_kind = alert_kind_of(type_str);
        self.kind_tag = WidgetKind.Alert;
        match (self.alert_kind) {
            AlertKind.Success => { self.bg = color.rgb(30, 120, 70); },
            AlertKind.Warning => { self.bg = color.rgb(160, 110, 20); },
            AlertKind.Danger => { self.bg = color.rgb(160, 45, 55); },
            _ => { self.bg = color.rgb(40, 85, 160); }
        }
        self.fg = color.white;
        self.radius = 6.0;
        self.pad_l = 12.0;
        self.pad_t = 10.0;
        self.pad_r = 12.0;
        self.pad_b = 10.0;
    }

    pub fn kind_name(): str { return "Alert"; }
    pub fn widget_kind(): WidgetKind { return self.kind_tag; }
}

