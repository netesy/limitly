// ── Composition Helpers ───────────────────────────────────────────────────────

pub fn empty(): Container {
    return Container(true);
}

pub fn column(children: [any] = [] as [any]): Container {
    val c = Container(true);
    iter (child in children) {
        c.add(child as Fluent);
    }
    return c;
}

pub fn row(children: [any] = [] as [any]): Container {
    val c = Container(false);
    iter (child in children) {
        c.add(child as Fluent);
    }
    return c;
}

pub fn stack(children: [any] = [] as [any]): Container {
    val c = Container(true);
    c.flow = Flow.Stacked;
    iter (child in children) {
        c.add(child as Fluent);
    }
    return c;
}

pub fn overlay(content: Fluent, x: float = 0.0, y: float = 0.0, w: float = 0.0, h: float = 0.0): Container {
    val c = Container(true);
    c.kind_tag = WidgetKind.Overlay;
    c.overlay_x = x;
    c.overlay_y = y;
    c.overlay_w = w;
    c.overlay_h = h;
    c.children = [content];
    return c;
}

pub fn mask(shape_name: str, child: Fluent): Container {
    val c = Container(true);
    c.kind_tag = WidgetKind.Mask;
    c.a11y_role = shape_name;
    c.children = [child];
    return c;
}

pub fn tooltip(label: str, content: Fluent): Container {
    val c = Container(true);
    c.kind_tag = WidgetKind.Tooltip;
    c.a11y_label = label;
    c.children = [content];
    return c;
}

pub fn container_of(kind: WidgetKind, vertical: bool = true): Container {
    val c = Container(vertical);
    c.kind_tag = kind;
    return c;
}

pub fn toast(msg: str, type_str: str = "info"): Alert {
    val a = Alert(msg, type_str);
    a.kind_tag = WidgetKind.Toast;
    return a;
}
