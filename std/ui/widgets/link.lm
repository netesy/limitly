// std/ui/widgets/link.lm
// Widget — ported from legacy Fluent Link (std/ui/components.lm).
// Clickable accent-colored text. `url` is metadata only (no browser
// integration); clicks fire the optional callback.

import std.ui.component as comp;
import std.ui.component show Placed, TextBound;
import std.ui.types as ui_types;
import std.ui.event as uievent;
import std.ui.context as uictx;
import std.ui.draw_list as dl;
import std.ui.state as state;
import std.ui.tree as tree;
import std.events as events;
import std.color as color;
import std.ui.theme as uitheme;
import std.text.controller as text_ctrl;
import std.text.shaping as textshape;
import std.ui.text_metrics as tm;

frame Link {
    embed Placed;
    embed TextBound;
    pub var url: str;
    pub var click: (fn(): nil)?;
    pub var fg: color.Color;
    pub var font_scale: float;
    pub var hovered: int;

    pub init(txt: str = "", target_url: str = "", on_click: (fn(): nil)? = nil) {
        val pal = uitheme.palette();
        self.text = txt;
        self.url = target_url;
        self.click = on_click;
        self.fg = pal.info;
        self.font_scale = 1.0;
        self.hovered = 0;
        self.id = comp.next_widget_id();
    }

    pub fn kind(): ui_types.WidgetKind { return ui_types.WidgetKind.Link; }
    pub fn on_theme_changed(): nil {
        val p = uitheme.palette();
        self.fg = p.info;
        tree.request_repaint();
    }
    pub fn on_overlay_dismiss(): nil { }

    pub fn wants_pointer_capture(): int { return 0; }

    pub fn measure(min_w: float, max_w: float, min_h: float, max_h: float): comp.Size {
        var w: float = tm.text_width(textshape.prepare_display(self.string_val()), self.font_scale);
        var h: float = tm.line_height(self.font_scale);
        if (w < min_w) { w = min_w; }
        if (w > max_w) { w = max_w; }
        if (h < min_h) { h = min_h; }
        if (h > max_h) { h = max_h; }
        return comp.Size(w=w, h=h);
    }

    pub fn paint(): nil {
        var c = self.fg;
        if (self.hovered != 0) {
            c = color.Color(r=self.fg.r + 0.15, g=self.fg.g + 0.15, b=self.fg.b + 0.15, a=self.fg.a);
        }
        dl.dl_emit_text(dl.paint_ctx.dl, textshape.prepare_display(self.string_val()),
            self.rect.x, self.rect.y + (self.rect.h - tm.line_height(self.font_scale)) / 2.0,
            c.r, c.g, c.b, c.a, self.font_scale);
    }

    pub fn on_event(t: events.EventType, x: int, y: int, key: int): uievent.EventResult {
        var inside: bool = self.rect.contains(x as float, y as float);
        if (t == events.EventType.MouseMove) {
            if (inside) {
                self.hovered = 1;
                return uievent.EventResult.Handled;
            }
            self.hovered = 0;
        } elif (t == events.EventType.MouseUp) {
            if (inside and key == 0 and self.click != nil) {
                (self.click as (fn(): nil))();
                return uievent.EventResult.Handled;
            }
        }
        return uievent.EventResult.Ignored;
    }
}

pub fn link(txt: str, target_url: str = "", on_click: (fn(): nil)? = nil): Link {
    return Link(txt, target_url, on_click);
}
