// std/ui/widgets/filter.lm
// Widget — ported from legacy Fluent Filter.
// Single-line query box backed by EditorController + StrSignal, same
// editing model as TextInput (cursor keys, backspace, char insert,
// single focus owner via tree.set_focus).

import std.ui.component as comp;
import std.ui.component show Placed;
import std.ui.types as ui_types;
import std.ui.event as uievent;
import std.ui.context as uictx;
import std.ui.draw_list as dl;
import std.ui.state as state;
import std.ui.tree as tree;
import std.events as events;
import std.color as color;
import std.ui.theme as uitheme;
import std.text.controller as text_ctrl;
import std.text.shaping as textshape;
import std.ui.text_metrics as tm;

frame Filter {
    embed Placed;
    pub var ctrl: text_ctrl.EditorController;
    pub var query_sig: state.StrSignal;
    pub var placeholder: str;
    pub var surface: color.Color;
    pub var border: color.Color;
    pub var text: color.Color;
    pub var font_scale: float;
    pub var pad_x: float;
    pub var pad_y: float;
    pub var focused: int;

    pub init(q: str = "", hint: str = "Filter...") {
        val pal = uitheme.palette();
        self.ctrl = text_ctrl.EditorController(q);
        self.query_sig = state.signal_str(q);
        self.placeholder = hint;
        self.surface = pal.background;
        self.border = pal.border;
        self.text = pal.text_primary;
        self.font_scale = 1.0;
        self.pad_x = 10.0;
        self.pad_y = 6.0;
        self.focused = 0;
        self.id = comp.next_widget_id();
    }

    pub fn bind_query(sig: state.StrSignal): nil {
        self.query_sig = sig;
        self.ctrl.set_text(sig.get());
    }

    pub fn kind(): ui_types.WidgetKind { return ui_types.WidgetKind.Filter; }
    pub fn on_theme_changed(): nil {
        val p = uitheme.palette();
        self.surface = p.background;
        self.border = p.border;
        self.text = p.text_primary;
        tree.request_repaint();
    }
    pub fn on_overlay_dismiss(): nil { }

    fn sync_sig(): nil {
        self.query_sig.set(self.ctrl.get_text());
    }

    pub fn wants_pointer_capture(): int { return 0; }

    pub fn measure(min_w: float, max_w: float, min_h: float, max_h: float): comp.Size {
        var w: float = 200.0;
        var h: float = tm.line_height(self.font_scale) + self.pad_y * 2.0;
        if (w < min_w) { w = min_w; }
        if (w > max_w) { w = max_w; }
        if (h < min_h) { h = min_h; }
        if (h > max_h) { h = max_h; }
        return comp.Size(w=w, h=h);
    }

    pub fn paint(): nil {
        dl.dl_emit_rect_rounded(dl.paint_ctx.dl, self.rect.x, self.rect.y, self.rect.w, self.rect.h,
            4.0, self.surface.r, self.surface.g, self.surface.b, self.surface.a);
        dl.dl_emit_rect_border(dl.paint_ctx.dl, self.rect.x, self.rect.y, self.rect.w, self.rect.h,
            4.0, 1.0, self.border.r, self.border.g, self.border.b, 1.0);
        var txt = self.ctrl.get_text();
        if (self.focused == 0 and len(txt) == 0 and len(self.placeholder) > 0) {
            dl.dl_emit_text(dl.paint_ctx.dl, self.placeholder,
                self.rect.x + self.pad_x, self.rect.y + self.pad_y,
                0.5, 0.55, 0.6, 0.6, self.font_scale);
        } else {
            dl.dl_emit_text(dl.paint_ctx.dl, textshape.prepare_display(txt),
                self.rect.x + self.pad_x, self.rect.y + self.pad_y,
                self.text.r, self.text.g, self.text.b, 1.0, self.font_scale);
        }
        if (self.focused != 0) {
            dl.dl_emit_rect_border(dl.paint_ctx.dl, self.rect.x, self.rect.y, self.rect.w, self.rect.h,
                4.0, 1.0, 0.4, 0.6, 1.0, 0.9);
        }
    }

    pub fn on_event(t: events.EventType, x: int, y: int, key: int): uievent.EventResult {
        var inside: bool = self.rect.contains(x as float, y as float);
        if (t == events.EventType.MouseDown) {
            if (inside) {
                self.focused = 1;
                tree.set_focus(self);
                return uievent.EventResult.Handled;
            }
        } elif (t == events.EventType.KeyDown) {
            if (self.focused == 0) { return uievent.EventResult.Ignored; }
            if (key == 8 or key == 127) {
                self.ctrl.backspace();
                self.sync_sig();
                return uievent.EventResult.Handled;
            }
            if (key == 37) {
                self.ctrl.move_left(false);
                return uievent.EventResult.Handled;
            }
            if (key == 39) {
                self.ctrl.move_right(false);
                return uievent.EventResult.Handled;
            }
            if (key == 36) {
                self.ctrl.set_cursor(0, 0);
                return uievent.EventResult.Handled;
            }
            if (key == 35) {
                var lc = self.ctrl.get_line_count() - 1;
                self.ctrl.set_cursor(lc, len(self.ctrl.get_line(lc)));
                return uievent.EventResult.Handled;
            }
        } elif (t == events.EventType.Char) {
            if (self.focused == 0) { return uievent.EventResult.Ignored; }
            var ch = uictx.codepoint_to_utf8(key);
            if (len(ch) > 0) {
                self.ctrl.insert_text(ch);
                self.sync_sig();
                return uievent.EventResult.Handled;
            }
        }
        return uievent.EventResult.Ignored;
    }
}

pub fn filter(q: str = "", hint: str = "Filter..."): Filter {
    return Filter(q, hint);
}
