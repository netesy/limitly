// std/ui/widgets/slider.lm
// Widget — split from std/ui/widgets.lm.

import std.ui.component as comp;
import std.ui.component show Placed, TextBound;
import std.ui.types as ui_types;
import std.ui.event as uievent;
import std.ui.context as uictx;
import std.ui.draw_list as dl;
import std.ui.state as state;
import std.ui.tree as tree;
import std.events as events;
import std.color as color;
import std.ui.theme as uitheme;
import std.ui.motion as motion;
import std.text.controller as text_ctrl;
import std.text.shaping as textshape;
import std.ui.text_metrics as tm;

// ── Slider ───────────────────────────────────────────────────────────────────
// Horizontal value slider backed by a FloatSignal. value_sig is always
// present; widget drags write it, external set() is read live on paint.
// Layout: optional label on the left (TextBound), track fills the rest.

frame Slider {
    embed Placed;
    embed TextBound;
    pub var value_sig: state.FloatSignal;
    pub var min_val: float;
    pub var max_val: float;
    pub var track_h: float;
    pub var gap: float;
    pub var fg: color.Color;
    pub var accent: color.Color;
    pub var track_color: color.Color;
    pub var font_scale: float;
    pub var dragging: int;
    pub var hovered: int;
    // Track geometry cache — computed by layout_track() each paint/event.
    // Fields not a tuple return: AOT tuple returns read garbage (verified).
    pub var _tx: float = 0.0;
    pub var _ty: float = 0.0;
    pub var _tw: float = 0.0;
    pub var _th: float = 0.0;

    pub init(min_v: float = 0.0, max_v: float = 1.0, initial: float = 0.0, label_txt: str = "") {
        val pal = uitheme.palette();
        self.text = label_txt;
        self.value_sig = state.signal_float(initial);
        self.min_val = min_v;
        self.max_val = max_v;
        self.track_h = 8.0;
        self.gap = 8.0;
        self.fg = pal.on_accent;
        self.accent = pal.accent;
        self.track_color = pal.track;
        self.font_scale = 1.0;
        self.dragging = 0;
        self.hovered = 0;
        self.id = comp.next_widget_id();
    }

    pub fn kind(): ui_types.WidgetKind { return ui_types.WidgetKind.Slider; }
    pub fn wants_pointer_capture(): int { return self.dragging; }
    pub fn on_theme_changed(): nil {
        val p = uitheme.palette();
        self.fg = p.on_accent;
        self.accent = p.accent;
        self.track_color = p.track;
        tree.request_repaint();
    }
    pub fn on_overlay_dismiss(): nil { }

    pub fn bind_value(sig: state.FloatSignal): nil {
        self.value_sig = sig;
    }

    fn label_w(): float {
        if (len(self.string_val()) == 0) { return 0.0; }
        return tm.text_width(textshape.prepare_display(self.string_val()), self.font_scale) + self.gap;
    }

    fn clamp_val(v: float): float {
        if (v < self.min_val) { return self.min_val; }
        if (v > self.max_val) { return self.max_val; }
        return v;
    }

    // (track_x, track_y, track_w, track_h) cached in fields — tuple returns
    // are unreliable under AOT.
    fn layout_track(): nil {
        var lw: float = self.label_w();
        self._tx = self.rect.x + lw;
        self._tw = self.rect.x + self.rect.w - self._tx;
        self._ty = self.rect.y + (self.rect.h - self.track_h) / 2.0;
        self._th = self.track_h;
    }

    fn value_at_px(px: float): float {
        self.layout_track();
        var frac: float = (px - self._tx) / self._tw;
        if (frac < 0.0) { frac = 0.0; }
        if (frac > 1.0) { frac = 1.0; }
        return self.min_val + frac * (self.max_val - self.min_val);
    }

    pub fn measure(min_w: float, max_w: float, min_h: float, max_h: float): comp.Size {
        var w: float = self.label_w() + 120.0 * self.font_scale;
        var h: float = self.track_h + 8.0;
        var lh: float = tm.line_height(self.font_scale);
        if (lh > h) { h = lh; }
        if (w < min_w) { w = min_w; }
        if (w > max_w) { w = max_w; }
        if (h < min_h) { h = min_h; }
        if (h > max_h) { h = max_h; }
        return comp.Size(w=w, h=h);
    }

    pub fn paint(): nil {
        self.layout_track();
        dl.dl_emit_rect_rounded(dl.paint_ctx.dl, self._tx, self._ty, self._tw, self._th, self._th / 2.0,
            self.track_color.r, self.track_color.g, self.track_color.b, 1.0);
        var cur: float = self.clamp_val(self.value_sig.get());
        var frac: float = 0.0;
        if (self.max_val > self.min_val) {
            frac = (cur - self.min_val) / (self.max_val - self.min_val);
        }
        var fw: float = self._tw * frac;
        if (fw > 0.0) {
            dl.dl_emit_rect_rounded(dl.paint_ctx.dl, self._tx, self._ty, fw, self._th, self._th / 2.0,
                self.accent.r, self.accent.g, self.accent.b, 1.0);
        }
        // Thumb grows while hovered or dragged (motion prop 0 eases 0→1).
        var act: float = 0.0;
        if (self.hovered != 0 or self.dragging != 0) { act = 1.0; }
        act = motion.value(self.id, 0, act);
        var thumb: float = self._th + 6.0 + act * 4.0;
        var kx: float = self._tx + fw - thumb / 2.0;
        if (kx < self._tx - thumb / 2.0) { kx = self._tx - thumb / 2.0; }
        if (kx + thumb > self._tx + self._tw + thumb / 2.0) { kx = self._tx + self._tw - thumb / 2.0; }
        dl.dl_emit_rect_rounded(dl.paint_ctx.dl, kx, self._ty - 3.0, thumb, thumb, thumb / 4.0,
            1.0, 1.0, 1.0, 1.0);
        if (len(self.string_val()) > 0) {
            dl.dl_emit_text(dl.paint_ctx.dl, textshape.prepare_display(self.string_val()),
                self.rect.x, self.rect.y + (self.rect.h - tm.line_height(self.font_scale)) / 2.0,
                self.fg.r, self.fg.g, self.fg.b, self.fg.a, self.font_scale);
        }
    }

    pub fn on_event(t: events.EventType, x: int, y: int, key: int): uievent.EventResult {
        self.layout_track();
        var in_track: bool = (x as float) >= self._tx and (x as float) <= self._tx + self._tw
            and (y as float) >= self._ty - 4.0 and (y as float) <= self._ty + self._th + 4.0;
        // Activity target: hovered or dragging keeps the thumb grown.
        var act_target: float = 0.0;
        if (self.hovered != 0 or self.dragging != 0) { act_target = 1.0; }
        if (t == events.EventType.MouseMove) {
            if (self.dragging != 0) {
                self.value_sig.set(self.value_at_px(x as float));
                return uievent.EventResult.Handled;
            }
            var want: int = 0;
            if (in_track) { want = 1; }
            if (want != self.hovered) {
                self.hovered = want;
                motion.animate_to(self.id, 0, act_target, 0.12,
                    motion.value(self.id, 0, act_target));
                tree.request_repaint();
            }
        } elif (t == events.EventType.MouseDown) {
            if (in_track and key == 0) {
                self.dragging = 1;
                self.hovered = 1;
                self.value_sig.set(self.value_at_px(x as float));
                motion.animate_to(self.id, 0, 1.0, 0.08,
                    motion.value(self.id, 0, act_target));
                tree.request_repaint();
                return uievent.EventResult.Handled;
            }
        } elif (t == events.EventType.MouseUp) {
            if (self.dragging != 0) {
                self.dragging = 0;
                var rel: float = 0.0;
                if (self.hovered != 0) { rel = 1.0; }
                motion.animate_to(self.id, 0, rel, 0.15,
                    motion.value(self.id, 0, 1.0));
                tree.request_repaint();
                return uievent.EventResult.Handled;
            }
        }
        return uievent.EventResult.Ignored;
    }
}

pub fn slider(min_v: float = 0.0, max_v: float = 1.0, initial: float = 0.0, label_txt: str = ""): Slider {
    return Slider(min_v, max_v, initial, label_txt);
}

