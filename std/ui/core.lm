// std/ui/core - Core UI primitives and utilities
import std.ui.types as ui_types;
import std.color as color;

// Re-export fundamental types
pub import std.ui.types show Widget, Style, Color;

// Core utility functions
pub fn style(): ui_types.Style {
    return ui_types.style();
}

pub fn color(r: float, g: float, b: float): ui_types.Color {
    return color.color_rgb(r, g, b);
}

pub fn color_with_alpha(r: float, g: float, b: float, a: float): ui_types.Color {
    return color.color_rgba(r, g, b, a);
}
