// std/ui/grid - Grid layout container (CSS-grid like layout)
import std.ui.components as comp;
import std.ui.layout as layout;

// Create a grid layout with columns x rows
pub fn grid(columns_count: int, children: [comp.Fluent], spacing_val: float = 8.0): comp.Container {
    if (columns_count <= 0) {
        val c = comp.Container(true);
        iter (ch in children) { c.add(ch); }
        return c.spacing(spacing_val);
    }

    val rows: [comp.Fluent] = [];
    var cur_row: [comp.Fluent] = [];
    iter (child in children) {
        cur_row.append(child);
        if (len(cur_row) == columns_count) {
            val row_w = comp.Container(false);
            iter (r_ch in cur_row) { row_w.add(r_ch); }
            row_w.spacing_val = spacing_val;
            rows.append(row_w);
            cur_row = [] as [comp.Fluent];
        }
    }

    if (len(cur_row) > 0) {
        while (len(cur_row) < columns_count) {
            cur_row.append(comp.Spacer(1.0));
        }
        val row_w = comp.Container(false);
        iter (r_ch in cur_row) { row_w.add(r_ch); }
        row_w.spacing_val = spacing_val;
        rows.append(row_w);
    }

    val result = comp.Container(true);
    iter (r in rows) { result.add(r); }
    result.spacing_val = spacing_val;
    return result;
}

frame GridLayout {
    pub var columns: int;
    pub var gap: float;
    pub var children: [comp.Fluent];

    pub init(cols: int = 2, gap_size: float = 8.0) {
        self.columns = cols;
        self.gap = gap_size;
        self.children = [] as [comp.Fluent];
    }
}

pub fn grid_two_column(left: comp.Fluent, right: comp.Fluent, gap: float = 16.0): comp.Container {
    val row = comp.Container(false);
    row.add(left);
    row.add(right);
    row.spacing_val = gap;
    return row;
}

pub fn grid_three_column(a: comp.Fluent, b: comp.Fluent, c: comp.Fluent, gap: float = 12.0): comp.Container {
    val row = comp.Container(false);
    row.add(a);
    row.add(b);
    row.add(c);
    row.spacing_val = gap;
    return row;
}

pub fn grid_with_aspect(columns_count: int, children: [comp.Fluent], aspect_ratio: float, spacing_val: float = 8.0): comp.Container {
    iter (child in children) {
        child.set_aspect_ratio_val(aspect_ratio);
    }
    return grid(columns_count, children, spacing_val);
}

pub fn grid_enhanced(spec: layout.GridSpec, children: [comp.Fluent]): comp.Container {
    val w = comp.Container(false);
    iter (ch in children) { w.add(ch); }
    w.spacing_val = spec.column_gap;
    return w;
}
