// std.ui.types - Type definitions for Fluent, Retained UI System

import std.text.controller as text_ctrl;
import std.animation as anim;
import std.graphics.shadow as shadow;
import std.ui.state as state;
pub import std.graphics.shadow show Shadow, shadow;

// Widget identity enum: `==`/`match` on WidgetKind take the tag-compare
// path lowered in the LIR generator, so dispatch is type-checked.
enum WidgetKind {
    Container,
    Text,
    Button,
    Spacer,
    Image,
    Input,
    Checkbox,
    Slider,
    Tabs,
    Scroll,
    Badge,
    Select,
    Textarea,
    Toggle,
    Stepper,
    PlotLines,
    PlotHistogram,
    TreeNode,
    ColorPicker,
    Table,
    Accordion,
    Alert,
    Calendar,
    Card,
    Diff,
    Dock,
    FileInput,
    Filter,
    Indicator,
    Join,
    Link,
    List,
    Progress,
    RangeSlider,
    Stat,
    Timeline,
    Tooltip,
    Toast,
    Steps,
    Mask,
    BarChart,
    BubbleChart,
    DoughnutChart,
    LineChart,
    PolarAreaChart,
    RadarChart,
    ScatterChart,
    PieChart,
    Overlay,
    FormField
}

// Widget lifecycle phase (enter/exit transitions).
enum LifecycleState {
    Entering,
    Active,
    Exiting,
    Removed
}

// ── Nominal dispatch enums ───────────────────────────────────────────────────
// Every cross-cutting choice that used to hide behind a magic int, an int-packed
// frame, or a stringly-typed parameter is a nominal enum here. Renderers keep
// reading their packed int/string fields; the conversion happens once, through
// `match`, at the fluent call site (jump-table dispatch lowered in the LIR).

enum Alignment {
    Start,
    Center,
    End
}

type Align = Alignment;

enum Axis {
    Horizontal,
    Vertical,
    Stacked
}

enum Weight {
    Normal,
    Medium,
    Semibold,
    Bold
}

// Accessibility semantics. `Semantic` reads as "the semantic role this widget
// claims": ui.Semantic.Heading. The legacy string spelling stays available on
// Widget as `role_str` for hand-written ARIA values.
enum Semantic {
    Generic,
    Button,
    Link,
    Heading,
    Label,
    Paragraph,
    Img,
    Input,
    Checkbox,
    Slider,
    Progress,
    Tab,
    TabList,
    Region,
    Navigation,
    LiveStatus
}

enum AlertKind {
    Info,
    Success,
    Warning,
    Danger
}

enum DotState {
    Offline,
    Online,
    Busy
}

enum MaskShape {
    Circle,
    Rounded,
    Pill,
    Squircle
}

// Blueprint discriminant: 1 = Container, 2 = Text, 3 = Button.
enum BlueprintVariant {
    Container,
    Text,
    Button
}

// LayoutConstraint encoding consumed by the blueprint evaluator:
// mode 0 = fixed size, mode 1 = minimum, mode 2 = maximum.
enum ConstraintMode {
    Fixed,
    Min,
    Max
}

trait WidgetTrait {
    fn mark_for_removal(): nil;
}

// WidgetState is decomposed into per-concern mixins (shared state only -- mixins are
// not interfaces and never dispatch dynamically). The Widget frame mixes all of them;
// fields flatten onto the frame unchanged, so every `self.<field>` site keeps working.
mixin WidgetIdentity {
    pub var kind: WidgetKind;
    pub var lifecycle_state: LifecycleState;
}

enum Role {
    Text,
    Image,
    ChartValues,
    Rows,
    High
}

mixin TextualContent {
    pub var text_val: str;
    pub var placeholder_val: str;
    pub var focus_key: str;
    pub var text_editor_state: any;
    // Typed payload lanes. The `any` fields above stay as the storage the
    // renderers read; these record *what kind* of payload is parked there so
    // constructors and hit-testers dispatch with `match` instead of assuming.
    pub var payload_role: Role;
    // Semantic alert/status kind carried by Alert & Toast (Info lane is the
    // neutral default for widgets that never set it).
    pub var alert_kind: AlertKind;
    // Dot state for Indicator widgets.
    pub var dot_state: DotState;
}

mixin VisualStyle {
    pub var foreground_color: Color;
    pub var background_color: Color;
    pub var font_size_val: float;
    pub var font_weight_val: int;
    pub var corner_radius_val: float;
    pub var pressed_style_val: Style;
    pub var hover_style_val: Style;
    pub var opacity_val: float;
    pub var scale_val: float;
    pub var shadow_val: shadow.Shadow;
}

mixin LayoutMetrics {
    pub var padding_left: float;
    pub var padding_top: float;
    pub var padding_right: float;
    pub var padding_bottom: float;
    pub var spacing_val: float;
    pub var is_vertical: int;
    pub var align_val: int;
    // Declared through the `align` fluent modifier; kept as the packed int the
    // flexbox walkers read (0/1/2 — see Align).
    pub var align_kind: Align;
    pub var flex_val: float;
    pub var width_val: float;
    pub var height_val: float;

    // ── Layout Constraints ────────────────────────────────────────────────
    pub var min_width: float;
    pub var max_width: float;
    pub var min_height: float;
    pub var max_height: float;
    pub var grow: float;
    pub var shrink: float;
    pub var aspect_ratio: float;
}

mixin InteractionState {
    pub var is_enabled: int;
    pub var is_pressed: int;
    pub var is_hovered: int;
    pub var is_focused: int;
    pub var is_open: int;
    pub var click_count: int;
    // Callback slot: holds a `fn(): nil` (see the `fire_*` helpers in
    // std.ui.event, which invoke it fallibly as `EventResult?`).
    pub var on_click_action: any;
    pub var on_change_action: any;
}

mixin ToggleValue {
    pub var is_checked: int;
}

mixin SliderValue {
    pub var slider_val: float;
    pub var slider_min: float;
    pub var slider_max: float;
}

mixin TabState {
    pub var active_tab: int;
    pub var hovered_tab: int;
    pub var tab_titles: [str];
}

mixin SelectValue {
    pub var select_options: [str];
    pub var selected_idx: int;
}

mixin ScrollState {
    pub var scroll_x: float;
    pub var scroll_y: float;
    pub var max_scroll_x: float;
    pub var max_scroll_y: float;
}

mixin AnimationState {
    pub var enter_transition: anim.Transition;
    pub var exit_transition: anim.Transition;
    pub var anim_property: anim.PropertyAnimation;
    pub var active_transition: anim.Transition;
}

mixin Accessibility {
    pub var a11y_role: str;
    pub var a11y_label: str;
    pub var a11y_hint: str;
    pub var a11y_live: str;
    pub var tab_index: int;
    pub var is_a11y_hidden: bool;
}

// ── Canonical Retained UI Color (Re-exported from std.color) ────────────────
import std.color as color;
pub import std.color show Color, rgb, rgba, hex, color_rgb, color_rgba, lerp;

pub const white: Color = color.white;
pub const black: Color = color.black;
pub const red: Color = color.red;
pub const green: Color = color.green;
pub const blue: Color = color.blue;
pub const indigo: Color = color.indigo;
pub const yellow: Color = color.yellow;
pub const gray: Color = color.gray;
pub const dark_gray: Color = color.dark_gray;
pub const light_gray: Color = color.light_gray;
pub const transparent: Color = color.transparent;

// ── Widget Lifecycle States ──────────────────────────────────────────────────
pub const LIFECYCLE_ENTERING = LifecycleState.Entering;
pub const LIFECYCLE_ACTIVE = LifecycleState.Active;
pub const LIFECYCLE_EXITING = LifecycleState.Exiting;
pub const LIFECYCLE_REMOVED = LifecycleState.Removed;

frame Point {
    pub var x: float;
    pub var y: float;
}

pub fn point(x: float, y: float): Point {
    return Point(x=x, y=y);
}

frame Size {
    pub var width: float;
    pub var height: float;
}

pub fn size(w: float, h: float): Size {
    return Size(width=w, height=h);
}

frame Rect {
    pub var x: float;
    pub var y: float;
    pub var w: float;
    pub var h: float;
}

pub fn rect(x: float, y: float, w: float, h: float): Rect {
    return Rect(x=x, y=y, w=w, h=h);
}

// ── Enum ⇄ packed-field bridges ──────────────────────────────────────────────
// The retained renderer walks `is_vertical` / `align_val` ints directly; these
// helpers are the single place where a nominal enum crosses into that packing,
// dispatched by `match` rather than by an if/elif ladder.

pub fn axis_flag(a: Axis): int {
    match (a) {
        Axis.Horizontal => { return 0; },
        Axis.Vertical => { return 1; },
        Axis.Stacked => { return 2; }
    }
    return 1;
}

pub fn align_flag(a: Align): int {
    match (a) {
        Align.Start => { return 0; },
        Align.Center => { return 1; },
        Align.End => { return 2; }
    }
    return 0;
}

pub const AXIS_HORIZONTAL: Axis = Axis.Horizontal;
pub const AXIS_VERTICAL: Axis = Axis.Vertical;
pub const AXIS_STACKED: Axis = Axis.Stacked;

pub fn weight_value(w: Weight): int {
    match (w) {
        Weight.Normal => { return 400; },
        Weight.Medium => { return 500; },
        Weight.Semibold => { return 600; },
        Weight.Bold => { return 700; }
    }
    return 400;
}

pub const normal: Weight = Weight.Normal;
pub const bold: Weight = Weight.Bold;

// ARIA spelling for each semantic role.
pub fn semantic_name(s: Semantic): str {
    match (s) {
        Semantic.Generic => { return "generic"; },
        Semantic.Button => { return "button"; },
        Semantic.Link => { return "link"; },
        Semantic.Heading => { return "heading"; },
        Semantic.Label => { return "label"; },
        Semantic.Paragraph => { return "paragraph"; },
        Semantic.Img => { return "img"; },
        Semantic.Input => { return "textbox"; },
        Semantic.Checkbox => { return "checkbox"; },
        Semantic.Slider => { return "slider"; },
        Semantic.Progress => { return "progressbar"; },
        Semantic.Tab => { return "tab"; },
        Semantic.TabList => { return "tablist"; },
        Semantic.Region => { return "region"; },
        Semantic.Navigation => { return "navigation"; },
        Semantic.LiveStatus => { return "status"; }
    }
    return "generic";
}

pub fn mask_shape_name(m: MaskShape): str {
    match (m) {
        MaskShape.Circle => { return "circle"; },
        MaskShape.Rounded => { return "rounded"; },
        MaskShape.Pill => { return "pill"; },
        MaskShape.Squircle => { return "squircle"; }
    }
    return "circle";
}

// Stringly-typed legacy spellings fold into the nominal domain through match.
pub fn alert_kind_of(type_val: str): AlertKind {
    match (type_val) {
        "error" => { return AlertKind.Danger; },
        "danger" => { return AlertKind.Danger; },
        "warning" => { return AlertKind.Warning; },
        "success" => { return AlertKind.Success; },
        _ => { return AlertKind.Info; }
    }
}

pub fn dot_state_of(status: str): DotState {
    match (status) {
        "online" => { return DotState.Online; },
        "active" => { return DotState.Online; },
        "busy" => { return DotState.Busy; },
        "warning" => { return DotState.Busy; },
        _ => { return DotState.Offline; }
    }
}


pub fn semantic_alert_name(kind: AlertKind): str {
    match (kind) {
        AlertKind.Danger => { return "danger"; },
        AlertKind.Warning => { return "warning"; },
        AlertKind.Success => { return "success"; },
        _ => { return "info"; }
    }
}

pub fn dot_state_name(state: DotState): str {
    match (state) {
        DotState.Online => { return "online"; },
        DotState.Busy => { return "busy"; },
        _ => { return "offline"; }
    }
}
pub const align_start: Align = Align.Start;
pub const align_center: Align = Align.Center;
pub const align_end: Align = Align.End;

// Canonical spellings written back into the legacy string lanes the renderers
// still read, so the enum stays the single source of truth.
pub fn alert_kind_name(k: AlertKind): str {
    match (k) {
        AlertKind.Info => { return "info"; },
        AlertKind.Success => { return "success"; },
        AlertKind.Warning => { return "warning"; },
        AlertKind.Danger => { return "danger"; }
    }
    return "info";
}

pub fn dot_state_name(s: DotState): str {
    match (s) {
        DotState.Online => { return "online"; },
        DotState.Busy => { return "busy"; },
        DotState.Offline => { return "offline"; }
    }
    return "offline";
}

// Reusable Style Model (LVGL / CSS Inspired)
frame Style {
    pub var has_bg: bool;
    pub var bg: Color;
    pub var has_fg: bool;
    pub var fg: Color;
    pub var has_padding: bool;
    pub var pad_l: float;
    pub var pad_t: float;
    pub var pad_r: float;
    pub var pad_b: float;
    pub var has_radius: bool;
    pub var radius: float;
    pub var has_font_size: bool;
    pub var font_size_val: float;
    pub var has_weight: bool;
    pub var weight_val: int;
    pub var has_spacing: bool;
    pub var spacing_val: float;

    pub init() {
        self.has_bg = false;
        self.bg = transparent;
        self.has_fg = false;
        self.fg = white;
        self.has_padding = false;
        self.pad_l = 0.0;
        self.pad_t = 0.0;
        self.pad_r = 0.0;
        self.pad_b = 0.0;
        self.has_radius = false;
        self.radius = 0.0;
        self.has_font_size = false;
        self.font_size_val = 14.0;
        self.has_weight = false;
        self.weight_val = 400;
        self.has_spacing = false;
        self.spacing_val = 0.0;
    }

    pub fn background(c: Color): Style {
        self.has_bg = true;
        self.bg = c;
        return self;
    }

    pub fn foreground(c: Color): Style {
        self.has_fg = true;
        self.fg = c;
        return self;
    }

    pub fn color(c: Color): Style {
        return self.foreground(c);
    }

    pub fn padding(p: float): Style {
        self.has_padding = true;
        self.pad_l = p;
        self.pad_t = p;
        self.pad_r = p;
        self.pad_b = p;
        return self;
    }

    pub fn padding_xy(x: float, y: float): Style {
        self.has_padding = true;
        self.pad_l = x;
        self.pad_t = y;
        self.pad_r = x;
        self.pad_b = y;
        return self;
    }

    pub fn corner_radius(r: float): Style {
        self.has_radius = true;
        self.radius = r;
        return self;
    }

    pub fn font_size(s: float): Style {
        self.has_font_size = true;
        self.font_size_val = s;
        return self;
    }

    pub fn weight(w: int): Style {
        self.has_weight = true;
        self.weight_val = w;
        return self;
    }

    pub fn bold(): Style {
        return self.weight(700);
    }

    pub fn spacing(s: float): Style {
        self.has_spacing = true;
        self.spacing_val = s;
        return self;
    }

    pub fn merge(other: Style): Style {
        var s = Style();
        s.has_bg = self.has_bg;
        s.bg = self.bg;
        s.has_fg = self.has_fg;
        s.fg = self.fg;
        s.has_padding = self.has_padding;
        s.pad_l = self.pad_l;
        s.pad_t = self.pad_t;
        s.pad_r = self.pad_r;
        s.pad_b = self.pad_b;
        s.has_radius = self.has_radius;
        s.radius = self.radius;
        s.has_font_size = self.has_font_size;
        s.font_size_val = self.font_size_val;
        s.has_weight = self.has_weight;
        s.weight_val = self.weight_val;
        s.has_spacing = self.has_spacing;
        s.spacing_val = self.spacing_val;

        if (other.has_bg) { s.has_bg = true; s.bg = other.bg; }
        if (other.has_fg) { s.has_fg = true; s.fg = other.fg; }
        if (other.has_padding) {
            s.has_padding = true;
            s.pad_l = other.pad_l;
            s.pad_t = other.pad_t;
            s.pad_r = other.pad_r;
            s.pad_b = other.pad_b;
        }
        if (other.has_radius) { s.has_radius = true; s.radius = other.radius; }
        if (other.has_font_size) { s.has_font_size = true; s.font_size_val = other.font_size_val; }
        if (other.has_weight) { s.has_weight = true; s.weight_val = other.weight_val; }
        if (other.has_spacing) { s.has_spacing = true; s.spacing_val = other.spacing_val; }
        return s;
    }
}

pub fn style(): Style {
    return Style();
}

pub const KIND_CONTAINER = WidgetKind.Container;
pub const KIND_TEXT = WidgetKind.Text;
pub const KIND_BUTTON = WidgetKind.Button;
pub const KIND_SPACER = WidgetKind.Spacer;
pub const KIND_IMAGE = WidgetKind.Image;
pub const KIND_INPUT = WidgetKind.Input;
pub const KIND_CHECKBOX = WidgetKind.Checkbox;
pub const KIND_SLIDER = WidgetKind.Slider;
pub const KIND_TABS = WidgetKind.Tabs;
pub const KIND_SCROLL = WidgetKind.Scroll;
pub const KIND_BADGE = WidgetKind.Badge;
pub const KIND_SELECT = WidgetKind.Select;
pub const KIND_TEXTAREA = WidgetKind.Textarea;
pub const KIND_TOGGLE = WidgetKind.Toggle;
pub const KIND_STEPPER = WidgetKind.Stepper;
pub const KIND_PLOT_LINES = WidgetKind.PlotLines;
pub const KIND_PLOT_HISTOGRAM = WidgetKind.PlotHistogram;
pub const KIND_TREE_NODE = WidgetKind.TreeNode;
pub const KIND_COLOR_PICKER = WidgetKind.ColorPicker;
pub const KIND_TABLE = WidgetKind.Table;
pub const KIND_ACCORDION = WidgetKind.Accordion;
pub const KIND_ALERT = WidgetKind.Alert;
pub const KIND_CALENDAR = WidgetKind.Calendar;
pub const KIND_CARD = WidgetKind.Card;
pub const KIND_DIFF = WidgetKind.Diff;
pub const KIND_DOCK = WidgetKind.Dock;
pub const KIND_FILE_INPUT = WidgetKind.FileInput;
pub const KIND_FILTER = WidgetKind.Filter;
pub const KIND_INDICATOR = WidgetKind.Indicator;
pub const KIND_JOIN = WidgetKind.Join;
pub const KIND_LINK = WidgetKind.Link;
pub const KIND_LIST = WidgetKind.List;
pub const KIND_PROGRESS = WidgetKind.Progress;
pub const KIND_RANGE_SLIDER = WidgetKind.RangeSlider;
pub const KIND_STAT = WidgetKind.Stat;
pub const KIND_TIMELINE = WidgetKind.Timeline;
pub const KIND_TOOLTIP = WidgetKind.Tooltip;
pub const KIND_TOAST = WidgetKind.Toast;
pub const KIND_STEPS = WidgetKind.Steps;
pub const KIND_MASK = WidgetKind.Mask;
pub const KIND_BAR_CHART = WidgetKind.BarChart;
pub const KIND_BUBBLE_CHART = WidgetKind.BubbleChart;
pub const KIND_DOUGHNUT_CHART = WidgetKind.DoughnutChart;
pub const KIND_LINE_CHART = WidgetKind.LineChart;
pub const KIND_POLAR_AREA_CHART = WidgetKind.PolarAreaChart;
pub const KIND_RADAR_CHART = WidgetKind.RadarChart;
pub const KIND_SCATTER_CHART = WidgetKind.ScatterChart;
pub const KIND_PIE_CHART = WidgetKind.PieChart;
pub const KIND_OVERLAY = WidgetKind.Overlay;
pub const KIND_FORM_FIELD = WidgetKind.FormField;
pub var _shared_empty_style: Style = Style();
pub var _shared_empty_shadow: shadow.Shadow = shadow.Shadow();
pub var _shared_empty_trans: anim.Transition = anim.Transition();
pub var _shared_empty_anim: anim.PropertyAnimation = anim.PropertyAnimation();

// Unified Retained UI Node with Fluent Modifiers
frame Widget : WidgetTrait {
    mixin WidgetIdentity;
    mixin TextualContent;
    mixin VisualStyle;
    mixin LayoutMetrics;
    mixin InteractionState;
    mixin ToggleValue;
    mixin SliderValue;
    mixin TabState;
    mixin SelectValue;
    mixin ScrollState;
    mixin AnimationState;
    mixin Accessibility;

    pub var children: [Widget];

    pub init(k: WidgetKind) {
        self.kind = k;
        self.text_val = "";
        self.on_click_action = nil;
        self.children = [] as [Widget];
        self.foreground_color = white;
        self.background_color = transparent;
        self.font_size_val = 14.0;
        self.font_weight_val = 400;
        self.padding_left = 0.0;
        self.padding_top = 0.0;
        self.padding_right = 0.0;
        self.padding_bottom = 0.0;
        self.corner_radius_val = 0.0;
        self.spacing_val = 0.0;
        self.is_vertical = 1;
        self.align_val = 0;
        // Enum-side defaults mirror the packed ints above.
        self.align_kind = Align.Start;
        self.payload_role = Role.Text;
        self.alert_kind = AlertKind.Info;
        self.dot_state = DotState.Offline;
        self.flex_val = 1.0;
        self.is_enabled = 1;
        self.is_pressed = 0;
        self.is_hovered = 0;
        self.click_count = 0;
        self.width_val = 0.0;
        self.height_val = 0.0;
        self.pressed_style_val = _shared_empty_style;
        self.hover_style_val = _shared_empty_style;
        self.is_checked = 0;
        self.slider_val = 0.0;
        self.slider_min = 0.0;
        self.slider_max = 1.0;
        self.is_focused = 0;
        self.active_tab = 0;
        self.hovered_tab = -1;
        self.tab_titles = [] as [str];
        self.on_change_action = nil;
        self.select_options = [] as [str];
        self.selected_idx = 0;
        self.is_open = 0;
        self.opacity_val = 1.0;
        self.scale_val = 1.0;
        self.shadow_val = _shared_empty_shadow;
        self.lifecycle_state = LIFECYCLE_ACTIVE;
        self.enter_transition = _shared_empty_trans;
        self.exit_transition = _shared_empty_trans;
        self.anim_property = _shared_empty_anim;
        self.active_transition = _shared_empty_trans;

        self.text_editor_state = nil;
        self.scroll_x = 0.0;
        self.scroll_y = 0.0;
        self.max_scroll_x = 0.0;
        self.max_scroll_y = 0.0;
        self.placeholder_val = "";
        self.focus_key = "";

        // Constraints
        self.min_width = 0.0;
        self.max_width = 0.0;
        self.min_height = 0.0;
        self.max_height = 0.0;
        self.grow = 0.0;
        self.shrink = 1.0;
        self.aspect_ratio = 0.0;

        // Accessibility
        self.a11y_role = "";
        self.a11y_label = "";
        self.a11y_hint = "";
        self.a11y_live = "";
        self.tab_index = 0;
        self.is_a11y_hidden = false;
    }

    pub fn color(c: Color): Widget {
        self.foreground_color = c;
        return self;
    }

    pub fn foreground(c: Color): Widget {
        self.foreground_color = c;
        return self;
    }

    pub fn background(c: Color): Widget {
        self.background_color = c;
        return self;
    }

    pub fn font_size(s: float): Widget {
        self.font_size_val = s;
        return self;
    }

    pub fn bold(): Widget {
        self.font_weight_val = weight_value(Weight.Bold);
        return self;
    }

    // Semantic weight: the Weight enum crosses into the packed int once, here.
    pub fn weight(w: Weight): Widget {
        self.font_weight_val = weight_value(w);
        return self;
    }

    pub fn padding(p: float): Widget {
        self.padding_left = p;
        self.padding_top = p;
        self.padding_right = p;
        self.padding_bottom = p;
        return self;
    }

    pub fn padding_xy(x: float, y: float): Widget {
        self.padding_left = x;
        self.padding_top = y;
        self.padding_right = x;
        self.padding_bottom = y;
        return self;
    }

    pub fn padding_rect(l: float, t: float, r: float, b: float): Widget {
        self.padding_left = l;
        self.padding_top = t;
        self.padding_right = r;
        self.padding_bottom = b;
        return self;
    }

    pub fn corner_radius(r: float): Widget {
        self.corner_radius_val = r;
        return self;
    }

    pub fn spacing(s: float): Widget {
        self.spacing_val = s;
        return self;
    }

    pub fn align(a: Align): Widget {
        self.align_kind = a;
        self.align_val = align_flag(a);
        return self;
    }

    pub fn width(w: float): Widget {
        self.width_val = w;
        return self;
    }

    pub fn height(h: float): Widget {
        self.height_val = h;
        return self;
    }

    pub fn size(w: float, h: float): Widget {
        self.width_val = w;
        self.height_val = h;
        return self;
    }

    pub fn on_click(act: any): Widget {
        self.on_click_action = act;
        return self;
    }

    pub fn pressed(s: Style): Widget {
        self.pressed_style_val = s;
        return self;
    }

    pub fn style(s: Style): Widget {
        if (s.has_bg) {
            self.background_color = s.bg;
        }
        if (s.has_fg) {
            self.foreground_color = s.fg;
        }
        if (s.has_padding) {
            self.padding_left = s.pad_l;
            self.padding_top = s.pad_t;
            self.padding_right = s.pad_r;
            self.padding_bottom = s.pad_b;
        }
        if (s.has_radius) {
            self.corner_radius_val = s.radius;
        }
        if (s.has_font_size) {
            self.font_size_val = s.font_size_val;
        }
        if (s.has_weight) {
            self.font_weight_val = s.weight_val;
        }
        if (s.has_spacing) {
            self.spacing_val = s.spacing_val;
        }
        return self;
    }

    // ── Layout Constraint Modifiers ───────────────────────────────────────
    pub fn min_width(w: float): Widget { self.min_width = w; return self; }
    pub fn max_width(w: float): Widget { self.max_width = w; return self; }
    pub fn min_height(h: float): Widget { self.min_height = h; return self; }
    pub fn max_height(h: float): Widget { self.max_height = h; return self; }
    pub fn grow(factor: float): Widget { self.grow = factor; return self; }
    pub fn shrink(factor: float): Widget { self.shrink = factor; return self; }
    pub fn aspect_ratio(ratio: float): Widget { self.aspect_ratio = ratio; return self; }
    pub fn fill(): Widget { self.grow = 1.0; return self; }

    // ── Accessibility Modifiers ───────────────────────────────────────────
    // Nominal semantics: `widget.role(Semantic.Heading)`.
    pub fn role(s: Semantic): Widget {
        self.a11y_role = semantic_name(s);
        return self;
    }

    // Escape hatch for hand-written ARIA strings.
    pub fn role_str(r: str): Widget { self.a11y_role = r; return self; }

    pub fn aria_label(lbl: str): Widget { self.a11y_label = lbl; return self; }
    pub fn aria_hint(hint: str): Widget { self.a11y_hint = hint; return self; }
    pub fn aria_live(mode: str): Widget { self.a11y_live = mode; return self; }
    pub fn focusable(idx: int = 0): Widget { self.tab_index = idx; return self; }
    pub fn hidden_from_a11y(): Widget { self.is_a11y_hidden = true; return self; }

    // ── Retained Visual & Animation Modifiers ──────────────────────────────
    pub fn opacity(o: float): Widget { self.opacity_val = o; return self; }
    pub fn scale(s: float): Widget { self.scale_val = s; return self; }
    pub fn shadow(s: shadow.Shadow): Widget { self.shadow_val = s; return self; }
    pub fn animate(dur: float = 0.25, easing: anim.Easing = anim.Easing.Linear): Widget {
        self.anim_property = anim.PropertyAnimation(0.0, 1.0, dur, easing);
        return self;
    }
    pub fn spring(stiffness: float = 180.0, damping: float = 12.0): Widget {
        self.anim_property.spring_model = anim.Spring(stiffness, damping);
        self.anim_property.is_spring = true;
        return self;
    }
    pub fn transition(trans: anim.Transition): Widget { self.active_transition = trans; return self; }
    pub fn on_change(cb: any): Widget { self.on_change_action = cb; return self; }
    pub fn checked(c: bool): Widget { if (c) { self.is_checked = 1; } else { self.is_checked = 0; } return self; }
    pub fn disabled(): Widget { self.is_enabled = 0; return self; }
    pub fn hover(s: Style): Widget { self.hover_style_val = s; return self; }
    pub fn enter(t: anim.Transition): Widget {
        self.enter_transition = t;
        self.lifecycle_state = LIFECYCLE_ENTERING;
        return self;
    }
    pub fn exit(t: anim.Transition): Widget {
        self.exit_transition = t;
        return self;
    }
    pub fn mark_for_removal(): nil {
        self.lifecycle_state = LIFECYCLE_EXITING;
    }
    pub fn background_color(c: Color): Widget {
        return self.background(c);
    }

    // ── Signal Binding Modifiers ───────────────────────────────────────────
    pub fn bind_text(sig: any): Widget {
        var s = sig as state.Signal;
        if (s != nil) {
            s.subscribe(fn(new_val: any): nil {
                var txt = new_val as str;
                self.text_val = txt;
            });
        }
        return self;
    }

    pub fn bind_checked(sig: any): Widget {
        var s = sig as state.Signal;
        if (s != nil) {
            s.subscribe(fn(new_val: any): nil {
                var checked = new_val as bool;
                if (checked) {
                    self.is_checked = 1;
                } else {
                    self.is_checked = 0;
                }
            });
        }
        return self;
    }

    pub fn bind_value(sig: any): Widget {
        var s = sig as state.Signal;
        if (s != nil) {
            s.subscribe(fn(new_val: any): nil {
                var v = new_val as float;
                self.slider_val = v;
            });
        }
        return self;
    }

    pub fn bind_enabled(sig: any): Widget {
        var s = sig as state.Signal;
        if (s != nil) {
            s.subscribe(fn(new_val: any): nil {
                var enabled = new_val as bool;
                if (enabled) {
                    self.is_enabled = 1;
                } else {
                    self.is_enabled = 0;
                }
            });
        }
        return self;
    }
}

// Semantic Widget Constructors
pub fn text(content: str): Widget {
    var w = Widget(KIND_TEXT);
    w.text_val = content;
    w.foreground_color = white;
    return w;
}

pub fn button(label: str, on_click: any = nil): Widget {
    var w = Widget(KIND_BUTTON);
    w.text_val = label;
    w.on_click_action = on_click;
    w.background_color = blue;
    w.foreground_color = white;
    w.padding_left = 10.0;
    w.padding_top = 8.0;
    w.padding_right = 10.0;
    w.padding_bottom = 8.0;
    w.corner_radius_val = 4.0;
    w.height_val = 36.0;
    return w;
}

pub fn textarea(content: str): Widget {
    var w = Widget(KIND_TEXTAREA);
    w.text_val = content;
    w.text_editor_state = text_ctrl.EditorController(content);
    w.payload_role = Role.Text;
    w.focus_key = "ta_default";
    w.foreground_color = white;
    w.padding_left = 8.0;
    w.padding_top = 8.0;
    w.padding_right = 8.0;
    w.padding_bottom = 8.0;
    w.width_val = 300.0;
    w.height_val = 120.0;
    return w;
}

pub fn column(children: [Widget]): Widget {
    var w = Widget(KIND_CONTAINER);
    w.is_vertical = 1;
    w.children = children;
    return w;
}

pub fn row(children: [Widget]): Widget {
    var w = Widget(KIND_CONTAINER);
    w.is_vertical = 0;
    w.children = children;
    return w;
}

pub fn stack(children: [Widget]): Widget {
    var w = Widget(KIND_CONTAINER);
    w.is_vertical = 2;
    w.children = children;
    return w;
}

pub fn spacer(flex: float = 1.0): Widget {
    var w = Widget(KIND_SPACER);
    w.flex_val = flex;
    return w;
}

pub fn empty(): Widget {
    return Widget(KIND_CONTAINER);
}

// Blueprint data structures
frame ContainerData {
    pub var axis: Axis;
    pub var spacing: float;
    pub var padding: Rect;
    pub var background: Color;
}

pub fn container_data(axis: Axis): ContainerData {
    return ContainerData(
        axis=axis,
        spacing=0.0,
        padding=rect(0.0, 0.0, 0.0, 0.0),
        background=color_rgba(0.0, 0.0, 0.0, 0.0)
    );
}

frame TextData {
    pub var content: str;
    pub var font_size: float;
    pub var color: Color;
    pub var font_weight: int;
}

pub fn text_data(content: str): TextData {
    return TextData(content=content, font_size=14.0, color=color_rgb(1.0, 1.0, 1.0), font_weight=400);
}

frame ButtonData {
    pub var label: str;
    pub var background: Color;
    pub var text_color: Color;
    pub var corner_radius: float;
    pub var padding: Rect;
    pub var enabled: int;
}

pub fn button_data(label: str): ButtonData {
    return ButtonData(
        label=label,
        background=color_rgb8(60, 120, 210),
        text_color=color_rgb8(255, 255, 255),
        corner_radius=4.0,
        padding=rect(8.0, 4.0, 8.0, 4.0),
        enabled=1
    );
}

frame LayoutConstraint {
    pub var mode: int;
    pub var value_num: int;
}

frame Blueprint {
    pub var variant_type: int; // 1 = Container, 2 = Text, 3 = Button
    pub var container_data_val: ContainerData;
    pub var text_data_val: TextData;
    pub var button_data_val: ButtonData;
    pub var constraints: [LayoutConstraint];
    pub var children: [Blueprint];
}

pub fn empty_constraints(): [LayoutConstraint] {
    var res: [LayoutConstraint] = [];
    return res;
}

pub fn empty_blueprints(): [Blueprint] {
    var res: [Blueprint] = [];
    return res;
}

pub fn blueprint_add_constraint(bp: Blueprint, c: LayoutConstraint): Blueprint {
    bp.constraints.append(c);
    return bp;
}

pub fn blueprint_add_child(bp: Blueprint, child: Blueprint): Blueprint {
    bp.children.append(child);
    return bp;
}

// ── Nominal blueprint builders ────────────────────────────────────
// The evaluator walks the packed `variant_type` int (1/2/3); these helpers are
// the only place new blueprints are minted, so call sites never spell a raw
// discriminant.

pub fn variant_code(v: BlueprintVariant): int {
    match (v) {
        BlueprintVariant.Container => { return 1; },
        BlueprintVariant.Text => { return 2; },
        BlueprintVariant.Button => { return 3; }
    }
    return 1;
}

pub fn blueprint_container(children: [Blueprint] = empty_blueprints(), axis: Axis = AXIS_VERTICAL): Blueprint {
    return Blueprint(
        variant_type=variant_code(BlueprintVariant.Container),
        container_data_val=container_data(axis),
        text_data_val=text_data(""),
        button_data_val=button_data(""),
        constraints=empty_constraints(),
        children=children
    );
}

pub fn blueprint_text(content: str): Blueprint {
    return Blueprint(
        variant_type=variant_code(BlueprintVariant.Text),
        container_data_val=container_data(AXIS_VERTICAL),
        text_data_val=text_data(content),
        button_data_val=button_data(""),
        constraints=empty_constraints(),
        children=empty_blueprints()
    );
}

pub fn blueprint_button(label: str): Blueprint {
    return Blueprint(
        variant_type=variant_code(BlueprintVariant.Button),
        container_data_val=container_data(AXIS_VERTICAL),
        text_data_val=text_data(""),
        button_data_val=button_data(label),
        constraints=empty_constraints(),
        children=empty_blueprints()
    );
}

// Typed constraint: the ConstraintMode enum crosses into the packed int once,
// through match.
pub fn constraint(m: ConstraintMode, value: int): LayoutConstraint {
    var encoded = 0;
    match (m) {
        ConstraintMode.Fixed => { encoded = 0; },
        ConstraintMode.Min => { encoded = 1; },
        ConstraintMode.Max => { encoded = 2; }
    }
    return LayoutConstraint(mode=encoded, value_num=value);
}

// Extra widgets from std/ui.lm
pub fn select(options: [str], selected_idx: int = 0, on_change: any = nil): Widget {
    var w = Widget(KIND_SELECT);
    w.select_options = options;
    w.selected_idx = selected_idx;
    w.on_change_action = on_change;
    w.is_open = 0;
    w.background_color = rgb(28, 30, 38);
    w.foreground_color = white;
    w.height_val = 28.0;
    w.width_val = 180.0;
    w.padding_left = 10.0;
    w.padding_right = 10.0;
    w.corner_radius_val = 4.0;
    if (len(options) > selected_idx) {
        w.text_val = options[selected_idx];
    }
    return w;
}

