pub fn checkbox(checked: bool = false, on_change: any = nil): Widget {
    var w = Widget(KIND_CHECKBOX);
    if (checked) {
        w.is_checked = 1;
        w.text_val = "[X]";
        w.foreground_color = rgb(80, 220, 130);
    } else {
        w.is_checked = 0;
        w.text_val = "[ ]";
        w.foreground_color = gray;
    }
    w.background_color = rgb(35, 38, 48);
    w.height_val = 26.0;
    w.width_val = 42.0;
    w.on_change_action = on_change;
    return w;
}

pub fn indicator(status: str = "online", label: str = ""): Widget {
    var w = Widget(KIND_INDICATOR);
    w.placeholder_val = status;
    w.text_val = label;
    if (status == "online" or status == "active") {
        w.foreground_color = rgb(80, 220, 130);
    } elif (status == "busy" or status == "warning") {
        w.foreground_color = rgb(255, 200, 80);
    } else {
        w.foreground_color = rgb(150, 155, 170);
    }
    w.height_val = 20.0;
    return w;
}

pub fn slider(value: float = 50.0, min_val: float = 0.0, max_val: float = 100.0, on_change: any = nil): Widget {
    var w = Widget(KIND_SLIDER);
    w.slider_val = value;
    w.slider_min = min_val;
    w.slider_max = max_val;
    w.on_change_action = on_change;
    w.height_val = 24.0;
    w.width_val = 140.0;
    w.background_color = rgb(35, 38, 48);
    w.foreground_color = rgb(100, 180, 255);
    return w;
}

pub fn input(value: str = "", placeholder: str = "Type here...", on_change: any = nil): Widget {
    var w = Widget(KIND_INPUT);
    w.text_val = value;
    w.placeholder_val = placeholder;
    w.on_change_action = on_change;
    w.background_color = rgb(20, 22, 28);
    w.foreground_color = white;
    w.height_val = 28.0;
    w.width_val = 220.0;
    w.padding_left = 8.0;
    w.padding_right = 8.0;
    w.padding_top = 6.0;
    w.padding_bottom = 6.0;
    return w;
}
