    return toast_k(message, alert_kind_of(type_val));
}

pub fn toast_k(message: str, kind: AlertKind): Widget {
    var w = Widget(KIND_TOAST);
    w.text_val = message;
    w.alert_kind = kind;
    w.placeholder_val = alert_kind_name(kind);
    w.background_color = rgb(28, 30, 42);
    w.foreground_color = white;
    w.height_val = 36.0;
    w.width_val = 240.0;
    return w;
}

pub fn filter(query: str = "", placeholder: str = "Filter...", on_change: any = nil): Widget {
    var w = Widget(KIND_FILTER);
    w.text_val = query;
    w.placeholder_val = placeholder;
    w.on_change_action = on_change;
    w.background_color = rgb(20, 22, 28);
    w.foreground_color = white;
    w.height_val = 28.0;
    w.width_val = 180.0;
    return w;
}

pub fn card(title: str, content: Widget): Widget {
    var w = Widget(KIND_CARD);
    w.text_val = title;
    w.children = [content];
    w.background_color = rgb(24, 26, 34);
    w.foreground_color = white;
    w.padding_left = 12.0;
    w.padding_top = 12.0;
    w.padding_right = 12.0;
    w.padding_bottom = 12.0;
    return w;
}

pub fn scroll(content: Widget): Widget {
    var w = Widget(KIND_SCROLL);
    w.children = [content];
    w.height_val = 0.0;
    w.scroll_y = 0.0;
    w.background_color = rgb(20, 22, 28);
    return w;
}

pub fn plot_lines(label: str, values: [float], min_val: float = 0.0, max_val: float = 1.0): Widget {
    var w = Widget(KIND_PLOT_LINES);
    w.text_val = label;
    w.slider_min = min_val;
    w.slider_max = max_val;
    w.height_val = 50.0;
    w.width_val = 180.0;
    w.background_color = rgb(24, 26, 34);
    w.foreground_color = rgb(100, 180, 255);
    w.text_editor_state = values;
    w.payload_role = Role.ChartValues;
    return w;
}

pub fn text_area(value: str = "", placeholder: str = "Type here...", on_change: any = nil): Widget {
    var w = Widget(KIND_TEXTAREA);
    w.text_val = value;
    w.placeholder_val = placeholder;
    w.on_change_action = on_change;
    w.text_editor_state = text_ctrl.EditorController(value);
    w.focus_key = "ta_default";
    w.background_color = rgb(20, 22, 28);
    w.foreground_color = white;
    w.height_val = 120.0;
    w.width_val = 300.0;
    w.padding_left = 8.0;
    w.padding_right = 8.0;
    w.padding_top = 6.0;
    w.padding_bottom = 6.0;
    return w;
}

pub fn tabs(titles: [str], pages: [Widget], active: int = 0, on_change: any = nil): Widget {
    var w = Widget(KIND_TABS);
    w.tab_titles = titles;
    w.children = pages;
    w.active_tab = active;
    w.on_change_action = on_change;
    w.height_val = 0.0;
    w.spacing_val = 6.0;
    return w;
}

pub fn polar_area_chart(label: str, values: [float], labels: [str] = [] as [str]): Widget {
    var w = Widget(KIND_POLAR_AREA_CHART);
    w.text_val = label;
    w.tab_titles = labels;
    w.height_val = 120.0;
    w.width_val = 120.0;
    w.background_color = rgb(24, 26, 34);
    w.text_editor_state = values;
    w.payload_role = Role.ChartValues;
    return w;
}

pub fn join(items: [Widget]): Widget {
    var w = Widget(KIND_JOIN);
    w.children = items;
    w.is_vertical = 0;
    return w;
}

pub fn dock(items: [Widget]): Widget {
    var w = Widget(KIND_DOCK);
    w.children = items;
    w.background_color = rgb(28, 30, 40);
    w.height_val = 48.0;
    return w;
}

pub fn bubble_chart(label: str, values: [float]): Widget {
    var w = Widget(KIND_BUBBLE_CHART);
    w.text_val = label;
    w.height_val = 100.0;
    w.width_val = 180.0;
    w.background_color = rgb(24, 26, 34);
    w.foreground_color = rgb(255, 180, 90);
    w.text_editor_state = values;
    w.payload_role = Role.ChartValues;
    return w;
}

pub fn scatter_chart(label: str, values: [float]): Widget {
    var w = Widget(KIND_SCATTER_CHART);
    w.text_val = label;
    w.height_val = 100.0;
    w.width_val = 180.0;
    w.background_color = rgb(24, 26, 34);
    w.foreground_color = rgb(220, 120, 255);
    w.text_editor_state = values;
    w.payload_role = Role.ChartValues;
    return w;
}

pub fn doughnut_chart(label: str, values: [float], labels: [str] = [] as [str]): Widget {
    var w = Widget(KIND_DOUGHNUT_CHART);
    w.text_val = label;
    w.tab_titles = labels;
    w.height_val = 120.0;
    w.width_val = 120.0;
    w.background_color = rgb(24, 26, 34);
    w.text_editor_state = values;
    w.payload_role = Role.ChartValues;
    return w;
}

pub fn overlay(content: Widget, x: float = 0.0, y: float = 0.0, width_val: float = 0.0, height_val: float = 0.0): Widget {
    var w = Widget(KIND_OVERLAY);
    w.children = [content];
    w.padding_left = x;
    w.padding_top = y;
    w.width_val = width_val;
    w.height_val = height_val;
    return w;
}

pub fn diff(old_text: str, new_text: str): Widget {
    var w = Widget(KIND_DIFF);
    w.text_val = old_text;
    w.placeholder_val = new_text;
    w.background_color = rgb(20, 22, 28);
    return w;
}

pub fn checkbox(checked: bool = false, on_change: any = nil): Widget {
    var w = Widget(KIND_CHECKBOX);
    if (checked) {
        w.is_checked = 1;
        w.text_val = "[X]";
        w.foreground_color = rgb(80, 220, 130);
    } else {
        w.is_checked = 0;
        w.text_val = "[ ]";
        w.foreground_color = gray;
    }
    w.background_color = rgb(35, 38, 48);
    w.height_val = 26.0;
    w.width_val = 42.0;
    w.on_change_action = on_change;
    return w;
}

pub fn indicator(status: str = "online", label: str = ""): Widget {
    return indicator_k(dot_state_of(status), label);
}

// Nominal form: dot color chosen by exhaustive match.
pub fn indicator_k(status: DotState, label: str = ""): Widget {
    var w = Widget(KIND_INDICATOR);
    w.dot_state = status;
    w.placeholder_val = dot_state_name(status);
    w.text_val = label;
    match (status) {
        DotState.Online => { w.foreground_color = rgb(80, 220, 130); },
        DotState.Busy => { w.foreground_color = rgb(255, 200, 80); },
        DotState.Offline => { w.foreground_color = rgb(150, 155, 170); }
    }
    w.height_val = 20.0;
    return w;
}

pub fn slider(value: float = 50.0, min_val: float = 0.0, max_val: float = 100.0, on_change: any = nil): Widget {
    var w = Widget(KIND_SLIDER);
    w.slider_val = value;
    w.slider_min = min_val;
    w.slider_max = max_val;
    w.on_change_action = on_change;
    w.height_val = 24.0;
    w.width_val = 140.0;
    w.background_color = rgb(35, 38, 48);
    w.foreground_color = rgb(100, 180, 255);
    return w;
}

pub fn input(value: str = "", placeholder: str = "Type here...", on_change: any = nil): Widget {
    var w = Widget(KIND_INPUT);
    w.text_val = value;
    w.placeholder_val = placeholder;
    w.on_change_action = on_change;
    w.background_color = rgb(20, 22, 28);
    w.foreground_color = white;
    w.height_val = 28.0;
    w.width_val = 220.0;
    w.padding_left = 8.0;
    w.padding_right = 8.0;
    w.padding_top = 6.0;
    w.padding_bottom = 6.0;
    return w;
}
