// std.ui.types - Type definitions for Fluent, Retained UI System

import std.text.controller as text_ctrl;
import std.animation as anim_mod;
import std.graphics.shadow as shadow_mod;
import std.ui.state as state_mod;

pub var Shadow = shadow_mod.Shadow;
pub fn shadow(r: float = 0.0, g: float = 0.0, b: float = 0.0, a: float = 0.0, off_x: float = 0.0, off_y: float = 0.0, blur: float = 0.0, spread: float = 0.0): shadow_mod.Shadow {
    return shadow_mod.shadow(r, g, b, a, off_x, off_y, blur, spread);
}

// ── Canonical Retained UI Color ──────────────────────────────────────────────
frame Color {
    pub var r: float;
    pub var g: float;
    pub var b: float;
    pub var a: float;

    pub init(r: float = 0.0, g: float = 0.0, b: float = 0.0, a: float = 1.0) {
        self.r = r;
        self.g = g;
        self.b = b;
        self.a = a;
    }
}

pub fn rgb(r: int, g: int, b: int): Color {
    return Color(r=(r as float) / 255.0, g=(g as float) / 255.0, b=(b as float) / 255.0, a=1.0);
}

pub fn rgba(r: int, g: int, b: int, a: float): Color {
    return Color(r=(r as float) / 255.0, g=(g as float) / 255.0, b=(b as float) / 255.0, a=a);
}

pub fn color_rgb(r: float, g: float, b: float): Color {
    return Color(r=r, g=g, b=b, a=1.0);
}

pub fn color_rgba(r: float, g: float, b: float, a: float): Color {
    return Color(r=r, g=g, b=b, a=a);
}

pub var white: Color = Color(r=1.0, g=1.0, b=1.0, a=1.0);
pub var black: Color = Color(r=0.0, g=0.0, b=0.0, a=1.0);
pub var red: Color = Color(r=0.9, g=0.2, b=0.2, a=1.0);
pub var green: Color = Color(r=0.2, g=0.8, b=0.3, a=1.0);
pub var blue: Color = Color(r=0.2, g=0.6, b=0.95, a=1.0);
pub var indigo: Color = Color(r=0.35, g=0.35, b=0.9, a=1.0);
pub var yellow: Color = Color(r=0.95, g=0.8, b=0.15, a=1.0);
pub var gray: Color = Color(r=0.55, g=0.55, b=0.55, a=1.0);
pub var dark_gray: Color = Color(r=0.15, g=0.15, b=0.18, a=1.0);
pub var light_gray: Color = Color(r=0.85, g=0.85, b=0.88, a=1.0);
pub var transparent: Color = Color(r=0.0, g=0.0, b=0.0, a=0.0);

// ── Widget Lifecycle States ──────────────────────────────────────────────────
pub var LIFECYCLE_ENTERING: int = 0;
pub var LIFECYCLE_ACTIVE: int = 1;
pub var LIFECYCLE_EXITING: int = 2;
pub var LIFECYCLE_REMOVED: int = 3;








frame Point {
    pub var x: float;
    pub var y: float;
}

pub fn point(x: float, y: float): Point {
    return Point(x=x, y=y);
}

frame Size {
    pub var width: float;
    pub var height: float;
}

pub fn size(w: float, h: float): Size {
    return Size(width=w, height=h);
}

frame Rect {
    pub var x: float;
    pub var y: float;
    pub var w: float;
    pub var h: float;
}

pub fn rect(x: float, y: float, w: float, h: float): Rect {
    return Rect(x=x, y=y, w=w, h=h);
}

frame Axis {
    pub var is_vertical: int;
}

pub var AXIS_HORIZONTAL: Axis = Axis(is_vertical=0);
pub var AXIS_VERTICAL: Axis = Axis(is_vertical=1);

frame Alignment {
    pub var align_type: int;
}

pub var align_start: Alignment = Alignment(align_type=0);
pub var align_center: Alignment = Alignment(align_type=1);
pub var align_end: Alignment = Alignment(align_type=2);

pub var normal: int = 400;
pub var bold: int = 700;

// Reusable Style Model (LVGL / CSS Inspired)
frame Style {
    pub var has_bg: bool;
    pub var bg: Color;
    pub var has_fg: bool;
    pub var fg: Color;
    pub var has_padding: bool;
    pub var pad_l: float;
    pub var pad_t: float;
    pub var pad_r: float;
    pub var pad_b: float;
    pub var has_radius: bool;
    pub var radius: float;
    pub var has_font_size: bool;
    pub var font_size_val: float;
    pub var has_weight: bool;
    pub var weight_val: int;
    pub var has_spacing: bool;
    pub var spacing_val: float;

    pub init() {
        self.has_bg = false;
        self.bg = transparent;
        self.has_fg = false;
        self.fg = white;
        self.has_padding = false;
        self.pad_l = 0.0;
        self.pad_t = 0.0;
        self.pad_r = 0.0;
        self.pad_b = 0.0;
        self.has_radius = false;
        self.radius = 0.0;
        self.has_font_size = false;
        self.font_size_val = 14.0;
        self.has_weight = false;
        self.weight_val = 400;
        self.has_spacing = false;
        self.spacing_val = 0.0;
    }

    pub fn background(c: Color): Style {
        self.has_bg = true;
        self.bg = c;
        return self;
    }

    pub fn foreground(c: Color): Style {
        self.has_fg = true;
        self.fg = c;
        return self;
    }

    pub fn color(c: Color): Style {
        return self.foreground(c);
    }

    pub fn padding(p: float): Style {
        self.has_padding = true;
        self.pad_l = p;
        self.pad_t = p;
        self.pad_r = p;
        self.pad_b = p;
        return self;
    }

    pub fn padding_xy(x: float, y: float): Style {
        self.has_padding = true;
        self.pad_l = x;
        self.pad_t = y;
        self.pad_r = x;
        self.pad_b = y;
        return self;
    }

    pub fn corner_radius(r: float): Style {
        self.has_radius = true;
        self.radius = r;
        return self;
    }

    pub fn font_size(s: float): Style {
        self.has_font_size = true;
        self.font_size_val = s;
        return self;
    }

    pub fn weight(w: int): Style {
        self.has_weight = true;
        self.weight_val = w;
        return self;
    }

    pub fn bold(): Style {
        return self.weight(700);
    }

    pub fn spacing(s: float): Style {
        self.has_spacing = true;
        self.spacing_val = s;
        return self;
    }

    pub fn merge(other: Style): Style {
        var s = Style();
        s.has_bg = self.has_bg;
        s.bg = self.bg;
        s.has_fg = self.has_fg;
        s.fg = self.fg;
        s.has_padding = self.has_padding;
        s.pad_l = self.pad_l;
        s.pad_t = self.pad_t;
        s.pad_r = self.pad_r;
        s.pad_b = self.pad_b;
        s.has_radius = self.has_radius;
        s.radius = self.radius;
        s.has_font_size = self.has_font_size;
        s.font_size_val = self.font_size_val;
        s.has_weight = self.has_weight;
        s.weight_val = self.weight_val;
        s.has_spacing = self.has_spacing;
        s.spacing_val = self.spacing_val;

        if (other.has_bg) { s.has_bg = true; s.bg = other.bg; }
        if (other.has_fg) { s.has_fg = true; s.fg = other.fg; }
        if (other.has_padding) {
            s.has_padding = true;
            s.pad_l = other.pad_l;
            s.pad_t = other.pad_t;
            s.pad_r = other.pad_r;
            s.pad_b = other.pad_b;
        }
        if (other.has_radius) { s.has_radius = true; s.radius = other.radius; }
        if (other.has_font_size) { s.has_font_size = true; s.font_size_val = other.font_size_val; }
        if (other.has_weight) { s.has_weight = true; s.weight_val = other.weight_val; }
        if (other.has_spacing) { s.has_spacing = true; s.spacing_val = other.spacing_val; }
        return s;
    }
}

pub fn style(): Style {
    return Style();
}

pub var KIND_CONTAINER: int = 1;
pub var KIND_TEXT: int = 2;
pub var KIND_BUTTON: int = 3;
pub var KIND_SPACER: int = 4;
pub var KIND_IMAGE: int = 5;
pub var KIND_INPUT: int = 6;
pub var KIND_CHECKBOX: int = 7;
pub var KIND_SLIDER: int = 8;
pub var KIND_TABS: int = 9;
pub var KIND_SCROLL: int = 10;
pub var KIND_BADGE: int = 11;
pub var KIND_SELECT: int = 12;
pub var KIND_TEXTAREA: int = 13;
pub var KIND_TOGGLE: int = 14;
pub var KIND_STEPPER: int = 15;
pub var KIND_PLOT_LINES: int = 16;
pub var KIND_PLOT_HISTOGRAM: int = 17;
pub var KIND_TREE_NODE: int = 18;
pub var KIND_COLOR_PICKER: int = 19;
pub var KIND_TABLE: int = 20;
pub var KIND_ACCORDION: int = 21;
pub var KIND_ALERT: int = 22;
pub var KIND_CALENDAR: int = 23;
pub var KIND_CARD: int = 24;
pub var KIND_DIFF: int = 25;
pub var KIND_DOCK: int = 26;
pub var KIND_FILE_INPUT: int = 27;
pub var KIND_FILTER: int = 28;
pub var KIND_INDICATOR: int = 29;
pub var KIND_JOIN: int = 30;
pub var KIND_LINK: int = 31;
pub var KIND_LIST: int = 32;
pub var KIND_PROGRESS: int = 33;
pub var KIND_RANGE_SLIDER: int = 34;
pub var KIND_STAT: int = 35;
pub var KIND_TIMELINE: int = 36;
pub var KIND_TOOLTIP: int = 37;
pub var KIND_TOAST: int = 38;
pub var KIND_STEPS: int = 39;
pub var KIND_MASK: int = 40;
pub var KIND_BAR_CHART: int = 41;
pub var KIND_BUBBLE_CHART: int = 42;
pub var KIND_DOUGHNUT_CHART: int = 43;
pub var KIND_LINE_CHART: int = 44;
pub var KIND_POLAR_AREA_CHART: int = 45;
pub var KIND_RADAR_CHART: int = 46;
pub var KIND_SCATTER_CHART: int = 47;
pub var KIND_PIE_CHART: int = 48;
pub var KIND_OVERLAY: int = 49;
pub var KIND_FORM_FIELD: int = 50;
pub var _shared_empty_style: Style = Style();
pub var _shared_empty_shadow: shadow_mod.Shadow = shadow_mod.Shadow();
pub var _shared_empty_trans: anim_mod.Transition = anim_mod.Transition();
pub var _shared_empty_anim: anim_mod.PropertyAnimation = anim_mod.PropertyAnimation();

// Unified Retained UI Node with Fluent Modifiers
frame Widget {
    pub var kind: int;
    pub var text_val: str;
    pub var on_click_action: any;
    pub var children: [Widget];

    pub var foreground_color: Color;
    pub var background_color: Color;
    pub var font_size_val: float;
    pub var font_weight_val: int;
    pub var padding_left: float;
    pub var padding_top: float;
    pub var padding_right: float;
    pub var padding_bottom: float;
    pub var corner_radius_val: float;
    pub var spacing_val: float;
    pub var is_vertical: int;
    pub var align_val: int;
    pub var flex_val: float;
    pub var is_enabled: int;
    pub var is_pressed: int;
    pub var is_hovered: int;
    pub var click_count: int;
    pub var width_val: float;
    pub var height_val: float;
    pub var pressed_style_val: Style;
    pub var hover_style_val: Style;
    pub var is_checked: int;
    pub var slider_val: float;
    pub var slider_min: float;
    pub var slider_max: float;
    pub var is_focused: int;
    pub var active_tab: int;
    pub var hovered_tab: int;
    pub var tab_titles: [str];
    pub var on_change_action: any;
    pub var select_options: [str];
    pub var selected_idx: int;
    pub var is_open: int;
    pub var opacity_val: float;
    pub var scale_val: float;
    pub var shadow_val: shadow_mod.Shadow;
    pub var lifecycle_state: int;
    pub var enter_transition: anim_mod.Transition;
    pub var exit_transition: anim_mod.Transition;
    pub var anim_property: anim_mod.PropertyAnimation;
    pub var active_transition: anim_mod.Transition;

    pub var text_editor_state: any;
    pub var scroll_x: float;
    pub var scroll_y: float;
    pub var max_scroll_x: float;
    pub var max_scroll_y: float;
    pub var placeholder_val: str;
    pub var focus_key: str;

    // ── Layout Constraints ────────────────────────────────────────────────
    pub var min_width: float;    // 0.0 = unconstrained
    pub var max_width: float;    // 0.0 = unconstrained
    pub var min_height: float;
    pub var max_height: float;
    pub var grow: float;         // flex-grow factor (0.0 = fixed, 1.0 = fill)
    pub var shrink: float;       // flex-shrink factor
    pub var aspect_ratio: float; // 0.0 = no constraint; w/h ratio

    // ── Accessibility ─────────────────────────────────────────────────────
    pub var a11y_role: str;      // e.g. "button", "heading", "checkbox", "img", "link", "status"
    pub var a11y_label: str;     // screen-reader label (overrides text_val)
    pub var a11y_hint: str;      // additional description / usage hint
    pub var a11y_live: str;      // "" | "polite" | "assertive" (for dynamic regions)
    pub var tab_index: int;      // -1 = not focusable, 0 = natural order, >0 = explicit order
    pub var is_a11y_hidden: bool; // true = hidden from assistive tech

    pub init(k: int) {
        self.kind = k;
        self.text_val = "";
        self.on_click_action = nil;
        self.children = [] as [Widget];
        self.foreground_color = white;
        self.background_color = transparent;
        self.font_size_val = 14.0;
        self.font_weight_val = 400;
        self.padding_left = 0.0;
        self.padding_top = 0.0;
        self.padding_right = 0.0;
        self.padding_bottom = 0.0;
        self.corner_radius_val = 0.0;
        self.spacing_val = 0.0;
        self.is_vertical = 1;
        self.align_val = 0;
        self.flex_val = 1.0;
        self.is_enabled = 1;
        self.is_pressed = 0;
        self.is_hovered = 0;
        self.click_count = 0;
        self.width_val = 0.0;
        self.height_val = 0.0;
        self.pressed_style_val = _shared_empty_style;
        self.hover_style_val = _shared_empty_style;
        self.is_checked = 0;
        self.slider_val = 0.0;
        self.slider_min = 0.0;
        self.slider_max = 1.0;
        self.is_focused = 0;
        self.active_tab = 0;
        self.hovered_tab = -1;
        self.tab_titles = [] as [str];
        self.on_change_action = nil;
        self.select_options = [] as [str];
        self.selected_idx = 0;
        self.is_open = 0;
        self.opacity_val = 1.0;
        self.scale_val = 1.0;
        self.shadow_val = _shared_empty_shadow;
        self.lifecycle_state = 1;
        self.enter_transition = _shared_empty_trans;
        self.exit_transition = _shared_empty_trans;
        self.anim_property = _shared_empty_anim;
        self.active_transition = _shared_empty_trans;

        self.text_editor_state = nil;
        self.scroll_x = 0.0;
        self.scroll_y = 0.0;
        self.max_scroll_x = 0.0;
        self.max_scroll_y = 0.0;
        self.placeholder_val = "";
        self.focus_key = "";

        // Constraints
        self.min_width = 0.0;
        self.max_width = 0.0;
        self.min_height = 0.0;
        self.max_height = 0.0;
        self.grow = 0.0;
        self.shrink = 1.0;
        self.aspect_ratio = 0.0;

        // Accessibility
        self.a11y_role = "";
        self.a11y_label = "";
        self.a11y_hint = "";
        self.a11y_live = "";
        self.tab_index = 0;
        self.is_a11y_hidden = false;
    }

    pub fn color(c: Color): Widget {
        self.foreground_color = c;
        return self;
    }

    pub fn foreground(c: Color): Widget {
        self.foreground_color = c;
        return self;
    }

    pub fn background(c: Color): Widget {
        self.background_color = c;
        return self;
    }

    pub fn font_size(s: float): Widget {
        self.font_size_val = s;
        return self;
    }

    pub fn weight(w: int): Widget {
        self.font_weight_val = w;
        return self;
    }

    pub fn bold(): Widget {
        self.font_weight_val = 700;
        return self;
    }

    pub fn padding(p: float): Widget {
        self.padding_left = p;
        self.padding_top = p;
        self.padding_right = p;
        self.padding_bottom = p;
        return self;
    }

    pub fn padding_xy(x: float, y: float): Widget {
        self.padding_left = x;
        self.padding_top = y;
        self.padding_right = x;
        self.padding_bottom = y;
        return self;
    }

    pub fn padding_rect(l: float, t: float, r: float, b: float): Widget {
        self.padding_left = l;
        self.padding_top = t;
        self.padding_right = r;
        self.padding_bottom = b;
        return self;
    }

    pub fn corner_radius(r: float): Widget {
        self.corner_radius_val = r;
        return self;
    }

    pub fn spacing(s: float): Widget {
        self.spacing_val = s;
        return self;
    }

    pub fn align(a: Alignment): Widget {
        self.align_val = a.align_type;
        return self;
    }

    pub fn width(w: float): Widget {
        self.width_val = w;
        return self;
    }

    pub fn height(h: float): Widget {
        self.height_val = h;
        return self;
    }

    pub fn size(w: float, h: float): Widget {
        self.width_val = w;
        self.height_val = h;
        return self;
    }

    pub fn on_click(act: any): Widget {
        self.on_click_action = act;
        return self;
    }

    pub fn pressed(s: Style): Widget {
        self.pressed_style_val = s;
        return self;
    }

    pub fn style(s: Style): Widget {
        if (s.has_bg) {
            self.background_color = s.bg;
        }
        if (s.has_fg) {
            self.foreground_color = s.fg;
        }
        if (s.has_padding) {
            self.padding_left = s.pad_l;
            self.padding_top = s.pad_t;
            self.padding_right = s.pad_r;
            self.padding_bottom = s.pad_b;
        }
        if (s.has_radius) {
            self.corner_radius_val = s.radius;
        }
        if (s.has_font_size) {
            self.font_size_val = s.font_size_val;
        }
        if (s.has_weight) {
            self.font_weight_val = s.weight_val;
        }
        if (s.has_spacing) {
            self.spacing_val = s.spacing_val;
        }
        return self;
    }

    // ── Layout Constraint Modifiers ───────────────────────────────────────
    pub fn min_width(w: float): Widget { self.min_width = w; return self; }
    pub fn max_width(w: float): Widget { self.max_width = w; return self; }
    pub fn min_height(h: float): Widget { self.min_height = h; return self; }
    pub fn max_height(h: float): Widget { self.max_height = h; return self; }
    pub fn grow(factor: float): Widget { self.grow = factor; return self; }
    pub fn shrink(factor: float): Widget { self.shrink = factor; return self; }
    pub fn aspect_ratio(ratio: float): Widget { self.aspect_ratio = ratio; return self; }
    pub fn fill(): Widget { self.grow = 1.0; return self; }

    // ── Accessibility Modifiers ───────────────────────────────────────────
    pub fn role(r: str): Widget { self.a11y_role = r; return self; }
    pub fn aria_label(lbl: str): Widget { self.a11y_label = lbl; return self; }
    pub fn aria_hint(hint: str): Widget { self.a11y_hint = hint; return self; }
    pub fn aria_live(mode: str): Widget { self.a11y_live = mode; return self; }
    pub fn focusable(idx: int = 0): Widget { self.tab_index = idx; return self; }
    pub fn hidden_from_a11y(): Widget { self.is_a11y_hidden = true; return self; }

    // ── Retained Visual & Animation Modifiers ──────────────────────────────
    pub fn opacity(o: float): Widget { self.opacity_val = o; return self; }
    pub fn scale(s: float): Widget { self.scale_val = s; return self; }
    pub fn shadow(s: shadow_mod.Shadow): Widget { self.shadow_val = s; return self; }
    pub fn animate(dur: float = 0.25, easing: int = 0): Widget {
        self.anim_property = anim_mod.PropertyAnimation(0.0, 1.0, dur, easing);
        return self;
    }
    pub fn spring(stiffness: float = 180.0, damping: float = 12.0): Widget {
        self.anim_property.spring_model = anim_mod.Spring(stiffness, damping);
        self.anim_property.is_spring = true;
        return self;
    }
    pub fn transition(trans: anim_mod.Transition): Widget { self.active_transition = trans; return self; }
    pub fn on_change(cb: any): Widget { self.on_change_action = cb; return self; }
    pub fn checked(c: bool): Widget { if (c) { self.is_checked = 1; } else { self.is_checked = 0; } return self; }
    pub fn disabled(): Widget { self.is_enabled = 0; return self; }
    pub fn hover(s: Style): Widget { self.hover_style_val = s; return self; }
    pub fn enter(t: anim_mod.Transition): Widget {
        self.enter_transition = t;
        self.lifecycle_state = LIFECYCLE_ENTERING;
        return self;
    }
    pub fn exit(t: anim_mod.Transition): Widget {
        self.exit_transition = t;
        return self;
    }
    pub fn mark_for_removal(): nil {
        self.lifecycle_state = LIFECYCLE_EXITING;
    }
    pub fn background_color(c: Color): Widget {
        return self.background(c);
    }

    // ── Signal Binding Modifiers ───────────────────────────────────────────
    // Bind a signal to this widget's text property
    pub fn bind_text(sig: any): Widget {
        var s = sig as state_mod.Signal;
        if (s != nil) {
            s.subscribe(fn(new_val: any): nil {
                var txt = new_val as str;
                self.text_val = txt;
            });
        }
        return self;
    }

    // Bind a signal to this widget's checked property
    pub fn bind_checked(sig: any): Widget {
        var s = sig as state_mod.Signal;
        if (s != nil) {
            s.subscribe(fn(new_val: any): nil {
                var checked = new_val as bool;
                if (checked) {
                    self.is_checked = 1;
                } else {
                    self.is_checked = 0;
                }
            });
        }
        return self;
    }

    // Bind a signal to this widget's slider_val property
    pub fn bind_value(sig: any): Widget {
        var s = sig as state_mod.Signal;
        if (s != nil) {
            s.subscribe(fn(new_val: any): nil {
                var v = new_val as float;
                self.slider_val = v;
            });
        }
        return self;
    }

    // Bind a signal to this widget's enabled state
    pub fn bind_enabled(sig: any): Widget {
        var s = sig as state_mod.Signal;
        if (s != nil) {
            s.subscribe(fn(new_val: any): nil {
                var enabled = new_val as bool;
                if (enabled) {
                    self.is_enabled = 1;
                } else {
                    self.is_enabled = 0;
                }
            });
        }
        return self;
    }
}

// Semantic Widget Constructors
pub fn text(content: str): Widget {
    var w = Widget(KIND_TEXT);
    w.text_val = content;
    w.foreground_color = white;
    return w;
}

pub fn button(label: str, on_click: any = nil): Widget {
    var w = Widget(KIND_BUTTON);
    w.text_val = label;
    w.on_click_action = on_click;
    w.background_color = blue;
    w.foreground_color = white;
    w.padding_left = 10.0;
    w.padding_top = 8.0;
    w.padding_right = 10.0;
    w.padding_bottom = 8.0;
    w.corner_radius_val = 4.0;
    w.height_val = 36.0;
    return w;
}

pub fn textarea(content: str): Widget {
    var w = Widget(KIND_TEXTAREA);
    w.text_val = content;
    w.text_editor_state = text_ctrl.EditorController(content);
    w.focus_key = "ta_default";
    w.foreground_color = white;
    w.padding_left = 8.0;
    w.padding_top = 8.0;
    w.padding_right = 8.0;
    w.padding_bottom = 8.0;
    w.width_val = 300.0;
    w.height_val = 120.0;
    return w;
}

pub fn column(children: [Widget]): Widget {
    var w = Widget(KIND_CONTAINER);
    w.is_vertical = 1;
    w.children = children;
    return w;
}

pub fn row(children: [Widget]): Widget {
    var w = Widget(KIND_CONTAINER);
    w.is_vertical = 0;
    w.children = children;
    return w;
}

pub fn stack(children: [Widget]): Widget {
    var w = Widget(KIND_CONTAINER);
    w.is_vertical = 2;
    w.children = children;
    return w;
}

pub fn spacer(flex: float = 1.0): Widget {
    var w = Widget(KIND_SPACER);
    w.flex_val = flex;
    return w;
}

pub fn empty(): Widget {
    return Widget(KIND_CONTAINER);
}

// Legacy structures maintained for compatibility
frame ContainerData {
    pub var axis: Axis;
    pub var spacing: float;
    pub var padding: Rect;
    pub var background: Color;
}

pub fn container_data(axis: Axis): ContainerData {
    return ContainerData(
        axis=axis,
        spacing=0.0,
        padding=rect(0.0, 0.0, 0.0, 0.0),
        background=color_rgba(0.0, 0.0, 0.0, 0.0)
    );
}

frame TextData {
    pub var content: str;
    pub var font_size: float;
    pub var color: Color;
    pub var font_weight: int;
}

pub fn text_data(content: str): TextData {
    return TextData(content=content, font_size=14.0, color=color_rgb(1.0, 1.0, 1.0), font_weight=400);
}

frame ButtonData {
    pub var label: str;
    pub var background: Color;
    pub var text_color: Color;
    pub var corner_radius: float;
    pub var padding: Rect;
    pub var enabled: int;
}

pub fn button_data(label: str): ButtonData {
    return ButtonData(
        label=label,
        background=color_rgb8(60, 120, 210),
        text_color=color_rgb8(255, 255, 255),
        corner_radius=4.0,
        padding=rect(8.0, 4.0, 8.0, 4.0),
        enabled=1
    );
}

frame ImageData {
    pub var texture_id: int;
    pub var tint: Color;
    pub var fit_mode: int;
}

pub fn image_data(tex_id: int): ImageData {
    return ImageData(texture_id=tex_id, tint=color_rgb(1.0, 1.0, 1.0), fit_mode=0);
}

frame TextFieldData {
    pub var prompt_text: str;
    pub var text: str;
    pub var font_size: float;
    pub var background: Color;
    pub var corner_radius: float;
    pub var editable: int;
}

pub fn text_field_data(prompt_text: str): TextFieldData {
    return TextFieldData(
        prompt_text=prompt_text,
        text="",
        font_size=14.0,
        background=color_rgb8(40, 40, 40),
        corner_radius=4.0,
        editable=1
    );
}

frame ScrollData {
    pub var axis: Axis;
    pub var scrollbar_width: float;
    pub var scrollbar_color: Color;
}

pub fn scroll_data(axis: Axis): ScrollData {
    return ScrollData(axis=axis, scrollbar_width=8.0, scrollbar_color=color_rgb8(100, 100, 100));
}

frame CustomData {
    pub var type_id: int;
    pub var state_size: int;
    pub var render_callback: int;
}

pub fn custom_data(type_id: int, state_size: int): CustomData {
    return CustomData(type_id=type_id, state_size=state_size, render_callback=0);
}

frame LayoutConstraint {
    pub var mode: int;
    pub var value_num: int;
}

frame Blueprint {
    pub var variant_type: int; // 1 = Container, 2 = Text, 3 = Button
    pub var container_data_val: ContainerData;
    pub var text_data_val: TextData;
    pub var button_data_val: ButtonData;
    pub var constraints: [LayoutConstraint];
    pub var children: [Blueprint];
}

pub fn empty_constraints(): [LayoutConstraint] {
    var res: [LayoutConstraint] = [];
    return res;
}

pub fn empty_blueprints(): [Blueprint] {
    var res: [Blueprint] = [];
    return res;
}

pub fn blueprint_add_constraint(bp: Blueprint, c: LayoutConstraint): Blueprint {
    return Blueprint(variant_type=bp.variant_type, container_data_val=bp.container_data_val, text_data_val=bp.text_data_val, button_data_val=bp.button_data_val, constraints=bp.constraints + [c], children=bp.children);
}

pub fn blueprint_add_child(bp: Blueprint, child: Blueprint): Blueprint {
    return Blueprint(variant_type=bp.variant_type, container_data_val=bp.container_data_val, text_data_val=bp.text_data_val, button_data_val=bp.button_data_val, constraints=bp.constraints, children=bp.children + [child]);
}

// Extra widgets from std/ui.lm
pub fn select(options: [str], selected_idx: int = 0, on_change: any = nil): Widget {
    var w = Widget(KIND_SELECT);
    w.select_options = options;
    w.selected_idx = selected_idx;
    w.on_change_action = on_change;
    w.is_open = 0;
    w.background_color = rgb(28, 30, 38);
    w.foreground_color = white;
    w.height_val = 28.0;
    w.width_val = 180.0;
    w.padding_left = 10.0;
    w.padding_right = 10.0;
    w.corner_radius_val = 4.0;
    if (len(options) > selected_idx) {
        w.text_val = options[selected_idx];
    }
    return w;
}

pub fn link(text_val: str, url: str): Widget {
    var w = Widget(KIND_LINK);
    w.text_val = text_val;
    w.placeholder_val = url;
    w.foreground_color = rgb(100, 180, 255);
    w.height_val = 20.0;
    return w;
}

pub fn pie_chart(label: str, values: [float], labels: [str] = [] as [str]): Widget {
    var w = Widget(KIND_PIE_CHART);
    w.text_val = label;
    w.tab_titles = labels;
    w.height_val = 120.0;
    w.width_val = 120.0;
    w.background_color = rgb(24, 26, 34);
    w.text_editor_state = values;
    return w;
}

pub fn table(headers: [str], rows: [[Widget]]): Widget {
    var w = Widget(KIND_TABLE);
    w.tab_titles = headers;
    w.background_color = rgb(24, 26, 34);
    w.foreground_color = white;
    w.text_editor_state = rows;
    return w;
}

pub fn alert(message: str, type_val: str = "info"): Widget {
    var w = Widget(KIND_ALERT);
    w.text_val = message;
    w.placeholder_val = type_val;
    if (type_val == "error" or type_val == "danger") {
        w.background_color = rgb(80, 25, 30);
        w.foreground_color = rgb(255, 120, 130);
    } elif (type_val == "warning") {
        w.background_color = rgb(70, 55, 20);
        w.foreground_color = rgb(255, 210, 90);
    } elif (type_val == "success") {
        w.background_color = rgb(25, 65, 35);
        w.foreground_color = rgb(100, 230, 140);
    } else {
        w.background_color = rgb(30, 45, 70);
        w.foreground_color = rgb(120, 180, 255);
    }
    w.height_val = 36.0;
    return w;
}

pub fn color_rgb(r: float, g: float, b: float): Color {
    return Color(r=r, g=g, b=b, a=1.0);
}

pub fn accordion(title: str, content: Widget, default_open: bool = false): Widget {
    var w = Widget(KIND_ACCORDION);
    w.text_val = title;
    w.children = [content];
    if (default_open) w.is_open = 1; else w.is_open = 0;
    w.background_color = rgb(28, 30, 40);
    w.foreground_color = white;
    return w;
}

