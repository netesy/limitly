pub fn alert(message: str, type_val: str = "info"): Widget {
    return alert_k(message, alert_kind_of(type_val));
}

// Nominal form: the palette is chosen by an exhaustive match, never a ladder.
pub fn alert_k(message: str, kind: AlertKind): Widget {
    var w = Widget(KIND_ALERT);
    w.text_val = message;
    w.alert_kind = kind;
    w.placeholder_val = alert_kind_name(kind);
    match (kind) {
        AlertKind.Danger => {
            w.background_color = rgb(80, 25, 30);
            w.foreground_color = rgb(255, 120, 130);
        },
        AlertKind.Warning => {
            w.background_color = rgb(70, 55, 20);
            w.foreground_color = rgb(255, 210, 90);
        },
        AlertKind.Success => {
            w.background_color = rgb(25, 65, 35);
            w.foreground_color = rgb(100, 230, 140);
        },
        AlertKind.Info => {
            w.background_color = rgb(30, 45, 70);
            w.foreground_color = rgb(120, 180, 255);
        }
    }
    w.height_val = 36.0;
    return w;
}

pub fn accordion(title: str, content: Widget, default_open: bool = false): Widget {
    var w = Widget(KIND_ACCORDION);
    w.text_val = title;
    w.children = [content];
    if (default_open) w.is_open = 1; else w.is_open = 0;
    w.background_color = rgb(28, 30, 40);
    w.foreground_color = white;
    return w;
}

