// std/ui/replay.lm
// Replays a DrawList to the GPU.
// Pure linear iteration — zero recursion, zero tree traversal.
// This is the final GPU submission stage of the hybrid pipeline.

import std.gg as gg;
import std.ui.draw_list as dl;

// Replays a DrawList to the GPU — pure linear iteration, zero recursion.
pub fn replay(draw_list: dl.DrawList): nil {
    var i = 0;
    var n = len(draw_list.cmds);
    while (i < n) {
        var cmd = draw_list.cmds[i];
        // Enum-valued dispatch via `match` (tag compare lowered over the DrawCmdKind
        // variants). Qualified arms on an imported enum resolve against the scrutinee's
        // own enum type, so no `==` fallback is needed here.
        match (cmd.kind) {
            dl.DrawCmdKind.Rect => {
                gg.draw_rect_primitive(cmd.x, cmd.y, cmd.w, cmd.h, cmd.r, cmd.g, cmd.b, cmd.a);
            },
            dl.DrawCmdKind.RectRounded => {
                if (cmd.border_width > 0.0) {
                    gg.draw_rect_border_primitive(cmd.x, cmd.y, cmd.w, cmd.h, cmd.radius, cmd.border_width, cmd.r, cmd.g, cmd.b, cmd.a);
                } else {
                    gg.draw_rect_rounded_primitive(cmd.x, cmd.y, cmd.w, cmd.h, cmd.radius, cmd.r, cmd.g, cmd.b, cmd.a);
                }
            },
            dl.DrawCmdKind.Text => {
                var scale_i: int = 1;
                if (cmd.font_scale >= 1.5) { scale_i = 2; }
                gg.draw_text(cmd.text, cmd.x, cmd.y, cmd.r, cmd.g, cmd.b, cmd.a, scale_i);
            },
            dl.DrawCmdKind.Line => {
                gg.draw_line_primitive(cmd.x, cmd.y, cmd.x2, cmd.y2, cmd.r, cmd.g, cmd.b, cmd.a, 1.5);
            },
            dl.DrawCmdKind.Triangle => {
                gg.draw_triangle_primitive(cmd.x, cmd.y, cmd.x2, cmd.y2, cmd.x3, cmd.y3, cmd.r, cmd.g, cmd.b, cmd.a);
            },
            dl.DrawCmdKind.ClipPush => {
                gg.push_clip(cmd.x, cmd.y, cmd.w, cmd.h);
            },
            dl.DrawCmdKind.ClipPop => {
                gg.pop_clip();
            },
            _ => { }
        }
        i = i + 1;
    }
}
