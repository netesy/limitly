// std/ui/padding - Add spacing around child widget
import std.ui.components as comp;

pub fn padding(child: comp.Fluent, pad: float): comp.Container {
    val w = comp.column([child]);
    w.set_padding(pad);
    return w;
}

pub fn padding_xy(child: comp.Fluent, x: float, y: float): comp.Container {
    val w = comp.column([child]);
    w.pad_l = x;
    w.pad_t = y;
    w.pad_r = x;
    w.pad_b = y;
    return w;
}
