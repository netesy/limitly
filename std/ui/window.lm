// std/ui/window.lm
import std.ui.components as comp;

frame Window {
    pub var title: str;
    pub var width: float;
    pub var height: float;
    pub var root: comp.Fluent;

    pub init(t: str = "Window", w: float = 800.0, h: float = 600.0) {
        self.title = t;
        self.width = w;
        self.height = h;
        self.root = comp.empty();
    }

    pub fn set_root(w: comp.Fluent): Window {
        self.root = w;
        return self;
    }
}
