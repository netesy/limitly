// std/ui/window.lm
// Window submodule for std.ui. User interface widgets, layout engines, styling, and application framework.

import std.ui.widget as widget;
import std.ui.types as ui_types;

frame Window {
    pub var title: str;
    pub var width: float;
    pub var height: float;
    pub var root: ui_types.Widget;
    pub var root_blueprint: ui_types.Blueprint;

    pub init(t: str = "Window", w: float = 800.0, h: float = 600.0) {
        self.title = t;
        self.width = w;
        self.height = h;
        self.root = ui_types.empty();
        self.root_blueprint = ui_types.blueprint_container();
    }

    pub fn set_root(w: ui_types.Widget): Window {
        self.root = w;
        return self;
    }
}
