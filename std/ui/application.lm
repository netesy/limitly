import std.ui.types as ui_types;
import std.app as app;

frame Application {
    pub var name: str;
    pub var root_widget: ui_types.Widget;

    pub init(n: str = "LymarApp") {
        self.name = n;
        self.root_widget = ui_types.empty();
    }

    pub fn set_root(widget: ui_types.Widget): nil {
        self.root_widget = widget;
    }

    pub fn run(): nil {
        var cfg = app.default_window_config();
        cfg.title = self.name;
        app.init(cfg);
        app.set_ui(self.root_widget);
        app.run();
        app.shutdown();
    }
}
