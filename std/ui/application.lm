// std/ui/application.lm
import std.ui.components as comp;
import std.app as app;

frame Application {
    pub var name: str;
    pub var root_widget: comp.Fluent;

    pub init(n: str = "LymarApp") {
        self.name = n;
        self.root_widget = comp.empty();
    }

    pub fn set_root(widget: comp.Fluent): nil {
        self.root_widget = widget;
    }

    pub fn run(): nil {
        val cfg = app.default_window_config();
        cfg.title = self.name;
        app.init(cfg);
        app.ui(self.root_widget);
        app.run();
        app.shutdown();
    }
}
