import std.ui.window as window;
import std.app as app;

frame Application {
    pub var name: str;
    pub var windows: [window.Window];

    pub init(n: str = "LimitApp") {
        self.name = n;
        self.windows = [window.Window()];
    }

    pub fn run(): nil {
        var cfg = app.default_window_config();
        cfg.title = self.name;
        app.app_init(cfg);
        app.app_run();
    }
}
