// std/ui/list_view - List widget with virtual scrolling support
import std.ui.types as ui_types;
import std.ui.components as comp;

frame VirtualListState {
    pub var scroll_offset: int;
    pub var visible_count: int;
    pub var item_height: float;
    pub var total_items: int;

    pub init(height: float = 24.0, visible: int = 10) {
        self.scroll_offset = 0;
        self.visible_count = visible;
        self.item_height = height;
        self.total_items = 0;
    }
}

pub fn list_view(items: [comp.Fluent]): comp.Container {
    val c = comp.container_of(ui_types.WidgetKind.List, true);
    iter (it in items) { c.add(it); }
    return c;
}

pub fn virtual_list(items: [comp.Fluent], item_height: float = 24.0, max_visible: int = 10): comp.ScrollView {
    val inner = list_view(items);
    val sv = comp.ScrollView(inner, (max_visible as float) * item_height);
    sv.max_scroll_y = ((len(items) as float) * item_height) - ((max_visible as float) * item_height);
    return sv;
}

pub fn get_visible_range(state: VirtualListState, viewport_height: float): (int, int) {
    val start_idx = (state.scroll_offset / (state.item_height as int));
    val visible_count = ((viewport_height / state.item_height) as int) + 1;
    var end_idx = start_idx + visible_count;
    if (end_idx > state.total_items) {
        end_idx = state.total_items;
    }
    return (start_idx, end_idx);
}

pub fn render_virtual_list(items: [comp.Fluent], state: VirtualListState, viewport_height: float): [comp.Fluent] {
    val visible: [comp.Fluent] = [];
    val range = get_visible_range(state, viewport_height);
    var i = range.0;
    while (i < range.1) {
        if (i >= 0 and i < len(items)) {
            visible.append(items[i]);
        }
        i = i + 1;
    }
    return visible;
}
