// std/ui/event.lm
// Type-Safe Event Handling for Lymar UI
//
// Nominal enums and exhaustive match dispatch for widget-level event
// results. The component tree (std.ui.component/tree) dispatches typed
// std.events.Event values directly through the Component.on_event contract.

enum EventKind {
    Click,
    Press,
    Release,
    Hover,
    PointerMove,
    Scroll,
    KeyDown,
    KeyUp,
    Focus,
    Blur
}

enum EventResult {
    Handled,
    Unhandled,
    Ignored
}
