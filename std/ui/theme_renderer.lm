// std/ui/theme_renderer - Theme-aware color helpers
import std.ui.components as comp;
import std.ui.types as ui_types;
import std.ui.theme show Theme, ColorPalette;
import std.color as color;

// Get button background color based on state
pub fn get_button_bg_color(w: comp.Button, theme: Theme): color.Color {
    val colors: ColorPalette = theme.colors;
    var bg = w.bg;
    if (bg.a <= 0.0) {
        bg = colors.primary;
    }
    if (w.is_pressed) {
        val ps_opt = w.pressed_style_val;
        if (ps_opt != nil) {
            val ps = ps_opt as ui_types.Style;
            if (ps.has_bg) {
                return ps.bg;
            }
        }
        return color.rgba(bg.r * 0.7, bg.g * 0.7, bg.b * 0.7, bg.a);
    } elif (w.is_hovered) {
        val hs_opt = w.hover_style_val;
        if (hs_opt != nil) {
            val hs = hs_opt as ui_types.Style;
            if (hs.has_bg) {
                return hs.bg;
            }
        }
        return color.rgb(150, 200, 255);
    }
    return bg;
}

// Get input border color based on state and focus
pub fn get_input_border_color(w: comp.TextInput, has_focus: bool, theme: Theme): color.Color {
    val colors: ColorPalette = theme.colors;
    if (has_focus or w.is_focused) {
        return colors.focus_ring;
    } elif (w.is_hovered) {
        return colors.border;
    }
    return color.rgb(55, 60, 75);
}
