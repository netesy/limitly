// std/ui/context.lm
// Unified Retained UI Context Module
// Routes layout/rendering directly through `builder.build_into` + `replay.replay`
// over a pooled `DrawList` and dispatches input linearly via `HitZone`s and `event.fire_action`.

import std.ui.types as ui_types;
import std.ui.components as comp;
import std.ui.event as event;
import std.ui.viewport as viewport;
import std.ui.state as state;
import std.ui.builder as builder;
import std.ui.draw_list as dlist;
import std.ui.replay as replay;
import std.focus.manager as focus;
import std.math as math;

frame UIContextState {
    pub var is_initialized: int;
    pub var next_element_id: int;
    pub var root_element: int;
    pub var dirty: int;
    pub var current_widget: comp.Fluent;
    pub var focus_manager: focus.Manager;
    pub var focused_widget: comp.Fluent | nil;
    pub var modifiers: int;
    pub var get_clipboard_cb: (fn(): str) | nil;
    pub var set_clipboard_cb: (fn(str): nil) | nil;
    pub var has_widget: int;
    pub var viewport_w: float;
    pub var viewport_h: float;
    pub var captured_widget: comp.Fluent;
    pub var has_captured: int;
    pub var captured_bounds_x: float;
    pub var captured_bounds_y: float;
    pub var captured_bounds_w: float;
    pub var captured_bounds_h: float;
    pub var last_pointer_x: float;
    pub var last_pointer_y: float;
    pub var is_pointer_down: int;
    pub var active_overlays: [comp.Fluent];
    pub var cached_draw_list: dlist.DrawList;
}

pub var global_ui_context: UIContextState = UIContextState(
    is_initialized=0,
    next_element_id=1,
    root_element=0,
    dirty=1,
    current_widget=comp.empty(),
    focused_widget=nil,
    get_clipboard_cb=nil,
    set_clipboard_cb=nil,
    has_widget=0,
    viewport_w=800.0,
    viewport_h=600.0,
    captured_widget=comp.empty(),
    has_captured=0,
    captured_bounds_x=0.0,
    captured_bounds_y=0.0,
    captured_bounds_w=0.0,
    captured_bounds_h=0.0,
    last_pointer_x=0.0,
    last_pointer_y=0.0,
    is_pointer_down=0,
    active_overlays=[] as [comp.Fluent],
    cached_draw_list=dlist.draw_list()
);

pub fn push_overlay(w: comp.Fluent): nil {
    global_ui_context.active_overlays.append(w);
    mark_element_dirty(1);
}

pub fn clear_overlays(): nil {
    global_ui_context.active_overlays = [] as [comp.Fluent];
    mark_element_dirty(1);
}

pub fn ui_init(): int {
    if (global_ui_context.is_initialized != 0) {
        return 0;
    }
    global_ui_context.is_initialized = 1;
    global_ui_context.next_element_id = 1;
    global_ui_context.root_element = 1;
    global_ui_context.dirty = 1;
    state.register_dirty_notifier(_signal_dirty_cb);
    return 1;
}

fn _signal_dirty_cb(): nil {
    global_ui_context.dirty = 1;
}

pub fn mark_element_dirty(element_id: int): nil {
    global_ui_context.dirty = 1;
}

pub fn set_viewport_size(w: float, h: float): nil {
    if (w > 0.0 and h > 0.0) {
        if (global_ui_context.viewport_w != w or global_ui_context.viewport_h != h) {
            global_ui_context.viewport_w = w;
            global_ui_context.viewport_h = h;
            viewport.global_viewport.width = w;
            viewport.global_viewport.height = h;
            global_ui_context.dirty = 1;
        }
    }
}

pub fn get_viewport_width(): float {
    return global_ui_context.viewport_w;
}

pub fn get_viewport_height(): float {
    return global_ui_context.viewport_h;
}

pub fn set_root(w: comp.Fluent): nil {
    global_ui_context.current_widget = w;
    global_ui_context.has_widget = 1;
    global_ui_context.dirty = 1;
    global_ui_context.cached_draw_list.clear();
}

// ── UTF-8 Helpers ─────────────────────────────────────────────────────────────
pub fn codepoint_to_utf8(cp: int): str {
    if (cp <= 0 or cp > 1114111 or (cp >= 55296 and cp <= 57343)) {
        return "";
    }
    if (cp < 128) {
        return _builtin_string_from_bytes([cp]);
    }
    if (cp <= 2047) {
        val b1 = 192 | ((cp >> 6) & 31);
        val b2 = 128 | (cp & 63);
        return _builtin_string_from_bytes([b1, b2]);
    }
    if (cp <= 65535) {
        val b1 = 224 | ((cp >> 12) & 15);
        val b2 = 128 | ((cp >> 6) & 63);
        val b3 = 128 | (cp & 63);
        return _builtin_string_from_bytes([b1, b2, b3]);
    }
    val b1 = 240 | ((cp >> 18) & 7);
    val b2 = 128 | ((cp >> 12) & 63);
    val b3 = 128 | ((cp >> 6) & 63);
    val b4 = 128 | (cp & 63);
    return _builtin_string_from_bytes([b1, b2, b3, b4]);
}

pub fn utf8_pop_back(s: str): str {
    val l = len(s);
    if (l <= 0) {
        return "";
    }
    var cut = l - 1;
    while (cut > 0 and (_builtin_string_byte_at(s, cut) & 192) == 128) {
        cut = cut - 1;
    }
    if (cut <= 0) {
        return "";
    }
    return _builtin_substring(s, 0, cut);
}

// ── Pooled DrawList Synchronization ──────────────────────────────────────────
fn _ensure_draw_list(): nil {
    if (global_ui_context.has_widget == 0) {
        return;
    }
    if (global_ui_context.cached_draw_list.is_valid == 0 or global_ui_context.dirty != 0) {
        val content_w = global_ui_context.viewport_w - 40.0;
        val content_h = global_ui_context.viewport_h - 40.0;
        builder.build_into(
            global_ui_context.cached_draw_list,
            global_ui_context.current_widget,
            content_w,
            content_h,
            nil,
            20.0,
            20.0
        );
    }
}

fn _blur_active_focus(): nil {
    val fw_opt = global_ui_context.focused_widget;
    if (fw_opt != nil) {
        val fw = fw_opt as comp.Fluent;
        val k = fw.widget_kind();
        if (k == ui_types.WidgetKind.Input or k == ui_types.WidgetKind.Textarea) {
            val ti = fw as comp.TextInput;
            ti.blur();
            if (len(ti.focus_key_val) > 0) {
                global_ui_context.focus_manager.clear_focus();
            }
        }
        global_ui_context.focused_widget = nil;
    }
}

fn _capture_zone(hz: dlist.HitZone, w: comp.Fluent): nil {
    global_ui_context.captured_widget = w;
    global_ui_context.has_captured = 1;
    global_ui_context.captured_bounds_x = hz.x;
    global_ui_context.captured_bounds_y = hz.y;
    global_ui_context.captured_bounds_w = hz.w;
    global_ui_context.captured_bounds_h = hz.h;
}

// ── Event Dispatch (O(n) Linear HitZone Lookup) ───────────────────────────────
pub fn dispatch_pointer_down(px: float, py: float): nil {
    global_ui_context.is_pointer_down = 1;
    global_ui_context.last_pointer_x = px;
    global_ui_context.last_pointer_y = py;

    if (global_ui_context.has_widget == 0) {
        return;
    }

    _ensure_draw_list();
    val hz = dlist.dl_hit_test(global_ui_context.cached_draw_list, px, py);
    _blur_active_focus();

    if (hz.widget == nil) {
        if (hz.on_click != nil) {
            event.fire_action(hz.on_click)? else { };
        }
        global_ui_context.dirty = 1;
        return;
    }

    val w = hz.widget as comp.Fluent;
    match (hz.kind) {
        dlist.HitZoneKind.Button => {
            _capture_zone(hz, w);
            val k = w.widget_kind();
            if (k == ui_types.WidgetKind.Button) {
                val btn = w as comp.Button;
                btn.is_pressed = true;
                if (len(btn.focus_key_val) > 0) {
                    global_ui_context.focus_manager.request_focus(btn.focus_key_val);
                }
            } elif (k == ui_types.WidgetKind.Accordion) {
                val acc = w as comp.Accordion;
                acc.is_open = not acc.is_open;
                acc.click()? else { };
            } elif (k == ui_types.WidgetKind.Link) {
                val lnk = w as comp.Link;
                lnk.click()? else { };
            } else {
                event.fire_action(hz.on_click)? else { };
            }
            global_ui_context.dirty = 1;
        },
        dlist.HitZoneKind.Slider => {
            _capture_zone(hz, w);
            val sld = w as comp.Slider;
            if (hz.w > 0.0) {
                val frac = math.clamp((px - hz.x) / hz.w, 0.0, 1.0);
                val new_v = hz.slider_min + frac * (hz.slider_max - hz.slider_min);
                sld.set_value(new_v);
            }
            global_ui_context.dirty = 1;
        },
        dlist.HitZoneKind.Checkbox => {
            _capture_zone(hz, w);
            val cb = w as comp.Checkbox;
            cb.toggle()? else { };
            global_ui_context.dirty = 1;
        },
        dlist.HitZoneKind.Toggle => {
            _capture_zone(hz, w);
            val tg = w as comp.Toggle;
            tg.toggle()? else { };
            global_ui_context.dirty = 1;
        },
        dlist.HitZoneKind.Input => {
            _capture_zone(hz, w);
            val ti = w as comp.TextInput;
            ti.focus();
            ti.cursor_pos = len(ti.text);
            global_ui_context.focused_widget = ti as comp.Fluent;
            if (len(ti.focus_key_val) > 0) {
                global_ui_context.focus_manager.request_focus(ti.focus_key_val);
            }
            global_ui_context.dirty = 1;
        },
        dlist.HitZoneKind.Tab => {
            _capture_zone(hz, w);
            val tb = w as comp.Tabs;
            tb.active_tab = hz.tab_index;
            tb.notify_change()? else { };
            global_ui_context.dirty = 1;
        },
        dlist.HitZoneKind.Select => {
            _capture_zone(hz, w);
            val sel = w as comp.Select;
            if (hz.tab_index == -1) {
                sel.is_open = not sel.is_open;
            } else {
                sel.selected_idx = hz.tab_index;
                sel.is_open = false;
                sel.notify_change()? else { };
            }
            global_ui_context.dirty = 1;
        },
        dlist.HitZoneKind.TreeNode => {
            _capture_zone(hz, w);
            val tn = w as comp.TreeNode;
            tn.is_open = not tn.is_open;
            tn.click()? else { };
            global_ui_context.dirty = 1;
        },
        _ => {
            if (hz.on_click != nil) {
                event.fire_action(hz.on_click)? else { };
                global_ui_context.dirty = 1;
            }
        }
    }
}

pub fn dispatch_pointer_click(px: float, py: float): nil {
    dispatch_pointer_down(px, py);
}

pub fn dispatch_pointer_move(px: float, py: float): nil {
    global_ui_context.last_pointer_x = px;
    global_ui_context.last_pointer_y = py;

    if (global_ui_context.has_widget == 0) {
        return;
    }

    if (global_ui_context.is_pointer_down != 0 and global_ui_context.has_captured != 0) {
        val cap = global_ui_context.captured_widget;
        val cap_kind = cap.widget_kind();
        if (cap_kind == ui_types.WidgetKind.Slider and global_ui_context.captured_bounds_w > 0.0) {
            val sld = cap as comp.Slider;
            val frac = math.clamp((px - global_ui_context.captured_bounds_x) / global_ui_context.captured_bounds_w, 0.0, 1.0);
            sld.set_value(sld.min_val + frac * (sld.max_val - sld.min_val));
            global_ui_context.dirty = 1;
            return;
        }
        if (cap_kind == ui_types.WidgetKind.Button) {
            val btn = cap as comp.Button;
            val inside = (px >= global_ui_context.captured_bounds_x and px <= global_ui_context.captured_bounds_x + global_ui_context.captured_bounds_w and py >= global_ui_context.captured_bounds_y and py <= global_ui_context.captured_bounds_y + global_ui_context.captured_bounds_h);
            if (btn.is_pressed != inside) {
                btn.is_pressed = inside;
                global_ui_context.dirty = 1;
            }
        }
    }

    _ensure_draw_list();
    val top = dlist.dl_hit_test(global_ui_context.cached_draw_list, px, py);
    val nh = global_ui_context.cached_draw_list.hit_count;
    if (nh > 0) {
        iter (i in 0..nh) {
            val hz = global_ui_context.cached_draw_list.hits[i];
            if (hz.widget != nil) {
                val w = hz.widget as comp.Fluent;
                if (w.widget_kind() == ui_types.WidgetKind.Button) {
                    val btn = w as comp.Button;
                    val hovered = (px >= hz.x and px <= hz.x + hz.w and py >= hz.y and py <= hz.y + hz.h);
                    if (btn.is_hovered != hovered) {
                        btn.is_hovered = hovered;
                        global_ui_context.dirty = 1;
                    }
                }
            }
        }
    }
}

pub fn dispatch_pointer_up(px: float, py: float): nil {
    global_ui_context.is_pointer_down = 0;
    global_ui_context.last_pointer_x = px;
    global_ui_context.last_pointer_y = py;

    if (global_ui_context.has_captured != 0) {
        val cap = global_ui_context.captured_widget;
        if (cap.widget_kind() == ui_types.WidgetKind.Button) {
            val btn = cap as comp.Button;
            val inside = (px >= global_ui_context.captured_bounds_x and px <= global_ui_context.captured_bounds_x + global_ui_context.captured_bounds_w and py >= global_ui_context.captured_bounds_y and py <= global_ui_context.captured_bounds_y + global_ui_context.captured_bounds_h);
            if (inside) {
                btn.click()? else { };
            }
            btn.is_pressed = false;
        }
        global_ui_context.has_captured = 0;
        global_ui_context.captured_widget = comp.empty();
        global_ui_context.dirty = 1;
    }

    val nh = global_ui_context.cached_draw_list.hit_count;
    if (nh > 0) {
        iter (i in 0..nh) {
            val hz = global_ui_context.cached_draw_list.hits[i];
            if (hz.widget != nil) {
                val w = hz.widget as comp.Fluent;
                if (w.widget_kind() == ui_types.WidgetKind.Button) {
                    (w as comp.Button).is_pressed = false;
                }
            }
        }
    }
}

pub fn dispatch_char_input(cp: int): nil {
    val fw_opt = global_ui_context.focused_widget;
    if (fw_opt == nil) {
        return;
    }
    val fw = fw_opt as comp.Fluent;
    val k = fw.widget_kind();
    if (k == ui_types.WidgetKind.Input or k == ui_types.WidgetKind.Textarea) {
        val ti = fw as comp.TextInput;
        val ch = codepoint_to_utf8(cp);
        if (len(ch) > 0) {
            ti.set_text(ti.text + ch);
            ti.cursor_pos = len(ti.text);
            global_ui_context.dirty = 1;
        }
    }
}

pub fn dispatch_key_down(key_code: int, mods: int = 0): nil {
    global_ui_context.modifiers = mods;
    val fw_opt = global_ui_context.focused_widget;
    if (fw_opt == nil) {
        return;
    }
    val fw = fw_opt as comp.Fluent;
    val k = fw.widget_kind();
    if (k == ui_types.WidgetKind.Input or k == ui_types.WidgetKind.Textarea) {
        val ti = fw as comp.TextInput;
        if (key_code == 8 or key_code == 127) {
            ti.set_text(utf8_pop_back(ti.text));
            ti.cursor_pos = len(ti.text);
            global_ui_context.dirty = 1;
        } elif ((key_code == 13 or key_code == 10) and k == ui_types.WidgetKind.Textarea) {
            ti.set_text(ti.text + "\n");
            ti.cursor_pos = len(ti.text);
            global_ui_context.dirty = 1;
        }
    }
}

fn _scroll_widget_tree(w: comp.Fluent, delta: float): bool {
    match (w.widget_kind()) {
        ui_types.WidgetKind.Scroll => {
            val sv = w as comp.ScrollView;
            sv.scroll_y = math.clamp(sv.scroll_y - delta * 24.0, 0.0, sv.max_scroll_y);
            global_ui_context.dirty = 1;
            return true;
        },
        ui_types.WidgetKind.Container => {
            val c = w as comp.Container;
            iter (ch in c.children) {
                if (_scroll_widget_tree(ch, delta)) { return true; }
            }
        },
        ui_types.WidgetKind.Tabs => {
            val tb = w as comp.Tabs;
            if (tb.active_tab >= 0 and tb.active_tab < len(tb.children)) {
                if (_scroll_widget_tree(tb.children[tb.active_tab], delta)) { return true; }
            }
        },
        ui_types.WidgetKind.Card => {
            val cd = w as comp.Card;
            iter (ch in cd.children) {
                if (_scroll_widget_tree(ch, delta)) { return true; }
            }
        },
        _ => { }
    }
    return false;
}

pub fn dispatch_mouse_wheel(delta: float): nil {
    if (global_ui_context.has_widget != 0) {
        _scroll_widget_tree(global_ui_context.current_widget, delta);
    }
}

// ── Frame Update & Replay ─────────────────────────────────────────────────────
pub fn frame_update(delta_time: float): nil {
    if (global_ui_context.has_widget == 0) {
        return;
    }
    _ensure_draw_list();
    replay.replay(global_ui_context.cached_draw_list);
    global_ui_context.dirty = 0;
}
