// std/env/index.lm
// Public facade for std.env: environment variables only.
//
// No implementation lives here. Program arguments are std.process.args(); the
// working directory is std.os.cwd(); the raw getenv/setenv surface is std.os.
// This module exists as the conventional `KEY=VALUE` variable API and as the
// frame-style accessor used by std.config.

pub import std.env.variables show Env, get, get_or, set, unset, vars;
