// std/env/index.lm
// Public facade for std.env: environment variables.

/// Process environment variables, typed values, dictionary views, and .env configuration.
///
/// Provides access to ambient process configuration, integer/boolean parsing,
/// and `.env` format loading.
///
/// @example
/// import std.env as env;
/// var port = env.get_int("PORT", 8080);
/// var is_prod = env.get_bool("PRODUCTION", false);
/// print("Listening on port {port}");

pub import std.env.variables show Env, get, get_or, get_int, get_bool, has, contains, set, unset, vars, to_dict, keys, values, parse_env, load_dotenv, load_file;
