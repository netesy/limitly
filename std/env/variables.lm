// std/env/variables.lm
// Process environment variables, parsing, and .env file configuration.

import std.os as os;
import std.io as io;

/// Retrieves the string value of an environment variable, returning nil if unset.
///
/// @pre len(key) > 0
/// @param key Environment variable name.
/// @return Fallible string value or nil.
pub fn get(key: str): str? {
    contract(len(key) > 0, "Environment variable key must not be empty");
    return os.getenv(key);
}

/// Retrieves an environment variable or returns a fallback string if absent.
///
/// @pre len(key) > 0
/// @param key Environment variable name.
/// @param fallback Default string value.
/// @return Variable value or fallback.
pub fn get_or(key: str, fallback: str): str {
    contract(len(key) > 0, "Environment variable key must not be empty");
    return os.getenv_or(key, fallback);
}

/// Checks whether an environment variable exists.
///
/// @pre len(key) > 0
/// @param key Environment variable name.
/// @return True if key is defined in the environment.
pub fn has(key: str): bool {
    contract(len(key) > 0, "Environment variable key must not be empty");
    var val_opt = os.getenv(key);
    return val_opt != nil;
}

/// Alias for `has()`.
///
/// @pre len(key) > 0
/// @param key Environment variable name.
/// @return True if key is defined.
pub fn contains(key: str): bool {
    contract(len(key) > 0, "Environment variable key must not be empty");
    return has(key);
}

/// Parses an environment variable as an integer, falling back to a default if absent or invalid.
///
/// @pre len(key) > 0
/// @param key Environment variable name.
/// @param fallback Default integer value.
/// @return Parsed integer or fallback.
pub fn get_int(key: str, fallback: int = 0): int {
    contract(len(key) > 0, "Environment variable key must not be empty");
    var raw = get_or(key, "");
    if (raw == "") return fallback;
    var i = 0;
    if (len(raw) > 0 and _builtin_substring(raw, 0, 1) == "-") {
        i = 1;
    }
    if (i >= len(raw)) return fallback;
    while (i < len(raw)) {
        var ch = _builtin_substring(raw, i, i + 1);
        if (ch < "0" or ch > "9") return fallback;
        i = i + 1;
    }
    return raw as int;
}

/// Parses a boolean environment variable ("1", "true", "yes", "on" vs "0", "false", "no", "off").
///
/// @pre len(key) > 0
/// @param key Environment variable name.
/// @param fallback Default boolean value.
/// @return Parsed boolean or fallback.
pub fn get_bool(key: str, fallback: bool = false): bool {
    contract(len(key) > 0, "Environment variable key must not be empty");
    var raw = get_or(key, "");
    if (raw == "") return fallback;
    var lower = _builtin_string_to_lower(raw);
    if (lower == "1" or lower == "true" or lower == "yes" or lower == "on") {
        return true;
    }
    if (lower == "0" or lower == "false" or lower == "no" or lower == "off") {
        return false;
    }
    return fallback;
}

/// Sets or updates an environment variable for the process.
///
/// @pre len(key) > 0
/// @param key Environment variable name.
/// @param value Target value string.
/// @return True if successfully set.
pub fn set(key: str, value: str): bool {
    contract(len(key) > 0, "Environment variable key must not be empty");
    return os.setenv(key, value);
}

/// Deletes an environment variable from the process environment.
///
/// @pre len(key) > 0
/// @param key Environment variable name.
/// @return True if successfully removed.
pub fn unset(key: str): bool {
    contract(len(key) > 0, "Environment variable key must not be empty");
    return os.unsetenv(key);
}

/// Returns all environment variables formatted as a list of "KEY=VALUE" strings.
///
/// @return List of raw environment entries.
pub fn vars(): [str] {
    return os.env_vars();
}

/// Parses all environment variables into a dictionary mapping {KEY: VALUE}.
///
/// @return Dictionary of environment variables.
pub fn to_dict(): {str: str} {
    var all = vars();
    var dict: {str: str} = {};
    var i = 0;
    while (i < len(all)) {
        var entry = all[i];
        var eq_idx = find_char(entry, "=");
        if (eq_idx > 0) {
            var k = _builtin_substring(entry, 0, eq_idx);
            var v = _builtin_substring(entry, eq_idx + 1, len(entry));
            dict[k] = v;
        }
        i = i + 1;
    }
    return dict;
}

/// Returns a list of all environment variable names.
///
/// @return List of variable key strings.
pub fn keys(): [str] {
    var all = vars();
    var result: [str] = [];
    var i = 0;
    while (i < len(all)) {
        var entry = all[i];
        var eq_idx = find_char(entry, "=");
        if (eq_idx > 0) {
            result.append(_builtin_substring(entry, 0, eq_idx));
        }
        i = i + 1;
    }
    return result;
}

/// Returns a list of all environment variable values.
///
/// @return List of variable value strings.
pub fn values(): [str] {
    var all = vars();
    var result: [str] = [];
    var i = 0;
    while (i < len(all)) {
        var entry = all[i];
        var eq_idx = find_char(entry, "=");
        if (eq_idx >= 0) {
            result.append(_builtin_substring(entry, eq_idx + 1, len(entry)));
        }
        i = i + 1;
    }
    return result;
}

/// Parses a `.env` file content string into a key-value dictionary.
///
/// @param content Raw .env text content.
/// @return Dictionary of parsed configuration variables.
pub fn parse_env(content: str): {str: str} {
    var result: {str: str} = {};
    var lines: [str] = [];
    var curr = "";
    var i = 0;
    while (i < len(content)) {
        var ch = _builtin_substring(content, i, i + 1);
        if (ch == "\n") {
            lines.append(curr);
            curr = "";
        } else {
            if (ch != "\r") {
                curr = curr + ch;
            }
        }
        i = i + 1;
    }
    if (len(curr) > 0) lines.append(curr);

    var idx = 0;
    while (idx < len(lines)) {
        var line = _builtin_string_trim(lines[idx]);
        if (len(line) > 0 and _builtin_substring(line, 0, 1) != "#") {
            var eq = find_char(line, "=");
            if (eq > 0) {
                var k = _builtin_string_trim(_builtin_substring(line, 0, eq));
                var v = _builtin_string_trim(_builtin_substring(line, eq + 1, len(line)));
                if (len(v) >= 2) {
                    var q1 = _builtin_substring(v, 0, 1);
                    var q2 = _builtin_substring(v, len(v) - 1, len(v));
                    if ((q1 == "\"" and q2 == "\"") or (q1 == "'" and q2 == "'")) {
                        v = _builtin_substring(v, 1, len(v) - 1);
                    }
                }
                if (len(k) > 0) {
                    result[k] = v;
                }
            }
        }
        idx = idx + 1;
    }
    return result;
}

/// Parses `.env` content and injects variables into the current process environment.
///
/// @param content Raw .env file content.
/// @return Number of variables successfully set.
pub fn load_dotenv(content: str): int {
    var parsed = parse_env(content);
    var count = 0;
    iter (k, v in parsed) {
        if (set(k, v)) {
            count = count + 1;
        }
    }
    return count;
}

/// Reads a `.env` file from disk and loads its variables into the process environment.
///
/// @pre len(path) > 0
/// @param path Filesystem path to the .env file.
/// @return Number of variables loaded, or 0 if unreadable.
pub fn load_file(path: str): int {
    contract(len(path) > 0, "File path must not be empty");
    var f_res = io.open(path, "r");
    match (f_res) {
        val file_obj => {
            var f = file_obj as io.File;
            var r = f.read([]);
            f.close();
            match (r) {
                val data => {
                    return load_dotenv(data as str);
                },
                err e => return 0
            }
        },
        err e => return 0
    }
}

fn find_char(s: str, needle: str): int {
    var i = 0;
    while (i <= len(s) - len(needle)) {
        if (_builtin_substring(s, i, i + len(needle)) == needle) return i;
        i = i + 1;
    }
    return -1;
}

/// Object-oriented interface to environment variable management.
frame Env {
    pub init() {}

    /// Retrieves an environment variable or nil if absent.
    pub fn get(key: str): str? { return get(key); }

    /// Retrieves an environment variable with a fallback default.
    pub fn get_or(key: str, fallback: str): str { return get_or(key, fallback); }

    /// Parses an environment variable as an integer.
    pub fn get_int(key: str, fallback: int = 0): int { return get_int(key, fallback); }

    /// Parses an environment variable as a boolean.
    pub fn get_bool(key: str, fallback: bool = false): bool { return get_bool(key, fallback); }

    /// Checks if a variable is present.
    pub fn has(key: str): bool { return has(key); }

    /// Checks if a variable is present.
    pub fn contains(key: str): bool { return has(key); }

    /// Sets or updates a variable.
    pub fn set(key: str, value: str): bool { return set(key, value); }

    /// Deletes a variable.
    pub fn unset(key: str): bool { return unset(key); }

    /// Lists all environment entries as "KEY=VALUE".
    pub fn vars(): [str] { return vars(); }

    /// Returns a dictionary of all environment variables.
    pub fn to_dict(): {str: str} { return to_dict(); }

    /// Lists all variable names.
    pub fn keys(): [str] { return keys(); }

    /// Lists all variable values.
    pub fn values(): [str] { return values(); }

    /// Parses raw .env content into a dictionary.
    pub fn parse_env(content: str): {str: str} { return parse_env(content); }

    /// Loads raw .env content into the process environment.
    pub fn load_dotenv(content: str): int { return load_dotenv(content); }

    /// Reads and loads a .env file from disk.
    pub fn load_file(path: str): int { return load_file(path); }

    /// Reads the system PATH variable or returns a fallback if unset.
    pub fn path(fallback: str): str { return get_or("PATH", fallback); }
}
