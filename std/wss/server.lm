// Provides WebSocket server utilities built on the raw WebSocket client module.
//
// Operations that can fail return `T?Error` and carry a diagnostic code; the
// ones that cannot (`join`, `leave`, `broadcast` on a room) just return a count.

import std.core show Error;
import std.resource as res;

frame WSConnection {
    pub var resource: res.Resource?;
    pub var writer: res.Writer?;
    pub var reader: res.Reader?;
    pub var poller: res.Poller?;
    pub var remote_addr: str;
    pub var connected: bool;
    pub var id: str;

    pub fn init(handle: int) {
        if (handle > 0) {
            var r = res.Resource(h=handle, k=-1); // Temporary
            self.resource = r;
            self.writer = res.Writer(r=r);
            self.reader = res.Reader(r=r);
            self.poller = res.Poller(r=r);
            self.connected = true;
        } else {
            self.resource = nil;
            self.writer = nil;
            self.reader = nil;
            self.poller = nil;
            self.connected = false;
        }
        self.remote_addr = "";
        self.id = "";
    }

    pub fn send(message: str): int?Error {
        match (self.writer) {
            val w => {
                if (w.write(args=[message]) == true) {
                    return ok(len(message));
                }
                self.connected = false;
                return err(Error(code="SendError", message="write failed"));
            },
            nil => return err(Error(code="NotConnected", message="no writer attached"))
        }
    }

    pub fn recv(): str?Error {
        match (self.reader) {
            val rd => {
                var payload = rd.read(args=[]);
                if (payload != nil) return ok(payload as str);
                self.connected = false;
                return err(Error(code="ConnectionClosed", message="peer closed the connection"));
            },
            nil => return err(Error(code="NotConnected", message="no reader attached"))
        }
    }

    pub fn has_message(): bool {
        match (self.poller) {
            val p => return p.poll(),
            nil => return false
        }
    }

    pub fn send_ping(payload: str = ""): bool {
        match (self.writer) {
            val w => return w.write(args=[payload]),
            nil => return false
        }
    }

    pub fn send_pong(payload: str = ""): bool {
        match (self.writer) {
            val w => return w.write(args=[payload]),
            nil => return false
        }
    }

    pub fn close(): nil?Error {
        match (self.resource) {
            val r => {
                r.close();
            },
            nil => {}
        }
        self.connected = false;
        self.resource = nil;
        return ok(nil);
    }
}

frame WSSServer {
    var host: str;
    var port: int;
    var running: bool;
    var on_connect: str;
    var on_message: str;
    var on_disconnect: str;
    pub var resource: res.Resource?;
    pub var binder: res.Binder?;
    pub var listener: res.Listener?;

    pub fn init() {
        self.host = "0.0.0.0";
        self.port = 8080;
        self.running = false;
        self.on_connect = "";
        self.on_message = "";
        self.on_disconnect = "";
        self.resource = nil;
        self.binder = nil;
        self.listener = nil;
    }

    // Configure the server
    pub fn set_host(host: str): WSSServer { self.host = host; return self; }
    pub fn set_port(port: int): WSSServer { self.port = port; return self; }
    pub fn on_connection(handler: str): WSSServer { self.on_connect = handler; return self; }
    pub fn on_message_handler(handler: str): WSSServer { self.on_message = handler; return self; }
    pub fn on_disconnection(handler: str): WSSServer { self.on_disconnect = handler; return self; }

    // Start the server (bind + listen)
    pub fn start(): int?Error {
        match (res.create_socket()) {
            val r => {
                var binder = res.Binder(r=r);
                if (not binder.bind(args=[self.host, self.port])) {
                    r.close();
                    return err(Error(code="BindError", message="failed to bind " + self.host + ":" + (self.port as str)));
                }

                var listener = res.Listener(r=r);
                if (not listener.listen(args=[128])) {
                    r.close();
                    return err(Error(code="ListenError", message="listen failed on port " + (self.port as str)));
                }

                self.running = true;
                self.resource = r;
                self.binder = binder;
                self.listener = listener;
                return ok(r._handle());
            },
            err e => return err(Error(code="SocketError", message="failed to create socket"))
        }
    }

    // Accept a new WebSocket connection (with HTTP upgrade)
    pub fn accept(): str?Error {
        match (res.create_websocket()) {
            val ws => {
                ws.close();
                return ok("ws_handle");
            },
            err e => return err(Error(code="UpgradeError", message="failed to create WebSocket resource"))
        }
    }

    // Broadcast a message to multiple client handles
    pub fn broadcast(handles: [int], message: str): int?Error {
        var sent: int = 0;
        var failed: int = 0;
        var i: int = 0;
        while (i < len(handles)) {
            var h: int = handles[i];
            if (h > 0) {
                var r = res.Resource(h=h, k=-1); // Temporary wrapper for raw handle
                var writer = res.Writer(r=r);
                if (writer.write(args=[message]) == true) {
                    sent = sent + 1;
                } else {
                    failed = failed + 1;
                }
            }
            i = i + 1;
        }
        if (failed > 0) {
            return err(Error(code="PartialSend", message="broadcast: " + (sent as str) + " sent, " + (failed as str) + " failed"));
        }
        return ok(sent);
    }

    // Close the server
    pub fn stop(): nil?Error {
        match (self.resource) {
            val r => {
                r.close();
            },
            nil => {}
        }
        self.resource = nil;
        self.running = false;
        return ok(nil);
    }

    pub fn select_subprotocol(requested: str, supported: [str]): str {
        var i = 0;
        while (i < len(supported)) {
            if (supported[i] == requested) return supported[i];
            i = i + 1;
        }
        if (len(supported) > 0) return supported[0];
        return "";
    }

    pub fn is_running(): bool { return self.running; }
}

frame WSRoom {
    var name: str;
    var connections: {str: WSConnection};

    pub fn init(name: str) {
        self.name = name;
        self.connections = {} as {str: WSConnection};
    }

    pub fn join(id: str, conn: WSConnection): int {
        self.connections[id] = conn;
        return len(self.connections);
    }

    pub fn leave(id: str): int {
        var new_conns: {str: WSConnection} = {} as {str: WSConnection};
        var keys = __room_keys(self.connections);
        var i: int = 0;
        while (i < len(keys)) {
            var k = keys[i];
            if (k != id) {
                new_conns[k] = self.connections[k];
            }
            i = i + 1;
        }
        self.connections = new_conns;
        return len(self.connections);
    }

    pub fn member_count(): int {
        return len(self.connections);
    }

    pub fn broadcast(message: str): int {
        var count = 0;
        var keys = __room_keys(self.connections);
        var i: int = 0;
        while (i < len(keys)) {
            var conn = self.connections[keys[i]];
            if (conn.connected) {
                var _sent = conn.send(message);
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }
}

// Keys of a connection table. `iter` inside a frame method aborts the compiler,
// so the loop lives in this free function and the methods walk the resulting
// list with a while loop. Dictionaries are walked with the two-variable form,
// `iter (key, value in dict)`.
fn __room_keys(connections: {str: WSConnection}): [str] {
    var keys: [str] = [];
    iter (id, conn in connections) {
        keys.append(id);
    }
    return keys;
}
