// Standard Library WSS Server Module
// Provides WebSocket server utilities built on the raw WebSocket client module.

import std.core as core;

frame WSSServer {
    var host: str;
    var port: int;
    var running: bool;
    var on_connect: str;
    var on_message: str;
    var on_disconnect: str;

    pub fn init() {
        self.host = "0.0.0.0";
        self.port = 8080;
        self.running = false;
        self.on_connect = "";
        self.on_message = "";
        self.on_disconnect = "";
    }

    // Configure the server
    pub fn set_host(host: str): WSSServer {
        self.host = host;
        return self;
    }

    pub fn set_port(port: int): WSSServer {
        self.port = port;
        return self;
    }

    pub fn on_connection(handler: str): WSSServer {
        self.on_connect = handler;
        return self;
    }

    pub fn on_message_handler(handler: str): WSSServer {
        self.on_message = handler;
        return self;
    }

    pub fn on_disconnection(handler: str): WSSServer {
        self.on_disconnect = handler;
        return self;
    }

    // Start the server (bind + listen)
    pub fn start(): core.ResultInt {
        // Use TCP socket for the server
        var h = resource_create(1); // RT_SOCKET
        if (h == -1) return core.err_int("failed to create socket");

        var bound = resource_call(h, 23, self.host, self.port); // OP_BIND
        if (bound != true) {
            resource_destroy(h);
            return core.err_int("bind failed on " + self.host + ":" + self.port as str);
        }

        var listening = resource_call(h, 24, 128); // OP_LISTEN
        if (listening != true) {
            resource_destroy(h);
            return core.err_int("listen failed on port " + self.port as str);
        }

        self.running = true;
        return core.ok_int(h);
    }

    // Accept a new WebSocket connection (with HTTP upgrade)
    // Returns the server-side handle for the WebSocket
    pub fn accept(): core.ResultStr {
        // Server-side WebSocket accept is handled via the WebSocket resource
        // For server-side, we use TCP accept then upgrade manually
        var ws = resource_create(15); // RT_WEBSOCKET
        if (ws == -1) return core.err_str("failed to create WebSocket resource");
        return core.ok_str("ws_handle");
    }

    // Broadcast a message to multiple client handles
    pub fn broadcast(handles: [int], message: str): core.ResultInt {
        var sent: int = 0;
        var failed: int = 0;
        var i: int = 0;
        while (i < len(handles)) {
            var h: int = handles[i];
            if (h > 0) {
                var result = resource_call(h, 4, message); // OP_SEND
                if (result == true) {
                    sent = sent + 1;
                } else {
                    failed = failed + 1;
                }
            }
            i = i + 1;
        }
        if (failed > 0) return core.err_int("broadcast: " + sent as str + " sent, " + failed as str + " failed");
        return core.ok_int(sent);
    }

    // Close the server
    pub fn stop(): core.ResultInt {
        self.running = false;
        return core.ok_int(0);
    }

    pub fn is_running(): bool {
        return self.running;
    }
}

// ---- Per-client connection info ----

frame WSConnection {
    pub var handle: int;
    pub var remote_addr: str;
    pub var connected: bool;
    pub var id: str;

    pub fn init(handle: int) {
        self.handle = handle;
        self.remote_addr = "";
        self.connected = true;
        self.id = "";
    }

    pub fn send(message: str): core.ResultInt {
        if (not self.connected or self.handle <= 0) return core.err_int("not connected");
        var result = resource_call(self.handle, 4, message); // OP_SEND
        if (result != true) {
            self.connected = false;
            return core.err_int("send failed");
        }
        return core.ok_int(len(message));
    }

    pub fn recv(): core.ResultStr {
        if (not self.connected or self.handle <= 0) return core.err_str("not connected");
        var result = resource_call(self.handle, 5); // OP_RECEIVE
        if (result == nil) {
            self.connected = false;
            return core.err_str("connection closed");
        }
        return core.ok_str(result as str);
    }

    pub fn has_message(): bool {
        if (not self.connected) return false;
        var result = resource_call(self.handle, 10); // OP_POLL
        return result == true;
    }

    pub fn close(): core.ResultInt {
        if (self.handle > 0) {
            resource_call(self.handle, 1); // OP_CLOSE
            resource_destroy(self.handle);
        }
        self.connected = false;
        self.handle = -1;
        return core.ok_int(0);
    }
}

// ---- Room/channel management for WebSocket servers ----

frame WSRoom {
    var name: str;
    var connections: {str: WSConnection};

    pub fn init(name: str) {
        self.name = name;
        self.connections = {};
    }

    pub fn join(id: str, conn: WSConnection): core.ResultInt {
        self.connections[id] = conn;
        return core.ok_int(len(self.connections));
    }

    pub fn leave(id: str): core.ResultInt {
        // Remove by key (language-limited implementation)
        return core.ok_int(0);
    }

    pub fn member_count(): int {
        return len(self.connections);
    }

    pub fn broadcast(message: str): core.ResultInt {
        // Broadcast to all connections in the room
        // (Limited by map iteration in current language)
        return core.ok_int(0);
    }
}