// Standard Library WebSocket Module
// Uses the native WEBSOCKET resource (type 15) for real WebSocket connections.

import std.core as core;
import std.url as url;

var RT_WEBSOCKET: int = 15;
var OP_CONNECT: int = 6;
var OP_SEND: int = 4;
var OP_RECEIVE: int = 5;
var OP_CLOSE: int = 1;
var OP_POLL: int = 10;

frame WebSocketClient {
    pub var handle: int;
    pub var connected: bool;

    pub fn init() {
        self.handle = -1;
        self.connected = false;
    }

    // Connect to a WebSocket server
    pub fn connect(url_str: str): int?core.Error {
        if (url_str == "") return err(core.Error { code: "ERR", message: "empty URL" });

        var parsed = url.URL(url_str);
        if (not parsed.is_valid) return err(core.Error { code: "ERR", message: "invalid URL" });

        var ws = resource_create(RT_WEBSOCKET, []);
        if (ws == -1) return err(core.Error { code: "ERR", message: "failed to create WebSocket resource" });

        var result = resource_call(ws, OP_CONNECT, [url_str]);
        if (result != true) {
            resource_destroy(ws);
            return err(core.Error { code: "ERR", message: "WebSocket handshake failed" });
        }

        self.handle = ws;
        self.connected = true;
        return ok(ws);
    }

    // Send a text message
    pub fn send_text(message: str): int?core.Error {
        if (not self.connected or self.handle <= 0) return err(core.Error { code: "ERR", message: "not connected" });
        var result = resource_call(self.handle, OP_SEND, [message]);
        if (result != true) {
            self.connected = false;
            return err(core.Error { code: "ERR", message: "send failed" });
        }
        return ok(len(message));
    }

    // Receive a message (blocks until data available)
    pub fn recv(): str?core.Error {
        if (not self.connected or self.handle <= 0) return err(core.Error { code: "ERR", message: "not connected" });
        var result = resource_call(self.handle, OP_RECEIVE, []);
        if (result == nil) {
            self.connected = false;
            return err(core.Error { code: "ERR", message: "connection closed" });
        }
        return ok(result as str);
    }

    // Non-blocking check for available messages
    pub fn has_message(): bool {
        if (not self.connected or self.handle <= 0) return false;
        var result = resource_call(self.handle, OP_POLL, []);
        return result == true;
    }

    // Close the WebSocket connection
    pub fn close(): nil?core.Error {
        if (self.handle <= 0) return ok(nil);
        resource_call(self.handle, OP_CLOSE, []);
        resource_destroy(self.handle);
        self.handle = -1;
        self.connected = false;
        return ok(nil);
    }
}
