// Standard Library WebSocket Module
// Uses the native WEBSOCKET resource for real WebSocket connections.

import std.core as core;
import std.core show Error;
import std.url.index as url;
import std.resource as res;

frame WebSocketClient {
    pub var resource: res.Resource?;
    pub var connector: res.Connector?;
    pub var writer: res.Writer?;
    pub var reader: res.Reader?;
    pub var poller: res.Poller?;

    pub fn init() {
        self.resource = nil;
        self.connector = nil;
        self.writer = nil;
        self.reader = nil;
        self.poller = nil;
    }

    // Connect to a WebSocket server
    pub fn connect(url_str: str): int?core.Error {
        if (url_str == "") return err(Error(code="ERR", message="empty URL"));

        var parsed = url.URL(url_str);
        if (not parsed.is_valid) return err(Error(code="ERR", message="invalid URL"));

        match (res.create_websocket()) {
            val ws => {
                var connector = res.Connector(r=ws);
                if (not connector.connect(args=[url_str])) {
                    ws.close();
                    return err(Error(code="ERR", message="WebSocket handshake failed"));
                }

                self.resource = ws;
                self.connector = connector;
                self.writer = res.Writer(r=ws);
                self.reader = res.Reader(r=ws);
                self.poller = res.Poller(r=ws);
                return ok(ws._handle());
            },
            err e => {
                return err(Error(code="ERR", message="failed to create WebSocket resource"));
            }
        }
    }

    // Send a text message
    pub fn send_text(message: str): int?core.Error {
        match (self.writer) {
            val w => {
                var result = w.write(args=[message]);
                if (result != true) {
                    self.close();
                    return err(Error(code="ERR", message="send failed"));
                }
                return ok(len(message));
            },
            nil => {
                return err(Error(code="ERR", message="not connected"));
            }
        }
    }

    // Receive a message (blocks until data available)
    pub fn recv(): str?core.Error {
        match (self.reader) {
            val rd => {
                var result = rd.read(args=[]);
                if (result == nil) {
                    self.close();
                    return err(Error(code="ERR", message="connection closed"));
                }
                return ok(result as str);
            },
            nil => {
                return err(Error(code="ERR", message="not connected"));
            }
        }
    }

    // Non-blocking check for available messages
    pub fn has_message(): bool {
        match (self.poller) {
            val p => return p.poll(),
            nil => return false
        }
    }

    // Close the WebSocket connection
    pub fn close(): nil?core.Error {
        match (self.resource) {
            val r => {
                r.close();
                self.resource = nil;
                self.connector = nil;
                self.writer = nil;
                self.reader = nil;
                self.poller = nil;
                return ok(nil);
            },
            nil => return ok(nil)
        }
    }

    pub fn is_connected(): bool {
        match (self.resource) {
            val r => return r.is_open(),
            nil => return false
        }
    }
}
