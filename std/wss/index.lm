// WebSocket umbrella: re-exports the client and server submodules plus the
// RFC 6455 close codes as module-level constants.
//
// Usage:
//   import std.wss as wss;
//   var client = wss.Client();
//   client.connect("ws://localhost:8080/ws");
//   client.send_text("Hello");
//   var msg = client.recv();

pub import std.wss.client as client;
pub import std.wss.server as server;

pub import std.wss.client show Client;
pub import std.wss.server show Server, Connection, Room;

// WebSocket Close Code Enumeration (RFC 6455 section 7.4.1)
enum CloseCode {
    Normal,
    GoingAway,
    ProtocolError,
    UnsupportedData,
    NoStatus,
    Abnormal,
    InvalidPayload,
    PolicyViolation,
    MessageTooBig,
    MandatoryExt,
    InternalError,
    ServiceRestart,
    TryAgainLater
}

pub fn close_code_value(code: CloseCode): int {
    match (code) {
        CloseCode.Normal => { return 1000; },
        CloseCode.GoingAway => { return 1001; },
        CloseCode.ProtocolError => { return 1002; },
        CloseCode.UnsupportedData => { return 1003; },
        CloseCode.NoStatus => { return 1005; },
        CloseCode.Abnormal => { return 1006; },
        CloseCode.InvalidPayload => { return 1007; },
        CloseCode.PolicyViolation => { return 1008; },
        CloseCode.MessageTooBig => { return 1009; },
        CloseCode.MandatoryExt => { return 1010; },
        CloseCode.InternalError => { return 1011; },
        CloseCode.ServiceRestart => { return 1012; },
        CloseCode.TryAgainLater => { return 1013; },
        _ => { return 1000; }
    }
}

// Close codes, RFC 6455 section 7.4.1.
pub const WS_CLOSE_NORMAL: int = 1000;
pub const WS_CLOSE_GOING_AWAY: int = 1001;
pub const WS_CLOSE_PROTOCOL_ERROR: int = 1002;
pub const WS_CLOSE_UNSUPPORTED_DATA: int = 1003;
pub const WS_CLOSE_NO_STATUS: int = 1005;
pub const WS_CLOSE_ABNORMAL: int = 1006;
pub const WS_CLOSE_INVALID_PAYLOAD: int = 1007;
pub const WS_CLOSE_POLICY_VIOLATION: int = 1008;
pub const WS_CLOSE_MESSAGE_TOO_BIG: int = 1009;
pub const WS_CLOSE_MANDATORY_EXT: int = 1010;
pub const WS_CLOSE_INTERNAL_ERROR: int = 1011;
pub const WS_CLOSE_SERVICE_RESTART: int = 1012;
pub const WS_CLOSE_TRY_AGAIN_LATER: int = 1013;
