// Standard Library Math Module

var PI: float = 3.14159265358979323846;
var E: float = 2.71828182845904523536;
var TAU: float = 6.28318530717958647692;
var PHI: float = 1.61803398874989484820;
var INF: float = 1.0 / 0.0;
var NAN: float = 0.0 / 0.0;
var EPSILON: float = 0.00000000000000022204;

frame Int {
    pub var value: int;
    pub init(value: int) {
        this.value = value;
    }
    pub fn abs(): int { if (self.value < 0) return -self.value; return self.value; }
    pub fn min(other: int): int { if (self.value < other) return self.value; return other; }
    pub fn max(other: int): int { if (self.value > other) return self.value; return other; }
}

frame Float {
    pub var value: float;
    pub init(value: float) {
        this.value = value;
    }
    pub fn abs(): float { if (self.value < 0.0) return -self.value; return self.value; }
    pub fn min(other: float): float { if (self.value < other) return self.value; return other; }
    pub fn max(other: float): float { if (self.value > other) return self.value; return other; }
    
    // Rounding operations
    pub fn floor(): int { 
        var i: int = self.value as int; 
        if ((i as float) > self.value) return i - 1; 
        return i; 
    }
    
    pub fn ceil(): int { 
        var i: int = self.value as int; 
        if ((i as float) < self.value) return i + 1; 
        return i; 
    }
    
    pub fn round(): int { 
        if (self.value >= 0.0) return Float(self.value + 0.5).floor(); 
        return Float(self.value - 0.5).ceil(); 
    }
    
    pub fn trunc(): int { return self.value as int; }
    
    pub fn fract(): float { return self.value - (self.value as int as float); }

    // Powers and logs
    pub fn sqrt(): float {
        if (self.value < 0.0) return NAN;
        if (self.value == 0.0) return 0.0;
        var x = self.value;
        var y = 1.0;
        var e = 0.000000000000001;
        while (abs(x - y) > e) {
            x = (x + y) / 2.0;
            y = self.value / x;
        }
        return x;
    }

    pub fn cbrt(): float {
        if (self.value == 0.0) return 0.0;
        var x = self.value;
        var y = 1.0;
        if (x < 0.0) {
            x = -x;
            while (abs(x - y * y * y) > 0.000000000000001) {
                y = (2.0 * y + x / (y * y)) / 3.0;
            }
            return -y;
        }
        while (abs(x - y * y * y) > 0.000000000000001) {
            y = (2.0 * y + x / (y * y)) / 3.0;
        }
        return y;
    }

    pub fn exp(): float {
        var x = self.value;
        var sum = 1.0;
        var term = 1.0;
        var i = 1;
        while (i < 100) {
            var i_f = i as float;
            term = term * x / i_f;
            sum = sum + term;
            if (abs(term) < 1e-16) break;
            i = i + 1;
        }
        return sum;
    }

    pub fn log(): float {
        if (self.value <= 0.0) return NAN;
        var x = self.value;
        var count = 0;
        while (x > 2.0) {
            x = x / E;
            count = count + 1;
        }
        while (x < 0.5) {
            x = x * E;
            count = count - 1;
        }
        x = x - 1.0;
        var sum = 0.0;
        var term = x;
        var i = 1;
        while (i < 100) {
            var i_f = i as float;
            if (i % 2 == 1) sum = sum + term / i_f;
            else sum = sum - term / i_f;
            term = term * x;
            if (abs(term) < 1e-16) break;
            i = i + 1;
        }
        return sum + (count as float);
    }

    pub fn log2(): float { return self.log() / Float(2.0).log(); }
    pub fn log10(): float { return self.log() / Float(10.0).log(); }
    pub fn exp2(): float { return Float(self.value * Float(2.0).log()).exp(); }

    pub fn pow(exponent: float): float {
        if (self.value == 0.0) return 0.0;
        if (self.value < 0.0) return NAN;
        return Float(exponent * self.log()).exp();
    }

    pub fn hypot(other: float): float {
        return Float(self.value * self.value + other * other).sqrt();
    }

    // Trigonometry
    pub fn sin(): float {
        var x = self.normalize_angle();
        var sum = 0.0;
        var term = x;
        var i = 1;
        while (i < 20) {
            var i_f = i as float;
            sum = sum + term;
            term = -term * x * x / ((2.0 * i_f) * (2.0 * i_f + 1.0));
            i = i + 1;
        }
        return sum;
    }

    pub fn cos(): float {
        var x = self.normalize_angle();
        var sum = 0.0;
        var term = 1.0;
        var i = 1;
        while (i < 20) {
            var i_f = i as float;
            sum = sum + term;
            term = -term * x * x / ((2.0 * i_f - 1.0) * (2.0 * i_f));
            i = i + 1;
        }
        return sum;
    }

    pub fn tan(): float { return self.sin() / self.cos(); }

    pub fn asin(): float {
        if (self.value < -1.0 or self.value > 1.0) return NAN;
        var x = self.value;
        var sum = x;
        var term = x;
        var i = 1;
        while (i < 50) {
            var i_f = i as float;
            term = term * x * x * (2.0 * i_f - 1.0) / (2.0 * i_f);
            sum = sum + term / (2.0 * i_f + 1.0);
            if (abs(term) < 1e-16) break;
            i = i + 1;
        }
        return sum;
    }

    pub fn acos(): float { return PI / 2.0 - self.asin(); }

    pub fn atan(): float {
        var x = self.value;
        if (abs(x) > 1.0) {
            if (x > 0.0) return PI / 2.0 - Float(1.0 / x).atan();
            return -PI / 2.0 - Float(1.0 / x).atan();
        }
        var sum = x;
        var term = x;
        var i = 1;
        while (i < 50) {
            var i_f = i as float;
            term = -term * x * x;
            sum = sum + term / (2.0 * i_f + 1.0);
            if (abs(term) < 1e-16) break;
            i = i + 1;
        }
        return sum;
    }

    pub fn atan2(x: float): float {
        var y = self.value;
        if (x > 0.0) return Float(y / x).atan();
        if (x < 0.0 and y >= 0.0) return Float(y / x).atan() + PI;
        if (x < 0.0 and y < 0.0) return Float(y / x).atan() - PI;
        if (x == 0.0 and y > 0.0) return PI / 2.0;
        if (x == 0.0 and y < 0.0) return -PI / 2.0;
        return 0.0;
    }

    // Hyperbolic
    pub fn sinh(): float {
        var e = self.exp();
        return (e - 1.0 / e) / 2.0;
    }

    pub fn cosh(): float {
        var e = self.exp();
        return (e + 1.0 / e) / 2.0;
    }

    pub fn tanh(): float {
        var e = Float(2.0 * self.value).exp();
        return (e - 1.0) / (e + 1.0);
    }

    // Helper method for trigonometric functions
    private fn normalize_angle(): float { 
        var y: float = self.value; 
        while (y > PI) { y = y - TAU; } 
        while (y < -PI) { y = y + TAU; } 
        return y; 
    }

    // Floating-point helpers
    pub fn is_nan(): bool { return self.value != self.value; }
    pub fn is_inf(): bool { return self.value == INF or self.value == -INF; }
    pub fn is_finite(): bool { return !self.is_nan() and !self.is_inf(); }
}

// Basic operations
fn abs(x: float): float { return Float(x).abs(); }
fn abs_int(x: int): int { return Int(x).abs(); }

// Integer utilities
fn gcd(a: int, b: int): int {
    var x = abs_int(a);
    var y = abs_int(b);
    while (y != 0) {
        var temp = y;
        y = x % y;
        x = temp;
    }
    return x;
}

fn lcm(a: int, b: int): int {
    if (a == 0 or b == 0) return 0;
    return abs_int(a * b) / gcd(a, b);
}

fn factorial(n: int): int {
    if (n < 0) return 0;
    if (n == 0) return 1;
    var res = 1;
    var i = 1;
    while (i <= n) {
        res = res * i;
        i = i + 1;
    }
    return res;
}

fn permutations(n: int, k: int): int {
    if (k < 0 or k > n) return 0;
    return factorial(n) / factorial(n - k);
}

fn combinations(n: int, k: int): int {
    if (k < 0 or k > n) return 0;
    return factorial(n) / (factorial(k) * factorial(n - k));
}
fn min(a: float, b: float): float { return Float(a).min(b); }
fn max(a: float, b: float): float { return Float(a).max(b); }
fn clamp(value: float, low: float, high: float): float { if (value < low) return low; if (value > high) return high; return value; }
fn sign(x: float): float { if (x > 0.0) return 1.0; if (x < 0.0) return -1.0; return 0.0; }
fn lerp(a: float, b: float, t: float): float { return a + (b - a) * t; }

// Rounding utility functions
fn floor(x: float): int { return Float(x).floor(); }
fn ceil(x: float): int { return Float(x).ceil(); }
fn round(x: float): int { return Float(x).round(); }
fn trunc(x: float): int { return Float(x).trunc(); }
fn fract(x: float): float { return Float(x).fract(); }

// Powers and logs utility functions
fn pow(base: float, exponent: float): float { return Float(base).pow(exponent); }
fn sqrt(x: float): float { return Float(x).sqrt(); }
fn cbrt(x: float): float { return Float(x).cbrt(); }
fn hypot(x: float, y: float): float { return Float(x).hypot(y); }
fn log(x: float): float { return Float(x).log(); }
fn log2(x: float): float { return Float(x).log2(); }
fn log10(x: float): float { return Float(x).log10(); }
fn exp(x: float): float { return Float(x).exp(); }
fn exp2(x: float): float { return Float(x).exp2(); }

// Trigonometry utility functions
fn sin(x: float): float { return Float(x).sin(); }
fn cos(x: float): float { return Float(x).cos(); }
fn tan(x: float): float { return Float(x).tan(); }
fn asin(x: float): float { return Float(x).asin(); }
fn acos(x: float): float { return Float(x).acos(); }
fn atan(x: float): float { return Float(x).atan(); }
fn atan2(y: float, x: float): float { return Float(y).atan2(x); }

// Hyperbolic utility functions
fn sinh(x: float): float { return Float(x).sinh(); }
fn cosh(x: float): float { return Float(x).cosh(); }
fn tanh(x: float): float { return Float(x).tanh(); }

// Floating-point helpers
fn is_nan(x: float): bool { return Float(x).is_nan(); }
fn is_inf(x: float): bool { return Float(x).is_inf(); }
fn is_finite(x: float): bool { return Float(x).is_finite(); }
fn nearly_equal(a: float, b: float, epsilon: float = 0.000001): bool { return abs(a - b) <= epsilon; }
