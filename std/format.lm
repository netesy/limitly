// Standard Library Format Forwarder Module

import std.format.index as format_mod;

frame Format {
    pub init() {}
    pub fn int(value: int): str {
        var f = format_mod.Format();
        return f.int(value);
    }
    pub fn float(value: float): str {
        var f = format_mod.Format();
        return f.float(value);
    }
    pub fn bool(value: bool): str {
        var f = format_mod.Format();
        return f.bool(value);
    }
    pub fn pad_left(value: str, length_val: int, fill_char: str): str {
        var f = format_mod.Format();
        return f.pad_left(value, length_val, fill_char);
    }
    pub fn pad_right(value: str, length_val: int, fill_char: str): str {
        var f = format_mod.Format();
        return f.pad_right(value, length_val, fill_char);
    }
    pub fn center(value: str, length_val: int, fill_char: str): str {
        var f = format_mod.Format();
        return f.center(value, length_val, fill_char);
    }
    pub fn truncate(value: str, length_val: int, ellipsis: bool): str {
        var f = format_mod.Format();
        return f.truncate(value, length_val, ellipsis);
    }
    pub fn title_case(value: str): str {
        var f = format_mod.Format();
        return f.title_case(value);
    }
    pub fn snake_case(value: str): str {
        var f = format_mod.Format();
        return f.snake_case(value);
    }
    pub fn camel_case(value: str): str {
        var f = format_mod.Format();
        return f.camel_case(value);
    }
    pub fn kebab_case(value: str): str {
        var f = format_mod.Format();
        return f.kebab_case(value);
    }
    pub fn pascal_case(value: str): str {
        var f = format_mod.Format();
        return f.pascal_case(value);
    }
}
