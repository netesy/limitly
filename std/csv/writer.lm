// CSV Writer Module

import std.string.join as join_mod;

pub fn stringify_csv(rows: [[str]]): str {
    var res = "";
    var i = 0;
    var rows_len = len(rows);
    while (i < rows_len) {
        var row = rows[i];
        res = res + join_mod.join(row, ",");
        res = res + "\n";
        i = i + 1;
    }
    return res;
}
