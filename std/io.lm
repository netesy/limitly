// Standard Library I/O Module

import std.core as core;
import std.resource as res;
import std.internal.runtime as rt;

frame FileNotFound { pub var path: str; }
frame PermissionDenied { pub var path: str; pub var operation: str; }
frame DiskFull { pub var path: str; }
frame NetworkError { pub var message: str; }
frame UnknownError { pub var message: str; }

pub type IOError = FileNotFound | PermissionDenied | DiskFull | NetworkError | UnknownError;

// Internal capability for filesystem operations
frame FileSystem {
    var resource: res.Resource;
    pub init(r: res.Resource) { self.resource = r; }
    pub fn exists(path: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_EXISTS, args=[path]);
        return (result == true);
    }
    pub fn delete(path: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_DELETE, args=[path]);
        return (result == true);
    }
    pub fn rename(old: str, new: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_RENAME, args=[old, new]);
        return (result == true);
    }
    pub fn mkdir(path: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_MKDIR, args=[path]);
        return (result == true);
    }
    pub fn readdir(path: str): any {
        return res._call(h=self.resource.handle, op=res.OP_READDIR, args=[path]);
    }
}

frame Console {
    var resource: res.Resource;
    var writer: res.Writer;
    pub init() {
        self.resource = res.stdout;
        self.writer = res.Writer(r=self.resource);
    }
    pub fn print(msg: any): nil {
        self.writer.write(args=[msg]);
    }
    pub fn read_line(): str { return input(""); }
}

pub var out: Console = Console();

frame File {
    pub var path: str;
    var resource: res.Resource;
    var reader: res.Reader;
    var writer: res.Writer;

    pub init(p: str, r: res.Resource) {
        self.path = p;
        self.resource = r;
        self.reader = res.Reader(r=r);
        self.writer = res.Writer(r=r);
    }

    pub fn read(): str?IOError {
        var r = self.reader.read(args=[]);
        if (r == nil) return err(UnknownError(message="fail"));
        return ok(r);
    }

    pub fn write(content: str): nil?IOError {
        var success = self.writer.write(args=[content]);
        if (success == nil) return err(UnknownError(message="fail"));
        return ok(nil);
    }

    pub fn close(): nil?IOError {
        if (self.resource.is_open_val) {
            rt.destroy(self.resource.handle);
            self.resource.is_open_val = false;
        }
        return ok(nil);
    }

    pub fn is_open(): bool {
        return self.resource.is_open();
    }
}

pub fn open(path: str, mode: str): File?IOError {
    match (res.open_file(path=path, mode=mode)) {
        val r => return ok(File(p=path, r=r)),
        err e => return err(FileNotFound(path=path))
    }
}

pub fn print(msg: any): nil {
    var w = res.Writer(r=res.stdout);
    w.write(args=[msg]);
}

pub fn exists(path: str): bool {
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r=r);
            var result = fs.exists(path=path);
            r.close();
            return result;
        },
        err e => return false
    }
}

pub fn delete(path: str): bool {
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r=r);
            var result = fs.delete(path=path);
            r.close();
            return result;
        },
        err e => return false
    }
}

pub fn rename(old_path: str, new_path: str): bool {
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r=r);
            var result = fs.rename(old=old_path, new=new_path);
            r.close();
            return result;
        },
        err e => return false
    }
}

pub fn create_directory(path: str): nil?IOError {
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r=r);
            var result = fs.mkdir(path=path);
            r.close();
            if (result) return ok(nil);
            return err(UnknownError(message="fail"));
        },
        err e => return err(UnknownError(message="fail"))
    }
}

pub fn list_directory(path: str): [str]?IOError {
    match (res.create_fs_resource()) {
        val r => {
            var fs = FileSystem(r=r);
            var result = fs.readdir(path=path);
            r.close();
            if (result == nil) return err(UnknownError(message="fail"));
            
            var s = result as str;
            var parts: [str] = [];
            var current = "";
            for (var i = 0; i < len(s); i = i + 1) {
                var ch = substring(s, i, i + 1);
                if (ch == "\n") {
                    if (len(current) > 0) parts.append(current);
                    current = "";
                } else {
                    current = current + ch;
                }
            }
            if (len(current) > 0) parts.append(current);
            return ok(parts);
        },
        err e => return err(UnknownError(message="fail"))
    }
}
