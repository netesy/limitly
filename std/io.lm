// Standard Library I/O Forwarder Module

import std.io.index as io;
import std.resource as res;

pub type Console = io.Console;
pub type File = io.File;
pub type Reader = io.Reader;
pub type Writer = io.Writer;

pub var out: Console = io.out;

pub fn open(path: str, mode: str): any { return io.open(path, mode); }
pub fn print(msg: any): nil { io.print(msg); }
pub fn exists(path: str): bool { return io.exists(path); }
pub fn delete(path: str): bool { return io.delete(path); }
pub fn rename(old_path: str, new_path: str): bool { return io.rename(old_path, new_path); }
pub fn create_directory(path: str): any { return io.create_directory(path); }
pub fn list_directory(path: str): any { return io.list_directory(path); }
