// Standard Library I/O Module (Unified Resource System)

import std.core as core;

// Resource Types (aligned with LIR/VM)
// RT_FILE: 0, RT_SOCKET: 1, RT_STDOUT: 9, RT_STDERR: 10
// Operations: OPEN: 0, CLOSE: 1, READ: 2, WRITE: 3

type IOError = FileNotFound | PermissionDenied | DiskFull | NetworkError | UnknownError;
type FileNotFound = { path: str };
type PermissionDenied = { path: str, operation: str };
type DiskFull = { path: str };
type NetworkError = { message: str };
type UnknownError = { message: str };

frame Console {
    pub fn print(msg: any): nil {
        // Use pre-allocated STDOUT resource (ID 0)
        resource_call(0, 3, [msg]); 
    }

    pub fn read_line(): str {
        return input("");
    }
}

frame File {
    var path: str;
    var handle: int64;

    pub fn read(): str?IOError {
        var res = resource_call(this.handle, 2, []); // OP_READ
        if (res == nil) return UnknownError { message: "Failed to read file" };
        return (res as str);
    }

    pub fn write(content: str): nil?IOError {
        var success = resource_call(this.handle, 3, [content]); // OP_WRITE
        if (!success) return UnknownError { message: "Failed to write file" };
        return nil;
    }

    pub fn close(): nil?IOError {
        resource_call(this.handle, 1, []); // OP_CLOSE
        resource_destroy(this.handle);
        return nil;
    }
}

fn open(path: str, mode: str): File?IOError {
    var h = resource_create(0, [path, mode]); // RT_FILE
    if (h == -1) return UnknownError { message: "Failed to create file resource" };

    // Note: resource_create for FILE might already perform the open 
    // depending on the implementation. Based on the previous code, 
    // it was separate.
    var success = resource_call(h, 0, [path, mode]); // OP_OPEN
    if (!success) {
        resource_destroy(h);
        return FileNotFound { path: path };
    }

    return File(path=path, handle=h);
}

// Global print helper
fn print(msg: any): nil {
    resource_call(0, 3, [msg]);
}

// Filesystem helpers
fn exists(path: str): bool {
    return file_exists(path);
}

fn delete(path: str): bool {
    return file_delete(path);
}

fn create_directory(path: str): nil?IOError {
    return err(UnknownError { message: "Not implemented" });
}
