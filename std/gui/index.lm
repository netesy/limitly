// std/gui/index.lm
// High-performance, zero-DOM Immediate-Mode GUI (IMGUI) engine.
// Features comprehensive widget library, moddable style stack, and customizable themes.

import std.gg as gg;
import std.math as math;
import std.gui.types as types;
import std.color as color;
import std.string as std_string;
import std.text.controller as text_ctrl;
import std.focus.manager as focus;
import std.graphics.text_layout as layout;
import std.ui.viewport as viewport;
import std.animation as anim;
import std.graphics.shadow as shadow;
import std.widget as widget;

frame WindowState {
    embed types.Rect;

    pub var collapsed: bool;
    pub var is_dragging: bool;
    pub var drag_off_x: float;
    pub var drag_off_y: float;

    pub init(x: float = 0.0, y: float = 0.0, w: float = 200.0, h: float = 200.0) {
        self.x = x;
        self.y = y;
        self.w = w;
        self.h = h;
        self.collapsed = false;
        self.is_dragging = false;
        self.drag_off_x = 0.0;
        self.drag_off_y = 0.0;
    }
}

frame GUI {
    pub var theme: types.GUITheme;

    // Input snapshot for current frame
    pub var mouse_x: float;
    pub var mouse_y: float;
    pub var mouse_down: bool;
    pub var mouse_pressed: bool;
    pub var mouse_released: bool;
    pub var mouse_wheel: float;
    pub var prev_mouse_down: bool;
    pub var dt: float;
    pub var keys_down: [int];
    pub var keys_pressed: [int];
    pub var typed_chars: [int];
    pub var active_modifiers: int;
    pub var get_clipboard_cb: (fn(): str)?;
    pub var set_clipboard_cb: (fn(str): nil)?;

    // Interaction tracking
    pub var hot_id: str;
    pub var active_id: str;
    pub var id_prefix: str;
    pub var prev_item_hovered: bool;
    pub var prev_item_rect: types.Rect;

    // Layout & Flow cursor
    pub var cursor_x: float;
    pub var cursor_y: float;
    pub var start_x: float;
    pub var start_y: float;
    pub var line_h: float;
    pub var same_line_flag: bool;
    pub var prev_item_w: float;
    pub var indent_x: float;

    // Multi-column layout
    pub var columns_count: int;
    pub var columns_idx: int;
    pub var columns_start_x: float;
    pub var columns_width: float;

    // Scrolling & Popups
    pub var scroll_y: float;
    pub var active_popup_id: str;
    pub var popup_x: float;
    pub var popup_y: float;
    pub var popup_w: float;
    pub var popup_h: float;
    pub var cur_tab_bar_id: str;
    pub var combo_open_id: str;
    pub var has_deferred_combo: bool;
    pub var deferred_combo_bx: float;
    pub var deferred_combo_by: float;
    pub var deferred_combo_w: float;
    pub var deferred_combo_h: float;
    pub var deferred_combo_items: [str];
    pub var deferred_combo_selected: int;
    pub var deferred_combo_id: str;
    pub var combo_selected_new: int;
    pub var combo_selected_changed: bool;
    pub var editor_controllers: {str: text_ctrl.EditorController};
    pub var scroll_offsets: {str: float};
    pub var focus_manager: focus.Manager;

    // Immediate-mode Modifier Support (Shadows, Opacity, Disabled)
    pub var next_shadow: shadow.Shadow | nil;
    pub var has_next_shadow: bool;
    pub var shadow_stack: [shadow.Shadow];
    pub var shadow_stack_top: int;
    pub var next_opacity: float;
    pub var has_next_opacity: bool;
    pub var next_disabled: bool;
    pub var has_next_disabled: bool;

    // Window management
    pub var in_window: bool;
    pub var cur_window_title: str;
    pub var cur_window_x: float;
    pub var cur_window_y: float;
    pub var cur_window_w: float;
    pub var cur_window_h: float;

    // Persistent storage for windows & collapsing headers
    pub var windows: {str: WindowState};
    pub var headers: {str: bool};
    pub var anim_store: anim.IMGUIAnimationStore;

    // Moddable Style Stack (O(1) push/pop via top cursors)
    pub var style_color_indices: [int];
    pub var style_color_stack: [color.Color];
    pub var style_color_top: int;
    pub var style_var_indices: [int];
    pub var style_var_stack: [float];
    pub var style_var_top: int;

    pub init(theme: types.GUITheme | nil = nil) {
        if (theme == nil) {
            self.theme = types.default_theme();
        } else {
            self.theme = theme as types.GUITheme;
        }

        self.mouse_x = 0.0;
        self.mouse_y = 0.0;
        self.mouse_down = false;
        self.mouse_pressed = false;
        self.mouse_released = false;
        self.mouse_wheel = 0.0;
        self.prev_mouse_down = false;
        self.dt = 0.016;

        self.hot_id = "";
        self.has_deferred_combo = false;
        self.active_id = "";
        self.id_prefix = "";
        self.prev_item_hovered = false;
        self.prev_item_rect = types.rect(0.0, 0.0, 0.0, 0.0);

        self.cursor_x = 10.0;
        self.cursor_y = 10.0;
        self.start_x = 10.0;
        self.start_y = 10.0;
        self.line_h = 0.0;
        self.same_line_flag = false;
        self.prev_item_w = 0.0;
        self.indent_x = 0.0;

        self.columns_count = 1;
        self.columns_idx = 0;
        self.columns_start_x = 10.0;
        self.columns_width = 400.0;

        self.scroll_y = 0.0;
        self.active_popup_id = "";
        self.popup_x = 0.0;
        self.popup_y = 0.0;
        self.popup_w = 0.0;
        self.popup_h = 0.0;
        self.cur_tab_bar_id = "";
        self.combo_open_id = "";
        self.has_deferred_combo = false;
        self.deferred_combo_bx = 0.0;
        self.deferred_combo_by = 0.0;
        self.deferred_combo_w = 0.0;
        self.deferred_combo_h = 0.0;
        self.deferred_combo_items = [] as [str];
        self.deferred_combo_selected = 0;
        self.deferred_combo_id = "";
        self.combo_selected_new = -1;
        self.combo_selected_changed = false;
        self.editor_controllers = {} as {str: text_ctrl.EditorController};
        self.scroll_offsets = {} as {str: float};
        self.focus_manager = focus.Manager();

        self.next_shadow = nil;
        self.has_next_shadow = false;
        self.shadow_stack = [] as [shadow.Shadow];
        self.shadow_stack_top = 0;
        self.next_opacity = 1.0;
        self.has_next_opacity = false;
        self.next_disabled = false;
        self.has_next_disabled = false;

        self.in_window = false;
        self.cur_window_title = "";
        self.cur_window_x = 0.0;
        self.cur_window_y = 0.0;
        self.cur_window_w = 0.0;
        self.cur_window_h = 0.0;

        self.windows = {} as {str: WindowState};
        self.headers = {} as {str: bool};
        self.anim_store = anim.global_imgui_anim_store;

        self.style_color_indices = [];
        self.style_color_stack = [];
        self.style_color_top = 0;
        self.style_var_indices = [];
        self.style_var_stack = [];
        self.style_var_top = 0;
    }

    // ── Frame Lifecycle ────────────────────────────────────────────────────────

    pub fn begin(mx: float, my: float, is_down: bool, wheel: float = 0.0, dt: float = 0.016, is_pressed: bool = false, is_released: bool = false): nil {
        self.mouse_x = mx;
        self.mouse_y = my;
        self.mouse_pressed = is_pressed or (is_down and not self.prev_mouse_down);
        self.mouse_released = is_released or (not is_down and self.prev_mouse_down);
        self.mouse_down = is_down;
        self.prev_mouse_down = is_down;
        self.mouse_wheel = wheel;
        self.dt = dt;

        self.hot_id = "";
        self.has_deferred_combo = false;

        self.cursor_x = 10.0;
        self.cursor_y = 10.0;
        self.start_x = 10.0;
        self.start_y = 10.0;
        self.line_h = 0.0;
        self.same_line_flag = false;
        self.prev_item_w = 0.0;
        self.indent_x = 0.0;
        self.id_prefix = "";
        self.in_window = false;
        self.prev_item_hovered = false;
        self.columns_count = 1;
        self.columns_idx = 0;
        self.has_next_shadow = false;
        self.next_shadow = nil;
        self.has_next_opacity = false;
        self.next_opacity = 1.0;
        self.has_next_disabled = false;
        self.next_disabled = false;

        // Auto-dismiss popup & combo on outside click
        if ((self.active_popup_id != "" or self.combo_open_id != "") and self.mouse_pressed) {
            var in_popup = (self.mouse_x >= self.popup_x and self.mouse_x <= (self.popup_x + self.popup_w) and
            self.mouse_y >= self.popup_y and self.mouse_y <= (self.popup_y + self.popup_h));
            var in_combo_btn = false;
            if (self.combo_open_id != "") {
                in_combo_btn = (self.mouse_x >= self.deferred_combo_bx and self.mouse_x <= (self.deferred_combo_bx + self.deferred_combo_w) and
                self.mouse_y >= self.deferred_combo_by and self.mouse_y <= (self.deferred_combo_by + self.deferred_combo_h));
            }
            if (not in_popup and not in_combo_btn) {
                self.active_popup_id = "";
                self.combo_open_id = "";
            }
        }
    }

    pub fn is_occluded(x: float, y: float, w: float, h: float): bool {
        if (self.active_popup_id != "" or self.combo_open_id != "") {
            if (self.mouse_x >= self.popup_x and self.mouse_x <= (self.popup_x + self.popup_w) and
            self.mouse_y >= self.popup_y and self.mouse_y <= (self.popup_y + self.popup_h)) {
                return true;
            }
        }
        return false;
    }

    pub fn render_deferred_combo(): nil {
        if (not self.has_deferred_combo) { return; }

        var bx = self.deferred_combo_bx;
        var by = self.deferred_combo_by;
        var w = self.deferred_combo_w;
        var h = self.deferred_combo_h;
        var items = self.deferred_combo_items;
        var selected_idx = self.deferred_combo_selected;
        var item_count = len(items);
        var popup_h = (item_count as float) * h;
        var popup_y = by + h + 2.0;
        var rad = self.get_style_var(types.VAR_ROUNDING, self.theme.rounding);

        // Elevation drop shadow for combo dropdown (top z-index)
        var raw_csh = self.get_active_shadow();
        if (raw_csh != nil) {
            val csh = raw_csh as shadow.Shadow;
            if (csh.a > 0.0) {
                gg.draw_shadow_primitive(bx, popup_y, w, popup_h, csh.r, csh.g, csh.b, csh.a, csh.offset_x, csh.offset_y, csh.blur_radius, csh.spread_radius);
            }
        } elif (self.theme.popup_shadow != nil) {
            val csh = self.theme.popup_shadow as shadow.Shadow;
            if (csh.a > 0.0) {
                gg.draw_shadow_primitive(bx, popup_y, w, popup_h, csh.r, csh.g, csh.b, csh.a, csh.offset_x, csh.offset_y, csh.blur_radius, csh.spread_radius);
            }
        }

        var pbg = self.get_style_color(types.COLOR_PANEL_BG);
        var popup_border = self.get_style_color(types.COLOR_ACCENT);
        if (rad > 0.0) {
            gg.draw_rect_rounded_primitive(bx, popup_y, w, popup_h, rad, pbg.r, pbg.g, pbg.b, pbg.a);
            gg.draw_rect_border_primitive(bx, popup_y, w, popup_h, rad, 1.0, popup_border.r, popup_border.g, popup_border.b, popup_border.a);
        } else {
            gg.draw_rect_primitive(bx, popup_y, w, popup_h, pbg.r, pbg.g, pbg.b, pbg.a);
            gg.draw_rect_primitive(bx, popup_y, w, 1.0, popup_border.r, popup_border.g, popup_border.b, popup_border.a);
            gg.draw_rect_primitive(bx, popup_y + popup_h - 1.0, w, 1.0, popup_border.r, popup_border.g, popup_border.b, popup_border.a);
            gg.draw_rect_primitive(bx, popup_y, 1.0, popup_h, popup_border.r, popup_border.g, popup_border.b, popup_border.a);
            gg.draw_rect_primitive(bx + w - 1.0, popup_y, 1.0, popup_h, popup_border.r, popup_border.g, popup_border.b, popup_border.a);
        }

        var k = 0;
        while (k < item_count) {
            var iy = popup_y + (k as float) * h;
            var item_hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and
            self.mouse_y >= iy and self.mouse_y <= (iy + h));
            if (item_hovered) {
                var hbg = self.get_style_color(types.COLOR_FRAME_BG_HOVER);
                if (rad > 0.0) {
                    gg.draw_rect_rounded_primitive(bx + 2.0, iy + 1.0, w - 4.0, h - 2.0, rad, hbg.r, hbg.g, hbg.b, hbg.a);
                } else {
                    gg.draw_rect_primitive(bx, iy, w, h, hbg.r, hbg.g, hbg.b, hbg.a);
                }
                if (self.mouse_pressed) {
                    self.combo_selected_new = k;
                    self.combo_selected_changed = true;
                    self.combo_open_id = "";
                    self.active_popup_id = "";
                    self.has_deferred_combo = false;
                }
            }
            var itc = self.get_style_color(types.COLOR_TEXT);
            if (k == selected_idx) { itc = self.get_style_color(types.COLOR_ACCENT); }
            gg.draw_text(items[k], bx + 8.0, iy + (h - 8.0 * (self.theme.font_scale as float)) / 2.0, itc.r, itc.g, itc.b, itc.a, self.theme.font_scale);
            k = k + 1;
        }
    }

    pub fn end(): nil {
        if (self.in_window) {
            self.end_window();
        }
        if (self.has_deferred_combo) {
            self.render_deferred_combo();
        }
        if (self.mouse_released) {
            self.active_id = "";
        }
    }

    pub fn set_theme(new_theme: types.GUITheme): nil {
        self.theme = new_theme;
    }

    // ── Moddability: Style Stack ───────────────────────────────────────────────

    pub fn push_style_color(idx: int, c: color.Color): nil {
        if (self.style_color_top < len(self.style_color_indices)) {
            self.style_color_indices[self.style_color_top] = idx;
            self.style_color_stack[self.style_color_top] = c;
        } else {
            self.style_color_indices.append(idx);
            self.style_color_stack.append(c);
        }
        self.style_color_top = self.style_color_top + 1;
    }

    pub fn push_color_role(role: types.ColorRole, c: color.Color): nil {
        self.push_style_color(role as int, c);
    }

    pub fn pop_style_color(count: int = 1): nil {
        self.style_color_top = self.style_color_top - count;
        if (self.style_color_top < 0) { self.style_color_top = 0; }
    }

    pub fn push_style_var(idx: int, value: float): nil {
        if (self.style_var_top < len(self.style_var_indices)) {
            self.style_var_indices[self.style_var_top] = idx;
            self.style_var_stack[self.style_var_top] = value;
        } else {
            self.style_var_indices.append(idx);
            self.style_var_stack.append(value);
        }
        self.style_var_top = self.style_var_top + 1;
    }

    pub fn pop_style_var(count: int = 1): nil {
        self.style_var_top = self.style_var_top - count;
        if (self.style_var_top < 0) { self.style_var_top = 0; }
    }

    // ── Immediate-Mode Modifiers (Shadows & Effects) ─────────────────────────

    pub fn set_next_shadow(s: shadow.Shadow | nil): nil {
        self.next_shadow = s;
        self.has_next_shadow = true;
    }

    pub fn shadow(s: shadow.Shadow | nil): GUI {
        self.set_next_shadow(s);
        return self;
    }

    pub fn opacity(o: float): GUI {
        self.next_opacity = o;
        self.has_next_opacity = true;
        return self;
    }

    pub fn disabled(d: bool = true): GUI {
        self.next_disabled = d;
        self.has_next_disabled = true;
        return self;
    }

    pub fn push_shadow(s: shadow.Shadow): nil {
        if (self.shadow_stack_top < len(self.shadow_stack)) {
            self.shadow_stack[self.shadow_stack_top] = s;
        } else {
            self.shadow_stack.append(s);
        }
        self.shadow_stack_top = self.shadow_stack_top + 1;
    }

    pub fn pop_shadow(): nil {
        if (self.shadow_stack_top > 0) {
            self.shadow_stack_top = self.shadow_stack_top - 1;
        }
    }

    pub fn get_active_shadow(): shadow.Shadow | nil {
        if (self.has_next_shadow) {
            val s = self.next_shadow;
            self.has_next_shadow = false;
            self.next_shadow = nil;
            return s;
        }
        if (self.shadow_stack_top > 0) {
            return self.shadow_stack[self.shadow_stack_top - 1];
        }
        return nil;
    }

    pub fn get_style_color(idx: int): color.Color {
        var i = self.style_color_top - 1;
        while (i >= 0) {
            if (self.style_color_indices[i] == idx) {
                return self.style_color_stack[i];
            }
            i = i - 1;
        }
        return self.get_color_role(types.color_role_from_index(idx));
    }

    pub fn get_style_var(idx: int, default_value: float): float {
        var i = self.style_var_top - 1;
        while (i >= 0) {
            if (self.style_var_indices[i] == idx) {
                return self.style_var_stack[i];
            }
            i = i - 1;
        }
        return self.get_var_type(types.style_var_from_index(idx), default_value);
    }

    pub fn get_color_role(role: types.ColorRole): color.Color {
        match (role) {
            types.ColorRole.WindowBg => { return self.theme.bg_window; },
            types.ColorRole.WindowTitle => { return self.theme.bg_window_title; },
            types.ColorRole.PanelBg => { return self.theme.bg_panel; },
            types.ColorRole.Text => { return self.theme.text; },
            types.ColorRole.TextMuted => { return self.theme.text_muted; },
            types.ColorRole.Accent => { return self.theme.accent; },
            types.ColorRole.Button => { return self.theme.btn_normal; },
            types.ColorRole.ButtonHover => { return self.theme.btn_hover; },
            types.ColorRole.ButtonActive => { return self.theme.btn_active; },
            types.ColorRole.SliderTrack => { return self.theme.slider_track; },
            types.ColorRole.SliderThumb => { return self.theme.slider_thumb; },
            types.ColorRole.CheckboxBorder => { return self.theme.checkbox_border; },
            types.ColorRole.CheckboxCheck => { return self.theme.checkbox_check; },
            types.ColorRole.Separator => { return self.theme.separator; },
            types.ColorRole.FrameBg => { return self.theme.frame_bg; },
            types.ColorRole.FrameBgHover => { return self.theme.frame_bg_hover; },
            types.ColorRole.FrameBgActive => { return self.theme.frame_bg_active; },
            types.ColorRole.Tab => { return self.theme.tab_normal; },
            types.ColorRole.TabActive => { return self.theme.tab_active; },
            types.ColorRole.PlotLines => { return self.theme.plot_lines; },
            types.ColorRole.PlotHistogram => { return self.theme.plot_histogram; },
            _ => { return self.theme.text; }
        }
    }

    pub fn get_var_type(v: types.StyleVar, default_value: float): float {
        match (v) {
            types.StyleVar.Padding => { return self.theme.padding; },
            types.StyleVar.Spacing => { return self.theme.spacing; },
            types.StyleVar.ItemHeight => { return self.theme.item_height; },
            types.StyleVar.Rounding => { return self.theme.rounding; },
            _ => { return default_value; }
        }
    }


    // ── ID & Scoping ───────────────────────────────────────────────────────────

    pub fn make_id(label: str): str {
        if (self.id_prefix == "") {
            return label;
        }
        return self.id_prefix + "/" + label;
    }

    pub fn push_id(prefix: str): nil {
        if (self.id_prefix == "") {
            self.id_prefix = prefix;
        } else {
            self.id_prefix = self.id_prefix + "/" + prefix;
        }
    }

    pub fn pop_id(): nil {
        var n = len(self.id_prefix);
        var last_slash = -1;
        var i = 0;
        while (i < n) {
            if (_builtin_substring(self.id_prefix, i, i + 1) == "/") {
                last_slash = i;
            }
            i = i + 1;
        }
        if (last_slash != -1) {
            self.id_prefix = _builtin_substring(self.id_prefix, 0, last_slash);
        } else {
            self.id_prefix = "";
        }
    }

    // ── Layout Cursor ──────────────────────────────────────────────────────────

    pub fn set_cursor(x: float, y: float): nil {
        self.cursor_x = x;
        self.cursor_y = y;
    }

    pub fn same_line(spacing: float = -1.0): nil {
        var sp = spacing;
        if (sp < 0.0) {
            sp = self.get_style_var(types.VAR_SPACING, self.theme.spacing);
        }
        self.same_line_flag = true;
        self.cursor_x = self.prev_item_rect.x + self.prev_item_rect.w + sp;
        self.cursor_y = self.prev_item_rect.y;
    }

    pub fn spacing(amount: float = -1.0): nil {
        var sp = amount;
        if (sp < 0.0) {
            sp = self.get_style_var(types.VAR_SPACING, self.theme.spacing);
        }
        self.cursor_y = self.cursor_y + sp;
    }

    pub fn indent(amount: float = 16.0): nil {
        self.indent_x = self.indent_x + amount;
        self.cursor_x = self.cursor_x + amount;
    }

    pub fn unindent(amount: float = 16.0): nil {
        self.indent_x = self.indent_x - amount;
        if (self.indent_x < 0.0) {
            self.indent_x = 0.0;
        }
        self.cursor_x = self.start_x + self.indent_x;
    }

    fn advance(item_w: float, item_h: float): nil {
        self.prev_item_w = item_w;
        var sp = self.get_style_var(types.VAR_SPACING, self.theme.spacing);
        if (self.same_line_flag) {
            self.same_line_flag = false;
            if (item_h > self.line_h) {
                self.line_h = item_h;
            }
            self.cursor_y = self.prev_item_rect.y + self.line_h + sp;
            self.cursor_x = self.start_x + self.indent_x;
        } else {
            self.cursor_x = self.start_x + self.indent_x;
            self.line_h = item_h;
            self.cursor_y = self.prev_item_rect.y + item_h + sp;
        }
    }

    // ── Multi-column Layout ────────────────────────────────────────────────────

    pub fn columns(count: int, width: float = -1.0): nil {
        self.columns_count = count;
        self.columns_idx = 0;
        self.columns_start_x = self.cursor_x;
        var total_w = width;
        if (total_w <= 0.0) {
            if (self.in_window) {
                var pad = self.get_style_var(types.VAR_PADDING, self.theme.padding);
                total_w = self.cur_window_w - 2.0 * pad;
            } else {
                total_w = 400.0;
            }
        }
        self.columns_width = total_w / (count as float);
    }

    pub fn next_column(): nil {
        if (self.columns_count <= 1) { return; }
        self.columns_idx = self.columns_idx + 1;
        if (self.columns_idx >= self.columns_count) {
            self.columns_idx = 0;
            self.cursor_x = self.columns_start_x;
            var sp = self.get_style_var(types.VAR_SPACING, self.theme.spacing);
            self.cursor_y = self.cursor_y + self.line_h + sp;
        } else {
            self.cursor_x = self.columns_start_x + (self.columns_idx as float) * self.columns_width;
        }
    }

    // ── Basic IMGUI Controls ───────────────────────────────────────────────────

    fn _draw_button_shadow(sh: shadow.Shadow, bx: float, by: float, w: float, h: float, active_opacity: float, hovered: bool, is_active: bool): nil {
        if (sh.a > 0.0) {
            var s_alpha = sh.a * active_opacity;
            var s_y = sh.offset_y;
            var s_blur = sh.blur_radius;
            if (is_active) {
                s_alpha = s_alpha * 0.5;
                s_y = s_y * 0.5;
                s_blur = s_blur * 0.5;
            } elif (hovered) {
                s_alpha = s_alpha * 1.25;
                if (s_alpha > 1.0) { s_alpha = 1.0; }
                s_y = s_y * 1.3;
                s_blur = s_blur * 1.3;
            }
            gg.draw_shadow_primitive(bx, by, w, h, sh.r, sh.g, sh.b, s_alpha, sh.offset_x, s_y, s_blur, sh.spread_radius);
        }
    }

    pub fn draw_rect(x: float, y: float, w: float, h: float, col: color.Color): nil {
        gg.draw_rect_primitive(x, y, w, h, col.r, col.g, col.b, col.a);
    }

    pub fn label(text: str, custom_color: color.Color | nil = nil): nil {
        var c = self.get_style_color(types.COLOR_TEXT);
        if (custom_color != nil) {
            c = custom_color as color.Color;
        }
        var w = (len(text) * 8 * self.theme.font_scale) as float;
        var h = (8 * self.theme.font_scale + 4) as float;

        gg.draw_text(text, self.cursor_x, self.cursor_y + 2.0, c.r, c.g, c.b, c.a, self.theme.font_scale);
        self.prev_item_hovered = (self.mouse_x >= self.cursor_x and self.mouse_x <= (self.cursor_x + w) and
        self.mouse_y >= self.cursor_y and self.mouse_y <= (self.cursor_y + h));
        self.prev_item_rect = types.rect(self.cursor_x, self.cursor_y, w, h);
        self.advance(w, h);
    }

    pub fn button(text: str, width: float = 0.0, height: float = 0.0): bool {
        var w = width;
        if (w <= 0.0) {
            w = (len(text) * 8 * self.theme.font_scale + 24) as float;
        }
        var h = height;
        if (h <= 0.0) {
            h = self.get_style_var(types.VAR_ITEM_HEIGHT, self.theme.item_height);
        }

        var is_disabled = false;
        if (self.has_next_disabled) {
            is_disabled = self.next_disabled;
            self.has_next_disabled = false;
            self.next_disabled = false;
        }

        var active_opacity = 1.0;
        if (self.has_next_opacity) {
            active_opacity = self.next_opacity;
            self.has_next_opacity = false;
            self.next_opacity = 1.0;
        }

        var id = self.make_id(text);
        var bx = self.cursor_x;
        var by = self.cursor_y;

        var hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and
        self.mouse_y >= by and self.mouse_y <= (by + h));


        if (hovered and self.is_occluded(bx, by, w, h)) {
            var in_active_popup = (bx >= self.popup_x and (bx + w) <= (self.popup_x + self.popup_w) and
            by >= self.popup_y and (by + h) <= (self.popup_y + self.popup_h));
            if (not in_active_popup) {
                hovered = false;
            }
        }

        if (is_disabled) {
            hovered = false;
        }

        if (hovered) {
            self.hot_id = id;
        }

        var clicked = false;
        var is_focused = false;
        if (not is_disabled) {
            if (self.active_id == id) {
                if (self.mouse_released or not self.mouse_down) {
                    self.active_id = "";
                    if (hovered) {
                        clicked = true;
                    }
                }
            } elif (hovered and self.mouse_pressed) {
                self.active_id = id;
                self.focus_manager.request_focus(id);
                if (self.mouse_released or not self.mouse_down) {
                    self.active_id = "";
                    clicked = true;
                }
            }

            is_focused = (self.active_id == id or self.focus_manager.has_focus(id));
            if (is_focused and (self.is_key_pressed(13) or self.is_key_pressed(32))) {
                clicked = true;
            }
        }

        var hover_target = 0.0;
        if (hovered) { hover_target = 1.0; }
        var ast = self.anim_store.get_or_create(id);
        var hover_t = ast.animate_property("hover_t", hover_target, 0.15, anim.Easing.Out, self.dt);

        var bg = self.get_style_color(types.COLOR_BUTTON);
        if (is_disabled) {
            bg = self.get_style_color(types.COLOR_FRAME_BG);
            bg.a = bg.a * 0.5;
        } elif (self.active_id == id) {
            bg = self.get_style_color(types.COLOR_BUTTON_ACTIVE);
        } else if (hover_t > 0.0) {
            var hbg = self.get_style_color(types.COLOR_BUTTON_HOVER);
            bg = color.Color(
                r=anim.lerp_float(bg.r, hbg.r, hover_t),
                g=anim.lerp_float(bg.g, hbg.g, hover_t),
                b=anim.lerp_float(bg.b, hbg.b, hover_t),
                a=anim.lerp_float(bg.a, hbg.a, hover_t)
            );
        }

        if (active_opacity < 1.0) {
            bg.a = bg.a * active_opacity;
        }

        // Optional Button Elevation Drop Shadow (opt-in via set_next_shadow, shadow(), shadow_stack, or theme)
        if (not is_disabled) {
            var raw_sh = self.get_active_shadow();
            if (raw_sh != nil) {
                self._draw_button_shadow(raw_sh as shadow.Shadow, bx, by, w, h, active_opacity, hovered, self.active_id == id);
            } elif (self.theme.button_shadow != nil) {
                self._draw_button_shadow(self.theme.button_shadow as shadow.Shadow, bx, by, w, h, active_opacity, hovered, self.active_id == id);
            }
        }

        // Button Base
        var rad = self.get_style_var(types.VAR_ROUNDING, self.theme.rounding);
        if (rad > 0.0) {
            gg.draw_rect_rounded_primitive(bx, by, w, h, rad, bg.r, bg.g, bg.b, bg.a);
            var border_col = color.Color(r=bg.r + 0.12, g=bg.g + 0.12, b=bg.b + 0.12, a=0.45);
            if (hovered) {
                var acc = self.get_style_color(types.COLOR_ACCENT);
                border_col = color.Color(r=acc.r, g=acc.g, b=acc.b, a=0.7);
            }
            gg.draw_rect_border_primitive(bx, by, w, h, rad, 1.0, border_col.r, border_col.g, border_col.b, border_col.a);
        } else {
            gg.draw_rect_primitive(bx, by, w, h, bg.r, bg.g, bg.b, bg.a);
        }

        // Focus Highlight Ring
        if (is_focused and not is_disabled) {
            var focus_color = self.get_style_color(types.COLOR_ACCENT);
            var f_alpha = 0.95 * active_opacity;
            gg.draw_rect_primitive(bx - 1.0, by - 1.0, w + 2.0, 1.0, focus_color.r, focus_color.g, focus_color.b, f_alpha);
            gg.draw_rect_primitive(bx - 1.0, by + h, w + 2.0, 1.0, focus_color.r, focus_color.g, focus_color.b, f_alpha);
            gg.draw_rect_primitive(bx - 1.0, by, 1.0, h, focus_color.r, focus_color.g, focus_color.b, f_alpha);
            gg.draw_rect_primitive(bx + w, by, 1.0, h, focus_color.r, focus_color.g, focus_color.b, f_alpha);
        }

        var text_w = (len(text) * 8 * self.theme.font_scale) as float;
        var text_x = bx + (w - text_w) / 2.0;
        var text_y = by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0;
        var tc = self.get_style_color(types.COLOR_TEXT);
        if (is_disabled) {
            tc = self.get_style_color(types.COLOR_TEXT_MUTED);
        }
        if (active_opacity < 1.0) {
            tc.a = tc.a * active_opacity;
        }
        gg.draw_text(text, text_x, text_y, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);

        self.prev_item_hovered = hovered;
        self.prev_item_rect = types.rect(bx, by, w, h);
        self.advance(w, h);
        return clicked;
    }

    pub fn button_colored(text: str, bg_color: color.Color, width: float = 0.0, height: float = 0.0): bool {
        self.push_style_color(types.COLOR_BUTTON, bg_color);
        var res = self.button(text, width, height);
        self.pop_style_color(1);
        return res;
    }

    pub fn checkbox(label: str, checked: bool): bool {
        var box_size = 18.0;
        var h = self.get_style_var(types.VAR_ITEM_HEIGHT, self.theme.item_height);
        var id = self.make_id(label);
        var bx = self.cursor_x;
        var by = self.cursor_y;
        var total_w = box_size + 8.0 + (len(label) * 8 * self.theme.font_scale) as float;

        var hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + total_w) and
        self.mouse_y >= by and self.mouse_y <= (by + h));

        if (hovered and self.is_occluded(bx, by, total_w, h)) {
            hovered = false;
        }

        if (hovered) {
            self.hot_id = id;
        }

        var new_checked = checked;
        if (hovered and self.mouse_pressed) {
            new_checked = not checked;
        }

        var box_y = by + (h - box_size) / 2.0;
        var rad = self.get_style_var(types.VAR_ROUNDING, self.theme.rounding);
        if (rad > 4.0) { rad = 4.0; }

        var border = self.get_style_color(types.COLOR_CHECKBOX_BORDER);
        if (hovered or new_checked) {
            border = self.get_style_color(types.COLOR_ACCENT);
        }

        var bg = self.get_style_color(types.COLOR_FRAME_BG);
        if (new_checked) {
            bg = self.get_style_color(types.COLOR_ACCENT);
        }

        if (rad > 0.0) {
            gg.draw_rect_rounded_primitive(bx, box_y, box_size, box_size, rad, bg.r, bg.g, bg.b, bg.a);
            gg.draw_rect_border_primitive(bx, box_y, box_size, box_size, rad, 1.5, border.r, border.g, border.b, border.a);
        } else {
            gg.draw_rect_primitive(bx, box_y, box_size, box_size, bg.r, bg.g, bg.b, bg.a);
            gg.draw_rect_primitive(bx, box_y, box_size, 1.0, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(bx, box_y + box_size - 1.0, box_size, 1.0, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(bx, box_y, 1.0, box_size, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(bx + box_size - 1.0, box_y, 1.0, box_size, border.r, border.g, border.b, border.a);
        }

        if (new_checked) {
            var check_col = self.get_style_color(types.COLOR_CHECKBOX_CHECK);
            gg.draw_line_primitive(bx + 4.5, box_y + 9.5, bx + 7.5, box_y + 13.0, check_col.r, check_col.g, check_col.b, check_col.a, 2.0);
            gg.draw_line_primitive(bx + 7.5, box_y + 13.0, bx + 13.5, box_y + 5.5, check_col.r, check_col.g, check_col.b, check_col.a, 2.0);
        }

        var text_x = bx + box_size + 8.0;
        var text_y = by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0;
        var tc = self.get_style_color(types.COLOR_TEXT);
        gg.draw_text(label, text_x, text_y, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);

        self.prev_item_hovered = hovered;
        self.prev_item_rect = types.rect(bx, by, total_w, h);
        self.advance(total_w, h);
        return new_checked;
    }

    pub fn radio_button(label: str, active: bool): bool {
        var size = 16.0;
        var h = self.get_style_var(types.VAR_ITEM_HEIGHT, self.theme.item_height);
        var id = self.make_id(label);
        var bx = self.cursor_x;
        var by = self.cursor_y;
        var total_w = size + 8.0 + (len(label) * 8 * self.theme.font_scale) as float;

        var hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + total_w) and
        self.mouse_y >= by and self.mouse_y <= (by + h));
        if (hovered) { self.hot_id = id; }

        var clicked = false;
        if (hovered and self.mouse_pressed) {
            clicked = true;
        }

        var radio_y = by + (h - size) / 2.0;
        var border = self.get_style_color(types.COLOR_CHECKBOX_BORDER);
        if (hovered or active) { border = self.get_style_color(types.COLOR_ACCENT); }
        var bg = self.get_style_color(types.COLOR_FRAME_BG);
        var rad = size * 0.5;

        // Circular radio outline
        gg.draw_rect_rounded_primitive(bx, radio_y, size, size, rad, bg.r, bg.g, bg.b, bg.a);
        gg.draw_rect_border_primitive(bx, radio_y, size, size, rad, 1.5, border.r, border.g, border.b, border.a);

        if (active) {
            var check_col = self.get_style_color(types.COLOR_ACCENT);
            var dot_s = size - 8.0;
            gg.draw_rect_rounded_primitive(bx + 4.0, radio_y + 4.0, dot_s, dot_s, dot_s * 0.5, check_col.r, check_col.g, check_col.b, check_col.a);
        }

        var tc = self.get_style_color(types.COLOR_TEXT);
        var text_y = by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0;
        gg.draw_text(label, bx + size + 8.0, text_y, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);

        self.prev_item_hovered = hovered;
        self.prev_item_rect = types.rect(bx, by, total_w, h);
        self.advance(total_w, h);
        return clicked;
    }

    pub fn toggle(label: str, enabled: bool): bool {
        var pill_w = 36.0;
        var pill_h = 20.0;
        var h = self.get_style_var(types.VAR_ITEM_HEIGHT, self.theme.item_height);
        var id = self.make_id(label);
        var bx = self.cursor_x;
        var by = self.cursor_y;
        var total_w = pill_w + 8.0 + (len(label) * 8 * self.theme.font_scale) as float;

        var hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + total_w) and
        self.mouse_y >= by and self.mouse_y <= (by + h));

        if (hovered and self.is_occluded(bx, by, total_w, h)) {
            hovered = false;
        }

        if (hovered) {
            self.hot_id = id;
        }

        var new_enabled = enabled;
        if (hovered and self.mouse_pressed) {
            new_enabled = not enabled;
        }

        var pill_y = by + (h - pill_h) / 2.0;
        var bg = self.get_style_color(types.COLOR_BUTTON);
        if (new_enabled) {
            bg = self.get_style_color(types.COLOR_ACCENT);
        }
        var pill_rad = pill_h * 0.5;
        gg.draw_rect_rounded_primitive(bx, pill_y, pill_w, pill_h, pill_rad, bg.r, bg.g, bg.b, bg.a);

        var thumb_size = pill_h - 4.0;
        var thumb_x = bx + 2.0;
        if (new_enabled) {
            thumb_x = bx + pill_w - thumb_size - 2.0;
        }
        var thumb_rad = thumb_size * 0.5;
        gg.draw_rect_rounded_primitive(thumb_x, pill_y + 2.0, thumb_size, thumb_size, thumb_rad, 1.0, 1.0, 1.0, 1.0);

        var tc = self.get_style_color(types.COLOR_TEXT);
        var text_y = by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0;
        gg.draw_text(label, bx + pill_w + 8.0, text_y, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);

        self.prev_item_hovered = hovered;
        self.prev_item_rect = types.rect(bx, by, total_w, h);
        self.advance(total_w, h);
        return new_enabled;
    }

    pub fn slider(label: str, value: float, min_val: float, max_val: float, width: float = 160.0): float {
        var w = width;
        var track_h = 6.0;
        var thumb_size = 14.0;
        var h = self.get_style_var(types.VAR_ITEM_HEIGHT, self.theme.item_height);
        var id = self.make_id(label);
        var bx = self.cursor_x;
        var by = self.cursor_y;

        var hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and
        self.mouse_y >= by and self.mouse_y <= (by + h));


        if (hovered and self.is_occluded(bx, by, w, h)) {
            hovered = false;
        }

        if (hovered) {
            self.hot_id = id;
        }

        var current_val = value;
        if (self.active_id == id) {
            if (self.mouse_down) {
                var norm = widget.clamp_value((self.mouse_x - bx) / w, 0.0, 1.0);
                current_val = widget.ratio_to_value(norm, min_val, max_val);
            } else {
                self.active_id = "";
            }
        } elif ((self.active_id == "" or self.active_id == id) and hovered and (self.mouse_pressed or (self.mouse_down and self.active_id == id))) {
            self.active_id = id;
            var norm2 = widget.clamp_value((self.mouse_x - bx) / w, 0.0, 1.0);
            current_val = widget.ratio_to_value(norm2, min_val, max_val);
        }

        var track_y = by + (h - track_h) / 2.0;
        var track_rad = track_h * 0.5;
        var track_color = self.get_style_color(types.COLOR_SLIDER_TRACK);
        gg.draw_rect_rounded_primitive(bx, track_y, w, track_h, track_rad, track_color.r, track_color.g, track_color.b, track_color.a);

        var t = widget.value_to_ratio(current_val, min_val, max_val);

        // Active fill from left to thumb
        var fill_w = t * w;
        if (fill_w > 0.0) {
            var acc = self.get_style_color(types.COLOR_ACCENT);
            gg.draw_rect_rounded_primitive(bx, track_y, fill_w, track_h, track_rad, acc.r, acc.g, acc.b, acc.a * 0.85);
        }

        var thumb_x = bx + t * (w - thumb_size);
        var thumb_y = by + (h - thumb_size) / 2.0;
        var thumb_rad = thumb_size * 0.5;

        var thumb_color = self.get_style_color(types.COLOR_SLIDER_THUMB);
        if (self.active_id == id or self.hot_id == id) {
            if (self.theme.slider_thumb_hover != nil) {
                thumb_color = self.theme.slider_thumb_hover;
            } else {
                thumb_color = self.get_style_color(types.COLOR_ACCENT);
            }
        }
        gg.draw_rect_rounded_primitive(thumb_x, thumb_y, thumb_size, thumb_size, thumb_rad, thumb_color.r, thumb_color.g, thumb_color.b, thumb_color.a);
        gg.draw_rect_border_primitive(thumb_x, thumb_y, thumb_size, thumb_size, thumb_rad, 1.5, 1.0, 1.0, 1.0, 0.95);

        if (label != "") {
            var ltc = self.get_style_color(types.COLOR_TEXT_MUTED);
            var label_x = bx + w + 8.0;
            var label_y = by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0;
            gg.draw_text(label, label_x, label_y, ltc.r, ltc.g, ltc.b, ltc.a, self.theme.font_scale);
        }

        self.prev_item_hovered = hovered;
        self.prev_item_rect = types.rect(bx, by, w, h);
        self.advance(w + 80.0, h);
        return current_val;
    }

    pub fn slider_int(label: str, value: int, min_val: int = 0, max_val: int = 100, w: float = 140.0): int {
        var diff_range: int = max_val - min_val;
        if (diff_range <= 0) { diff_range = 1; }
        var range: float = diff_range * 1.0;

        var val_diff: int = value - min_val;
        var norm_val: float = (val_diff * 1.0) / range;

        var new_norm = self.slider(label, norm_val, 0.0, 1.0, w);
        var scaled_f: float = new_norm * range;
        var min_f: float = min_val * 1.0;
        var final_f: float = min_f + scaled_f + 0.5;
        var result: int = final_f as int;

        if (result < min_val) { result = min_val; }
        if (result > max_val) { result = max_val; }
        return result;
    }


    pub fn stepper_int(label: str, value: int, step: int = 1, min_val: int = 0, max_val: int = 100): int {
        var h = self.get_style_var(types.VAR_ITEM_HEIGHT, self.theme.item_height);
        var btn_w = 24.0;
        var box_w = 60.0;
        var by = self.cursor_y;

        var new_val = value;
        if (self.button(" - ", btn_w, h)) {
            new_val = new_val - step;
            if (new_val < min_val) { new_val = min_val; }
        }
        self.same_line();

        var val_str = "{new_val}";
        var tc = self.get_style_color(types.COLOR_TEXT);
        var fbg = self.get_style_color(types.COLOR_FRAME_BG);
        var vx = self.cursor_x;
        gg.draw_rect_primitive(vx, by, box_w, h, fbg.r, fbg.g, fbg.b, fbg.a);
        var text_w = (len(val_str) * 8 * self.theme.font_scale) as float;
        gg.draw_text(val_str, vx + (box_w - text_w) / 2.0, by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);
        self.advance(box_w, h);
        self.same_line();

        if (self.button(" + ", btn_w, h)) {
            new_val = new_val + step;
            if (new_val > max_val) { new_val = max_val; }
        }

        if (label != "") {
            self.same_line();
            var ltc = self.get_style_color(types.COLOR_TEXT_MUTED);
            gg.draw_text(label, self.cursor_x + 4.0, by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0, ltc.r, ltc.g, ltc.b, ltc.a, self.theme.font_scale);
            var lw = (len(label) * 8 * self.theme.font_scale) as float;
            self.advance(lw + 4.0, h);
        }

        return new_val;
    }

    pub fn stepper_float(label: str, value: float, step: float = 0.1, min_val: float = 0.0, max_val: float = 1.0): float {
        var h = self.get_style_var(types.VAR_ITEM_HEIGHT, self.theme.item_height);
        var btn_w = 24.0;
        var box_w = 60.0;
        var by = self.cursor_y;

        var new_val = value;
        if (self.button(" - ", btn_w, h)) {
            new_val = new_val - step;
            if (new_val < min_val) { new_val = min_val; }
        }
        self.same_line();

        var val_str = "{new_val}";
        var tc = self.get_style_color(types.COLOR_TEXT);
        var fbg = self.get_style_color(types.COLOR_FRAME_BG);
        var vx = self.cursor_x;
        gg.draw_rect_primitive(vx, by, box_w, h, fbg.r, fbg.g, fbg.b, fbg.a);
        var text_w = (len(val_str) * 8 * self.theme.font_scale) as float;
        gg.draw_text(val_str, vx + (box_w - text_w) / 2.0, by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);
        self.advance(box_w, h);
        self.same_line();


        if (self.button(" + ", btn_w, h)) {
            new_val = new_val + step;
            if (new_val > max_val) { new_val = max_val; }
        }

        if (label != "") {
            self.same_line();
            var ltc = self.get_style_color(types.COLOR_TEXT_MUTED);
            gg.draw_text(label, self.cursor_x + 4.0, by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0, ltc.r, ltc.g, ltc.b, ltc.a, self.theme.font_scale);
            var lw = (len(label) * 8 * self.theme.font_scale) as float;
            self.advance(lw + 4.0, h);
        }

        return new_val;
    }


    pub fn is_key_down(k: int): bool {
        iter (kd in self.keys_down) {
            if (kd == k) { return true; }
        }
        return false;
    }

    pub fn is_key_pressed(k: int): bool {
        iter (kp in self.keys_pressed) {
            if (kp == k) { return true; }
        }
        return false;
    }

    pub fn get_typed_chars(): [int] {
        return self.typed_chars;
    }

    pub fn get_editor_controller(label: str): text_ctrl.EditorController | nil {
        var id = self.make_id(label);
        return self.editor_controllers[id];
    }

    pub fn set_multiline_selection(label: str, line: int, col: int, end_line: int, end_col: int): nil {
        var id = self.make_id(label);
        var ctrl_val = self.editor_controllers[id];
        if (ctrl_val != nil) {
            var ctrl = ctrl_val as text_ctrl.EditorController;
            ctrl.set_cursor(line, col);
            ctrl.set_selection(end_line, end_col);
            var lh = gg.get_line_height(self.theme.font_scale);
            var target_scroll = (line as float) * lh - 60.0;
            if (target_scroll < 0.0) { target_scroll = 0.0; }
            if (self.scroll_offsets != nil) {
                self.scroll_offsets[id] = target_scroll;
            }
        }
    }

    pub fn set_multiline_text(label: str, new_text: str): nil {
        var id = self.make_id(label);
        var ctrl_val = self.editor_controllers[id];
        if (ctrl_val != nil) {
            var ctrl = ctrl_val as text_ctrl.EditorController;
            ctrl.set_text(new_text);
        }
    }

    pub fn get_multiline_cursor(label: str): (int, int) {
        var id = self.make_id(label);
        var ctrl_val = self.editor_controllers[id];
        if (ctrl_val != nil) {
            var ctrl = ctrl_val as text_ctrl.EditorController;
            return (ctrl.get_cursor_line(), ctrl.get_cursor_col());
        }
        return (0, 0);
    }

    pub fn input_text_multiline(label: str, text: str, width: float, height: float, show_line_numbers: bool = true): str {
        var w = width;
        var h = height;
        var id = self.make_id(label);
        var bx = self.cursor_x;
        var by = self.cursor_y;

        if (self.editor_controllers[id] == nil) {
            var new_ctrl = text_ctrl.EditorController(text);
            self.editor_controllers[id] = new_ctrl;
        }
        var ctrl = self.editor_controllers[id] as text_ctrl.EditorController;
        ctrl.get_clipboard = self.get_clipboard_cb;
        ctrl.set_clipboard = self.set_clipboard_cb;

        var is_focused = (self.active_id == id or self.focus_manager.has_focus(id));
        if (not is_focused and text != ctrl.get_text()) {
            ctrl.set_text(text);
        }

        var lh = gg.get_line_height(self.theme.font_scale);
        var cur_scroll = 0.0;
        if (self.scroll_offsets != nil) {
            var scroll_val = self.scroll_offsets[id];
            if (scroll_val != nil) {
                cur_scroll = scroll_val as float;
            }
        }

        var gutter_w = 0.0;
        if (show_line_numbers) {
            gutter_w = 46.0;
        }
        var text_area_w = w - gutter_w - 2.0;
        var text_origin_x = bx + gutter_w + 8.0;

        var hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and
        self.mouse_y >= by and self.mouse_y <= (by + h));

        if (hovered and self.is_occluded(bx, by, w, h)) {
            hovered = false;
        }
        if (hovered) { self.hot_id = id; }
        if (hovered and self.mouse_pressed) {
            self.active_id = id;
            self.focus_manager.request_focus(id);

            var rel_x = self.mouse_x - text_origin_x;
            if (rel_x < 0.0) { rel_x = 0.0; }
            var rel_y = self.mouse_y - (by + 6.0) + cur_scroll;
            var hit = layout.hit_test_multiline(ctrl.get_lines(), rel_x, rel_y, lh, self.theme.font_scale);
            if (show_line_numbers and self.mouse_x < (bx + gutter_w)) {
                ctrl.set_cursor(hit[0], 0);
                var l_str = ctrl.get_line(hit[0]);
                var l_len = 0;
                if (l_str != nil) { l_len = len(l_str); }
                ctrl.set_selection(hit[0], l_len);
            } else {
                ctrl.set_cursor(hit[0], hit[1]);
            }
        } elif (self.active_id == id and self.mouse_down) {
            var rel_x = self.mouse_x - text_origin_x;
            if (rel_x < 0.0) { rel_x = 0.0; }
            var rel_y = self.mouse_y - (by + 6.0) + cur_scroll;
            var hit = layout.hit_test_multiline(ctrl.get_lines(), rel_x, rel_y, lh, self.theme.font_scale);
            ctrl.set_selection(hit[0], hit[1]);
        }

        var bg = self.get_style_color(types.COLOR_FRAME_BG);
        if (is_focused) {
            bg = self.get_style_color(types.COLOR_FRAME_BG_ACTIVE);

            const MOD_CTRL = 2; // MOD_CONTROL

            if (self.typed_chars != nil) {
                iter (cp in self.typed_chars) {
                    if (cp >= 32 and cp <= 126) {
                        var ch = _builtin_string_from_bytes([cp]);
                        ctrl.insert_text(ch);
                    } elif (cp == 10 or cp == 13) {
                        ctrl.insert_newline();
                    }
                }
            }

            if (self.is_key_pressed(8) or self.is_key_pressed(259)) { ctrl.backspace(); }
            if (self.is_key_pressed(257) or self.is_key_pressed(13) or self.is_key_pressed(10) or self.is_key_pressed(335)) {
                ctrl.insert_newline();
            }
            if (self.is_key_pressed(258) or self.is_key_pressed(9)) {
                ctrl.insert_text("    ");
            }
            if (self.is_key_pressed(262)) { ctrl.move_right(false); }
            if (self.is_key_pressed(263)) { ctrl.move_left(false); }
            if (self.is_key_pressed(264)) { ctrl.move_down(false); }
            if (self.is_key_pressed(265)) { ctrl.move_up(false); }
            if (self.is_key_pressed(90) and (self.active_modifiers & MOD_CTRL) != 0) { ctrl.undo(); }
            if (self.is_key_pressed(89) and (self.active_modifiers & MOD_CTRL) != 0) { ctrl.redo(); }
            if (self.is_key_pressed(67) and (self.active_modifiers & MOD_CTRL) != 0) { ctrl.copy(); }
            if (self.is_key_pressed(86) and (self.active_modifiers & MOD_CTRL) != 0) { ctrl.paste(); }
            if (self.is_key_pressed(88) and (self.active_modifiers & MOD_CTRL) != 0) {
                ctrl.cut();
            }
        } elif (hovered) {
            bg = self.get_style_color(types.COLOR_FRAME_BG_HOVER);
        }

        if (hovered and self.mouse_wheel != 0.0) {
            cur_scroll = cur_scroll - self.mouse_wheel * 20.0;
        }

        var total_content_h = (ctrl.get_line_count() as float) * lh + 12.0;
        var vp = viewport.Viewport(text_area_w, h - 2.0, text_area_w, total_content_h);
        vp.scroll_y = cur_scroll;

        if (is_focused) {
            var cur_line = ctrl.get_cursor_line();
            var line_text = ctrl.get_line(cur_line);
            if (line_text == nil) { line_text = ""; }
            var cur_col = ctrl.get_cursor_col();
            var prefix = "";
            if (cur_col > 0) {
                prefix = std_string.substring(line_text, 0, cur_col);
            }
            if (prefix == nil) { prefix = ""; }
            var cur_x = gg.measure_text(prefix, self.theme.font_scale);
            var cur_y = (cur_line as float) * lh;
            vp.ensure_visible(cur_x, cur_y, 2.0, lh);
        } else {
            vp.clamp_scroll();
        }
        if (self.scroll_offsets != nil) {
            self.scroll_offsets[id] = vp.scroll_y;
        }

        gg.draw_rect_primitive(bx, by, w, h, bg.r, bg.g, bg.b, bg.a);

        if (show_line_numbers) {
            var gbg = color.Color(r=bg.r * 0.85, g=bg.g * 0.85, b=bg.b * 0.85, a=bg.a);
            gg.draw_rect_primitive(bx + 1.0, by + 1.0, gutter_w, h - 2.0, gbg.r, gbg.g, gbg.b, gbg.a);
            var sep = self.get_style_color(types.COLOR_SEPARATOR);
            gg.draw_rect_primitive(bx + gutter_w, by + 1.0, 1.0, h - 2.0, sep.r, sep.g, sep.b, sep.a);
        }

        var border = self.theme.checkbox_border;
        if (is_focused) {
            border = self.get_style_color(types.COLOR_ACCENT);
        }
        gg.draw_rect_primitive(bx, by, w, 1.0, border.r, border.g, border.b, border.a);
        gg.draw_rect_primitive(bx, by + h - 1.0, w, 1.0, border.r, border.g, border.b, border.a);
        gg.draw_rect_primitive(bx, by, 1.0, h, border.r, border.g, border.b, border.a);
        gg.draw_rect_primitive(bx + w - 1.0, by, 1.0, h, border.r, border.g, border.b, border.a);

        var tc = self.get_style_color(types.COLOR_TEXT);

        var start_line = (vp.scroll_y / lh) as int;
        if (start_line < 0) start_line = 0;
        var visible_lines = ((h / lh) as int) + 2;
        var end_line = start_line + visible_lines;
        if (end_line > ctrl.get_line_count()) end_line = ctrl.get_line_count();

        // 1. Draw line numbers in gutter
        if (show_line_numbers) {
            gg.push_clip(bx + 1.0, by + 1.0, gutter_w - 1.0, h - 2.0);
            var gi = start_line;
            while (gi < end_line) {
                var g_cy = by + 6.0 - vp.scroll_y + (gi as float) * lh;
                var line_num_str = "{gi + 1}";
                var num_w = gg.measure_text(line_num_str, self.theme.font_scale);
                var num_x = bx + gutter_w - num_w - 6.0;
                var num_c = self.get_style_color(types.COLOR_TEXT_MUTED);
                if (is_focused and gi == ctrl.get_cursor_line()) {
                    num_c = self.get_style_color(types.COLOR_ACCENT);
                    gg.draw_rect_primitive(bx + 1.0, g_cy, gutter_w - 1.0, lh, num_c.r, num_c.g, num_c.b, 0.18);
                }
                gg.draw_text(line_num_str, num_x, g_cy, num_c.r, num_c.g, num_c.b, num_c.a, self.theme.font_scale);
                gi = gi + 1;
            }
            gg.pop_clip();
        }

        // 2. Draw text area content
        gg.push_clip(bx + gutter_w + 1.0, by + 1.0, text_area_w, h - 2.0);

        var ii = start_line;
        while (ii < end_line) {
            var cy = by + 6.0 - vp.scroll_y + (ii as float) * lh;
            var line_text = ctrl.get_line(ii);
            if (line_text == nil) { line_text = ""; }

            // Draw selection highlight if line intersects selection range
            if (ctrl.is_selected()) {
                var sel_rng = ctrl.get_selection_range();
                var r_s_line = sel_rng[0];
                var r_s_col = sel_rng[1];
                var r_e_line = sel_rng[2];
                var r_e_col = sel_rng[3];

                if (ii >= r_s_line and ii <= r_e_line) {
                    var l_start_col = 0;
                    var l_end_col = len(line_text);
                    if (ii == r_s_line) { l_start_col = r_s_col; }
                    if (ii == r_e_line) { l_end_col = r_e_col; }
                    if (l_start_col < 0) { l_start_col = 0; }
                    if (l_end_col > len(line_text)) { l_end_col = len(line_text); }

                    if (l_end_col > l_start_col) {
                        var pre_sel = "";
                        if (l_start_col > 0) {
                            pre_sel = std_string.substring(line_text, 0, l_start_col);
                        }
                        var sel_str = std_string.substring(line_text, l_start_col, l_end_col);
                        var s_x = gg.measure_text(pre_sel, self.theme.font_scale);
                        var s_w = gg.measure_text(sel_str, self.theme.font_scale);
                        if (s_w < 4.0) { s_w = 4.0; }
                        var sel_col = self.get_style_color(types.COLOR_ACCENT);
                        gg.draw_rect_primitive(text_origin_x + s_x, cy, s_w, lh, sel_col.r, sel_col.g, sel_col.b, 0.4);
                    }
                }
            }

            // Draw text
            gg.draw_text(line_text, text_origin_x, cy, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);

            // Draw cursor bar
            if (is_focused and ii == ctrl.get_cursor_line()) {
                var cur_col = ctrl.get_cursor_col();
                if (cur_col > len(line_text)) { cur_col = len(line_text); }
                var prefix = "";
                if (cur_col > 0) { prefix = std_string.substring(line_text, 0, cur_col); }
                var cur_x = gg.measure_text(prefix, self.theme.font_scale);
                gg.draw_rect_primitive(text_origin_x + cur_x, cy, 2.0, lh, tc.r, tc.g, tc.b, tc.a);
            }

            ii = ii + 1;
        }

        gg.pop_clip();

        if (label != nil and len(label) > 0) {
            var ltc = self.get_style_color(types.COLOR_TEXT_MUTED);
            gg.draw_text(label, bx + w + 8.0, by + 6.0, ltc.r, ltc.g, ltc.b, ltc.a, self.theme.font_scale);
        }

        self.prev_item_hovered = hovered;
        self.prev_item_rect = types.rect(bx, by, w, h);
        self.advance(w + 80.0, h);
        return ctrl.get_text();
    }
    pub fn input_text(label: str, text: str, max_len: int = 256): str {
        var w = 160.0;
        var h = self.get_style_var(types.VAR_ITEM_HEIGHT, self.theme.item_height);
        var id = self.make_id(label);
        var bx = self.cursor_x;
        var by = self.cursor_y;

        var hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and
        self.mouse_y >= by and self.mouse_y <= (by + h));

        if (hovered and self.is_occluded(bx, by, w, h)) {
            hovered = false;
        }
        if (hovered) { self.hot_id = id; }
        if (hovered and self.mouse_pressed) {
            self.active_id = id;
        }

        var is_focused = (self.active_id == id);
        var bg = self.get_style_color(types.COLOR_FRAME_BG);
        if (is_focused) {
            bg = self.get_style_color(types.COLOR_FRAME_BG_ACTIVE);
        } elif (hovered) {
            bg = self.get_style_color(types.COLOR_FRAME_BG_HOVER);
        }

        gg.draw_rect_primitive(bx, by, w, h, bg.r, bg.g, bg.b, bg.a);

        var border = self.theme.checkbox_border;
        if (is_focused) {
            border = self.get_style_color(types.COLOR_ACCENT);
        }
        gg.draw_rect_primitive(bx, by, w, 1.0, border.r, border.g, border.b, border.a);
        gg.draw_rect_primitive(bx, by + h - 1.0, w, 1.0, border.r, border.g, border.b, border.a);
        gg.draw_rect_primitive(bx, by, 1.0, h, border.r, border.g, border.b, border.a);
        gg.draw_rect_primitive(bx + w - 1.0, by, 1.0, h, border.r, border.g, border.b, border.a);

        var res_text = text;
        if (is_focused) {
            if (self.typed_chars != nil) {
                iter (cp in self.typed_chars) {
                    if (cp >= 32 and cp <= 126 and len(res_text) < max_len) {
                        var ch = _builtin_string_from_bytes([cp]);
                        res_text = res_text + ch;
                    }
                }
            }
            if ((self.is_key_pressed(8) or self.is_key_pressed(259)) and len(res_text) > 0) {
                res_text = std_string.substring(res_text, 0, len(res_text) - 1);
            }
        }

        var display_text = res_text;
        if (is_focused) {
            display_text = display_text + "|";
        }
        var tc = self.get_style_color(types.COLOR_TEXT);
        gg.draw_text(display_text, bx + 6.0, by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);

        if (label != "") {
            var ltc = self.get_style_color(types.COLOR_TEXT_MUTED);
            gg.draw_text(label, bx + w + 8.0, by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0, ltc.r, ltc.g, ltc.b, ltc.a, self.theme.font_scale);
        }

        self.prev_item_hovered = hovered;
        self.prev_item_rect = types.rect(bx, by, w, h);
        self.advance(w + 80.0, h);
        return res_text;
    }

    pub fn combo_box(label: str, items: [str], selected_idx: int): int {
        var w = 150.0;
        var h = self.get_style_var(types.VAR_ITEM_HEIGHT, self.theme.item_height);
        var id = self.make_id(label);
        var bx = self.cursor_x;
        var by = self.cursor_y;
        if (id == "") {
            var ix = bx as int;
            var iy = by as int;
            id = "combo_{ix}_{iy}";
        }

        var hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and
        self.mouse_y >= by and self.mouse_y <= (by + h));

        if (hovered) { self.hot_id = id; }

        var is_open = (self.combo_open_id != "" and self.combo_open_id == id);
        if (hovered and self.mouse_pressed) {
            if (is_open) {
                self.combo_open_id = "";
                self.active_popup_id = "";
            } else {
                self.combo_open_id = id;
            }
        }

        var rad = self.get_style_var(types.VAR_ROUNDING, self.theme.rounding);
        var bg = self.get_style_color(types.COLOR_FRAME_BG);
        if (hovered or is_open) { bg = self.get_style_color(types.COLOR_FRAME_BG_HOVER); }
        var border = self.theme.checkbox_border;
        if (is_open) { border = self.get_style_color(types.COLOR_ACCENT); }

        if (rad > 0.0) {
            gg.draw_rect_rounded_primitive(bx, by, w, h, rad, bg.r, bg.g, bg.b, bg.a);
            gg.draw_rect_border_primitive(bx, by, w, h, rad, 1.0, border.r, border.g, border.b, border.a);
        } else {
            gg.draw_rect_primitive(bx, by, w, h, bg.r, bg.g, bg.b, bg.a);
            gg.draw_rect_primitive(bx, by, w, 1.0, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(bx, by + h - 1.0, w, 1.0, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(bx, by, 1.0, h, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(bx + w - 1.0, by, 1.0, h, border.r, border.g, border.b, border.a);
        }

        var current_text = "";
        if (selected_idx >= 0 and selected_idx < len(items)) {
            current_text = items[selected_idx];
        }
        var tc = self.get_style_color(types.COLOR_TEXT);
        gg.draw_text(current_text, bx + 6.0, by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);

        var arrow_char = "v";
        if (is_open) { arrow_char = "^"; }
        var ac = self.theme.text_muted;
        gg.draw_text(arrow_char, bx + w - 16.0, by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0, ac.r, ac.g, ac.b, ac.a, self.theme.font_scale);

        if (label != "") {
            var ltc = self.get_style_color(types.COLOR_TEXT_MUTED);
            gg.draw_text(label, bx + w + 8.0, by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0, ltc.r, ltc.g, ltc.b, ltc.a, self.theme.font_scale);
        }

        var new_idx = selected_idx;
        if (self.combo_selected_changed and self.combo_open_id == "" and id == self.deferred_combo_id) {
            new_idx = self.combo_selected_new;
            self.combo_selected_changed = false;
            self.combo_selected_new = -1;
        }

        if (is_open) {
            self.has_deferred_combo = true;
            self.deferred_combo_bx = bx;
            self.deferred_combo_by = by;
            self.deferred_combo_w = w;
            self.deferred_combo_h = h;
            self.deferred_combo_items = items;
            self.deferred_combo_selected = new_idx;
            self.deferred_combo_id = id;

            var item_count = len(items);
            var popup_h = (item_count as float) * h;
            var popup_y = by + h + 2.0;

            self.popup_x = bx;
            self.popup_y = popup_y;
            self.popup_w = w;
            self.popup_h = popup_h;
            self.active_popup_id = id;
        }

        self.prev_item_hovered = hovered;
        self.prev_item_rect = types.rect(bx, by, w, h);
        var adv_w = w;
        if (label != "") {
            adv_w = w + 80.0;
        }
        self.advance(adv_w, h);
        return new_idx;
    }

    pub fn color_button(id: str, col: color.Color, w: float = 24.0, h: float = 24.0): bool {
        var bx = self.cursor_x;
        var by = self.cursor_y;
        var full_id = self.make_id(id);

        var hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and
        self.mouse_y >= by and self.mouse_y <= (by + h));

        if (hovered) { self.hot_id = full_id; }

        var clicked = false;
        if (hovered and self.mouse_pressed) {
            clicked = true;
        }

        var border = self.theme.checkbox_border;
        if (hovered) { border = self.get_style_color(types.COLOR_ACCENT); }
        gg.draw_rect_primitive(bx, by, w, h, border.r, border.g, border.b, border.a);
        gg.draw_rect_primitive(bx + 2.0, by + 2.0, w - 4.0, h - 4.0, col.r, col.g, col.b, col.a);

        self.prev_item_hovered = hovered;
        self.prev_item_rect = types.rect(bx, by, w, h);
        self.advance(w, h);
        return clicked;
    }

    pub fn color_picker(label: str, col: color.Color): color.Color {
        self.push_id(label);
        self.color_button("##swatch", col, 28.0, 28.0);
        self.same_line();
        self.label(label);

        self.indent(12.0);
        var nr = self.slider("R", col.r, 0.0, 1.0, 120.0);
        var ng = self.slider("G", col.g, 0.0, 1.0, 120.0);
        var nb = self.slider("B", col.b, 0.0, 1.0, 120.0);
        self.unindent(12.0);
        self.pop_id();

        return color.Color(r=nr, g=ng, b=nb, a=col.a);
    }

    pub fn plot_lines(label: str, values: [float], min_val: float = 0.0, max_val: float = 1.0, w: float = 180.0, h: float = 50.0): nil {
        var bx = self.cursor_x;
        var by = self.cursor_y;
        var count = len(values);

        var rad = self.get_style_var(types.VAR_ROUNDING, self.theme.rounding);
        var bg = self.get_style_color(types.COLOR_FRAME_BG);
        var border = self.theme.checkbox_border;

        if (rad > 0.0) {
            gg.draw_rect_rounded_primitive(bx, by, w, h, rad, bg.r, bg.g, bg.b, bg.a);
            gg.draw_rect_border_primitive(bx, by, w, h, rad, 1.0, border.r, border.g, border.b, border.a);
        } else {
            gg.draw_rect_primitive(bx, by, w, h, bg.r, bg.g, bg.b, bg.a);
            gg.draw_rect_primitive(bx, by, w, 1.0, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(bx, by + h - 1.0, w, 1.0, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(bx, by, 1.0, h, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(bx + w - 1.0, by, 1.0, h, border.r, border.g, border.b, border.a);
        }

        var val_range = max_val - min_val;
        if (val_range <= 0.0) { val_range = 1.0; }

        if (count > 1) {
            var step_x = (w - 8.0) / ((count - 1) as float);
            var lc = self.get_style_color(types.COLOR_PLOT_LINES);
            var prev_px = 0.0;
            var prev_py = 0.0;
            var i = 0;
            while (i < count) {
                var cur_px = bx + 4.0 + (i as float) * step_x;
                var norm = (values[i] - min_val) / val_range;
                if (norm < 0.0) { norm = 0.0; }
                if (norm > 1.0) { norm = 1.0; }
                var cur_py = by + h - norm * (h - 10.0) - 5.0;

                if (i > 0) {
                    gg.draw_line_primitive(prev_px, prev_py, cur_px, cur_py, lc.r, lc.g, lc.b, lc.a, 2.0);
                }
                prev_px = cur_px;
                prev_py = cur_py;
                i = i + 1;
            }
        }

        if (label != "") {
            var ltc = self.get_style_color(types.COLOR_TEXT_MUTED);
            gg.draw_text(label, bx + 6.0, by + 4.0, ltc.r, ltc.g, ltc.b, ltc.a, self.theme.font_scale);
        }

        self.prev_item_hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and self.mouse_y >= by and self.mouse_y <= (by + h));
        self.prev_item_rect = types.rect(bx, by, w, h);
        self.advance(w, h);
    }

    pub fn plot_histogram(label: str, values: [float], min_val: float = 0.0, max_val: float = 1.0, w: float = 180.0, h: float = 50.0): nil {
        var bx = self.cursor_x;
        var by = self.cursor_y;
        var count = len(values);

        var rad = self.get_style_var(types.VAR_ROUNDING, self.theme.rounding);
        var bg = self.get_style_color(types.COLOR_FRAME_BG);
        var border = self.theme.checkbox_border;

        if (rad > 0.0) {
            gg.draw_rect_rounded_primitive(bx, by, w, h, rad, bg.r, bg.g, bg.b, bg.a);
            gg.draw_rect_border_primitive(bx, by, w, h, rad, 1.0, border.r, border.g, border.b, border.a);
        } else {
            gg.draw_rect_primitive(bx, by, w, h, bg.r, bg.g, bg.b, bg.a);
            gg.draw_rect_primitive(bx, by, w, 1.0, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(bx, by + h - 1.0, w, 1.0, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(bx, by, 1.0, h, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(bx + w - 1.0, by, 1.0, h, border.r, border.g, border.b, border.a);
        }

        var val_range = max_val - min_val;
        if (val_range <= 0.0) { val_range = 1.0; }

        if (count > 0) {
            var bar_w = (w - 8.0 - (count as float) * 2.0) / (count as float);
            if (bar_w < 1.0) { bar_w = 1.0; }
            var hc = self.get_style_color(types.COLOR_PLOT_HISTOGRAM);

            var i = 0;
            while (i < count) {
                var bar_x = bx + 4.0 + (i as float) * (bar_w + 2.0);
                var norm = (values[i] - min_val) / val_range;
                if (norm < 0.0) { norm = 0.0; }
                if (norm > 1.0) { norm = 1.0; }
                var bar_h = norm * (h - 8.0);
                var bar_y = by + h - bar_h - 4.0;

                gg.draw_rect_rounded_primitive(bar_x, bar_y, bar_w, bar_h, 1.5, hc.r, hc.g, hc.b, hc.a);
                i = i + 1;
            }
        }

        if (label != "") {
            var ltc = self.get_style_color(types.COLOR_TEXT_MUTED);
            gg.draw_text(label, bx + 6.0, by + 4.0, ltc.r, ltc.g, ltc.b, ltc.a, self.theme.font_scale);
        }

        self.prev_item_hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and self.mouse_y >= by and self.mouse_y <= (by + h));
        self.prev_item_rect = types.rect(bx, by, w, h);
        self.advance(w, h);
    }

    pub fn progress_bar(fraction: float, width: float = 160.0, height: float = 16.0, overlay_text: str = ""): nil {
        var w = width;
        var h = height;
        var bx = self.cursor_x;
        var by = self.cursor_y;

        var f = fraction;
        if (f < 0.0) { f = 0.0; }
        if (f > 1.0) { f = 1.0; }

        var rad = self.get_style_var(types.VAR_ROUNDING, self.theme.rounding);
        var track = self.get_style_color(types.COLOR_SLIDER_TRACK);
        if (rad > 0.0) {
            gg.draw_rect_rounded_primitive(bx, by, w, h, rad, track.r, track.g, track.b, track.a);
        } else {
            gg.draw_rect_primitive(bx, by, w, h, track.r, track.g, track.b, track.a);
        }

        if (f > 0.0) {
            var fill_w = w * f;
            var fill_color = self.get_style_color(types.COLOR_ACCENT);
            if (rad > 0.0) {
                gg.draw_rect_rounded_primitive(bx, by, fill_w, h, rad, fill_color.r, fill_color.g, fill_color.b, fill_color.a);
            } else {
                gg.draw_rect_primitive(bx, by, fill_w, h, fill_color.r, fill_color.g, fill_color.b, fill_color.a);
            }
        }

        if (overlay_text != "") {
            var tc = color.Color(r=1.0, g=1.0, b=1.0, a=0.95);
            var text_w = (len(overlay_text) * 8 * self.theme.font_scale) as float;
            var text_x = bx + (w - text_w) / 2.0;
            var text_y = by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0;
            gg.draw_text(overlay_text, text_x, text_y, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);
        }

        self.prev_item_hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and self.mouse_y >= by and self.mouse_y <= (by + h));
        self.prev_item_rect = types.rect(bx, by, w, h);
        self.advance(w, h);
    }

    pub fn separator(): nil {
        var w = 200.0;
        if (self.in_window) {
            var pad = self.get_style_var(types.VAR_PADDING, self.theme.padding);
            w = self.cur_window_w - (pad * 2.0);
        }
        var c = self.get_style_color(types.COLOR_SEPARATOR);
        gg.draw_rect_primitive(self.cursor_x, self.cursor_y + 2.0, w, 1.0, c.r, c.g, c.b, c.a);
        self.cursor_y = self.cursor_y + 5.0;
    }

    pub fn header(title: str, default_open: bool = true): bool {
        var id = self.make_id(title);
        var is_open = default_open;
        if (self.headers[id] != nil) {
            is_open = self.headers[id];
        } else {
            self.headers[id] = default_open;
        }


        var w = 200.0;
        if (self.in_window) {
            var pad = self.get_style_var(types.VAR_PADDING, self.theme.padding);
            w = self.cur_window_w - (pad * 2.0);
        }
        var h = 22.0;
        var bx = self.cursor_x;
        var by = self.cursor_y;

        var hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and
        self.mouse_y >= by and self.mouse_y <= (by + h));


        if (hovered) {
            self.hot_id = id;
            if (self.mouse_pressed) {
                is_open = not is_open;
                self.headers[id] = is_open;
            }
        }

        var bg = self.get_style_color(types.COLOR_PANEL_BG);
        if (hovered) {
            bg = self.get_style_color(types.COLOR_BUTTON_HOVER);
        }
        gg.draw_rect_primitive(bx, by, w, h, bg.r, bg.g, bg.b, bg.a);

        var prefix = "[+] ";
        if (is_open) {
            prefix = "[-] ";
        }
        var full_title = prefix + title;
        var ty = by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0;
        var ac = self.get_style_color(types.COLOR_ACCENT);
        gg.draw_text(full_title, bx + 6.0, ty, ac.r, ac.g, ac.b, 1.0, self.theme.font_scale);

        self.prev_item_hovered = hovered;
        self.prev_item_rect = types.rect(bx, by, w, h);
        self.advance(w, h);
        return is_open;
    }

    // ── Tab Bar ────────────────────────────────────────────────────────────────

    pub fn begin_tab_bar(id: str): bool {
        self.cur_tab_bar_id = id;
        return true;
    }

    pub fn tab_item(label: str, is_active: bool): bool {
        var w = (len(label) * 8 * self.theme.font_scale + 20) as float;
        var h = self.get_style_var(types.VAR_ITEM_HEIGHT, self.theme.item_height);
        var bx = self.cursor_x;
        var by = self.cursor_y;
        var tab_bar_id = self.cur_tab_bar_id;
        var id = self.make_id(tab_bar_id + "/" + label);

        var hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and
        self.mouse_y >= by and self.mouse_y <= (by + h));

        if (hovered) { self.hot_id = id; }

        var clicked = false;
        if (hovered and self.mouse_pressed) {
            clicked = true;
        }

        var bg = self.get_style_color(types.COLOR_TAB);
        if (is_active) {
            bg = self.get_style_color(types.COLOR_TAB_ACTIVE);
        } elif (hovered) {
            bg = self.get_style_color(types.COLOR_BUTTON_HOVER);
        }
        gg.draw_rect_primitive(bx, by, w, h, bg.r, bg.g, bg.b, bg.a);

        var tc = self.get_style_color(types.COLOR_TEXT);
        if (is_active) { tc = color.white; }
        var tw = (len(label) * 8 * self.theme.font_scale) as float;
        gg.draw_text(label, bx + (w - tw) / 2.0, by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);

        self.prev_item_hovered = hovered;
        self.prev_item_rect = types.rect(bx, by, w, h);
        self.advance(w, h);
        self.same_line();
        return clicked;
    }

    pub fn end_tab_bar(): nil {
        self.cur_tab_bar_id = "";
        self.cursor_x = self.start_x + self.indent_x;
        var sp = self.get_style_var(types.VAR_SPACING, self.theme.spacing);
        self.cursor_y = self.cursor_y + sp;
    }

    // ── Tree Node ──────────────────────────────────────────────────────────────

    pub fn tree_node(label: str): bool {
        var id = self.make_id(label);
        var open = false;
        if (self.headers[id] != nil) {
            open = self.headers[id];
        }


        var h = self.get_style_var(types.VAR_ITEM_HEIGHT, self.theme.item_height);
        var bx = self.cursor_x;
        var by = self.cursor_y;
        var w = 160.0;

        var hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and
        self.mouse_y >= by and self.mouse_y <= (by + h));

        if (hovered) { self.hot_id = id; }

        if (hovered and self.mouse_pressed) {
            open = not open;
            self.headers[id] = open;
        }

        var icon = ">";
        if (open) { icon = "v"; }
        var ac = self.get_style_color(types.COLOR_ACCENT);
        gg.draw_text(icon, bx, by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0, ac.r, ac.g, ac.b, ac.a, self.theme.font_scale);

        var tc = self.get_style_color(types.COLOR_TEXT);
        gg.draw_text(label, bx + 16.0, by + (h - 8.0 * (self.theme.font_scale as float)) / 2.0, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);

        self.prev_item_hovered = hovered;
        self.prev_item_rect = types.rect(bx, by, w, h);
        self.advance(w, h);

        if (open) {
            self.indent(16.0);
        }
        return open;
    }

    pub fn tree_pop(): nil {
        self.unindent(16.0);
    }

    // ── Tooltip ────────────────────────────────────────────────────────────────

    pub fn tooltip(text: str): nil {
        if (self.prev_item_hovered and text != "") {
            var tw = (len(text) * 8 * self.theme.font_scale + 16) as float;
            var th = 22.0;
            var tx = self.mouse_x + 12.0;
            var ty = self.mouse_y + 12.0;

            var bg = self.get_style_color(types.COLOR_PANEL_BG);
            gg.draw_rect_primitive(tx, ty, tw, th, bg.r, bg.g, bg.b, bg.a);
            var border = self.get_style_color(types.COLOR_SEPARATOR);
            gg.draw_rect_primitive(tx, ty, tw, 1.0, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(tx, ty + th - 1.0, tw, 1.0, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(tx, ty, 1.0, th, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(tx + tw - 1.0, ty, 1.0, th, border.r, border.g, border.b, border.a);

            var tc = self.get_style_color(types.COLOR_TEXT);
            gg.draw_text(text, tx + 8.0, ty + (th - 8.0 * (self.theme.font_scale as float)) / 2.0, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);
        }
    }

    // ── Popups ─────────────────────────────────────────────────────────────────

    pub fn open_popup(id: str): nil {
        self.active_popup_id = id;
    }

    pub fn close_popup(id: str): nil {
        if (self.active_popup_id == id) {
            self.active_popup_id = "";
        }
    }

    pub fn is_popup_open(id: str): bool {
        return self.active_popup_id == id;
    }

    pub fn begin_popup(id: str, x: float, y: float, w: float, h: float): bool {
        if (self.active_popup_id != id) {
            return false;
        }
        self.popup_x = x;
        self.popup_y = y;
        self.popup_w = w;
        self.popup_h = h;

        // Optional popup drop shadow (opt-in)
        var raw_psh = self.get_active_shadow();
        if (raw_psh != nil) {
            val psh = raw_psh as shadow.Shadow;
            if (psh.a > 0.0) {
                gg.draw_shadow_primitive(x, y, w, h, psh.r, psh.g, psh.b, psh.a, psh.offset_x, psh.offset_y, psh.blur_radius, psh.spread_radius);
            }
        } elif (self.theme.popup_shadow != nil) {
            val psh = self.theme.popup_shadow as shadow.Shadow;
            if (psh.a > 0.0) {
                gg.draw_shadow_primitive(x, y, w, h, psh.r, psh.g, psh.b, psh.a, psh.offset_x, psh.offset_y, psh.blur_radius, psh.spread_radius);
            }
        }

        var rad = self.get_style_var(types.VAR_ROUNDING, self.theme.rounding);
        var bg = self.get_style_color(types.COLOR_PANEL_BG);
        var border = self.get_style_color(types.COLOR_ACCENT);

        if (rad > 0.0) {
            gg.draw_rect_rounded_primitive(x, y, w, h, rad, bg.r, bg.g, bg.b, bg.a);
            gg.draw_rect_border_primitive(x, y, w, h, rad, 1.5, border.r, border.g, border.b, border.a);
        } else {
            gg.draw_rect_primitive(x, y, w, h, bg.r, bg.g, bg.b, bg.a);
            gg.draw_rect_primitive(x, y, w, 1.0, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(x, y + h - 1.0, w, 1.0, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(x, y, 1.0, h, border.r, border.g, border.b, border.a);
            gg.draw_rect_primitive(x + w - 1.0, y, 1.0, h, border.r, border.g, border.b, border.a);
        }

        var pad = self.get_style_var(types.VAR_PADDING, 6.0);
        self.cursor_x = x + pad;
        self.cursor_y = y + pad;
        self.start_x = self.cursor_x;
        self.start_y = self.cursor_y;
        return true;
    }

    pub fn end_popup(): nil {
        // End popup
    }

    // ── Table / Grid Layout ───────────────────────────────────────────────────

    pub fn table(headers: [str], rows_count: int, row_height: float = 24.0): bool {
        var col_count = len(headers);
        if (col_count == 0) { return false; }

        var pad = self.get_style_var(types.VAR_PADDING, self.theme.padding);
        var total_w = 400.0;
        if (self.in_window) {
            total_w = self.cur_window_w - (pad * 2.0);
        }
        var col_w = total_w / (col_count as float);

        var bx = self.cursor_x;
        var by = self.cursor_y;
        var hbg = self.get_style_color(types.COLOR_PANEL_BG);
        gg.draw_rect_primitive(bx, by, total_w, row_height, hbg.r, hbg.g, hbg.b, hbg.a);

        var c_idx = 0;
        while (c_idx < col_count) {
            var cx = bx + (c_idx as float) * col_w;
            var tc = self.get_style_color(types.COLOR_ACCENT);
            gg.draw_text(headers[c_idx], cx + 6.0, by + (row_height - 8.0 * (self.theme.font_scale as float)) / 2.0, tc.r, tc.g, tc.b, tc.a, self.theme.font_scale);
            c_idx = c_idx + 1;
        }

        self.columns(col_count, total_w);
        self.cursor_y = by + row_height + 2.0;
        return true;
    }

    // ── Scroll Area ────────────────────────────────────────────────────────────

    pub fn begin_scroll_area(w: float, h: float, content_h: float): bool {
        var bx = self.cursor_x;
        var by = self.cursor_y;
        gg.push_clip(bx, by, w, h);

        var bg = self.get_style_color(types.COLOR_FRAME_BG);
        gg.draw_rect_primitive(bx, by, w, h, bg.r, bg.g, bg.b, bg.a);

        var hovered = (self.mouse_x >= bx and self.mouse_x <= (bx + w) and
        self.mouse_y >= by and self.mouse_y <= (by + h));

        if (hovered and self.mouse_wheel != 0.0) {
            self.scroll_y = self.scroll_y - self.mouse_wheel * 20.0;
            var max_scroll = content_h - h;
            if (max_scroll < 0.0) { max_scroll = 0.0; }
            if (self.scroll_y < 0.0) { self.scroll_y = 0.0; }
            if (self.scroll_y > max_scroll) { self.scroll_y = max_scroll; }
        }

        if (content_h > h) {
            var sb_w = 6.0;
            var sb_x = bx + w - sb_w - 2.0;
            var track_c = self.get_style_color(types.COLOR_SLIDER_TRACK);
            gg.draw_rect_primitive(sb_x, by, sb_w, h, track_c.r, track_c.g, track_c.b, track_c.a);

            var thumb_h = (h / content_h) * h;
            if (thumb_h < 15.0) { thumb_h = 15.0; }
            var max_scroll = content_h - h;
            var norm = 0.0;
            if (max_scroll > 0.0) { norm = self.scroll_y / max_scroll; }
            var thumb_y = by + norm * (h - thumb_h);
            var thumb_c = self.get_style_color(types.COLOR_SLIDER_THUMB);
            gg.draw_rect_primitive(sb_x, thumb_y, sb_w, thumb_h, thumb_c.r, thumb_c.g, thumb_c.b, thumb_c.a);
        }

        self.cursor_x = bx + 4.0;
        self.cursor_y = by + 4.0 - self.scroll_y;
        self.start_x = self.cursor_x;
        self.start_y = self.cursor_y;
        return true;
    }

    pub fn end_scroll_area(): nil {
        gg.pop_clip();
    }

    // ── Floating Window Management ─────────────────────────────────────────────

    pub fn set_window_rect(title: str, x: float, y: float, w: float, h: float): nil {
        var win = self.windows[title];
        if (win != nil) {
            win.x = x;
            win.y = y;
            win.w = w;
            win.h = h;
        } else {
            self.windows[title] = WindowState(x, y, w, h);
        }
    }

    pub fn begin_window(title: str, default_x: float, default_y: float, default_w: float, default_h: float): bool {
        var win = self.windows[title];
        if (win == nil) {
            win = WindowState(default_x, default_y, default_w, default_h);
            self.windows[title] = win;
        }

        var titlebar_h = 24.0;
        var wx = win.x;
        var wy = win.y;
        var ww = win.w;
        var wh = win.h;

        var title_hovered = (self.mouse_x >= wx and self.mouse_x <= (wx + ww) and
        self.mouse_y >= wy and self.mouse_y <= (wy + titlebar_h));

        var id = self.make_id(title);
        if (title_hovered and self.mouse_pressed) {
            win.is_dragging = true;
            win.drag_off_x = self.mouse_x - wx;
            win.drag_off_y = self.mouse_y - wy;
            self.active_id = id;
        }

        if (win.is_dragging) {
            if (self.mouse_down) {
                win.x = self.mouse_x - win.drag_off_x;
                win.y = self.mouse_y - win.drag_off_y;
                wx = win.x;
                wy = win.y;
            } else {
                win.is_dragging = false;
                if (self.active_id == id) {
                    self.active_id = "";
                }
            }
        }

        var bg = self.get_style_color(types.COLOR_WINDOW_BG);
        var panel_h = wh;
        if (win.collapsed) {
            panel_h = titlebar_h;
        }

        var rad = self.get_style_var(types.VAR_ROUNDING, self.theme.rounding);

        // Optional window elevation drop shadow (opt-in)
        var raw_wsh = self.get_active_shadow();
        if (raw_wsh != nil) {
            val wsh = raw_wsh as shadow.Shadow;
            if (wsh.a > 0.0) {
                gg.draw_shadow_primitive(wx, wy, ww, panel_h, wsh.r, wsh.g, wsh.b, wsh.a, wsh.offset_x, wsh.offset_y, wsh.blur_radius, wsh.spread_radius);
            }
        } elif (self.theme.window_shadow != nil) {
            val wsh = self.theme.window_shadow as shadow.Shadow;
            if (wsh.a > 0.0) {
                gg.draw_shadow_primitive(wx, wy, ww, panel_h, wsh.r, wsh.g, wsh.b, wsh.a, wsh.offset_x, wsh.offset_y, wsh.blur_radius, wsh.spread_radius);
            }
        }

        var tb = self.get_style_color(types.COLOR_WINDOW_TITLE);

        if (rad > 0.0) {
            gg.draw_rect_rounded_primitive(wx, wy, ww, panel_h, rad, bg.r, bg.g, bg.b, bg.a);
            gg.draw_rect_rounded_primitive(wx, wy, ww, titlebar_h, rad, tb.r, tb.g, tb.b, tb.a);
            if (panel_h > titlebar_h) {
                gg.draw_rect_primitive(wx, wy + titlebar_h - rad, ww, rad, tb.r, tb.g, tb.b, tb.a);
            }
            var border_col = color.Color(r=tb.r * 1.3, g=tb.g * 1.3, b=tb.b * 1.3, a=0.5);
            gg.draw_rect_border_primitive(wx, wy, ww, panel_h, rad, 1.0, border_col.r, border_col.g, border_col.b, border_col.a);
        } else {
            gg.draw_rect_primitive(wx, wy, ww, panel_h, bg.r, bg.g, bg.b, bg.a);
            gg.draw_rect_primitive(wx, wy, ww, titlebar_h, tb.r, tb.g, tb.b, tb.a);
        }

        var text_y = wy + (titlebar_h - 8.0 * (self.theme.font_scale as float)) / 2.0;
        var tc = self.get_style_color(types.COLOR_TEXT);
        var pad = self.get_style_var(types.VAR_PADDING, self.theme.padding);
        gg.draw_text(title, wx + pad, text_y, tc.r, tc.g, tc.b, 1.0, self.theme.font_scale);

        self.in_window = true;
        self.cur_window_title = title;
        self.cur_window_x = wx;
        self.cur_window_y = wy;
        self.cur_window_w = ww;
        self.cur_window_h = wh;

        if (win.collapsed) {
            return false;
        }

        gg.push_clip(wx, wy + titlebar_h, ww, wh - titlebar_h);

        self.cursor_x = wx + pad;
        self.cursor_y = wy + titlebar_h + pad;
        self.start_x = self.cursor_x;
        self.start_y = self.cursor_y;

        return true;
    }

    pub fn end_window(): nil {
        if (not self.in_window) {
            return;
        }
        var win = self.windows[self.cur_window_title];
        if (win != nil and not win.collapsed) {
            gg.pop_clip();
        }
        self.in_window = false;
        self.cur_window_title = "";
    }

    pub fn show_debug_hud(fps: float, dt: float, entity_count: int = 0): nil {
        if (self.begin_window("Engine Metrics", 10.0, 10.0, 220.0, 160.0)) {
            self.label("FPS: {fps as int}");
            self.label("Frame: {dt * 1000.0} ms");
            if (entity_count > 0) {
                self.label("Entities: {entity_count}");
            }
            self.separator();
            self.end_window();
        }
    }
}

pub var default_gui: GUI = GUI();
