import std.format.formatter as formatter;
import std.format.printf as printf;

frame Format {
    pub init() {}
    pub fn format_int(value: int): str { return formatter.format_int(value); }
    pub fn format_float(value: float): str { return formatter.format_float(value); }
    pub fn format_bool(value: bool): str { return formatter.format_bool(value); }
    pub fn pad_left(value: str, length_val: int, fill_char: str): str { return formatter.pad_left(value, length_val, fill_char); }
    pub fn pad_right(value: str, length_val: int, fill_char: str): str { return formatter.pad_right(value, length_val, fill_char); }
    pub fn center(value: str, length_val: int, fill_char: str): str { return formatter.center(value, length_val, fill_char); }
    pub fn truncate(value: str, length_val: int, ellipsis: bool): str { return formatter.truncate(value, length_val, ellipsis); }
    pub fn title_case(value: str): str { return formatter.title_case(value); }
    pub fn snake_case(value: str): str { return formatter.snake_case(value); }
    pub fn camel_case(value: str): str { return formatter.camel_case(value); }
    pub fn kebab_case(value: str): str { return formatter.kebab_case(value); }
    pub fn pascal_case(value: str): str { return formatter.pascal_case(value); }
}

pub fn format_int(value: int): str {
    return formatter.format_int(value);
}

pub fn format_float(value: float): str {
    return formatter.format_float(value);
}

pub fn format_bool(value: bool): str {
    return formatter.format_bool(value);
}

pub fn pad_string(value: str, length_val: int): str {
    return formatter.pad_left(value, length_val, " ");
}

pub fn title_case(value: str): str {
    return formatter.title_case(value);
}

pub fn snake_case(value: str): str {
    return formatter.snake_case(value);
}

pub fn camel_case(value: str): str {
    return formatter.camel_case(value);
}

pub fn kebab_case(value: str): str {
    return formatter.kebab_case(value);
}

pub fn pascal_case(value: str): str {
    return formatter.pascal_case(value);
}

pub fn truncate_string(value: str, length_val: int): str {
    return formatter.truncate(value, length_val, true);
}

pub fn printf_template(template: str, args: [any]): str {
    return printf.printf_template(template, args);
}
