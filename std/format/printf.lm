// Standard Library Format Printf Submodule
//
// Template-based positional format substitution.

/// Interpolates ordered argument values into `{}` placeholders within a template string.
///
/// @param template Text template containing `{}` format tokens.
/// @param args Positional values to format and substitute into tokens.
/// @return Interpolated string.
///
/// @example
/// ```lymar
/// var msg = printf_template("Hello {}, you have {} messages", ["Alice", 5]);
/// ```
pub fn printf_template(template: str, args: [any]): str {
    var result = "";
    var i = 0;
    var arg_index = 0;
    var tlen = len(template);

    while (i < tlen) {
        var ch = _builtin_substring(template, i, i + 1);

        if (ch == "{" and i + 1 < tlen and _builtin_substring(template, i + 1, i + 2) == "}") {
            if (arg_index < len(args)) {
                result = result + "{args[arg_index]}";
                arg_index = arg_index + 1;
            }
            i = i + 2;
        } else {
            result = result + ch;
            i = i + 1;
        }
    }

    return result;
}
