// Assertions as fallible calls. A failed assertion returns an `Error` carrying
// the caller's message, so it lands in the enclosing function's error path
// instead of becoming a sentinel integer nobody checks.
//
//   var _ = Debug.assert(ready, "not ready")? else { return; };
//
// `nil` is the success payload: the check has no value to report.

import std.core show Error;

frame Debug {
    pub fn assert(condition: bool, message: str): nil?Error {
        if (not condition) {
            return err(Error(code="AssertionFailed", message=message));
        }
        return ok(nil);
    }

    pub fn assert_eq(left: str, right: str): nil?Error {
        if (left == right) return ok(nil);
        return err(Error(code="AssertionFailed", message="expected '{right}', found '{left}'"));
    }

    pub fn trace(message: str): nil {
        print("[TRACE] " + message);
    }
}
