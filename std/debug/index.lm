import std.core as core;
import std.result as result;

frame Debug {
    pub fn assert(condition: bool, message: str): result.ResultInstance {
        if (!condition) return result.Err(message);
        return result.Ok(1);
    }

    pub fn assert_eq(left: str, right: str): result.ResultInstance {
        if (left == right) return result.Ok(1);
        return result.Err("assert_eq failed");
    }

    pub fn trace(message: str): nil {
        print("[TRACE] " + message);
    }
}
