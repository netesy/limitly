import std.url.url as url;
import std.url.builder as builder;
import std.url.query as query;

pub import std.url.url show URL;
pub import std.url.builder show URLBuilder;
pub import std.url.query show QueryParams;

pub fn URL(url_str: str): url.URL {
    return url.URL(url_str);
}

pub fn URLBuilder(): builder.URLBuilder {
    return builder.URLBuilder();
}

pub fn QueryParams(): query.QueryParams {
    return query.QueryParams();
}

pub fn parse(url_str: str): url.URL {
    return url.URL(url_str);
}

pub fn parse_query(qs: str): query.QueryParams {
    return query.parse(qs);
}

pub fn build(scheme: str, host: str, port: int, path: str, query: str, fragment: str): url.URL {
    return url.build(scheme, host, port, path, query, fragment);
}
