// Standard Library URL Module Index

import std.url.url as url_mod;
import std.url.builder as builder_mod;
import std.url.query as query_mod;

pub fn URL(url_str: str): any {
    return url_mod.URL(url_str);
}

pub fn URLBuilder(): any {
    return builder_mod.URLBuilder();
}

pub fn QueryParams(): any {
    return query_mod.QueryParams();
}

pub fn parse(url_str: str): any {
    return url_mod.URL(url_str);
}

pub fn parse_query(qs: str): any {
    return query_mod.parse(qs);
}

pub fn build(scheme: str, host: str, port: int, path: str, query: str, fragment: str): any {
    return url_mod.build(scheme, host, port, path, query, fragment);
}
