// Standard Library URL Core Module

import std.encoding.percent as percent;
import std.url.query as query_mod;

frame URL {
    pub fragment: str;
    pub host: str;
    pub is_valid: bool;
    pub password: str;
    pub path: str;
    pub port: int;
    pub query: str;
    pub scheme: str;
    pub username: str;

    pub init(url_str: str) {
        self.fragment = "";
        self.host = "";
        self.is_valid = false;
        self.password = "";
        self.path = "";
        self.port = -1;
        self.query = "";
        self.scheme = "";
        self.username = "";
        if (url_str != "") {
            self.parse(url_str);
        }
    }

    // Parse a URL string into its components
    pub fn parse(url_str: str) {
        var remaining: str = url_str;
        var i: int = 0;
        var len_val: int = len(url_str);

        // ---- Extract fragment ----
        var frag_idx: int = find_last(remaining, "#");
        if (frag_idx != -1) {
            self.fragment = percent.decode(substring(remaining, frag_idx + 1, len_val));
            remaining = substring(remaining, 0, frag_idx);
            len_val = len(remaining);
        }

        // ---- Extract scheme ----
        var colon_idx: int = index_of(remaining, ":");
        if (colon_idx != -1) {
            var after_scheme: str = "";
            if (colon_idx + 2 < len_val) {
                after_scheme = substring(remaining, colon_idx + 1, colon_idx + 3);
            }
            if (after_scheme == "//") {
                self.scheme = to_lower(substring(remaining, 0, colon_idx));
                remaining = substring(remaining, colon_idx + 3, len_val);
                len_val = len(remaining);
            }
        }

        // ---- Extract query ----
        var query_idx: int = index_of(remaining, "?");
        if (query_idx != -1) {
            self.query = substring(remaining, query_idx + 1, len_val);
            remaining = substring(remaining, 0, query_idx);
            len_val = len(remaining);
        }

        // ---- Extract userinfo and host ----
        var slash_idx: int = index_of(remaining, "/");
        var authority: str = "";
        if (slash_idx != -1) {
            authority = substring(remaining, 0, slash_idx);
            self.path = percent.decode(substring(remaining, slash_idx, len_val));
        } else {
            authority = remaining;
            self.path = "";
        }

        // Parse authority: [userinfo@]host[:port]
        var at_idx: int = find_last(authority, "@");
        if (at_idx != -1) {
            var userinfo: str = substring(authority, 0, at_idx);
            authority = substring(authority, at_idx + 1, len(authority));
            // Split userinfo into username:password
            var colon_in_user: int = index_of(userinfo, ":");
            if (colon_in_user != -1) {
                self.username = percent.decode(substring(userinfo, 0, colon_in_user));
                self.password = percent.decode(substring(userinfo, colon_in_user + 1, len(userinfo)));
            } else {
                self.username = percent.decode(userinfo);
            }
        }

        // Parse host and port from authority
        // Handle IPv6 addresses in brackets
        if (len(authority) > 0 and _builtin_substring(authority, 0, 1) == "[") {
            // IPv6: [::1]:port
            var close_bracket: int = index_of(authority, "]");
            if (close_bracket != -1) {
                self.host = substring(authority, 0, close_bracket + 1);
                if (close_bracket + 1 < len(authority) and _builtin_substring(authority, close_bracket + 1, close_bracket + 2) == ":") {
                    var port_str: str = substring(authority, close_bracket + 2, len(authority));
                    self.port = port_str as int;
                }
            } else {
                self.host = authority;
            }
        } else {
            var host_colon: int = find_last(authority, ":");
            if (host_colon != -1) {
                self.host = percent.decode(substring(authority, 0, host_colon));
                self.port = substring(authority, host_colon + 1, len(authority)) as int;
            } else {
                self.host = percent.decode(authority);
            }
        }

        // Set default port based on scheme
        if (self.port == -1) {
            if (self.scheme == "http") { self.port = 80; }
            elif (self.scheme == "https") { self.port = 443; }
            elif (self.scheme == "ftp") { self.port = 21; }
            elif (self.scheme == "ssh") { self.port = 22; }
            elif (self.scheme == "ws") { self.port = 80; }
            elif (self.scheme == "wss") { self.port = 443; }
            elif (self.scheme == "smtp") { self.port = 25; }
            elif (self.scheme == "mysql") { self.port = 3306; }
            elif (self.scheme == "postgresql") { self.port = 5432; }
            elif (self.scheme == "redis") { self.port = 6379; }
            elif (self.scheme == "mongodb") { self.port = 27017; }
        }

        // Default path
        if (self.path == "") {
            self.path = "/";
        }

        self.is_valid = (self.host != "" or self.scheme == "file" or self.scheme == "data");
    }

    // Reconstruct the URL from components
    pub fn to_string(): str {
        var result: str = "";
        if (self.scheme != "") {
            result = result + self.scheme + "://";
        }
        if (self.username != "") {
            result = result + percent.encode(self.username);
            if (self.password != "") {
                result = result + ":" + percent.encode(self.password);
            }
            result = result + "@";
        }
        result = result + self.host;
        if (self.port != -1) {
            var is_default: bool = false;
            if (self.scheme == "http" and self.port == 80) { is_default = true; }
            if (self.scheme == "https" and self.port == 443) { is_default = true; }
            if (self.scheme == "ws" and self.port == 80) { is_default = true; }
            if (self.scheme == "wss" and self.port == 443) { is_default = true; }
            if (not is_default) {
                result = result + ":" + "{self.port}";
            }
        }
        result = result + self.path;
        if (self.query != "") {
            result = result + "?" + self.query;
        }
        if (self.fragment != "") {
            result = result + "#" + self.fragment;
        }
        return result;
    }

    // Parse the query string into key-value pairs
    pub fn query_params(): query_mod.QueryParams {
        return query_mod.parse(self.query);
    }

    // Get the origin (scheme + host + port)
    pub fn origin(): str {
        var result: str = self.scheme + "://" + self.host;
        if (self.port != -1) {
            var is_default: bool = false;
            if (self.scheme == "http" and self.port == 80) { is_default = true; }
            if (self.scheme == "https" and self.port == 443) { is_default = true; }
            if (not is_default) {
                result = result + ":" + "{self.port}";
            }
        }
        return result;
    }

    // Resolve a relative URL against this base URL
    pub fn resolve(relative: str): URL {
        // Simple absolute/relative resolution
        if (index_of(relative, "://") != -1) {
            return URL(relative);
        }
        var base_path: str = self.path;
        var new_path: str = "";

        // Strip query and fragment from relative path first
        var rel_path_only: str = relative;
        var rel_q_idx: int = index_of(relative, "?");
        var rel_f_idx: int = index_of(relative, "#");
        var cut_idx: int = -1;
        if (rel_q_idx != -1 and rel_f_idx != -1) {
            if (rel_q_idx < rel_f_idx) {
                cut_idx = rel_q_idx;
            } else {
                cut_idx = rel_f_idx;
            }
        } else if (rel_q_idx != -1) {
            cut_idx = rel_q_idx;
        } else if (rel_f_idx != -1) {
            cut_idx = rel_f_idx;
        }
        if (cut_idx != -1) {
            rel_path_only = substring(relative, 0, cut_idx);
        }

        if (len(rel_path_only) > 0 and _builtin_substring(rel_path_only, 0, 1) == "/") {
            new_path = normalize_path(rel_path_only);
        } else {
            // Relative path
            var last_slash: int = find_last(base_path, "/");
            var dir: str = "/";
            if (last_slash != -1) {
                dir = substring(base_path, 0, last_slash + 1);
            }
            new_path = normalize_path(dir + rel_path_only);
        }
        var u = URL("") as URL;
        u.scheme = self.scheme;
        u.host = self.host;
        u.port = self.port;
        u.username = self.username;
        u.password = self.password;
        u.path = new_path;

        // Extract query and fragment from relative
        var q_idx: int = index_of(relative, "?");
        if (q_idx != -1) {
            var q_end: int = index_of(relative, "#");
            if (q_end != -1) {
                u.query = substring(relative, q_idx + 1, q_end);
            } else {
                u.query = substring(relative, q_idx + 1, len(relative));
            }
        }
        var f_idx: int = index_of(relative, "#");
        if (f_idx != -1) {
            u.fragment = substring(relative, f_idx + 1, len(relative));
        }

        u.is_valid = true;
        return u;
    }
}

pub fn build(scheme: str, host: str, port: int, path: str, query: str, fragment: str): URL {
    var u = URL("") as URL;
    u.scheme = scheme;
    u.host = host;
    u.port = port;
    u.path = path;
    u.query = query;
    u.fragment = fragment;
    u.is_valid = (host != "");
    return u;
}

// ---- Internal helpers ----

fn to_lower(s: str): str {
    var result: str = "";
    var i: int = 0;
    var alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    var lower_alphabet = "abcdefghijklmnopqrstuvwxyz";
    while (i < len(s)) {
        var ch: str = _builtin_substring(s, i, i + 1);
        var idx = index_of(alphabet, ch);
        if (idx != -1) {
            result = result + _builtin_substring(lower_alphabet, idx, idx + 1);
        } else {
            result = result + ch;
        }
        i = i + 1;
    }
    return result;
}

fn normalize_path(path_val: str): str {
    // Remove dot segments (simplified)
    var parts: [str] = [] as [str];
    var segments: [str] = split_str(path_val, "/");
    var i: int = 0;
    while (i < len(segments)) {
        var seg: str = segments[i];
        if (seg == "" or seg == ".") {
            // Skip empty segments or dot
        } else if (seg == "..") {
            if (len(parts) > 0) {
                // Remove last segment (but not the root)
                var new_parts: [str] = [] as [str];
                var j: int = 0;
                while (j < len(parts) - 1) {
                    new_parts.append(parts[j]);
                    j = j + 1;
                }
                parts = new_parts;
            }
        } else {
            parts.append(seg);
        }
        i = i + 1;
    }
    var result: str = "";
    if (len(path_val) > 0 and _builtin_substring(path_val, 0, 1) == "/") {
        result = "/";
    }
    var k: int = 0;
    while (k < len(parts)) {
        if (k > 0) {
            result = result + "/";
        }
        result = result + parts[k];
        k = k + 1;
    }
    return result;
}

fn find_last(s: str, ch: str): int {
    var i: int = len(s) - 1;
    while (i >= 0) {
        if (_builtin_substring(s, i, i + 1) == ch) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

fn index_of(s: str, pattern: str): int {
    var i: int = 0;
    while (i <= len(s) - len(pattern)) {
        if (_builtin_substring(s, i, i + len(pattern)) == pattern) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn split_str(s: str, delimiter: str): [str] {
    var parts: [str] = [] as [str];
    var current: str = "";
    var i: int = 0;
    while (i < len(s)) {
        if (_builtin_substring(s, i, i + 1) == delimiter) {
            parts.append(current);
            current = "";
        } else {
            current = current + _builtin_substring(s, i, i + 1);
        }
        i = i + 1;
    }
    parts.append(current);
    return parts;
}

fn substring(s: str, start: int, end_idx: int): str {
    var l: int = len(s);
    var real_end: int = end_idx;
    if (real_end > l) {
        real_end = l;
    }
    if (start < 0) {
        return "";
    }
    if (start >= l) {
        return "";
    }
    return _builtin_substring(s, start, real_end);
}
