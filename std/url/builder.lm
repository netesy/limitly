import std.url.url as url;

frame Builder {
    pub fragment: str;
    pub host: str;
    pub password: str;
    pub path: str;
    pub port: int;
    pub query: str;
    pub scheme: str;
    pub username: str;

    pub init() {
        self.fragment = "";
        self.host = "";
        self.password = "";
        self.path = "";
        self.port = -1;
        self.query = "";
        self.scheme = "";
        self.username = "";
    }

    pub fn set_scheme(scheme: str): Builder {
        self.scheme = scheme;
        return self;
    }

    pub fn set_host(host: str): Builder {
        self.host = host;
        return self;
    }

    pub fn set_port(port: int): Builder {
        self.port = port;
        return self;
    }

    pub fn set_path(path: str): Builder {
        self.path = path;
        return self;
    }

    pub fn set_query(query: str): Builder {
        self.query = query;
        return self;
    }

    pub fn set_fragment(fragment: str): Builder {
        self.fragment = fragment;
        return self;
    }

    pub fn set_username(username: str): Builder {
        self.username = username;
        return self;
    }

    pub fn set_password(password: str): Builder {
        self.password = password;
        return self;
    }

    pub fn build(): url.URL {
        var u = url.URL("");
        u.scheme = self.scheme;
        u.host = self.host;
        u.port = self.port;
        u.path = self.path;
        u.query = self.query;
        u.fragment = self.fragment;
        u.username = self.username;
        u.password = self.password;
        u.is_valid = (self.host != "" or self.scheme == "file" or self.scheme == "data");
        return u;
    }
}
