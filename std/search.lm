// std/search.lm
// Compatibility re-export forwarding to std.algorithm.search and std.algorithm.binary_search

import std.algorithm.search as search_mod;
import std.algorithm.binary_search as bs_mod;

pub fn linear_search(items: [any], target: any): int {
    return search_mod.linear_search(items, target);
}

pub fn binary_search(items: [any], target: any): int {
    return bs_mod.binary_search(items, target);
}

pub fn lower_bound(items: [any], target: any): int {
    return bs_mod.lower_bound(items, target);
}

pub fn upper_bound(items: [any], target: any): int {
    return bs_mod.upper_bound(items, target);
}

pub fn interpolation_search(items: [int], target: int): int {
    return search_mod.interpolation_search(items, target);
}
