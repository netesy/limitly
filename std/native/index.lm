// std.native - Platform-native windowing backend dispatch.
//
// Selects the concrete backend for the host OS via std.os.identity and
// forwards the shared window/event contract. Each backend is a real
// implementation over std.ffi - no shims:
//
//   win32.lm    - Win32 user32/kernel32 (WNDCLASSEXA + WndProc callback)
//   linux.lm    - X11 via libX11.so (XOpenDisplay/XNextEvent; XWayland
//                 covers Wayland sessions; native Wayland is separate)
//   macos.lm    - Cocoa via libobjc + AppKit (objc_msgSend FFI, struct
//                 NSRect args, Lymar-defined NSWindowDelegate)
//   android.lm  - JNI + ANativeWindow + AInputQueue (libart/libandroid;
//                 requires a Lymar host Activity supplying the Surface)
//
// Usage:
//   import std.native as native;
//   var win = native.create_window("app", 800, 600) ? else { ... };
//   var ev = native.poll_event(win);

import std.os.identity as osid;
import std.native.types as nt;
import std.native.win32 as w32;
import std.native.linux as lx;
import std.native.macos as mc;
import std.native.android as andr;
import std.native.d3d11 as d3d;
import std.native.vulkan as vk;
import std.native.metal as mt;

pub import std.native.types show Window, Event, EventKind, event_none;
pub import std.native.types show MOD_SHIFT, MOD_CTRL, MOD_ALT, MOD_SUPER, MOD_CAPS, MOD_NUM;

var _cached_name: str = "";

/// Name of the selected backend, resolved once per process:
/// "win32", "linux-x11", "macos", "android", or "none".
///
/// Platform selection uses the compile-time TARGET_OS const so only the
/// host backend's availability probe is emitted; other platforms' bindings
/// are eliminated before LIR generation.
pub fn backend_name(): str {
    if (_cached_name != "") { return _cached_name; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        if (w32.available()) { _cached_name = "win32"; return _cached_name; }
    } elif (osid.TARGET_OS == osid.OS_LINUX or osid.TARGET_OS == osid.OS_FREEBSD) {
        if (lx.available()) { _cached_name = "linux-x11"; return _cached_name; }
    } elif (osid.TARGET_OS == osid.OS_MACOS) {
        if (mc.available()) { _cached_name = "macos"; return _cached_name; }
    } elif (osid.TARGET_OS == osid.OS_ANDROID) {
        if (andr.available()) { _cached_name = "android"; return _cached_name; }
    }
    _cached_name = "none";
    return _cached_name;
}

/// True when a usable native backend exists on this host.
pub fn available(): bool {
    return backend_name() != "none";
}

/// Name of the preferred GPU backend for this host:
/// "d3d11" | "vulkan" | "metal" | "none".
///
/// Capability query only - probes driver library availability without
/// creating a device. std.gg initializes the chosen driver lazily when it
/// attaches to a window. `prefer` overrides the default order when that
/// backend is available (e.g. prefer="vulkan" for the SPIR-V/Fyra path).
pub fn gfx_backend(prefer: str = ""): str {
    // `prefer` is a runtime choice, so driver probes stay dynamic; the OS
    // ladder below is compile-time so foreign drivers are never emitted.
    if (osid.TARGET_OS == osid.OS_WINDOWS and prefer == "d3d11" and d3d.gpu_available() != 0) { return "d3d11"; }
    if (prefer == "vulkan" and vk.gpu_available() != 0) { return "vulkan"; }
    if (osid.TARGET_OS == osid.OS_MACOS and prefer == "metal" and mt.gpu_available() != 0) { return "metal"; }
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        if (d3d.gpu_available() != 0) { return "d3d11"; }
        if (vk.gpu_available() != 0) { return "vulkan"; }
        return "none";
    }
    if (osid.TARGET_OS == osid.OS_MACOS) {
        if (mt.gpu_available() != 0) { return "metal"; }
        if (vk.gpu_available() != 0) { return "vulkan"; }
        return "none";
    }
    // linux / freebsd / android / wasi: Vulkan (or MoltenVK where applicable).
    if (vk.gpu_available() != 0) { return "vulkan"; }
    return "none";
}

pub fn create_window(title: str, width: int, height: int): nt.Window? {
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        if (backend_name() == "win32") { return w32.create_window(title, width, height); }
        return err();
    }
    if (osid.TARGET_OS == osid.OS_LINUX or osid.TARGET_OS == osid.OS_FREEBSD) {
        if (backend_name() == "linux-x11") { return lx.create_window(title, width, height); }
        return err();
    }
    if (osid.TARGET_OS == osid.OS_MACOS) {
        if (backend_name() == "macos") { return mc.create_window(title, width, height); }
        return err();
    }
    if (osid.TARGET_OS == osid.OS_ANDROID) {
        if (backend_name() == "android") { return andr.create_window(title, width, height); }
        return err();
    }
    return err();
}

pub fn poll_event(win: nt.Window): nt.Event {
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        if (backend_name() == "win32") { return w32.poll_event(win); }
        return nt.event_none();
    }
    if (osid.TARGET_OS == osid.OS_LINUX or osid.TARGET_OS == osid.OS_FREEBSD) {
        if (backend_name() == "linux-x11") { return lx.poll_event(win); }
        return nt.event_none();
    }
    if (osid.TARGET_OS == osid.OS_MACOS) {
        if (backend_name() == "macos") { return mc.poll_event(win); }
        return nt.event_none();
    }
    if (osid.TARGET_OS == osid.OS_ANDROID) {
        if (backend_name() == "android") { return andr.poll_event(win); }
        return nt.event_none();
    }
    return nt.event_none();
}

pub fn wait_event(win: nt.Window): nt.Event {
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        if (backend_name() == "win32") { return w32.wait_event(win); }
        return nt.event_none();
    }
    if (osid.TARGET_OS == osid.OS_LINUX or osid.TARGET_OS == osid.OS_FREEBSD) {
        if (backend_name() == "linux-x11") { return lx.wait_event(win); }
        return nt.event_none();
    }
    if (osid.TARGET_OS == osid.OS_MACOS) {
        if (backend_name() == "macos") { return mc.wait_event(win); }
        return nt.event_none();
    }
    if (osid.TARGET_OS == osid.OS_ANDROID) {
        if (backend_name() == "android") { return andr.wait_event(win); }
        return nt.event_none();
    }
    return nt.event_none();
}

pub fn invalidate(win: nt.Window): nil {
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        if (backend_name() == "win32") { w32.invalidate(win); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_LINUX or osid.TARGET_OS == osid.OS_FREEBSD) {
        if (backend_name() == "linux-x11") { lx.invalidate(win); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_MACOS) {
        if (backend_name() == "macos") { mc.invalidate(win); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_ANDROID) {
        if (backend_name() == "android") { andr.invalidate(win); return; }
        return;
    }
}

pub fn set_title(win: nt.Window, title: str): nil {
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        if (backend_name() == "win32") { w32.set_title(win, title); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_LINUX or osid.TARGET_OS == osid.OS_FREEBSD) {
        if (backend_name() == "linux-x11") { lx.set_title(win, title); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_MACOS) {
        if (backend_name() == "macos") { mc.set_title(win, title); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_ANDROID) {
        if (backend_name() == "android") { andr.set_title(win, title); return; }
        return;
    }
}

pub fn set_size(win: nt.Window, width: int, height: int): nil {
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        if (backend_name() == "win32") { w32.set_size(win, width, height); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_LINUX or osid.TARGET_OS == osid.OS_FREEBSD) {
        if (backend_name() == "linux-x11") { lx.set_size(win, width, height); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_MACOS) {
        if (backend_name() == "macos") { mc.set_size(win, width, height); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_ANDROID) {
        if (backend_name() == "android") { andr.set_size(win, width, height); return; }
        return;
    }
}

pub fn client_size(win: nt.Window): (int, int) {
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        if (backend_name() == "win32") { return w32.client_size(win); }
        return (0, 0);
    }
    if (osid.TARGET_OS == osid.OS_LINUX or osid.TARGET_OS == osid.OS_FREEBSD) {
        if (backend_name() == "linux-x11") { return lx.client_size(win); }
        return (0, 0);
    }
    if (osid.TARGET_OS == osid.OS_MACOS) {
        if (backend_name() == "macos") { return mc.client_size(win); }
        return (0, 0);
    }
    if (osid.TARGET_OS == osid.OS_ANDROID) {
        if (backend_name() == "android") { return andr.client_size(win); }
        return (0, 0);
    }
    return (0, 0);
}

pub fn destroy(win: nt.Window): nil {
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        if (backend_name() == "win32") { w32.destroy(win); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_LINUX or osid.TARGET_OS == osid.OS_FREEBSD) {
        if (backend_name() == "linux-x11") { lx.destroy(win); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_MACOS) {
        if (backend_name() == "macos") { mc.destroy(win); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_ANDROID) {
        if (backend_name() == "android") { andr.destroy(win); return; }
        return;
    }
}

pub fn run_message_loop(): nil {
    if (osid.TARGET_OS == osid.OS_WINDOWS) {
        if (backend_name() == "win32") { w32.run_message_loop(); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_LINUX or osid.TARGET_OS == osid.OS_FREEBSD) {
        if (backend_name() == "linux-x11") { lx.run_message_loop(); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_MACOS) {
        if (backend_name() == "macos") { mc.run_message_loop(); return; }
        return;
    }
    if (osid.TARGET_OS == osid.OS_ANDROID) {
        if (backend_name() == "android") { andr.run_message_loop(); return; }
        return;
    }
}
