        gfx_ensure_bind();
        if (slot < 0 or slot > 15) { return; }
        st_u64(_gfx_bind, 384 + slot * 8, smp);
        _gfx_desc_dirty = 1;
    }
}

// gfx_set_scissor sets the draw scissor rect in framebuffer pixels.
// w<=0 or h<=0 restores full-window scissor. Clip stacks are implemented
// by callers intersecting rects before each flush.
pub fn gfx_set_scissor(x: int, y: int, w: int, h: int): nil {
    _gfx_sc_x = x; _gfx_sc_y = y; _gfx_sc_w = w; _gfx_sc_h = h;
}

pub fn gfx_set_viewport(x: float, y: float, w: float, h: float): nil {
    _vp_x = x; _vp_y = y; _vp_w = w; _vp_h = h;
}

pub fn gfx_set_render_targets(rtvs: [int], dsv: int): nil {
    // Vulkan path renders to the swapchain framebuffer; offscreen
    // render targets are not yet supported.
}

pub fn gfx_discard_all(): nil {
    unsafe {
        if (_attached != 0) { gfx_detach(); }
    }
}

fn gfx_reg_destroy_one(idx: int): nil {
    unsafe {
        var e = ffi.ptr_add(_gfx_reg, idx * 16);
        var p = ffi.load_i64(e);
        var t = ffi.load_i64(ffi.ptr_add(e, 8));
        if (t == 1) { gfx_buf_destroy(p); }
        elif (t == 2) {
            if (_vk_destroy_shader != 0) {
                ffi.foreign_call(_vk_destroy_shader, [_device, p, 0],
                                 ffi.TYPE_VOID, [ffi.TYPE_U64, ffi.TYPE_U64, ffi.TYPE_PTR]);
            }
        }
        elif (t == 3) { gfx_tex_destroy(p); }
        elif (t == 4) {
            var sm = ffi.load_i64(ffi.ptr_add(p, 0));
            if (sm != 0 and _vk_destroy_sampler != 0) {
                ffi.foreign_call(_vk_destroy_sampler, [_device, sm, 0],
                                 ffi.TYPE_VOID, [ffi.TYPE_U64, ffi.TYPE_U64, ffi.TYPE_PTR]);
            }
            ffi.free(p);
        }
        elif (t == 5) { ffi.free(p); }
        elif (t == 6) { ffi.free(p); }
    }
}

pub fn gfx_release_all(): nil {
    unsafe {
        gfx_discard_all();
        // destroy registered gfx objects
        var i = 0;
        while (i < _gfx_reg_count) {
            gfx_reg_destroy_one(i);
            i = i + 1;
        }
        _gfx_reg_count = 0;
        if (_gfx_bind != 0) { ffi.free(_gfx_bind); _gfx_bind = 0; }
        if (_gfx_reg != 0) { ffi.free(_gfx_reg); _gfx_reg = 0; }
        _gfx_pipe = 0; _gfx_pl = 0; _gfx_dsl = 0; _gfx_dp = 0;
        _gfx_dset = 0; _gfx_pipe_dirty = 1;
        _gfx_vs = 0; _gfx_ps = 0; _gfx_layout = 0;
        _gfx_dummy_buf = 0; _gfx_dummy_tex = 0; _gfx_dummy_smp = 0;
        _gfx_desc_dirty = 1; _cmd_bound = 0;
        gpu_shutdown();
    }
}

pub fn gfx_device_ok(): int {
    if (_device != 0) { return 1; }
    return 0;
}

pub fn gfx_context(): int { return _device; }
pub fn gfx_device(): int { return _device; }

pub fn gfx_map_dynamic(buf: int): int {
    unsafe {
        if (buf == 0) { return 0; }
        return ffi.load_i64(ffi.ptr_add(buf, 16));
    }
}

pub fn gfx_unmap(buf: int): nil {}

// gpu_release frees only the ffi record memory. Object teardown is
// gpu_shutdown's job.
pub fn gpu_release(obj: int): int {
    unsafe {
        if (obj != 0) { ffi.free(obj); }
        return 1;
    }
}

// gpu_shutdown destroys device-level objects, the instance, and unloads
// the loader. Buffer/pipe records should be gpu_release'd first.
pub fn gpu_shutdown(): int {
    unsafe {
        if (_attached != 0) { gfx_detach(); }
        if (_device != 0 and _vk_destroy_device != 0) {
            ffi.foreign_call(_vk_destroy_device, [_device, 0], ffi.TYPE_VOID,
                             [ffi.TYPE_U64, ffi.TYPE_PTR]);
        }
        _device = 0; _queue = 0; _physdev = 0;
        _cmd_pool = 0; _cmd_buf = 0; _fence = 0;
        if (_instance != 0 and _vk_destroy_instance != 0) {
            ffi.foreign_call(_vk_destroy_instance, [_instance, 0],
                             ffi.TYPE_VOID,
                             [ffi.TYPE_U64, ffi.TYPE_PTR]);
        }
        _instance = 0;
        return 1;
    }
}
