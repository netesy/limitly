import std.core as core;
import std.random as random;

frame CryptoRandom {
    pub fn bytes(length: int): core.ResultStr {
        if (length < 0) return core.err_str("invalid length");
        // No native CSPRNG builtin available; fall back to the std PRNG so
        // each call returns distinct output (not cryptographically secure).
        var hex: str = "0123456789abcdef";
        var out: str = "";
        var i: int = 0;
        while (i < length) {
            var b: int = random.random_int(0, 255);
            var hi: int = (b / 16) % 16;
            var lo: int = b % 16;
            out = out + substring(hex, hi, hi + 1);
            out = out + substring(hex, lo, lo + 1);
            i = i + 1;
        }
        return core.ok_str(out);
    }

    pub fn int(min: int, max: int): core.ResultInt { return core.ok_int(random.random_int(min, max)); }
}
