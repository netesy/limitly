// Cryptographically Secure Random Number Generator
// Uses the native ENTROPY resource (type 12) backed by getrandom(2) /dev/urandom.

import std.core as core;
import std.encoding as encoding;

var RT_ENTROPY: int = 12;
var OP_READ: int = 2;

frame CryptoRandom {

    // Generate `length` random bytes, returned as a hex string.
    pub fn bytes_hex(length: int): core.ResultStr {
        if (length < 0) return core.err_str("negative length");
        if (length == 0) return core.ok_str("");
        var entropy = resource_create(RT_ENTROPY, [ []]);
        if (entropy == -1) return core.err_str("entropy source unavailable");
        var raw = resource_call(entropy, OP_READ, [length]);
        resource_destroy(entropy);
        if (raw == nil) return core.err_str("entropy read failed");
        // raw is a string of binary data; encode as hex
        var result: str = "";
        var i: int = 0;
        var hex_chars: str = "0123456789abcdef";
        while (i < len(raw as str)) {
            var ch: str = substring(raw as str, i, i + 1);
            var b: int = byte_ord(ch);
            result = result + substring(hex_chars, (b >> 4) & 0xF, ((b >> 4) & 0xF) + 1);
            result = result + substring(hex_chars, b & 0xF, (b & 0xF) + 1);
            i = i + 1;
        }
        return core.ok_str(result);
    }

    // Generate `count` random bytes, returned as a base64 string.
    pub fn bytes_base64(count: int): core.ResultStr {
        if (count < 0) return core.err_str("negative count");
        if (count == 0) return core.ok_str("");
        var entropy = resource_create(RT_ENTROPY, [ []]);
        if (entropy == -1) return core.err_str("entropy source unavailable");
        var raw = resource_call(entropy, OP_READ, [count]);
        resource_destroy(entropy);
        if (raw == nil) return core.err_str("entropy read failed");
        // Convert raw binary string to byte array then base64
        var bytes: [int] = string_to_bytes(raw as str);
        var encoded: str = encoding.Encoding.base64_encode(bytes);
        return core.ok_str(encoded);
    }

    // Generate a cryptographically secure random integer in [min, max).
    pub fn int_range(min: int, max: int): core.ResultInt {
        if (min >= max) return core.err_int("invalid range: min must be less than max");
        var range_size: int = max - min;
        // Read 4 bytes for a 32-bit random value
        var entropy = resource_create(RT_ENTROPY, [ []]);
        if (entropy == -1) return core.err_int("entropy source unavailable");
        var raw = resource_call(entropy, OP_READ, [4]);
        resource_destroy(entropy);
        if (raw == nil) return core.err_int("entropy read failed");
        // Use modular reduction (simplified; real impl would use rejection sampling)
        var val: int = 0;
        var i: int = 0;
        var s: str = raw as str;
        while (i < len(s) and i < 4) {
            var b: int = byte_ord(substring(s, i, i + 1));
            val = val | (b << (i * 8));
            i = i + 1;
        }
        if (val < 0) val = -val;
        return core.ok_int(min + (val % range_size));
    }

    // Generate a UUID v4 (cryptographically random)
    pub fn uuid(): core.ResultStr {
        var entropy = resource_create(RT_ENTROPY, [ []]);
        if (entropy == -1) return core.err_str("entropy source unavailable");
        var raw = resource_call(entropy, OP_READ, [16]);
        resource_destroy(entropy);
        if (raw == nil) return core.err_str("entropy read failed");
        var s: str = raw as str;
        var hex_chars: str = "0123456789abcdef";
        var result: str = "";
        var i: int = 0;
        while (i < 16) {
            if (i == 4 or i == 6 or i == 8 or i == 10) {
                result = result + "-";
            }
            var b: int = byte_ord(substring(s, i, i + 1));
            if (i == 6) {
                // Version 4: set top 4 bits to 0100
                b = (b & 0x0F) | 0x40;
            }
            if (i == 8) {
                // Variant 1: set top 2 bits to 10
                b = (b & 0x3F) | 0x80;
            }
            result = result + substring(hex_chars, (b >> 4) & 0xF, ((b >> 4) & 0xF) + 1);
            result = result + substring(hex_chars, b & 0xF, (b & 0xF) + 1);
            i = i + 1;
        }
        return core.ok_str(result);
    }

    // Generate a random alphanumeric string of the given length
    pub fn string(length: int, alphabet: str): core.ResultStr {
        if (length < 0) return core.err_str("negative length");
        if (length == 0) return core.ok_str("");
        if (alphabet == "") alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        var result: str = "";
        var i: int = 0;
        while (i < length) {
            var idx_result = self.int_range(0, len(alphabet));
            if (idx_result.is_err()) return core.err_str("random generation failed");
            var idx: int = idx_result.unwrap();
            result = result + substring(alphabet, idx, idx + 1);
            i = i + 1;
        }
        return core.ok_str(result);
    }
}

// ---- Internal helpers ----
fn byte_ord(ch: str): int {
    if (ch >= "a" and ch <= "z") return 97 + (len(ch) == 1 ? (ch - "a") : 0);
    if (ch >= "A" and ch <= "Z") return 65 + (len(ch) == 1 ? (ch - "A") : 0);
    if (ch >= "0" and ch <= "9") return 48 + (len(ch) == 1 ? (ch - "0") : 0);
    if (ch == " ") return 32;
    if (ch == "\n") return 10;
    if (ch == "\r") return 13;
    if (ch == "\t") return 9;
    return 0;
}

fn string_to_bytes(s: str): [int] {
    var bytes: [int] = [];
    var i: int = 0;
    while (i < len(s)) {
        bytes = bytes + [byte_ord(substring(s, i, i + 1))];
        i = i + 1;
    }
    return bytes;
}