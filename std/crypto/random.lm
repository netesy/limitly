// std/crypto/random.lm
// Clean cryptographically secure pseudo-random number generator (CSPRNG) using OpenSSL

import std.ffi as ffi;
import std.crypto.hash as hash;

frame Random {
    pub fn hex(num_bytes: int): str {
        return random_hex(num_bytes);
    }

    pub fn uuid(): str {
        return uuid();
    }

    pub fn int_range(min: int, max: int): int {
        return random_int(min, max);
    }

    pub fn string(length: int, alphabet: str = ""): str {
        return random_string(length, alphabet);
    }
}

pub fn random_hex(num_bytes: int): str {
    if (num_bytes <= 0) { return ""; }
    var out_str: str = "";
    unsafe {
        var lib = hash._open_lib();
        if (lib != nil and lib != 0) {
            var fn_rnd = ffi.library_get_symbol(lib, "crypto_random_hex");
            if (fn_rnd != nil and fn_rnd != 0) {
                var out_buf: int = ffi.alloc(num_bytes * 2 + 4);
                var ok_code = ffi.foreign_call(
                    fn_rnd,
                    [out_buf, num_bytes],
                    ffi.TYPE_I32,
                    [ffi.TYPE_PTR, ffi.TYPE_I32]
                );
                if (ok_code == 1) {
                    out_str = ffi.cstring_to_string(out_buf);
                }
                ffi.free(out_buf);
            }
        }
    }
    return out_str;
}

pub fn uuid(): str {
    var h: str = random_hex(16);
    if (len(h) < 32) { return ""; }
    var p1 = _builtin_substring(h, 0, 8);
    var p2 = _builtin_substring(h, 8, 12);
    var p3 = "4" + _builtin_substring(h, 13, 16);
    var p4 = "a" + _builtin_substring(h, 17, 20);
    var p5 = _builtin_substring(h, 20, 32);
    return p1 + "-" + p2 + "-" + p3 + "-" + p4 + "-" + p5;
}

pub fn random_int(min: int, max: int): int {
    if (min >= max) { return min; }
    var range_size = max - min;
    var result_val = min;
    unsafe {
        var lib = hash._open_lib();
        if (lib != nil and lib != 0) {
            var fn_bytes = ffi.library_get_symbol(lib, "crypto_random_bytes");
            if (fn_bytes != nil and fn_bytes != 0) {
                var buf = ffi.alloc(4);
                ffi.foreign_call(
                    fn_bytes,
                    [buf, 4],
                    ffi.TYPE_I32,
                    [ffi.TYPE_PTR, ffi.TYPE_I32]
                );
                var raw = ffi.load_u32(buf);
                ffi.free(buf);
                result_val = min + (raw % range_size);
            }
        }
    }
    return result_val;
}

pub fn random_string(length: int, alphabet: str = ""): str {
    if (length <= 0) { return ""; }
    var alpha = alphabet;
    if (alpha == "") {
        alpha = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    }
    var alpha_len = len(alpha);
    var result_str = "";
    var i = 0;
    while (i < length) {
        var idx = random_int(0, alpha_len);
        result_str = result_str + _builtin_substring(alpha, idx, idx + 1);
        i = i + 1;
    }
    return result_str;
}
