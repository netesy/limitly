// Cryptographic Hash Functions Module

import std.resource as res;
import std.core as core;
import std.core show Error;

frame Hasher {
    var resource: res.Resource;
    pub init(r: res.Resource) { self.resource = r; }
    pub fn open_algo(algo: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_OPEN, args=[algo]);
        return (result == true);
    }
    pub fn update(data: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_WRITE, args=[data]);
        return (result == true);
    }
    pub fn finalize(): any {
        return res._call(h=self.resource.handle, op=res.OP_READ, args=[]);
    }
}

frame HashEngine {
    pub var resource: res.Resource;
    pub var hasher: Hasher;
    pub init(h: int) {
        self.resource = res.Resource(h=h, k=res.KIND_HASH_ENGINE);
        self.hasher = Hasher(r=self.resource);
    }
}

frame Hash {
    pub fn hash(data: str, algorithm: str): str?Error {
        match (res.create_hash_engine()) {
            val engine_res => {
                var engine = HashEngine(h=engine_res.handle);
                if (not engine.hasher.open_algo(algo=algorithm)) {
                    engine.resource.close();
                    return err(Error(code="ERR", message="fail"));
                }
                if (not engine.hasher.update(data=data)) {
                    engine.resource.close();
                    return err(Error(code="ERR", message="fail"));
                }
                var result = engine.hasher.finalize();
                engine.resource.close();
                if (result == nil) return err(Error(code="ERR", message="fail"));
                return ok(result as str);
            },
            err e => return err(Error(code="ERR", message="fail"))
        }
    }

    pub fn sha256(data: str): str?Error {
        match (self.hash(data=data, algorithm="sha256")) {
            val s => return ok(s),
            err e => return err(Error(code="ERR", message="fail"))
        }
    }
    pub fn sha512(data: str): str?Error {
        match (self.hash(data=data, algorithm="sha512")) {
            val s => return ok(s),
            err e => return err(Error(code="ERR", message="fail"))
        }
    }
    pub fn md5(data: str): str?Error {
        match (self.hash(data=data, algorithm="md5")) {
            val s => return ok(s),
            err e => return err(Error(code="ERR", message="fail"))
        }
    }
    pub fn sha1(data: str): str?Error {
        match (self.hash(data=data, algorithm="sha1")) {
            val s => return ok(s),
            err e => return err(Error(code="ERR", message="fail"))
        }
    }

    pub fn create(algorithm: str): int?Error {
        match (res.create_hash_engine()) {
            val engine_res => {
                var engine = HashEngine(h=engine_res.handle);
                if (not engine.hasher.open_algo(algo=algorithm)) {
                    engine.resource.close();
                    return err(Error(code="ERR", message="fail"));
                }
                return ok(engine_res.handle);
            },
            err e => return err(Error(code="ERR", message="fail"))
        }
    }

    pub fn update(handle: int, data: str): nil?Error {
        var engine = HashEngine(h=handle);
        if (not engine.hasher.update(data=data)) return err(Error(code="ERR", message="fail"));
        return ok(nil);
    }

    pub fn finalize(handle: int): str?Error {
        var engine = HashEngine(h=handle);
        var result = engine.hasher.finalize();
        engine.resource.close();
        if (result == nil) return err(Error(code="ERR", message="fail"));
        return ok(result as str);
    }
}

pub fn sha256(data: str): str?Error {
    match (Hash.sha256(data=data)) {
        val s => return ok(s),
        err e => return err(Error(code="ERR", message="fail"))
    }
}
pub fn sha512(data: str): str?Error {
    match (Hash.sha512(data=data)) {
        val s => return ok(s),
        err e => return err(Error(code="ERR", message="fail"))
    }
}
pub fn md5(data: str): str?Error {
    match (Hash.md5(data=data)) {
        val s => return ok(s),
        err e => return err(Error(code="ERR", message="fail"))
    }
}
pub fn sha1(data: str): str?Error {
    match (Hash.sha1(data=data)) {
        val s => return ok(s),
        err e => return err(Error(code="ERR", message="fail"))
    }
}

fn byte_ord(ch: str): int {
    var alphabet = "abcdefghijklmnopqrstuvwxyz";
    for (var i = 0; i < len(alphabet); i = i + 1) {
        if (substring(alphabet, i, i + 1) == ch) return 97 + i;
    }
    var u_alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    for (var i = 0; i < len(u_alphabet); i = i + 1) {
        if (substring(u_alphabet, i, i + 1) == ch) return 65 + i;
    }
    var digits = "0123456789";
    for (var i = 0; i < len(digits); i = i + 1) {
        if (substring(digits, i, i + 1) == ch) return 48 + i;
    }
    if (ch == " ") return 32;
    if (ch == "\n") return 10;
    if (ch == "\r") return 13;
    if (ch == "\t") return 9;
    return 0;
}
