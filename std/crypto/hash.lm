// Cryptographic Hash Functions Module
// Uses the native HASH_ENGINE resource for correct SHA-256/512/MD5/SHA-1.

import std.core as core;
import std.resource as res;

frame Hash {

    // ---- Core: hash a string with a given algorithm ----
    pub fn hash(data: str, algorithm: str): str?core.Error {
        if (algorithm != "sha256" and algorithm != "sha512" and algorithm != "md5" and algorithm != "sha1") {
            return err(core.Error { code: "ERR", message: "unsupported algorithm: " + algorithm });
        }
        match res.create_hash_engine() {
            case ok(engine_res) => {
                var hasher = res.Hasher(engine_res);
                if (not hasher.open_algo(algorithm)) {
                    engine_res.close();
                    return err(core.Error { code: "ERR", message: "failed to initialize " + algorithm });
                }

                if (not hasher.update(data)) {
                    engine_res.close();
                    return err(core.Error { code: "ERR", message: "failed to feed data to " + algorithm });
                }

                var result = hasher.finalize();
                engine_res.close();

                if (result == nil) return err(core.Error { code: "ERR", message: algorithm + " digest computation failed" });
                return ok(result as str);
            }
            case err(e) => return err(core.Error { code: "ERR", message: "failed to create hash engine resource" });
        }
    }

    // ---- SHA-256 ----
    pub fn sha256(data: str): str?core.Error { return self.hash(data, "sha256"); }

    // ---- SHA-512 ----
    pub fn sha512(data: str): str?core.Error { return self.hash(data, "sha512"); }

    // ---- MD5 ----
    pub fn md5(data: str): str?core.Error { return self.hash(data, "md5"); }

    // ---- SHA-1 ----
    pub fn sha1(data: str): str?core.Error { return self.hash(data, "sha1"); }

    // ---- Streaming API: create a hash engine, update, then finalize ----
    pub fn create(algorithm: str): int?core.Error {
        if (algorithm != "sha256" and algorithm != "sha512" and algorithm != "md5" and algorithm != "sha1") {
            return err(core.Error { code: "ERR", message: "unsupported algorithm: " + algorithm });
        }
        match res.create_hash_engine() {
            case ok(engine_res) => {
                var hasher = res.Hasher(engine_res);
                if (not hasher.open_algo(algorithm)) {
                    engine_res.close();
                    return err(core.Error { code: "ERR", message: "failed to initialize " + algorithm });
                }
                return ok(engine_res._handle());
            }
            case err(e) => return err(core.Error { code: "ERR", message: "failed to create hash engine resource" });
        }
    }

    pub fn update(handle: int, data: str): nil?core.Error {
        if (handle <= 0) return err(core.Error { code: "ERR", message: "invalid hash engine handle" });
        var engine_res = res.adopt_hash_engine(handle);
        var hasher = res.Hasher(engine_res);
        if (not hasher.update(data)) return err(core.Error { code: "ERR", message: "failed to update hash" });
        return ok(nil);
    }

    pub fn finalize(handle: int): str?core.Error {
        if (handle <= 0) return err(core.Error { code: "ERR", message: "invalid hash engine handle" });
        var engine_res = res.adopt_hash_engine(handle);
        var hasher = res.Hasher(engine_res);
        var result = hasher.finalize();
        engine_res.close();
        if (result == nil) return err(core.Error { code: "ERR", message: "hash finalization failed" });
        return ok(result as str);
    }

    // ---- HMAC implementations ----
    pub fn hmac(data: str, key: str, algorithm: str): str?core.Error {
        match res.create_hash_engine() {
            case ok(engine_res) => {
                var hasher = res.Hasher(engine_res);
                var result = hasher.hmac(algorithm, key, data);
                engine_res.close();
                if (result == nil) return err(core.Error { code: "ERR", message: "HMAC computation failed" });
                return ok(result as str);
            }
            case err(e) => return err(core.Error { code: "ERR", message: "failed to create hash engine resource" });
        }
    }

    pub fn hmac_sha256(data: str, key: str): str?core.Error { return self.hmac(data, key, "sha256"); }
    pub fn hmac_sha512(data: str, key: str): str?core.Error { return self.hmac(data, key, "sha512"); }
    pub fn hmac_md5(data: str, key: str): str?core.Error { return self.hmac(data, key, "md5"); }
    pub fn hmac_sha1(data: str, key: str): str?core.Error { return self.hmac(data, key, "sha1"); }

    // ---- Hash verification ----
    pub fn verify(data: str, expected_hash: str, algorithm: str): bool {
        var hash_result = self.hash(data, algorithm)? else { return false; };
        return hash_result == expected_hash;
    }

    // ---- Hash comparison with constant-time semantics ----
    pub fn constant_time_compare(a: str, b: str): bool {
        if (len(a) != len(b)) return false;
        var result: int = 0;
        var i: int = 0;
        while (i < len(a)) {
            var ca: int = byte_ord(substring(a, i, i + 1));
            var cb: int = byte_ord(substring(b, i, i + 1));
            result = result | (ca ^ cb);
            i = i + 1;
        }
        return result == 0;
    }
}

// ---- Standalone convenience functions ----
pub fn sha256(data: str): str?core.Error { return Hash.sha256(data); }
pub fn sha512(data: str): str?core.Error { return Hash.sha512(data); }
pub fn md5(data: str): str?core.Error { return Hash.md5(data); }
pub fn sha1(data: str): str?core.Error { return Hash.sha1(data); }
pub fn hash_data(data: str, algorithm: str): str?core.Error { return Hash.hash(data, algorithm); }
pub fn hmac_sha256(data: str, key: str): str?core.Error { return Hash.hmac_sha256(data, key); }
pub fn hmac_sha512(data: str, key: str): str?core.Error { return Hash.hmac_sha512(data, key); }

// ---- Internal byte helpers ----
fn byte_ord(ch: str): int {
    if (ch >= "a" and ch <= "z") return 97 + (len(ch) == 1 ? (ch - "a") : 0);
    if (ch >= "A" and ch <= "Z") return 65 + (len(ch) == 1 ? (ch - "A") : 0);
    if (ch >= "0" and ch <= "9") return 48 + (len(ch) == 1 ? (ch - "0") : 0);
    if (ch == " ") return 32;
    if (ch == "\n") return 10;
    if (ch == "\r") return 13;
    if (ch == "\t") return 9;
    return 0;
}
