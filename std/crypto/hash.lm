// std/crypto/hash.lm
// Clean cryptographic hashing using OpenSSL EVP

import std.ffi as ffi;
import std.core show Disposable;

// ── Supported Hash Algorithms ───────────────────────────────────────────────
enum HashAlgorithm {
    SHA256,
    SHA512,
    SHA384,
    SHA1,
    MD5
}

/// Returns the normalized lowercase algorithm name string.
///
/// @param algo Algorithm identifier (`HashAlgorithm` enum variant or string like `"sha256"`).
/// @return Lowercase algorithm string.
pub fn algo_name(algo): str {
    var s = algo as str;
    return _builtin_string_to_lower(s);
}

// ── Shared OpenSSL library loader ──────────────────────────────────────────
var _lib_path: str = "";
var _lib_handle: int = 0;

pub fn _open_lib(): int {
    unsafe {
        if (_lib_handle != 0) {
            return _lib_handle;
        }

        if (_lib_path != "") {
            var h = ffi.library_load(_lib_path);
            if (h != 0) {
                _lib_handle = h;
                return h;
            }
        }

        var candidates: [str] = [
            "bin/liblymar_ssl.dll",
            "bin/liblymar_ssl.so",
            "bin/liblymar_ssl.dylib",
            "./bin/liblymar_ssl.dll",
            "./bin/liblymar_ssl.so",
            "./bin/liblymar_ssl.dylib",
            "liblymar_ssl.dll",
            "liblymar_ssl.so",
            "liblymar_ssl.dylib"
        ];

        iter (c in candidates) {
            var h2 = ffi.library_load(c);
            if (h2 != 0) {
                _lib_path = c;
                _lib_handle = h2;
                return h2;
            }
        }

        return 0;
    }
}

// ── Streaming Hasher frame ─────────────────────────────────────────────────
frame Hasher : Disposable {
    pub var algorithm: str;
    pub var ctx: any;
    pub var is_open: bool;

    pub init(algo: any = "sha256") {
        self.algorithm = algo_name(algo);
        self.ctx = nil;
        self.is_open = false;
        unsafe {
            var lib = _open_lib();
            if (lib != nil and lib != 0) {
                var fn_create = ffi.library_get_symbol(lib, "crypto_hasher_create");
                if (fn_create != nil and fn_create != 0) {
                    var cs_algo: ffi.CString = ffi.string_to_cstring(self.algorithm);
                    var raw_ctx = ffi.foreign_call(
                        fn_create,
                        [ffi.cstring_as_ptr(cs_algo)],
                        ffi.TYPE_PTR,
                        [ffi.TYPE_PTR]
                    );
                    ffi.cstring_free(cs_algo);
                    if (raw_ctx != nil and raw_ctx != 0) {
                        self.ctx = raw_ctx;
                        self.is_open = true;
                    }
                }
            }
        }
    }

    pub deinit() {
        self.dispose();
    }

    pub fn dispose(): nil {
        if (self.is_open and self.ctx != nil and self.ctx != 0) {
            unsafe {
                var lib = _open_lib();
                if (lib != nil and lib != 0) {
                    var fn_free = ffi.library_get_symbol(lib, "crypto_hasher_free");
                    if (fn_free != nil and fn_free != 0) {
                        ffi.foreign_call(
                            fn_free,
                            [self.ctx],
                            ffi.TYPE_VOID,
                            [ffi.TYPE_PTR]
                        );
                    }
                }
            }
            self.is_open = false;
            self.ctx = nil;
        }
        return nil;
    }

    pub fn update(data: str): Hasher {
        if (not self.is_open or self.ctx == nil or self.ctx == 0) { return self; }
        unsafe {
            var lib = _open_lib();
            if (lib != nil and lib != 0) {
                var fn_upd = ffi.library_get_symbol(lib, "crypto_hasher_update");
                if (fn_upd != nil and fn_upd != 0) {
                    var cs: ffi.CString = ffi.string_to_cstring(data);
                    ffi.foreign_call(
                        fn_upd,
                        [self.ctx, ffi.cstring_as_ptr(cs), len(data)],
                        ffi.TYPE_I32,
                        [ffi.TYPE_PTR, ffi.TYPE_PTR, ffi.TYPE_I32]
                    );
                    ffi.cstring_free(cs);
                }
            }
        }
        return self;
    }

    pub fn hex(): str {
        if (not self.is_open or self.ctx == nil or self.ctx == 0) { return ""; }
        var result_str: str = "";
        unsafe {
            var lib = _open_lib();
            if (lib != nil and lib != 0) {
                var fn_final = ffi.library_get_symbol(lib, "crypto_hasher_final_hex");
                if (fn_final != nil and fn_final != 0) {
                    var out_buf: int = ffi.alloc(130);
                    var ok_code = ffi.foreign_call(
                        fn_final,
                        [self.ctx, out_buf],
                        ffi.TYPE_I32,
                        [ffi.TYPE_PTR, ffi.TYPE_PTR]
                    );
                    if (ok_code == 1) {
                        result_str = ffi.cstring_to_string(out_buf);
                    }
                    ffi.free(out_buf);
                }
            }
        }
        self.is_open = false;
        self.ctx = nil;
        return result_str;
    }

    pub fn digest(): str {
        return self.hex();
    }
}

// ── One-shot Hash Functions ────────────────────────────────────────────────

/// Calculates a one-shot cryptographic hash of input data.
///
/// @param algo Hash algorithm (`HashAlgorithm` enum or string identifier).
/// @param data Input string to hash.
/// @return Hexadecimal digest string.
/// @example
/// ```lymar
/// var hex_digest = hash.hash("sha256", "hello world");
/// ```
pub fn hash(algo, data: str): str {
    contract(len(data) >= 0, "data must be a valid string");
    var algo_str = algo_name(algo);
    var out_str: str = "";
    unsafe {
        var lib = _open_lib();
        if (lib != nil and lib != 0) {
            var fn_hash = ffi.library_get_symbol(lib, "crypto_hash");
            if (fn_hash != nil and fn_hash != 0) {
                var cs_algo: ffi.CString = ffi.string_to_cstring(algo_str);
                var cs_data: ffi.CString = ffi.string_to_cstring(data);
                var out_buf: int = ffi.alloc(130);

                var ok_code = ffi.foreign_call(
                    fn_hash,
                    [ffi.cstring_as_ptr(cs_algo), ffi.cstring_as_ptr(cs_data), len(data), out_buf],
                    ffi.TYPE_I32,
                    [ffi.TYPE_PTR, ffi.TYPE_PTR, ffi.TYPE_I32, ffi.TYPE_PTR]
                );

                if (ok_code == 1) {
                    out_str = ffi.cstring_to_string(out_buf);
                }

                ffi.cstring_free(cs_algo);
                ffi.cstring_free(cs_data);
                ffi.free(out_buf);
            }
        }
    }
    return out_str;
}

pub fn sha256(data: str): str { return hash("sha256", data); }
pub fn sha512(data: str): str { return hash("sha512", data); }
pub fn sha384(data: str): str { return hash("sha384", data); }
pub fn sha1(data: str): str   { return hash("sha1", data); }
pub fn md5(data: str): str    { return hash("md5", data); }
