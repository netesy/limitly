// Cryptographic Hash Functions Module

import std.resource as res;
import std.core as core;
import std.core show Error;

frame Hasher {
    var resource: res.Resource;
    pub init(r: res.Resource) { self.resource = r; }
    pub fn open_algo(algo: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_OPEN, args=[algo]);
        return (result == true);
    }
    pub fn update(data: str): bool {
        var result = res._call(h=self.resource.handle, op=res.OP_WRITE, args=[data]);
        return (result == true);
    }
    pub fn finalize(): any {
        return res._call(h=self.resource.handle, op=res.OP_READ, args=[]);
    }
}

frame HashEngine {
    pub var resource: res.Resource;
    pub var hasher: Hasher;
    pub init(h: int) {
        self.resource = res.Resource(h=h, k=res.KIND_HASH_ENGINE);
        self.hasher = Hasher(r=self.resource);
    }
}

frame Hash {
    pub fn hash(data: str, algorithm: str): str?core.Error {
        match (res.create_hash_engine()) {
            val engine_res => {
                var engine = HashEngine(h=engine_res.handle);
                if (not engine.hasher.open_algo(algo=algorithm)) {
                    engine.resource.close();
                    return err(Error(code="ERR", message="fail"));
                }
                if (not engine.hasher.update(data=data)) {
                    engine.resource.close();
                    return err(Error(code="ERR", message="fail"));
                }
                var result = engine.hasher.finalize();
                engine.resource.close();
                if (result == nil) return err(Error(code="ERR", message="fail"));
                return ok(result as str);
            },
            err e => return err(Error(code="ERR", message="fail"))
        }
    }

    pub fn sha256(data: str): str?core.Error { return ok(self.hash(data=data, algorithm="sha256")?); }
    pub fn sha512(data: str): str?core.Error { return ok(self.hash(data=data, algorithm="sha512")?); }
    pub fn md5(data: str): str?core.Error { return ok(self.hash(data=data, algorithm="md5")?); }
    pub fn sha1(data: str): str?core.Error { return ok(self.hash(data=data, algorithm="sha1")?); }

    pub fn create(algorithm: str): int?core.Error {
        match (res.create_hash_engine()) {
            val engine_res => {
                var engine = HashEngine(h=engine_res.handle);
                if (not engine.hasher.open_algo(algo=algorithm)) {
                    engine.resource.close();
                    return err(Error(code="ERR", message="fail"));
                }
                return ok(engine_res.handle);
            },
            err e => return err(Error(code="ERR", message="fail"))
        }
    }

    pub fn update(handle: int, data: str): nil?core.Error {
        var engine = HashEngine(h=handle);
        if (not engine.hasher.update(data=data)) return err(Error(code="ERR", message="fail"));
        return ok(nil);
    }

    pub fn finalize(handle: int): str?core.Error {
        var engine = HashEngine(h=handle);
        var result = engine.hasher.finalize();
        engine.resource.close();
        if (result == nil) return err(Error(code="ERR", message="fail"));
        return ok(result as str);
    }
}

pub fn sha256(data: str): str?core.Error { return ok(Hash.sha256(data=data)?); }
pub fn sha512(data: str): str?core.Error { return ok(Hash.sha512(data=data)?); }
pub fn md5(data: str): str?core.Error { return ok(Hash.md5(data=data)?); }
pub fn sha1(data: str): str?core.Error { return ok(Hash.sha1(data=data)?); }

fn byte_ord(ch: str): int {
    if (ch >= "a" and ch <= "z") {
        if (len(ch) == 1) return 97 + (ch - "a");
        return 97;
    }
    if (ch >= "A" and ch <= "Z") {
        if (len(ch) == 1) return 65 + (ch - "A");
        return 65;
    }
    if (ch >= "0" and ch <= "9") {
        if (len(ch) == 1) return 48 + (ch - "0");
        return 48;
    }
    if (ch == " ") return 32;
    if (ch == "\n") return 10;
    if (ch == "\r") return 13;
    if (ch == "\t") return 9;
    return 0;
}
