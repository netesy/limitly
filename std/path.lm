// Standard Library Path Forwarder Module

import std.path.index as p;

pub type Path = p.Path;

pub fn from_string(v: str): Path {
    return p.from_string(v);
}

pub fn join(paths: [str]): Path {
    return p.join(paths);
}

pub fn normalize(path_str: str): Path {
    return p.normalize(path_str);
}
