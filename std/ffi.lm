// Foreign Function Interface (FFI) Module
// Standard C ABI Interoperability, Type Mapping, and Unmanaged Memory Operations

// Primitive C integer types
type c_char = int;
type c_short = int;
type c_int = int;
type c_long = int;
type c_longlong = int;

type c_uchar = int;
type c_ushort = int;
type c_uint = int;
type c_ulong = int;
type c_ulonglong = int;

type c_size_t = int;
type c_ssize_t = int;
type c_ptrdiff_t = int;

type c_float = float;
type c_double = float;

// Opaque pointer types
type pubptr = int;
type fnptr = int;

type c_bool = int;
type c_void = int;

// Alignment constants
pub var ALIGNMENT_CHAR: int = 1;
pub var ALIGNMENT_SHORT: int = 2;
pub var ALIGNMENT_INT: int = 4;
pub var ALIGNMENT_LONG: int = 8;
pub var ALIGNMENT_LONGLONG: int = 8;
pub var ALIGNMENT_PTR: int = 8;
pub var ALIGNMENT_FLOAT: int = 4;
pub var ALIGNMENT_DOUBLE: int = 8;
pub var ALIGNMENT_MAX: int = 8;

// Clean FFI Type Identifiers
pub var TYPE_I8: int = 0;
pub var TYPE_U8: int = 1;
pub var TYPE_I16: int = 2;
pub var TYPE_U16: int = 3;
pub var TYPE_I32: int = 4;
pub var TYPE_U32: int = 5;
pub var TYPE_I64: int = 6;
pub var TYPE_U64: int = 7;
pub var TYPE_F32: int = 8;
pub var TYPE_F64: int = 9;
pub var TYPE_PTR: int = 10;
pub var TYPE_CSTRING: int = 11;
pub var TYPE_VOID: int = 12;

// C ABI calling conventions
pub enum CallingConvention {
    CDecl,
    StdCall,
    FastCall,
    ThisCall,
    VectorCall
}

// Memory Allocation Intrinsics
pub fn alloc(size: int): pubptr { return 0; }
pub fn free(ptr: pubptr): nil {}
pub fn realloc(ptr: pubptr, new_size: int): pubptr { return 0; }

// Memory Manipulation
pub fn memcpy(dest: pubptr, src: pubptr, size: int): nil {}
pub fn memset(ptr: pubptr, value: int, size: int): nil {}
pub fn memcmp(ptr1: pubptr, ptr2: pubptr, size: int): int { return 0; }

// Pointer Arithmetic
pub fn ptr_add(ptr: pubptr, offset: int): pubptr { return ptr + offset; }
pub fn ptr_sub(ptr: pubptr, offset: int): pubptr { return ptr - offset; }
pub fn ptr_diff(ptr1: pubptr, ptr2: pubptr): int { return ptr1 - ptr2; }

pub fn ptr_align(ptr: pubptr, alignment: int): pubptr {
    var remainder: int = ptr % alignment;
    if (remainder == 0) { return ptr; }
    return ptr + (alignment - remainder);
}

pub fn ptr_is_aligned(ptr: pubptr, alignment: int): bool {
    return (ptr % alignment) == 0;
}

// Raw Memory Loading
pub fn load_i8(ptr: pubptr): int { return 0; }
pub fn load_u8(ptr: pubptr): int { return 0; }
pub fn load_i16(ptr: pubptr): int { return 0; }
pub fn load_u16(ptr: pubptr): int { return 0; }
pub fn load_i32(ptr: pubptr): int { return 0; }
pub fn load_u32(ptr: pubptr): int { return 0; }
pub fn load_i64(ptr: pubptr): int { return 0; }
pub fn load_u64(ptr: pubptr): int { return 0; }
pub fn load_f32(ptr: pubptr): float { return 0.0; }
pub fn load_f64(ptr: pubptr): float { return 0.0; }
pub fn load_ptr(ptr: pubptr): pubptr { return 0; }

// Raw Memory Storing
pub fn store_i8(ptr: pubptr, value: int): nil {}
pub fn store_u8(ptr: pubptr, value: int): nil {}
pub fn store_i16(ptr: pubptr, value: int): nil {}
pub fn store_u16(ptr: pubptr, value: int): nil {}
pub fn store_i32(ptr: pubptr, value: int): nil {}
pub fn store_u32(ptr: pubptr, value: int): nil {}
pub fn store_i64(ptr: pubptr, value: int): nil {}
pub fn store_u64(ptr: pubptr, value: int): nil {}
pub fn store_f32(ptr: pubptr, value: float): nil {}
pub fn store_f64(ptr: pubptr, value: float): nil {}
pub fn store_ptr(ptr: pubptr, value: pubptr): nil {}

// Dynamic Linking Operations
pub fn library_load(path: str): pubptr { return 0; }
pub fn library_unload(handle: pubptr): nil {}
pub fn library_get_symbol(handle: pubptr, symbol: str): fnptr { return 0; }

// Foreign Calls
pub fn foreign_call(func_ptr: fnptr, args: [any], return_type: int = 6, param_types: [any] = []): any { return 0; }

// CString wrapper
pub frame CString {
    pub var ptr: pubptr;
    pub var length: int;
    pub var is_owned: int;
}

pub fn string_to_cstring(s: str): CString {
    var len_val: int = len(s);
    var p: pubptr = 0;
    unsafe {
        p = alloc(len_val + 1);
        if (p != 0 and len_val > 0) {
            var i: int = 0;
            while (i < len_val) {
                store_i8(p + i, s[i]);
                i = i + 1;
            }
        }
        if (p != 0) {
            store_i8(p + len_val, 0);
        }
    }
    return CString(ptr=p, length=len_val, is_owned=1);
}

pub fn cstring_to_string(p: pubptr): str {
    if (p == 0) { return ""; }
    var len_val: int = 0;
    var bytes: [int] = [];
    unsafe {
        var current: pubptr = p;
        while (load_i8(current) != 0) {
            len_val = len_val + 1;
            current = current + 1;
        }
        if (len_val > 0) {
            var i: int = 0;
            while (i < len_val) {
                var b: int = load_i8(p + i);
                bytes.append(b);
                i = i + 1;
            }
        }
    }
    return _builtin_string_from_bytes(bytes);
}

pub fn cstring_free(cs: CString): nil {
    if (cs.is_owned != 0 and cs.ptr != 0) {
        unsafe {
            free(cs.ptr);
        }
    }
}

pub fn cstring_as_ptr(cs: CString): pubptr {
    return cs.ptr;
}

pub fn cstring_from_ptr(p: pubptr, take_ownership: int): CString {
    var len_val: int = 0;
    if (p != 0) {
        unsafe {
            var current: pubptr = p;
            while (load_i8(current) != 0) {
                len_val = len_val + 1;
                current = current + 1;
            }
        }
    }
    return CString(ptr=p, length=len_val, is_owned=take_ownership);
}

// High-Level Foreign Function Descriptor & Call Wrapper
pub frame ForeignFunction {
    pub var name: str;
    pub var func_ptr: fnptr;
    pub var param_types: [any];
    pub var return_type: int;

    pub fn call(arg1: any = nil, arg2: any = nil, arg3: any = nil, arg4: any = nil, arg5: any = nil, arg6: any = nil): any {
        var call_args: [any] = [];
        if (arg1 != nil) { call_args.append(arg1); }
        if (arg2 != nil) { call_args.append(arg2); }
        if (arg3 != nil) { call_args.append(arg3); }
        if (arg4 != nil) { call_args.append(arg4); }
        if (arg5 != nil) { call_args.append(arg5); }
        if (arg6 != nil) { call_args.append(arg6); }
        unsafe {
            return foreign_call(self.func_ptr, call_args, self.return_type, self.param_types);
        }
    }

    pub fn call_list(call_args: [any]): any {
        unsafe {
            return foreign_call(self.func_ptr, call_args, self.return_type, self.param_types);
        }
    }
}

pub fn declare(name: str, func_ptr: fnptr, param_types: [any], return_type: int): ForeignFunction {
    return ForeignFunction(
        name=name,
        func_ptr=func_ptr,
        param_types=param_types,
        return_type=return_type
    );
}

// High-level Library Abstraction
pub frame Library {
    pub var handle: pubptr;
    pub var path: str;
    pub var is_loaded: bool;

    pub fn symbol(symbol_name: str): fnptr {
        if (not self.is_loaded or self.handle == 0) { return 0; }
        unsafe {
            return library_get_symbol(self.handle, symbol_name);
        }
    }

    pub fn func(name: str, return_type: int, param_types: [any]): ForeignFunction {
        var sym: fnptr = self.symbol(name);
        return declare(name, sym, param_types, return_type);
    }

    pub fn close(): nil {
        if (self.is_loaded and self.handle != 0) {
            unsafe {
                library_unload(self.handle);
            }
            self.is_loaded = false;
        }
    }
}

pub fn load(path: str): Library {
    var h: pubptr = 0;
    unsafe {
        h = library_load(path);
    }
    var loaded: bool = (h != 0 and h != nil);
    return Library(handle=h, path=path, is_loaded=loaded);
}
