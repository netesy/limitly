// std.ui - Public Fluent & Composable UI Framework for Limit
// Implements semantic widget constructors, composable modifiers, and reusable styles.

frame Color {
    pub var r: float; // 0.0 to 1.0
    pub var g: float;
    pub var b: float;
    pub var a: float;

    pub init(r: float = 0.0, g: float = 0.0, b: float = 0.0, a: float = 1.0) {
        self.r = r;
        self.g = g;
        self.b = b;
        self.a = a;
    }
}

pub fn rgb(r: int, g: int, b: int): Color {
    return Color(r=(r as float) / 255.0, g=(g as float) / 255.0, b=(b as float) / 255.0, a=1.0);
}

pub fn rgba(r: int, g: int, b: int, a: float): Color {
    return Color(r=(r as float) / 255.0, g=(g as float) / 255.0, b=(b as float) / 255.0, a=a);
}

pub fn color_rgb(r: float, g: float, b: float): Color {
    return Color(r=r, g=g, b=b, a=1.0);
}

pub fn color_rgba(r: float, g: float, b: float, a: float): Color {
    return Color(r=r, g=g, b=b, a=a);
}

pub fn color_rgb8(r: int, g: int, b: int): Color {
    return rgb(r, g, b);
}

// Built-in Semantic Colors
pub var white: Color = Color(r=1.0, g=1.0, b=1.0, a=1.0);
pub var black: Color = Color(r=0.0, g=0.0, b=0.0, a=1.0);
pub var red: Color = Color(r=0.9, g=0.2, b=0.2, a=1.0);
pub var green: Color = Color(r=0.2, g=0.8, b=0.3, a=1.0);
pub var blue: Color = Color(r=0.2, g=0.6, b=0.95, a=1.0);
pub var indigo: Color = Color(r=0.35, g=0.35, b=0.9, a=1.0);
pub var yellow: Color = Color(r=0.95, g=0.8, b=0.15, a=1.0);
pub var gray: Color = Color(r=0.55, g=0.55, b=0.55, a=1.0);
pub var dark_gray: Color = Color(r=0.15, g=0.15, b=0.18, a=1.0);
pub var light_gray: Color = Color(r=0.85, g=0.85, b=0.88, a=1.0);
pub var transparent: Color = Color(r=0.0, g=0.0, b=0.0, a=0.0);

frame Alignment {
    pub var align_type: int;
}

pub var align_start: Alignment = Alignment(align_type=0);
pub var align_center: Alignment = Alignment(align_type=1);
pub var align_end: Alignment = Alignment(align_type=2);

pub var normal: int = 400;
pub var bold: int = 700;

// Reusable Style Model (LVGL / CSS Inspired)
frame Style {
    pub var has_bg: bool;
    pub var bg: Color;
    pub var has_fg: bool;
    pub var fg: Color;
    pub var has_padding: bool;
    pub var pad_l: float;
    pub var pad_t: float;
    pub var pad_r: float;
    pub var pad_b: float;
    pub var has_radius: bool;
    pub var radius: float;
    pub var has_font_size: bool;
    pub var font_size_val: float;
    pub var has_weight: bool;
    pub var weight_val: int;
    pub var has_spacing: bool;
    pub var spacing_val: float;

    pub init() {
        self.has_bg = false;
        self.bg = transparent;
        self.has_fg = false;
        self.fg = white;
        self.has_padding = false;
        self.pad_l = 0.0;
        self.pad_t = 0.0;
        self.pad_r = 0.0;
        self.pad_b = 0.0;
        self.has_radius = false;
        self.radius = 0.0;
        self.has_font_size = false;
        self.font_size_val = 14.0;
        self.has_weight = false;
        self.weight_val = 400;
        self.has_spacing = false;
        self.spacing_val = 0.0;
    }

    pub fn background(c: Color): Style {
        self.has_bg = true;
        self.bg = c;
        return self;
    }

    pub fn foreground(c: Color): Style {
        self.has_fg = true;
        self.fg = c;
        return self;
    }

    pub fn color(c: Color): Style {
        return self.foreground(c);
    }

    pub fn padding(p: float): Style {
        self.has_padding = true;
        self.pad_l = p;
        self.pad_t = p;
        self.pad_r = p;
        self.pad_b = p;
        return self;
    }

    pub fn padding_xy(x: float, y: float): Style {
        self.has_padding = true;
        self.pad_l = x;
        self.pad_t = y;
        self.pad_r = x;
        self.pad_b = y;
        return self;
    }

    pub fn corner_radius(r: float): Style {
        self.has_radius = true;
        self.radius = r;
        return self;
    }

    pub fn font_size(s: float): Style {
        self.has_font_size = true;
        self.font_size_val = s;
        return self;
    }

    pub fn weight(w: int): Style {
        self.has_weight = true;
        self.weight_val = w;
        return self;
    }

    pub fn bold(): Style {
        return self.weight(700);
    }

    pub fn spacing(s: float): Style {
        self.has_spacing = true;
        self.spacing_val = s;
        return self;
    }
}

pub fn style(): Style {
    return Style();
}

pub var KIND_CONTAINER: int = 1;
pub var KIND_TEXT: int = 2;
pub var KIND_BUTTON: int = 3;
pub var KIND_SPACER: int = 4;
pub var KIND_IMAGE: int = 5;
pub var KIND_INPUT: int = 6;
pub var KIND_CHECKBOX: int = 7;
pub var KIND_SLIDER: int = 8;
pub var KIND_TABS: int = 9;
pub var KIND_SCROLL: int = 10;
pub var KIND_BADGE: int = 11;
pub var KIND_SELECT: int = 12;

// Unified Retained UI Node with Fluent Modifiers
frame Widget {
    pub var kind: int;
    pub var text_val: str;
    pub var on_click_action: any;
    pub var children: [Widget];

    pub var foreground_color: Color;
    pub var background_color: Color;
    pub var font_size_val: float;
    pub var font_weight_val: int;
    pub var padding_left: float;
    pub var padding_top: float;
    pub var padding_right: float;
    pub var padding_bottom: float;
    pub var corner_radius_val: float;
    pub var spacing_val: float;
    pub var is_vertical: int;
    pub var align_val: int;
    pub var flex_val: float;
    pub var is_enabled: int;
    pub var is_pressed: int;
    pub var is_hovered: int;
    pub var click_count: int;
    pub var width_val: float;
    pub var height_val: float;
    pub var pressed_style_val: Style;
    pub var hover_style_val: Style;

    pub var is_checked: int;
    pub var slider_val: float;
    pub var slider_min: float;
    pub var slider_max: float;
    pub var is_focused: int;
    pub var placeholder_val: str;
    pub var active_tab: int;
    pub var hovered_tab: int;
    pub var tab_titles: [str];
    pub var scroll_y: float;
    pub var max_scroll_y: float;
    pub var on_change_action: any;
    pub var select_options: [str];
    pub var selected_idx: int;
    pub var is_open: int;

    pub init(k: int) {
        self.kind = k;
        self.text_val = "";
        self.on_click_action = nil;
        self.children = [] as [Widget];
        self.foreground_color = white;
        self.background_color = transparent;
        self.font_size_val = 14.0;
        self.font_weight_val = 400;
        self.padding_left = 0.0;
        self.padding_top = 0.0;
        self.padding_right = 0.0;
        self.padding_bottom = 0.0;
        self.corner_radius_val = 0.0;
        self.spacing_val = 0.0;
        self.is_vertical = 1;
        self.align_val = 0;
        self.flex_val = 1.0;
        self.is_enabled = 1;
        self.is_pressed = 0;
        self.is_hovered = 0;
        self.click_count = 0;
        self.width_val = 0.0;
        self.height_val = 0.0;
        self.pressed_style_val = Style();
        self.hover_style_val = Style();

        self.is_checked = 0;
        self.slider_val = 0.0;
        self.slider_min = 0.0;
        self.slider_max = 100.0;
        self.is_focused = 0;
        self.placeholder_val = "";
        self.active_tab = 0;
        self.hovered_tab = 0 - 1;
        self.tab_titles = [] as [str];
        self.scroll_y = 0.0;
        self.max_scroll_y = 0.0;
        self.on_change_action = nil;
        self.select_options = [] as [str];
        self.selected_idx = 0;
        self.is_open = 0;
    }

    pub fn checked(c: bool): Widget {
        if (c) {
            self.is_checked = 1;
            self.text_val = "[X]";
        } else {
            self.is_checked = 0;
            self.text_val = "[ ]";
        }
        return self;
    }

    pub fn placeholder(p: str): Widget {
        self.placeholder_val = p;
        return self;
    }

    pub fn on_change(act: any): Widget {
        self.on_change_action = act;
        return self;
    }

    pub fn active(idx: int): Widget {
        self.active_tab = idx;
        return self;
    }

    pub fn color(c: Color): Widget {
        self.foreground_color = c;
        return self;
    }

    pub fn foreground(c: Color): Widget {
        self.foreground_color = c;
        return self;
    }

    pub fn background(c: Color): Widget {
        self.background_color = c;
        return self;
    }

    pub fn font_size(s: float): Widget {
        self.font_size_val = s;
        return self;
    }

    pub fn weight(w: int): Widget {
        self.font_weight_val = w;
        return self;
    }

    pub fn bold(): Widget {
        self.font_weight_val = 700;
        return self;
    }

    pub fn padding(p: float): Widget {
        self.padding_left = p;
        self.padding_top = p;
        self.padding_right = p;
        self.padding_bottom = p;
        return self;
    }

    pub fn padding_xy(x: float, y: float): Widget {
        self.padding_left = x;
        self.padding_top = y;
        self.padding_right = x;
        self.padding_bottom = y;
        return self;
    }

    pub fn padding_rect(l: float, t: float, r: float, b: float): Widget {
        self.padding_left = l;
        self.padding_top = t;
        self.padding_right = r;
        self.padding_bottom = b;
        return self;
    }

    pub fn corner_radius(r: float): Widget {
        self.corner_radius_val = r;
        return self;
    }

    pub fn spacing(s: float): Widget {
        self.spacing_val = s;
        return self;
    }

    pub fn align(a: Alignment): Widget {
        self.align_val = a.align_type;
        return self;
    }

    pub fn width(w: float): Widget {
        self.width_val = w;
        return self;
    }

    pub fn height(h: float): Widget {
        self.height_val = h;
        return self;
    }

    pub fn size(w: float, h: float): Widget {
        self.width_val = w;
        self.height_val = h;
        return self;
    }

    pub fn on_click(act: any): Widget {
        self.on_click_action = act;
        return self;
    }

    pub fn pressed(s: Style): Widget {
        self.pressed_style_val = s;
        return self;
    }

    pub fn hover(s: Style): Widget {
        self.hover_style_val = s;
        return self;
    }

    pub fn style(s: Style): Widget {
        if (s.has_bg) {
            self.background_color = s.bg;
        }
        if (s.has_fg) {
            self.foreground_color = s.fg;
        }
        if (s.has_padding) {
            self.padding_left = s.pad_l;
            self.padding_top = s.pad_t;
            self.padding_right = s.pad_r;
            self.padding_bottom = s.pad_b;
        }
        if (s.has_radius) {
            self.corner_radius_val = s.radius;
        }
        if (s.has_font_size) {
            self.font_size_val = s.font_size_val;
        }
        if (s.has_weight) {
            self.font_weight_val = s.weight_val;
        }
        if (s.has_spacing) {
            self.spacing_val = s.spacing_val;
        }
        return self;
    }
}

// Semantic Widget Constructors
pub fn text(content: str): Widget {
    var w = Widget(KIND_TEXT);
    w.text_val = content;
    w.foreground_color = white;
    return w;
}

pub fn button(label: str, on_click: any = nil): Widget {
    var w = Widget(KIND_BUTTON);
    w.text_val = label;
    w.on_click_action = on_click;
    w.background_color = blue;
    w.foreground_color = white;
    w.padding_left = 10.0;
    w.padding_top = 8.0;
    w.padding_right = 10.0;
    w.padding_bottom = 8.0;
    w.corner_radius_val = 4.0;
    w.height_val = 36.0;
    return w;
}

pub fn column(children: [Widget]): Widget {
    var w = Widget(KIND_CONTAINER);
    w.is_vertical = 1;
    w.children = children;
    return w;
}

pub fn row(children: [Widget]): Widget {
    var w = Widget(KIND_CONTAINER);
    w.is_vertical = 0;
    w.children = children;
    return w;
}

pub fn stack(children: [Widget]): Widget {
    var w = Widget(KIND_CONTAINER);
    w.is_vertical = 2;
    w.children = children;
    return w;
}

pub fn spacer(flex: float = 1.0): Widget {
    var w = Widget(KIND_SPACER);
    w.flex_val = flex;
    return w;
}

pub fn empty(): Widget {
    return Widget(KIND_CONTAINER);
}

// Input & Media Semantic Constructors (Experimental)
pub fn image(source: str = ""): Widget {
    var w = Widget(KIND_IMAGE);
    w.text_val = source;
    return w;
}

pub fn input(value: str = "", placeholder: str = "Type here...", on_change: any = nil): Widget {
    var w = Widget(KIND_INPUT);
    w.text_val = value;
    w.placeholder_val = placeholder;
    w.on_change_action = on_change;
    w.background_color = rgb(20, 22, 28);
    w.foreground_color = white;
    w.height_val = 28.0;
    w.width_val = 220.0;
    w.padding_left = 8.0;
    w.padding_right = 8.0;
    w.padding_top = 6.0;
    w.padding_bottom = 6.0;
    return w;
}

pub fn checkbox(checked: bool = false, on_change: any = nil): Widget {
    var w = Widget(KIND_CHECKBOX);
    if (checked) {
        w.is_checked = 1;
        w.text_val = "[X]";
        w.foreground_color = rgb(80, 220, 130);
    } else {
        w.is_checked = 0;
        w.text_val = "[ ]";
        w.foreground_color = gray;
    }
    w.background_color = rgb(35, 38, 48);
    w.height_val = 26.0;
    w.width_val = 42.0;
    w.on_change_action = on_change;
    return w;
}

pub fn slider(value: float = 50.0, min_val: float = 0.0, max_val: float = 100.0, on_change: any = nil): Widget {
    var w = Widget(KIND_SLIDER);
    w.slider_val = value;
    w.slider_min = min_val;
    w.slider_max = max_val;
    w.on_change_action = on_change;
    w.height_val = 24.0;
    w.width_val = 140.0;
    w.background_color = rgb(35, 38, 48);
    w.foreground_color = rgb(100, 180, 255);
    return w;
}

pub fn tabs(titles: [str], pages: [Widget], active: int = 0, on_change: any = nil): Widget {
    var w = Widget(KIND_TABS);
    w.tab_titles = titles;
    w.children = pages;
    w.active_tab = active;
    w.on_change_action = on_change;
    w.height_val = 0.0;
    w.spacing_val = 6.0;
    return w;
}

pub fn badge(label: str): Widget {
    var w = Widget(KIND_BADGE);
    w.text_val = label;
    w.background_color = blue;
    w.foreground_color = white;
    w.height_val = 20.0;
    w.corner_radius_val = 4.0;
    w.padding_left = 6.0;
    w.padding_right = 6.0;
    w.padding_top = 2.0;
    w.padding_bottom = 2.0;
    return w;
}

pub fn select(options: [str], selected_idx: int = 0, on_change: any = nil): Widget {
    var w = Widget(KIND_SELECT);
    w.select_options = options;
    w.selected_idx = selected_idx;
    w.on_change_action = on_change;
    w.is_open = 0;
    w.background_color = rgb(28, 30, 38);
    w.foreground_color = white;
    w.height_val = 28.0;
    w.width_val = 180.0;
    w.padding_left = 10.0;
    w.padding_right = 10.0;
    w.corner_radius_val = 4.0;
    if (len(options) > selected_idx) {
        w.text_val = options[selected_idx];
    }
    return w;
}

pub fn scroll(content: Widget): Widget {
    var w = Widget(KIND_SCROLL);
    w.children = [content];
    w.height_val = 0.0;
    w.scroll_y = 0.0;
    w.background_color = rgb(20, 22, 28);
    return w;
}
