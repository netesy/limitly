// Standard Library Random Module
import std.math as math;
import std.resource as res;

frame Random {
    var state: int;

    pub init(seed: int = 0) {
        if (seed == 0) {
            match (res.create_entropy()) {
                case ok(r) => {
                    var rd = res.Reader(r);
                    var s = rd.read([ []]);
                    if (s != nil) {
                        self.state = s as int;
                    } else {
                        self.state = 123456789;
                    }
                    r.close();
                }
                case err(e) => {
                    self.state = 123456789;
                }
            }
        } else {
            self.state = seed;
        }
    }

    pub fn next_int(): int {
        var x = self.state;
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        self.state = x;
        return x * 0x2545F4914F6CDD1D;
    }

    pub fn next_float(): float {
        var i = self.next_int();
        if (i < 0) i = -i;
        return (i % 1000000000 as float) / 1000000000.0;
    }

    pub fn next_bool(): bool { return self.next_int() % 2 == 0; }
    pub fn range_int(min: int, max: int): int {
        if (min >= max) return min;
        var r = self.next_int();
        if (r < 0) r = -r;
        return min + (r % (max - min));
    }
    pub fn range_float(min: float, max: float): float { return min + (max - min) * self.next_float(); }
    pub fn next_bytes(count: int): [int] {
        var res = [];
        for (var i = 0; i < count; i = i + 1) {
            var b = self.next_int();
            if (b < 0) b = -b;
            res = res + [b % 256];
        }
        return res;
    }
    pub fn next_string(len: int, alphabet: str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"): str {
        var res = "";
        var a_len = length(alphabet);
        for (var i = 0; i < len; i = i + 1) {
            var idx = self.range_int(0, a_len);
            res = res + substring(alphabet, idx, idx + 1);
        }
        return res;
    }
}

frame SecureRandom {
    var reader: res.Reader?;

    pub init() {
        match (res.create_entropy()) {
            case ok(r) => self.reader = ok(res.Reader(r));
            case err(e) => self.reader = nil;
        }
    }

    pub fn next_int(): int {
        match (self.reader) {
            case ok(rd) => {
                var s = rd.read([ []]);
                if (s != nil) return s as int;
                return 0;
            }
            case nil => return 0;
        }
    }

    pub fn next_float(): float {
        var i = self.next_int();
        if (i < 0) i = -i;
        return (i % 1000000000 as float) / 1000000000.0;
    }

    pub fn next_bytes(count: int): [int] {
        var res = [];
        for (var i = 0; i < count; i = i + 1) {
            var b = self.next_int();
            if (b < 0) b = -b;
            res = res + [b % 256];
        }
        return res;
    }
}

var _default_rng: Random = Random(seed=0);
fn random_int(min: int, max: int): int { return _default_rng.range_int(min, max); }
fn random_float(min: float, max: float): float { return _default_rng.range_float(min, max); }
fn random_bool(): bool { return _default_rng.next_bool(); }
fn random_bytes(count: int): [int] { return _default_rng.next_bytes(count); }
fn random_string(len: int): str { return _default_rng.next_string(len); }
