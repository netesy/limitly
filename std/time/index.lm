import std.time.instant as instant;
import std.time.duration as duration;
import std.time.datetime as datetime;
import std.time.timezone as timezone;
import std.time.timer as timer;

pub import std.time.instant show Instant;
pub import std.time.duration show TimeDuration;
pub import std.time.datetime show DateTime;
pub import std.time.timezone show TimeZone;
pub import std.time.timer show Timer;

pub fn Instant(timestamp_ms: float): instant.Instant {
    return instant.Instant(timestamp_ms);
}

pub fn Duration(seconds: int, microseconds: int): duration.TimeDuration {
    return duration.TimeDuration(seconds, microseconds);
}

pub fn Time(timestamp: int, microseconds: int, tz: any): datetime.DateTime {
    var tz_obj = tz as timezone.TimeZone;
    return datetime.DateTime(timestamp, microseconds, tz_obj);
}

pub fn TimeZone(name: str, offset_hours: int, offset_minutes: int): timezone.TimeZone {
    return timezone.TimeZone(name, offset_hours, offset_minutes);
}

pub fn Timer(): timer.Timer {
    return timer.Timer();
}

// Global functions
pub fn sleep_ms(ms: int): nil {
    return datetime.sleep_ms(ms);
}

pub fn sleep_seconds(seconds: float): nil {
    return datetime.sleep_seconds(seconds);
}

pub fn sleep_duration(dur: any): nil {
    var d = dur as duration.TimeDuration;
    return datetime.sleep_duration(d);
}

pub fn is_leap_year(year: int): bool {
    return datetime.is_leap_year(year);
}

pub fn get_days_in_month(year: int, month: int): int {
    return datetime.get_days_in_month(year, month);
}

pub fn get_days_in_year(year: int): int {
    return datetime.get_days_in_year(year);
}

pub fn datetime_to_timestamp(year: int, month: int, day: int, hour: int, minute: int, second: int): int {
    return datetime.datetime_to_timestamp(year, month, day, hour, minute, second);
}

pub fn timestamp_to_year(timestamp: int): int {
    return datetime.timestamp_to_year(timestamp);
}

pub fn timestamp_to_month(timestamp: int): int {
    return datetime.timestamp_to_month(timestamp);
}

pub fn timestamp_to_day(timestamp: int): int {
    return datetime.timestamp_to_day(timestamp);
}
