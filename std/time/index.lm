// Standard Library Time Entrypoint Module

import std.time.instant as instant_mod;
import std.time.duration as duration_mod;
import std.time.datetime as datetime_mod;
import std.time.timezone as timezone_mod;
import std.time.timer as timer_mod;

// Types
pub type Instant = instant_mod.Instant;
pub type Duration = duration_mod.Duration;
pub type Time = datetime_mod.Time;
pub type TimeZone = timezone_mod.TimeZone;
pub type Timer = timer_mod.Timer;

// Constructors
pub fn Instant(timestamp_ms: float): any {
    return instant_mod.Instant(timestamp_ms);
}

pub fn Duration(seconds: int, microseconds: int): any {
    return duration_mod.Duration(seconds, microseconds);
}

pub fn Time(timestamp: int, microseconds: int, timezone: TimeZone): any {
    return datetime_mod.Time(timestamp, microseconds, timezone);
}

pub fn TimeZone(name: str, offset_hours: int, offset_minutes: int): any {
    return timezone_mod.TimeZone(name, offset_hours, offset_minutes);
}

pub fn Timer(): any {
    return timer_mod.Timer();
}

// Global functions
pub fn sleep_ms(ms: int): nil {
    return datetime_mod.sleep_ms(ms);
}

pub fn sleep_seconds(seconds: float): nil {
    return datetime_mod.sleep_seconds(seconds);
}

pub fn sleep_duration(duration: Duration): nil {
    return datetime_mod.sleep_duration(duration);
}

pub fn is_leap_year(year: int): bool {
    return datetime_mod.is_leap_year(year);
}

pub fn get_days_in_month(year: int, month: int): int {
    return datetime_mod.get_days_in_month(year, month);
}

pub fn get_days_in_year(year: int): int {
    return datetime_mod.get_days_in_year(year);
}

pub fn datetime_to_timestamp(year: int, month: int, day: int, hour: int, minute: int, second: int): int {
    return datetime_mod.datetime_to_timestamp(year, month, day, hour, minute, second);
}

pub fn timestamp_to_year(timestamp: int): int {
    return datetime_mod.timestamp_to_year(timestamp);
}

pub fn timestamp_to_month(timestamp: int): int {
    return datetime_mod.timestamp_to_month(timestamp);
}

pub fn timestamp_to_day(timestamp: int): int {
    return datetime_mod.timestamp_to_day(timestamp);
}
