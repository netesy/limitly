// std/time/instant.lm
// Monotonic time measurement and elapsed interval calculation.

import std.time.duration as dur;

/// Represents a point-in-time timestamp used for high-precision latency and interval measurements.
///
/// @tip Call `Instant.now()` before a task and `instant.elapsed()` after to measure duration.
/// @note Operates on system monotonic time in milliseconds.
///
/// @param timestamp_ms Milliseconds timestamp value as a float.
///
/// @example
/// import std.time as time;
/// var start = time.Instant.now();
/// // ... perform workload ...
/// var took = start.elapsed();
/// print("Completed in: {took.human_readable()}");
frame Instant {
    pub timestamp_ms: float;

    pub init(timestamp_ms: float) {
        self.timestamp_ms = timestamp_ms;
    }

    /// Captures the current monotonic timestamp.
    ///
    /// @return Fresh Instant capturing the current moment.
    pub fn now(): Instant {
        var current_time = time();
        var current_float = current_time as float;
        var result_ms = current_float * 1000.0;
        return Instant(result_ms);
    }

    /// Returns the elapsed duration since this Instant was recorded.
    ///
    /// @return Duration elapsed between this Instant and the current moment.
    pub fn elapsed(): dur.Duration {
        var current_time = time();
        var current_float = current_time as float;
        var elapsed_ms = (current_float * 1000.0) - self.timestamp_ms;
        if (elapsed_ms < 0.0) elapsed_ms = 0.0;
        var elapsed_int = elapsed_ms as int;
        return dur.Duration.from_milliseconds(elapsed_int);
    }
}
