// Standard Library Time Instant Submodule

import std.time.duration as dur;

frame Instant {
    pub var timestamp_ms: float;

    pub init(timestamp_ms: float) {
        self.timestamp_ms = timestamp_ms;
    }

    pub fn now(): Instant {
        return Instant(timestamp_ms=time() as float * 1000.0);
    }

    pub fn elapsed(): dur.Duration {
        var elapsed_ms = (time() as float * 1000.0) - self.timestamp_ms;
        if (elapsed_ms < 0.0) elapsed_ms = 0.0;
        return dur.Duration.from_milliseconds(elapsed_ms as int);
    }
}
