// Time module — Carbon-like time handling
// Proper calendar arithmetic with correct year/month/day extraction
// from Unix timestamps.

// ---- Duration frame for time arithmetic ----

frame Duration {
    var seconds: int;
    var microseconds: int;

    pub fn init(seconds: int, microseconds: int): Duration {
        return Duration(seconds=seconds, microseconds=microseconds);
    }

    // Factory methods
    pub fn from_days(days: int): Duration {
        return Duration(seconds=days * 86400, microseconds=0);
    }

    pub fn from_hours(hours: int): Duration {
        return Duration(seconds=hours * 3600, microseconds=0);
    }

    pub fn from_minutes(minutes: int): Duration {
        return Duration(seconds=minutes * 60, microseconds=0);
    }

    pub fn from_seconds(seconds: int): Duration {
        return Duration(seconds=seconds, microseconds=0);
    }

    pub fn from_milliseconds(ms: int): Duration {
        return Duration(seconds=ms / 1000, microseconds=(ms % 1000) * 1000);
    }

    pub fn from_microseconds(us: int): Duration {
        return Duration(seconds=us / 1000000, microseconds=us % 1000000);
    }

    // Arithmetic operations
    pub fn add(other: Duration): Duration {
        var total_microseconds: int = self.microseconds + other.microseconds;
        var carry: int = 0;
        if (total_microseconds >= 1000000) {
            carry = total_microseconds / 1000000;
            total_microseconds = total_microseconds % 1000000;
        }
        if (total_microseconds < 0) {
            carry = -1;
            total_microseconds = 1000000 + total_microseconds;
        }
        return Duration(
            seconds=self.seconds + other.seconds + carry,
            microseconds=total_microseconds
        );
    }

    pub fn subtract(other: Duration): Duration {
        return self.add(Duration(seconds=-other.seconds, microseconds=-other.microseconds));
    }

    pub fn multiply(factor: int): Duration {
        var total_us: int = self.seconds * 1000000 * factor + self.microseconds * factor;
        return Duration(
            seconds=total_us / 1000000,
            microseconds=((total_us % 1000000) + 1000000) % 1000000
        );
    }

    // Comparison
    pub fn equals(other: Duration): bool {
        var diff: Duration = self.subtract(other);
        return diff.seconds == 0 and diff.microseconds == 0;
    }

    pub fn greater_than(other: Duration): bool {
        if (self.seconds > other.seconds) return true;
        if (self.seconds < other.seconds) return false;
        return self.microseconds > other.microseconds;
    }

    pub fn less_than(other: Duration): bool {
        if (self.seconds < other.seconds) return true;
        if (self.seconds > other.seconds) return false;
        return self.microseconds < other.microseconds;
    }

    // Conversion
    pub fn to_seconds(): float {
        return self.seconds as float + (self.microseconds as float) / 1000000.0;
    }

    pub fn to_milliseconds(): int {
        return self.seconds * 1000 + self.microseconds / 1000;
    }

    pub fn to_microseconds(): int {
        return self.seconds * 1000000 + self.microseconds;
    }

    pub fn total_seconds(): int {
        return self.seconds;
    }

    // Formatting
    pub fn to_string(): str {
        var abs_sec: int = self.seconds;
        var abs_us: int = self.microseconds;
        if (self.seconds < 0) {
            abs_sec = -self.seconds;
            abs_us = -self.microseconds;
            if (abs_us < 0) {
                abs_us = 1000000 + abs_us;
                abs_sec = abs_sec - 1;
            }
        }
        var ms: int = abs_us / 1000;
        return abs_sec as str + "." + pad_int(ms, 3) + "s";
    }

    pub fn human_readable(): str {
        var total_sec: int = abs(self.seconds);
        var days: int = total_sec / 86400;
        var hours: int = (total_sec % 86400) / 3600;
        var minutes: int = (total_sec % 3600) / 60;
        var secs: int = total_sec % 60;

        var parts: [str] = [];
        if (days > 0) parts = parts + [days as str + "d"];
        if (hours > 0) parts = parts + [hours as str + "h"];
        if (minutes > 0) parts = parts + [minutes as str + "m"];
        if (secs > 0 or len(parts) == 0) parts = parts + [secs as str + "s"];

        var result: str = "";
        var i: int = 0;
        while (i < len(parts)) {
            if (i > 0) result = result + " ";
            result = result + parts[i];
            i = i + 1;
        }
        return result;
    }
}

// ---- Time zone frame ----

frame TimeZone {
    var name: str;
    var offset_hours: int;
    var offset_minutes: int;

    pub fn init(name: str, offset_hours: int, offset_minutes: int): TimeZone {
        return TimeZone(name=name, offset_hours=offset_hours, offset_minutes=offset_minutes);
    }

    pub fn utc(): TimeZone {
        return TimeZone(name="UTC", offset_hours=0, offset_minutes=0);
    }

    pub fn from_offset(offset_hours: int): TimeZone {
        var name: str = "UTC";
        if (offset_hours > 0) name = "UTC+" + offset_hours as str;
        if (offset_hours < 0) name = "UTC" + offset_hours as str;
        return TimeZone(name=name, offset_hours=offset_hours, offset_minutes=0);
    }

    pub fn to_seconds_offset(): int {
        return self.offset_hours * 3600 + self.offset_minutes * 60;
    }

    pub fn offset_string(): str {
        var sign: str = "+";
        var hours: int = self.offset_hours;
        var minutes: int = self.offset_minutes;
        if (hours < 0) {
            sign = "-";
            hours = -hours;
        }
        return sign + pad_int(hours, 2) + ":" + pad_int(minutes, 2);
    }
}

// ---- Main Time frame ----

frame Time {
    var timestamp: int;       // Unix timestamp in seconds
    var microseconds: int;     // Microseconds part
    var timezone: TimeZone;

    pub fn init(timestamp: int, microseconds: int, timezone: TimeZone): Time {
        return Time(timestamp=timestamp, microseconds=microseconds, timezone=timezone);
    }

    // Factory methods
    pub fn now(): Time {
        return Time(timestamp=time(), microseconds=0, timezone=TimeZone.utc());
    }

    pub fn from_timestamp(timestamp: int): Time {
        return Time(timestamp=timestamp, microseconds=0, timezone=TimeZone.utc());
    }

    pub fn from_string(datetime: str): Time? {
        // Parse ISO 8601 format: "YYYY-MM-DD HH:MM:SS" or "YYYY-MM-DDTHH:MM:SS"
        if (len(datetime) < 19) return nil;

        var year_str: str = substring(datetime, 0, 4);
        var month_str: str = substring(datetime, 5, 7);
        var day_str: str = substring(datetime, 8, 10);
        var hour_str: str = substring(datetime, 11, 13);
        var min_str: str = substring(datetime, 14, 16);
        var sec_str: str = substring(datetime, 17, 19);

        var year: int = year_str as int;
        var month: int = month_str as int;
        var day: int = day_str as int;
        var hour: int = hour_str as int;
        var minute: int = min_str as int;
        var second: int = sec_str as int;

        var ts: int = datetime_to_timestamp(year, month, day, hour, minute, second);
        return Time(timestamp=ts, microseconds=0, timezone=TimeZone.utc());
    }

    pub fn from_components(year: int, month: int, day: int, hour: int, minute: int, second: int): Time {
        var ts: int = datetime_to_timestamp(year, month, day, hour, minute, second);
        return Time(timestamp=ts, microseconds=0, timezone=TimeZone.utc());
    }

    // Time arithmetic
    pub fn add(duration: Duration): Time {
        var total_us: int = self.microseconds + duration.microseconds;
        var carry: int = 0;
        if (total_us >= 1000000) {
            carry = total_us / 1000000;
            total_us = total_us % 1000000;
        }
        if (total_us < 0) {
            carry = -1;
            total_us = 1000000 + total_us;
        }
        return Time(
            timestamp=self.timestamp + duration.seconds + carry,
            microseconds=total_us,
            timezone=self.timezone
        );
    }

    pub fn subtract(duration: Duration): Time {
        return self.add(Duration(seconds=-duration.seconds, microseconds=-duration.microseconds));
    }

    pub fn difference(other: Time): Duration {
        var sec_diff: int = self.timestamp - other.timestamp;
        var us_diff: int = self.microseconds - other.microseconds;
        return Duration(seconds=sec_diff, microseconds=us_diff);
    }

    // Time component access (proper calendar calculations)
    pub fn year(): int {
        return timestamp_to_year(self.timestamp);
    }

    pub fn month(): int {
        return timestamp_to_month(self.timestamp);
    }

    pub fn day(): int {
        return timestamp_to_day(self.timestamp);
    }

    pub fn hour(): int {
        var day_seconds: int = self.timestamp % 86400;
        if (day_seconds < 0) day_seconds = day_seconds + 86400;
        return day_seconds / 3600;
    }

    pub fn minute(): int {
        var day_seconds: int = self.timestamp % 3600;
        if (day_seconds < 0) day_seconds = day_seconds + 3600;
        return day_seconds / 60;
    }

    pub fn second(): int {
        var s: int = self.timestamp % 60;
        if (s < 0) s = s + 60;
        return s;
    }

    pub fn day_of_week(): int {
        // 0=Sunday, 1=Monday, ..., 6=Saturday
        // Unix epoch (1970-01-01) was a Thursday (4)
        var days_since_epoch: int = self.timestamp / 86400;
        if (self.timestamp < 0 and self.timestamp % 86400 != 0) {
            days_since_epoch = days_since_epoch - 1;
        }
        var dow: int = (days_since_epoch + 4) % 7;
        if (dow < 0) dow = dow + 7;
        return dow;
    }

    pub fn day_of_year(): int {
        var y: int = self.year();
        var m: int = self.month();
        var d: int = self.day();
        // Days in each month (non-leap)
        var days_before: [int] = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
        var doy: int = days_before[m - 1] + d;
        if (m > 2 and is_leap_year(y)) doy = doy + 1;
        return doy;
    }

    pub fn week_of_year(): int {
        var doy: int = self.day_of_year();
        var dow: int = self.day_of_week();
        // ISO week: week 1 is the first week with a Thursday
        var wday_monday: int = dow;
        if (wday_monday == 0) wday_monday = 7; // Convert Sunday=0 to Monday-based=7
        var week: int = (doy - wday_monday + 10) / 7;
        if (week < 1) week = 1;
        if (week > 53) week = 53;
        return week;
    }

    pub fn is_leap_year(): bool {
        return is_leap_year(self.year());
    }

    pub fn days_in_month(): int {
        return get_days_in_month(self.year(), self.month());
    }

    pub fn quarter(): int {
        var m: int = self.month();
        if (m <= 3) return 1;
        if (m <= 6) return 2;
        if (m <= 9) return 3;
        return 4;
    }

    // Time modification (with-methods)
    pub fn with_year(year: int): Time {
        return Time.from_components(year, self.month(), self.day(), self.hour(), self.minute(), self.second());
    }

    pub fn with_month(month: int): Time {
        return Time.from_components(self.year(), month, self.day(), self.hour(), self.minute(), self.second());
    }

    pub fn with_day(day: int): Time {
        return Time.from_components(self.year(), self.month(), day, self.hour(), self.minute(), self.second());
    }

    pub fn with_hour(hour: int): Time {
        return Time.from_components(self.year(), self.month(), self.day(), hour, self.minute(), self.second());
    }

    pub fn with_minute(minute: int): Time {
        return Time.from_components(self.year(), self.month(), self.day(), self.hour(), minute, self.second());
    }

    pub fn with_second(second: int): Time {
        return Time.from_components(self.year(), self.month(), self.day(), self.hour(), self.minute(), second);
    }

    pub fn with_timezone(tz: TimeZone): Time {
        var offset_diff: int = tz.to_seconds_offset() - self.timezone.to_seconds_offset();
        return Time(
            timestamp=self.timestamp + offset_diff,
            microseconds=self.microseconds,
            timezone=tz
        );
    }

    pub fn to_timezone(tz: TimeZone): Time {
        return self.with_timezone(tz);
    }

    // Comparison
    pub fn equals(other: Time): bool {
        var diff: Duration = self.difference(other);
        return diff.seconds == 0 and diff.microseconds == 0;
    }

    pub fn greater_than(other: Time): bool {
        if (self.timestamp > other.timestamp) return true;
        if (self.timestamp < other.timestamp) return false;
        return self.microseconds > other.microseconds;
    }

    pub fn less_than(other: Time): bool {
        if (self.timestamp < other.timestamp) return true;
        if (self.timestamp > other.timestamp) return false;
        return self.microseconds < other.microseconds;
    }

    pub fn is_between(start: Time, end: Time): bool {
        return self.greater_than(start) and self.less_than(end);
    }

    // Formatting
    pub fn format(fmt: str): str {
        var year: int = self.year();
        var month: int = self.month();
        var day: int = self.day();
        var hour: int = self.hour();
        var minute: int = self.minute();
        var second: int = self.second();

        var result: str = "";
        var i: int = 0;
        while (i < len(fmt)) {
            if (substring(fmt, i, i + 1) == "Y") {
                result = result + pad_int(year, 4);
                i = i + 1;
            } else if (substring(fmt, i, i + 1) == "m") {
                result = result + pad_int(month, 2);
                i = i + 1;
            } else if (substring(fmt, i, i + 1) == "d") {
                result = result + pad_int(day, 2);
                i = i + 1;
            } else if (substring(fmt, i, i + 1) == "H") {
                result = result + pad_int(hour, 2);
                i = i + 1;
            } else if (substring(fmt, i, i + 1) == "i") {
                result = result + pad_int(minute, 2);
                i = i + 1;
            } else if (substring(fmt, i, i + 1) == "s") {
                result = result + pad_int(second, 2);
                i = i + 1;
            } else {
                result = result + substring(fmt, i, i + 1);
                i = i + 1;
            }
        }
        return result;
    }

    pub fn to_iso_string(): str {
        return self.format("Y-m-d H:i:s");
    }

    pub fn to_iso8601(): str {
        return self.format("Y-m-d") + "T" + self.format("H:i:s") + "Z";
    }

    pub fn to_date_string(): str {
        return self.format("Y-m-d");
    }

    pub fn to_time_string(): str {
        return self.format("H:i:s");
    }

    pub fn to_rfc2822(): str {
        var days: [str] = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
        var months: [str] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        var dow: int = self.day_of_week();
        var m: int = self.month();
        return days[dow] + ", " + pad_int(self.day(), 2) + " " + months[m - 1] + " " + self.year() as str + " " + self.format("H:i:s") + " +0000";
    }

    pub fn to_string(): str {
        return self.to_iso_string() + " " + self.timezone.name;
    }

    // Utility methods
    pub fn is_weekend(): bool {
        var dow: int = self.day_of_week();
        return dow == 0 or dow == 6;
    }

    pub fn is_weekday(): bool {
        return not self.is_weekend();
    }

    pub fn start_of_day(): Time {
        var day_start: int = self.timestamp - (self.timestamp % 86400);
        return Time(timestamp=day_start, microseconds=0, timezone=self.timezone);
    }

    pub fn end_of_day(): Time {
        var day_start: int = self.timestamp - (self.timestamp % 86400);
        return Time(timestamp=day_start + 86399, microseconds=999999, timezone=self.timezone);
    }

    pub fn start_of_week(): Time {
        var dow: int = self.day_of_week();
        var days_back: int = dow;
        return self.subtract(Duration.from_days(days_back)).start_of_day();
    }

    pub fn start_of_month(): Time {
        return Time.from_components(self.year(), self.month(), 1, 0, 0, 0);
    }

    pub fn end_of_month(): Time {
        var days: int = get_days_in_month(self.year(), self.month());
        return Time.from_components(self.year(), self.month(), days, 23, 59, 59);
    }

    pub fn start_of_year(): Time {
        return Time.from_components(self.year(), 1, 1, 0, 0, 0);
    }

    pub fn end_of_year(): Time {
        return Time.from_components(self.year(), 12, 31, 23, 59, 59);
    }

    pub fn start_of_quarter(): Time {
        var q: int = self.quarter();
        var m: int = (q - 1) * 3 + 1;
        return Time.from_components(self.year(), m, 1, 0, 0, 0);
    }

    pub fn age(birthdate: Time): Duration {
        return self.difference(birthdate);
    }
}

// ---- Global utility functions ----

fn sleep_ms(ms: int): nil {
    sleep((ms as float) / 1000.0);
}

fn sleep_seconds(seconds: float): nil {
    sleep(seconds);
}

fn sleep_duration(duration: Duration): nil {
    sleep_ms(duration.to_milliseconds());
}

// ---- Calendar calculation functions ----

fn is_leap_year(year: int): bool {
    if (year % 4 != 0) return false;
    if (year % 100 != 0) return true;
    if (year % 400 != 0) return false;
    return true;
}

fn get_days_in_month(year: int, month: int): int {
    var days: [int] = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if (month == 2 and is_leap_year(year)) return 29;
    return days[month - 1];
}

fn get_days_in_year(year: int): int {
    if (is_leap_year(year)) return 366;
    return 365;
}

// Convert a date/time to a Unix timestamp
fn datetime_to_timestamp(year: int, month: int, day: int, hour: int, minute: int, second: int): int {
    // Count total days from 1970-01-01
    var total_days: int = 0;
    var y: int = 1970;

    // Add full years
    while (y < year) {
        total_days = total_days + get_days_in_year(y);
        y = y + 1;
    }
    while (y > year) {
        y = y - 1;
        total_days = total_days - get_days_in_year(y);
    }

    // Add full months
    var m: int = 1;
    while (m < month) {
        total_days = total_days + get_days_in_month(year, m);
        m = m + 1;
    }

    // Add days (day is 1-based, so subtract 1)
    total_days = total_days + (day - 1);

    // Add time
    return total_days * 86400 + hour * 3600 + minute * 60 + second;
}

// Extract year from a Unix timestamp
fn timestamp_to_year(timestamp: int): int {
    // Binary search / iterative approach
    if (timestamp >= 0) {
        var days: int = timestamp / 86400;
        var year: int = 1970;
        var remaining: int = days;
        while (remaining >= get_days_in_year(year)) {
            remaining = remaining - get_days_in_year(year);
            year = year + 1;
        }
        return year;
    } else {
        var days: int = -timestamp / 86400;
        if (-timestamp % 86400 != 0) days = days + 1;
        var year: int = 1970;
        var remaining: int = days;
        while (remaining >= get_days_in_year(year - 1)) {
            year = year - 1;
            remaining = remaining - get_days_in_year(year);
        }
        return year - 1;
    }
}

// Extract month from a Unix timestamp
fn timestamp_to_month(timestamp: int): int {
    var year: int = timestamp_to_year(timestamp);
    var year_start: int = datetime_to_timestamp(year, 1, 1, 0, 0, 0);
    var days_in_year: int = timestamp - year_start;
    if (days_in_year < 0) days_in_year = 0;
    var day_of_year: int = days_in_year / 86400;

    var m: int = 1;
    while (m <= 12) {
        var dim: int = get_days_in_month(year, m);
        if (day_of_year < dim) return m;
        day_of_year = day_of_year - dim;
        m = m + 1;
    }
    return 12;
}

// Extract day from a Unix timestamp
fn timestamp_to_day(timestamp: int): int {
    var year: int = timestamp_to_year(timestamp);
    var month: int = timestamp_to_month(timestamp);
    var month_start: int = datetime_to_timestamp(year, month, 1, 0, 0, 0);
    var days_since_month_start: int = timestamp - month_start;
    if (days_since_month_start < 0) days_since_month_start = 0;
    return (days_since_month_start / 86400) + 1;
}

fn pad_int(n: int, width: int): str {
    var s: str = n as str;
    while (len(s) < width) {
        s = "0" + s;
    }
    return s;
}