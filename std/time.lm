// Standard Library Time Forwarder Module

import std.time.index as t;

pub type Duration = t.Duration;
pub type TimeZone = t.TimeZone;
pub type Time = t.Time;

pub fn sleep_ms(ms: int): nil { t.sleep_ms(ms); }
pub fn sleep_seconds(seconds: float): nil { t.sleep_seconds(seconds); }
pub fn sleep_duration(duration: Duration): nil { t.sleep_duration(duration); }

pub fn is_leap_year(year: int): bool { return t.is_leap_year(year); }
pub fn get_days_in_month(year: int, month: int): int { return t.get_days_in_month(year, month); }
pub fn get_days_in_year(year: int): int { return t.get_days_in_year(year); }

pub fn datetime_to_timestamp(year: int, month: int, day: int, hour: int, minute: int, second: int): int {
    return t.datetime_to_timestamp(year, month, day, hour, minute, second);
}

pub fn timestamp_to_year(timestamp: int): int { return t.timestamp_to_year(timestamp); }
pub fn timestamp_to_month(timestamp: int): int { return t.timestamp_to_month(timestamp); }
pub fn timestamp_to_day(timestamp: int): int { return t.timestamp_to_day(timestamp); }
