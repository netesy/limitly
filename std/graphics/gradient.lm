// std/graphics/gradient.lm
// Gradient submodule for std.graphics. 2D/3D graphics abstractions, canvases, shaders, and rendering pipelines.

import std.color as color;

frame Gradient {
    pub var colors: [color.Color];
    pub var stops: [float];

    pub init(cols: [color.Color] = [color.Color()], stps: [float] = [0.0]) {
        self.colors = cols;
        self.stops = stps;
    }
}
