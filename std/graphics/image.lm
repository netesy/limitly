// Portable Image representation for std.graphics

frame Image {
    pub var width: int;
    pub var height: int;
    pub var channels: int;
    pub var pixels: int;
    pub var lib_handle: int;

    pub init(w: int = 0, h: int = 0, c: int = 4, p: int = 0, hnd: int = 0) {
        self.width = w;
        self.height = h;
        self.channels = c;
        self.pixels = p;
        self.lib_handle = hnd;
    }
}

pub fn load(filename: str): Image {
    return Image(w=100, h=100, c=4, p=0, hnd=0);
}

pub fn save_png(img: Image, filename: str): bool {
    return true;
}

pub fn free(img: Image): nil {}
