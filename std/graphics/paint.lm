// std/graphics/paint.lm
// Paint submodule for std.graphics. 2D/3D graphics abstractions, canvases, shaders, and rendering pipelines.

import std.color as color;
import std.graphics.brush as brush;

frame Paint {
    pub var color_val: color.Color;
    pub var brush_val: brush.Brush;
    pub var stroke_width: float;
    pub var is_stroke: bool;

    pub init() {
        self.color_val = color.rgb(0, 0, 0);
        self.brush_val = brush.Brush();
        self.stroke_width = 1.0;
        self.is_stroke = false;
    }
}
