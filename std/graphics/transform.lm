// std/graphics/transform.lm
// Transform submodule for std.graphics. 2D/3D graphics abstractions, canvases, shaders, and rendering pipelines.

import std.math.matrix as matrix;

frame Transform {
    pub var matrix_val: matrix.Matrix;

    pub init(m: matrix.Matrix? = nil) {
        if (m != nil) {
            self.matrix_val = m as matrix.Matrix;
        } else {
            self.matrix_val = matrix.Matrix();
        }
    }
}
