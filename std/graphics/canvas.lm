import std.graphics.rect as rect;
import std.graphics.paint as paint;
import std.graphics.color as color;
import std.graphics.path as path;
import std.graphics.image as image;
import std.gg as gg;

frame Canvas {
    pub var width: float;
    pub var height: float;

    pub init(w: float = 800.0, h: float = 600.0) {
        self.width = w;
        self.height = h;
    }

    pub fn draw_rect(r: rect.Rect, p: paint.Paint): nil {
        gg.draw_rect_primitive(r.x, r.y, r.w, r.h, p.color_val.r, p.color_val.g, p.color_val.b, p.color_val.a);
    }

    pub fn draw_color(c: color.Color): nil {
        gg.begin_pass(self.width as int, self.height as int, c.r, c.g, c.b, c.a);
    }

    pub fn draw_image(img: image.Image, x: float, y: float): nil {
        gg.draw(0, 6, 1);
    }

    pub fn draw_path(p: path.Path, paint_obj: paint.Paint): nil {
        var i: int = 0;
        var p_idx: int = 0;
        while (i < len(p.commands)) {
            var cmd: int = p.commands[i];
            if (cmd == 1 and p_idx >= 4) { // LineTo (draw segment using triangle primitive)
                var x1: float = p.points[p_idx - 2];
                var y1: float = p.points[p_idx - 1];
                var x2: float = p.points[p_idx];
                var y2: float = p.points[p_idx + 1];
                gg.draw_triangle_primitive(x1, y1, x2, y2, x2 + 2.0, y2 + 2.0, paint_obj.color_val.r, paint_obj.color_val.g, paint_obj.color_val.b, paint_obj.color_val.a);
            }
            if (cmd == 0 or cmd == 1) {
                p_idx = p_idx + 2;
            }
            i = i + 1;
        }
    }

    pub fn draw_text(text_str: str, x: float, y: float, p: paint.Paint): nil {
        gg.draw_rect_primitive(x, y, (len(text_str) * 8) as float, 16.0, p.color_val.r, p.color_val.g, p.color_val.b, p.color_val.a);
    }
}
