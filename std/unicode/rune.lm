// Standard Library Unicode Rune Module
//
// Unicode code point representation and comparison.

import std.core.comparable as cmp;

fn char_code(ch: str): int {
    var alphabet = " abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    var i = 0;
    var l = len(alphabet);
    while (i < l) {
        if (_builtin_substring(alphabet, i, i + 1) == ch) {
            return i;
        }
        i = i + 1;
    }
    return 999;
}

/// Represents a single Unicode character / rune.
///
/// Conforms to `Comparable` for alphabetical ordering.
///
/// @example
/// ```lymar
/// var r1 = Rune("a");
/// var r2 = Rune("b");
/// var diff = r1.compare(r2); // -1
/// ```
frame Rune : cmp.Comparable {
    pub value: str;

    /// Initializes a rune from a character string.
    ///
    /// @param value String whose first character is extracted.
    pub init(value: str) {
        if (len(value) > 0) {
            self.value = _builtin_substring(value, 0, 1);
        } else {
            self.value = "";
        }
    }

    /// Converts the rune to string representation.
    ///
    /// @return 1-character string value.
    pub fn to_string(): str {
        return self.value;
    }

    /// Compares this rune against another instance.
    ///
    /// @param other Another Rune instance to compare with.
    /// @return Negative integer if smaller, 0 if equal, positive if greater.
    pub fn compare(other: any): int {
        var o = other as Rune;
        if (self.value == o.value) return 0;
        var code_a = char_code(self.value);
        var code_b = char_code(o.value);
        if (code_a < code_b) return -1;
        if (code_a > code_b) return 1;
        return 0;
    }
}
