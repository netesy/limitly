// Standard Library Unicode Normalization Module

fn _char_to_lower(ch: str): str {
    if (ch == "A") { return "a"; }
    if (ch == "B") { return "b"; }
    if (ch == "C") { return "c"; }
    if (ch == "D") { return "d"; }
    if (ch == "E") { return "e"; }
    if (ch == "F") { return "f"; }
    if (ch == "G") { return "g"; }
    if (ch == "H") { return "h"; }
    if (ch == "I") { return "i"; }
    if (ch == "J") { return "j"; }
    if (ch == "K") { return "k"; }
    if (ch == "L") { return "l"; }
    if (ch == "M") { return "m"; }
    if (ch == "N") { return "n"; }
    if (ch == "O") { return "o"; }
    if (ch == "P") { return "p"; }
    if (ch == "Q") { return "q"; }
    if (ch == "R") { return "r"; }
    if (ch == "S") { return "s"; }
    if (ch == "T") { return "t"; }
    if (ch == "U") { return "u"; }
    if (ch == "V") { return "v"; }
    if (ch == "W") { return "w"; }
    if (ch == "X") { return "x"; }
    if (ch == "Y") { return "y"; }
    if (ch == "Z") { return "z"; }
    return ch;
}

fn _char_to_upper(ch: str): str {
    if (ch == "a") { return "A"; }
    if (ch == "b") { return "B"; }
    if (ch == "c") { return "C"; }
    if (ch == "d") { return "D"; }
    if (ch == "e") { return "E"; }
    if (ch == "f") { return "F"; }
    if (ch == "g") { return "G"; }
    if (ch == "h") { return "H"; }
    if (ch == "i") { return "I"; }
    if (ch == "j") { return "J"; }
    if (ch == "k") { return "K"; }
    if (ch == "l") { return "L"; }
    if (ch == "m") { return "M"; }
    if (ch == "n") { return "N"; }
    if (ch == "o") { return "O"; }
    if (ch == "p") { return "P"; }
    if (ch == "q") { return "Q"; }
    if (ch == "r") { return "R"; }
    if (ch == "s") { return "S"; }
    if (ch == "t") { return "T"; }
    if (ch == "u") { return "U"; }
    if (ch == "v") { return "V"; }
    if (ch == "w") { return "W"; }
    if (ch == "x") { return "X"; }
    if (ch == "y") { return "Y"; }
    if (ch == "z") { return "Z"; }
    return ch;
}

pub fn to_lower(value: str): str {
    var result = "";
    var i = 0;
    var vlen = len(value);
    while (i < vlen) {
        result = result + _char_to_lower(_builtin_substring(value, i, i + 1));
        i = i + 1;
    }
    return result;
}

pub fn to_upper(value: str): str {
    var result = "";
    var i = 0;
    var vlen = len(value);
    while (i < vlen) {
        result = result + _char_to_upper(_builtin_substring(value, i, i + 1));
        i = i + 1;
    }
    return result;
}
