import std.unicode.rune as rune;
import std.unicode.category as category;
import std.unicode.normalize as normalize;

pub import std.unicode.rune show Rune;

// Category function re-exports
pub fn is_upper(ch: str): bool {
    return category.is_upper(ch);
}

pub fn is_lower(ch: str): bool {
    return category.is_lower(ch);
}

pub fn is_digit(ch: str): bool {
    return category.is_digit(ch);
}

pub fn is_alpha(ch: str): bool {
    return category.is_alpha(ch);
}

pub fn is_alphanumeric(ch: str): bool {
    return category.is_alphanumeric(ch);
}

pub fn is_whitespace(ch: str): bool {
    return category.is_whitespace(ch);
}

// Normalize function re-exports
pub fn to_lower(value: str): str {
    return normalize.to_lower(value);
}

pub fn to_upper(value: str): str {
    return normalize.to_upper(value);
}
