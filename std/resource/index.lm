import std.internal.runtime as rt;

frame Resource {
    pub var handle: int;
    pub var kind: int;
    pub var is_open_val: bool;

    pub init(h: int, k: int) {
        self.handle = h;
        self.kind = k;
        self.is_open_val = (h != -1);
    }

    pub fn close(): nil? {
        if (self.is_open_val) {
            rt.destroy(self.handle);
            self.is_open_val = false;
        }
        return ok(nil);
    }

    pub fn is_open(): bool {
        return self.is_open_val;
    }

    pub fn _handle(): int {
        return self.handle;
    }
}

// Byte-buffer resource backed by the RT_MEMORY resource, exposing memory measurement.
frame Memory {
    pub var resource: Resource;

    pub init(r: Resource) {
        self.resource = r;
    }

    // Allocate or resize the buffer to `size` bytes. Returns true on success.
    pub fn resize(size: int): bool {
        var result = rt.call(self.resource.handle, rt.OP_OPEN, [size]);
        return (result == true);
    }

    // Memory measurement: number of bytes currently allocated for this buffer.
    pub fn size(): int {
        var result = rt.call(self.resource.handle, rt.OP_SIZE, []);
        if (result == nil) return 0;
        return result as int;
    }

    // Alias for size(): bytes held by the buffer.
    pub fn capacity(): int {
        return self.size();
    }

    // Copy bytes from `data` into the buffer (bounded by the current capacity).
    pub fn write(data: str): bool {
        var result = rt.call(self.resource.handle, rt.OP_WRITE, [data]);
        return (result == true);
    }

    // Read the buffer contents back as a string.
    pub fn read(): str {
        var result = rt.call(self.resource.handle, rt.OP_READ, []);
        if (result == nil) return "";
        return result as str;
    }

    pub fn is_open(): bool {
        return self.resource.is_open();
    }

    // Release the underlying buffer while keeping the handle valid.
    pub fn release(): bool {
        var result = rt.call(self.resource.handle, rt.OP_CLOSE, []);
        return (result == true);
    }

    pub fn close(): nil? {
        return self.resource.close();
    }
}

frame Reader {
    pub var resource: Resource;
    pub init(r: Resource) {
        self.resource = r;
    }
    pub fn read(args: [any]): any {
        return rt.call(self.resource.handle, rt.OP_READ, args);
    }
    // Binary read: returns [int] list of raw byte values (handles \0 bytes correctly).
    pub fn read_bytes(): [int] {
        var result = rt.call(self.resource.handle, rt.OP_READ_BYTES, []);
        if (result == nil) { return [] as [int]; }
        return result as [int];
    }
}


frame Writer {
    pub var resource: Resource;
    pub init(r: Resource) {
        self.resource = r;
    }
    pub fn write(args: [any]): any {
        return rt.call(self.resource.handle, rt.OP_WRITE, args);
    }
}




