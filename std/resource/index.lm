}

// Create a byte-buffer memory resource with memory measurement support.
// `size` is the initial number of bytes to allocate (0 for an empty buffer).
pub fn create_memory(size: int): Memory? {
    var h = rt.create(rt.RT_MEMORY, []);
    if (h == -1) return err();
    var mem = Memory(Resource(h=h, k=rt.RT_MEMORY));
    if (size > 0) {
        if (not mem.resize(size)) {
            rt.destroy(h);
            return err();
        }
    }
    return ok(mem);
}

pub fn create(type_id: int, args: [any]): Resource? {
    var h = rt.create(type_id, args);
    if (h == -1) return err();
    return ok(Resource(h=h, k=type_id));
}

pub fn adopt_socket(fd: int): Resource {
    return Resource(h=fd, k=rt.RT_SOCKET);
}

pub fn _call(h: int, op: int, args: [any]): any {
    return rt.call(h, op, args);
}

// Re-export essential constants
