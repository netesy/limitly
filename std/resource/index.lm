pub const OP_DELETE: int = rt.OP_DELETE;
pub const OP_READ_BYTES: int = rt.OP_READ_BYTES;
pub const OP_SIZE: int = rt.OP_SIZE;
pub const OP_GET_STATE: int = rt.OP_GET_STATE;

pub const KIND_OS: int = rt.RT_OS;
