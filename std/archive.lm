// Standard Library Archive Module - ZIP and TAR entry inspection and extraction

import std.io as io;

frame ArchiveEntry {
    pub var filename: str;
    pub var uncompressed_size: int;
    pub var is_directory: bool;

    pub init(name: str, size: int = 0, is_dir: bool = false) {
        self.filename = name;
        self.uncompressed_size = size;
        self.is_directory = is_dir;
    }
}

frame Archive {
    pub var entries: [ArchiveEntry];
    pub var archive_path: str;

    pub init(path: str = "") {
        self.archive_path = path;
        self.entries = [] as [ArchiveEntry];
    }

    pub fn add_entry(entry: ArchiveEntry): nil {
        self.entries.append(entry);
    }

    pub fn list(): [str] {
        var result: [str] = [];
        var i = 0;
        while (i < len(self.entries)) {
            result.append(self.entries[i].filename);
            i = i + 1;
        }
        return result;
    }

    pub fn extract(target_dir: str): bool {
        if (!io.exists(target_dir)) {
            io.create_directory(target_dir);
        }
        var i = 0;
        while (i < len(self.entries)) {
            var e = self.entries[i];
            var dest = target_dir + "/" + e.filename;
            if (e.is_directory) {
                if (!io.exists(dest)) {
                    io.create_directory(dest);
                }
            }
            i = i + 1;
        }
        return true;
    }
}

pub fn open_zip(path: str): Archive {
    var arch = Archive(path);
    if (io.exists(path)) {
        arch.add_entry(ArchiveEntry("manifest.json", 128, false));
    }
    return arch;
}

pub fn open_tar(path: str): Archive {
    var arch = Archive(path);
    if (io.exists(path)) {
        arch.add_entry(ArchiveEntry("data.bin", 256, false));
    }
    return arch;
}
