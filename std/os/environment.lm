// std/os/environment.lm
// Process environment variables, backed by the RT_OS resource.

import std.os.service as service;
import std.internal.runtime as rt;

/// Looks up an environment variable by name.
///
/// @pre len(key) > 0
/// @param key Variable name.
/// @return Fallible string value, or nil/error when absent.
pub fn getenv(key: str): str? {
    contract(len(key) > 0, "Environment key must not be empty");
    var result = service.request_with(rt.OP_ENV_GET, [key]);
    if (result == nil) {
        var missing: str? = nil;
        return missing;
    }
    return ok(result as str);
}

/// Looks up an environment variable with a fallback default value.
///
/// @pre len(key) > 0
/// @param key Variable name.
/// @param fallback Default string value if absent.
/// @return Variable value or fallback string.
pub fn getenv_or(key: str, fallback: str): str {
    contract(len(key) > 0, "Environment key must not be empty");
    var result = service.request_with(rt.OP_ENV_GET, [key]);
    if (result == nil) return fallback;
    return result as str;
}

/// Sets or updates an environment variable for the current process.
///
/// @pre len(key) > 0
/// @param key Variable name.
/// @param value Target string value.
/// @return True if operation succeeded, false otherwise.
pub fn setenv(key: str, value: str): bool {
    contract(len(key) > 0, "Environment key must not be empty");
    var result = service.request_with(rt.OP_ENV_SET, [key, value]);
    if (result as bool) return true;
    return false;
}

/// Removes an environment variable from the current process.
///
/// @pre len(key) > 0
/// @param key Variable name to delete.
/// @return True if operation succeeded, false otherwise.
pub fn unsetenv(key: str): bool {
    contract(len(key) > 0, "Environment key must not be empty");
    var result = service.request_with(rt.OP_ENV_UNSET, [key]);
    if (result as bool) return true;
    return false;
}

/// Retrieves all current environment variables as a list of "NAME=VALUE" pairs.
///
/// @return List of formatted environment key-value pairs.
pub fn env_vars(): [str] {
    var result = service.request(rt.OP_ENV_LIST);
    if (result == nil) { return [] as [str]; }
    return result as [str];
}
