// std/os/identity.lm
// Platform, architecture and machine identity, backed by the RT_OS resource.

import std.os.service as service;
import std.internal.runtime as rt;

/// Returns the operating system identifier string ("windows", "linux", "darwin", "android", "freebsd", "wasi", "unknown").
///
/// @return OS name string.
pub fn os_name(): str {
    var result = service.request(rt.OP_OS_NAME);
    if (result == nil) return "unknown";
    return result as str;
}

/// Returns the host processor architecture ("x86_64", "aarch64", "riscv64", "i686", "arm", "wasm32", "unknown").
///
/// @return CPU architecture string.
pub fn arch(): str {
    var result = service.request(rt.OP_ARCH);
    if (result == nil) return "unknown";
    return result as str;
}

/// Returns the network hostname of the local machine.
///
/// @return System hostname string.
pub fn hostname(): str {
    var result = service.request(rt.OP_HOSTNAME);
    if (result == nil) return "";
    return result as str;
}

/// Returns the count of logical CPU cores available to the process.
///
/// @return Number of logical processor cores (at least 1).
pub fn num_cpu(): int {
    var result = service.request(rt.OP_NUM_CPU);
    if (result == nil) return 1;
    return result as int;
}

/// Checks whether the host operating system is Windows.
///
/// @return True on Microsoft Windows.
pub fn is_windows(): bool {
    return os_name() == "windows";
}

/// Checks whether the host operating system is Linux.
///
/// @return True on Linux.
pub fn is_linux(): bool {
    return os_name() == "linux";
}

/// Checks whether the host operating system is macOS / Apple Darwin.
///
/// @return True on macOS.
pub fn is_macos(): bool {
    return os_name() == "darwin";
}

/// Checks whether the target environment is WebAssembly (WASI or wasm32).
///
/// @return True on WebAssembly targets.
pub fn is_wasm(): bool {
    var name = os_name();
    var machine = arch();
    return name == "wasi" or machine == "wasm32";
}

/// Checks whether the target processor architecture is 64-bit.
///
/// @return True on 64-bit architectures (x86_64, aarch64, riscv64).
pub fn is_64bit(): bool {
    var machine = arch();
    return machine == "x86_64" or machine == "aarch64" or machine == "riscv64";
}

/// Alias for `os_name()`.
///
/// @return OS platform identifier.
pub fn platform(): str {
    return os_name();
}

/// Returns the native filesystem path segment separator ("\\" on Windows, "/" on POSIX).
///
/// @return Path separator character.
pub fn path_separator(): str {
    if (is_windows()) return "\\";
    return "/";
}

/// Returns the search-path list delimiter (";" on Windows, ":" on POSIX).
///
/// @return Search path list separator character.
pub fn path_list_separator(): str {
    if (is_windows()) return ";";
    return ":";
}
