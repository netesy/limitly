// std/uuid/generator.lm
// RFC 4122 Version 4 (Random) UUID generator.

import std.uuid.uuid as uuid;
import std.random.random as random;

/// Generates a cryptographically random RFC 4122 Version 4 UUID.
///
/// @tip Sets version 4 (bits 4-7 of byte 6 = 0100) and RFC 4122 variant (bits 6-7 of byte 8 = 10).
///
/// @return Newly generated, random UUID instance.
///
/// @example
/// import std.uuid as uuid;
/// var id = uuid.generate_v4();
/// print("UUID: {id.to_string()}");
pub fn generate_v4(): uuid.UUID {
    var b = random.random_bytes(16);
    // Version 4: set top 4 bits of byte 6 to 0100
    b[6] = (b[6] & 0x0F) | 0x40;
    // Variant 1 (RFC 4122): set top 2 bits of byte 8 to 10
    b[8] = (b[8] & 0x3F) | 0x80;
    return uuid.UUID(b, true);
}
