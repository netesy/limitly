import std.uuid.uuid as uuid;
import std.random.random as random;

pub fn generate_v4(): uuid.UUID {
    var b = random.random_bytes(16);
    // Version 4: set top 4 bits of byte 6 to 0100
    b[6] = (b[6] & 0x0F) | 0x40;
    // Variant 1 (RFC 4122): set top 2 bits of byte 8 to 10
    b[8] = (b[8] & 0x3F) | 0x80;
    return uuid.UUID(b, true);
}
