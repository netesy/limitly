// std/uuid/uuid.lm
// RFC 4122 Universally Unique Identifier (UUID) representation and parsing.

/// Represents a 128-bit RFC 4122 Universally Unique Identifier (UUID).
///
/// @tip Use `uuid.generate_v4()` to create random UUIDs or `uuid.parse(str)` to parse from strings.
/// @note Instances represent 16 raw bytes along with a validation status flag.
///
/// @param bytes 16-element byte array or empty if invalid.
/// @param is_valid Boolean indicating whether the UUID represents a parsed/valid identifier.
///
/// @example
/// import std.uuid as uuid;
/// var id = uuid.generate_v4();
/// print("Generated: {id.to_string()} (v{id.version()})");
frame UUID {
    pub bytes: [int];
    pub is_valid: bool;

    pub init(bytes: [int], is_valid: bool) {
        contract(len(bytes) == 16 or not is_valid, "Valid UUID must contain exactly 16 bytes");
        self.bytes = bytes;
        self.is_valid = is_valid;
    }

    /// Formats the UUID into its standard canonical 8-4-4-4-12 lowercase string.
    ///
    /// @return Canonical 36-character hyphenated UUID string, or empty string if invalid.
    ///
    /// @example
    /// var s = id.to_string(); // "f81d4fae-7dec-11d0-a765-00a0c91e6bf6"
    pub fn to_string(): str {
        if (not self.is_valid or len(self.bytes) != 16) {
            return "";
        }
        var res = "";
        res = res + byte_to_hex(self.bytes[0]);
        res = res + byte_to_hex(self.bytes[1]);
        res = res + byte_to_hex(self.bytes[2]);
        res = res + byte_to_hex(self.bytes[3]);
        res = res + "-";
        res = res + byte_to_hex(self.bytes[4]);
        res = res + byte_to_hex(self.bytes[5]);
        res = res + "-";
        res = res + byte_to_hex(self.bytes[6]);
        res = res + byte_to_hex(self.bytes[7]);
        res = res + "-";
        res = res + byte_to_hex(self.bytes[8]);
        res = res + byte_to_hex(self.bytes[9]);
        res = res + "-";
        res = res + byte_to_hex(self.bytes[10]);
        res = res + byte_to_hex(self.bytes[11]);
        res = res + byte_to_hex(self.bytes[12]);
        res = res + byte_to_hex(self.bytes[13]);
        res = res + byte_to_hex(self.bytes[14]);
        res = res + byte_to_hex(self.bytes[15]);
        return res;
    }

    /// Extracts the UUID specification version number (bits 4-7 of octet 6).
    ///
    /// @return Version number (e.g. 4 for pseudo-random UUIDs, 1 for time-based, 0 if invalid).
    pub fn version(): int {
        if (not self.is_valid or len(self.bytes) != 16) {
            return 0;
        }
        return (self.bytes[6] >> 4) & 0x0F;
    }

    /// Extracts the RFC 4122 variant code.
    ///
    /// @return 1 for RFC 4122 (Leach-Salz), 0 for NCS backwards compatibility, 2 for Microsoft GUID.
    pub fn variant(): int {
        if (not self.is_valid or len(self.bytes) != 16) {
            return 0;
        }
        var b8 = self.bytes[8];
        if ((b8 & 0x80) == 0x00) {
            return 0;
        }
        if ((b8 & 0xC0) == 0x80) {
            return 1;
        }
        if ((b8 & 0xE0) == 0xC0) {
            return 2;
        }
        return 3;
    }

    /// Compares two UUID instances for 128-bit equality.
    ///
    /// @param other The target UUID to compare against.
    /// @return True if both UUIDs are valid and all 16 bytes match identically.
    pub fn equals(other: UUID): bool {
        if (not self.is_valid or not other.is_valid) {
            return false;
        }
        if (len(self.bytes) != 16 or len(other.bytes) != 16) {
            return false;
        }
        var i = 0;
        while (i < 16) {
            if (self.bytes[i] != other.bytes[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
}

/// Parses a 36-character hyphenated UUID string (or 38-character braced format) into a UUID.
///
/// @tip Tolerates uppercase and lowercase hexadecimal digits, surrounding whitespace, and `{...}` braces.
///
/// @param uuid_str The UUID string to parse.
/// @return Parsed UUID object; check `result.is_valid` for success.
///
/// @example
/// var id = uuid.parse("f81d4fae-7dec-11d0-a765-00a0c91e6bf6");
/// if (id.is_valid) {
    ///     print("Version: {id.version()}");
    /// }
    pub fn parse(uuid_str: str): UUID {
        var s = to_lower(trim(uuid_str));
        if (len(s) == 38 and _builtin_substring(s, 0, 1) == "{" and _builtin_substring(s, 37, 38) == "}") {
            s = _builtin_substring(s, 1, 37);
        }

        if (len(s) != 36) {
            return UUID([] as [int], false);
        }

        if (_builtin_substring(s, 8, 9) != "-" or _builtin_substring(s, 13, 14) != "-" or _builtin_substring(s, 18, 19) != "-" or _builtin_substring(s, 23, 24) != "-") {
            return UUID([] as [int], false);
        }

        var b = [] as [int];
        var hex_chars = "0123456789abcdef";
        var i = 0;
        while (i < 36) {
            if (i == 8 or i == 13 or i == 18 or i == 23) {
                i = i + 1;
            } else {
                var h1 = _builtin_substring(s, i, i + 1);
                var h2 = _builtin_substring(s, i + 1, i + 2);
                var idx1 = index_of(hex_chars, h1);
                var idx2 = index_of(hex_chars, h2);
                if (idx1 == -1 or idx2 == -1) {
                    return UUID([] as [int], false);
                }
                b.append((idx1 << 4) | idx2);
                i = i + 2;
            }
        }

        return UUID(b, true);
    }

    // ---- Internal helpers ----

    fn byte_to_hex(b: int): str {
        var hex_chars = "0123456789abcdef";
        var high = (b >> 4) & 0xF;
        var low = b & 0xF;
        return _builtin_substring(hex_chars, high, high + 1) + _builtin_substring(hex_chars, low, low + 1);
    }

    fn trim(s: str): str {
        var start = 0;
        while (start < len(s) and (_builtin_substring(s, start, start + 1) == " " or _builtin_substring(s, start, start + 1) == "\t" or _builtin_substring(s, start, start + 1) == "\n" or _builtin_substring(s, start, start + 1) == "\r")) {
            start = start + 1;
        }
        var end = len(s) - 1;
        while (end >= start and (_builtin_substring(s, end, end + 1) == " " or _builtin_substring(s, end, end + 1) == "\t" or _builtin_substring(s, end, end + 1) == "\n" or _builtin_substring(s, end, end + 1) == "\r")) {
            end = end - 1;
        }
        if (start > end) {
            return "";
        }
        return _builtin_substring(s, start, end + 1);
    }

    fn to_lower(s: str): str {
        var result: str = "";
        var i: int = 0;
        var alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        var lower_alphabet = "abcdefghijklmnopqrstuvwxyz";
        while (i < len(s)) {
            var ch: str = _builtin_substring(s, i, i + 1);
            var idx = index_of(alphabet, ch);
            if (idx != -1) {
                result = result + _builtin_substring(lower_alphabet, idx, idx + 1);
            } else {
                result = result + ch;
            }
            i = i + 1;
        }
        return result;
    }

    fn index_of(s: str, pattern: str): int {
        var i: int = 0;
        while (i <= len(s) - len(pattern)) {
            if (_builtin_substring(s, i, i + len(pattern)) == pattern) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
