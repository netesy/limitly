// Standard Library Result Module (using staged type functions)

frame ResultInstance {
    pub success: bool;
    pub value: any;
    pub error: any;

    pub init(success: bool, value: any, error: any) {
        self.success = success;
        self.value = value;
        self.error = error;
    }

    pub fn is_ok(): bool {
        return self.success;
    }

    pub fn is_err(): bool {
        return not self.success;
    }

    pub fn unwrap(): any {
        return self.value;
    }

    pub fn unwrap_or(default_value: any): any {
        if (self.success) {
            return self.value;
        }
        return default_value;
    }

    pub fn unwrap_err(): any {
        return self.error;
    }

    pub fn map(f: fn(any): any): ResultInstance {
        if (self.success) {
            return Ok(f(self.value));
        }
        return self;
    }
}

staged fn Result(T: type, E: type): type {
    return ResultInstance;
}

pub fn Ok(value: any): ResultInstance {
    return ResultInstance(true, value, nil);
}

pub fn Err(error: any): ResultInstance {
    return ResultInstance(false, nil, error);
}
