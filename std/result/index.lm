frame Result {
    var success: bool;
    var value: any;
    var error: any;

    pub init(success: bool, value: any, error: any) {
        self.success = success;
        self.value = value;
        self.error = error;
    }

    pub fn is_ok(): bool {
        return self.success;
    }

    pub fn is_err(): bool {
        return not self.success;
    }

    pub fn unwrap(): any {
        return self.value;
    }

    pub fn unwrap_or(default_value: any): any {
        if (self.success) {
            return self.value;
        }
        return default_value;
    }

    pub fn unwrap_err(): any {
        return self.error;
    }

    pub fn map(f: fn(any): any): Result {
        if (self.success) {
            return Ok(f(self.value));
        }
        return self;
    }
}

pub fn Ok(value: any): Result {
    return Result(true, value, nil);
}

pub fn Err(error: any): Result {
    return Result(false, nil, error);
}
