import std.sort as sort;

fn reverse_cmp(a: any, b: any): int {
    if (a > b) { return -1; }
    if (a < b) { return 1; }
    return 0;
}

fn main(): int {
    var values: [any] = [3, 1, 2, 2];
    sort.stable_sort(values);
    if (values[0] != 1) { return 1; }
    sort.quicksort(values, false, reverse_cmp);
    if (values[0] != 3) { return 2; }
    var ints: [int] = [9, 0, 3, 3];
    sort.counting_sort(ints);
    if (ints[0] != 0) { return 3; }
    sort.radix_sort(ints, true);
    if (ints[0] != 9) { return 4; }
    return 0;
}
