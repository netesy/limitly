import std.string as string;

fn main() {
    var text = "  Hello, Lymar World!  ";
    var trimmed = string.trim(text);
    var replaced = string.replace(trimmed, "World", "Language");

    print("Checking contains...");
    assert(string.contains(replaced, "Language"), "Contains failure");
    print("Checking starts_with...");
    assert(string.starts_with(replaced, "Hello"), "Starts with failure");
    print("Checking ends_with...");
    assert(string.ends_with(replaced, "Language!"), "Ends with failure");

    print("Checking to_lower...");
    var lower = string.to_lower("LYMAR");
    assert(lower == "lymar", "Lower failure");

    print("Checking to_upper...");
    var upper = string.to_upper("lymar");
    assert(upper == "LYMAR", "Upper failure");

    print("ALL PASSED");
}
