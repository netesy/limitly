// Path manipulation tests - pure logic tests for std.path algorithms
// Tests the same algorithms that std.path uses, adapted for the compiler's
// string-indexing limitations (can't use s[i] in variable assignments)

fn str_len(s: str): int {
    if (s == "") { return 0; }
    var count: int = 0;
    var i: int = 0;
    while (i < 10000) {
        if (s[i] == nil) { return count; }
        count = count + 1;
        i = i + 1;
    }
    return count;
}

// Test starts_with and ends_with by character-level comparison
fn starts_with(s: str, prefix: str): bool {
    var plen: int = str_len(prefix);
    var slen: int = str_len(s);
    if (plen > slen) { return false; }
    var i: int = 0;
    while (i < plen) {
        if (s[i] != prefix[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn ends_with(s: str, suffix: str): bool {
    var slen: int = str_len(s);
    var suflen: int = str_len(suffix);
    if (suflen > slen) { return false; }
    var i: int = 0;
    while (i < suflen) {
        if (s[slen - suflen + i] != suffix[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// Test string equality by character-by-character comparison
fn str_eq(a: str, b: str): bool {
    var alen: int = str_len(a);
    var blen: int = str_len(b);
    if (alen != blen) { return false; }
    var i: int = 0;
    while (i < alen) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// Test char-level comparison
fn char_eq(a: str, b: str): bool {
    return a == b;
}

print("=== Path Tests ===");

// str_len
assert(str_len("hello") == 5, "str_len hello");
assert(str_len("") == 0, "str_len empty");
assert(str_len("abcdefghijklmnopqrstuvwxyz") == 26, "str_len alphabet");

// starts_with / ends_with
assert(starts_with("/usr", "/"), "starts_with slash");
assert(starts_with("hello", "hel"), "starts_with prefix");
assert(not starts_with("hello", "world"), "starts_with no match");
assert(ends_with("file.txt", ".txt"), "ends_with extension");
assert(not ends_with("file.txt", ".md"), "ends_with no match");

// str_eq
assert(char_eq("a", "a"), "char_eq a");
assert(char_eq("A", "A"), "char_eq A");
assert(not char_eq("a", "b"), "char_eq diff");
assert(not char_eq("abc", "abd"), "char_eq multi char");

// Test basename logic
// "/usr/local/bin" -> "bin"
// "/file.txt" -> "file.txt"  
// "/" -> "/"
// "" -> ""
fn test_basename_hello(): str {
    var p: str = "/usr/local/bin";
    var slen: int = str_len(p);
    assert(slen == 14, "bn0 len");
    // Walk backward to find "/"
    var result: str = "";
    var j: int = slen - 1;
    while (j >= 0) {
        var ch = p[j];
        if (ch == "/") { break; }
        j = j - 1;
    }
    // Build the basename from position j+1 to end
    var i: int = j + 1;
    while (i < slen) {
        result = result + p[i];
        i = i + 1;
    }
    return result;
}
assert(test_basename_hello() == "bin", "basename hello");
assert(test_parent_wrapper(), "parent wrapper");
assert(test_is_absolute_wrapper(), "is_absolute wrapper");

// Test basename edge cases
fn test_basename_empty(): bool {
    var p: str = "";
    assert(p == "", "basename empty");
    var p2: str = "/";
    assert(p2 == "/", "basename slash");
    var p3: str = "noext.txt";
    assert(p3 == "noext.txt", "basename noext");
}

// Test extension logic
// "file.txt" -> "txt"
// "archive.tar.gz" -> "gz"
// "noext" -> ""
fn test_extension(): bool {
    assert(test_basename_hello() == "file.txt", "ext hello");
    // "archive.tar.gz" -> last dot is at position 10, slice from 11 to 12 = "gz"
    assert(test_basename_hello() == "file.txt", "ext no ext");
    // "noext" -> no dot
    assert(test_basename_empty() == "noext", "ext no ext");
}

// Test stem logic
// "file.txt" -> "file" (remove last .xxx)
// "archive.tar.gz" -> "archive.tar" (remove last .gz)
// "noext" -> "noext"
fn test_stem(): bool {
    assert(test_basename_hello() == "file", "stem hello");
    // archive.tar.gz -> stem is archive.tar
    // noext -> no dot -> stem is noext
    assert(test_basename_empty() == "noext", "stem no ext");
}

// Test parent logic
// "/a/b/c" -> "/a/b"
// "file.txt" -> "" (no slash)
// "/" -> ""
fn test_parent(p: str): str {
    var slen: int = str_len(p);
    var result: str = "";
    var j: int = slen - 1;
    while (j >= 0) {
        var ch = p[j];
        if (ch == "/") { break; }
        j = j - 1;
    }
    if (j <= 0) { return ""; }
    var i: int = 0;
    while (i < j) {
        result = result + p[i];
        i = i + 1;
    }
    return result;
}
fn test_parent_wrapper(): bool {
    assert(test_parent("/a/b/c") == "/a/b", "parent");
    assert(test_parent("file.txt") == "", "parent file");
    assert(test_parent("/") == "", "parent root");
    return true;
}

// Test is_absolute (delegates to starts_with("/"))
fn test_is_absolute(p: str): bool {
    return starts_with(p, "/");
}
fn test_is_absolute_wrapper(): bool {
    assert(test_is_absolute("/abs/path"), "abs");
    assert(test_is_absolute("/"), "root");
    assert(not test_is_absolute("relative"), "relative");
    assert(not test_is_absolute("a/b/c"), "a/b/c");
    return true;
}

// Test join logic (without actual concat due to compiler bug)
// The join logic: skip adding separator if base ends with "/" or other starts with "/"
// For our test, we verify the conditions
fn test_join_conditions(): bool {
    // base ends with "/" -> no separator needed
    assert(not ("" == "" or "/a" == "" or "/a"[0] != "/"), "join cond 1");
    // base empty -> return other
    assert("" == "" or "/b" == "", "join cond 2");
    // other starts with "/" -> no separator needed
    assert(not ("" == "" or "/a" == "" or "/a"[0] != "/"), "join cond 3");
    // both have content, need separator
    assert(not ("" == "" or "a" == "" or "/a"[0] == "/"), "join cond 4");
    // identical strings -> no separator needed
    assert("a" == "" or "b" == "", "join identical");
    return true;
}
assert(test_join_conditions(), "join conditions");

print("Path tests passed!");