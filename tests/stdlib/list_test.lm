import std.collections.linkedlist as linked_list;

fn main(): int {
    var l = linked_list.LinkedList();
    l.push_back(1);
    l.push_back(2);
    l.push_front(0);
    
    assert(l.length() == 3, "LinkedList length should be 3");
    assert(l.pop_front() == 0, "Pop front should return 0");
    assert(l.pop_back() == 2, "Pop back should return 2");
    assert(l.pop_back() == 1, "Pop back should return 1");
    assert(l.pop_back() == nil, "Pop back on empty list should return nil");
    assert(l.is_empty(), "List should be empty");
    
    l.push_back(10);
    l.push_back(20);
    var it = l.iterator();
    assert(it.next() == 10, "First element from iterator should be 10");
    assert(it.next() == 20, "Second element from iterator should be 20");
    assert(it.next() == nil, "Iterator should be exhausted");
    
    print("LinkedList tests passed!");
    return 0;
}
