import std.cli as cli;

fn main(): int {
    var parser = cli.ArgParser("limapp");
    parser.parse(["limapp", "-v", "--flag", "file.txt", "out.bin"]);

    assert(parser.has_flag("-v"), "has_flag -v failed");
    assert(parser.has_flag("--flag"), "has_flag --flag failed");
    assert(not parser.has_flag("-x"), "has_flag -x should be false");

    var args = parser.get_args();
    assert(len(args) == 2, "positional args count should be 2");
    assert(args[0] == "file.txt", "arg 0 should match");
    assert(args[1] == "out.bin", "arg 1 should match");

    print("CLI test passed!");
    return 0;
}

