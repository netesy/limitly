import std.string as string;
import std.core as core;

fn twice(x: any): any { return x * 2; }
fn positive(x: any): bool { return x > 0; }

fn main(): int {
    if (string.length("abc") != 3) { return 1; }
    if (not string.starts_with("abc", "a")) { return 2; }
    if (string.uppercase("a") != "A") { return 3; }
    var some = core.Some(2).map(twice).filter(positive);
    if (some.unwrap() != 4) { return 4; }
    var none = core.None();
    if (none.unwrap_or(9) != 9) { return 5; }
    var res_ok = core.Ok(3).map(twice);
    if (res_ok.unwrap() != 6) { return 6; }
    var res_err = core.Err(core.Error(code="E1", message="bad"));
    if (not res_err.is_err()) { return 7; }
    return 0;
}
