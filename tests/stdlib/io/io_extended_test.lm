// Extended integration and resource lifecycle validation test.
// Automatically run by tests/run_tests.sh.

import std.io as io;
import std.io.file as file_mod;
import std.crypto.random as crypto_random;

fn main(): int {
    print("=== Extended Stdlib Integration Test ===");

    // ---- Step 1: Secure Random Generation ----
    var rand_hex_res = crypto_random.CryptoRandom.bytes_hex(16);
    var rand_hex = "";
    match (rand_hex_res) {
        val s => {
            rand_hex = s;
            assert(len(s) == 32, "16 random bytes should be 32 hex chars");
            print("Successfully generated secure random hex: {s}");
        },
        err e => assert(false, "CryptoRandom.bytes_hex failed")
    }

    // ---- Step 2: Path Manipulation ----
    var file_path = "std_test_temp_config.txt";

    // ---- Step 3: File IO ----
    // Write file
    var content = "SecureRandomSeed=" + rand_hex;
    var f_write_res = io.open(file_path, "w");
    match (f_write_res) {
        val f => {
            var f_obj = f as file_mod.File;
            assert(f_obj.is_open(), "File should be open after creation");
            f_obj.write(content);
            f_obj.close();
            assert(!f_obj.is_open(), "File should be closed after manual close");
            print("Successfully wrote random seed to temp file");
        },
        err e => assert(false, "Failed to open file for writing")
    }

    // Read and verify file
    var f_read_res = io.open(file_path, "r");
    match (f_read_res) {
        val f => {
            var f_obj = f as file_mod.File;
            var read_content_res = f_obj.read();
            match (read_content_res) {
                val read_content => {
                    assert(read_content == content, "Read content mismatch");
                    print("Successfully read and verified file content: {read_content}");
                },
                err e => assert(false, "Failed to read file content")
            }
            f_obj.close();
        },
        err e => assert(false, "Failed to open file for reading")
    }

    // ---- Step 6: Resource Double-Close & Safety Validation ----
    var double_close_f = io.open(file_path, "r");
    match (double_close_f) {
        val f => {
            var f_obj = f as file_mod.File;
            assert(f_obj.is_open(), "is_open true on creation");
            f_obj.close();
            assert(!f_obj.is_open(), "is_open false after close");
            // Double close should be perfectly safe and return ok
            f_obj.close();
            print("Double close safety verified");
        },
        err e => assert(false, "Failed to open file for double-close validation")
    }

    // ---- Cleanup ----
    io.delete(file_path);
    assert(!io.exists(file_path), "Cleanup validation: file should be deleted");

    print("=== Extended Stdlib Integration Test Passed successfully! ===");
    return 0;
}
