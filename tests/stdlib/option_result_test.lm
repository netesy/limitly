// Std core Option (staged frame template) + native fallibles.
// The library Result frame is gone: fallible paths use the language's own
// error types (T? / T?Error, ok/err, `?`, `? else`, match). Migration map:
// std/core/index.lm.

import std.core show Error, Option;

fn checked_divide(a: int, b: int): int?Error {
    if (b == 0) {
        return err(Error(code="DivByZero", message="divisor is zero"));
    }
    return ok(a / b);
}

fn main(): int {
    // A staged template mints one real frame per type argument; construction
    // goes through the instantiation written in the type position.
    var some: Option(int) = Option(true, 42);
    var none: Option(int) = Option(false, nil);

    assert(some.is_some(), "Option some is_some fail");
    assert(none.is_none(), "Option none is_none fail");
    assert(some.unwrap() == 42, "Option some unwrap fail");
    assert(none.unwrap_or(10) == 10, "Option none unwrap_or fail");

    var mapped = some.map(fn(x: int): int { return x + 1; });
    assert(mapped.unwrap() == 43, "Option map fail");

    var filtered_none = none.filter(fn(x: int): bool { return x > 0; });
    assert(filtered_none.is_none(), "Option filter on none fail");

    // Native fallible success through `? else`.
    var quotient = checked_divide(84, 2)? else {
        return 1;
    };
    assert(quotient == 42, "native fallible ok path fail");

    // Native fallible failure; the declared code reaches the match arm.
    match (checked_divide(1, 0)) {
        val v => { assert(false, "native fallible should have failed"); },
        err e => { assert("{e}" == "DivByZero", "declared error code fail"); }
    }

    print("Option/native-fallible tests passed!");
    return 0;
}
