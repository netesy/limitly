// Test std.csv parsing and stringifying
import std.csv as csv;

fn test_csv_basic() {
    print("Testing CSV parse and stringify...");
    var input_text = "id,name,role\n1,Alice,Admin\n2,Bob,Engineer";
    var rows = csv.parse(input_text);
    assert(len(rows) == 3, "Rows count should be 3");
    assert(rows[0][0] == "id", "Header col 0");
    assert(rows[0][1] == "name", "Header col 1");
    assert(rows[0][2] == "role", "Header col 2");

    assert(rows[1][1] == "Alice", "Alice row col 1");
    assert(rows[2][2] == "Engineer", "Engineer row col 2");

    var serialized = csv.stringify(rows);
    var rows2 = csv.parse(serialized);
    assert(len(rows2) == 3, "Round-trip row count");
    assert(rows2[1][1] == "Alice", "Round-trip Alice");
}

print("=== Running CSV Test Suite ===");
test_csv_basic();
print("=== All CSV Tests Passed ===");

