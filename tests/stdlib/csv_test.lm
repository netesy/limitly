// Test suite for Standard Library CSV Module

import std.csv.index as csv;

fn main(): int {
    print("=== CSV Module Test Suite ===");

    var csv_str = "Name,Age,Active\nJohn,30,true\nJane,25,false\n";
    var rows = csv.parse(csv_str);

    assert(len(rows) == 3, "rows count failed");
    assert(len(rows[0]) == 3, "cols 0 count failed");
    assert(rows[0][0] == "Name", "row 0 col 0 failed");
    assert(rows[1][0] == "John", "row 1 col 0 failed");
    assert(rows[2][1] == "25", "row 2 col 1 failed");

    var serialized = csv.stringify(rows);
    assert(serialized == csv_str, "stringify failed: " + serialized);

    print("All CSV tests passed successfully!");
    return 0;
}
