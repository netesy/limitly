// Test Suite for Standard Library Time Module

import std.time.duration as dur;
import std.time.timezone as tz;
import std.time.datetime as dt;
import std.time.instant as inst_mod;
import std.time.timer as timer_mod;

fn test_duration(): int {
    print("Testing Duration...");
    var dur1 = dur.TimeDuration(10, 0) as dur.TimeDuration;
    var dur2 = dur.TimeDuration(20, 0) as dur.TimeDuration;
    var dur3 = dur1.add(dur2) as dur.TimeDuration;
    assert(dur3.seconds == 30, "duration add failed");

    var duration4 = dur.TimeDuration.from_seconds(5) as dur.TimeDuration;
    assert(duration4.seconds == 5, "from_seconds failed");
    return 1;
}

fn test_timezone(): int {
    print("Testing TimeZone...");
    var tz_obj = tz.TimeZone("UTC", 0, 0) as tz.TimeZone;
    assert(tz_obj.name == "UTC", "timezone name failed");
    assert(tz_obj.offset_string() == "+00:00", "timezone offset failed");
    return 1;
}

fn test_time(): int {
    print("Testing Time...");
    var t1 = dt.DateTime(1000000, 0, tz.TimeZone("UTC", 0, 0)) as dt.DateTime;
    assert(t1.timestamp == 1000000, "timestamp failed");

    // Components (1000000 is 1970-01-12 13:46:40)
    assert(t1.year() == 1970, "year failed");
    assert(t1.month() == 1, "month failed");
    assert(t1.day() == 12, "day failed");
    return 1;
}

fn test_instant_and_timer(): int {
    print("Testing Instant and Timer...");
    var inst = inst_mod.Instant(0.0) as inst_mod.Instant; // Construct via inst_mod.Instant(0.0)
    var elapsed = inst.elapsed() as dur.TimeDuration;
    assert(elapsed.seconds >= 0, "instant elapsed failed");

    var timer = timer_mod.Timer() as timer_mod.Timer;
    timer.reset();
    var timer_elapsed = timer.elapsed() as dur.TimeDuration;
    assert(timer_elapsed.seconds >= 0, "timer elapsed failed");
    return 1;
}

fn main(): int {
    print("=== Time Module Test Suite ===");

    assert(test_duration() == 1, "Duration test failed");
    assert(test_timezone() == 1, "TimeZone test failed");
    assert(test_time() == 1, "Time test failed");
    assert(test_instant_and_timer() == 1, "Instant and Timer test failed");

    print("All time tests passed successfully.");
    return 0;
}
