// Test Suite for Standard Library Time Module

import std.time.index as t;

fn test_duration(): int {
    print("Testing Duration...");
    var d1 = t.Duration(10, 0) as t.Duration;
    var dt2 = t.Duration(20, 0) as t.Duration;
    var d3 = d1.add(d2) as t.Duration;
    assert(d3.seconds == 30, "duration add failed");

    var duration4 = t.Duration.from_seconds(5) as t.Duration;
    assert(duration4.seconds == 5, "from_seconds failed");
    return 1;
}

fn test_timezone(): int {
    print("Testing TimeZone...");
    var tz = t.TimeZone("UTC", 0, 0) as t.TimeZone;
    assert(tz.name == "UTC", "timezone name failed");
    assert(tz.offset_string() == "+00:00", "timezone offset failed");
    return 1;
}

fn test_time(): int {
    print("Testing Time...");
    var t1 = t.Time(1000000, 0, t.TimeZone.utc()) as t.Time;
    assert(t1.timestamp == 1000000, "timestamp failed");

    // Components (1000000 is 1970-01-12 13:46:40)
    assert(t1.year() == 1970, "year failed");
    assert(t1.month() == 1, "month failed");
    assert(t1.day() == 12, "day failed");
    return 1;
}

fn test_instant_and_timer(): int {
    print("Testing Instant and Timer...");
    var inst = t.Instant.now() as t.Instant;
    var elapsed = inst.elapsed() as t.Duration;
    assert(elapsed.seconds >= 0, "instant elapsed failed");

    var timer = t.Timer() as t.Timer;
    timer.reset();
    var timer_elapsed = timer.elapsed() as t.Duration;
    assert(timer_elapsed.seconds >= 0, "timer elapsed failed");
    return 1;
}

fn main(): int {
    print("=== Time Module Test Suite ===");

    assert(test_duration() == 1, "Duration test failed");
    assert(test_timezone() == 1, "TimeZone test failed");
    assert(test_time() == 1, "Time test failed");
    assert(test_instant_and_timer() == 1, "Instant and Timer test failed");

    print("All time tests passed successfully.");
    return 0;
}
