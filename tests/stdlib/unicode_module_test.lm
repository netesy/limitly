// Test Suite for Standard Library Unicode Module

import std.unicode as u;

fn test_rune(): int {
    print("Testing Rune...");
    var r1 = u.Rune("a");
    var r2 = u.Rune("b");
    var r3 = u.Rune("a");

    assert(r1.to_string() == "a", "Rune to_string failed");
    assert(r1.compare(r2) == -1, "Rune compare less failed");
    assert(r2.compare(r1) == 1, "Rune compare greater failed");
    assert(r1.compare(r3) == 0, "Rune compare equal failed");
    return 1;
}

fn test_categories(): int {
    print("Testing Categories...");
    assert(u.is_upper("A"), "is_upper A failed");
    assert(not u.is_upper("a"), "is_upper a failed");

    assert(u.is_lower("a"), "is_lower a failed");
    assert(not u.is_lower("A"), "is_lower A failed");

    assert(u.is_digit("5"), "is_digit 5 failed");
    assert(not u.is_digit("a"), "is_digit a failed");

    assert(u.is_alpha("a"), "is_alpha a failed");
    assert(not u.is_alpha("5"), "is_alpha 5 failed");

    assert(u.is_alphanumeric("a"), "is_alphanumeric a failed");
    assert(u.is_alphanumeric("5"), "is_alphanumeric 5 failed");
    assert(not u.is_alphanumeric("!"), "is_alphanumeric ! failed");

    assert(u.is_whitespace(" "), "is_whitespace space failed");
    assert(u.is_whitespace("\n"), "is_whitespace newline failed");
    assert(not u.is_whitespace("a"), "is_whitespace a failed");
    return 1;
}

fn test_normalize(): int {
    print("Testing Normalize...");
    assert(u.to_upper("hello") == "HELLO", "to_upper failed");
    assert(u.to_lower("WORLD") == "world", "to_lower failed");
    return 1;
}

fn main(): int {
    print("=== Unicode Module Test Suite ===");

    assert(test_rune() == 1, "Rune test failed");
    assert(test_categories() == 1, "Categories test failed");
    assert(test_normalize() == 1, "Normalize test failed");

    print("All unicode tests passed successfully.");
    return 0;
}
