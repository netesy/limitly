import std.collections.index as collections;

fn main(): int {
    var v = collections.Vector();
    v.push(1);
    v.append(2);
    v.insert(1, 9);
    if (v.len() != 3) { return 1; }
    if (v.get(1) != 9) { return 2; }
    if (v.remove(1) != 9) { return 3; }
    v.resize(5, 7);
    if (v.len() != 5) { return 4; }
    var it = v.iter();
    if (it.next() != 1) { return 5; }
    v.clear();
    if (not v.is_empty()) { return 6; }
    return 0;
}
