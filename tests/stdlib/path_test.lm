// tests/stdlib/path_test.lm
// Test suite for std.path module

import std.path as path;

print("=== std.path Tests ===");

var p1 = path.Path("/usr/local/bin");
assert(p1.basename() == "bin", "basename /usr/local/bin");

var p2 = path.Path("file.txt");
assert(p2.basename() == "file.txt", "basename file.txt");
assert(p2.extension() == "txt", "extension txt");

var p3 = path.Path("archive.tar.gz");
assert(p3.extension() == "gz", "extension gz");

var p4 = path.Path("noext");
assert(p4.extension() == "", "extension none");

var p5 = path.Path("/a/b/c");
var par = p5.parent();
match (par) {
    val ppar => {
        assert(ppar.display() == "/a/b", "parent /a/b/c");
    },
    _ => {
        assert(false, "parent was nil");
    }
}

var p6 = path.Path("dir").join("subdir").join("file.txt");
assert(p6.basename() == "file.txt", "chained join basename");

print("std.path tests passed!");
