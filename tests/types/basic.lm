// Basic Type Tests
// Tests fundamental type system features: type aliases, primitive types, basic declarations

print("=== Basic Type Tests ===");

// Test 1: Basic type aliases for primitive types
print("\n--- Test 1: Basic Type Aliases ---");
type Id = uint;
type Name = str;
type Age = int;
type Score = float;
type IsActive = bool;

var user_id: Id = 12345;
var user_name: Name = "Alice";
var user_age: Age = 25;
var user_score: Score = 95.5;
var is_user_active: IsActive = true;

print("User ID: {user_id}");
print("User Name: {user_name}");
print("User Age: {user_age}");
print("User Score: {user_score}");
print("Is Active: {is_user_active}");

assert(user_id == 12345, "Type alias should work for uint");
assert(user_name == "Alice", "Type alias should work for str");
assert(user_age == 25, "Type alias should work for int");
assert(user_score == 95.5, "Type alias should work for float");
assert(is_user_active, "Type alias should work for bool");

// Test 2: All primitive type aliases
print("\n--- Test 2: Primitive Type Aliases ---");
type MyInt = int;
type MyUInt = uint;
type MyFloat = float;
type MyStr = str;
type MyBool = bool;

var int_val: MyInt = 42;
var uint_val: MyUInt = 100;
var str_val: MyStr = "hello";
var bool_val: MyBool = true;
var float_val: MyFloat = 3.14;

print("Int: {int_val}");
print("UInt: {uint_val}");
print("String: {str_val}");
print("Bool: {bool_val}");
print("Float: {float_val}");

assert(int_val == 42, "Primitive type alias should work for int");
assert(uint_val == 100, "Primitive type alias should work for uint");
assert(str_val == "hello", "Primitive type alias should work for str");
assert(bool_val, "Primitive type alias should work for bool");
assert(float_val == 3.14, "Primitive type alias should work for float");

// Test 3: Type alias compatibility
print("\n--- Test 3: Type Alias Compatibility ---");
type UserId = int;
type ProductId = int;

var user: UserId = 1001;
var product: ProductId = 2002;

print("User ID: {user}");
print("Product ID: {product}");

assert(user == 1001, "Type alias compatibility should work");
assert(product == 2002, "Type alias compatibility should work");

// Test 4: Type aliases in function signatures
print("\n--- Test 4: Type Aliases in Functions ---");
type Distance = float;
type Time = float;
type Speed = float;

fn calculate_speed(distance: Distance, time: Time): Speed {
    if (time > 0.0) {
        return distance / time;
    } else {
        return 0.0;
    }
}

var dist: Distance = 100.0;
var duration: Time = 2.0;
var velocity: Speed = calculate_speed(dist, duration);

print("Distance: {dist}");
print("Time: {duration}");
print("Speed: {velocity}");

assert(velocity == 50.0, "Function with type aliases should work: 100.0/2.0 = 50.0");

// Test 5: Nested type usage
print("\n--- Test 5: Nested Type Usage ---");
type FirstName = str;
type LastName = str;
type FullName = str;

fn create_full_name(first: FirstName, last: LastName): FullName {
    return first + " " + last;
}

var first_name: FirstName = "John";
var last_name: LastName = "Doe";
var full_name: FullName = create_full_name(first_name, last_name);

print("First Name: {first_name}");
print("Last Name: {last_name}");
print("Full Name: {full_name}");

assert(full_name == "John Doe", "Function with type aliases should work correctly");

// Test 6: Type aliases with different scopes
print("\n--- Test 6: Type Alias Scopes ---");
type GlobalType = int;

{
    var global_var: GlobalType = 999;
    var local_var: str = "local";
    print("Global in local scope: {global_var}");
    print("Local variable: {local_var}");

    assert(global_var == 999, "Global type alias should work in local scope");
    assert(local_var == "local", "Local variable should work correctly");
}

var another_global: GlobalType = 888;
print("Another global: {another_global}");

assert(another_global == 888, "Global type alias should work outside local scope");

print("\n=== Basic Type Tests Complete ===");
