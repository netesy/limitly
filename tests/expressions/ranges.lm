// Test range expressions
print("=== Range Expression Tests ===");

// Basic ranges
print("Range 1..5:");
var range1_count = 0;
var range1_sum = 0;
iter (i in 1..5) {
    print(i);
    range1_count += 1;
    range1_sum += i;
}
assert(range1_count == 4, "Range 1..5 should iterate 4 times (1,2,3,4)");
assert(range1_sum == 10, "Sum of 1+2+3+4 should be 10");

print("Range 0..3:");
var range2_count = 0;
var range2_sum = 0;
iter (j in 0..3) {
    print(j);
    range2_count += 1;
    range2_sum += j;
}
assert(range2_count == 3, "Range 0..3 should iterate 3 times (0,1,2)");
assert(range2_sum == 3, "Sum of 0+1+2 should be 3");

// Range with variables
var start = 5;
var end = 8;
print("Variable range {start}..{end}:");
var range3_count = 0;
var range3_sum = 0;
iter (k in start..end) {
    print(k);
    range3_count += 1;
    range3_sum += k;
}
assert(range3_count == 3, "Range 5..8 should iterate 3 times (5,6,7)");
assert(range3_sum == 18, "Sum of 5+6+7 should be 18");

// Range with expressions
var base = 2;
print("Expression range {base}..{base + 3}:");
var range4_count = 0;
var range4_sum = 0;
iter (x in base..(base + 3)) {
    print(x);
    range4_count += 1;
    range4_sum += x;
}
assert(range4_count == 3, "Range 2..5 should iterate 3 times (2,3,4)");
assert(range4_sum == 9, "Sum of 2+3+4 should be 9");

// Nested ranges
print("Nested ranges:");
var outer_count = 0;
var total_inner_count = 0;
iter (i in 1..3) {
    print("Outer: {i}");
    outer_count += 1;
    var inner_count = 0;
    iter (j in (i * 10)..(i * 10 + 2)) {
        print("  Inner: {j}");
        inner_count += 1;
        total_inner_count += 1;
    }
    assert(inner_count == 2, "Each inner range should iterate 2 times");
}
assert(outer_count == 2, "Outer range should iterate 2 times (1,2)");
assert(total_inner_count == 4, "Total inner iterations should be 4");

// Empty range
print("Empty range (5..5):");
var empty_count = 0;
iter (empty in 5..5) {
    print("This should not print: {empty}");
    empty_count += 1;
}
assert(empty_count == 0, "Empty range should not iterate");
print("Empty range test complete");

print("=== Range Expression Tests Complete ===");
