// Test very large numeric literals
print("=== Large Literal Tests ===");

// Test maximum values for different types
var max_i64: i64 = 9223372036854775807;
var max_u64: u64 = 18446744073709551615;
var large_float: float = 1.7976931348623157e+308;

print("---------Large literal test:------------");
print("Max I64:", max_i64);
print("Max U64:", max_u64);
print("Large Float:", large_float);

assert(max_i64 == 9223372036854775807, "Max i64 should be 9223372036854775807");
assert(max_u64 == 18446744073709551615, "Max u64 should be 18446744073709551615");
assert(large_float == 1.7976931348623157e+308, "Large float should be 1.7976931348623157e+308");

// Test very small values
var small_float: f64 = 2.2250738585072014e-308;
var tiny_float: f64 = 1e-100;

print("-------Small literal test:-----------");
print("Small Float:", small_float);
print("Tiny Float:", tiny_float);

assert(small_float == 2.2250738585072014e-308, "Small float should be 2.2250738585072014e-308");
assert(tiny_float == 1e-100, "Tiny float should be 1e-100");

// Test negative large values
var pos_large: i64 = 123456789;   // Positive integer
var neg_large: i64 = -123456789;  // Simple negative integer
var neg_float: f64 = -1.7976931348623157e+308;

print("------Negative large literal test: -------");
print("Negative Large I64:", neg_large);
print("Negative Large Float:", neg_float);

assert(pos_large == 123456789, "Positive large integer should be 123456789");
assert(neg_large == -123456789, "Negative large integer should be -123456789");
assert(neg_float == -1.7976931348623157e+308, "Negative large float should be -1.7976931348623157e+308");

// Test arithmetic with large literals
var sum_large = pos_large + 876543211;
var diff_large = max_u64 - pos_large;
var product_large = pos_large * 1000;

print("------Arithmetic with large literals:------");
print("Sum large:", sum_large);
print("Diff large:", diff_large);
print("Product large:", product_large);

assert(sum_large == 1000000000, "Sum of large integers should work");
assert(product_large == 123456789000, "Product of large integers should work");

// Test comparison with large literals
var comp1 = max_i64 > pos_large;
var comp2 = neg_large < pos_large;
var comp3 = large_float > 0.0;

print("------Comparisons with large literals:----");
print("maxI64 > posLarge:", comp1);
print("negLarge < posLarge:", comp2);
print("largeFloat > 0.0:", comp3);

assert(comp1, "maxI64 should be greater than posLarge");
assert(comp2, "negLarge should be less than posLarge");
assert(comp3, "largeFloat should be greater than 0.0");

print("=== Large Literal Tests Complete ===");
