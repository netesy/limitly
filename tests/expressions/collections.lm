// Test collection operations (lists and dictionaries)
print("=== Collection Operations Test ===");

// List operations
print("List operations:");
var my_list = [1, 2, 3, 4, 5];
print("Initial list: " + my_list);

// List indexing
print("myList[0] = " + my_list[0]);
print("myList[2] = " + my_list[2]);
print("myList[4] = " + my_list[4]);

// Dictionary operations
print("Dictionary operations:");
var my_dict = {"name": "Alice", "age": 25, "city": "New York"};
print("Initial dict: " + my_dict);

// Dictionary indexing
print("myDict['name'] = " + my_dict["name"]);
print("myDict['age'] = " + my_dict["age"]);
print("myDict['city'] = " + my_dict["city"]);

// Mixed collections
print("Mixed collections:");
var mixed_list = [1, "hello", true, {"key": "value"}];
print("Mixed list: " + mixed_list);

var nested_dict = {"user": {"name": "Bob", "age": 30}, "active": true};
print("Nested dict: " + nested_dict);
print("nestedDict['user'] = " + nested_dict["user"]);
print("nestedDict['active'] = " + nested_dict["active"]);
