fn main() {
    var b: i128 = 170141183460469231731687303715884105727;
    var c: i128 = 9000000000000000000;
    var d: i128 = 10000000000000000000;
    var e: i128 = 123456789012345678901234567890;
    print(b - 1);
    print(b + 0);
    print(c + d);
    print(c * 2);
    print(e);
    print(e / 3);
    print(e % 7);
    return 0;
}
