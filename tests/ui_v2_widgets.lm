// M2/M3 test: retained component tree with signal-driven state.
//
// Model under test: frame→trait coercion snapshots widgets but SHARES
// frame-typed fields — so StrSignal/FloatSignal fields are the live
// state channel. External code binds signals BEFORE add(); the tree
// reads them every frame. Geometry is observed through the live `rect`
// alias (arrange mutates in place).

import std.gg as gg;
import std.ui.component as v2;
import std.ui.container as boxes;
import std.ui.widgets as widgets;
import std.ui.tree as tree;
import std.ui.draw_list as dl;
import std.ui.state as state;
import std.events as events;

var clicked: int = 0;

fn on_fire(): nil {
    clicked = clicked + 1;
}

fn main() {
    print("=== UI Widgets (M2/M3) ===");

    // ── Signals ──
    var status = state.signal_str("idle");
    var scroll_pos = state.signal_float(0.0);

    // ── Build the tree ──
    var title = v2.label("HUD");
    title.bind_text(status);                    // reactive label

    var fire_btn = widgets.button("Fire", nil, on_fire);
    var btn_rect = fire_btn.rect;               // live geometry alias

    var name_in = widgets.text_input("abc", "name...");
    var in_rect = name_in.rect;
    var in_sig = name_in.text_sig;              // shared signal handle

    var btn_row = boxes.row(8.0);
    btn_row.add(title);
    btn_row.add(fire_btn);
    btn_row.add(name_in);

    var scroll_col = boxes.column(2.0);
    var i: int = 0;
    while (i < 30) {
        scroll_col.add(v2.label("log line " + (i as str)));
        i = i + 1;
    }
    var scroller = boxes.scroll_view(scroll_col);
    scroller.bind_scroll(scroll_pos);
    var scroll_rect = scroller.rect;

    var root = boxes.column(6.0);
    root.add(btn_row);
    root.add(scroller);

    // ── Frame 1: arrange + paint ──
    tree.update(root, 200.0, 200.0);

    assert(btn_rect.w > 0.0 and btn_rect.h > 0.0, "button should be arranged");
    assert(in_rect.w > 0.0 and in_rect.h > 0.0, "input should be arranged");
    assert(scroll_rect.h > 0.0, "scrollview should be arranged");
    assert(scroll_rect.h <= 200.0, "scrollview should clamp to remaining space");
    assert(tree.dirty == 0, "update should clear the dirty flag");

    // ── Signal write marks the tree dirty (via registered notifier) ──
    tree.enable_reactive();
    status.set("armed");
    assert(tree.dirty == 1, "signal set should mark tree dirty");

    var cx: int = (btn_rect.x + btn_rect.w / 2.0) as int;
    var cy: int = (btn_rect.y + btn_rect.h / 2.0) as int;
    var ix: int = (in_rect.x + in_rect.w / 2.0) as int;
    var iy: int = (in_rect.y + in_rect.h / 2.0) as int;

    // ── Click the button ──
    var down = events.Event(event_type=events.EventType.MouseDown, x=cx, y=cy, key_code=0);
    var up = events.Event(event_type=events.EventType.MouseUp, x=cx, y=cy, key_code=0);
    tree.dispatch(root, down);
    tree.dispatch(root, up);
    assert(clicked == 1, "button on_click should have fired once");

    // ── Reactive label: signal write → next frame paints new text ──
    status.set("fired!");
    tree.update(root, 200.0, 200.0);
    // The label's text cmd should now carry "fired!" — find it in cmds.
    var saw_fired: int = 0;
    var ci = 0;
    while (ci < dl.paint_ctx.dl.cmd_count) {
        val cmd = dl.paint_ctx.dl.cmds[ci];
        if (cmd.text == "fired!") { saw_fired = 1; }
        ci = ci + 1;
    }
    assert(saw_fired == 1, "bound label should repaint signal text");

    // ── Type into the text input (two-way signal) ──
    var idown = events.Event(event_type=events.EventType.MouseDown, x=ix, y=iy, key_code=0);
    tree.dispatch(root, idown);
    assert(tree.focused() != nil, "tree should track focused component");

    var end_key = events.Event(event_type=events.EventType.KeyDown, key_code=35);
    tree.dispatch(root, end_key);
    var ch = events.Event(event_type=events.EventType.Char, key_code=90); // 'Z'
    tree.dispatch(root, ch);
    assert(in_sig.get() == "abcZ", "edit should write text_sig, got: " + in_sig.get());

    var bk = events.Event(event_type=events.EventType.KeyDown, key_code=8); // Backspace
    tree.dispatch(root, bk);
    assert(in_sig.get() == "abc", "backspace should update text_sig, got: " + in_sig.get());

    // External write → widget reconciles on next paint.
    in_sig.set("external");
    tree.update(root, 200.0, 200.0);
    var saw_ext: int = 0;
    ci = 0;
    while (ci < dl.paint_ctx.dl.cmd_count) {
        val cmd = dl.paint_ctx.dl.cmds[ci];
        if (cmd.text == "external") { saw_ext = 1; }
        ci = ci + 1;
    }
    assert(saw_ext == 1, "external sig.set should reconcile into the input");

    // ── Scroll the ScrollView (signal two-way) ──
    var wx: int = (scroll_rect.x + scroll_rect.w / 2.0) as int;
    var wy: int = (scroll_rect.y + scroll_rect.h / 2.0) as int;
    var wheel = events.Event(event_type=events.EventType.MouseWheel, x=wx, y=wy, key_code=1);
    tree.dispatch(root, wheel);
    assert(scroll_pos.get() != 0.0, "wheel should write scroll_sig");

    // External scroll → next arrange applies it.
    scroll_pos.set(40.0);
    tree.update(root, 200.0, 200.0);
    assert(scroll_pos.get() == 40.0, "external scroll_sig should persist");

    // ── Paint to screen and verify pixels ──
    assert(gg.setup(), "gg setup failed");
    gg.begin_pass(200, 200, 0.05, 0.07, 0.12, 1.0);
    tree.submit();
    gg.end_pass();
    gg.commit();

    var bg_px = gg.readback_pixel(2, 2);
    var btn_px = gg.readback_pixel(cx, cy);
    gg.shutdown();

    assert(btn_px != bg_px, "button should paint over the clear color");

    print("UI Widgets (M2/M3) PASSED.");
}
