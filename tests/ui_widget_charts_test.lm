import std.ui as ui;
import std.ui.context as ctx;
import std.ui.builder as builder;
import std.ui.draw_list as dlist;
import std.color as color;

fn test_bar_chart() {
    print("Testing BarChart widget...");
    var vals = [10.0, 25.0, 18.0, 40.0] as [float];
    var labels = ["Q1", "Q2", "Q3", "Q4"];
    var bc = ui.bar_chart("Quarterly Sales", vals, labels);

    ctx.ui_init();
    ctx.set_viewport_size(500.0, 400.0);
    ctx.set_root(bc);

    var dl = builder.build(bc, 460.0, 360.0, nil, 20.0, 20.0);
    // Container, border, title, guide lines, baseline, bars, labels
    assert(len(dl.cmds) >= 10, "BarChart should emit background, guides, bars, and category labels");

    print("BarChart tests passed!");
}

fn test_line_chart() {
    print("Testing LineChart widget...");
    var pts = [5.0, 12.0, 8.0, 22.0, 19.0, 30.0] as [float];
    var lc = ui.line_chart("System Load", pts);

    ctx.ui_init();
    ctx.set_viewport_size(500.0, 400.0);
    ctx.set_root(lc);

    var dl = builder.build(lc, 460.0, 360.0, nil, 20.0, 20.0);
    assert(len(dl.cmds) >= 12, "LineChart should emit background, guides, data points, and connect lines");

    print("LineChart tests passed!");
}

fn test_pie_chart() {
    print("Testing PieChart widget...");
    var segs = [65.0, 25.0, 10.0] as [float];
    var lbls = ["Desktop", "Mobile", "Tablet"];
    var pc = ui.pie_chart("Traffic Share", segs, lbls);

    ctx.ui_init();
    ctx.set_viewport_size(500.0, 400.0);
    ctx.set_root(pc);

    var dl = builder.build(pc, 460.0, 360.0, nil, 20.0, 20.0);
    assert(len(dl.cmds) >= 8, "PieChart should emit doughnut/pie segments and legend items");

    print("PieChart tests passed!");
}

fn main(): int {
    test_bar_chart();
    test_line_chart();
    test_pie_chart();
    print("ALL DATA VISUALIZATION & CHARTS TESTS PASSED!");
    return 0;
}

