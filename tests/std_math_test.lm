import std.math as math;

fn main(): int {
    print("=== Testing std.math Constants ===");
    print("PI: {math.PI}");
    print("E: {math.E}");
    print("TAU: {math.TAU}");
    print("PHI: {math.PHI}");
    
    print("\n=== Testing Basic Operations ===");
    var abs_val = math.abs(-5.5);
    print("abs(-5.5): {abs_val}");
    var min_val = math.min(10.0, 20.0);
    print("min(10.0, 20.0): {min_val}");
    var max_val = math.max(10.0, 20.0);
    print("max(10.0, 20.0): {max_val}");
    var clamp_val = math.clamp(15.0, 0.0, 10.0);
    print("clamp(15.0, 0.0, 10.0): {clamp_val}");
    var sign_val = math.sign(-10.0);
    print("sign(-10.0): {sign_val}");
    var lerp_val = math.lerp(0.0, 10.0, 0.5);
    print("lerp(0.0, 10.0, 0.5): {lerp_val}");
    
    print("\n=== Testing Rounding ===");
    var floor_val = math.floor(3.7);
    print("floor(3.7): {floor_val}");
    var ceil_val = math.ceil(3.2);
    print("ceil(3.2): {ceil_val}");
    var round_val = math.round(3.5);
    print("round(3.5): {round_val}");
    var trunc_val = math.trunc(3.9);
    print("trunc(3.9): {trunc_val}");
    var fract_val = math.fract(3.75);
    print("fract(3.75): {fract_val}");
    
    print("\n=== Testing Powers and Logs ===");
    var sqrt_val = math.sqrt(16.0);
    print("sqrt(16.0): {sqrt_val}");
    var cbrt_val = math.cbrt(27.0);
    print("cbrt(27.0): {cbrt_val}");
    var pow_val = math.pow(2.0, 3.0);
    print("pow(2.0, 3.0): {pow_val}");
    var exp_val = math.exp(1.0);
    print("exp(1.0): {exp_val}");
    var log_val = math.log(math.E);
    print("log(math.E): {log_val}");
    
    print("\n=== Testing Trigonometry ===");
    var sin_val = math.sin(0.0);
    print("sin(0.0): {sin_val}");
    var cos_val = math.cos(0.0);
    print("cos(0.0): {cos_val}");
    var tan_val = math.tan(0.0);
    print("tan(0.0): {tan_val}");
    
    print("\n=== Testing Integer Utilities ===");
    var gcd_val = math.gcd(48, 18);
    print("gcd(48, 18): {gcd_val}");
    var lcm_val = math.lcm(48, 18);
    print("lcm(48, 18): {lcm_val}");
    var fact_val = math.factorial(5);
    print("factorial(5): {fact_val}");
    var comb_val = math.combinations(5, 2);
    print("combinations(5, 2): {comb_val}");
    
    print("\n=== Testing Floating-point Helpers ===");
    var is_nan_val = math.is_nan(math.NAN);
    print("is_nan(math.NAN): {is_nan_val}");
    var is_inf_val = math.is_inf(math.INF);
    print("is_inf(math.INF): {is_inf_val}");
    var is_finite_val = math.is_finite(1.0);
    print("is_finite(1.0): {is_finite_val}");
    var nearly_equal_val = math.nearly_equal(1.0, 1.0000001);
    print("nearly_equal(1.0, 1.0000001): {nearly_equal_val}");

    return 0;
}
