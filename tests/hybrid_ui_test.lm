// tests/hybrid_ui_test.lm
// Validates the hybrid DrawList pipeline end-to-end:
//   Declarative Widget API → DrawList (emitted by builder) → GPU replay (zero recursion)

import std.ui as ui;
import std.ui.builder as builder;
import std.ui.draw_list as dl_mod;
import std.ui.replay as replay_mod;
import std.app as app;
import std.gg as gg;

fn main(): nil {
    print("=== Hybrid UI Pipeline Test ===");
    print("Architecture: Declarative API + DrawList engine + linear GPU replay");

    // ── Phase 1: Declare widgets using the unchanged fluent API
    var save_btn = ui.button("Save").size(100.0, 32.0).on_click(fn(): nil { print("[Hybrid] Save clicked"); });
    var cancel_btn = ui.button("Cancel").size(100.0, 32.0).on_click(fn(): nil { print("[Hybrid] Cancel clicked"); });
    var title = ui.text("Dashboard").font_size(24.0).color(ui.white);
    
    var root = ui.column([
        title,
        ui.row([save_btn, cancel_btn]).spacing(12.0)
    ]).padding(16.0);

    print("Widgets declared successfully");

    // ── Phase 2: Single-pass emission into DrawList
    var dl = builder.build(root, 800.0, 600.0);

    print("DrawList commands: {len(dl.cmds)}");
    print("DrawList hit zones: {len(dl.hits)}");
    assert(len(dl.cmds) > 0, "draw commands must be emitted");
    assert(len(dl.hits) >= 2, "hit zones must be emitted for buttons");

    // ── Phase 3: Hit test — O(n) linear scan, no recursion
    print("\nHit testing first button zone:");
    var b1_zone = dl.hits[0] as dl_mod.HitZone;
    var hz1 = dl_mod.dl_hit_test(dl, b1_zone.x + 10.0, b1_zone.y + 10.0);
    if (hz1.kind == dl_mod.HZONE_BUTTON) {
        print("  Hit button 1: '{hz1.id}'");
    } else {
        print("  Miss");
    }

    print("Hit testing second button zone:");
    var b2_zone = dl.hits[1] as dl_mod.HitZone;
    var hz2 = dl_mod.dl_hit_test(dl, b2_zone.x + 10.0, b2_zone.y + 10.0);
    if (hz2.kind == dl_mod.HZONE_BUTTON) {
        print("  Hit button 2: '{hz2.id}'");
    } else {
        print("  Miss");
    }

    // ── Phase 4: GPU replay — pure linear iteration, zero tree traversal
    print("\n=== GPU Replay (5 frames) ===");
    app.init();
    app.show_window();
    var fn_idx = 0;
    while (fn_idx < 5) {
        gg.begin_pass(800, 600, 0.06, 0.06, 0.08, 1.0);
        replay_mod.replay(dl);  // O(n) iteration — no recursion, no tree walk
        gg.end_pass();
        gg.commit();
        sleep(0.016);
        fn_idx = fn_idx + 1;
    }

    print("\n=== Summary ===");
    print("  DrawList built ONCE, cached, replayed {fn_idx} frames");
    print("  Traversals per frame: 0 (vs 3 in retained mode)");
    print("  Allocations per frame: 0 (vs per-widget in retained mode)");
    print("  Commands: {len(dl.cmds)}  HitZones: {len(dl.hits)}");
    app.shutdown();
}
