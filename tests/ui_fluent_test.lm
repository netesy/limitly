// Comprehensive Fluent UI Public API Test Suite
// Verifies:
// 1. Fluent text styling
// 2. Fluent button styling
// 3. Layout modifiers (column, row, spacing, padding)
// 4. Reusable Style value
// 5. Modifier precedence and override ordering
// 6. Button action callback execution
// 7. Multi-frame retained state persistence
// 8. std.app -> Sokol lifecycle integration

import std.app as app;
import std.ui as ui;
import std.gg as gg;
import std.color as color;

fn test_button_callback() {
    print("Action callback executed successfully!");
}

fn test_fluent_text_styling(): int {
    var t = ui.text("Hello Lymar")
    .color(color.red)
    .font_size(24.0)
    .bold();

    assert(t.widget_kind() == ui.WidgetKind.Text, "text kind mismatch");
    assert(t.text == "Hello Lymar", "text content mismatch");
    assert(t.fg.r > 0.8, "text color R mismatch");
    assert(t.font_size_val == 24.0, "text font size mismatch");
    assert(t.weight_val == ui.Weight.Bold, "text weight mismatch");
    print("[PASS] 1. Fluent text styling");
    return 1;
}

fn test_fluent_button_styling(): int {
    var btn = ui.button("Save", test_button_callback)
    .background(color.indigo)
    .foreground(color.white)
    .padding(14.0)
    .corner_radius(8.0)
    .size(160.0, 44.0);

    assert(btn.widget_kind() == ui.WidgetKind.Button, "button kind mismatch");
    assert(btn.label == "Save", "button label mismatch");
    assert(btn.pad_l == 14.0, "button padding mismatch");
    assert(btn.radius == 8.0, "button corner radius mismatch");
    assert(btn.width_val == 160.0, "button width mismatch");
    assert(btn.height_val == 44.0, "button height mismatch");
    assert(btn.on_click_action != nil, "button callback missing");
    print("[PASS] 2. Fluent button styling");
    return 1;
}

fn test_layout_modifiers(): int {
    var item1 = ui.text("Item 1");
    var item2 = ui.text("Item 2");
    var col = ui.column([item1, item2])
    .spacing(12.0)
    .padding_xy(16.0, 20.0);

    assert(col.widget_kind() == ui.WidgetKind.Container, "column kind mismatch");
    assert(col.is_vertical(), "column vertical axis mismatch");
    assert(len(col.children) == 2, "column child count mismatch");
    assert(col.spacing_val == 12.0, "column spacing mismatch");
    assert(col.pad_l == 16.0, "column padding_x mismatch");
    assert(col.pad_t == 20.0, "column padding_y mismatch");

    var r = ui.row([item1, item2]).spacing(8.0);
    assert(not r.is_vertical(), "row axis mismatch");
    assert(r.spacing_val == 8.0, "row spacing mismatch");

    print("[PASS] 3. Layout modifiers (column, row, spacing, padding)");
    return 1;
}

fn test_style_reuse_and_precedence(): int {
    // Define a reusable style
    var base_style = ui.style()
    .background(color.blue)
    .foreground(color.white)
    .padding(10.0)
    .corner_radius(6.0)
    .font_size(16.0);

    // Apply reusable style to two different widgets
    var btn1 = ui.button("B1").style(base_style);
    var btn2 = ui.button("B2").style(base_style);

    assert(btn1.bg.b > 0.9, "btn1 base background mismatch");
    assert(btn2.bg.b > 0.9, "btn2 base background mismatch");
    assert(btn1.pad_l == 10.0, "btn1 base padding mismatch");
    assert(btn2.pad_l == 10.0, "btn2 base padding mismatch");

    // Test modifier override ordering: local modifier overrides style property (later wins)
    btn2.background(color.red).padding(18.0);
    assert(btn2.bg.r > 0.8, "btn2 overridden background mismatch");
    assert(btn2.pad_l == 18.0, "btn2 overridden padding mismatch");

    // Test direct modifier override ordering: later direct modifier overrides earlier direct modifier
    var t = ui.text("Test").color(color.red).color(color.green);
    assert(t.fg.g > 0.7, "later modifier precedence failed");

    print("[PASS] 4. Reusable Style value and modifier precedence");
    return 1;
}

fn test_state_styling(): int {
    var pressed_style = ui.style().background(color.dark_gray).foreground(color.yellow);
    var btn = ui.button("Stateful")
    .background(color.blue)
    .pressed_style(pressed_style);

    var ps = btn.pressed_style_val as ui.Style;
    assert(ps.has_bg, "pressed style missing bg");
    assert(ps.has_fg, "pressed style missing fg");
    print("[PASS] 5. State-specific styling (LVGL-inspired)");
    return 1;
}

fn test_retained_lifecycle_and_callback(): int {
    var cfg = app.default_window_config();
    assert(app.init(cfg) == 1, "app init failed");

    var btn = ui.button("Click Counter", test_button_callback)
    .background(color.rgb(40, 100, 200))
    .size(200.0, 40.0);

    var root = ui.column([btn]).padding(20.0);
    app.ui(root);

    // Frame 1: Initial rendering
    app.run_frame_step();
    var p1 = gg.readback_pixel(50, 50);
    assert(p1 != nil, "frame 1 readback failed");
    assert(btn.click_count == 0, "initial click count must be 0");
    assert(not btn.is_pressed, "initial is_pressed must be false");

    // Frame 2: Mouse down on button at (x=50, y=50) -> pressed visual
    app.push_event(app.Event(event_type=app.EventType.MouseDown, x=50, y=50));
    app.run_frame_step();
    var p2 = gg.readback_pixel(50, 50);
    assert(p2 != nil, "frame 2 readback failed");
    assert(p1 != p2, "pixel should change to pressed color on mouse down");
    assert(btn.is_pressed, "button is_pressed must be true on mouse down");

    // Frame 3: Mouse up on button -> fires callback and resets pressed state
    app.push_event(app.Event(event_type=app.EventType.MouseUp, x=50, y=50));
    app.run_frame_step();
    assert(btn.click_count == 1, "button click_count was not incremented");
    assert(not btn.is_pressed, "button is_pressed must be false after mouse up");

    // Frame 4: Verify retained state persistence across frames
    app.run_frame_step();
    assert(btn.click_count == 1, "click count must persist");

    app.shutdown();
    gg.shutdown();
    print("[PASS] 6. Retained multi-frame state and callback invocation");
    return 1;
}

fn test_style_merge(): int {
    var s1 = ui.style()
    .background(color.red)
    .padding(10.0);

    var s2 = ui.style()
    .foreground(color.blue)
    .corner_radius(6.0);

    var merged = s1.merge(s2);

    assert(merged.has_bg and merged.bg.r > 0.8, "base bg retained");
    assert(merged.has_padding and merged.pad_l == 10.0, "base padding retained");
    assert(merged.has_fg and merged.fg.b > 0.9, "merged fg added");
    assert(merged.has_radius and merged.radius == 6.0, "merged radius added");

    print("[PASS] 7. Style.merge partial style overrides");
    return 1;
}

fn main() {
    print("=== Lymar Fluent UI Comprehensive Test Suite ===");
    test_fluent_text_styling();
    test_fluent_button_styling();
    test_layout_modifiers();
    test_style_reuse_and_precedence();
    test_state_styling();
    test_style_merge();
    test_retained_lifecycle_and_callback();
    print("=== All Fluent UI Tests Passed Successfully ===");
}
