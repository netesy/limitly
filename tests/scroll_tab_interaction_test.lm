// ScrollView & Tab Interaction, Persistence, and Hit-Test Transformation Test
// Verifies:
// 1. Tab page switching and state persistence across frames
// 2. Scroll offset persistence across frames and tab switches
// 3. Resize preserves semantic state (tab, scroll, input, checkbox, slider)
// 4. Scrolled Input & Button hit testing routes to display-transformed coordinates

import std.app as app;
import std.ui as ui;
import std.ui.context as ui_context;

fn on_scrolled_btn_click() {
    print("Scrolled button clicked");
}

fn run_scroll_tab_tests() {
    print("=== Testing ScrollView & Tab Interaction, Persistence, and Hit Testing ===");

    var cfg = app.default_window_config();
    cfg.width = 800;
    cfg.height = 600;
    app.init(cfg);

    // Tab A: Contains a tall ScrollView with buttons and an input
    var btn1 = ui.button("Top Button", nil).height(40.0);
    var spacer1 = ui.spacer().height(60.0);
    var inp1 = ui.input("initial_text", "Placeholder").height(30.0);
    var spacer2 = ui.spacer().height(60.0);
    var btn_scrolled = ui.button("Scrolled Target", on_scrolled_btn_click).height(40.0);
    var spacer3 = ui.spacer().height(100.0);

    var scroll_content = ui.column([
        btn1,
        spacer1,
        inp1,
        spacer2,
        btn_scrolled,
        spacer3
    ]);

    var scr_a = ui.scroll_view(scroll_content, 180.0);

    // Tab B: Simple dashboard view with checkbox and slider
    var chk_b = ui.checkbox(true);
    var sld_b = ui.slider(75.0, 0.0, 100.0);
    var tab_b_content = ui.column([
        ui.text("Tab B Settings"),
        chk_b,
        sld_b
    ]).spacing(10.0);

    var tv = ui.tab_view(["Dashboard", "Settings"], [scr_a, tab_b_content], 0);

    var root = ui.column([tv]);
    app.ui(root);
    app.present_frame();

    // 1. Initial State Checks
    assert(tv.active_tab == 0, "Initial tab must be 0");
    assert(scr_a.scroll_y == 0.0, "Initial scroll_y must be 0.0");
    assert(chk_b.is_checked == 1, "Tab B checkbox initially checked");
    assert(sld_b.slider_val == 75.0, "Tab B slider initially 75.0");

    // 2. Scroll Tab A by wheel
    app.push_event(app.Event(event_type=app.EVENT_MOUSE_MOVE, x=100, y=100));
    app.push_event(app.Event(event_type=app.EVENT_MOUSE_WHEEL, y=-160));
    app.process_events();
    assert(scr_a.scroll_y > 0.0, "Scroll offset should increase after wheel scroll");
    var saved_scroll_y = scr_a.scroll_y;
    print("Pass: Scroll offset updated on Tab A");

    // 3. Render multiple frames without input -> state must persist
    var f = 0;
    while (f < 5) {
        app.present_frame();
        f = f + 1;
    }
    assert(tv.active_tab == 0, "Active tab must persist across frames");
    assert(scr_a.scroll_y == saved_scroll_y, "Scroll offset must persist across frames");
    print("Pass: State persists across multiple frames");

    // 4. Switch to Tab B
    // Tab B header item is around x=130, y=30
    app.push_event(app.Event(event_type=app.EVENT_MOUSE_DOWN, x=130, y=30));
    app.push_event(app.Event(event_type=app.EVENT_MOUSE_UP, x=130, y=30));
    app.process_events();
    assert(tv.active_tab == 1, "Active tab should switch to Tab B (1)");
    app.present_frame();

    // Inactive Tab A elements should NOT receive input or clicks
    assert(btn_scrolled.click_count == 0, "Initial click count should be 0");
    app.push_event(app.Event(event_type=app.EVENT_MOUSE_DOWN, x=100, y=100));
    app.push_event(app.Event(event_type=app.EVENT_MOUSE_UP, x=100, y=100));
    app.process_events();
    assert(btn_scrolled.click_count == 0, "Inactive Tab A must not receive clicks");
    print("Pass: Inactive tab content isolated from input");

    // 5. Switch back to Tab A
    // Tab A header item is around x=50, y=30
    app.push_event(app.Event(event_type=app.EVENT_MOUSE_DOWN, x=50, y=30));
    app.push_event(app.Event(event_type=app.EVENT_MOUSE_UP, x=50, y=30));
    app.process_events();
    assert(tv.active_tab == 0, "Active tab should switch back to Tab A (0)");
    assert(scr_a.scroll_y == saved_scroll_y, "Tab A scroll offset must be preserved across tab switches");
    print("Pass: Tab A scroll offset persisted across tab switch");

    // 6. Window Resize must preserve semantic states
    app.push_event(app.Event(event_type=app.EVENT_RESIZE, x=1024, y=768));
    app.process_events();
    app.present_frame();

    assert(tv.active_tab == 0, "Active tab preserved after window resize");
    assert(scr_a.scroll_y == saved_scroll_y, "Scroll offset preserved after window resize");
    assert(chk_b.is_checked == 1, "Checkbox state preserved after resize");
    assert(sld_b.slider_val == 75.0, "Slider value preserved after resize");
    print("Pass: Window resize preserves tab, scroll, checkbox, and slider state");

    // 7. Focus and edit Input inside ScrollView
    // Click on input field inside ScrollView
    // The input is rendered inside viewport: click within input's visible area
    // Reset scroll to 0 for exact hit testing
    scr_a.scroll_y = 0.0;
    app.present_frame();

    // In Tab A, tab header is 32px + 8px gap = 40px down, ScrollView starts at y=60
    // btn1 is y=66..106, spacer1 is 60px, inp1 is at y=166..196
    app.push_event(app.Event(event_type=app.EVENT_MOUSE_DOWN, x=100, y=175));
    app.push_event(app.Event(event_type=app.EVENT_MOUSE_UP, x=100, y=175));
    app.process_events();
    assert(inp1.is_focused == 1, "Input inside ScrollView should become focused");

    // Type text into input
    app.push_event(app.Event(event_type=app.EVENT_CHAR, key_code=65)); // 'A'
    app.process_events();
    assert(inp1.text_val == "initial_textA", "Input inside ScrollView accepts text input");
    print("Pass: Input inside ScrollView hit testing and text entry verified");

    app.app_shutdown();
    print("=== All ScrollView & Tab Interaction Tests Passed ===");
}

run_scroll_tab_tests();
