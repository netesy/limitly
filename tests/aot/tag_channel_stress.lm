// Option 2 Stage 1 adversarial stress: tagged LmValue across channels,
// foreign pointers (unaligned offsets), and [any] list reallocation.
// NOTE: the concurrent section uses an order-independent checksum because
// worker scheduling order is nondeterministic.
import std.ffi as ffi;

frame Box {
    pub v: any;
    pub n: int;
    pub init(x: any, i: int) {
        self.v = x;
        self.n = i;
    }
}

fn main() {
    // ---- sequential mixed-value channel round-trip (FIFO, deterministic) ----
    var ch = channel();
    var big = 1152921504606846976; // 2^60 -> boxed TYPE_I64
    ch.send(0);
    ch.send(-1);
    ch.send(42);
    ch.send(big);
    ch.send(big + 5);
    ch.send(true);
    ch.send(false);
    ch.send(nil);
    ch.send("chan-str");
    ch.send(3.5);
    ch.close();
    var n = 0;
    iter (v in ch) {
        print("ch[{n}] = {v}");
        n = n + 1;
    }
    print("ch count = {n}");

    // NOTE: multi-worker `concurrent` blocks are excluded here — the AOT
    // scheduler has a pre-existing shared-region-stack race at cores>=2 and
    // divergent capture semantics at cores=1 (independent of LmValue tags;
    // see tests/concurrency/ for the flaky coverage that remains).

    // ---- foreign pointer round-trips through dynamic slots ----
    unsafe {
        var p = ffi.alloc(256);
        var pi: int = p as int;
        print("p valid = {pi != 0}");

        // raw + odd offsets through [any]
        var a0: any = p;
        var a1: any = ffi.ptr_add(p, 1);
        var a2: any = ffi.ptr_add(p, 2);
        var a3: any = ffi.ptr_add(p, 3);
        print("f0 = {(a0 as int) - pi}");
        print("f1 = {(a1 as int) - pi}");
        print("f2 = {(a2 as int) - pi}");
        print("f3 = {(a3 as int) - pi}");

        // same pointers through a typed [int] list (raw scalar fast path)
        var l = [p, ffi.ptr_add(p, 1), ffi.ptr_add(p, 2), ffi.ptr_add(p, 3)];
        print("l0 = {(l[0] as int) - pi}");
        print("l1 = {(l[1] as int) - pi}");
        print("l2 = {(l[2] as int) - pi}");
        print("l3 = {(l[3] as int) - pi}");

        // foreign ptr through frame field + channel
        var bx = Box(p, 1);
        print("frame f = {(bx.v as int) - pi}");
        var fch = channel();
        fch.send(p);
        fch.send(ffi.ptr_add(p, 2));
        fch.close();
        var fi = 0;
        iter (fv in fch) {
            print("fch[{fi}] = {(fv as int) - pi}");
            fi = fi + 1;
        }
        ffi.free(p);
    }

    // ---- [any] list reallocation (memmove) with boxed ints + strings ----
    var mix = [big, "s1", true, nil, 7];
    iter (i in 0..200) {
        mix.append(i);
        mix.append("x{i}");
    }
    print("mix len = {len(mix)}");
    print("mix0 = {mix[0] as int}");
    print("mix1 = {mix[1]}");
    print("mix2 = {mix[2]}");
    print("mix3 = {mix[3]}");
    print("mix4 = {mix[4]}");
    print("mix last = {mix[len(mix) - 1]}");
    // typed readback of boxed int + SMI after realloc
    print("mix0 again = {mix[0] as int}");
    print("mix200 = {mix[200] as int}");
    print("mix201 = {mix[201]}");
}
