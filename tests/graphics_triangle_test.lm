import std.gg as gg;
import std.graphics.canvas as canvas;
import std.graphics.paint as paint;
import std.graphics.color as color;

fn main() {
    print("=== Software Graphics Pixel Verification ===");
    assert(gg.setup(), "gg setup failed");

    // Begin pass and clear to black background (0,0,0,1)
    gg.begin_pass(800, 600, 0.0, 0.0, 0.0, 1.0);

    // Draw red triangle using Canvas -> std.gg pipeline draw
    var cvs = canvas.Canvas(w=800.0, h=600.0);
    var p = paint.Paint();
    p.color_val = color.rgb(255, 0, 0);

    cvs.draw_triangle(100.0, 100.0, 200.0, 100.0, 150.0, 200.0, p);
    gg.end_pass();
    gg.commit();

    // Verify pixel inside triangle (150, 120) is non-nil
    var inside_pixel = gg.readback_pixel(150, 120);
    assert(inside_pixel != nil, "Pixel inside triangle should be non-nil");

    gg.shutdown();
    print("Pixel verification passed successfully.");
}

main();
