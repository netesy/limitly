// Minimal windowed GPU-backend bisect: clear + one rect + one text per frame.
import std.gg as gg;

fn main() {
    assert(gg.setup(), "gg setup failed");
    gg.spawn_window(800, 600, "GPU Bisect", 0);
    var frames = 0;
    while (frames < 600) {
        gg.begin_pass(800, 600, 0.05, 0.07, 0.12, 1.0);
        // big magenta rect center — proves raw sg rect path
        gg.draw_rect_primitive(300.0, 250.0, 200.0, 100.0, 1.0, 0.0, 1.0, 1.0);
        // huge white text — proves fontstash/sgl path
        gg.draw_text("HELLO GPU", 100.0, 100.0, 1.0, 1.0, 1.0, 1.0, 4);
        gg.end_pass();
        gg.poll_events();
        frames = frames + 1;
    }
    gg.shutdown();
}
