// Probe: verify the four recorded compiler constraints.
import std.ui as ui;

// ── 1. Trait requirement with default param is a parse error ──
// (verified separately by probe_default_params.lm failing to compile; here we
//  use the bare declare + default-in-implementation pattern that DOES work)
trait Renderer2 {
    fn draw(camera: any): nil;
}

frame CamA: Renderer2 {
    pub fn draw(camera: any = nil): nil {
        print("CamA.draw ok");
        return nil;
    }
}

// ── 4. embed host vs structural subtyping ──
frame Node {
    pub var name: str = "node";
    pub fn label(): str { return self.name; }
}

frame TransformNode {
    embed Node;               // flattens Node's members; TransformNode is NOT a Node subtype
    pub var tx: int = 0;
}

fn take_node(n: Node): str { return n.label(); }

fn main() {
    // 1: default-param conformance works when trait declares bare
    var r = CamA();
    r.draw();

    // 3: closure capture by-value snapshot
    var counter = 0;
    var bump = fn() { counter = counter + 1; };
    bump();
    bump();
    print("counter after two bumps (by-value capture expects 0): {counter}");

    // 2: computed/effect notify chain
    var a = ui.signal_int(1);
    var b = ui.signal_int(2);
    var sum = ui.computed(fn(): any { return a.get() + b.get(); }, [a, b]);
    print("sum initial (expect 3): {sum.get()}");
    a.set(10);
    print("sum after a.set(10) (expect 12): {sum.get()}");

    // 4: embed host needs explicit cast where Node is expected
    var t = TransformNode();
    print("take_node via cast (expect node): " + take_node(t as Node));
}

main();
