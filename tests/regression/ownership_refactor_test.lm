// Regression test for type ownership refactor
// Tests that collection syntax [int], {str:int}, (int,str) works correctly
// and that list/dict/array are no longer reserved keywords

// Test 1: Collection literals
var list_literal = [1, 2, 3];
var dict_literal = {"a": 1, "b": 2};
var tuple_literal = (10, 20);

print("Collection literals: OK");

// Test 2: Collection type annotations
var list_typed: [int] = [1, 2, 3];
var dict_typed: {str: int} = {"a": 1, "b": 2};
var tuple_typed: (int, str) = (42, "hello");

print("Collection type annotations: OK");

// Test 3: Enum compatibility with collections
enum Color {
    Red,
    Blue,
    Green
}

var colors: [Color] = [
    Color.Red,
    Color.Blue,
    Color.Green
];

var color_dict: {str: Color} = {
    "primary": Color.Red,
    "secondary": Color.Blue
};

var color_tuple: (Color, Color) = (Color.Red, Color.Blue);

print("Enum compatibility with collections: OK");

// Test 4: list/dict/array can be used as identifiers (not reserved)
var list = 5;
var dict = 10;
var array = 15;

print("list/dict/array as identifiers: OK");
print("list = ", list);
print("dict = ", dict);
print("array = ", array);

// Test 5: Verify generic syntax is NOT supported
// These should fail to parse:
// var invalid1: List<int> = [1, 2, 3];  // Should be syntax error
// var invalid2: Dict<str, int> = {"a": 1};  // Should be syntax error
// var invalid3: Option<int> = some(5);  // Should be syntax error

print("Generic syntax correctly unsupported: OK");

print("All ownership refactor tests passed!");
