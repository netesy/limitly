// UI Ergonomics Verification - 5 Representative Application Snippets
// 1. Simple label + button
// 2. Styled login form
// 3. Counter
// 4. Toolbar / card layout
// 5. Settings form
// Validates structural composition, layout calculation, and real pipeline rendering across all 5 forms.

import std.app as app;
import std.ui as ui;
import std.gg as gg;

// Snippet 1: Simple label + button
fn snippet_1_simple(): ui.Widget {
    return ui.column([
        ui.text("Welcome to Limit!").color(ui.white),
        ui.button("Get Started").background(ui.blue).foreground(ui.white)
    ]).spacing(12.0).padding(16.0);
}

// Snippet 2: Styled login form
fn snippet_2_login(): ui.Widget {
    var input_style = ui.style()
        .background(ui.dark_gray)
        .padding(10.0)
        .corner_radius(4.0)
        .font_size(14.0);

    return ui.column([
        ui.text("Sign In").font_size(20.0).bold().color(ui.white),
        ui.text("Username").color(ui.light_gray),
        ui.input("user@example.com").style(input_style),
        ui.text("Password").color(ui.light_gray),
        ui.input("********").style(input_style),
        ui.button("Login")
            .background(ui.indigo)
            .foreground(ui.white)
            .padding_xy(16.0, 10.0)
            .corner_radius(6.0)
    ]).spacing(8.0).padding(16.0);
}

// Snippet 3: Counter
fn snippet_3_counter(): ui.Widget {
    return ui.column([
        ui.text("Counter Application").font_size(18.0).bold(),
        ui.text("Count: 42").color(ui.light_gray),
        ui.row([
            ui.button("Decrement").background(ui.red).padding(8.0),
            ui.spacer(),
            ui.button("Increment").background(ui.green).padding(8.0)
        ]).spacing(10.0)
    ]).spacing(12.0).padding(16.0);
}

// Snippet 4: Toolbar / card layout
fn snippet_4_card(): ui.Widget {
    var card_style = ui.style()
        .background(ui.dark_gray)
        .padding(16.0)
        .corner_radius(8.0)
        .spacing(10.0);

    var toolbar = ui.row([
        ui.button("New").padding(6.0),
        ui.button("Open").padding(6.0),
        ui.button("Save").padding(6.0),
        ui.spacer(),
        ui.button("Settings").padding(6.0)
    ]).spacing(8.0);

    return ui.column([
        toolbar,
        ui.column([
            ui.text("Project Dashboard").font_size(18.0).bold(),
            ui.text("All systems operational.").color(ui.green)
        ]).style(card_style)
    ]).spacing(12.0).padding(16.0);
}

// Snippet 5: Settings form
fn snippet_5_settings(): ui.Widget {
    return ui.column([
        ui.text("Settings").font_size(20.0).bold(),
        ui.row([
            ui.text("Enable Notifications"),
            ui.spacer(),
            ui.checkbox(true)
        ]),
        ui.row([
            ui.text("Dark Theme"),
            ui.spacer(),
            ui.checkbox(true)
        ]),
        ui.row([
            ui.text("Volume"),
            ui.spacer(),
            ui.slider(75.0, 0.0, 100.0)
        ]),
        ui.button("Save Changes").background(ui.blue).padding(10.0)
    ]).spacing(10.0).padding(16.0);
}

fn build_all_forms_gallery(): ui.Widget {
    return ui.column([
        ui.text("Limit UI Form Gallery").font_size(22.0).bold().color(ui.white),
        snippet_1_simple(),
        snippet_2_login(),
        snippet_3_counter(),
        snippet_4_card(),
        snippet_5_settings()
    ]).spacing(12.0).padding(12.0);
}

fn main() {
    print("=== Testing 5 Representative Ergonomics Snippets with Real Rendering ===");

    var cfg = app.default_window_config();
    assert(app.init(cfg) == 1, "app init failed");

    // Form 1: Simple label + button
    var s1 = snippet_1_simple();
    assert(s1.kind == ui.KIND_CONTAINER, "snippet 1 structural check failed");
    app.ui(s1);
    app.run_frame_step();
    var p1 = gg.readback_pixel(40, 40);
    assert(p1 != nil, "snippet 1 render failed");
    print("[PASS - RENDERED] Snippet 1: Simple label + button");

    // Form 2: Styled login form
    var s2 = snippet_2_login();
    assert(len(s2.children) == 6, "snippet 2 structural check failed");
    app.ui(s2);
    app.run_frame_step();
    var p2 = gg.readback_pixel(40, 40);
    assert(p2 != nil, "snippet 2 render failed");
    print("[PASS - RENDERED] Snippet 2: Styled login form");

    // Form 3: Counter
    var s3 = snippet_3_counter();
    assert(len(s3.children) == 3, "snippet 3 structural check failed");
    app.ui(s3);
    app.run_frame_step();
    var p3 = gg.readback_pixel(40, 40);
    assert(p3 != nil, "snippet 3 render failed");
    print("[PASS - RENDERED] Snippet 3: Counter");

    // Form 4: Toolbar / card layout
    var s4 = snippet_4_card();
    assert(len(s4.children) == 2, "snippet 4 structural check failed");
    app.ui(s4);
    app.run_frame_step();
    var p4 = gg.readback_pixel(40, 40);
    assert(p4 != nil, "snippet 4 render failed");
    print("[PASS - RENDERED] Snippet 4: Toolbar / card layout");

    // Form 5: Settings form
    var s5 = snippet_5_settings();
    assert(len(s5.children) == 5, "snippet 5 structural check failed");
    app.ui(s5);
    app.run_frame_step();
    var p5 = gg.readback_pixel(40, 40);
    assert(p5 != nil, "snippet 5 render failed");
    print("[PASS - RENDERED] Snippet 5: Settings form");

    // Form 6: Combined gallery rendering
    var gallery = build_all_forms_gallery();
    app.ui(gallery);
    app.run_frame_step();
    var p_gallery = gg.readback_pixel(50, 50);
    assert(p_gallery != nil, "gallery render failed");
    print("[PASS - RENDERED] Multi-Form Gallery rendered to framebuffer");

    app.shutdown();
    gg.shutdown();
    print("=== All 5 Ergonomics Forms Successfully Rendered and Verified ===");
}

main();
