// tests/d3_showcase.lm
// Interactive 3D Showcase demonstrating std.d3 real-time 3D graphics in Lymar.
// Features the Valkyrie SF-9 Aerospace Interceptor with multi-material subsystems,
// interactive orbit controls, procedural asteroids, and real-time IMGUI sliders.

import std.d3 as d3;
import std.gg as gg;
import std.game as game;
import std.theme as theme;
import std.color as color;
import std.math as math;

fn add_tri(g: d3.Geometry, i0: int, i1: int, i2: int) {
    g.add_face(i0, i1, i2);
}

fn add_quad(g: d3.Geometry, i0: int, i1: int, i2: int, i3: int) {
    g.add_face(i0, i1, i2);
    g.add_face(i0, i2, i3);
}

// ── 1. Aerodynamic Titanium Fuselage with Integrated Engine Nacelles ──
fn build_starfighter_hull(): d3.Geometry {
    var g = d3.Geometry();

    // ── 1. Needle-Nose & Stealth Chines (z = 2.8 -> 2.0 -> 1.0) ──
    var p_tip   = g.add_vertex(0.0, 0.02, 2.8);          // 0: needle nose probe
    var n1_top  = g.add_vertex(0.0, 0.16, 2.0);          // 1
    var n1_cl   = g.add_vertex(-0.28, 0.04, 2.0);        // 2
    var n1_cr   = g.add_vertex(0.28, 0.04, 2.0);         // 3
    var n1_bot  = g.add_vertex(0.0, -0.14, 2.0);         // 4

    add_tri(g, p_tip, n1_top, n1_cl);
    add_tri(g, p_tip, n1_cr, n1_top);
    add_tri(g, p_tip, n1_cl, n1_bot);
    add_tri(g, p_tip, n1_bot, n1_cr);

    var n2_top  = g.add_vertex(0.0, 0.28, 1.0);          // 5: cockpit nose sill
    var n2_cl   = g.add_vertex(-0.55, 0.05, 1.0);        // 6
    var n2_cr   = g.add_vertex(0.55, 0.05, 1.0);         // 7
    var n2_bot  = g.add_vertex(0.0, -0.22, 1.0);         // 8

    add_quad(g, n1_top, n2_top, n2_cl, n1_cl);
    add_quad(g, n1_top, n1_cr, n2_cr, n2_top);
    add_quad(g, n1_bot, n1_cl, n2_cl, n2_bot);
    add_quad(g, n1_bot, n2_bot, n2_cr, n1_cr);

    // ── 2. Cockpit Sills & Blended Mid Fuselage (z = 1.0 -> 0.1 -> -0.7) ──
    var s_mid_l = g.add_vertex(-0.35, 0.32, 0.1);        // 9
    var s_mid_r = g.add_vertex(0.35, 0.32, 0.1);         // 10
    var s_aft_l = g.add_vertex(-0.30, 0.35, -0.7);       // 11
    var s_aft_r = g.add_vertex(0.30, 0.35, -0.7);        // 12
    var s_aft_c = g.add_vertex(0.0, 0.44, -0.8);         // 13: rear canopy apex

    var c_mid_l = g.add_vertex(-0.85, 0.04, 0.1);        // 14
    var c_mid_r = g.add_vertex(0.85, 0.04, 0.1);         // 15
    var c_aft_l = g.add_vertex(-1.00, 0.02, -0.7);       // 16
    var c_aft_r = g.add_vertex(1.00, 0.02, -0.7);        // 17

    var k_mid   = g.add_vertex(0.0, -0.30, 0.1);         // 18: ventral keel
    var k_aft   = g.add_vertex(0.0, -0.32, -0.7);        // 19

    // Upper deck flanks
    add_tri(g, n2_top, s_mid_l, n2_cl);
    add_tri(g, n2_cl, s_mid_l, c_mid_l);
    add_quad(g, s_mid_l, s_aft_l, c_aft_l, c_mid_l);
    add_tri(g, s_aft_l, s_aft_c, c_aft_l);

    add_tri(g, n2_top, n2_cr, s_mid_r);
    add_tri(g, n2_cr, c_mid_r, s_mid_r);
    add_quad(g, s_mid_r, c_mid_r, c_aft_r, s_aft_r);
    add_tri(g, s_aft_r, c_aft_r, s_aft_c);

    // Ventral hull flanks
    add_quad(g, n2_bot, n2_cl, c_mid_l, k_mid);
    add_quad(g, n2_bot, k_mid, c_mid_r, n2_cr);
    add_quad(g, k_mid, c_mid_l, c_aft_l, k_aft);
    add_quad(g, k_mid, k_aft, c_aft_r, c_mid_r);

    // ── 3. Twin Sculpted Engine Nacelles & Stern (z = -0.7 -> -1.6 -> -2.5) ──
    var sp_mid  = g.add_vertex(0.0, 0.50, -1.6);         // 20: raised dorsal spine
    var sp_aft  = g.add_vertex(0.0, 0.40, -2.5);         // 21

    var en_p_top = g.add_vertex(-0.62, 0.38, -1.6);      // 22
    var en_p_out = g.add_vertex(-0.95, 0.06, -1.6);      // 23
    var en_p_bot = g.add_vertex(-0.62, -0.22, -1.6);     // 24
    var st_p_top = g.add_vertex(-0.60, 0.32, -2.5);      // 25
    var st_p_out = g.add_vertex(-0.90, 0.05, -2.5);      // 26
    var st_p_bot = g.add_vertex(-0.60, -0.20, -2.5);     // 27
    var st_p_in  = g.add_vertex(-0.25, 0.05, -2.5);      // 28

    var en_s_top = g.add_vertex(0.62, 0.38, -1.6);       // 29
    var en_s_out = g.add_vertex(0.95, 0.06, -1.6);       // 30
    var en_s_bot = g.add_vertex(0.62, -0.22, -1.6);      // 31
    var st_s_top = g.add_vertex(0.60, 0.32, -2.5);       // 32
    var st_s_out = g.add_vertex(0.90, 0.05, -2.5);       // 33
    var st_s_bot = g.add_vertex(0.60, -0.20, -2.5);      // 34
    var st_s_in  = g.add_vertex(0.25, 0.05, -2.5);       // 35

    var v_mid   = g.add_vertex(0.0, -0.14, -1.6);        // 36
    var v_aft   = g.add_vertex(0.0, -0.12, -2.5);        // 37

    add_tri(g, s_aft_c, sp_mid, en_p_top);
    add_tri(g, s_aft_c, en_s_top, sp_mid);
    add_quad(g, s_aft_c, en_p_top, en_p_out, c_aft_l);
    add_quad(g, s_aft_c, c_aft_r, en_s_out, en_s_top);

    add_quad(g, sp_mid, sp_aft, st_p_top, en_p_top);
    add_quad(g, sp_mid, en_s_top, st_s_top, sp_aft);

    add_quad(g, en_p_top, st_p_top, st_p_out, en_p_out);
    add_quad(g, en_p_out, st_p_out, st_p_bot, en_p_bot);
    add_quad(g, en_s_top, en_s_out, st_s_out, st_s_top);
    add_quad(g, en_s_out, en_s_bot, st_s_bot, st_s_out);

    add_quad(g, k_aft, c_aft_l, en_p_out, en_p_bot);
    add_tri(g, k_aft, en_p_bot, v_mid);
    add_quad(g, k_aft, en_s_bot, en_s_out, c_aft_r);
    add_tri(g, k_aft, v_mid, en_s_bot);

    // Nacelle inner walls: without these the channel between the engines is
    // a see-through V opening into the hull.
    add_tri(g, en_p_top, en_p_bot, st_p_bot);
    add_tri(g, en_p_top, st_p_bot, st_p_in);
    add_tri(g, en_p_top, st_p_in, st_p_top);
    add_tri(g, en_s_top, st_s_top, st_s_in);
    add_tri(g, en_s_top, st_s_in, st_s_bot);
    add_tri(g, en_s_top, st_s_bot, en_s_bot);

    add_quad(g, v_mid, en_p_bot, st_p_bot, v_aft);
    add_quad(g, v_mid, v_aft, st_s_bot, en_s_bot);

    // Center stern collar
    add_quad(g, sp_aft, st_p_in, v_aft, st_s_in);
    add_tri(g, sp_aft, st_p_top, st_p_in);
    add_tri(g, sp_aft, st_s_in, st_s_top);

    // Nacelle stern caps: the engine tubes were open at z=-2.5, leaving a
    // see-through opening into the hull. Cap both with outward (-Z) faces;
    // the thruster bells protrude through them as exhaust nozzles.
    add_quad(g, st_p_top, st_p_in, st_p_bot, st_p_out);
    add_quad(g, st_s_top, st_s_out, st_s_bot, st_s_in);

    // ── 4. 3D Swept Delta Wings with True Airfoil & Canted Winglets ──
    var pw_le_tip = g.add_vertex(-2.45, 0.04, -0.9);     // 38
    var pw_te_tip = g.add_vertex(-2.30, -0.02, -1.7);    // 39
    var pw_spar_u = g.add_vertex(-1.60, 0.08, -0.9);     // 40
    var pw_spar_d = g.add_vertex(-1.60, -0.10, -0.9);    // 41
    var pw_wlet_t = g.add_vertex(-2.65, 0.48, -1.4);     // 42

    add_tri(g, c_mid_l, pw_spar_u, pw_le_tip);
    add_tri(g, c_mid_l, c_aft_l, pw_spar_u);
    add_tri(g, c_aft_l, en_p_out, pw_spar_u);
    add_tri(g, pw_spar_u, en_p_out, pw_te_tip);
    add_tri(g, pw_spar_u, pw_te_tip, pw_le_tip);

    add_tri(g, c_mid_l, pw_le_tip, pw_spar_d);
    add_tri(g, c_mid_l, pw_spar_d, c_aft_l);
    add_tri(g, c_aft_l, pw_spar_d, en_p_out);
    add_tri(g, pw_spar_d, pw_te_tip, en_p_out);
    add_tri(g, pw_spar_d, pw_le_tip, pw_te_tip);

    add_tri(g, pw_le_tip, pw_wlet_t, pw_te_tip);
    add_tri(g, pw_le_tip, pw_te_tip, pw_wlet_t);

    var sw_le_tip = g.add_vertex(2.45, 0.04, -0.9);      // 43
    var sw_te_tip = g.add_vertex(2.30, -0.02, -1.7);     // 44
    var sw_spar_u = g.add_vertex(1.60, 0.08, -0.9);      // 45
    var sw_spar_d = g.add_vertex(1.60, -0.10, -0.9);     // 46
    var sw_wlet_t = g.add_vertex(2.65, 0.48, -1.4);      // 47

    add_tri(g, c_mid_r, sw_le_tip, sw_spar_u);
    add_tri(g, c_mid_r, sw_spar_u, c_aft_r);
    add_tri(g, c_aft_r, sw_spar_u, en_s_out);
    add_tri(g, sw_spar_u, sw_te_tip, en_s_out);
    add_tri(g, sw_spar_u, sw_le_tip, sw_te_tip);

    add_tri(g, c_mid_r, sw_spar_d, sw_le_tip);
    add_tri(g, c_mid_r, c_aft_r, sw_spar_d);
    add_tri(g, c_aft_r, sw_spar_d, en_s_out);
    add_tri(g, sw_spar_d, en_s_out, sw_te_tip);
    add_tri(g, sw_spar_d, sw_te_tip, sw_le_tip);

    add_tri(g, sw_le_tip, sw_te_tip, sw_wlet_t);
    add_tri(g, sw_le_tip, sw_wlet_t, sw_te_tip);

    // ── 5. Twin Canted V-Tail Vertical Stabilizers (28 deg cant) ──
    // Root leading edge sits on the nacelle top ridge (en_p_top/en_s_top);
    // rooting at z=-1.1 left a ~0.4 gap between fin and fuselage.
    var pf_b_le  = g.add_vertex(-0.62, 0.38, -1.6);      // 48
    var pf_b_te  = g.add_vertex(-0.60, 0.32, -2.4);      // 49
    var pf_t_le  = g.add_vertex(-1.12, 1.32, -1.7);      // 50
    var pf_t_te  = g.add_vertex(-1.18, 1.25, -2.3);      // 51

    add_tri(g, pf_b_le, pf_t_le, pf_t_te);
    add_tri(g, pf_b_le, pf_t_te, pf_b_te);
    add_tri(g, pf_b_le, pf_t_te, pf_t_le);
    add_tri(g, pf_b_le, pf_b_te, pf_t_te);

    var sf_b_le  = g.add_vertex(0.62, 0.38, -1.6);       // 52
    var sf_b_te  = g.add_vertex(0.60, 0.32, -2.4);       // 53
    var sf_t_le  = g.add_vertex(1.12, 1.32, -1.7);       // 54
    var sf_t_te  = g.add_vertex(1.18, 1.25, -2.3);       // 55

    add_tri(g, sf_b_le, sf_t_te, sf_t_le);
    add_tri(g, sf_b_le, sf_b_te, sf_t_te);
    add_tri(g, sf_b_le, sf_t_le, sf_t_te);
    add_tri(g, sf_b_le, sf_t_te, sf_b_te);

    // ── 6. Horizontal Tailplane Stabilizers ──
    // The aircraft had delta wings and V-tails but no horizontal tail
    // surfaces; these small swept stabs complete the tail silhouette.
    var hp_le  = g.add_vertex(-0.60, 0.00, -2.0);        // 56
    var hp_tip = g.add_vertex(-1.50, 0.04, -2.4);        // 57
    var hp_te  = g.add_vertex(-1.45, 0.00, -2.65);       // 58
    var hp_re  = g.add_vertex(-0.60, -0.05, -2.3);       // 59
    add_quad(g, hp_le, hp_tip, hp_te, hp_re);

    var hq_le  = g.add_vertex(0.60, 0.00, -2.0);         // 60
    var hq_tip = g.add_vertex(1.50, 0.04, -2.4);         // 61
    var hq_te  = g.add_vertex(1.45, 0.00, -2.65);        // 62
    var hq_re  = g.add_vertex(0.60, -0.05, -2.3);        // 63
    add_quad(g, hq_le, hq_tip, hq_te, hq_re);

    g.compute_vertex_normals();
    return g;
}

// ── 2. Faceted Cockpit Canopy Glass (Sits perfectly flush on the sill) ──
fn build_starfighter_canopy(): d3.Geometry {
    var g = d3.Geometry();

    var cn_fwd = g.add_vertex(0.0, 0.28, 1.0);           // 0
    var cn_l1  = g.add_vertex(-0.35, 0.32, 0.1);         // 1
    var cn_r1  = g.add_vertex(0.35, 0.32, 0.1);          // 2
    var cn_l2  = g.add_vertex(-0.30, 0.35, -0.7);        // 3
    var cn_r2  = g.add_vertex(0.30, 0.35, -0.7);         // 4
    var cn_aft = g.add_vertex(0.0, 0.44, -0.8);          // 5

    var cr_wind = g.add_vertex(0.0, 0.52, 0.4);          // 6: windscreen peak
    var cr_dome = g.add_vertex(0.0, 0.58, -0.2);         // 7: canopy crown

    add_tri(g, cn_fwd, cr_wind, cn_l1);
    add_tri(g, cn_fwd, cn_r1, cr_wind);
    add_tri(g, cr_wind, cr_dome, cn_l1);
    add_tri(g, cr_dome, cn_l2, cn_l1);
    add_tri(g, cr_wind, cn_r1, cr_dome);
    add_tri(g, cr_dome, cn_r1, cn_r2);
    add_tri(g, cr_dome, cn_aft, cn_l2);
    add_tri(g, cr_dome, cn_r2, cn_aft);

    g.compute_vertex_normals();
    return g;
}

// ── 3. Integrated Chine Autocannons & Dorsal Spine Blade Fairing ──
// Uses procedural polygon extrusion (d3.extrude) and bilateral symmetry mirroring (d3.mirror_compound).
fn build_starfighter_trim(): d3.Geometry {
    // 1. Procedural Extruded Port Autocannon Pod
    val gun_profile: [float] = [
        -0.08, -0.05,
         0.08, -0.05,
         0.09,  0.03,
         0.00,  0.09,
        -0.09,  0.03
    ];
    // Extrude 0.6m along Z, tapering down to 0.35x at the muzzle. Mounted on
    // the wing panels (x~+-1.7, chord z -0.9..-1.5) so the pods emerge from
    // the wing surface instead of floating beside the fuselage.
    var gun = d3.extrude(gun_profile, 0.6, 0.35, 0.0);
    gun.rotate_x(3.14159265); // Flip Z to face forward (+Z)
    gun.translate(-1.7, 0.0, -1.5);

    // Bilateral Symmetry: mirror port gun across X to create starboard gun
    var g = d3.mirror_compound(gun, 0);

    // 2. Aerodynamic Dorsal Spine Blade Fairing
    var spine = d3.Geometry();
    // Lowered so the blade base intersects the dorsal spine ridge
    // (sp_mid/sp_aft at y~0.40-0.50) instead of floating above it.
    var sp_blade_f = spine.add_vertex(0.0, 0.47, -0.6);
    var sp_blade_t = spine.add_vertex(0.0, 0.56, -1.6);
    var sp_blade_b = spine.add_vertex(0.0, 0.40, -2.4);
    var sp_side_l  = spine.add_vertex(-0.07, 0.45, -1.6);
    var sp_side_r  = spine.add_vertex(0.07, 0.45, -1.6);

    add_tri(spine, sp_blade_f, sp_blade_t, sp_side_l);
    add_tri(spine, sp_blade_f, sp_side_r, sp_blade_t);
    add_tri(spine, sp_blade_t, sp_blade_b, sp_side_l);
    add_tri(spine, sp_blade_t, sp_side_r, sp_blade_b);
    spine.compute_vertex_normals();

    g.merge(spine);
    return g;
}

// ── 4. Twin Convergent-Divergent Ion Thruster Nozzles ──
// Uses rotational lathe sculpting (d3.revolve), axial rotation, and geometry merging.
fn build_starfighter_thrusters(): d3.Geometry {
    // Revolve silhouette representing an aerospace rocket nozzle
    val nozzle_profile: [float] = [
        0.06, -0.42,
        0.22, -0.15,
        0.18,  0.00,
        0.15,  0.18,
        0.24,  0.32
    ];
    var bell = d3.revolve(nozzle_profile, 12);
    bell.rotate_x(1.5707963); // Rotate 90 deg to face rearward (-Z)

    var port = bell.clone();
    port.translate(-0.60, 0.05, -2.55);

    var stbd = bell.clone();
    stbd.translate(0.60, 0.05, -2.55);

    port.merge(stbd);
    return port;
}

fn main(): int {
    print(" === Launching Limitless 3D Starfighter Showcase (std.d3) === ");

    var cfg = game.Config(
        title = "Limitless 3D - Valkyrie SF-9 Interceptor (std.d3)",
        width = 1000,
        height = 700,
        resizable = true
    );
    cfg.bg_color = color.hex(0x080914, 1.0);

    var app = game.Game(cfg);
    if (not app.setup()) {
        print("Error: Failed to initialize graphics context.");
        return 1;
    }

    app.gui.set_theme(theme.cyberpunk_theme());

    // ── Build 3D Scene & Lighting ──────────────────────────────────────────
    var scene = d3.Scene3D();
    scene.background_r = 0.03;
    scene.background_g = 0.04;
    scene.background_b = 0.08;

    scene.add_light(d3.ambient_light(0.8, 0.9, 1.0, 0.35));

    var sun = d3.directional_light(-0.6, 0.8, 0.7, 1.0, 0.96, 0.88, 1.25);
    scene.add_light(sun);

    var rim_light = d3.directional_light(0.8, -0.4, -0.6, 0.3, 0.7, 1.0, 0.85);
    scene.add_light(rim_light);

    // ── Starfighter Subsystem Meshes ───────────────────────────────────────
    // 1. Titanium Hull: Aerodynamic fuselage and swept wings
    var hull_geo = build_starfighter_hull();
    var hull_mat = d3.phong_material(0.88, 0.92, 0.98, 64.0);
    hull_mat.specular = 0.9;
    // The hand-built hull shell has open sections and mixed winding; render
    // both sides so the fuselage never shows see-through holes.
    hull_mat.cull_mode = d3.CullMode.None;
    var hull_mesh = d3.Mesh(hull_geo, hull_mat, "StarfighterHull");
    scene.add(hull_mesh);

    // 2. Canopy: Tinted Solar Cyan Crystal Visor
    var canopy_geo = build_starfighter_canopy();
    var canopy_mat = d3.phong_material(0.10, 0.85, 0.98, 128.0);
    canopy_mat.specular = 0.95;
    canopy_mat.cull_mode = d3.CullMode.None;
    var canopy_mesh = d3.Mesh(canopy_geo, canopy_mat, "StarfighterCanopy");
    scene.add(canopy_mesh);

    // 3. Trim: Procedurally Extruded & Mirrored Chine Autocannons + Spine Fairing
    var trim_geo = build_starfighter_trim();
    var trim_mat = d3.phong_material(0.20, 0.22, 0.28, 48.0);
    var trim_mesh = d3.Mesh(trim_geo, trim_mat, "StarfighterTrim");
    scene.add(trim_mesh);

    // 4. Thrusters: Rotational Lathe (Revolved) Twin Convergent-Divergent Nozzles
    var thruster_geo = build_starfighter_thrusters();
    var thruster_mat = d3.basic_material(0.0, 0.95, 1.0);
    thruster_mat.cull_mode = d3.CullMode.None;
    var thruster_mesh = d3.Mesh(thruster_geo, thruster_mat, "StarfighterThrusters");
    scene.add(thruster_mesh);

    // ── Procedural Asteroid Field (d3.asteroid) ────────────────────────────
    var rock1_geo = d3.asteroid(1.15, 0.35, 10, 8, 101);
    var rock2_geo = d3.asteroid(0.85, 0.40, 8, 6, 202);
    var rock3_geo = d3.asteroid(1.45, 0.28, 12, 8, 303);
    var rock_mat  = d3.lambert_material(0.62, 0.58, 0.52);

    var rock1 = d3.Mesh(rock1_geo, rock_mat, "AsteroidAlpha");
    rock1.set_position(-3.6, 1.8, -2.2);
    scene.add(rock1);

    var rock2 = d3.Mesh(rock2_geo, rock_mat, "AsteroidBeta");
    rock2.set_position(4.2, -1.6, -2.8);
    scene.add(rock2);

    var rock3 = d3.Mesh(rock3_geo, rock_mat, "AsteroidGamma");
    rock3.set_position(2.8, 2.4, -4.5);
    scene.add(rock3);

    // ── Procedural Celestial Moon (d3.icosphere) ───────────────────────────
    var moon_geo = d3.icosphere(2.2, 1);
    var moon_mat = d3.phong_material(0.72, 0.75, 0.82, 32.0);
    moon_mat.specular = 0.4;
    var moon = d3.Mesh(moon_geo, moon_mat, "CelestialMoon");
    moon.set_position(6.2, 3.8, -8.0);
    scene.add(moon);

    // ── Procedural Planetary Canyon (d3.terrain) ──────────────────────────
    var canyon_geo = d3.terrain(36.0, 36.0, 10, 10, 2.8, 77);
    var canyon_mat = d3.lambert_material(0.85, 0.85, 0.85);
    var canyon = d3.Mesh(canyon_geo, canyon_mat, "PlanetaryCanyon");
    canyon.set_position(-1.2, -5.4, -2.0);
    scene.add(canyon);

    // ── 3D Camera & Renderer ───────────────────────────────────────────────
    var camera = d3.perspective_camera(50.0, 1000.0 / 700.0, 0.1, 100.0);
    camera.set_position(-1.2, 1.6, 6.8);
    camera.look_at(-1.2, 0.0, 0.0);

    var renderer = d3.Renderer3D(1000, 700);

    var auto_rotate: bool = true;
    var wireframe_mode: bool = false;
    var show_terrain: bool = true;
    var show_asteroids: bool = true;
    var show_moon: bool = true;
    var terrain_alt: float = -5.4;
    var ship_yaw: float = 0.55;
    var ship_pitch: float = 0.28;
    var ship_roll: float = -0.05;
    var cam_distance: float = 6.8;
    var last_cam_distance: float = 6.8;
    var sun_angle: float = 0.85;
    var thruster_glow: float = 1.0;
    var livery_id: int = 0; // 0 = Ghost, 1 = Crimson, 2 = Void, 3 = Viper Gold
    var orbit_speed: float = 1.0;
    var last_w: int = 1000;
    var last_h: int = 700;
    var anim_tick: int = 0;

    print("Running 3D render loop...");

    while (app.is_running) {
        app.begin_frame();
        anim_tick = anim_tick + 1;

        var sw = app.width as float;
        var sh = app.height as float;
        if (app.width != last_w or app.height != last_h) {
            renderer.set_size(app.width, app.height);
            camera.aspect = sw / sh;
            camera.update_projection_matrix();
            last_w = app.width;
            last_h = app.height;
        }

        // ── Direct 3D Viewport Mouse Drag Rotation (Arcball) ────────────────
        if (app.input.is_mouse_down(0) and app.input.mouse_x > 330.0) {
            auto_rotate = false;
            var m_delta = app.input.mouse_delta();
            ship_yaw = ship_yaw + m_delta.x * 0.012;
            ship_pitch = ship_pitch + m_delta.y * 0.012;
            if (ship_pitch > 1.55) { ship_pitch = 1.55; }
            if (ship_pitch < -1.55) { ship_pitch = -1.55; }
        }

        // ── Keyboard Shortcuts ──────────────────────────────────────────────
        if (app.input.is_key_down(game.KEY_LEFT) or app.input.is_key_down(game.KEY_A)) {
            ship_yaw = ship_yaw - 0.035;
            auto_rotate = false;
        }
        if (app.input.is_key_down(game.KEY_RIGHT) or app.input.is_key_down(game.KEY_D)) {
            ship_yaw = ship_yaw + 0.035;
            auto_rotate = false;
        }
        if (app.input.is_key_down(game.KEY_UP) or app.input.is_key_down(game.KEY_W)) {
            ship_pitch = ship_pitch - 0.025;
            auto_rotate = false;
        }
        if (app.input.is_key_down(game.KEY_DOWN) or app.input.is_key_down(game.KEY_S)) {
            ship_pitch = ship_pitch + 0.025;
            auto_rotate = false;
        }
        if (app.input.is_key_down(game.KEY_Q)) {
            ship_roll = ship_roll - 0.035;
            auto_rotate = false;
        }
        if (app.input.is_key_down(game.KEY_E)) {
            ship_roll = ship_roll + 0.035;
            auto_rotate = false;
        }
        if (app.input.is_key_pressed(game.KEY_SPACE)) {
            auto_rotate = not auto_rotate;
        }

        // Livery hotkeys
        if (app.input.is_key_down(game.KEY_1)) {
            livery_id = 0;
            hull_mat.set_color(0.88, 0.92, 0.98);
            canopy_mat.set_color(0.10, 0.85, 0.98);
            trim_mat.set_color(0.20, 0.22, 0.28);
            thruster_mat.set_color(0.0, 0.95 * thruster_glow, 1.0 * thruster_glow);
        }
        if (app.input.is_key_down(game.KEY_2)) {
            livery_id = 1;
            hull_mat.set_color(0.85, 0.12, 0.18);
            canopy_mat.set_color(0.98, 0.82, 0.15);
            trim_mat.set_color(0.14, 0.14, 0.18);
            thruster_mat.set_color(1.0 * thruster_glow, 0.45 * thruster_glow, 0.05);
        }
        if (app.input.is_key_down(game.KEY_3)) {
            livery_id = 2;
            hull_mat.set_color(0.18, 0.20, 0.24);
            canopy_mat.set_color(0.82, 0.22, 0.96);
            trim_mat.set_color(0.10, 0.10, 0.14);
            thruster_mat.set_color(0.95 * thruster_glow, 0.10 * thruster_glow, 1.0);
        }
        if (app.input.is_key_down(game.KEY_4)) {
            livery_id = 3;
            hull_mat.set_color(0.95, 0.78, 0.12);
            canopy_mat.set_color(0.15, 0.95, 0.55);
            trim_mat.set_color(0.16, 0.18, 0.22);
            thruster_mat.set_color(0.20 * thruster_glow, 0.85 * thruster_glow, 1.0);
        }
        if (app.input.is_key_down(game.KEY_R)) {
            ship_yaw = 0.55;
            ship_pitch = 0.28;
            ship_roll = -0.05;
            cam_distance = 6.8;
            sun_angle = 0.85;
            thruster_glow = 1.0;
            orbit_speed = 1.0;
            sun.direction_x = math.cos(0.85) * 0.8;
            sun.direction_z = math.sin(0.85) * 0.8;
            auto_rotate = true;
        }

        // Smooth Auto-Orbit Animation
        if (auto_rotate) {
            ship_yaw = ship_yaw + 0.014 * orbit_speed;
            ship_pitch = 0.25 + math.sin((anim_tick as float) * 0.02 * orbit_speed) * 0.12;
            ship_roll = math.cos((anim_tick as float) * 0.025 * orbit_speed) * 0.08;
        }

        // Tumble surrounding celestial asteroids
        rock1.rotation_x = rock1.rotation_x + 0.012;
        rock1.rotation_y = rock1.rotation_y + 0.018;
        rock2.rotation_y = rock2.rotation_y - 0.015;
        rock2.rotation_z = rock2.rotation_z + 0.020;
        rock3.rotation_x = rock3.rotation_x - 0.008;
        rock3.rotation_y = rock3.rotation_y + 0.010;

        // Slow axial rotation for icosphere moon and terrain drifting
        moon.rotation_y = moon.rotation_y + 0.003;
        canyon.rotation_y = canyon.rotation_y + 0.001;

        // Synchronize all starfighter subsystem orientations
        hull_mesh.set_rotation(ship_pitch, ship_yaw, ship_roll);
        canopy_mesh.set_rotation(ship_pitch, ship_yaw, ship_roll);
        trim_mesh.set_rotation(ship_pitch, ship_yaw, ship_roll);
        thruster_mesh.set_rotation(ship_pitch, ship_yaw, ship_roll);

        // Update Camera Position when Distance changes
        if (cam_distance != last_cam_distance or anim_tick == 1) {
            camera.set_position(-1.2, 1.6, cam_distance);
            camera.look_at(-1.2, 0.0, 0.0);
            last_cam_distance = cam_distance;
        }

        // ── Deep-Space Starfield Grid Background ───────────────────────────
        var g_i = 0;
        while (g_i < 16) {
            var gx = (g_i as float) * 65.0;
            gg.draw_rect_primitive(gx, 0.0, 1.0, sh, 0.08, 0.12, 0.20, 0.25);
            var gy = (g_i as float) * 45.0;
            gg.draw_rect_primitive(0.0, gy, sw, 1.0, 0.08, 0.12, 0.20, 0.25);
            g_i = g_i + 1;
        }

        // ── Render 3D Scene ─────────────────────────────────────────────────
        renderer.render(scene, camera, 0.0, 0.0, sw, sh);
        if (anim_tick == 1) {
            print("tick 1: rendered 3D scene");
        }

        // ── 2D Immediate-Mode GUI Studio Controls ───────────────────────────
        if (app.gui.begin_window("Valkyrie SF-9 Studio (std.d3)", 15.0, 15.0, 315.0, 670.0)) {
            app.gui.label("Aerospace Superiority Interceptor");
            app.gui.separator();

            auto_rotate = app.gui.toggle("Auto-Orbit Spin", auto_rotate);

            var new_wire = app.gui.toggle("Wireframe Mode", wireframe_mode);
            if (new_wire != wireframe_mode) {
                wireframe_mode = new_wire;
                hull_mat.wireframe = wireframe_mode;
                canopy_mat.wireframe = wireframe_mode;
                trim_mat.wireframe = wireframe_mode;
                thruster_mat.wireframe = wireframe_mode;
                rock_mat.wireframe = wireframe_mode;
                moon_mat.wireframe = wireframe_mode;
                canyon_mat.wireframe = wireframe_mode;
            }

            app.gui.separator();
            app.gui.label("Flight Attitude Controls:");

            var prev_yaw = ship_yaw;
            ship_yaw = app.gui.slider("Yaw", ship_yaw, -3.14, 3.14, 185.0);
            if (ship_yaw != prev_yaw) {
                auto_rotate = false;
            }

            var prev_pitch = ship_pitch;
            ship_pitch = app.gui.slider("Pitch", ship_pitch, -1.57, 1.57, 185.0);
            if (ship_pitch != prev_pitch) {
                auto_rotate = false;
            }

            var prev_roll = ship_roll;
            ship_roll = app.gui.slider("Roll", ship_roll, -3.14, 3.14, 185.0);
            if (ship_roll != prev_roll) {
                auto_rotate = false;
            }

            app.gui.separator();
            app.gui.label("Procedural Environment (std.d3):");

            var new_show_ter = app.gui.toggle("Planetary Canyon", show_terrain);
            if (new_show_ter != show_terrain) {
                show_terrain = new_show_ter;
                if (show_terrain) {
                    canyon.position_y = terrain_alt;
                } else {
                    canyon.position_y = -999.0;
                }
            }

            var prev_alt = terrain_alt;
            terrain_alt = app.gui.slider("Altitude", terrain_alt, -8.0, -3.0, 185.0);
            if (terrain_alt != prev_alt and show_terrain) {
                canyon.position_y = terrain_alt;
            }

            var new_show_ast = app.gui.toggle("Asteroid Field", show_asteroids);
            if (new_show_ast != show_asteroids) {
                show_asteroids = new_show_ast;
                if (show_asteroids) {
                    rock1.position_y = 1.8;
                    rock2.position_y = -1.6;
                    rock3.position_y = 2.4;
                } else {
                    rock1.position_y = -999.0;
                    rock2.position_y = -999.0;
                    rock3.position_y = -999.0;
                }
            }

            var new_show_moon = app.gui.toggle("Icosphere Moon", show_moon);
            if (new_show_moon != show_moon) {
                show_moon = new_show_moon;
                if (show_moon) {
                    moon.position_y = 3.8;
                } else {
                    moon.position_y = -999.0;
                }
            }

            app.gui.separator();
            app.gui.label("Optics & Illumination:");

            cam_distance = app.gui.slider("Zoom", cam_distance, 4.0, 14.0, 185.0);

            var prev_sun = sun_angle;
            sun_angle = app.gui.slider("Sun Orbit", sun_angle, 0.0, 6.28, 185.0);
            if (sun_angle != prev_sun) {
                sun.direction_x = math.cos(sun_angle) * 0.8;
                sun.direction_z = math.sin(sun_angle) * 0.8;
            }

            var prev_glow = thruster_glow;
            thruster_glow = app.gui.slider("Thrust", thruster_glow, 0.2, 2.5, 185.0);
            if (thruster_glow != prev_glow) {
                if (livery_id == 0) {
                    thruster_mat.set_color(0.0, 0.95 * thruster_glow, 1.0 * thruster_glow);
                } elif (livery_id == 1) {
                    thruster_mat.set_color(1.0 * thruster_glow, 0.45 * thruster_glow, 0.05);
                } elif (livery_id == 2) {
                    thruster_mat.set_color(0.95 * thruster_glow, 0.10 * thruster_glow, 1.0);
                } else {
                    thruster_mat.set_color(0.20 * thruster_glow, 0.85 * thruster_glow, 1.0);
                }
            }

            orbit_speed = app.gui.slider("Orbit Rate", orbit_speed, 0.0, 3.0, 185.0);

            app.gui.separator();
            app.gui.label("Fleet Livery Theme:");
            if (app.gui.button("Ghost (Titanium / Cyan)")) {
                livery_id = 0;
                hull_mat.set_color(0.88, 0.92, 0.98);
                canopy_mat.set_color(0.10, 0.85, 0.98);
                trim_mat.set_color(0.20, 0.22, 0.28);
                thruster_mat.set_color(0.0, 0.95 * thruster_glow, 1.0 * thruster_glow);
            }
            if (app.gui.button("Crimson Fury (Red / Gold)")) {
                livery_id = 1;
                hull_mat.set_color(0.85, 0.12, 0.18);
                canopy_mat.set_color(0.98, 0.82, 0.15);
                trim_mat.set_color(0.14, 0.14, 0.18);
                thruster_mat.set_color(1.0 * thruster_glow, 0.45 * thruster_glow, 0.05);
            }
            if (app.gui.button("Void Shadow (Stealth / Violet)")) {
                livery_id = 2;
                hull_mat.set_color(0.18, 0.20, 0.24);
                canopy_mat.set_color(0.82, 0.22, 0.96);
                trim_mat.set_color(0.10, 0.10, 0.14);
                thruster_mat.set_color(0.95 * thruster_glow, 0.10 * thruster_glow, 1.0);
            }
            if (app.gui.button("Viper Gold (Gold / Emerald)")) {
                livery_id = 3;
                hull_mat.set_color(0.95, 0.78, 0.12);
                canopy_mat.set_color(0.15, 0.95, 0.55);
                trim_mat.set_color(0.16, 0.18, 0.22);
                thruster_mat.set_color(0.20 * thruster_glow, 0.85 * thruster_glow, 1.0);
            }

            app.gui.separator();
            app.gui.label("Telemetry & Procedural Stats:");
            app.gui.label("Performance: {app.fps as int} FPS");
            var ship_polys = hull_geo.get_face_count() + canopy_geo.get_face_count() + trim_geo.get_face_count() + thruster_geo.get_face_count();
            var env_polys = rock1_geo.get_face_count() + rock2_geo.get_face_count() + rock3_geo.get_face_count() + moon_geo.get_face_count() + canyon_geo.get_face_count();
            var total_polys = ship_polys + env_polys;
            app.gui.label("Ship Polys: {ship_polys} | Env: {env_polys}");
            app.gui.label("Total Polys: {total_polys}");
            app.gui.label("Features: Extrude, Revolve, Terrain, Asteroids, Icosphere");

            if (app.gui.button("Reset Ship & Camera")) {
                ship_yaw = 0.55;
                ship_pitch = 0.28;
                ship_roll = -0.05;
                cam_distance = 6.8;
                sun_angle = 0.85;
                thruster_glow = 1.0;
                orbit_speed = 1.0;
                terrain_alt = -5.4;
                show_terrain = true;
                show_asteroids = true;
                show_moon = true;
                canyon.position_y = -5.4;
                rock1.position_y = 1.8;
                rock2.position_y = -1.6;
                rock3.position_y = 2.4;
                moon.position_y = 3.8;
                sun.direction_x = math.cos(0.85) * 0.8;
                sun.direction_z = math.sin(0.85) * 0.8;
                auto_rotate = true;
            }

            app.gui.end_window();
        }

        app.end_frame();

        if (anim_tick > 120 and app.input.is_key_down(game.KEY_ESCAPE)) {
            app.is_running = false;
        }
    }

    app.shutdown();
    print("Showcase terminated cleanly.");
    return 0;
}
