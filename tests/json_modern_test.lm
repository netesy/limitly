// Test std/json parsing, stringifying, and enum JSONType matching
import std.json as json;

fn test_json_primitives() {
    print("Testing JSON primitive types...");
    var null_val = json.make_null();
    assert(null_val.is_null(), "is_null should be true");
    assert(null_val.kind == json.JSONType.Null, "kind should be Null");
    assert(json.stringify(null_val) == "null", "null stringify");

    var bool_val = json.make_bool(true);
    assert(bool_val.is_bool(), "is_bool should be true");
    assert(bool_val.kind == json.JSONType.Bool, "kind should be Bool");
    assert(json.stringify(bool_val) == "true", "true stringify");

    var num_val = json.make_number(42);
    assert(num_val.is_number(), "is_number should be true");
    assert(num_val.kind == json.JSONType.Number, "kind should be Number");

    var str_val = json.make_string("hello world");
    assert(str_val.is_string(), "is_string should be true");
    assert(str_val.kind == json.JSONType.String, "kind should be String");
    assert(json.stringify(str_val) == "\"hello world\"", "string stringify");
}

fn test_json_parse_and_match() {
    print("Testing JSON parsing and match on kind...");
    var doc = json.parse("[1, 2, 3]")? else {
        assert(false, "Failed to parse json array");
        return;
    };

    assert(doc.is_array(), "parsed doc is an array");
    assert(doc.kind == json.JSONType.Array, "parsed doc kind is Array");

    match (doc.kind) {
        json.JSONType.Array => {
            assert(len(doc.list_val) == 3, "items len is 3");
            var first = doc.list_val[0] as json.JSONValue;
            assert(first != nil, "first element not nil");
            assert(first.num_val == 1, "first num_val is 1");
        },
        _ => {
            assert(false, "expected Array");
        }
    }
}

print("=== Running Modernized std/json Test Suite ===");
test_json_primitives();
test_json_parse_and_match();
print("=== All Modernized std/json Tests Passed ===");
