import std.search as search;

fn main(): int {
    var values: [any] = [1, 2, 2, 3, 4];
    if (search.linear_search(values, 3) != 3) { return 1; }
    if (search.binary_search(values, 4) != 4) { return 2; }
    if (search.lower_bound(values, 2) != 1) { return 3; }
    if (search.upper_bound(values, 2) != 3) { return 4; }
    var range = search.equal_range(values, 2);
    if (search.interpolation_search([1, 3, 5, 7], 5) != 2) { return 5; }
    return 0;
}
