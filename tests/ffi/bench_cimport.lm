// import "c:" direct-call overhead benchmark (AOT native Call vs dynamic ffi).
// Requires tests/native/cimport_fixture.{h,c} built as libcimport_fixture.dll.
import "c:tests/native/cimport_fixture.h" from "tests/native/libcimport_fixture.dll" as fx;
import std.ffi as ffi;

fn time_it(tag: str, start: float): nil {
    var ms = (clock() - start) * 1000.0;
    print(tag, " ", ms, " ms");
}

fn main() {
    var N: int = 2000000;
    var i = 0;

    // Direct c-import leaf: AOT emits a native `call fixture_add` with no
    // libffi/foreign_call trampoline, no wrapper scaffolding, no boxing.
    var a: int = 1;
    var t0 = clock();
    while (i < N) {
        a = fx.fixture_add(a, 1);
        i = i + 1;
    }
    time_it("cimport_leaf", t0);

    // Same C function via dynamic ffi.load + typed helper for comparison.
    // ffi.load resolves at runtime, so this always pays the trampoline cost.
    i = 0;
    var b: int = 1;
    unsafe {
        var h = ffi.library_load("./tests/native/libcimport_fixture.dll");
        if (h == 0) { print("ffi load failed"); return 1; }
        var fadd = ffi.library_get_symbol(h, "fixture_add");
        t0 = clock();
        while (i < N) {
            b = ffi.call_i64_2(fadd, b, 1);
            i = i + 1;
        }
        time_it("ffi_leaf_same_fn", t0);
        ffi.library_unload(h);
    }
    print("done a=", a, " b=", b);
}
