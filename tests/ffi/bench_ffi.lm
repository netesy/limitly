// FFI overhead benchmark: VM vs AOT vs pure Lymar vs native C.
// Workloads: scalar leaf calls, bulk buffer pass, C->Lymar callbacks.
import std.ffi as ffi;

pub fn bench_cb_fn(x: int): int {
    return x * 3 + 1;
}

fn time_it(tag: str, start: float): nil {
    var ms = (clock() - start) * 1000.0;
    print(tag, " ", ms, " ms");
}

fn main() {
    // ---------- pure Lymar equivalents ----------
    var N_SCALAR: int = 2000000;
    var x: int = 1;
    var t0 = clock();
    var i = 0;
    while (i < N_SCALAR) {
        x = x * 3 + 1;
        i = i + 1;
    }
    time_it("lymar_leaf", t0);

    var N_BUF: int = 100000;
    var reps: int = 20;
    var buf_list: [int] = [];
    var k = 0;
    while (k < N_BUF) { buf_list.append(k); k = k + 1; }
    var acc: int = 0;
    t0 = clock();
    var r = 0;
    while (r < reps) {
        var s = 0;
        iter (v in buf_list) { s = s + v; }
        acc = acc + s;
        r = r + 1;
    }
    time_it("lymar_sum", t0);

    var N_CB: int = 200000;
    t0 = clock();
    var cacc = 0;
    var j = 0;
    while (j < N_CB) {
        cacc = cacc + bench_cb_fn(j);
        j = j + 1;
    }
    time_it("lymar_map", t0);

    // ---------- FFI (raw library_load path; ffi.load() wrapper is broken
    // on this build — see audit) ----------
    unsafe {
        var h = ffi.library_load("./tests/ffi/bench_fixture.dll");
        if (h == 0) {
            print("ffi load failed");
            return 1;
        }
        var leaf = ffi.library_get_symbol(h, "bench_leaf_i64");
        var leaff = ffi.library_get_symbol(h, "bench_leaf_f64");
        var sumf = ffi.library_get_symbol(h, "bench_sum_i64");
        var mapf = ffi.library_get_symbol(h, "bench_map_i64");

        // scalar i64 leaf via typed helper
        t0 = clock();
        var fx: int = 7;
        var m = 0;
        while (m < N_SCALAR) {
            fx = ffi.call_i64_1(leaf, fx);
            m = m + 1;
        }
        time_it("ffi_leaf_i64", t0);

        // scalar f64 leaf via generic foreign_call
        t0 = clock();
        var fd: float = 1.5;
        var m2 = 0;
        while (m2 < N_SCALAR / 4) {
            fd = ffi.foreign_call(leaff, [fd], ffi.TYPE_F64, [ffi.TYPE_F64]) as float;
            m2 = m2 + 1;
        }
        time_it("ffi_leaf_f64_generic", t0);

        // buffer: fill raw i64 buffer once, then time sum calls
        var nbytes = N_BUF * 8;
        var raw: int = ffi.alloc(nbytes);
        var q = 0;
        while (q < N_BUF) {
            ffi.store_i64(ffi.ptr_add(raw, q * 8), q);
            q = q + 1;
        }
        var fsum: int = 0;
        t0 = clock();
        var rr = 0;
        while (rr < reps) {
            fsum = fsum + ffi.call_i64_2(sumf, raw, N_BUF);
            rr = rr + 1;
        }
        time_it("ffi_sum", t0);

        // callback: C calls back into Lymar per element
        var cbh = ffi.callback_create("bench_cb_fn", [ffi.TYPE_I64], ffi.TYPE_I64);
        var cbp = ffi.callback_ptr(cbh);
        t0 = clock();
        var maps = ffi.call_i64_2(mapf, cbp, N_CB);
        time_it("ffi_map_callback", t0);
        print("map result=", maps, " lymar acc=", cacc);
        ffi.callback_destroy(cbh);
        ffi.free(raw);
        ffi.library_unload(h);
    }
    print("done x=", x, " acc=", acc);
}
