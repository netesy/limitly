import std.string as string;

fn main() {
    var lower = string.to_lower("LYMAR");
    print("Lower:");
    print(lower);
    assert(lower == "lymar", "Lower failure");

    var upper = string.to_upper("lymar");
    print("Upper:");
    print(upper);
    assert(upper == "LYMAR", "Upper failure");
}

main();
