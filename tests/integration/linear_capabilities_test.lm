// Test Linear Parallel Capability Splitting and Safety
fn test_capabilities() {
    var data = [1, 2, 3, 4, 5, 6, 7, 8];
    parallel(cores=2) {
        iter (i in 0..8) {
            data[i] = data[i] + 10;
        }
    }
    assert(data[0] == 11, "data[0] incremented");
    assert(data[7] == 18, "data[7] incremented");
}

fn main() {
    test_capabilities();
    print("Linear parallel capabilities test PASSED");
}

main();
