// Cross-system integration test
fn main(): int {
    // 1. Parallel capabilities and workers
    var sum = 0;
    parallel(cores=2, on_error="stop") {
        var x = 10 + 20;
        sum = x;
    }
    assert(sum == 30, "Parallel block execution failed");

    // 2. Refinements & Contracts verification
    var val1: int = 100;
    assert(val1 > 0, "Contract condition failed");

    print("Cross-system integration tests passed!");
    return 0;
}
