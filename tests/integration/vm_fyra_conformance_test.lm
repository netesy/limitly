// Cross-Backend Conformance Test for VM/Fyra Parity
fn factorial(n: int): int {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

fn test_parity() {
    var res = factorial(5);
    assert(res == 120, "factorial(5) == 120");

    var list = [1, 2, 3, 4, 5];
    assert(len(list) == 5, "list length is 5");
}

fn main() {
    test_parity();
    print("VM/Fyra parity conformance test PASSED");
}

main();
