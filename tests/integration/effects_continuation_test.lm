// Test Internal Effect Handlers and Continuation Resumption
fn divide_fallible(a: int, b: int): int? {
    if (b == 0) {
        return err();
    }
    return ok(a / b);
}

fn test_effects() {
    var res1 = divide_fallible(10, 2);
    assert(res1? == 5, "ok(5) unwrapped");
}

fn main() {
    test_effects();
    print("Internal effect/continuation model test PASSED");
}

main();
