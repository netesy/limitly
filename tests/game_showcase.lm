// game_showcase.lm
// Interactive Showcase for std.game - Zero-DOM Immediate-Mode GUI Engine for Game Developers
// Demonstrates:
// - Real-time procedural IMGUI overlaid on a live 2D canvas game scene
// - Draggable floating windows (HUD, Telemetry, Theme Modder, System Logs)
// - Moddable style stack and instant theme switching (Cyberpunk, Dark, Light, Retro, Nord)
// - Complete widget suite:
//   * Push buttons, colored accent buttons
//   * Sliders (float & integer), numeric steppers
//   * Checkboxes, toggles, radio groups
//   * Dropdown combobox, color picker
//   * Live telemetry graphs (FPS line plot, Frame time histogram)
//   * Tab bars, collapsible tree nodes, scroll areas
//   * Modal popups and tooltips

import std.app as app;
import std.game as game;
import std.theme as theme;
import std.color as color;
import std.gg as gg;
import std.d3 as d3;
import std.math as math;

frame Asteroid {
    pub var x: float;
    pub var y: float;
    pub var vx: float;
    pub var vy: float;
    pub var size: float;
    pub var hp: int;

    pub init(x: float = 0.0, y: float = 0.0, vx: float = 0.0, vy: float = 0.0, size: float = 20.0, hp: int = 2) {
        self.x = x;
        self.y = y;
        self.vx = vx;
        self.vy = vy;
        self.size = size;
        self.hp = hp;
    }
}

frame Projectile {
    pub var x: float;
    pub var y: float;
    pub var vx: float;
    pub var vy: float;
    pub var kind: int;
    pub var life: int;

    pub init(x: float = 0.0, y: float = 0.0, vx: float = 0.0, vy: float = 0.0, kind: int = 0, life: int = 45) {
        self.x = x;
        self.y = y;
        self.vx = vx;
        self.vy = vy;
        self.kind = kind;
        self.life = life;
    }
}

fn main(): int {
    print(" === Launching Lymar Game IMGUI & Interactive Space Game === ");

    var cfg = game.Config(
        title = "Lymar Game Engine - IMGUI & Interactive Space Game",
        width = 800,
        height = 600,
        resizable = true
    );

    // Asteroid field (declared early: it sizes the mesh pool below).
    var asteroids: [Asteroid] = [
        Asteroid(360.0, 100.0, 0.7, 0.4, 22.0, 2),
        Asteroid(450.0, 160.0, -0.6, 0.5, 26.0, 3),
        Asteroid(380.0, 420.0, 0.5, -0.6, 18.0, 1),
        Asteroid(440.0, 480.0, -0.5, -0.4, 24.0, 2)
    ];

    // ── std.d3 Scene: ship, asteroids & projectiles ──────────────────────────
    // Built BEFORE g.setup() so the window only appears once every mesh,
    // material and buffer exists — otherwise the visible-but-empty window
    // shows a black framebuffer for the whole init + first shader compile.
    // World units are screen pixels on the Z=0 plane (x right, y down); an
    // orthographic camera maps them 1:1 onto the viewport.
    val cfgw = cfg.width as float;
    val cfgh = cfg.height as float;

    var scene = d3.Scene3D();
    // Initial clear; the per-frame sync below repaints it from the live
    // GUI theme so Theme Studio switches visibly change the backdrop.
    scene.background_r = 0.05;
    scene.background_g = 0.05;
    scene.background_b = 0.10;
    scene.background_a = 1.0;
    scene.add_light(d3.ambient_light(1.0, 1.0, 1.0, 0.55));
    scene.add_light(d3.directional_light(0.0, 0.0, 1.0, 1.0, 1.0, 1.0, 0.9));

    var cam = d3.orthographic_camera(0.0, cfgw, 0.0, cfgh, 0.1, 100.0);
    cam.set_position(0.0, 0.0, 10.0);
    var renderer3d = d3.Renderer3D(cfg.width, cfg.height);
    renderer3d.clear_color = true;
    var cam_w = cfg.width;
    var cam_h = cfg.height;

    // Shared geometries: _ensure_gpu_buffers caches the GPU buffers on the
    // Geometry object, so one sphere/box backs every instance — building a
    // geometry per mesh would cost ~55 Lymar-side vertex loops before the
    // first present (visible as a black startup gap).
    val ast_geo = d3.sphere(1.0, 10, 8);
    val bolt_geo = d3.sphere(0.6, 8, 6);

    // Ship: invisible root carries position + heading; parts are children so
    // the whole craft rotates as one rigid body. Nose points toward -Y
    // (screen up) at rotation_z = 0.
    val ship_root_geo = d3.plane(0.01, 0.01);
    val hull_geo = d3.box(12.0, 26.0, 3.0);
    val nose_geo = d3.box(6.0, 10.0, 3.0);
    val wing_geo = d3.box(34.0, 9.0, 2.0);
    val cockpit_geo = d3.box(5.0, 7.0, 4.5);
    val thruster_geo = d3.box(7.0, 8.0, 3.0);
    val bubble_geo = d3.sphere(1.0, 12, 8);

    var ship_root = d3.Mesh(ship_root_geo, d3.basic_material(0.0, 0.0, 0.0, 0.0), "ship_root");
    ship_root.visible = false;
    scene.add(ship_root);

    // Material colors are re-synced from ship_color every frame; the
    // literals below are just the pre-loop defaults.
    var hull_mat = d3.basic_material(0.0, 0.94, 1.0, 1.0);
    var nose_mat = d3.basic_material(0.0, 0.75, 0.8, 1.0);
    var wing_mat = d3.basic_material(0.0, 0.61, 0.65, 0.95);
    var cockpit_mat = d3.basic_material(0.0, 0.95, 1.0, 0.95);
    var thruster_mat = d3.basic_material(1.0, 0.45, 0.1, 0.9);
    var bubble_mat = d3.basic_material(0.0, 0.95, 1.0, 0.22);
    bubble_mat.cull_mode = d3.CullMode.None;

    var hull = d3.Mesh(hull_geo, hull_mat, "hull");
    hull.attach_to(ship_root);
    scene.add(hull);
    var nose = d3.Mesh(nose_geo, nose_mat, "nose");
    nose.set_position(0.0, -17.0, 0.0);
    nose.attach_to(ship_root);
    scene.add(nose);
    var wings = d3.Mesh(wing_geo, wing_mat, "wings");
    wings.set_position(0.0, 9.0, 0.0);
    wings.attach_to(ship_root);
    scene.add(wings);
    var cockpit = d3.Mesh(cockpit_geo, cockpit_mat, "cockpit");
    cockpit.set_position(0.0, -4.0, 2.2);
    cockpit.attach_to(ship_root);
    scene.add(cockpit);
    var thruster = d3.Mesh(thruster_geo, thruster_mat, "thruster");
    thruster.set_position(0.0, 16.0, 0.0);
    thruster.visible = false;
    thruster.attach_to(ship_root);
    scene.add(thruster);
    var bubble = d3.Mesh(bubble_geo, bubble_mat, "bubble");
    bubble.set_position(0.0, 0.0, -1.0);
    bubble.set_scale(32.0, 32.0, 3.0);
    bubble.visible = false;
    bubble.attach_to(ship_root);
    scene.add(bubble);

    // One reusable sphere mesh per asteroid slot.
    var ast_meshes: [d3.Mesh] = [];
    iter (a in asteroids) {
        var am = d3.Mesh(ast_geo, d3.lambert_material(0.42, 0.45, 0.55), "asteroid");
        scene.add(am);
        ast_meshes.append(am);
    }

    // Fixed pool of projectile bolts; slots toggle visible instead of
    // allocating meshes per shot.
    var proj_pool: [d3.Mesh] = [];
    iter (i in 0..48) {
        var bolt = d3.Mesh(bolt_geo, d3.basic_material(0.0, 0.0, 0.0, 1.0), "bolt");
        bolt.visible = false;
        scene.add(bolt);
        proj_pool.append(bolt);
    }

    var g = game.Game(cfg);
    var a = app.App(cfg.title, cfg.width, cfg.height);
    a.open();

    g.gui.set_theme(theme.cyberpunk_theme());

    // ── Game State ─────────────────────────────────────────────────────────────
    var ship_x = 400.0;
    var ship_y = 280.0;
    var ship_vx = 0.0;
    var ship_vy = 0.0;
    var ship_angle = 0.0;
    var ship_speed = 3.5;
    var ship_color = color.hex(0x00f0ff, 1.0);
    var fire_cooldown = 0;

    var health = 85.0;
    var shield = 65.0;
    var energy = 92.0;
    var _score = 1420;
    var level = 4;

    var god_mode = false;
    var warp_drive = true;

    var weapons = ["Plasma Cannon", "Gauss Railgun", "Photon Torpedo", "Disruptor Beam"];
    var selected_weapon = 0;

    var projectiles: [Projectile] = [];

    var fps_data = [60.0, 59.5, 60.2, 58.8, 61.1, 60.0, 59.9, 60.5, 60.1, 60.0];
    var frame_times = [16.6, 16.8, 16.4, 17.0, 16.3, 16.6, 16.7, 16.5, 16.6, 16.6];

    var active_theme_idx = 0; // 0 = Cyberpunk, 1 = Dark, 2 = Light, 3 = Retro, 4 = Nord
    var hud_tab_idx = 0;      // 0 = Systems, 1 = Display & Themes
    var ops_tab_idx = 0;      // 0 = Telemetry, 1 = Diagnostics Log

    var log_messages = [
        "[00:00.01] Engine core initialized (Sokol GLES / Metal / D3D11)",
        "[00:00.04] TrueType font rasterizer loaded via stb_truetype",
        "[00:00.07] Audio mixer initialized (44.1kHz, 32 channels)",
        "[00:00.12] Starship entity spawned in central orbit",
        "[00:00.18] Sector radar operational: 12 stellar bodies detected",
        "[00:00.25] Ready for pilot input - Use [W,A,S,D] & [SPACE]"
    ];

    var sim_tick = 0;


    print("Running interactive game showcase loop...");

    while (a.is_running()) {
        a.pump();
        g.poll();
        sim_tick = sim_tick + 1;

        var sw = g.width as float;
        var sh = g.height as float;

        // ── Responsive Docked Panel Coordinates ─────────────────────────────
        var hud_w = 260.0;
        var hud_h = sh - 32.0;
        if (hud_h < 480.0) { hud_h = 480.0; }

        var ops_w = 270.0;
        var ops_h = sh - 32.0;
        if (ops_h < 480.0) { ops_h = 480.0; }
        var ops_x = sw - ops_w - 16.0;
        if (ops_x < hud_w + 32.0) { ops_x = hud_w + 32.0; }

        // ── Interactive Flight Controls & Physics ──────────────────────────────
        if (g.input.is_key_down(game.KEY_A) or g.input.is_key_down(game.KEY_LEFT)) {
            ship_angle = ship_angle - 0.055;
        }
        if (g.input.is_key_down(game.KEY_D) or g.input.is_key_down(game.KEY_RIGHT)) {
            ship_angle = ship_angle + 0.055;
        }

        var is_thrusting = false;
        var thrust = (ship_speed * 0.075) as float;
        if (thrust < 0.2) { thrust = 0.2; }
        if (warp_drive) { thrust = thrust * 1.75; }

        if (g.input.is_key_down(game.KEY_W) or g.input.is_key_down(game.KEY_UP)) {
            is_thrusting = true;
            ship_vx = ship_vx + math.sin(ship_angle) * thrust;
            ship_vy = ship_vy - math.cos(ship_angle) * thrust;
        }
        if (g.input.is_key_down(game.KEY_S) or g.input.is_key_down(game.KEY_DOWN)) {
            ship_vx = ship_vx * 0.88;
            ship_vy = ship_vy * 0.88;
        }

        ship_vx = ship_vx * 0.96;
        ship_vy = ship_vy * 0.96;
        ship_x = ship_x + ship_vx;
        ship_y = ship_y + ship_vy;

        // Wrap around viewport boundaries
        if (ship_x < 20.0) { ship_x = sw - 20.0; }
        if (ship_x > sw - 20.0) { ship_x = 20.0; }
        if (ship_y < 20.0) { ship_y = sh - 20.0; }
        if (ship_y > sh - 20.0) { ship_y = 20.0; }

        if (fire_cooldown > 0) {
            fire_cooldown = fire_cooldown - 1;
        }

        // Fire projectile via Space or clicking space outside windows
        var want_fire = g.input.is_key_pressed(game.KEY_SPACE);
        if (g.input.is_mouse_pressed(0)) {
            var mx = g.input.mouse_x;
            var my = g.input.mouse_y;
            var over_hud = (mx >= 16.0 and mx <= 16.0 + hud_w and my >= 16.0 and my <= 16.0 + hud_h);
            var over_ops = (mx >= ops_x and mx <= ops_x + ops_w and my >= 16.0 and my <= 16.0 + ops_h);
            if (not over_hud and not over_ops) {
                want_fire = true;
            }
        }

        if (want_fire and fire_cooldown == 0) {
            fire_cooldown = 9;
            var p_speed = 10.0;
            if (selected_weapon == 1) { p_speed = 17.0; }
            elif (selected_weapon == 2) { p_speed = 7.5; }
            elif (selected_weapon == 3) { p_speed = 22.0; }

            var spawn_x = ship_x + math.sin(ship_angle) * 26.0;
            var spawn_y = ship_y - math.cos(ship_angle) * 26.0;
            var p_vx = math.sin(ship_angle) * p_speed + ship_vx * 0.4;
            var p_vy = -math.cos(ship_angle) * p_speed + ship_vy * 0.4;
            projectiles.append(Projectile(spawn_x, spawn_y, p_vx, p_vy, selected_weapon, 45));
        }

        // ── Asteroids Simulation & Collision (In-Place, Zero-Allocation) ──────
        var ai = 0;
        var ast_count = len(asteroids);
        while (ai < ast_count) {
            var ast = asteroids[ai];
            ast.x = ast.x + ast.vx;
            ast.y = ast.y + ast.vy;

            if (ast.x < 0.0) { ast.x = sw; }
            if (ast.x > sw) { ast.x = 0.0; }
            if (ast.y < 0.0) { ast.y = sh; }
            if (ast.y > sh) { ast.y = 0.0; }

            // Projectile collision check using squared distances (no sqrt)
            var hit_r = ast.size * 0.5 + 6.0;
            var hit_r_sq = hit_r * hit_r;
            var pi = 0;
            var proj_count = len(projectiles);
            while (pi < proj_count) {
                var proj = projectiles[pi];
                if (proj.life > 0) {
                    var pdx = proj.x - ast.x;
                    var pdy = proj.y - ast.y;
                    if (pdx * pdx + pdy * pdy < hit_r_sq) {
                        ast.hp = ast.hp - 1;
                        proj.life = 0;
                        _score = _score + 50 * level;
                        break;
                    }
                }
                pi = pi + 1;
            }

            // Ship collision check using squared distances
            var s_hit_r = ast.size * 0.5 + 18.0;
            var s_hit_r_sq = s_hit_r * s_hit_r;
            var sdx = ship_x - ast.x;
            var sdy = ship_y - ast.y;
            if (sdx * sdx + sdy * sdy < s_hit_r_sq) {
                if (god_mode) {
                    var sdist = math.sqrt(sdx * sdx + sdy * sdy);
                    if (sdist < 0.001) { sdist = 1.0; }
                    var nx = -sdx / sdist;
                    var ny = -sdy / sdist;
                    ast.vx = nx * 3.5;
                    ast.vy = ny * 3.5;
                    ast.x = ship_x + nx * (s_hit_r + 2.0);
                    ast.y = ship_y + ny * (s_hit_r + 2.0);
                } else {
                    if (shield > 10.0) {
                        shield = shield - 15.0;
                        if (shield < 0.0) { shield = 0.0; }
                    } else {
                        health = health - 20.0;
                        if (health < 0.0) { health = 0.0; }
                    }
                    ast.hp = 0;
                    log_messages.append("[Impact] Hull collision with space debris!");
                }
            }

            // Respawn asteroid if destroyed
            if (ast.hp <= 0) {
                _score = _score + 100 * level;
                ast.hp = 2;
                ast.size = 20.0 + ((sim_tick * 7) % 12) as float;
                ast.x = 300.0 + ((sim_tick * 23) % 200) as float;
                ast.y = 40.0;
            }

            // Update asteroid mesh (sphere scaled to the rock's diameter)
            var rock_r = 0.42; var rock_g = 0.45; var rock_b = 0.55;
            if (ast.hp == 1) { rock_r = 0.70; rock_g = 0.30; rock_b = 0.35; }
            if (ai < len(ast_meshes)) {
                var amesh = ast_meshes[ai];
                amesh.set_position(ast.x, ast.y, 0.0);
                var ascale = ast.size * 0.5;
                amesh.set_scale(ascale, ascale, ascale);
                amesh.material.set_color(rock_r, rock_g, rock_b, 0.95);
            }
            ai = ai + 1;
        }

        // ── Projectiles Update & Render ───────────────────────────────────────
        var active_projectiles: [Projectile] = [];
        var p_idx = 0;
        var total_projs = len(projectiles);
        var pvis = 0;
        while (p_idx < total_projs) {
            var p = projectiles[p_idx];
            p.life = p.life - 1;
            if (p.life > 0) {
                p.x = p.x + p.vx;
                p.y = p.y + p.vy;
                active_projectiles.append(p);

                // Drive the next pooled bolt mesh for this projectile.
                if (pvis < len(proj_pool)) {
                    var bolt = proj_pool[pvis];
                    bolt.visible = true;
                    bolt.set_position(p.x, p.y, 0.0);
                    var br = 0.0; var bg = 0.95; var bb = 1.0; var bs = 6.0;
                    if (p.kind == 1) { br = 0.2; bg = 1.0; bb = 0.4; bs = 5.0; }
                    elif (p.kind == 2) { br = 1.0; bg = 0.45; bb = 0.0; bs = 8.0; }
                    elif (p.kind == 3) { br = 1.0; bg = 0.0; bb = 0.65; bs = 5.0; }
                    bolt.material.set_color(br, bg, bb, 1.0);
                    bolt.set_scale(bs, bs, bs);
                    pvis = pvis + 1;
                }
            }
            p_idx = p_idx + 1;
        }
        projectiles = active_projectiles;
        // Hide pooled bolts beyond the live projectile count.
        var p_hide = pvis;
        while (p_hide < len(proj_pool)) {
            proj_pool[p_hide].visible = false;
            p_hide = p_hide + 1;
        }

        // ── Ship Transform & Material Update (std.d3) ──────────────────────────
        ship_root.set_position(ship_x, ship_y, 0.0);
        ship_root.set_rotation(0.0, 0.0, ship_angle);

        hull_mat.set_color(ship_color.r, ship_color.g, ship_color.b, ship_color.a);
        nose_mat.set_color(ship_color.r * 0.8, ship_color.g * 0.8, ship_color.b * 0.8, ship_color.a);
        wing_mat.set_color(ship_color.r * 0.65, ship_color.g * 0.65, ship_color.b * 0.65, 0.95);

        // Thruster flame flicker
        thruster.visible = is_thrusting or warp_drive;
        if (thruster.visible) {
            var fl = 24.0 + ((sim_tick * 4) % 9) as float;
            thruster.set_scale(1.0, fl / 10.0, 1.0);
        }

        // Forcefield bubble
        bubble.visible = god_mode;

        // Keep the 3D scene clear in sync with the active theme background
        // so theme switches repaint the window backdrop immediately.
        scene.background_r = g.gui.theme.bg_window.r;
        scene.background_g = g.gui.theme.bg_window.g;
        scene.background_b = g.gui.theme.bg_window.b;
        scene.background_a = g.gui.theme.bg_window.a;

        // ── Render 3D Scene, then 2D chrome overlays ───────────────────────────
        a.begin_pass();
        g.imgui_begin();
        if (g.width != cam_w or g.height != cam_h) {
            cam_w = g.width;
            cam_h = g.height;
            cam.ortho_left = 0.0;
            cam.ortho_right = cam_w as float;
            cam.ortho_top = 0.0;
            cam.ortho_bottom = cam_h as float;
            cam.update_projection_matrix();
            renderer3d.set_size(cam_w, cam_h);
        }
        renderer3d.render(scene, cam, 0.0, 0.0, g.width as float, g.height as float);

        // Ambient space grid drawn over the 3D scene (2D overlay)
        var gx = 32.0;
        while (gx < sw) {
            gg.draw_rect_primitive(gx, 0.0, 1.0, sh, 0.12, 0.15, 0.25, 0.25);
            gx = gx + 96.0;
        }
        var gy = 32.0;
        while (gy < sh) {
            gg.draw_rect_primitive(0.0, gy, sw, 1.0, 0.12, 0.15, 0.25, 0.25);
            gy = gy + 96.0;
        }

        // Space Status Banner
        gg.draw_text("SCORE: {_score}", sw * 0.5 - 45.0, 14.0, 1.0, 0.9, 0.2, 1.0, 1);
        gg.draw_text("[W,A,S,D] Fly | [SPACE/Click] Fire", sw * 0.5 - 110.0, 30.0, 0.55, 0.65, 0.8, 0.85, 1);

        // ── Window 1: Starship Command HUD (Docked Left) ──────────────────────
        if (g.gui.begin_window("Starship Command HUD", 16.0, 16.0, hud_w, hud_h)) {
            g.gui.begin_tab_bar("hud_tabs");
            if (g.gui.tab_item("Vessel HUD", hud_tab_idx == 0)) {
                hud_tab_idx = 0;
            }
            if (g.gui.tab_item("Theme Studio", hud_tab_idx == 1)) {
                hud_tab_idx = 1;
            }
            g.gui.end_tab_bar();

            var bar_w = hud_w - 24.0;

            if (hud_tab_idx == 0) {
                g.gui.label("VESSEL STATUS");
                g.gui.label("Hull Integrity");
                g.gui.progress_bar(health / 100.0, bar_w, 14.0, "{health as int}%");

                g.gui.label("Energy Shields");
                g.gui.progress_bar(shield / 100.0, bar_w, 14.0, "{shield as int}%");

                g.gui.label("Reactor Output");
                g.gui.progress_bar(energy / 100.0, bar_w, 14.0, "{energy as int}%");

                g.gui.separator();
                g.gui.label("ARMAMENT & PROPULSION");
                selected_weapon = g.gui.combo_box("Active Weapon", weapons, selected_weapon);
                ship_speed = g.gui.slider("Sublight Speed", ship_speed, 0.0, 10.0);
                level = g.gui.stepper_int("Pilot Rank", level, 1, 1, 50);

                g.gui.separator();
                g.gui.label("SYSTEM OVERRIDES");
                god_mode = g.gui.checkbox("Invulnerability Field", god_mode);
                warp_drive = g.gui.toggle("Warp Drive", warp_drive);

                g.gui.separator();
                if (g.gui.button_colored("ENGAGE HYPERDRIVE", color.hex(0xff0055, 1.0), bar_w, 28.0)) {
                    log_messages.append("[Hyperdrive] Micro-jump sequence initiated!");
                }
            } else {
                g.gui.label("PRESET UI THEMES");
                if (g.gui.radio_button("Cyberpunk Neon", active_theme_idx == 0)) {
                    active_theme_idx = 0;
                    g.gui.set_theme(theme.cyberpunk_theme());
                }
                if (g.gui.radio_button("Dark Obsidian", active_theme_idx == 1)) {
                    active_theme_idx = 1;
                    g.gui.set_theme(theme.dark_theme());
                }
                if (g.gui.radio_button("Clean Studio (Light)", active_theme_idx == 2)) {
                    active_theme_idx = 2;
                    g.gui.set_theme(theme.light_theme());
                }
                if (g.gui.radio_button("Classic 90s Retro", active_theme_idx == 3)) {
                    active_theme_idx = 3;
                    g.gui.set_theme(theme.retro_theme());
                }
                if (g.gui.radio_button("Nord Frost", active_theme_idx == 4)) {
                    active_theme_idx = 4;
                    g.gui.set_theme(theme.nord_theme());
                }

                g.gui.separator();
                ship_color = g.gui.color_picker("Hull Paint", ship_color);

                g.gui.separator();
                g.gui.label("DISPLAY RESOLUTION");
                var rbtn_w = (bar_w - 8.0) * 0.5;
                if (g.gui.button("800 x 600", rbtn_w, 24.0)) {
                    g.set_resolution(800, 600);
                }
                g.gui.same_line();
                if (g.gui.button("1024 x 720", rbtn_w, 24.0)) {
                    g.set_resolution(1024, 720);
                }
                if (g.gui.button("1280 x 720", rbtn_w, 24.0)) {
                    g.set_resolution(1280, 720);
                }
                g.gui.same_line();
                if (g.gui.button("1920 x 1080", rbtn_w, 24.0)) {
                    g.set_resolution(1920, 1080);
                }
            }

            g.gui.end_window();
        }

        // ── Window 2: Operations & Diagnostics (Docked Right) ─────────────────
        if (g.gui.begin_window("Flight Operations", ops_x, 16.0, ops_w, ops_h)) {
            g.gui.begin_tab_bar("ops_tabs");
            if (g.gui.tab_item("Telemetry", ops_tab_idx == 0)) {
                ops_tab_idx = 0;
            }
            if (g.gui.tab_item("Flight Log", ops_tab_idx == 1)) {
                ops_tab_idx = 1;
            }
            g.gui.end_tab_bar();

            var plot_w = ops_w - 24.0;

            if (ops_tab_idx == 0) {
                g.gui.label("REAL-TIME METRICS");
                g.gui.plot_lines("FPS", fps_data, 45.0, 75.0, plot_w, 42.0);
                g.gui.plot_histogram("Frame Latency (ms)", frame_times, 0.0, 30.0, plot_w, 36.0);

                g.gui.separator();
                g.gui.label("SCENE HIERARCHY");
                if (g.gui.tree_node("Sector Entities (12)")) {
                    g.gui.label("├─ PlayerCruiser [Active]");
                    g.gui.label("├─ Waypoint Alpha");
                    g.gui.label("├─ Asteroid Belt (4 bodies)");
                    g.gui.label("└─ Space Station Outpost 7");
                    g.gui.tree_pop();
                }

                if (g.gui.tree_node("Lighting & Shaders")) {
                    g.gui.label("├─ Ambient Pass: D3D11 / Metal");
                    g.gui.label("├─ Subpixel TrueType Renderer");
                    g.gui.label("└─ HDR Bloom: Active");
                    g.gui.tree_pop();
                }

                g.gui.separator();
                if (g.gui.button("Trigger Emergency Alert", plot_w, 26.0)) {
                    g.gui.open_popup("AlertModal");
                }
            } else {
                g.gui.label("SYSTEM EVENT LOG");
                var log_count = len(log_messages);
                var content_h = (log_count as float) * 18.0;
                var scroll_h = ops_h - 100.0;
                if (scroll_h < 120.0) { scroll_h = 120.0; }
                g.gui.begin_scroll_area(plot_w, scroll_h, content_h);
                var l_idx = 0;
                while (l_idx < log_count) {
                    g.gui.label(log_messages[l_idx]);
                    l_idx = l_idx + 1;
                }
                g.gui.end_scroll_area();
            }

            g.gui.end_window();
        }

        // ── Modal Popup: Emergency Alert ───────────────────────────────────────
        var popup_w = 280.0;
        var popup_h = 150.0;
        var popup_x = (sw - popup_w) * 0.5;
        var popup_y = (sh - popup_h) * 0.5;
        if (g.gui.begin_popup("AlertModal", popup_x, popup_y, popup_w, popup_h)) {
            g.gui.label("[WARN] SYSTEM ANOMALY DETECTED");
            g.gui.label("Core temperature rising rapidly.");
            g.gui.label("Initiate thermal purge?");
            g.gui.spacing(8.0);

            if (g.gui.button_colored("PURGE CORE", color.hex(0xee2222, 1.0), 120.0, 26.0)) {
                log_messages.append("[Purge] Core flushed! Temp stabilized.");
                g.gui.close_popup("AlertModal");
            }
            g.gui.same_line();
            if (g.gui.button("Cancel", 120.0, 26.0)) {
                g.gui.close_popup("AlertModal");
            }
            g.gui.end_popup();
        }

        g.imgui_end();
        a.end_pass();
    }

    a.close();
    return 0;
}
