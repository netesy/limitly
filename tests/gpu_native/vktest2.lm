import std.native.vulkan as vk;
import std.ffi as ffi;
var SPV_WORDS: [int] = [119734787,65536,0,64,0,131089,1,196622,0,1,327695,5,30,1852399981,0,393232,30,17,1,1,1,262215,17,34,0,262215,17,33,0,196679,11,2,327752,11,0,35,0,327752,11,0,6,4,262215,16,11,28,131091,1,196641,2,1,262165,3,32,0,262187,3,4,0,262187,3,5,1,262187,3,6,40,262187,3,7,42,196637,10,3,196638,11,10,262176,12,12,11,262176,13,12,3,262167,14,3,3,262176,15,1,14,262203,15,16,1,262203,12,17,12,327734,1,30,0,2,131320,31,262205,14,40,16,327761,3,41,40,0,393281,13,43,17,0,41,196670,43,7,327808,3,42,41,5,393281,13,46,17,0,42,262205,3,44,43,327808,3,45,44,6,196670,46,45,65789,65592];
fn main() {
    var init = vk.gpu_init();
    if (init == 0) { return 0; }
    unsafe {
        var spv = ffi.alloc(151 * 4);
        var i = 0;
        while (i < 151) {
            ffi.store_u32(ffi.ptr_add(spv, i * 4), SPV_WORDS[i]);
            i = i + 1;
        }
        var shader = vk.gpu_shader_create_spv(spv, 151 * 4);
        if (shader == 0) { return 0; }
        var pipe = vk.gpu_pipeline_create(shader, 1);
        print("pipe=" + (pipe as str));
    }
}
