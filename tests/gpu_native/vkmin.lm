import std.native.gpu_vulkan as vk;
import std.ffi as ffi;
var SPV_WORDS: [int] = [119734787,65536,0,4,0,131089,1,196622,0,1,327695,5,1,1852399981,0,393232,1,17,1,1,1,131091,2,196628,3,2,262198,2,1,3,65784,65789,65592];
fn main() {
    var init = vk.gpu_init();
    print("init=" + (init as str));
    if (init == 0) { return 0; }
    var buf = vk.gpu_buffer_create(256);
    print("buf=" + (buf as str));
    if (buf == 0) { return 0; }
    unsafe {
        var spv = ffi.alloc(33 * 4);
        var i = 0;
        while (i < 33) {
            ffi.store_u32(ffi.ptr_add(spv, i * 4), SPV_WORDS[i]);
            i = i + 1;
        }
        var shader = vk.gpu_shader_create_spv(spv, 33 * 4);
        print("shader=" + (shader as str));
        if (shader == 0) { return 0; }
        var pipe = vk.gpu_pipeline_create(shader, 1);
        print("pipe=" + (pipe as str));
        if (pipe == 0) { return 0; }
        var bufs: [int] = [buf];
        var disp = vk.gpu_dispatch(pipe, bufs, 1, 1, 1);
        print("dispatch=" + (disp as str));
    }
    return 0;
}
