import std.d3 as d3;
import std.game as game;
import std.color as color;
import std.gg as gg;

fn main() {
    var cfg = game.Config(title = "T", width = 640, height = 480);
    cfg.bg_color = color.hex(0x101018, 1.0);
    var app = game.Game(cfg);
    if (not app.setup()) { return 1; }

    var scene = d3.Scene3D();
    scene.add_light(d3.ambient_light(1.0, 1.0, 1.0, 0.9));

    // 2x2 checker: red green / blue white — unmistakable if sampling works
    var px: [int] = [];
    iter (i in 0..4) {
        var x = i % 2;
        var y = i / 2 % 2;
        if (y == 0 and x == 0) { px.append(255); px.append(0); px.append(0); px.append(255); }
        elif (y == 0) { px.append(0); px.append(255); px.append(0); px.append(255); }
        elif (x == 0) { px.append(0); px.append(0); px.append(255); px.append(255); }
        else { px.append(255); px.append(255); px.append(255); px.append(255); }
    }
    val tid = gg.make_image_data(2, 2, px);
    print("tex id={tid}");

    var tex_geo = d3.plane(3.0, 2.0);
    tex_geo.rotate_x(1.5707963);
    var mat = d3.basic_material(1.0, 1.0, 1.0);
    mat.texture_state = 1;
    mat.texture_id = tid;
    mat.cull_mode = d3.CullMode.None;
    var m = d3.Mesh(tex_geo, mat, "texquad");
    scene.add(m);

    // same quad WITHOUT texture, offset right — control
    var ref_geo = d3.plane(1.0, 1.0);
    ref_geo.rotate_x(1.5707963);
    var m2 = d3.Mesh(ref_geo, d3.basic_material(1.0, 0.0, 0.0), "ref");
    m2.set_position(2.5, 0.0, 0.0);
    scene.add(m2);

    var cam = d3.perspective_camera(50.0, 640.0/480.0, 0.1, 100.0);
    cam.set_position(0.0, 0.0, 4.0);
    cam.look_at(0.0, 0.0, 0.0);
    var renderer = d3.Renderer3D(640, 480);

    var ticks = 0;
    while (app.is_running and ticks < 300) {
        app.begin_frame();
        ticks = ticks + 1;
        renderer.render(scene, cam, 0.0, 0.0, app.width as float, app.height as float);
        app.end_frame();
    }
    print("done tid={tid}");
    return 0;
}
