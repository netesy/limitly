// Test for loops
print("=== For Loop Tests ===");

// Basic for loop
print("Basic for loop (0 to 4):");
var basic_count = 0;
var basic_sum = 0;
for (var i = 0; i < 5; i += 1) {
    print("i = {i}");
    basic_count += 1;
    basic_sum += i;
}
assert(basic_count == 5, "Basic for loop should iterate 5 times");
assert(basic_sum == 10, "Sum of 0+1+2+3+4 should be 10");

// For loop with different increment
print("For loop with increment 2:");
var inc_count = 0;
var inc_sum = 0;
for (var j = 0; j < 10; j += 2) {
    print("j = {j}");
    inc_count += 1;
    inc_sum += j;
}
assert(inc_count == 5, "Increment loop should iterate 5 times (0,2,4,6,8)");
assert(inc_sum == 20, "Sum of 0+2+4+6+8 should be 20");

// Countdown loop
print("Countdown loop:");
var countdown_count = 0;
var countdown_sum = 0;
for (var k = 5; k > 0; k -= 1) {
    print("k = {k}");
    countdown_count += 1;
    countdown_sum += k;
}
assert(countdown_count == 5, "Countdown should iterate 5 times (5,4,3,2,1)");
assert(countdown_sum == 15, "Sum of 5+4+3+2+1 should be 15");

// For loop with complex condition
print("Complex condition:");
var complex_count = 0;
var complex_sum = 0;
for (var x = 1; x * x < 20; x += 1) {
    print("x = {x}, x² = {x * x}");
    complex_count += 1;
    complex_sum += x;
}
assert(complex_count == 4, "Complex condition should iterate 4 times (1,2,3,4)");
assert(complex_sum == 10, "Sum of 1+2+3+4 should be 10");

// Nested for loops
print("Nested for loops (2x3 grid):");
var nested_count = 0;
var total_pairs = 0;
for (var row = 0; row <= 2; row += 1) {
    for (var col = 0; col < 3; col += 1) {
        print("({row}, {col})");
        nested_count += 1;
        total_pairs += row * 10 + col;
    }
}
assert(nested_count == 9, "Nested loops should iterate 9 times (3x3)");

// For loop with variable scope
print("Variable scope test:");
var outer:int = 100;
var scope_count = 0;
var scope_sum = 0;
for (var i = 0; i < 4; i += 1) {
    var inner = i * 10;
    print("outer: {outer}, inner: {inner}");
    scope_count += 1;
    scope_sum += inner;
    assert(outer == 100, "Outer variable should remain constant");
    assert(inner == i * 10, "Inner variable should be calculated correctly");
}
assert(scope_count == 4, "Scope loop should iterate 4 times");
assert(scope_sum == 60, "Sum of inner values should be 0+10+20+30");

// For loop with break and continue
print("Break and continue test:");
var break_count = 0;
for (var i = 0; i < 10; i += 1) {
    if (i == 3) {
        continue;
    }
    if (i == 7) {
        break;
    }
    print("Loop value: {i}");
    break_count += 1;
}
assert(break_count == 6, "Loop should execute 6 times (skip 3, break at 7)");

print("=== For Loop Tests Complete ===");
