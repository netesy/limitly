// Test iter loops
print("=== Iter Loop Tests ===");

// Basic range iteration
print("Basic range (1 to 5):");
var basic_count = 0;
var basic_sum = 0;
iter (var i in 1..6) {
    print("i = {i}");
    basic_count += 1;
    basic_sum += i;
}
assert(basic_count == 5, "Basic iter should iterate 5 times (1-5)");
assert(basic_sum == 15, "Sum of 1+2+3+4+5 should be 15");

// Range with different bounds
print("Range (0 to 3):");
var range_count = 0;
var range_sum = 0;
iter (var x in 0..4) {
    print("x = {x}");
    range_count += 1;
    range_sum += x;
}
assert(range_count == 4, "Range iter should iterate 4 times (0-3)");
assert(range_sum == 6, "Sum of 0+1+2+3 should be 6");

// Nested iter loops
print("Nested iter loops:");
var nested_count = 0;
var total_pairs = 0;
iter (var x in 1..3) {
    print("Outer {x}");
    iter (var j in 10..13) {
        print("({x}, {j})");
        nested_count += 1;
        total_pairs += x * 100 + j;
    }
}
assert(nested_count == 6, "Nested iter should iterate 6 times (2x3)");

// Mixed nested loops (for + iter)
print("Mixed loops (for outer, iter inner):");
var mixed_count = 0;
var mixed_sum = 0;
for (var i = 0; i < 4; i += 2) {
    iter (var j in 5..8) {
        print("for-iter: ({i}, {j})");
        mixed_count += 1;
        mixed_sum += i + j;
    }
}
assert(mixed_count == 6, "Mixed for-iter should iterate 6 times (2x3)");

// Mixed nested loops (iter + for)
print("Mixed loops (iter outer, for inner):");
var mixed2_count = 0;
var mixed2_sum = 0;
iter (var i in 1..3) {
    for (var j = 0; j < 5; j += 2) {
        print("iter-for: ({i}, {j})");
        mixed2_count += 1;
        mixed2_sum += i * j;
    }
}
assert(mixed2_count == 6, "Mixed iter-for should iterate 6 times (2x3)");

// Range with expressions
var start = 2;
var end = 5;
print("Range with variables ({start} to {end}):");
var var_count = 0;
var var_sum = 0;
iter (var k in start..end) {
    print("k = {k}");
    var_count += 1;
    var_sum += k;
}
assert(var_count == 3, "Variable range should iterate 3 times (2-4)");
assert(var_sum == 9, "Sum of 2+3+4 should be 9");

// Iter loop with break and continue
print("Iter loop with break/continue:");
var break_count = 0;
var break_sum = 0;
iter (var i in 0..10) {
    if (i == 3) {
        continue;
    }
    if (i == 7) {
        break;
    }
    print("Iter value: {i}");
    break_count += 1;
    break_sum += i;
}
assert(break_count == 6, "Iter loop should execute 6 times (skip 3, break at 7)");
assert(break_sum == 18, "Sum should be 0+1+2+4+5+6 = 18");

// Iter loop over calculated range
print("Iter over calculated range:");
var base = 10;
var offset = 3;
var calc_count = 0;
var calc_sum = 0;
iter (var i in base..(base + offset)) {
    print("Calculated: {i}");
    calc_count += 1;
    calc_sum += i;
}
assert(calc_count == 3, "Calculated range should iterate 3 times");
assert(calc_sum == 33, "Sum of 10+11+12 should be 33");

print("=== Iter Loop Tests Complete ===");
