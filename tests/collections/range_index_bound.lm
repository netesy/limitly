// Range-loop bound proof: `iter (i in 0..xs.len()) { ... xs[i] ... }` must
// produce identical results in VM and AOT, including out-of-bounds accesses
// outside proven loops (which must yield nil, never garbage).

fn sum_idx_int(xs: [int]): int {
    var s = 0;
    iter (i in 0..xs.len()) {
        s = s + xs[i];
    }
    return s;
}

fn sum_iter_int(xs: [int]): int {
    var s = 0;
    iter (v in xs) {
        s = s + v;
    }
    return s;
}

fn sum_idx_float(xs: [float]): float {
    var s = 0.0;
    iter (i in 0..xs.len()) {
        s = s + xs[i];
    }
    return s;
}

fn sum_iter_float(xs: [float]): float {
    var s = 0.0;
    iter (v in xs) {
        s = s + v;
    }
    return s;
}

// Bound-proven ListSet: `xs[i] = ...` inside `0..xs.len()` must store
// in place with identical VM/AOT results.
fn fill_scale_int(xs: [int], k: int): int {
    iter (i in 0..xs.len()) {
        xs[i] = xs[i] * k;
    }
    var s = 0;
    iter (v in xs) {
        s = s + v;
    }
    return s;
}

fn fill_index_int(xs: [int]): int {
    iter (i in 0..xs.len()) {
        xs[i] = i * 10;
    }
    var s = 0;
    iter (v in xs) {
        s = s + v;
    }
    return s;
}

fn fill_add_float(xs: [float]): float {
    iter (i in 0..xs.len()) {
        xs[i] = xs[i] + 0.5;
    }
    var s = 0.0;
    iter (v in xs) {
        s = s + v;
    }
    return s;
}

// Unproven write: bound is a literal, not xs.len() — full bounds path.
fn fill_fixed(xs: [int]): int {
    iter (i in 0..3) {
        xs[i] = i + 100;
    }
    return xs[0] + xs[1] + xs[2];
}

fn main(): int {
    // [int] indexed range loop == iterator loop
    var xi: [int] = [];
    var i = 0;
    while (i < 1000) {
        xi.append(i * 3);
        i = i + 1;
    }
    assert(sum_idx_int(xi) == sum_iter_int(xi), "[int] range index sum mismatch");
    assert(sum_idx_int(xi) == 1498500, "[int] range index sum wrong");

    // [float] indexed range loop == iterator loop
    var xf: [float] = [];
    i = 0;
    while (i < 100) {
        xf.append((i as float) * 0.5);
        i = i + 1;
    }
    assert(sum_idx_float(xf) == sum_iter_float(xf), "[float] range index sum mismatch");
    assert(sum_idx_float(xf) == 2475.0, "[float] range index sum wrong");

    // [any] indexed range loop reads every element
    var xa: [any] = [1, "x", 2.5, true];
    var cnt = 0;
    var acc = 0;
    iter (k in 0..xa.len()) {
        var e = xa[k];
        if (e != nil) {
            cnt = cnt + 1;
        }
        if (e == 1) {
            acc = acc + 10;
        }
    }
    assert(cnt == 4, "[any] range index count wrong");
    assert(acc == 10, "[any] range index value wrong");

    // Out-of-bounds access outside a proven loop must yield nil in both backends
    var n: [int] = [7, 8];
    assert(n[10] == nil, "[int] OOB should be nil");
    assert(n[-1] == nil, "[int] negative OOB should be nil");
    var nf: [float] = [1.5];
    assert(nf[5] == nil, "[float] OOB should be nil");
    var na: [any] = [1];
    assert(na[9] == nil, "[any] OOB should be nil");
    var ns: [str] = ["a"];
    assert(ns[3] == nil, "[str] OOB should be nil");

    // In-bounds edge: last valid index works
    assert(n[1] == 8, "[int] last index wrong");
    assert(n[0] == 7, "[int] first index wrong");

    // Rebinding the list inside the loop must not use the stale proof:
    // ys shrinks to [9], the fresh len() check ends the loop.
    var ys: [int] = [1, 2, 3];
    var total = 0;
    iter (m in 0..ys.len()) {
        total = total + ys[m];
        if (m == 1) {
            ys = [9];
        }
    }
    assert(total == 3, "rebind during range loop wrong");

    // Appending during the loop grows the bound; every fetched index stays valid
    var zs: [int] = [1];
    var zsum = 0;
    var guard = 0;
    iter (g in 0..zs.len()) {
        zsum = zsum + zs[g];
        if (guard < 3) {
            zs.append(guard + 2);
            guard = guard + 1;
        }
    }
    assert(zsum == 1 + 2 + 3 + 4, "append during range loop wrong");

    // Non-canonical range (computed bound, step) still correct
    var w: [int] = [5, 6, 7, 8];
    var wsum = 0;
    iter (q in 0..(w.len() - 1)) {
        wsum = wsum + w[q];
    }
    assert(wsum == 18, "computed-bound range index wrong");

    // Bound-proven ListSet on [int]: element-wise scale then checksum
    var si: [int] = [1, 2, 3, 4, 5];
    assert(fill_scale_int(si, 3) == 45, "[int] proven ListSet scale wrong");
    assert(si[0] == 3 and si[4] == 15, "[int] proven ListSet values wrong");

    // Bound-proven ListSet writing the index itself
    var ii: [int] = [0, 0, 0, 0];
    assert(fill_index_int(ii) == 60, "[int] proven ListSet index wrong");
    assert(ii[3] == 30, "[int] proven ListSet last wrong");

    // Bound-proven ListSet on [float]
    var sf: [float] = [1.0, 2.0, 3.0];
    assert(fill_add_float(sf) == 7.5, "[float] proven ListSet wrong");
    assert(sf[1] == 2.5, "[float] proven ListSet value wrong");

    // Unproven write (literal bound) still stores correctly
    var uf: [int] = [0, 0, 0, 9];
    assert(fill_fixed(uf) == 303, "unproven ListSet wrong");
    assert(uf[3] == 9, "unproven ListSet clobbered");

    // Rebinding the list inside the loop defeats the write proof: ys2
    // becomes [9] at m2==1, the fresh len() check ends the loop, and the
    // surviving list keeps its rebound contents.
    var ys2: [int] = [1, 2, 3];
    iter (m2 in 0..ys2.len()) {
        ys2[m2] = ys2[m2] + 10;
        if (m2 == 1) {
            ys2 = [9];
        }
    }
    assert(ys2.len() == 1 and ys2[0] == 9, "rebind during proven ListSet wrong");

    // Out-of-bounds write outside a proven loop keeps the grow path:
    // lm_list_set extends capacity/len rather than trapping. (Gap-fill
    // semantics differ between backends today, so only the written slot
    // and length are asserted.)
    var oob: [int] = [1, 2];
    oob[4] = 42;
    assert(oob.len() == 5, "OOB ListSet did not grow");
    assert(oob[4] == 42, "OOB ListSet contents wrong");
    print("range index tests passed!");
    return 0;
}
