// Test print statements
print("=== Print Statement Tests ===");

// Basic print
print("Hello, World!");

// Print variables
var name = "Lymar";
var version = 1.0;

assert(name == "Lymar", "Variable name should be 'Lymar'");
assert(version == 1.0, "Variable version should be 1.0");

print(name);
print(version);

// Print expressions
var sum_result = 2 + 3;
var bool_result = 10 > 5;
var concat_result = "Result: " + "Success";

assert(sum_result == 5, "2 + 3 should equal 5");
assert(bool_result, "10 > 5 should be true");
assert(concat_result == "Result: Success", "String concatenation should work");

print(sum_result);
print(bool_result);
print(concat_result);

// Print with interpolation
var x = 42;
assert(x == 42, "Variable x should be 42");
print("The answer is {x}");

// Print multiple types
var bool_true = true;
var bool_false = false;
var nil_value = nil;
var zero = 0;
var empty_str = "";

assert(bool_true, "Boolean true should be true");
assert(not bool_false, "Boolean false should be false");
assert(nil_value == nil, "Nil value should be nil");
assert(zero == 0, "Zero should be 0");
assert(empty_str == "", "Empty string should be empty");

print(bool_true);
print(bool_false);
print(nil_value);
print(zero);
print(empty_str);

// Print complex expressions
var a = 5;
var b = 3;
var math_result = a + b;
var logic_result = a > b;

assert(a == 5, "Variable a should be 5");
assert(b == 3, "Variable b should be 3");
assert(math_result == 8, "5 + 3 should equal 8");
assert(logic_result, "5 > 3 should be true");

print("Math: {a} + {b} = {math_result}");
print("Logic: {a} > {b} is {logic_result}");

// Print in loops
print("Numbers 1-3:");
var loop_count = 0;
for (var i = 1; i <= 3; i += 1) {
    loop_count += 1;
    print("Number: {i}");
    // assert(i >= 1 and i <= 3, "Loop variable i should be between 1 and 3");
}
assert(loop_count == 3, "Loop should execute 3 times");

// Print with special characters
var line_str = "Line 1\nLine 2";
var tab_str = "Tab\tSeparated";
var quote_str = "Quote: \"Hello\"";

assert(line_str == "Line 1\nLine 2", "Line string should contain newline");
assert(tab_str == "Tab\tSeparated", "Tab string should contain tab");
assert(quote_str == "Quote: \"Hello\"", "Quote string should contain quotes");

print(line_str);
print(tab_str);
print(quote_str);
