fn main() {
    // 0 = RT_FILE
    var f = resource_create(0, ["test.txt", "w"]);
    if (f == nil) {
        print("Failed to create file resource");
        return;
    }

    // 0 = OP_OPEN
    resource_call(f, 0, ["test.txt", "w"]);
    // 3 = OP_WRITE
    resource_call(f, 3, ["Hello from resources!\n"]);
    resource_destroy(f);
    print("DONE");
}
