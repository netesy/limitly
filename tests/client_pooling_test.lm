// Unit Test for TOML Parser Optimizations
import std.toml.parser as toml;

fn main(): int {
    print("=== Running TOML Parser Optimization Test ===\n");

    print("Testing TOML Parser with optimized key trimming...");
    var toml_doc = "title = \"Limit Language\"\nversion = \"1.0.0\"\n";
    var parsed = toml.parse(toml_doc);
    assert(parsed != nil, "TOML parsed successfully");
    print("TOML Parser test passed.\n");

    print("\n=== TOML Optimization Tests Passed Successfully ===\n");
    return 0;
}
