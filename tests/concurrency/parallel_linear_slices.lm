// Linear slice capabilities permit one exclusive element per iteration.
var values = [1, 2, 3, 4];

parallel(cores=2) {
    iter(i in 0..4) {
        values[i] = values[i] * 2;
    }
}

assert(values[0] == 2, "slice element 0");
assert(values[1] == 4, "slice element 1");
assert(values[2] == 6, "slice element 2");
assert(values[3] == 8, "slice element 3");
