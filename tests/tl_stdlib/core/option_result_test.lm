import std.option as o;
import std.result as r;

fn main(): int {
    var some = o.Some(42);
    var none = o.None();
    
    assert(some.is_some(), "Some is_some fail");
    assert(none.is_none(), "None is_none fail");
    assert(some.unwrap() == 42, "Some unwrap fail");
    assert(none.unwrap_or(10) == 10, "None unwrap_or fail");
    
    var mapped = some.map(fn(x: any): any { return (x as int) + 1; });
    assert(mapped.unwrap() == 43, "Option map fail");
    
    var ok = r.Ok("success");
    var err = r.Err("failure");
    
    assert(ok.is_ok(), "Ok is_ok fail");
    assert(err.is_err(), "Err is_err fail");
    assert(ok.unwrap() == "success", "Ok unwrap fail");
    assert(err.unwrap_error() == "failure", "Err unwrap_error fail");
    
    print("Option/Result tests passed!");
    return 0;
}
