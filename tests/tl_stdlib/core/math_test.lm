import std.math as m;
import std.algorithms as a;

fn main(): int {
    assert(m.abs_int(-10) == 10, "Math abs fail");
    assert(m.gcd(12, 18) == 6, "Math gcd fail");
    assert(m.lcm(12, 18) == 36, "Math lcm fail");
    assert(m.factorial(5) == 120, "Math factorial fail");
    assert(a.is_prime(7), "Math is_prime fail");
    assert(!a.is_prime(4), "Math is_prime fail");
    
    assert(m.floor(2.7) == 2, "Math floor fail");
    assert(m.ceil(2.1) == 3, "Math ceil fail");
    
    var s = m.sin(0.0);
    assert(m.nearly_equal(s, 0.0), "Math sin fail");
    
    print("Math tests passed!");
    return 0;
}
