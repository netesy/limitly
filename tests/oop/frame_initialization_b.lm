// Test B: Constructor Execution
// Verify that init() is called and mutations persist

frame Foo {
    pub a: int = 1;
    
    fn init() {
        self.a = 5;
    }
}

var f = Foo();

print("After construction:");
print("f.a: {f.a}");
print("About to check f.a == 5");

if (f.a == 5) {
    print("OK: init() was called and f.a == 5");
} else {
    print("ERROR: init() not called or mutation didn't persist, got {f.a}");
}

print("After if statement");
