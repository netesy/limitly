// M4 test: staged static trees + WidgetId identity.
//
// Part 1 — staged layout math folds at compile time (std.ui.staged).
// Part 2 — every widget gets a stable int id at construction; find_widget
// walks the retained tree through the Component trait's child accessors.

import std.ui.component as v2;
import std.ui.widgets as w2;
import std.ui.container as boxes;
import std.ui.tree as tree;
import std.ui.staged as uistaged;
import std.ui.text_metrics as tm;

fn main() {
    print("=== UI Static Trees & WidgetId (M4) ===");

    // ── 1. Staged folds ──
    val cols_wide = uistaged.breakpoint_cols(1280);
    val cols_mid = uistaged.breakpoint_cols(1024);
    val cols_narrow = uistaged.breakpoint_cols(320);
    assert(cols_wide == 4, "1280px should fold to 4 columns");
    assert(cols_mid == 3, "1024px should fold to 3 columns");
    assert(cols_narrow == 1, "320px should fold to 1 column");
    assert(uistaged.COLS_DESKTOP == 4, "prefolded const COLS_DESKTOP");
    assert(uistaged.COLS_PHONE == 1, "prefolded const COLS_PHONE");

    val tw = uistaged.folded_text_width(5, 1000);
    assert(tw == 40, "5 chars at scale 1.0 folds to 40px");
    val tw_half = uistaged.folded_text_width(5, 500);
    assert(tw_half == 20, "scale 0.5 halves the folded width");

    // Label.measure uses real font advances (text_metrics) with the
    // staged 8px heuristic as fallback only. Assert against the provider.
    val probe = v2.label("Item 0");
    val m = probe.measure(0.0, v2.MEASURE_LOOSE, 0.0, v2.MEASURE_LOOSE);
    val expected_w: float = tm.text_width("Item 0", 1.0) + 8.0;
    assert(m.w == expected_w, "Label.measure should use text_metrics advances");

    // ── 2. WidgetId ──
    // Static screen: title + a row of `cols` item labels + a text input,
    // column layout inside a scroll view — all layout constants folded.
    val title = v2.label("Settings");
    val grid = boxes.row(8.0);
    var i: int = 0;
    while (i < cols_mid) {
        grid.add(v2.label("Item " + (i as str)));
        i = i + 1;
    }
    val input = w2.text_input("", "name");
    val body = boxes.column(4.0);
    body.add(title);
    body.add(grid);
    body.add(input);
    val root = boxes.scroll_view(body);

    // Every constructed widget has a unique nonzero id.
    assert(title.id != 0, "label id assigned");
    assert(grid.id != 0 and grid.id != title.id, "flow id unique");
    assert(input.id != 0 and input.id != grid.id, "input id unique");
    assert(body.id != 0 and body.id != input.id, "column id unique");
    assert(root.id != 0 and root.id != body.id, "scroll id unique");

    // The staged column count drove the real tree.
    assert(len(grid.children) == cols_mid, "grid should hold the folded column count");

    // find_widget walks ScrollView -> Column -> Row -> leaves.
    val found_title = tree.find_widget(root, title.id);
    assert(found_title != nil, "find_widget should locate the title");
    assert((found_title as v2.Component).widget_id() == title.id, "found widget id matches");

    val found_input = tree.find_widget(root, input.id);
    assert(found_input != nil, "find_widget should locate the nested input");

    val missing = tree.find_widget(root, 999999);
    assert(missing == nil, "unknown id returns nil");

    // Ids survive the arrange/paint pass (snapshot stability).
    tree.update(root, 800.0, 600.0);
    val found_after = tree.find_widget(root, title.id);
    assert(found_after != nil, "id lookup still works after update");

    tree.submit();
    print("UI Static Trees & WidgetId (M4) PASSED.");
}
