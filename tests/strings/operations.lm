// Test string operations
print("=== String Operations Tests ===");

var str1 = "Hello";
var str2 = "World";
var space = " ";

assert(str1 == "Hello", "str1 should be 'Hello'");
assert(str2 == "World", "str2 should be 'World'");
assert(space == " ", "space should be a single space");

// String concatenation
var concat = str1 + space + str2;
print("Concatenation: {str1} + {space} + {str2} = {concat}");
assert(concat == "Hello World", "String concatenation should work");

// String comparison
print("String comparisons:");
var eq_result = str1 == str2;
var ne_result = str1 != str2;

print("{str1} == {str2}: {eq_result}");
print("{str1} != {str2}: {ne_result}");

assert(not eq_result, "'Hello' should not equal 'World'");
assert(ne_result, "'Hello' should not equal 'World' (not equal)");

// String with numbers
var num_str:str = "42";
var num:int = 42;
var str_num_eq = num_str == num;

print("String vs number: {num_str} == {num}: {str_num_eq}");
assert(not str_num_eq, "String '42' should not equal number 42");

// Empty strings
var empty = "";
var empty_str = "";
var empty_eq = empty == empty_str;

print("Empty string: '{empty}'");
print("Empty length check: {empty_eq}");
assert(empty == "", "Empty string should be empty");
assert(empty_eq, "Two empty strings should be equal");

// Special characters
var special = "Line 1\nLine 2\tTabbed";
print("Special chars: {special}");
assert(special == "Line 1\nLine 2\tTabbed", "Special characters should be preserved");

// Quotes in strings
var quoted = "He said \"Hello\"";
print("Quoted: {quoted}");
assert(quoted == "He said \"Hello\"", "Quoted strings should work");

// String indexing
var test_str = "Lymar";
assert(test_str[0] == "L", "First character should be 'L'");
assert(test_str[4] == "r", "Last character should be 'r'");

print("String 'Lymar' first char: {test_str[0]}, last char: {test_str[4]}");

print("=== String Operations Tests Complete ===");
