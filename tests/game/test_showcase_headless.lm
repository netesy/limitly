// tests/game/test_showcase_headless.lm
import std.app as app;
import std.game as game;
import std.theme as theme;

fn test_game_showcase_run() {
    var cfg = game.Config(
        title="Game Showcase Smoke Test",
        width=800,
        height=600,
        resizable=true
    );
    var g = game.Game(cfg);
    var a = app.App(cfg.title, cfg.width, cfg.height);
    a.open();

    g.gui.set_theme(theme.cyberpunk_theme());

    // Run 3 simulation frames
    var frame_idx = 0;
    while (frame_idx < 3) {
        a.pump();
        g.poll();

        var sw = g.width as float;
        var sh = g.height as float;
        if (frame_idx == 0) {
            assert(sw == 800.0, "sw is 800 initially");
            assert(sh == 600.0, "sh is 600 initially");
        } else {
            assert(sw == 1024.0, "sw is 1024 after resize");
            assert(sh == 720.0, "sh is 720 after resize");
        }

        a.begin_pass();
        g.imgui_begin();

        if (g.gui.begin_window("Starship Command HUD", 16.0, 16.0, 250.0, sh - 32.0)) {
            g.gui.label("VESSEL STATUS");
            g.gui.progress_bar(0.85, 226.0, 14.0, "85%");
            g.gui.end_window();
        }

        if (g.gui.begin_window("Theme & Display Studio", 280.0, 320.0, 240.0, 260.0)) {
            g.gui.label("DISPLAY RESOLUTION");
            // Test switching resolution
            g.set_resolution(1024, 720);
            g.gui.end_window();
        }

        g.imgui_end();
        a.end_pass();
        frame_idx = frame_idx + 1;
    }

    assert(g.width == 1024, "Width updated to 1024");
    assert(g.height == 720, "Height updated to 720");

    a.close();
    print("PASS: Game showcase headless frame loop and resolution switch succeeded.");
}

test_game_showcase_run();
