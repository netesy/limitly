import std.process as process;
import std.io.file as file;

frame ListWrapper {
    pub items: [int];
    pub pos: int;

    pub init(arr: [int]) {
        self.items = arr;
        self.pos = 0;
    }

    pub fn next(): any {
        if (self.pos >= len(self.items)) {
            return nil;
        }
        var item = self.items[self.pos];
        self.pos = self.pos + 1;
        return item;
    }
}

fn main(): int {
    var wrapper = ListWrapper([10, 20, 30]);
    var item1 = wrapper.next();
    var item2 = wrapper.next();
    assert(item1 == 10, "item1 should equal 10");
    assert(item2 == 20, "item2 should equal 20");

    // Dump LIR and inspect file content
    var exit_code = process.run("bin/lymar -lir tests/oop/devirtualization_test.lm > test_io_temp.txt 2>&1");
    assert(exit_code == 0, "LIR dump command should exit with 0");

    var f = file.open("test_io_temp.txt", "r")? else {
        print("Failed to open test_io_temp.txt");
        return 1;
    };
    var content = f.read()? else {
        print("Failed to read test_io_temp.txt");
        return 1;
    };
    f.close();

    // Verify zero TraitCallMethod instructions and presence of direct frame call
    assert(not _builtin_string_contains(content, "TraitCallMethod"), "LIR dump must not contain dynamic trait call for devirtualized frame calls");
    assert(_builtin_string_contains(content, "Calculator.add"), "LIR dump must contain direct Calculator.add method calls");

    print("LIR Devirtualization Inspection Test Passed.");
    return 0;
}
