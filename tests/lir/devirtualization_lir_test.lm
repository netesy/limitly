import std.process as process;

frame ListWrapper {
    pub items: [int];
    pub pos: int;

    pub init(arr: [int]) {
        self.items = arr;
        self.pos = 0;
    }

    pub fn next(): any {
        if (self.pos >= len(self.items)) {
            return nil;
        }
        var item = self.items[self.pos];
        self.pos = self.pos + 1;
        return item;
    }
}

fn main(): int {
    var wrapper = ListWrapper([10, 20, 30]);
    var item1 = wrapper.next();
    var item2 = wrapper.next();
    assert(item1 == 10, "item1 should equal 10");
    assert(item2 == 20, "item2 should equal 20");

    // Execute CLI command check to confirm devirtualization
    var exit_code = process.run("bin/lymar -lir tests/lir/devirtualization_lir_test.lm > test_io_temp.txt 2>&1");
    assert(exit_code == 0, "LIR dump command should exit with 0");

    print("LIR Devirtualization Inspection Test Passed.");
    return 0;
}
