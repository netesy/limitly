// Comprehensive Module System Test
// Tests current functionality and documents known issues

print("========================================");
print("Comprehensive Module System Test Suite");
print("========================================");
print("");

// Test 1: Basic Import and Variable Access
print("Test 1: Basic Import and Variable Access");
print("----------------------------------------");
import tests.modules.basic_module as basic;
print("[OK] Module imported successfully");
print("[OK] Module variable access: {basic.moduleVar}");
print("[OK] Module number access: {basic.number}");
assert(basic.moduleVar == "Hello from basic module", "Module variable should be accessible");
assert(basic.number == 42, "Module number should be accessible");
print("");

// Test 2: Simple Function Calls (no parameters)
print("Test 2: Simple Function Calls");
print("------------------------------");
basic.greet();
print("[OK] Simple function call successful");
assert(true, "Module function call should work");
print("");

// Test 3: Module Aliasing
print("Test 3: Module Aliasing");
print("-----------------------");
import tests.modules.math_module as math;
print("[OK] Module imported with alias");
print("[OK] Aliased variable access: PI = {math.PI}");
assert(math.PI == 3.14159, "Module alias should work correctly");
print("");

// Test 4: Multiple Module Imports
print("Test 4: Multiple Module Imports");
print("-------------------------------");
import tests.modules.string_module as strS;
print("[OK] Multiple modules imported");
print("[OK] First module still accessible: {basic.moduleVar}");
print("[OK] Second module accessible: PI = {math.PI}");
print("[OK] Third module accessible: {strS.greeting}");
assert(basic.moduleVar == "Hello from basic module", "Multiple imports should preserve access");
assert(math.PI == 3.14159, "Multiple imports should preserve access");
assert(strS.greeting == "Hello", "Multiple imports should preserve access");
print("");

// Test 5: Nested Directory Import
print("Test 5: Nested Directory Import");
print("-------------------------------");
import tests.modules.nested.deep_module as deep;
print("[OK] Nested module imported");
print("[OK] Nested module variable: {deep.deep_value}");
assert(deep.deep_value == "I'm deep in the directory structure", "Nested module import should work");
print("");

// Test 6: Show Filter (Basic)
print("Test 6: Show Filter");
print("-------------------");
import tests.modules.string_module as str_filtered show greeting;
print("[OK] Module imported with show filter");
print("[OK] Shown variable accessible: {str_filtered.greeting}");
assert(str_filtered.greeting == "Hello", "Show filter should work");
print("");

// Test 7: Hide Filter (Basic)
print("Test 7: Hide Filter");
print("-------------------");
import tests.modules.string_module as str_hidden hide farewell;
print("[OK] Module imported with hide filter");
print("[OK] Non-hidden variable accessible: {str_hidden.greeting}");
assert(str_hidden.greeting == "Hello", "Hide filter should work");
print("");


print("Test Suite Complete!");