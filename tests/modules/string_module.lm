// String utilities module
pub var greeting = "Hello";
pub var farewell = "Goodbye";

pub fn say_hello(name: str): str {
    return greeting + ", " + name + "!";
}

pub fn say_goodbye(name: str): str {
    return farewell + ", " + name + "!";
}

pub fn repeat_string(text: str, times: int): str {
    var result = "";
    iter (i in 1..times) {
        result = result + text;
    }
    return result;
}