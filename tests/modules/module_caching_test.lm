// Module Caching Test
print("=== Module Caching Test ===");

print("Test 1: Import same module multiple times");
import tests.modules.basic_module as basic1;
import tests.modules.basic_module as basic2;
print("[OK] Same module imported twice with different aliases");
print("[OK] First alias access: " + basic1.moduleVar);
print("[OK] Second alias access: " + basic2.moduleVar);
assert(basic1.moduleVar == "Hello from basic module", "First alias should work");
assert(basic2.moduleVar == "Hello from basic module", "Second alias should work");

print("Test 2: Verify module state is shared");
print("[OK] Both aliases should access the same module instance");
print("[OK] Variable from first alias: {basic1.number}");
print("[OK] Variable from second alias: {basic2.number}");
assert(basic1.number == basic2.number, "Both aliases should access the same module instance");

print("Test 3: Import with different filters");
import tests.modules.math_module as math_all;
import tests.modules.math_module as math_pi_only show PI;
print("[OK] Same module imported with different filters");
print("[OK] Full access: PI = {math_all.PI}, E = {math_all.E}");
print("[OK] Filtered access: PI = {math_pi_only.PI}");
assert(math_all.PI == 3.14159, "Full access should work");
assert(math_all.E == 2.71828, "Full access should work");
assert(math_pi_only.PI == 3.14159, "Filtered access should work");

print("=== Module Caching Test Complete ===");