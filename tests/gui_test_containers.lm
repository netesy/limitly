// tests/gui_test_containers.lm
// Test suite for std.ui Table, Accordion, Timeline, Tree, and Calendar

import std.app as app;
import std.ui as ui;
import std.color as color;

fn build_view(): ui.Widget {
    val header = ui.row([
    ui.text("CONTAINERS & STRUCTURE TEST").font_size(16.0).bold().color(color.rgb(255, 255, 255)),
    ui.badge("TAB 3 / 4").background(color.rgb(99, 102, 241)),
    ui.spacer(1.0),
    ui.indicator("online", "Topology Engine Synchronized")
    ]).spacing(12.0).height(28.0);

    val table_headers = ["Node ID", "Instance Type", "Region", "Memory", "Status"];
    val row1 = [ui.text("i-08a9f21"), ui.text("c6g.2xlarge"), ui.text("us-east-1"), ui.text("16.0 GB"), ui.badge("Running").background(color.rgb(34, 197, 94))];
    val row2 = [ui.text("i-03b7e45"), ui.text("m6g.xlarge"), ui.text("us-west-2"), ui.text("8.0 GB"), ui.badge("Running").background(color.rgb(34, 197, 94))];
    val row3 = [ui.text("i-01c8912"), ui.text("r6g.4xlarge"), ui.text("eu-central-1"), ui.text("32.0 GB"), ui.badge("Maintenance").background(color.rgb(234, 179, 8))];
    val row4 = [ui.text("i-09f44a1"), ui.text("t4g.nano"), ui.text("ap-northeast-1"), ui.text("0.5 GB"), ui.badge("Stopped").background(color.rgb(100, 110, 130))];
    val table_rows = [row1, row2, row3, row4];

    val tbl = ui.table(table_headers, table_rows);

    val tree = ui.tree_node("Project Limitless", [
    ui.tree_node("src", [
    ui.text("main.lm"),
    ui.text("pipeline.lm"),
    ui.tree_node("transforms", [
    ui.text("SSARenamer.cpp"),
    ui.text("ConstantFolder.cpp")
    ], true)
    ], true),
    ui.tree_node("std", [
    ui.text("ui.lm"),
    ui.text("app.lm")
    ], false)
    ], true);

    val time_events = [
    ui.text("08:00 AM - Initialized cluster orchestrator"),
    ui.text("10:30 AM - Scaled replica pool to 16 workers"),
    ui.text("01:15 PM - Ingress TLS certificate renewed"),
    ui.text("03:45 PM - Deployed application version 2.4.0")
    ];
    val tline = ui.timeline(time_events);

    val cal = ui.calendar("2026-11-15");

    val acc1 = ui.accordion("Cluster Networking & Ingress Rules (Open)", ui.text("CIDR: 10.0.0.0/16 | Subnets: 3 private, 3 public | NAT Gateways: 2 active"), true);
    val acc2 = ui.accordion("Database Sharding & Read Replicas (Closed)", ui.text("Primary: PostgreSQL 16 (Multi-AZ) | Replicas: 3 read-pools active"), false);

    val left_col = ui.column([
    ui.text("Infrastructure Node Instances:").font_size(12.0).color(color.rgb(160, 165, 185)),
    tbl,
    acc1,
    acc2
    ]).spacing(8.0).width(480.0);

    val right_col = ui.column([
    ui.row([
    ui.column([
    ui.text("Release Timeline:").font_size(12.0).color(color.rgb(160, 165, 185)),
    tline
    ]).spacing(4.0).width(200.0),
    ui.column([
    ui.text("Project File Tree:").font_size(12.0).color(color.rgb(160, 165, 185)),
    tree
    ]).spacing(4.0).width(160.0)
    ]).spacing(10.0),
    ui.text("Maintenance Calendar:").font_size(12.0).color(color.rgb(160, 165, 185)),
    cal
    ]).spacing(8.0).width(380.0);

    return ui.column([
    header,
    ui.row([
    left_col,
    right_col
    ]).spacing(12.0)
    ]).spacing(12.0).padding(14.0);
}

fn main() {
    print("=== Launching Containers & Structure Test ===");

    var cfg = app.default_window_config();
    cfg.title = "Lymar UI - Containers & Structure Test";
    cfg.width = 920;
    cfg.height = 700;

    assert(app.init(cfg) == 1, "app init failed");

    val root = build_view();
    app.ui(root);

    print("Running containers application main loop...");
    app.run();

    app.shutdown();
}

