function lm_assert(i32, i64) {
@entry
  br %a_cond %pass %fail
@fail
  %fail_write = extern io.write(i64 1, i8* %assert_fail, i64 17)
  %fail_exit = extern process.exit(i64 1)
  ret null
@pass
  ret null
}

function lm_print_str(i8*) {
@entry
  %len_slot = alloc 8
  store 0 %len_slot
  jmp %loop
@loop
  %curr_len = load %len_slot
  %ps_curr_ptr = add %s_val %curr_len
  %curr_char = loadub %ps_curr_ptr
  %is_null = ceq %curr_char 0
  %next_len = add %curr_len 1
  store %next_len %len_slot
  br %is_null %done %loop
@done
  %final_len = load %len_slot
  %actual_len = sub %final_len 1
  %write_res = extern io.write(i64 1, i8* %s_val, i32 %actual_len)
  %write_res = extern io.write(i64 1, i8* %nl, i64 1)
  ret null
}

