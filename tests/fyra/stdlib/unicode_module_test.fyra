function lm_print_int(i64) {
@entry
  %buf = alloc 32
  %ptr = add %buf 31
  storeb 10 %ptr
  %val_slot = alloc 8
  %ptr_slot = alloc 8
  store %ptr %ptr_slot
  %is_neg = cslt %val 0
