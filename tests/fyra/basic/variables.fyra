function lm_print_int(i64) {
@entry
  %buf = alloc 32
  %ptr = add %buf 31
  storeb 10 %ptr
  %val_slot = alloc 8
  %ptr_slot = alloc 8
  store %ptr %ptr_slot
  %is_neg = cslt %val 0
  br %is_neg %neg %abs
@neg
  %write_neg = extern io.write(i64 1, i8* %str_minus, i64 1)
  %abs_v = neg %val
  store %abs_v %val_slot
  jmp %loop
@abs
  store %val %val_slot
  jmp %loop
@loop
  %curr_val = load %val_slot
  %next_val = div %curr_val 10
  %rem = rem %curr_val 10
  %ascii = add %rem 48
  %curr_ptr = load %ptr_slot
  %next_ptr = sub %curr_ptr 1
  %cast_ascii = cast %ascii
  storeb %cast_ascii %next_ptr
  store %next_val %val_slot
  store %next_ptr %ptr_slot
  %cond = cuge %next_val 1
  br %cond %loop %done
@done
  %final_ptr = load %ptr_slot
  %end_ptr = add %buf 32
  %len = sub %end_ptr %final_ptr
  %write_done = extern io.write(i64 1, i32 %final_ptr, i64 %len)
  ret null
}

function lm_assert(i32, i64) {
@entry
  br %a_cond %pass %fail
@fail
  %fail_write = extern io.write(i64 1, i8* %assert_fail, i64 17)
  %fail_exit = extern process.exit(i64 1)
  ret null
@pass
  ret null
}

