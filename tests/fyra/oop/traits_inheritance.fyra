function __top_level_wrapper__() {
@entry
@block_0
  %r0 = call %main
  %r1 = call %main
  ret 0
}

function main() {
@entry
@block_0
  %r0 = alloc 16
  %addr_0 = add %r0 0
  store %r0 %addr_0
  %r3 = call %MyFrame.name %r0
  %r4 = call %lm_print_int %r3
  %r5 = call %MyFrame.version %r0
  %r6 = call %lm_print_int %r5
  %r7 = call %Base.greet %r0
  %r8 = call %lm_print_int %r7
  %r9 = call %MyFrame.name %r0
  %r10 = call %lm_box_string %str_const_1
  %r11 = ceq %r9 %r10
  %r12 = call %lm_box_string %str_const_2
  %r13 = call %lm_assert %r11 %r12
  %r14 = call %MyFrame.version %r0
  %r16 = ceq %r14 9
  %r17 = call %lm_box_string %str_const_3
  %r18 = call %lm_assert %r16 %r17
  %r19 = call %Base.greet %r0
  %r20 = call %lm_box_string %str_const_4
  %r21 = ceq %r19 %r20
  %r22 = call %lm_box_string %str_const_5
  %r23 = call %lm_assert %r21 %r22
  ret 0
}

