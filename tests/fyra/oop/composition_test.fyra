function __top_level_wrapper__() {
@entry
@block_0
  %r0 = call %run_test
  ret 0
}

function run_test() {
@entry
@block_0
  %r0 = call %lm_box_string %str_const_0
  %r1 = call %lm_print_int %r0
  %r2 = alloc 16
  %r3 = call %Outer.init %r2
  %r5 = call %Outer.test %r2
  %r6 = call %lm_box_string %str_const_1
  %r7 = call %lm_print_int %r6
  ret 0
}

