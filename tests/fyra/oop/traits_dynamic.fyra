  %r6 = call %print_shape_info %r0
  %r7 = call %print_shape_info %r3
  %r8 = call %Circle.name %r0
  %r9 = call %lm_box_string %str_const_2
  %r10 = ceq %r8 %r9
  %r11 = call %lm_box_string %str_const_3
  %r12 = call %lm_assert %r10 %r11
  %r13 = call %Circle.area %r0
  %r15 = ceq %r13 601
  %r16 = call %lm_box_string %str_const_4
  %r17 = call %lm_assert %r15 %r16
  %r18 = call %Square.name %r3
  %r19 = call %lm_box_string %str_const_5
  %r20 = ceq %r18 %r19
  %r21 = call %lm_box_string %str_const_6
  %r22 = call %lm_assert %r20 %r21
  %r23 = call %Square.area %r3
  %r25 = ceq %r23 801
  %r26 = call %lm_box_string %str_const_7
  %r27 = call %lm_assert %r25 %r26
  ret 0
}

