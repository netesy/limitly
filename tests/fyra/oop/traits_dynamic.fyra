function __top_level_wrapper__() {
@entry
@block_0
  %r0 = call %main
  %r1 = call %main
  ret 0
}

function main() {
@entry
@block_0
  %r0 = alloc 16
  %addr_0 = add %r0 0
  store %r0 %addr_0
  %r3 = alloc 16
  %addr_1 = add %r3 0
