// @error:trait_not_impl
// Conflicting trait implementations

trait A {
    fn method(): int;
}

trait B {
    fn method(): str;
}

frame Both: A, B {
    // One member cannot satisfy both: the int version satisfies A and conflicts
    // with B's `str` return requirement.
    pub fn method(): int {
        return 1;
    }
}
