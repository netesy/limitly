import std.algorithm as algorithm;

fn twice(x: int): int { return x * 2; }
fn even(x: int): bool { return x % 2 == 0; }
fn add(a: int, b: int): int { return a + b; }

fn main(): int {
    var values: [int] = [1, 2, 2, 3];
    if (algorithm.count(values, 2) != 2) { return 1; }
    if (algorithm.find(values, 3) != 3) { return 2; }
    if (algorithm.find_if(values, even) != 1) { return 3; }
    if (not algorithm.any_match(values, even)) { return 4; }
    if (algorithm.none(values, even)) { return 5; }
    var mapped = algorithm.map(values, twice);
    var _filtered = algorithm.filter(values, even);
    var _total = algorithm.reduce(values, add, 0);
    var pairs = algorithm.zip(values, mapped);
    var _parts = algorithm.unzip(pairs);
    var _removed = algorithm.remove_if(values, even);
    algorithm.reverse(values);
    algorithm.rotate(values, 1);
    return 0;
}
